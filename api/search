"2398":7,"2399":7,"2400":7,"2401":7,"2402":7,"2403":7,"2404":7,"2405":7,"2406":7,"2407":7,"2408":7,"2409":7,"2410":7,"2411":7,"2412":7,"2413":7,"2414":7,"2415":7,"2416":7,"2417":7,"2418":7,"2419":7,"2420":7,"2421":7,"2422":7,"2423":7,"2424":7,"2425":7,"2426":7,"2427":7,"2428":7,"2429":7,"2430":7,"2431":7,"2432":7,"2433":7,"2434":7,"2435":7,"2436":7,"2437":7,"2438":7,"2439":7,"2440":7,"2441":7,"2442":7,"2443":6,"2444":7,"2445":7,"2446":7,"2447":7,"2448":7,"2449":7,"2450":7,"2451":7,"2452":7,"2453":7,"2454":7,"2455":7,"2456":7,"2457":7,"2458":7,"2459":7,"2460":7,"2461":7,"2462":7,"2463":7,"2464":7,"2465":7,"2466":7,"2467":7,"2468":7,"2469":7,"2470":6,"2471":7,"2472":7,"2473":7,"2474":7,"2475":7,"2476":7,"2477":7,"2478":7,"2479":7,"2480":7,"2481":7,"2482":7,"2483":7,"2484":7,"2485":7,"2486":7,"2487":7,"2488":7,"2489":7,"2490":7,"2491":7,"2492":7,"2493":7,"2494":7,"2495":7,"2496":7,"2497":7,"2498":7,"2499":7,"2500":7,"2501":7,"2502":7,"2503":7,"2504":7,"2505":7,"2506":7,"2507":7,"2508":7,"2509":7,"2510":7,"2511":7,"2512":7,"2513":7,"2514":7,"2515":7,"2516":7,"2517":7,"2518":7,"2519":7,"2520":7,"2521":7,"2522":6,"2523":7,"2524":7,"2525":7,"2526":7,"2527":7,"2528":7,"2529":7,"2530":7,"2531":7,"2532":7,"2533":7,"2534":7,"2535":7,"2536":7,"2537":7,"2538":7,"2539":7,"2540":7,"2541":7,"2542":6,"2543":7,"2544":7,"2545":7,"2546":7,"2547":7,"2548":7,"2549":5,"2550":5,"2551":6,"2552":6,"2553":6,"2554":6,"2555":5,"2556":5,"2557":5,"2558":6,"2559":6,"2560":6,"2561":6,"2562":6,"2563":6,"2564":6,"2565":6,"2566":6}}},"docs":{"docs":{"1":{"id":"/js/chop/latest/reference","page_id":"/js/chop/latest/reference","type":"page","content":"Reference","breadcrumbs":["Docs","Js","Chop","Latest"],"tags":[],"url":"/js/chop/latest/reference"},"2":{"id":"/js/chop/latest/reference-0","page_id":"/js/chop/latest/reference","type":"heading","tags":[],"url":"/js/chop/latest/reference#requests","content":"Requests"},"3":{"id":"/js/chop/latest/reference-1","page_id":"/js/chop/latest/reference","type":"heading","tags":[],"url":"/js/chop/latest/reference#query-scheme-arguments","content":"Query scheme arguments"},"4":{"id":"/js/chop/latest/reference-2","page_id":"/js/chop/latest/reference","type":"heading","tags":[],"url":"/js/chop/latest/reference#url-schemes","content":"URL schemes"},"5":{"id":"/js/chop/latest/reference-3","page_id":"/js/chop/latest/reference","type":"heading","tags":[],"url":"/js/chop/latest/reference#cloudflare","content":"`cloudflare`"},"6":{"id":"/js/chop/latest/reference-4","page_id":"/js/chop/latest/reference","type":"heading","tags":[],"url":"/js/chop/latest/reference#output-format","content":"Output format"},"7":{"id":"/js/chop/latest/reference-5","page_id":"/js/chop/latest/reference","type":"heading","tags":[],"url":"/js/chop/latest/reference#quality-and-size","content":"Quality and size"},"8":{"id":"/js/chop/latest/reference-6","page_id":"/js/chop/latest/reference","type":"heading","tags":[],"url":"/js/chop/latest/reference#responses","content":"Responses"},"9":{"id":"/js/chop/latest/reference-7","page_id":"/js/chop/latest/reference","type":"heading","tags":[],"url":"/js/chop/latest/reference#caching","content":"Caching"},"10":{"id":"/js/chop/latest/reference-8","page_id":"/js/chop/latest/reference","type":"heading","tags":[],"url":"/js/chop/latest/reference#limits","content":"Limits"},"11":{"id":"/js/chop/latest/reference-9","page_id":"/js/chop/latest/reference","type":"heading","tags":[],"url":"/js/chop/latest/reference#settings","content":"Settings"},"12":{"id":"/js/chop/latest/reference-10","page_id":"/js/chop/latest/reference","type":"heading","tags":[],"url":"/js/chop/latest/reference#interfaces","content":"Interfaces"},"13":{"id":"/js/chop/latest/reference-11","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference","content":"How Chop behaves, in short. The IDs in parentheses, like `R-OP-8`, are what the tests refer to in their names. Chop is MIT licensed and was implemented from a written behavior specification and the repository conventions, without reference to the source code of any other image server."},"14":{"id":"/js/chop/latest/reference-12","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#requests","content":"`GET` and `HEAD` are answered, other methods get `405` with `Allow: GET, HEAD` (R-REQ-1)."},"15":{"id":"/js/chop/latest/reference-13","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#requests","content":"The path selects the original under the data directory, and a URL scheme selects the operations (R-REQ-2, S-1). Unknown arguments are ignored, so cache busters like `ver=3` are harmless."},"16":{"id":"/js/chop/latest/reference-14","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#requests","content":"`/healthz` answers `200 ok` without touching the data directory (R-REQ-3)."},"17":{"id":"/js/chop/latest/reference-15","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#requests","content":"The same URL and `Accept` header give the same bytes (R-REQ-4)."},"18":{"id":"/js/chop/latest/reference-16","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#requests","content":"Path segments are percent-decoded once. `.`, `..`, empty segments and segments with `/`, `\\` or a NUL byte are a `400`, and a broken escape is a `400` (R-PATH-1)."},"19":{"id":"/js/chop/latest/reference-17","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#requests","content":"The real path, with symbolic links resolved, must be inside the real data directory. A missing file, a directory and an escape are all the same `404` (R-PATH-2)."},"20":{"id":"/js/chop/latest/reference-18","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#requests","content":"A file over `maxInputBytes` is a `413`, checked before the read and again after it (R-PATH-3)."},"21":{"id":"/js/chop/latest/reference-19","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#query-scheme-arguments","content":"This is the default scheme, named `query`. All arguments are optional, and a malformed value of a known argument is a `400` that names it."},"22":{"id":"/js/chop/latest/reference-20","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#query-scheme-arguments","content":"| Argument | Meaning                                                                                                               |\n| -------- | --------------------------------------------------------------------------------------------------------------------- |\n| `w`, `h` | Width or height in pixels. With one, scale to it. With both, fit inside the box without cropping or padding (R-OP-2). |","table":"table-0"},"23":{"id":"/js/chop/latest/reference-21","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#query-scheme-arguments","content":"| Argument  | Meaning                                                           |\n| --------- | ----------------------------------------------------------------- |\n| `fit=w,h` | The same as `w` and `h` together, and it wins over them (R-OP-3). |","table":"table-0"},"24":{"id":"/js/chop/latest/reference-22","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#query-scheme-arguments","content":"| Argument     | Meaning                                                                    |\n| ------------ | -------------------------------------------------------------------------- |\n| `resize=w,h` | Cover the box and crop to exactly `w` by `h`. It wins over `fit` (R-OP-4). |","table":"table-0"},"25":{"id":"/js/chop/latest/reference-23","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#query-scheme-arguments","content":"| Argument  | Meaning                                                                                             |\n| --------- | --------------------------------------------------------------------------------------------------- |\n| `gravity` | Where `resize` crops: `center` (default), `north`, `south`, `east`, `west` or `attention` (R-OP-5). |","table":"table-0"},"26":{"id":"/js/chop/latest/reference-24","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#query-scheme-arguments","content":"| Argument       | Meaning                                                                                                                                                |\n| -------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `crop=x,y,w,h` | A region of the oriented original, before scaling. Numbers are percentages, or pixels with a `px` suffix. The region is clipped to the image (R-OP-6). |","table":"table-0"},"27":{"id":"/js/chop/latest/reference-25","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#query-scheme-arguments","content":"| Argument         | Meaning                                                                                                    |\n| ---------------- | ---------------------------------------------------------------------------------------------------------- |\n| `lb=w,h[,color]` | Fit inside the box and pad to exactly `w` by `h`. `color` is 3 or 6 hex digits, default `ffffff` (R-OP-7). |","table":"table-0"},"28":{"id":"/js/chop/latest/reference-26","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#query-scheme-arguments","content":"| Argument | Meaning                                                               |\n| -------- | --------------------------------------------------------------------- |\n| `zoom`   | Device pixel ratio from 1 to 10, which multiplies the sizes (R-OP-9). |","table":"table-0"},"29":{"id":"/js/chop/latest/reference-27","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#query-scheme-arguments","content":"| Argument    | Meaning                                                |\n| ----------- | ------------------------------------------------------ |\n| `upscale=1` | Allow enlarging, up to `maxUpscaleDimension` (R-OP-8). |","table":"table-0"},"30":{"id":"/js/chop/latest/reference-28","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#query-scheme-arguments","content":"| Argument  | Meaning                                                                   |\n| --------- | ------------------------------------------------------------------------- |\n| `quality` | 1 to 100, with values below 20 raised to 20 for lossy encoders (R-QLT-1). |","table":"table-0"},"31":{"id":"/js/chop/latest/reference-29","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#query-scheme-arguments","content":"| Argument | Meaning                                                             |\n| -------- | ------------------------------------------------------------------- |\n| `format` | `auto` (default), `jpeg`, `png`, `webp`, `avif` or `gif` (R-FMT-2). |","table":"table-0"},"32":{"id":"/js/chop/latest/reference-30","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#query-scheme-arguments","content":"| Argument  | Meaning                                            |\n| --------- | -------------------------------------------------- |\n| `lossy=1` | Allow lossy output for lossless sources (R-QLT-5). |","table":"table-0"},"33":{"id":"/js/chop/latest/reference-31","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#query-scheme-arguments","content":"| Argument | Meaning                                                                 |\n| -------- | ----------------------------------------------------------------------- |\n| `strip`  | `metadata` (default, keeps the ICC profile), `all` or `none` (R-QLT-6). |","table":"table-0"},"34":{"id":"/js/chop/latest/reference-32","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#query-scheme-arguments","content":"Operations run in a fixed order, whatever the order in the URL: orientation, `crop`, size, `lb`, then encoding. Sizes always refer to the displayed (oriented) image (R-OP-1)."},"35":{"id":"/js/chop/latest/reference-33","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#query-scheme-arguments","content":"Without `upscale=1` nothing is enlarged: sizes clamp to the original, `resize` crops at the largest size with the requested aspect ratio, and `lb` pads without enlarging (R-OP-8). The output can't exceed `maxOutputDimension` (R-OP-12)."},"36":{"id":"/js/chop/latest/reference-34","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#query-scheme-arguments","content":"Animated sources keep all frames for `crop` and sizes. `lb` and `gravity=attention` are ignored for them (R-OP-13). Image adjustments (R-OP-10) and filters (R-OP-11) aren't supported, and their arguments are ignored."},"37":{"id":"/js/chop/latest/reference-35","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#url-schemes","content":"A scheme turns a URL into the path of the original and the operations. All the schemes produce the same operations, so every scheme gets the same negotiation, limits and path safety."},"38":{"id":"/js/chop/latest/reference-36","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#url-schemes","content":"Schemes are tried in the configured order, and the first one that recognizes the URL wins. The default is `query` only (S-1). The `query` scheme recognizes every URL, so it has to be listed last when it's enabled with others. The `cloudflare` scheme only recognizes URLs that start with `/cdn-cgi/image/`."},"39":{"id":"/js/chop/latest/reference-37","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#url-schemes","content":"A scheme's path segments go through the same checks as any other path, so no scheme can read outside the data directory (S-2)."},"40":{"id":"/js/chop/latest/reference-38","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#url-schemes","content":"A URL that no enabled scheme recognizes is a `404` (S-3)."},"41":{"id":"/js/chop/latest/reference-39","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#url-schemes","content":"A scheme ignores the options that Chop doesn't support, and a malformed value of one that it supports is a `400` (S-4)."},"42":{"id":"/js/chop/latest/reference-40","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#url-schemes","content":"Different schemes that give the same operations give the same bytes and `ETag` (S-5)."},"43":{"id":"/js/chop/latest/reference-41","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#cloudflare","content":"The `/cdn-cgi/image/<options>/<path>` form of Cloudflare Image Resizing, with comma separated `name=value` options."},"44":{"id":"/js/chop/latest/reference-42","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#cloudflare","content":"| Option            | Maps to         |\n| ----------------- | --------------- |\n| `width`, `height` | `w`, `h` (S-6). |","table":"table-1"},"45":{"id":"/js/chop/latest/reference-43","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#cloudflare","content":"| Option | Maps to                                                                                                                                                                                      |\n| ------ | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `fit`  | `scale-down` (default) is `w`/`h` that never enlarges, `contain` is the same with `upscale`, `cover` is `resize` with `upscale`, `crop` is `resize`, and `pad` is `lb` with `upscale` (S-7). |","table":"table-1"},"46":{"id":"/js/chop/latest/reference-44","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#cloudflare","content":"| Option    | Maps to                                                                                                                                                     |\n| --------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `gravity` | `left`, `right`, `top`, `bottom` are `west`, `east`, `north`, `south`, and `auto` and `face` are `attention`. Coordinates like `0.5x0.3` are ignored (S-8). |","table":"table-1"},"47":{"id":"/js/chop/latest/reference-45","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#cloudflare","content":"| Option    | Maps to          |\n| --------- | ---------------- |\n| `quality` | `quality` (S-9). |","table":"table-1"},"48":{"id":"/js/chop/latest/reference-46","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#cloudflare","content":"| Option   | Maps to                                                                                                |\n| -------- | ------------------------------------------------------------------------------------------------------ |\n| `format` | `auto`, `avif`, `webp`, `jpeg`, `png`, `gif`, and `baseline-jpeg` as `jpeg`. `json` is a `400` (S-10). |","table":"table-1"},"49":{"id":"/js/chop/latest/reference-47","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#cloudflare","content":"| Option | Maps to        |\n| ------ | -------------- |\n| `dpr`  | `zoom` (S-11). |","table":"table-1"},"50":{"id":"/js/chop/latest/reference-48","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#cloudflare","content":"| Option     | Maps to                                                                                |\n| ---------- | -------------------------------------------------------------------------------------- |\n| `metadata` | `keep` is `strip=none`, `copyright` is `strip=metadata`, `none` is `strip=all` (S-12). |","table":"table-1"},"51":{"id":"/js/chop/latest/reference-49","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#cloudflare","content":"| Option       | Maps to                                             |\n| ------------ | --------------------------------------------------- |\n| `background` | The `lb` color for `fit=pad`, as hex digits (S-13). |","table":"table-1"},"52":{"id":"/js/chop/latest/reference-50","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#cloudflare","content":"Other Cloudflare options, like `trim`, `rotate`, `blur`, `sharpen` and `onerror`, are ignored. Remote source URLs aren't supported and are a `404`."},"53":{"id":"/js/chop/latest/reference-51","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#output-format","content":"`Accept` is parsed per RFC 9110. Only a listed `image/avif` or `image/webp` makes those formats acceptable, so `image/*` and `*/*` don't (R-FMT-1)."},"54":{"id":"/js/chop/latest/reference-52","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#output-format","content":"An explicit `format` is used even when `Accept` doesn't list it. Transparency is flattened onto white for formats that can't hold it (R-FMT-2)."},"55":{"id":"/js/chop/latest/reference-53","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#output-format","content":"With `auto`, a still image is AVIF if enabled and accepted and the output is lossy, else WebP if accepted and within its size limit, else the fallback format: GIF for GIF sources, PNG for lossless or transparent output, and JPEG otherwise (R-FMT-3)."},"56":{"id":"/js/chop/latest/reference-54","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#output-format","content":"An animated source becomes an animated WebP if accepted, otherwise a GIF, and never AVIF (R-FMT-4)."},"57":{"id":"/js/chop/latest/reference-55","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#output-format","content":"PNG, GIF and lossless WebP sources stay lossless unless `lossy=1` or a `quality` below 100 is given (R-FMT-5). JPEG, lossy WebP and AVIF sources produce lossy output (R-FMT-6)."},"58":{"id":"/js/chop/latest/reference-56","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#output-format","content":"Every response that depends on `Accept` has `Vary: Accept` (R-FMT-7)."},"59":{"id":"/js/chop/latest/reference-57","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#output-format","content":"JPEG, PNG, GIF, WebP and AVIF are read, detected from the content. Other content is a `415`, and unreadable or corrupt files are a `422` (R-FMT-8)."},"60":{"id":"/js/chop/latest/reference-58","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#quality-and-size","content":"The defaults are JPEG 82, WebP 80 and AVIF 55, lowered to the estimated quality of a JPEG source, so that a recompressed JPEG never gets a higher quality than it has. The estimate compares the file's luminance quantization table with the standard table scaled for each quality. An explicit `quality` is used as given (R-QLT-2, R-QLT-3)."},"61":{"id":"/js/chop/latest/reference-59","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#quality-and-size","content":"A request that changes nothing about the pixels and keeps the source format sends the original bytes when the re-encoded image isn't smaller, and with `strip=none` it always sends them (R-QLT-4)."},"62":{"id":"/js/chop/latest/reference-60","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#responses","content":"`200` has the output `Content-Type`, `Content-Length`, `Cache-Control: public, max-age=<maxAge>`, `Vary: Accept`, `X-Content-Type-Options: nosniff` and a strong SHA-256 `ETag` (R-RES-1). `X-Bytes-Saved` appears when the output is smaller than the original (R-RES-3)."},"63":{"id":"/js/chop/latest/reference-61","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#responses","content":"`If-None-Match` that matches, including weak comparison, lists and `*`, gets a `304` without a body (R-RES-2)."},"64":{"id":"/js/chop/latest/reference-62","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#responses","content":"Errors are plain text with `Cache-Control: no-store` and no file system paths: `400` invalid request, `404` not found, `405` method, `413` original too large, `415` unsupported type, `422` unreadable image, `500` unexpected, `503` busy (R-RES-4)."},"65":{"id":"/js/chop/latest/reference-63","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#caching","content":"Responses depend on `Accept` and the URL only, so a cache can key on the URL and a bucket of `Accept`: `image/avif`, `image/webp` or neither. Send the bucket as `Accept` upstream so that the body matches the key. The README has an nginx recipe."},"66":{"id":"/js/chop/latest/reference-64","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#limits","content":"At most `maxConcurrency` images are processed at once and `maxQueue` more wait in order. A request that finds the queue full gets `503` with `Retry-After: 1`, and a failing request frees its slot (R-LIM-1, R-LIM-2)."},"67":{"id":"/js/chop/latest/reference-65","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#limits","content":"Decoding is limited by `maxInputPixels` (R-LIM-3)."},"68":{"id":"/js/chop/latest/reference-66","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#limits","content":"`allowedWidths` optionally restricts the output widths to a list (R-LIM-4)."},"69":{"id":"/js/chop/latest/reference-67","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#limits","content":"Chop never writes to disk and makes no network requests (R-LIM-5)."},"70":{"id":"/js/chop/latest/reference-68","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#settings","content":"| Setting   | Environment variable | Default |\n| --------- | -------------------- | ------- |\n| `dataDir` | `CHOP_DATA_DIR`      | `/data` |","table":"table-2"},"71":{"id":"/js/chop/latest/reference-69","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#settings","content":"| Setting   | Environment variable             | Default |\n| --------- | -------------------------------- | ------- |\n| `schemes` | `CHOP_SCHEMES` (comma separated) | `query` |","table":"table-2"},"72":{"id":"/js/chop/latest/reference-70","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#settings","content":"| Setting  | Environment variable | Default    |\n| -------- | -------------------- | ---------- |\n| `maxAge` | `CHOP_MAX_AGE`       | `31536000` |","table":"table-2"},"73":{"id":"/js/chop/latest/reference-71","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#settings","content":"| Setting          | Environment variable   | Default        |\n| ---------------- | ---------------------- | -------------- |\n| `maxConcurrency` | `CHOP_MAX_CONCURRENCY` | number of CPUs |","table":"table-2"},"74":{"id":"/js/chop/latest/reference-72","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#settings","content":"| Setting    | Environment variable | Default |\n| ---------- | -------------------- | ------- |\n| `maxQueue` | `CHOP_MAX_QUEUE`     | `64`    |","table":"table-2"},"75":{"id":"/js/chop/latest/reference-73","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#settings","content":"| Setting         | Environment variable   | Default    |\n| --------------- | ---------------------- | ---------- |\n| `maxInputBytes` | `CHOP_MAX_INPUT_BYTES` | `52428800` |","table":"table-2"},"76":{"id":"/js/chop/latest/reference-74","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#settings","content":"| Setting          | Environment variable    | Default     |\n| ---------------- | ----------------------- | ----------- |\n| `maxInputPixels` | `CHOP_MAX_INPUT_PIXELS` | `120000000` |","table":"table-2"},"77":{"id":"/js/chop/latest/reference-75","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#settings","content":"| Setting              | Environment variable        | Default |\n| -------------------- | --------------------------- | ------- |\n| `maxOutputDimension` | `CHOP_MAX_OUTPUT_DIMENSION` | `8192`  |","table":"table-2"},"78":{"id":"/js/chop/latest/reference-76","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#settings","content":"| Setting               | Environment variable         | Default |\n| --------------------- | ---------------------------- | ------- |\n| `maxUpscaleDimension` | `CHOP_MAX_UPSCALE_DIMENSION` | `4096`  |","table":"table-2"},"79":{"id":"/js/chop/latest/reference-77","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#settings","content":"| Setting                                     | Environment variable                                          | Default          |\n| ------------------------------------------- | ------------------------------------------------------------- | ---------------- |\n| `jpegQuality`, `webpQuality`, `avifQuality` | `CHOP_JPEG_QUALITY`, `CHOP_WEBP_QUALITY`, `CHOP_AVIF_QUALITY` | `82`, `80`, `55` |","table":"table-2"},"80":{"id":"/js/chop/latest/reference-78","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#settings","content":"| Setting | Environment variable | Default |\n| ------- | -------------------- | ------- |\n| `avif`  | `CHOP_AVIF`          | `true`  |","table":"table-2"},"81":{"id":"/js/chop/latest/reference-79","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#settings","content":"| Setting      | Environment variable | Default |\n| ------------ | -------------------- | ------- |\n| `avifEffort` | `CHOP_AVIF_EFFORT`   | `4`     |","table":"table-2"},"82":{"id":"/js/chop/latest/reference-80","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#settings","content":"| Setting         | Environment variable                    | Default |\n| --------------- | --------------------------------------- | ------- |\n| `allowedWidths` | `CHOP_ALLOWED_WIDTHS` (comma separated) | unset   |","table":"table-2"},"83":{"id":"/js/chop/latest/reference-81","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#interfaces","content":"`createHandler( settings? )` returns `( request ) => Promise< Response >` with `{ method, url, headers }` in and `{ status, headers, body }` out. It never throws for a request, never uses `node:http` and reports unexpected errors to an optional `onError` (R-API-1)."},"84":{"id":"/js/chop/latest/reference-82","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#interfaces","content":"`createConfig()`, `configFromEnv( env )`, `parseQuery()`, `createServer()`, the URL schemes `queryScheme` and `cloudflareScheme` with their `SCHEMES` registry and the `UrlScheme` type (`{ name, parse( url ) }`, where `parse` returns `{ segments, ops }` or `null`), and the other types are exported too (R-API-2, S-1)."},"85":{"id":"/js/chop/latest/reference-83","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#interfaces","content":"Errors are `ChopError` with a `code` from `CHOP_ERROR_CODES`, checked with `isChopError()` (R-API-3)."},"86":{"id":"/js/chop/latest/reference-84","page_id":"/js/chop/latest/reference","tags":[],"type":"text","url":"/js/chop/latest/reference#interfaces","content":"The CLI is `chop [--data <dir>] [--port <n>] [--host <address>] [--scheme <name>] [--help]`, with flags overriding `CHOP_*` variables. Exit codes are `0`, `1` for a failure and `2` for invalid options. `SIGINT` and `SIGTERM` stop it gracefully, and `CHOP_ACCESS_LOG=1` prints one JSON line per request (R-CLI-1 to R-CLI-4)."},"87":{"id":"/js/wp-release/latest/changesets","page_id":"/js/wp-release/latest/changesets","type":"page","content":"Changesets","breadcrumbs":["Docs","Js","Wp release","Latest"],"tags":[],"url":"/js/wp-release/latest/changesets"},"88":{"id":"/js/wp-release/latest/changesets-0","page_id":"/js/wp-release/latest/changesets","type":"heading","tags":[],"url":"/js/wp-release/latest/changesets#changesets-support","content":"Changesets support"},"89":{"id":"/js/wp-release/latest/changesets-1","page_id":"/js/wp-release/latest/changesets","type":"heading","tags":[],"url":"/js/wp-release/latest/changesets#single-project-repositories-without-a-config-file","content":"Single-project repositories without a config file"},"90":{"id":"/js/wp-release/latest/changesets-2","page_id":"/js/wp-release/latest/changesets","type":"heading","tags":[],"url":"/js/wp-release/latest/changesets#single-project-checks-in-github-actions","content":"Single-project checks in GitHub Actions"},"91":{"id":"/js/wp-release/latest/changesets-3","page_id":"/js/wp-release/latest/changesets","type":"heading","tags":[],"url":"/js/wp-release/latest/changesets#packages-and-tags","content":"Packages and tags"},"92":{"id":"/js/wp-release/latest/changesets-4","page_id":"/js/wp-release/latest/changesets","type":"heading","tags":[],"url":"/js/wp-release/latest/changesets#pre-releases","content":"Pre-releases"},"93":{"id":"/js/wp-release/latest/changesets-5","page_id":"/js/wp-release/latest/changesets","type":"heading","tags":[],"url":"/js/wp-release/latest/changesets#snapshots","content":"Snapshots"},"94":{"id":"/js/wp-release/latest/changesets-6","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#changesets-support","content":"The changeset commands manage versioning, changelogs and release tags for single-package repositories and monorepos, including this repository. They read Changesets-style Markdown and load JavaScript configs with descriptors for npm and Composer manifests, plugin and theme headers, readme Stable tags, PHP constants, and Git tags. Use JavaScript configs with ESM (`export default`) or CommonJS (`module.exports`). Frontmatter uses `package-name: patch|minor|major` entries. For pre-releases, use the built-in pre-release workflow; the parser supports this simple frontmatter format rather than general YAML or the Changesets pre mode."},"95":{"id":"/js/wp-release/latest/changesets-7","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#changesets-support","content":"PHP projects that don't use Node.js or JavaScript can run the same workflow with PHP Changesets, a Composer package that needs only PHP and Git. Its `changeset add`, `changeset status`, `changeset version` and `changeset tag` commands take the options of the `changeset-*` commands here, read the same changeset files and print the same release plans, with a PHP config file in place of `wp-release.config.*`. Use `wp-release` when the project already builds with Node.js, or to also build ZIPs, translations and WordPress.org deploys; see the comparison for the differences."},"96":{"id":"/js/wp-release/latest/changesets-8","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#single-project-repositories-without-a-config-file","content":"The `changeset-*` commands can release one project at the repository root without a `wp-release.config.*` file. Run them from the root directory. With no version descriptor flags, they detect a root `package.json` or `composer.json` with a version, a plugin entry PHP file with a `Plugin Name` header, or a theme `style.css` with a `Theme Name` header. A detected plugin also updates the Stable tag in `readme.txt`, or `readme.md` when no Stable tag is found in `readme.txt`. Multiple version sources, multiple plugin entry files and npm workspaces require explicit descriptors or a config; files belonging to different projects aren't silently synchronized. A directory without a recognized version source still requires a config or explicit descriptors."},"97":{"id":"/js/wp-release/latest/changesets-9","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#single-project-repositories-without-a-config-file","content":"For a root npm package, the complete workflow needs no project flags:"},"98":{"id":"/js/wp-release/latest/changesets-10","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#single-project-repositories-without-a-config-file","content":"A single configured package is selected automatically for `changeset-add --bump` when `--since` isn't supplied, and for `changeset-tag --version`; `--since` still selects changed packages. npm and Composer projects use their root manifest's name as the changeset identifier when that manifest supplies the version; other projects use the root directory's basename. `--project-name <name>` pins the identifier of a repository without a manifest name, so local checkouts and CI don't need matching directory names; a config sets the same identifier with `id`. The fallback uses `.changeset/`, `CHANGELOG.md`, tags named `v{version}`, and the `origin` remote. There is no default comparison branch: pass `--since` or `--base-branch` when status checks should compare changes. Readme changelog updates are opt-in."},"99":{"id":"/js/wp-release/latest/changesets-11","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#single-project-repositories-without-a-config-file","content":"Explicit descriptors replace automatic detection and define the entire version target list. For a plugin whose version appears in its header, readme and a PHP constant:"},"100":{"id":"/js/wp-release/latest/changesets-12","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#single-project-repositories-without-a-config-file","content":"The same project flags belong on `changeset-add`, `changeset-status`, `changeset-version` and `changeset-tag`. Keep them consistent across all four commands, for example in command-specific npm scripts. An accompanying `package.json` used for build tools isn't changed unless it is included explicitly."},"101":{"id":"/js/wp-release/latest/changesets-13","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#single-project-repositories-without-a-config-file","content":"| Flag                            | Version descriptor                     |\n| ------------------------------- | -------------------------------------- |\n| `--version-package-json <file>` | npm manifest version source and target |","table":"table-0"},"102":{"id":"/js/wp-release/latest/changesets-14","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#single-project-repositories-without-a-config-file","content":"| Flag                             | Version descriptor                                                                                                       |\n| -------------------------------- | ------------------------------------------------------------------------------------------------------------------------ |\n| `--version-composer-json <file>` | Composer manifest version source and target; a target without a `version` field is skipped, while a source must have one |","table":"table-0"},"103":{"id":"/js/wp-release/latest/changesets-15","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#single-project-repositories-without-a-config-file","content":"| Flag                                | Version descriptor                                |\n| ----------------------------------- | ------------------------------------------------- |\n| `--version-wordpress-plugin <file>` | WordPress plugin Version header source and target |","table":"table-0"},"104":{"id":"/js/wp-release/latest/changesets-16","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#single-project-repositories-without-a-config-file","content":"| Flag                               | Version descriptor                               |\n| ---------------------------------- | ------------------------------------------------ |\n| `--version-wordpress-theme <file>` | WordPress theme Version header source and target |","table":"table-0"},"105":{"id":"/js/wp-release/latest/changesets-17","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#single-project-repositories-without-a-config-file","content":"| Flag                                    | Version descriptor                                                                                        |\n| --------------------------------------- | --------------------------------------------------------------------------------------------------------- |\n| `--version-wordpress-stable-tag <file>` | WordPress readme Stable tag source and target; keeps its stable version during pre-releases and snapshots |","table":"table-0"},"106":{"id":"/js/wp-release/latest/changesets-18","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#single-project-repositories-without-a-config-file","content":"| Flag                                       | Version descriptor                                  |\n| ------------------------------------------ | --------------------------------------------------- |\n| `--version-php-constant <file>#<constant>` | PHP `define()` or `const` version source and target |","table":"table-0"},"107":{"id":"/js/wp-release/latest/changesets-19","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#single-project-repositories-without-a-config-file","content":"| Flag                          | Version descriptor                                                                                                      |\n| ----------------------------- | ----------------------------------------------------------------------------------------------------------------------- |\n| `--version-git-tag <pattern>` | Current version from existing stable Git tags, with a pattern such as `v{version}`; source-only, never a version target |","table":"table-0"},"108":{"id":"/js/wp-release/latest/changesets-20","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#single-project-repositories-without-a-config-file","content":"File descriptor flags are repeatable. The source is inferred from a sole descriptor, or a unique descriptor other than a Stable tag. Otherwise use `--version-from <kind>`, where kind is `package-json`, `composer-json`, `wordpress-plugin`, `wordpress-theme`, `wordpress-stable-tag`, `php-constant` or `git-tag`. For repeated kinds, qualify the selector with the exact descriptor value: `--version-from package-json:package.json` or `--version-from 'php-constant:my-plugin.php#MY_PLUGIN_VERSION'`. Argument order doesn't select the source. A Git source requires a matching existing stable tag; its pattern selects the tags to read, while `--tag-format` controls tags to create. With multiple descriptors, explicitly select `git-tag` if it is the authoritative source."},"109":{"id":"/js/wp-release/latest/changesets-21","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#single-project-repositories-without-a-config-file","content":"| Shared option           | Config equivalent                                                                                                       |\n| ----------------------- | ----------------------------------------------------------------------------------------------------------------------- |\n| `--project-name <name>` | `id`, the literal changeset identifier of the root package, instead of the manifest name or checkout directory basename |","table":"table-1"},"110":{"id":"/js/wp-release/latest/changesets-22","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#single-project-repositories-without-a-config-file","content":"| Shared option            | Config equivalent                                                 |\n| ------------------------ | ----------------------------------------------------------------- |\n| `--base-branch <branch>` | `baseBranch`, used with the remote for the default comparison ref |","table":"table-1"},"111":{"id":"/js/wp-release/latest/changesets-23","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#single-project-repositories-without-a-config-file","content":"| Shared option     | Config equivalent                                       |\n| ----------------- | ------------------------------------------------------- |\n| `--remote <name>` | `remote`, used for comparisons and pushing release tags |","table":"table-1"},"112":{"id":"/js/wp-release/latest/changesets-24","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#single-project-repositories-without-a-config-file","content":"| Shared option            | Config equivalent                             |\n| ------------------------ | --------------------------------------------- |\n| `--changesets-dir <dir>` | `changesets`, relative to the repository root |","table":"table-1"},"113":{"id":"/js/wp-release/latest/changesets-25","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#single-project-repositories-without-a-config-file","content":"| Shared option                                  | Config equivalent                                                |\n| ---------------------------------------------- | ---------------------------------------------------------------- |\n| `--readme-changelog` / `--no-readme-changelog` | `readmeChangelog`, independent of updating the readme Stable tag |","table":"table-1"},"114":{"id":"/js/wp-release/latest/changesets-26","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#single-project-repositories-without-a-config-file","content":"| Shared option                       | Config equivalent                                                                                          |\n| ----------------------------------- | ---------------------------------------------------------------------------------------------------------- |\n| `--changelog-insert-after <marker>` | `changelogInsertAfter`; must exist in `CHANGELOG.md` and, with readme changelog updates, the plugin readme |","table":"table-1"},"115":{"id":"/js/wp-release/latest/changesets-27","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#single-project-repositories-without-a-config-file","content":"| Shared option           | Config equivalent                               |\n| ----------------------- | ----------------------------------------------- |\n| `--tag-format <format>` | `tagFormat`, replacing the default `v{version}` |","table":"table-1"},"116":{"id":"/js/wp-release/latest/changesets-28","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#single-project-repositories-without-a-config-file","content":"An explicit `--config` must load successfully. Otherwise a discovered config takes precedence over the single-project fallback. Single-project descriptor and settings flags cannot be mixed with a config file; put those settings in the config instead. The existing global `--tag-format` override works in both modes. Config files remain the place for package layouts, dependents, custom version and changelog callbacks, deployment destinations and distribution settings. Packaging and deployment commands retain their existing config requirements."},"117":{"id":"/js/wp-release/latest/changesets-29","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#single-project-repositories-without-a-config-file","content":"Typical release flow, from a feature pull request to the publish workflows triggered by release tags:"},"118":{"id":"/js/wp-release/latest/changesets-30","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#single-project-repositories-without-a-config-file","content":"An empty changeset marks a feature PR as no-release. The version workflow consumes it without changing versions, and a release PR containing only its deletion produces no tags."},"119":{"id":"/js/wp-release/latest/changesets-31","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#single-project-repositories-without-a-config-file","content":"`version.from` selects the current version; `version.to` lists release targets. Use `phpConstantVersion( { file, constant } )` to sync a PHP constant."},"120":{"id":"/js/wp-release/latest/changesets-32","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#single-project-checks-in-github-actions","content":"There are no dedicated build or changeset wrapper actions. Install the CLI in your project and run it directly. A root npm package can check a pull request with:"},"121":{"id":"/js/wp-release/latest/changesets-33","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#single-project-checks-in-github-actions","content":"For a plugin with several version targets, put the same descriptor flags in npm scripts for all four changeset commands. Full Git history and tags are needed for comparisons, Git version sources and release notes. Keep the checkout directory name consistent when it supplies the changeset identifier. Directory artifacts use `npx --no-install wp-release build --output dist/my-plugin --github-output`; upload that directory with your artifact action. `build` writes manifest sidecars outside the directory and does not accept the ZIP-only embedding, codec or manifest-filename flags."},"122":{"id":"/js/wp-release/latest/changesets-34","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#packages-and-tags","content":"The config describes the repository, so wp-release assumes no directory structure or naming convention of its own:"},"123":{"id":"/js/wp-release/latest/changesets-35","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#packages-and-tags","content":"**Packages** are the directories that the `glob` of a `packages` entry matches under `root`, with `*`, `?` and `**`, like `plugins/*`, or `.` for a repository with one package at its root. The settings of an entry apply to each of its packages. Discovery never looks inside `.git`, `node_modules`, `vendor` or `dist` directories. A package is identified by its path, or with `idFrom` by the name in its `package.json` or `composer.json`, or with a literal `id` when the group matches exactly one package, and commands that take a package accept a path or identifier."},"124":{"id":"/js/wp-release/latest/changesets-36","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#packages-and-tags","content":"**Templates** name the tags and the deploy targets of a package with these placeholders:"},"125":{"id":"/js/wp-release/latest/changesets-37","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#packages-and-tags","content":"| Placeholder | Value                                                                 | `plugins/alpha` | Root package |\n| ----------- | --------------------------------------------------------------------- | --------------- | ------------ |\n| `{path}`    | Package directory relative to `root`, empty for a package at the root | `plugins/alpha` | (empty)      |","table":"table-2"},"126":{"id":"/js/wp-release/latest/changesets-38","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#packages-and-tags","content":"| Placeholder | Value              | `plugins/alpha`                                     | Root package                             |\n| ----------- | ------------------ | --------------------------------------------------- | ---------------------------------------- |\n| `{name}`    | Package identifier | `plugins/alpha`, or its manifest name with `idFrom` | the manifest name, or the directory name |","table":"table-2"},"127":{"id":"/js/wp-release/latest/changesets-39","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#packages-and-tags","content":"| Placeholder | Value            | `plugins/alpha` | Root package |\n| ----------- | ---------------- | --------------- | ------------ |\n| `{version}` | Released version | `1.2.0`         | `1.2.0`      |","table":"table-2"},"128":{"id":"/js/wp-release/latest/changesets-40","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#packages-and-tags","content":"Deploy templates also have `{branch}`, `{ref}` and `{revision}` (see Deploy configured packages), and any template can be a callback that receives the package, for names that the placeholders don't cover, like the last directory of the path."},"129":{"id":"/js/wp-release/latest/changesets-41","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#packages-and-tags","content":"**`tagFormat`** names the release tags, `{path}/{version}` by default, like `plugins/alpha/1.2.0`. Empty placeholders leave no leading or repeated slashes in a tag, so a package at the root gets plain version tags, like `1.2.0`, from the same default. Deploy templates, like repository URLs, are filled in as they are. A `gitTagVersion()` version source reads the tags with its own `pattern`, also `{path}/{version}` by default, so set both when you change the format."},"130":{"id":"/js/wp-release/latest/changesets-42","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#packages-and-tags","content":"**`releaseTitle`** titles the release, like the `title` that `changeset-tag` reports for creating a GitHub Release. The default is `name@version`, like `plugins/alpha@1.2.0`, without the prefix for a package at the repository root, which is titled `1.2.0` like its tag. Like `tagFormat`, it supports `{name}`, `{path}`, `{version}` and `{tag}` placeholders: `releaseTitle: '{version} (beta)'`, or a callback that receives `{ package, version, tag }` like the release notes callback. A template without a placeholder fails at load time, since it would name every release alike. `changeset-tag --release-title <template>` replaces the `releaseTitle` of the config for one command, like `--tag-format` replaces `tagFormat`."},"131":{"id":"/js/wp-release/latest/changesets-43","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#packages-and-tags","content":"**`--tag-format <format>`** replaces the `tagFormat` of the config for one command, for a workflow or job that names its tags differently, like `--tag-format '{name}@{version}'`. Every command that creates or reads the same tags needs the same format: `changeset-tag`, which creates them and finds the previous tag for the release notes, `changeset-version --prerelease`, which numbers pre-releases from them, and `deploy-git` and `deploy-svn --release-ref`, which read the package and version of a tag."},"132":{"id":"/js/wp-release/latest/changesets-44","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#packages-and-tags","content":"**Slugs** are a WordPress concept: the folder of a plugin or theme. Only the commands that produce something for WordPress use one: the `{slug}/` root folder and name of a `zip`, the `checksums` manifest, the WordPress.org slug of `deploy-svn`, and `version-check`. Each takes `--slug`, which defaults to the name of the working directory, or of the package directory with `zip --package`, and an SVN deploy target takes `slug`, which defaults to the name of the package directory. Tags and Git deploy targets don't have a slug."},"133":{"id":"/js/wp-release/latest/changesets-45","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#packages-and-tags","content":"**`remote`** is the git remote that `changeset-tag --push` pushes tags to and that the base branch is compared on, `origin` by default."},"134":{"id":"/js/wp-release/latest/changesets-46","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#packages-and-tags","content":"The default strategy bumps stable `x.y.z` versions with SemVer rules, and the `x.y` and `x.y.z.w` versions common in WordPress plugins the same way: the bumped part is raised, the parts after it reset to `0`, and the version keeps its number of parts. A minor bump of `2.1` is `2.2` and a major bump is `3.0`, while a patch bump adds the third part, `2.1.1`. A patch bump of `1.2.3.4` is `1.2.4.0`, so raising only the fourth part needs a custom strategy. Configure `nextVersion( { package, bump, currentVersion, changesets } )` for other formats; changeset bumps remain `patch`, `minor` or `major`. Pre-releases are added to the next version with `--prerelease`, described below."},"135":{"id":"/js/wp-release/latest/changesets-47","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#packages-and-tags","content":"Without `--since`, `changeset-status` compares against `<remote>/<baseBranch>`, where `remote` in the config defaults to `origin` and is also the remote that `changeset-tag --push` pushes tags to; fetch that ref or pass `--since` when using a fork or different upstream. `loadChangesetConfig()` discovers a conventional config at the repository root, unless `--config <path>` selects one explicitly."},"136":{"id":"/js/wp-release/latest/changesets-48","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#packages-and-tags","content":"Add release notes in a feature PR with `npx wp-release changeset-add`. In a terminal, it lists the packages, marks the ones that changed since `<remote>/<baseBranch>` (or `--since <ref>`) without a changeset, and asks for the packages to release, a `patch`, `minor` or `major` bump for each, and the release note. Choose packages by number, identifier or path, or press Enter to release the changed ones; `none` adds an empty changeset. Changed files include uncommitted and untracked ones, since changesets are usually added before committing."},"137":{"id":"/js/wp-release/latest/changesets-49","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#packages-and-tags","content":"Without a terminal, or for scripts, pass the changeset as options: `npx wp-release changeset-add --package @vendor/plugin --bump patch --summary \"Fix the checkout validation.\"`. Repeat package and bump flags for multiple packages, or use `--empty` when no release is needed. A package can also be named by its path under `root`, like `plugins/alpha`, and the changeset records its identifier; `changeset-version --package` and `changeset-tag --package` accept paths too. A single `--bump` without `--package` releases every changed package without a changeset, like `changeset-add --bump patch --summary \"…\"` to fix a failing `changeset-status` check. `--json` and `--github-output` never ask."},"138":{"id":"/js/wp-release/latest/changesets-50","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#packages-and-tags","content":"In CI, `changeset-status --since origin/main` requires a changeset added by the PR; changesets already on the base do not count, while an empty PR changeset records an explicit no-release decision. Missing-change annotations identify an affected file."},"139":{"id":"/js/wp-release/latest/changesets-51","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#packages-and-tags","content":"On the release branch, preview with `changeset-version --dry-run`, then run `changeset-version` to update version targets and changelogs. By default, new Markdown entries go before the first version heading; `changelogInsertAfter` sets a literal insertion marker for `CHANGELOG.md` and, with `readmeChangelog`, the plugin readme. Put the marker in both files; a missing marker is an error. Without a marker, plugin readmes use the `== Changelog ==` heading. Failed updates are rolled back for safe retries."},"140":{"id":"/js/wp-release/latest/changesets-52","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#packages-and-tags","content":"Configure `changelogEntry( { package, changeset, commit } )` to format the changelog entry of each changeset, where `commit` is the `{ hash, shortHash, subject }` of the commit that added the changeset file, if it's committed. The formatted entries go into `CHANGELOG.md`, the `changelog` of each release in the `changeset-version` result, and so the release notes; plugin readmes keep the plain summaries. Without the callback, entries are the plain summaries. For example, to link each entry to its commit:"},"141":{"id":"/js/wp-release/latest/changesets-53","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#packages-and-tags","content":"Configure `dependents` to re-release packages that bundle a package when it releases. The dependents come from what the packages declare: a package is a dependent of a source when the spec that it declares in its npm `dependencies` or `optionalDependencies` (or the sections that the policy adds) resolves the current version of the source or points at the workspace, and it re-releases when the next version of the source falls outside the declared range, or always with `when: 'always'`. A pin to an older version selects a registry release instead and `changeset-status` warns about the drift until the pin resolves the package again. Versioning a dependent rewrites its declared specs of the source to the released version, keeping their range prefixes, so an exact pin matches the released workspace again and the built bundle matches the changelog. Wildcards and unpinned ranges accept the release without one, like the `devDependencies` of a package. The derived dependents appear in `changeset-status`, `changeset-version` and `changeset-tag` like any other release, and a dependent that releases for its own reasons keeps its own bump and appends the bundle note:"},"142":{"id":"/js/wp-release/latest/changesets-54","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#packages-and-tags","content":"Excluded packages still release with their own changesets and stay out of the automatic re-releases."},"143":{"id":"/js/wp-release/latest/changesets-55","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#packages-and-tags","content":"When the changesets of a pull request release a source, `changeset-status` requires no changeset for a dependent whose only change is the spec of that source in its `package.json`, since versioning rewrites the spec and the bundle note announces it. Any other change to the dependent, like another manifest field or dependency, documentation or code, needs its own changeset."},"144":{"id":"/js/wp-release/latest/changesets-56","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#packages-and-tags","content":"The bundle changelog entry defaults to `Bundle <source> <version>.` and is formatted with `dependents.changelog( { package, source } )`:"},"145":{"id":"/js/wp-release/latest/changesets-57","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#packages-and-tags","content":"`dependents.sections` lists the npm dependency sections that declare a source, defaulting to `dependencies` and `optionalDependencies`; add `devDependencies` for dependencies that end up in the dependent's build, or `peerDependencies` to scan them."},"146":{"id":"/js/wp-release/latest/changesets-58","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#packages-and-tags","content":"The `dependents.dependency` hooks extend the built-in npm scan instead of replacing it, so that both work behind the same range rule and rewrite:"},"147":{"id":"/js/wp-release/latest/changesets-59","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#packages-and-tags","content":"After versioning, run `npm install --package-lock-only` so that the root lockfile resolves the rewritten pins to the workspace links again; the `Prepare Release` workflow (`prepare-release.yml` in this monorepo) does it with its release pull request."},"148":{"id":"/js/wp-release/latest/changesets-60","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#packages-and-tags","content":"To release packages separately, for example with a release pull request for each, pass `--package <name>`, repeatable, to version only those packages. A changeset that also names other packages keeps only their entries and its summary, so it still applies to their releases with the same bump. Changesets without packages are left for a run without `--package`."},"149":{"id":"/js/wp-release/latest/changesets-61","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#packages-and-tags","content":"The `changeset-version` result lists each release with its `package`, `bump`, `currentVersion`, `nextVersion` and `changelog` entries, a Markdown list like the one added to `CHANGELOG.md`. Use it to name and describe the release pull request in a repository script, or call `versionChangesets()` from the library and format the entries of each release with `formatChangelogEntries( release.changesets )`."},"150":{"id":"/js/wp-release/latest/changesets-62","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#packages-and-tags","content":"After merging the release PR, `changeset-tag --since <merge-commit>^1 --push` pushes tags only for packages changed by that release. It pushes one tag at a time because GitHub doesn't trigger workflows for a push of more than three tags. wp-release doesn't create GitHub Releases: with `--json` or `--github-output`, each entry of `tags` has the `tag`, a `title` like `plugins/alpha@1.2.0` or, for a package at the repository root, the release title like `1.2.0` (see releaseTitle, and `--release-title` for overriding it in one command), the release `notes` and a `prerelease` flag, for a workflow step like `softprops/action-gh-release` to create the release (see the example below). For initial adoption, preview all missing tags with `changeset-tag --dry-run` (without `--since`), then push if needed. To release each package with a separate workflow instead, `changeset-tag --since <merge-commit>^1 --untagged --github-output` lists the releases that don't have a tag yet, without creating any. Tag pushes need Git write credentials."},"151":{"id":"/js/wp-release/latest/changesets-63","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#packages-and-tags","content":"To release a single package, for example from a manual workflow, pass `--package <name>`, repeatable, and with one package `--version <version>` to fail unless the package is at that version. Packages versioned by git tags have no version file, so for them `--version` is the version to tag. Before a tag is created, every `version.to` target must match the version, so a plugin `Version` header that disagrees with its readme `Stable tag` blocks the tag. Versions with a pre-release part, like `1.0.0-rc.1`, have `prerelease` set, so their GitHub Releases can be marked as pre-releases. This example selects one package, so `tags[0]` is its release; these fields are nested in the JSON result:"},"152":{"id":"/js/wp-release/latest/changesets-64","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#packages-and-tags","content":"The release notes are the version's `CHANGELOG.md` section, or without one the commits that changed the package since its previous tag, the highest version below the released one, skipping pre-releases for a stable version. Configure `releaseNotes( { package, version, tag, previousTag, changelog, commits, notes } )` to format them, for example to add links; `notes` is the default text and `commits` lists `{ hash, shortHash, subject }`, newest first. `changeset-tag --package <name> --dry-run` prints them without creating the tag."},"153":{"id":"/js/wp-release/latest/changesets-65","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#packages-and-tags","content":"For local development, run the TypeScript source with `npm run wp-release -- <command>` (for example, `npm run wp-release -- changeset-status --since origin/main`). GitHub workflows use the same CLI for versioning and tagging. `SUBTREE_DEPLOY_TOKEN` lets them update the release PR and push tags, and the `Tag Release` workflow passes it to `softprops/action-gh-release` to create the GitHub Releases."},"154":{"id":"/js/wp-release/latest/changesets-66","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#pre-releases","content":"`changeset-version --prerelease <id>` (the `prerelease` option of `versionChangesets()`) releases pre-releases of the next versions, like `1.3.0-rc.1` for a minor bump of `1.2.0`. The identifier, like `alpha`, `beta` or `rc`, can have a number, like `rc.2`, which is used as is and fails when the version is already tagged. Without a number, the number is one above the highest existing tag of that identifier and next stable version, read with the `tagFormat` of the package, so the first one is `rc.1`, and the numbering starts again at `.1` when later changesets raise the next version. The dependents of a source become pre-releases too, so that they bundle its pre-release, unless they're left out with `--no-dependents`."},"155":{"id":"/js/wp-release/latest/changesets-67","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#pre-releases","content":"A pre-release writes every version target except the readme `Stable tag`, which keeps the last stable version since WordPress.org offers it to every site, and `changeset-tag` skips the `Stable tag` when it verifies a pre-release. The changelog gets a section for the pre-release, like `## 1.3.0-rc.1 (2026-10-12)`, so that `changeset-tag` finds its release notes, and the changesets are consumed like in any release."},"156":{"id":"/js/wp-release/latest/changesets-68","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#pre-releases","content":"Since a pre-release consumes the changesets that the stable release needs, run it on a branch that isn't merged, and tag that branch commit:"},"157":{"id":"/js/wp-release/latest/changesets-69","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#pre-releases","content":"The base branch keeps its stable versions and pending changesets, so the stable release later versions them as usual, in one changelog section. The tag keeps the pre-release commit reachable after the branch is reset or deleted. The release notes of a stable release compare with the previous stable release, skipping the pre-releases before it, and the `git-tag` version source ignores pre-release tags, so packages versioned by git tags keep building on their last stable version."},"158":{"id":"/js/wp-release/latest/changesets-70","page_id":"/js/wp-release/latest/changesets","tags":[],"type":"text","url":"/js/wp-release/latest/changesets#snapshots","content":"`changeset-version --snapshot <id>` (the `snapshot` option of `versionChangesets()`) releases snapshots of the next versions for test builds, like `1.3.0-pr-251.20261012183005` for a pull request: the next version with the identifier, like `pr-251` or `pr-251.0abc123` with a commit hash, and the UTC time, so that every snapshot is unique and they sort by time. Snapshots aren't numbered from tags and can't be combined with `--prerelease`. Like a pre-release, a snapshot writes every version target except the readme `Stable tag`. Build and publish the versioned files without committing them, for example under an npm dist-tag like `pr-251`, since a snapshot consumes the changesets:"},"159":{"id":"/js/wp-release/latest/cli","page_id":"/js/wp-release/latest/cli","type":"page","content":"CLI","breadcrumbs":["Docs","Js","Wp release","Latest"],"tags":[],"url":"/js/wp-release/latest/cli"},"160":{"id":"/js/wp-release/latest/cli-0","page_id":"/js/wp-release/latest/cli","type":"heading","tags":[],"url":"/js/wp-release/latest/cli#cli","content":"CLI"},"161":{"id":"/js/wp-release/latest/cli-1","page_id":"/js/wp-release/latest/cli","type":"heading","tags":[],"url":"/js/wp-release/latest/cli#github-actions-annotations-and-job-summaries","content":"GitHub Actions annotations and job summaries"},"162":{"id":"/js/wp-release/latest/cli-2","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#cli","content":"| Command                                                    | Description                                   |\n| ---------------------------------------------------------- | --------------------------------------------- |\n| `wp-release build [<source-dir>] --output <dir> [options]` | Copy selected release files into a directory. |","table":"table-0"},"163":{"id":"/js/wp-release/latest/cli-3","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#cli","content":"| Command                                   | Description                                                                  |\n| ----------------------------------------- | ---------------------------------------------------------------------------- |\n| `wp-release zip [<source-dir>] [options]` | Create a ZIP archive with a `{slug}/` root folder, respecting `.distignore`. |","table":"table-0"},"164":{"id":"/js/wp-release/latest/cli-4","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#cli","content":"| Command                                         | Description                                                                         |\n| ----------------------------------------------- | ----------------------------------------------------------------------------------- |\n| `wp-release checksums [<source-dir>] [options]` | Write the MD5 and SHA-256 hashes of every distributed file to a checksums manifest. |","table":"table-0"},"165":{"id":"/js/wp-release/latest/cli-5","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#cli","content":"| Command                               | Description                                                                                                            |\n| ------------------------------------- | ---------------------------------------------------------------------------------------------------------------------- |\n| `wp-release sign <file>... [options]` | Sign files with Ed25519, writing a detached `<file>.sig` next to each, or minisign and SSH signatures with `--format`. |","table":"table-0"},"166":{"id":"/js/wp-release/latest/cli-6","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#cli","content":"| Command             | Description                                                                                      |\n| ------------------- | ------------------------------------------------------------------------------------------------ |\n| `wp-release keygen` | Generate a base64 Ed25519 private seed and its public key, also as minisign and SSH public keys. |","table":"table-0"},"167":{"id":"/js/wp-release/latest/cli-7","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#cli","content":"| Command                                                         | Description                                                                |\n| --------------------------------------------------------------- | -------------------------------------------------------------------------- |\n| `wp-release verify [<source-dir>] --checksums <file> [options]` | Check a plugin or theme directory, or a ZIP, against a checksums manifest. |","table":"table-0"},"168":{"id":"/js/wp-release/latest/cli-8","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#cli","content":"| Command                                             | Description                                                                            |\n| --------------------------------------------------- | -------------------------------------------------------------------------------------- |\n| `wp-release version-check [<source-dir>] [options]` | Check that the `Version` header, readme `Stable tag`, PHP constants and git tag agree. |","table":"table-0"},"169":{"id":"/js/wp-release/latest/cli-9","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#cli","content":"| Command                                          | Description                                                 |\n| ------------------------------------------------ | ----------------------------------------------------------- |\n| `wp-release deploy-svn [<source-dir>] [options]` | Deploy a plugin to the WordPress.org plugin SVN repository. |","table":"table-0"},"170":{"id":"/js/wp-release/latest/cli-10","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#cli","content":"| Command                                                          | Description                                                                             |\n| ---------------------------------------------------------------- | --------------------------------------------------------------------------------------- |\n| `wp-release deploy-git [<source-dir>] --git-url <url> [options]` | Deploy the files of a plugin, theme or package to a Git repository as a release commit. |","table":"table-0"},"171":{"id":"/js/wp-release/latest/cli-11","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#cli","content":"| Command                                                                 | Description                                                                     |\n| ----------------------------------------------------------------------- | ------------------------------------------------------------------------------- |\n| `wp-release deploy-git --release-ref <ref> [--package <name>] [--list]` | Deploy the configured packages of a release tag or branch to their Git targets. |","table":"table-0"},"172":{"id":"/js/wp-release/latest/cli-12","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#cli","content":"| Command                                                                 | Description                                                     |\n| ----------------------------------------------------------------------- | --------------------------------------------------------------- |\n| `wp-release deploy-svn --release-ref <ref> [--package <name>] [--list]` | Deploy the configured plugin of a release tag to WordPress.org. |","table":"table-0"},"173":{"id":"/js/wp-release/latest/cli-13","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#cli","content":"| Command                                        | Description                                                |\n| ---------------------------------------------- | ---------------------------------------------------------- |\n| `wp-release i18n-pot [<source-dir>] [options]` | Extract translatable strings into a reproducible POT file. |","table":"table-0"},"174":{"id":"/js/wp-release/latest/cli-14","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#cli","content":"| Command                                          | Description                                               |\n| ------------------------------------------------ | --------------------------------------------------------- |\n| `wp-release i18n-audit [<source-dir>] [options]` | Report translation string problems without writing files. |","table":"table-0"},"175":{"id":"/js/wp-release/latest/cli-15","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#cli","content":"| Command                                  | Description                           |\n| ---------------------------------------- | ------------------------------------- |\n| `wp-release i18n-mo <file.po> [options]` | Compile a translated PO file into MO. |","table":"table-0"},"176":{"id":"/js/wp-release/latest/cli-16","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#cli","content":"| Command                                                      | Description                                                                              |\n| ------------------------------------------------------------ | ---------------------------------------------------------------------------------------- |\n| `wp-release i18n-json <file.po> --domain <domain> [options]` | Compile the JavaScript strings of a translated PO file into WordPress script JSON files. |","table":"table-0"},"177":{"id":"/js/wp-release/latest/cli-17","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#cli","content":"| Command                                   | Description                                                     |\n| ----------------------------------------- | --------------------------------------------------------------- |\n| `wp-release i18n-php <file.po> [options]` | Compile a translated PO file into a WordPress `.l10n.php` file. |","table":"table-0"},"178":{"id":"/js/wp-release/latest/cli-18","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#cli","content":"| Command                              | Description                                  |\n| ------------------------------------ | -------------------------------------------- |\n| `wp-release changeset-add [options]` | Record the release impact of a pull request. |","table":"table-0"},"179":{"id":"/js/wp-release/latest/cli-19","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#cli","content":"| Command                                 | Description                                                      |\n| --------------------------------------- | ---------------------------------------------------------------- |\n| `wp-release changeset-status [options]` | List pending releases and check changed packages for changesets. |","table":"table-0"},"180":{"id":"/js/wp-release/latest/cli-20","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#cli","content":"| Command                                  | Description                                |\n| ---------------------------------------- | ------------------------------------------ |\n| `wp-release changeset-version [options]` | Apply version bumps and changelog entries. |","table":"table-0"},"181":{"id":"/js/wp-release/latest/cli-21","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#cli","content":"| Command                              | Description                          |\n| ------------------------------------ | ------------------------------------ |\n| `wp-release changeset-tag [options]` | Create missing package release tags. |","table":"table-0"},"182":{"id":"/js/wp-release/latest/cli-22","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#cli","content":"Run `npx wp-release <command> --help` for the options of each command. Directory-based commands accept a first `<source-dir>` argument or `--source-dir`, defaulting to the current directory. `sign` and the `i18n-mo`, `i18n-json` and `i18n-php` compilers take file arguments, `keygen` generates keys, and changeset commands operate on the configured repository. Every command prints its result as JSON with `--json`. Commands that take no positional arguments, like the changeset commands, reject bare arguments with the usage instead of ignoring them."},"183":{"id":"/js/wp-release/latest/cli-23","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#cli","content":"In GitHub Actions, `--github-output` writes the complete result as JSON to `steps.<id>.outputs.result` and exposes each top-level string, number or boolean as a plain output. Use `steps.zip.outputs.zipPath` for a ZIP path, for example. Arrays and objects remain in `result`: tag metadata is read with `fromJSON( steps.tag.outputs.result ).tags[0].tag`, even when only one package is selected. There is no plain `steps.tag.outputs.tag` output."},"184":{"id":"/js/wp-release/latest/cli-24","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#cli","content":"Prefer plain outputs in steps that run conditionally, since a skipped step has empty outputs. When reading JSON from a step that may be skipped, use a fallback such as `fromJSON( steps.tag.outputs.result || '{\"tags\":[]}' ).tags[0].tag`. For several tags or deploys, read the arrays in `result` to build a job matrix or process each item."},"185":{"id":"/js/wp-release/latest/cli-25","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#github-actions-annotations-and-job-summaries","content":"With the `github` log format, the CLI uses current GitHub Actions features to report problems where you look for them, instead of only in the log. `--log-format <name>` picks how the CLI logs, separately from the result that `--json` prints:"},"186":{"id":"/js/wp-release/latest/cli-26","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#github-actions-annotations-and-job-summaries","content":"| Log format | Output                                          |\n| ---------- | ----------------------------------------------- |\n| `text`     | Plain text. The default outside GitHub Actions. |","table":"table-1"},"187":{"id":"/js/wp-release/latest/cli-27","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#github-actions-annotations-and-job-summaries","content":"| Log format | Output                                                                                                              |\n| ---------- | ------------------------------------------------------------------------------------------------------------------- |\n| `github`   | GitHub Actions annotations and job summaries. The default when `GITHUB_ACTIONS=true`. `--ci` is a shorthand for it. |","table":"table-1"},"188":{"id":"/js/wp-release/latest/cli-28","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#github-actions-annotations-and-job-summaries","content":"Pass `--log-format text` for plain text in GitHub Actions. The GitHub Actions always use the `github` log format. Only the CLI checks `GITHUB_ACTIONS`: the library classes don't read the environment, and choose the format by the writer they get."},"189":{"id":"/js/wp-release/latest/cli-29","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#github-actions-annotations-and-job-summaries","content":"Errors, warnings and notices are printed as workflow commands, so they show up as annotations on the run and on the files of a pull request:"},"190":{"id":"/js/wp-release/latest/cli-30","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#github-actions-annotations-and-job-summaries","content":"`version-check` and `deploy-svn` annotate each version mismatch on the file and line of the version: the `Version` header, the readme `Stable tag` or the PHP constant."},"191":{"id":"/js/wp-release/latest/cli-31","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#github-actions-annotations-and-job-summaries","content":"`verify` annotates each changed file and each file that isn't in the checksums."},"192":{"id":"/js/wp-release/latest/cli-32","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#github-actions-annotations-and-job-summaries","content":"Each command also adds a section to the job summary of the run, when `GITHUB_STEP_SUMMARY` is set:"},"193":{"id":"/js/wp-release/latest/cli-33","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#github-actions-annotations-and-job-summaries","content":"| Command      | Summary                                                                                                                                                                                            |\n| ------------ | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `deploy-svn` | Plugin, linked to its WordPress.org page, version, written SVN paths, the commit linked to its WordPress.org changeset (or the dry run or no-op result), and the SVN changes in a collapsed table. |","table":"table-2"},"194":{"id":"/js/wp-release/latest/cli-34","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#github-actions-annotations-and-job-summaries","content":"| Command      | Summary                                                   |\n| ------------ | --------------------------------------------------------- |\n| `deploy-git` | Repository, release commit and the pushed branch and tag. |","table":"table-2"},"195":{"id":"/js/wp-release/latest/cli-35","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#github-actions-annotations-and-job-summaries","content":"| Command | Summary                                                                                               |\n| ------- | ----------------------------------------------------------------------------------------------------- |\n| `build` | Output directory, number of copied files and optional manifest; requested signatures and public keys. |","table":"table-2"},"196":{"id":"/js/wp-release/latest/cli-36","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#github-actions-annotations-and-job-summaries","content":"| Command | Summary                                                                                                                |\n| ------- | ---------------------------------------------------------------------------------------------------------------------- |\n| `zip`   | ZIP, number of files and checksums manifest; with `--sign`, signature files and the public key of each written format. |","table":"table-2"},"197":{"id":"/js/wp-release/latest/cli-37","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#github-actions-annotations-and-job-summaries","content":"| Command     | Summary                       |\n| ----------- | ----------------------------- |\n| `checksums` | Manifest and number of files. |","table":"table-2"},"198":{"id":"/js/wp-release/latest/cli-38","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#github-actions-annotations-and-job-summaries","content":"| Command | Summary                                                    |\n| ------- | ---------------------------------------------------------- |\n| `sign`  | Signature files and the public key of each written format. |","table":"table-2"},"199":{"id":"/js/wp-release/latest/cli-39","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#github-actions-annotations-and-job-summaries","content":"| Command  | Summary                                                                                  |\n| -------- | ---------------------------------------------------------------------------------------- |\n| `verify` | That all files match, or the counts and a table of the changed, missing and extra files. |","table":"table-2"},"200":{"id":"/js/wp-release/latest/cli-40","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#github-actions-annotations-and-job-summaries","content":"| Command         | Summary                                                                        |\n| --------------- | ------------------------------------------------------------------------------ |\n| `version-check` | The matching version, or a table of the mismatches with their files and lines. |","table":"table-2"},"201":{"id":"/js/wp-release/latest/cli-41","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#github-actions-annotations-and-job-summaries","content":"| Command            | Summary                                               |\n| ------------------ | ----------------------------------------------------- |\n| `changeset-status` | Each changed package with whether it has a changeset. |","table":"table-2"},"202":{"id":"/js/wp-release/latest/cli-42","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#github-actions-annotations-and-job-summaries","content":"| Command             | Summary                                                               |\n| ------------------- | --------------------------------------------------------------------- |\n| `changeset-version` | A table of the package releases with their version changes and bumps. |","table":"table-2"},"203":{"id":"/js/wp-release/latest/cli-43","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#github-actions-annotations-and-job-summaries","content":"| Command         | Summary                                                                                  |\n| --------------- | ---------------------------------------------------------------------------------------- |\n| `changeset-tag` | Each tag with its previous tag and status, and its release notes in a collapsed section. |","table":"table-2"},"204":{"id":"/js/wp-release/latest/cli-44","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#github-actions-annotations-and-job-summaries","content":"A failed command adds its error to the summary, or a table of its problems with their files and lines, listing up to 100 and counting the rest. The Markdown of the summaries isn't part of the library API. File paths are relative to `GITHUB_WORKSPACE`, or the current directory without it. Files outside it, like those of an extracted ZIP, get an annotation without a file. Multi-line messages stay one annotation."},"205":{"id":"/js/wp-release/latest/cli-45","page_id":"/js/wp-release/latest/cli","tags":[],"type":"text","url":"/js/wp-release/latest/cli#github-actions-annotations-and-job-summaries","content":"Use global `--config <path>` to select a config; relative paths resolve from the current directory. Otherwise, commands using the config discover `wp-release.config.js`, `.mjs` or `.cjs` at the repository root. Global `--tag-format <format>` replaces the `tagFormat` of the config for one command, see Packages and tags."},"206":{"id":"/js/wp-release/latest/comparison","page_id":"/js/wp-release/latest/comparison","type":"page","content":"Comparison with other tools","breadcrumbs":["Docs","Js","Wp release","Latest"],"tags":[],"url":"/js/wp-release/latest/comparison"},"207":{"id":"/js/wp-release/latest/comparison-0","page_id":"/js/wp-release/latest/comparison","type":"heading","tags":[],"url":"/js/wp-release/latest/comparison#comparison-with-existing-tools","content":"Comparison with existing tools"},"208":{"id":"/js/wp-release/latest/comparison-1","page_id":"/js/wp-release/latest/comparison","tags":[],"type":"text","url":"/js/wp-release/latest/comparison#comparison-with-existing-tools","content":"| Tool                                                             | What it does                                                                                                                                                                                                                                                                                                                | How `wp-release` differs                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |\n| ---------------------------------------------------------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| 10up WordPress.org plugin deploy and readme/asset update actions | Two separate GitHub Actions configured through env vars. A deploy always syncs the build to `trunk/` and copies it to the tag; readme and asset updates need the second action. Assets come from `.wordpress-org` by default, and files are selected with `.distignore` or `.gitattributes`. Files are synced with `rsync`. | One `deploy-svn` command with independent write flags, so a release, a readme-only update and an assets-only update are the same command with different flags. Runs locally and in any CI, not only GitHub Actions, and syncs in Node.js without `rsync`. Checks that the `Version` header, readme `Stable tag` and SVN tag agree before writing, which the 10up actions don't. Assets are deployed only when `--assets-dir` is passed, instead of always syncing `.wordpress-org` when it exists, so a plugin's own `assets/` folder is never uploaded by accident. Adds `--exclude` for patterns without an ignore file, opt-in Git `export-ignore` support and `--from-zip` to deploy the exact files of a ZIP. |","table":"table-0"},"209":{"id":"/js/wp-release/latest/comparison-2","page_id":"/js/wp-release/latest/comparison","tags":[],"type":"text","url":"/js/wp-release/latest/comparison#comparison-with-existing-tools","content":"| Tool              | What it does                                                                                                     | How `wp-release` differs                                                                                                                                                                  |\n| ----------------- | ---------------------------------------------------------------------------------------------------------------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `grunt-wp-deploy` | Grunt task with `deploy_trunk` and `deploy_tag` booleans, interactive password prompts and a `Stable tag` check. | No Grunt dependency and never interactive. `--readme-only` is a separate flag, where `grunt-wp-deploy` can only update trunk with the full build. Assets are independent of trunk writes. |","table":"table-0"},"210":{"id":"/js/wp-release/latest/comparison-3","page_id":"/js/wp-release/latest/comparison","tags":[],"type":"text","url":"/js/wp-release/latest/comparison#comparison-with-existing-tools","content":"| Tool                  | What it does                                                                     | How `wp-release` differs                                                                                                           |\n| --------------------- | -------------------------------------------------------------------------------- | ---------------------------------------------------------------------------------------------------------------------------------- |\n| codeinwp theme deploy | Fork of the 10up plugin action that commits themes to the themes SVN repository. | Doesn't deploy themes. Theme releases are ZIP uploads on WordPress.org; `zip` builds the upload with the theme folder as the root. |","table":"table-0"},"211":{"id":"/js/wp-release/latest/comparison-4","page_id":"/js/wp-release/latest/comparison","tags":[],"type":"text","url":"/js/wp-release/latest/comparison#comparison-with-existing-tools","content":"| Tool              | What it does                                                                                             | How `wp-release` differs                                                                                                                                                                                                                                                                                                                                                                      |\n| ----------------- | -------------------------------------------------------------------------------------------------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `wp dist-archive` | WP-CLI command that zips a project using `.distignore`, with `--plugin-dirname` and `--filename-format`. | Same `.distignore` file and `{name}.{version}` style filename format, but needs only Node.js instead of PHP and WP-CLI. `.distignore` is matched with full gitignore syntax, including `!` negation, and `--distignore` / `--exclude` let you point at another ignore file or add patterns on the command line. Builds are reproducible, and `--checksums` writes a manifest next to the ZIP. |","table":"table-0"},"212":{"id":"/js/wp-release/latest/comparison-5","page_id":"/js/wp-release/latest/comparison","tags":[],"type":"text","url":"/js/wp-release/latest/comparison#comparison-with-existing-tools","content":"| Tool               | What it does                                                                                                                                                                                                        | How `wp-release` differs                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |\n| ------------------ | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `wp i18n make-pot` | WP-CLI command that extracts PHP, JavaScript, `block.json` and `theme.json` strings into a POT, with `--domain`, `--include`/`--exclude`, `--headers`, `--file-comment`, `--merge`/`--subtract` and audit warnings. | `i18n-pot` and `i18n-audit` need only Node.js, write byte-for-byte reproducible POTs without dates, and `--check` fails CI on a stale POT. Headers are set one at a time with a repeatable `--header NAME=VALUE` instead of a JSON object, and `--include`/`--exclude` take one glob each, so patterns never need escaping or comma splitting. `--add-location`, `--no-location` and `--all-domains` say what they do, and `--add-location file` drops line numbers so that unrelated edits don't make the POT stale. Monorepos keep these settings once in `wp-release.config.js` and select packages with `--package` or `--all` instead of running the command for every directory. The audit is a separate read-only command with stable finding codes for `--suppress`, instead of warnings mixed into generation. There's no `--merge`, `--subtract` or `--skip-*`; `--include` and `--exclude` cover the same needs. |","table":"table-0"},"213":{"id":"/js/wp-release/latest/comparison-6","page_id":"/js/wp-release/latest/comparison","tags":[],"type":"text","url":"/js/wp-release/latest/comparison#comparison-with-existing-tools","content":"| Tool                                          | What it does                                                                                                                                                                                          | How `wp-release` differs                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |\n| --------------------------------------------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `wp i18n make-mo`, `make-json` and `make-php` | WP-CLI commands that compile PO files into MO, script JSON and `.l10n.php` files. `make-json` maps sources with `--use-map` and removes JavaScript strings from the PO unless `--no-purge` is passed. | `i18n-mo`, `i18n-json` and `i18n-php` compile one translated PO at a time, never change it, and leave out fuzzy, obsolete and untranslated entries. `i18n-json` takes a many-to-many `--map` from source files to built scripts, and JSX and TypeScript sources need one, so catalogs are never written for files WordPress doesn't load. `--check` compares the outputs without writing. There's no `update-po`, so update PO files from the POT with gettext's `msgmerge` or a translation platform. |","table":"table-0"},"214":{"id":"/js/wp-release/latest/comparison-7","page_id":"/js/wp-release/latest/comparison","tags":[],"type":"text","url":"/js/wp-release/latest/comparison#comparison-with-existing-tools","content":"| Tool                         | What it does                                                                          | How `wp-release` differs                                                                                                                                                                                                                        |\n| ---------------------------- | ------------------------------------------------------------------------------------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `wp plugin verify-checksums` | WP-CLI command that checks installed plugins against the WordPress.org checksums API. | Reads the same manifest format, but from a file, so it also works for plugins and themes that aren't hosted on WordPress.org and for build directories in CI. `checksums` writes the manifest that WordPress.org generates for its own plugins. |","table":"table-0"},"215":{"id":"/js/wp-release/latest/comparison-8","page_id":"/js/wp-release/latest/comparison","tags":[],"type":"text","url":"/js/wp-release/latest/comparison#comparison-with-existing-tools","content":"| Tool                    | What it does                                                                                                                         | How `wp-release` differs                                                                                                                                                                                                                              |\n| ----------------------- | ------------------------------------------------------------------------------------------------------------------------------------ | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `wp-scripts plugin-zip` | Zips files from `package.json` `files` or a fixed allowlist, named after the npm package, with `--root-folder` / `--no-root-folder`. | Reuses the root folder flags, selects files with `.distignore` by default and can optionally honor Git `export-ignore` attributes, puts the version from the plugin headers in the filename and streams the archive instead of building it in memory. |","table":"table-0"},"216":{"id":"/js/wp-release/latest/configuration","page_id":"/js/wp-release/latest/configuration","type":"page","content":"Configuration","breadcrumbs":["Docs","Js","Wp release","Latest"],"tags":[],"url":"/js/wp-release/latest/configuration"},"217":{"id":"/js/wp-release/latest/configuration-0","page_id":"/js/wp-release/latest/configuration","type":"heading","tags":[],"url":"/js/wp-release/latest/configuration#naming-convention","content":"Naming convention"},"218":{"id":"/js/wp-release/latest/configuration-1","page_id":"/js/wp-release/latest/configuration","type":"heading","tags":[],"url":"/js/wp-release/latest/configuration#file-selection","content":"File selection"},"219":{"id":"/js/wp-release/latest/configuration-2","page_id":"/js/wp-release/latest/configuration","type":"heading","tags":[],"url":"/js/wp-release/latest/configuration#plugin-and-theme-headers","content":"Plugin and theme headers"},"220":{"id":"/js/wp-release/latest/configuration-3","page_id":"/js/wp-release/latest/configuration","tags":[],"type":"text","url":"/js/wp-release/latest/configuration#naming-convention","content":"`@wpelevator/wp-release` is the suite of release tools and `wp-release` is its CLI. \"Release\" is the whole workflow; each command is one operation in it. Commands are flat: a single word or dashed words like `version-check` and `deploy-svn`, without command groups or aliases. Each GitHub Action is named `wp-release-` followed by the command name, so the CLI command and the `uses:` name always match:"},"221":{"id":"/js/wp-release/latest/configuration-4","page_id":"/js/wp-release/latest/configuration","tags":[],"type":"text","url":"/js/wp-release/latest/configuration#naming-convention","content":"| Capability        | CLI command        | GitHub Action |\n| ----------------- | ------------------ | ------------- |\n| Build a directory | `wp-release build` |               |","table":"table-0"},"222":{"id":"/js/wp-release/latest/configuration-5","page_id":"/js/wp-release/latest/configuration","tags":[],"type":"text","url":"/js/wp-release/latest/configuration#naming-convention","content":"| Capability  | CLI command      | GitHub Action               |\n| ----------- | ---------------- | --------------------------- |\n| Build a ZIP | `wp-release zip` | `wpelevator/wp-release-zip` |","table":"table-0"},"223":{"id":"/js/wp-release/latest/configuration-6","page_id":"/js/wp-release/latest/configuration","tags":[],"type":"text","url":"/js/wp-release/latest/configuration#naming-convention","content":"| Capability                  | CLI command            | GitHub Action                     |\n| --------------------------- | ---------------------- | --------------------------------- |\n| Create a checksums manifest | `wp-release checksums` | `wpelevator/wp-release-checksums` |","table":"table-0"},"224":{"id":"/js/wp-release/latest/configuration-7","page_id":"/js/wp-release/latest/configuration","tags":[],"type":"text","url":"/js/wp-release/latest/configuration#naming-convention","content":"| Capability | CLI command       | GitHub Action                |\n| ---------- | ----------------- | ---------------------------- |\n| Sign files | `wp-release sign` | `wpelevator/wp-release-sign` |","table":"table-0"},"225":{"id":"/js/wp-release/latest/configuration-8","page_id":"/js/wp-release/latest/configuration","tags":[],"type":"text","url":"/js/wp-release/latest/configuration#naming-convention","content":"| Capability                      | CLI command         | GitHub Action |\n| ------------------------------- | ------------------- | ------------- |\n| Verify files against a manifest | `wp-release verify` |               |","table":"table-0"},"226":{"id":"/js/wp-release/latest/configuration-9","page_id":"/js/wp-release/latest/configuration","tags":[],"type":"text","url":"/js/wp-release/latest/configuration#naming-convention","content":"| Capability                    | CLI command                | GitHub Action |\n| ----------------------------- | -------------------------- | ------------- |\n| Check that the versions agree | `wp-release version-check` |               |","table":"table-0"},"227":{"id":"/js/wp-release/latest/configuration-10","page_id":"/js/wp-release/latest/configuration","tags":[],"type":"text","url":"/js/wp-release/latest/configuration#naming-convention","content":"| Capability                  | CLI command             | GitHub Action                      |\n| --------------------------- | ----------------------- | ---------------------------------- |\n| Deploy to WordPress.org SVN | `wp-release deploy-svn` | `wpelevator/wp-release-deploy-svn` |","table":"table-0"},"228":{"id":"/js/wp-release/latest/configuration-11","page_id":"/js/wp-release/latest/configuration","tags":[],"type":"text","url":"/js/wp-release/latest/configuration#naming-convention","content":"| Capability                 | CLI command             | GitHub Action |\n| -------------------------- | ----------------------- | ------------- |\n| Deploy to a Git repository | `wp-release deploy-git` |               |","table":"table-0"},"229":{"id":"/js/wp-release/latest/configuration-12","page_id":"/js/wp-release/latest/configuration","tags":[],"type":"text","url":"/js/wp-release/latest/configuration#naming-convention","content":"The names below are scoped to their commands. `--output` selects the primary artifact of each command; ZIP packaging uses `--checksums-file` for its accompanying manifest:"},"230":{"id":"/js/wp-release/latest/configuration-13","page_id":"/js/wp-release/latest/configuration","tags":[],"type":"text","url":"/js/wp-release/latest/configuration#naming-convention","content":"| Concept                   | CLI                                       | GitHub Action | Library     | Meaning                                                                           |\n| ------------------------- | ----------------------------------------- | ------------- | ----------- | --------------------------------------------------------------------------------- |\n| Plugin or theme directory | `<source-dir>` argument or `--source-dir` | `source-dir`  | `sourceDir` | Directory that a command reads, whether it's the repository or a build directory. |","table":"table-1"},"231":{"id":"/js/wp-release/latest/configuration-14","page_id":"/js/wp-release/latest/configuration","tags":[],"type":"text","url":"/js/wp-release/latest/configuration#naming-convention","content":"| Concept         | CLI                    | GitHub Action | Library     | Meaning                                                    |\n| --------------- | ---------------------- | ------------- | ----------- | ---------------------------------------------------------- |\n| Build directory | `build --output <dir>` | —             | `outputDir` | Directory written by `build`; files go directly inside it. |","table":"table-1"},"232":{"id":"/js/wp-release/latest/configuration-15","page_id":"/js/wp-release/latest/configuration","tags":[],"type":"text","url":"/js/wp-release/latest/configuration#naming-convention","content":"| Concept  | CLI                   | GitHub Action          | Library   | Meaning                                                           |\n| -------- | --------------------- | ---------------------- | --------- | ----------------------------------------------------------------- |\n| ZIP file | `zip --output <file>` | `output` in ZIP action | `zipPath` | Destination passed to `zipPackage()`; also returned as `zipPath`. |","table":"table-1"},"233":{"id":"/js/wp-release/latest/configuration-16","page_id":"/js/wp-release/latest/configuration","tags":[],"type":"text","url":"/js/wp-release/latest/configuration#naming-convention","content":"| Concept                   | CLI                         | GitHub Action                | Library                              | Meaning                                                                                                       |\n| ------------------------- | --------------------------- | ---------------------------- | ------------------------------------ | ------------------------------------------------------------------------------------------------------------- |\n| Standalone checksums file | `checksums --output <file>` | `output` in checksums action | first argument of `writeChecksums()` | Manifest destination relative to the working directory; the CLI returns its absolute path as `checksumsPath`. |","table":"table-1"},"234":{"id":"/js/wp-release/latest/configuration-17","page_id":"/js/wp-release/latest/configuration","tags":[],"type":"text","url":"/js/wp-release/latest/configuration#naming-convention","content":"| Concept                         | CLI                           | GitHub Action                  | Library         | Meaning                                                                             |\n| ------------------------------- | ----------------------------- | ------------------------------ | --------------- | ----------------------------------------------------------------------------------- |\n| Checksums filename when zipping | `zip --checksums-file <file>` | `checksums-file` in ZIP action | `checksumsFile` | Relative manifest filename beside the ZIP or inside its package root when embedded. |","table":"table-1"},"235":{"id":"/js/wp-release/latest/configuration-18","page_id":"/js/wp-release/latest/configuration","tags":[],"type":"text","url":"/js/wp-release/latest/configuration#naming-convention","content":"| Concept       | CLI                 | GitHub Action | Library   | Meaning                                 |\n| ------------- | ------------------- | ------------- | --------- | --------------------------------------- |\n| ZIP to deploy | `--from-zip <file>` | `from-zip`    | `fromZip` | Existing ZIP read as the deploy source. |","table":"table-1"},"236":{"id":"/js/wp-release/latest/configuration-19","page_id":"/js/wp-release/latest/configuration","tags":[],"type":"text","url":"/js/wp-release/latest/configuration#naming-convention","content":"| Concept            | CLI               | GitHub Action | Library  | Meaning                             |\n| ------------------ | ----------------- | ------------- | -------- | ----------------------------------- |\n| Git tag to compare | `--git-tag <tag>` |               | `gitTag` | Git tag checked by `version-check`. |","table":"table-1"},"237":{"id":"/js/wp-release/latest/configuration-20","page_id":"/js/wp-release/latest/configuration","tags":[],"type":"text","url":"/js/wp-release/latest/configuration#naming-convention","content":"| Concept           | CLI                   | GitHub Action | Library  | Meaning                                               |\n| ----------------- | --------------------- | ------------- | -------- | ----------------------------------------------------- |\n| SVN tag to create | `--svn-tag <version>` | `svn-tag`     | `svnTag` | Tag written by `deploy-svn`, distinct from a git tag. |","table":"table-1"},"238":{"id":"/js/wp-release/latest/configuration-21","page_id":"/js/wp-release/latest/configuration","tags":[],"type":"text","url":"/js/wp-release/latest/configuration#naming-convention","content":"| Concept        | CLI               | GitHub Action | Library  | Meaning             |\n| -------------- | ----------------- | ------------- | -------- | ------------------- |\n| SVN repository | `--svn-url <url>` | `svn-url`     | `svnUrl` | Deploy destination. |","table":"table-1"},"239":{"id":"/js/wp-release/latest/configuration-22","page_id":"/js/wp-release/latest/configuration","tags":[],"type":"text","url":"/js/wp-release/latest/configuration#naming-convention","content":"| Concept        | CLI               | GitHub Action | Library  | Meaning                                                                                                               |\n| -------------- | ----------------- | ------------- | -------- | --------------------------------------------------------------------------------------------------------------------- |\n| Git repository | `--git-url <url>` |               | `gitUrl` | Destination of `deploy-git`. Credentials come from git, like a token in the URL or an SSH key, and are never printed. |","table":"table-1"},"240":{"id":"/js/wp-release/latest/configuration-23","page_id":"/js/wp-release/latest/configuration","tags":[],"type":"text","url":"/js/wp-release/latest/configuration#naming-convention","content":"| Concept                      | CLI                               | GitHub Action | Library         | Meaning                                                                                                      |\n| ---------------------------- | --------------------------------- | ------------- | --------------- | ------------------------------------------------------------------------------------------------------------ |\n| Branch and tag to release to | `--branch <name>`, `--tag <name>` |               | `branch`, `tag` | Refs written by `deploy-git` in the Git repository, distinct from the git tag that `version-check` compares. |","table":"table-1"},"241":{"id":"/js/wp-release/latest/configuration-24","page_id":"/js/wp-release/latest/configuration","tags":[],"type":"text","url":"/js/wp-release/latest/configuration#naming-convention","content":"| Concept        | CLI                    | GitHub Action | Library       | Meaning                                                                                                                                                       |\n| -------------- | ---------------------- | ------------- | ------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| Source history | `--split-prefix <dir>` |               | `splitPrefix` | Directory of a monorepo package whose history, split into its own commits like `git subtree split` does, becomes the source history of `deploy-git` releases. |","table":"table-1"},"242":{"id":"/js/wp-release/latest/configuration-25","page_id":"/js/wp-release/latest/configuration","tags":[],"type":"text","url":"/js/wp-release/latest/configuration#naming-convention","content":"| Concept         | CLI                                                                 | GitHub Action                  | Library                      | Meaning                                                                                                                                                    |\n| --------------- | ------------------------------------------------------------------- | ------------------------------ | ---------------------------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| SVN credentials | `--svn-username <name>`, `SVN_USERNAME` and `SVN_PASSWORD` env vars | `svn-username`, `svn-password` | `svnUsername`, `svnPassword` | Needed only to commit. There's no password flag, since it would show in the process list; the action inputs and library options fall back to the env vars. |","table":"table-1"},"243":{"id":"/js/wp-release/latest/configuration-26","page_id":"/js/wp-release/latest/configuration","tags":[],"type":"text","url":"/js/wp-release/latest/configuration#naming-convention","content":"| Concept    | CLI                                                | GitHub Action   | Library                                                   | Meaning                                                                                                                               |\n| ---------- | -------------------------------------------------- | --------------- | --------------------------------------------------------- | ------------------------------------------------------------------------------------------------------------------------------------- |\n| Log format | `--log-format <text\\|github>`, `--ci` for `github` | always `github` | `writer: new TextWriter()` or `new GitHubActionsWriter()` | How the log is printed: plain text, or GitHub Actions annotations and job summaries. Each name matches the start of its writer class. |","table":"table-1"},"244":{"id":"/js/wp-release/latest/configuration-27","page_id":"/js/wp-release/latest/configuration","tags":[],"type":"text","url":"/js/wp-release/latest/configuration#naming-convention","content":"| Concept        | CLI               | GitHub Action                              | Library      | Meaning                                                                                  |\n| -------------- | ----------------- | ------------------------------------------ | ------------ | ---------------------------------------------------------------------------------------- |\n| Release config | `--config <path>` | `config` in ZIP, checksums and SVN actions | `configFile` | Explicit JavaScript config path for package selection, integrity settings or deployment. |","table":"table-1"},"245":{"id":"/js/wp-release/latest/configuration-28","page_id":"/js/wp-release/latest/configuration","tags":[],"type":"text","url":"/js/wp-release/latest/configuration#naming-convention","content":"| Concept            | CLI                     | GitHub Action              | Library     | Meaning                                                 |\n| ------------------ | ----------------------- | -------------------------- | ----------- | ------------------------------------------------------- |\n| Release tag format | `--tag-format <format>` | `tag-format` in SVN action | `tagFormat` | How `release-ref` identifies a package and its version. |","table":"table-1"},"246":{"id":"/js/wp-release/latest/configuration-29","page_id":"/js/wp-release/latest/configuration","tags":[],"type":"text","url":"/js/wp-release/latest/configuration#naming-convention","content":"| Concept               | CLI                   | GitHub Action               | Library | Meaning                                                             |\n| --------------------- | --------------------- | --------------------------- | ------- | ------------------------------------------------------------------- |\n| Release ref to deploy | `--release-ref <ref>` | `release-ref` in SVN action | `ref`   | Read configured packages and deployment targets from a release ref. |","table":"table-1"},"247":{"id":"/js/wp-release/latest/configuration-30","page_id":"/js/wp-release/latest/configuration","tags":[],"type":"text","url":"/js/wp-release/latest/configuration#naming-convention","content":"| Concept     | CLI                   | GitHub Action           | Library  | Meaning                                                                                                                               |\n| ----------- | --------------------- | ----------------------- | -------- | ------------------------------------------------------------------------------------------------------------------------------------- |\n| Assets sync | `--no-assets` to skip | `assets: false` to skip | `assets` | Booleans are positive in the library and the action; `--no-assets` is only the CLI negation, never `noAssets` or a `no-assets` input. |","table":"table-1"},"248":{"id":"/js/wp-release/latest/configuration-31","page_id":"/js/wp-release/latest/configuration","tags":[],"type":"text","url":"/js/wp-release/latest/configuration#naming-convention","content":"CLI JSON results use camelCase keys like `zipPath`, and GitHub Action outputs use kebab-case like `zip-path`. The ZIP action supports `package` and `config`, the checksums action supports `config` for codec selection, and the SVN action supports `release-ref`, repeated `package` values as newline-separated input, `list`, `config` and `tag-format`."},"249":{"id":"/js/wp-release/latest/configuration-32","page_id":"/js/wp-release/latest/configuration","tags":[],"type":"text","url":"/js/wp-release/latest/configuration#naming-convention","content":"The ZIP CLI result uses `checksumsEmbedded` for the package-relative embedded manifest path. Its `signatures` array includes external absolute paths and embedded package-relative paths, while `checksumsSignatures` contains only manifest signatures. The ZIP action exposes those locations as `checksums-embedded`, `signatures` for external signatures, and `signatures-embedded` for embedded signatures, so asset uploads receive local files. With CLI `--github-output`, signature arrays remain in the JSON `result` output."},"250":{"id":"/js/wp-release/latest/configuration-33","page_id":"/js/wp-release/latest/configuration","tags":[],"type":"text","url":"/js/wp-release/latest/configuration#naming-convention","content":"Library classes are named after the capability (`SvnDeploy`, `Svn`, `GitDeploy`) without repeating \"release\"."},"251":{"id":"/js/wp-release/latest/configuration-34","page_id":"/js/wp-release/latest/configuration","tags":[],"type":"text","url":"/js/wp-release/latest/configuration#file-selection","content":"`build`, `zip`, `checksums`, `deploy-svn` and `deploy-git` select files the same way:"},"252":{"id":"/js/wp-release/latest/configuration-35","page_id":"/js/wp-release/latest/configuration","tags":[],"type":"text","url":"/js/wp-release/latest/configuration#file-selection","content":"| Option                | Description                                                                                                                    |\n| --------------------- | ------------------------------------------------------------------------------------------------------------------------------ |\n| `--distignore <file>` | Path to the ignore file. Defaults to `.distignore` in the source directory when present; an explicitly passed file must exist. |","table":"table-2"},"253":{"id":"/js/wp-release/latest/configuration-36","page_id":"/js/wp-release/latest/configuration","tags":[],"type":"text","url":"/js/wp-release/latest/configuration#file-selection","content":"| Option            | Description                 |\n| ----------------- | --------------------------- |\n| `--no-distignore` | Don't read any ignore file. |","table":"table-2"},"254":{"id":"/js/wp-release/latest/configuration-37","page_id":"/js/wp-release/latest/configuration","tags":[],"type":"text","url":"/js/wp-release/latest/configuration#file-selection","content":"| Option                 | Description                                                                                                                                                                                    |\n| ---------------------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `--exclude <patterns>` | Extra gitignore-style patterns, comma-separated or repeated, like `--exclude build/,assets/*,images/**/*`. They're applied after the ignore file, so a `!` pattern can also re-include a file. |","table":"table-2"},"255":{"id":"/js/wp-release/latest/configuration-38","page_id":"/js/wp-release/latest/configuration","tags":[],"type":"text","url":"/js/wp-release/latest/configuration#file-selection","content":"| Option                    | Description                                                                                                                                  |\n| ------------------------- | -------------------------------------------------------------------------------------------------------------------------------------------- |\n| `--exclude-gitattributes` | Also exclude paths marked `export-ignore` by Git attributes. This is opt-in and requires the source directory to be inside a Git repository. |","table":"table-2"},"256":{"id":"/js/wp-release/latest/configuration-39","page_id":"/js/wp-release/latest/configuration","tags":[],"type":"text","url":"/js/wp-release/latest/configuration#file-selection","content":"`.distignore` and `--exclude` use full gitignore syntax, including `!` negation. `--exclude-gitattributes` asks Git to evaluate `export-ignore` attributes, including nested `.gitattributes` files, then adds those paths to the exclusions. It is off by default, so releases don't unexpectedly depend on Git or change selection when a repository adds attributes. Git must be installed and the source directory must be inside a working tree; the flag is ignored by `deploy-svn --from-zip`, since the ZIP is already filtered. Version control metadata (`.git`, `.svn` and `.hg`, at any depth, including the `.git` files of worktrees and submodules) is always left out, also without an ignore file and when deploying from a ZIP, and no `!` pattern can re-include it. This keeps a repository's history out of ZIPs and deploys when the source directory is the repository root. The comma-separated `--exclude` list works like `--exclude` in `wp i18n make-pot`. Selected symbolic links are an error, since ZIP archives and WordPress.org SVN don't support them."},"257":{"id":"/js/wp-release/latest/configuration-40","page_id":"/js/wp-release/latest/configuration","tags":[],"type":"text","url":"/js/wp-release/latest/configuration#plugin-and-theme-headers","content":"The commands read the same headers as WordPress. The main plugin file is the top-level `.php` file with a `Plugin Name:` header in its first 8 KB, preferring `{slug}.php` when several files have one. A directory without a plugin file and with `Theme Name:` in `style.css` is a theme. The readme headers (`Stable tag`, `Tested up to`, …) come from `readme.txt`, or `readme.md` when there's no `readme.txt`."},"258":{"id":"/js/wp-release/latest/configuration-41","page_id":"/js/wp-release/latest/configuration","tags":[],"type":"text","url":"/js/wp-release/latest/configuration#plugin-and-theme-headers","content":"`--version` defaults to the `Version` header in `zip`, `checksums` and `version-check`, and `checksums --type` defaults to the detected package type."},"259":{"id":"/js/wp-release/latest/deployment","page_id":"/js/wp-release/latest/deployment","type":"page","content":"Deployment","breadcrumbs":["Docs","Js","Wp release","Latest"],"tags":[],"url":"/js/wp-release/latest/deployment"},"260":{"id":"/js/wp-release/latest/deployment-0","page_id":"/js/wp-release/latest/deployment","type":"heading","tags":[],"url":"/js/wp-release/latest/deployment#deploy-to-svn","content":"Deploy to SVN"},"261":{"id":"/js/wp-release/latest/deployment-1","page_id":"/js/wp-release/latest/deployment","type":"heading","tags":[],"url":"/js/wp-release/latest/deployment#deploy-to-git","content":"Deploy to Git"},"262":{"id":"/js/wp-release/latest/deployment-2","page_id":"/js/wp-release/latest/deployment","type":"heading","tags":[],"url":"/js/wp-release/latest/deployment#deploy-configured-packages","content":"Deploy configured packages"},"263":{"id":"/js/wp-release/latest/deployment-3","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-to-svn","content":"The `wp-release-deploy-svn` GitHub Action runs this command."},"264":{"id":"/js/wp-release/latest/deployment-4","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-to-svn","content":"`deploy-svn` syncs a plugin to the WordPress.org plugin SVN repository. Each SVN write is a separate flag and nothing is written unless requested. All writes go into one commit."},"265":{"id":"/js/wp-release/latest/deployment-5","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-to-svn","content":"| Flag      | Default | Writes                                     |\n| --------- | ------- | ------------------------------------------ |\n| `--trunk` | off     | Sync the full source directory to `trunk/` |","table":"table-0"},"266":{"id":"/js/wp-release/latest/deployment-6","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-to-svn","content":"| Flag            | Default | Writes                                                                                                                             |\n| --------------- | ------- | ---------------------------------------------------------------------------------------------------------------------------------- |\n| `--readme-only` | off     | Sync only the readme to `trunk/`, for updates between releases such as bumping `Tested up to`. Can't be combined with `--svn-tag`. |","table":"table-0"},"267":{"id":"/js/wp-release/latest/deployment-7","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-to-svn","content":"| Flag                  | Default | Writes                                                                                                                                                                                                                                                        |\n| --------------------- | ------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `--svn-tag <version>` | off     | Create `tags/<version>`. With `--trunk`, the tag is a copy of the synced `trunk/`. Without it, the tag is built directly from the source files and `trunk/` is left alone, for pre-release tags. A leading `v` is stripped, so `v1.2.0` creates `tags/1.2.0`. |","table":"table-0"},"268":{"id":"/js/wp-release/latest/deployment-8","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-to-svn","content":"| Flag                 | Default | Writes                                                                                                                                                                                 |\n| -------------------- | ------- | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `--assets-dir <dir>` | not set | Sync this directory with banners, icons and screenshots to the SVN `assets/` directory. There's no default directory, so assets are only deployed when this is set, and it must exist. |","table":"table-0"},"269":{"id":"/js/wp-release/latest/deployment-9","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-to-svn","content":"| Flag          | Default | Writes                                                                                            |\n| ------------- | ------- | ------------------------------------------------------------------------------------------------- |\n| `--no-assets` |         | Skip the `--assets-dir` sync for one run, for example when a config always passes `--assets-dir`. |","table":"table-0"},"270":{"id":"/js/wp-release/latest/deployment-10","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-to-svn","content":"Typical runs:"},"271":{"id":"/js/wp-release/latest/deployment-11","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-to-svn","content":"How a deploy works:"},"272":{"id":"/js/wp-release/latest/deployment-12","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-to-svn","content":"The options are validated, including the slug, version and readme name, before they're used in URLs or paths."},"273":{"id":"/js/wp-release/latest/deployment-13","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-to-svn","content":"With `--trunk` or `--svn-tag`, the files must be a plugin whose `Version` header matches the version. When `--trunk` and `--svn-tag` are combined, the readme `Stable tag` must match too; a tag-only run skips that, since a pre-release tag doesn't change the stable tag. `--readme-only` needs the readme. Nothing is checked out when a check fails."},"274":{"id":"/js/wp-release/latest/deployment-14","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-to-svn","content":"The repository is checked out sparsely into a new temporary directory, with only the directories that the flags write to. A missing `assets/` (or `trunk/`, `tags/`) directory is created. The deploy stops when `tags/<version>` exists, unless `--force` replaces it."},"275":{"id":"/js/wp-release/latest/deployment-15","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-to-svn","content":"The files are synced in Node.js, without `rsync`: new and changed files are copied, files that are no longer selected are deleted, and `svn add` and `svn delete` stage them, including files that svn ignores by default. With `--trunk`, `trunk/` is then copied to the tag with `svn copy`. Without it, the same selected files are synced into `tags/<version>` instead, and with `--force` an existing tag is updated to match, deleting files that are no longer in the build."},"276":{"id":"/js/wp-release/latest/deployment-16","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-to-svn","content":"Asset images get `svn:mime-type` set for PNG, JPEG, GIF and SVG, the formats that WordPress.org documents for plugin assets. Other formats keep the type that svn assigns."},"277":{"id":"/js/wp-release/latest/deployment-17","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-to-svn","content":"When `svn status` is empty, the deploy ends without a commit. A dry run logs the status and stops before the commit. Otherwise the changes are committed, and the temporary directory is always removed."},"278":{"id":"/js/wp-release/latest/deployment-18","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-to-svn","content":"`--from-zip` reads the files from a ZIP instead of `<source-dir>`. The ZIP is checked before it's extracted: entries with absolute paths, `..` segments or symbolic links, and entries outside a single `{slug}/` root folder, are rejected."},"279":{"id":"/js/wp-release/latest/deployment-19","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-to-svn","content":"Credentials are only needed for the commit, not for dry runs, no-op runs or `file://` repositories. Pass the username with `--svn-username` or `SVN_USERNAME` and the password in `SVN_PASSWORD`. svn always runs non-interactively without caching credentials, and the password is passed on the standard input with `--password-from-stdin`, never on the command line or in the logs."},"280":{"id":"/js/wp-release/latest/deployment-20","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-to-svn","content":"Validation:"},"281":{"id":"/js/wp-release/latest/deployment-21","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-to-svn","content":"`--readme-only` can't be combined with `--svn-tag`, since a tag is a release snapshot that a readme update never changes."},"282":{"id":"/js/wp-release/latest/deployment-22","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-to-svn","content":"`--version` defaults to `--svn-tag`, then the `Version` header of the deployed files; when `--version` and `--svn-tag` are both set they must match."},"283":{"id":"/js/wp-release/latest/deployment-23","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-to-svn","content":"Pre-release versions like `1.0.0-rc.1` can be tagged, but syncing one to `trunk/` warns, since trunk is for the development version."},"284":{"id":"/js/wp-release/latest/deployment-24","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-to-svn","content":"`--trunk` without `--svn-tag` works but warns, to remind you that updating trunk alone doesn't create a version tag for stable downloads."},"285":{"id":"/js/wp-release/latest/deployment-25","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-to-svn","content":"A version mismatch throws a `VersionMismatchError`, a `ValidationError` with the `mismatches` and a problem for each, with its file and line. See Logging."},"286":{"id":"/js/wp-release/latest/deployment-26","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-to-git","content":"`deploy-git` deploys the selected files of a plugin, theme or package to a Git repository, like a distribution repository that ships the built files and `vendor/` for Composer installs or GitHub-hosted updates, or the release repository of a monorepo package. It selects files like `zip`, with `.distignore` and `--exclude`, so built files that git ignores in the source repository, like `build/` or `vendor/`, are released too. The source directory must be inside a Git repository, which provides the source history and stores the release objects before they're pushed."},"287":{"id":"/js/wp-release/latest/deployment-27","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-to-git","content":"| Flag              | Default | Writes                          |\n| ----------------- | ------- | ------------------------------- |\n| `--branch <name>` | off     | Push the release to this branch |","table":"table-1"},"288":{"id":"/js/wp-release/latest/deployment-28","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-to-git","content":"| Flag           | Default | Writes                          |\n| -------------- | ------- | ------------------------------- |\n| `--tag <name>` | off     | Create this tag for the release |","table":"table-1"},"289":{"id":"/js/wp-release/latest/deployment-29","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-to-git","content":"How a deploy works:"},"290":{"id":"/js/wp-release/latest/deployment-30","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-to-git","content":"The selected files are written to the object database of the source repository and become a tree, with a temporary index, so the working tree and the index of the repository are left alone. Executable files stay executable."},"291":{"id":"/js/wp-release/latest/deployment-31","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-to-git","content":"The previous release is fetched: the tip of `--branch`, or for a tag-only deploy the tip of the repository's default branch (its `HEAD`), whatever that branch holds. Release a tag together with `--branch` to choose the branch it builds on."},"292":{"id":"/js/wp-release/latest/deployment-32","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-to-git","content":"When the files are the same as in the previous release, that release is reused. Otherwise a release commit is created with the files, whose parents are the previous release and the source history: the source commit (`--source-ref`, default `HEAD`), or with `--split-prefix` the history of that directory, split with `@wpelevator/subtree-split` into the same commits as `git subtree split` makes. The repository keeps the source history, and `git log --first-parent` lists the releases."},"293":{"id":"/js/wp-release/latest/deployment-33","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-to-git","content":"When the previous release on `--branch` already has newer source history, the branch isn't moved, so running an older build again, like a re-run of an earlier CI job, can't release older files. The source history is outdated when it's an older commit of the source history that the previous release was made from, its last parent. The split makes this reliable for `--split-prefix` too, since it creates the same commits for the same history. It needs the full history, so a shallow clone, like a checkout without `fetch-depth: 0`, fails. A revert is a new commit, so it's released, and with `--tag` the tag of an older build is still released, without moving the branch."},"294":{"id":"/js/wp-release/latest/deployment-34","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-to-git","content":"The tag is checked in the repository first. A tag that already has the same files is the release: it's reused and nothing is pushed, so running a tag release again is a no-op. A tag with other files fails with exit code `2` before anything is pushed."},"295":{"id":"/js/wp-release/latest/deployment-35","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-to-git","content":"The release is pushed to the branch, unless it didn't change or is outdated, and to the tag, in one atomic push. Pushes are never forced, so the branch only moves forward and a tag is never replaced, also when it was created in the meantime."},"296":{"id":"/js/wp-release/latest/deployment-36","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-to-git","content":"To release a tag again, for example after a release with the wrong files, delete the tag in the repository (`git push <url> :refs/tags/<tag>`) and run the deploy again. There's no flag for replacing a tag, since installs, Composer and GitHub Actions pins trust that a published tag doesn't change."},"297":{"id":"/js/wp-release/latest/deployment-37","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-to-git","content":"`--dry-run` runs everything except the push. `--message` sets the commit message, which defaults to `Release <tag or branch> from <source commit>`. Credentials come from git, like a credential helper or an SSH key, and credentials in URLs are never printed. For an HTTPS repository on `github.com`, or on the host of `GITHUB_SERVER_URL` like GitHub Enterprise Server, the `GITHUB_TOKEN` environment variable is sent as an authorization header, like `actions/checkout` does, so the token stays out of the URL, the git arguments and the repository config, and it replaces the header that `actions/checkout` persists. Pass `token` to `resolveGitDeployOptions()` for another HTTPS host. The commit needs a git identity (`user.name` and `user.email`)."},"298":{"id":"/js/wp-release/latest/deployment-38","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-configured-packages","content":"`deploy-git --release-ref <ref>` and `deploy-svn --release-ref <ref>` deploy the packages of a monorepo, or of a single-package repository, to the targets in the `deploy` config of their package groups, like the release repository of each package or its WordPress.org plugin. The ref decides what's deployed: a release tag of a package, like `refs/tags/plugins/alpha/1.2.0` read with the `tagFormat`, deploys that package and version, and a branch, like `refs/heads/main`, deploys every package with a target for that branch. A name without `refs/` is a release tag when it matches the tag format of a package, otherwise a branch, and in GitHub Actions `$GITHUB_REF` is the pushed ref."},"299":{"id":"/js/wp-release/latest/deployment-39","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-configured-packages","content":"| Mode | Command                          | Use                                                                                                                                                                                           |\n| ---- | -------------------------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| All  | `deploy-git --release-ref <ref>` | Deploy every package of the ref to each of its targets, one at a time, in one log group for each package. A failed deploy doesn't stop the others, and the command exits with `1` at the end. |","table":"table-2"},"300":{"id":"/js/wp-release/latest/deployment-40","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-configured-packages","content":"| Mode        | Command                                           | Use                                                                                                                                                       |\n| ----------- | ------------------------------------------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| One package | `deploy-git --release-ref <ref> --package <name>` | Deploy only that package (repeatable), by identifier or path, for example to retry a failed one or in a CI job for each package with its own credentials. |","table":"table-2"},"301":{"id":"/js/wp-release/latest/deployment-41","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-configured-packages","content":"| Mode | Command                                 | Use                                                                                                                                                                                                                                                                                             |\n| ---- | --------------------------------------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| Plan | `deploy-git --release-ref <ref> --list` | List the deploys without running them, with each package, its version or branch and the targets with the tag or branch they get. With `--json` or `--github-output` the result is `{ packages: [ … ] }`, for a CI matrix with `include: ${{ fromJSON( steps.plan.outputs.result ).packages }}`. |","table":"table-2"},"302":{"id":"/js/wp-release/latest/deployment-42","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-configured-packages","content":"| Mode             | Command                                      | Use                                                        |\n| ---------------- | -------------------------------------------- | ---------------------------------------------------------- |\n| Single directory | `deploy-git <dir> --git-url <url> [options]` | Deploy one directory without a config, as described above. |","table":"table-2"},"303":{"id":"/js/wp-release/latest/deployment-43","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-configured-packages","content":"`deploy-svn` has the same modes. `--release-ref` can't be combined with the options of a single target, like `--git-url`, `--tag` or `--svn-tag`, which come from the config."},"304":{"id":"/js/wp-release/latest/deployment-44","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-configured-packages","content":"**Git targets** take a `repository` and release both branches and tags by default. `branches` limits the branches, like `[ 'main' ]`, or turns them off with `false`, and `tag` is the tag template in the repository, `{version}` by default, or `false` to not release tags. A release tag is created on top of the default branch of the repository, and a branch is released to the same branch. `history: false` uses the source commit instead of the package history, and `message` sets the release commit message, `Release {ref} from {revision}` by default."},"305":{"id":"/js/wp-release/latest/deployment-45","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-configured-packages","content":"**SVN targets** only deploy release tags: a stable release syncs `trunk/`, creates its tag and syncs the `assetsDir`, and a pre-release only creates its tag. `slug`, the WordPress.org plugin slug, defaults to the name of the package directory, `url` to the WordPress.org plugin repository, and `message` sets the commit message. Credentials come from `SVN_USERNAME` and `SVN_PASSWORD`, or `--svn-username`."},"306":{"id":"/js/wp-release/latest/deployment-46","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-configured-packages","content":"**Several targets**: `git` and `svn` each take one target or a list, like a release repository and a mirror on another host. Each target is a separate deploy."},"307":{"id":"/js/wp-release/latest/deployment-47","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-configured-packages","content":"**Credentials**: a GitHub repository URL needs no token in it, since `GITHUB_TOKEN` is sent as an authorization header (see above). A callback can still add credentials for other hosts."},"308":{"id":"/js/wp-release/latest/deployment-48","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-configured-packages","content":"**Templates and callbacks**: `repository`, `slug` and `message` are templates with `{name}` and `{path}`, like the `tagFormat`, and `{version}`, `{branch}`, `{ref}` (the tag or branch that the deploy writes in the target) and `{revision}` (the source commit), or callbacks that receive `{ package, version, branch, ref, revision }`, where `package` has the `name`, `directory`, `path` and `type`. A callback can name a target after the package directory, choose another host for some packages, read the environment, or return nothing to skip the target for that package or ref; an empty `message` uses the default one. Credentials in URLs are never printed or listed."},"309":{"id":"/js/wp-release/latest/deployment-49","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-configured-packages","content":"**Results**: with `--json` or `--github-output`, the result lists each deploy in `deploys` with its `package`, `label`, `target` (the repository or WordPress.org plugin, with credentials redacted), `targetRef` (the tag or branch written there), `version` or `branch`, and its `result` or `error`. A remote target repository also has its `targetHost`, like `github.com`, and `targetPath`, like `me/my-plugin`, without credentials, for a workflow step that calls the API of the forge that hosts it, such as to create the release of the deployed tag. The targets of `--list` have the same `host` and `path`, and `parseRepositoryUrl()` reads them from an HTTP(S), SSH or scp-like URL. `wp-release` doesn't call forge APIs itself."},"310":{"id":"/js/wp-release/latest/deployment-50","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-configured-packages","content":"**Packages without a version**: a package entry without `version`, like a single directory with a `glob` of its path, isn't released with changesets, so changes to it don't need one, and it only deploys branches, since it has no release tags."},"311":{"id":"/js/wp-release/latest/deployment-51","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-configured-packages","content":"**Files**: `files.exclude` adds gitignore-style patterns relative to the package directory, and `files.distignore` sets the ignore file relative to it or turns it off with `false`. A `files` at the root of the config applies to every package group, for the rules that all packages share, and the `files` of a group add their patterns after it and can replace its ignore file. Without `files`, each package's `.distignore` applies, like for `zip`; there's no repository-wide `.distignore`, since each one is relative to its package. `zip --package <name>` zips a package with the same files, `getPackageFiles()` returns the directory and the file selection of any configured package, and `getDeployPackages()` lists the packages with deploy targets and their file selection."},"312":{"id":"/js/wp-release/latest/deployment-52","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-configured-packages","content":"A deploy releases the files of the working tree, so build the packages first. One job that builds once and runs `deploy-git --release-ref \"$GITHUB_REF\"` is the simplest setup, also for a branch that releases every package. A matrix with a job for each package from `--list` would build every package in every job, so build once and pass the built tree to the jobs as an artifact if you need one, for example for separate credentials."},"313":{"id":"/js/wp-release/latest/deployment-53","page_id":"/js/wp-release/latest/deployment","tags":[],"type":"text","url":"/js/wp-release/latest/deployment#deploy-configured-packages","content":"Other monorepo tools split the same way with less of the release in the config: Symplify MonorepoBuilder and `danharrin/monorepo-split-github-action` push the source history of each package directory, with the packages and repositories listed in the workflow or a matrix, while `deploy-git` releases the built files on top of that history, so `vendor/` and `build/` reach Composer and WordPress installs. Like the publishers of GoReleaser, targets are lists with templates, and pre-releases skip the targets where they would replace the stable version."},"314":{"id":"/js/wp-release/latest/development","page_id":"/js/wp-release/latest/development","type":"page","content":"Development","breadcrumbs":["Docs","Js","Wp release","Latest"],"tags":[],"url":"/js/wp-release/latest/development"},"315":{"id":"/js/wp-release/latest/development-0","page_id":"/js/wp-release/latest/development","type":"heading","tags":[],"url":"/js/wp-release/latest/development#development","content":"Development"},"316":{"id":"/js/wp-release/latest/development-1","page_id":"/js/wp-release/latest/development","type":"heading","tags":[],"url":"/js/wp-release/latest/development#architecture","content":"Architecture"},"317":{"id":"/js/wp-release/latest/development-2","page_id":"/js/wp-release/latest/development","tags":[],"type":"text","url":"/js/wp-release/latest/development#development","content":"The source is TypeScript in `src/`, with tests next to the files they test (`*.test.ts`). The published package contains only the compiled `dist/` with JavaScript and `.d.ts` files; tests and translation fixtures stay in the repository."},"318":{"id":"/js/wp-release/latest/development-3","page_id":"/js/wp-release/latest/development","tags":[],"type":"text","url":"/js/wp-release/latest/development#development","content":"`build` compiles `src/` to `dist/` with `tsc`, leaving out the tests. TypeScript resolves the workspace packages that wp-release depends on, like `@wpelevator/zip`, through their `wpelevator-source` condition, so it checks their source and needs no `dist/` of them. `preserveSymlinks` keeps their files under `node_modules`, so they aren't compiled into wp-release's `dist/`."},"319":{"id":"/js/wp-release/latest/development-4","page_id":"/js/wp-release/latest/development","tags":[],"type":"text","url":"/js/wp-release/latest/development#development","content":"`test` runs the `.ts` tests directly with `node --test`, using Node.js type stripping, so it needs Node.js 22.18 or later but no build. The SVN integration tests in `svn-deploy.integration.test.ts` create repositories with `svnadmin` and deploy to their `file://` URLs; they're skipped when `svn` or `svnadmin` isn't installed."},"320":{"id":"/js/wp-release/latest/development-5","page_id":"/js/wp-release/latest/development","tags":[],"type":"text","url":"/js/wp-release/latest/development#development","content":"`lint` runs ESLint and a `tsc` type check."},"321":{"id":"/js/wp-release/latest/development-6","page_id":"/js/wp-release/latest/development","tags":[],"type":"text","url":"/js/wp-release/latest/development#development","content":"The i18n tests in `@wpelevator/wp-gettext` validate gettext round trips, script catalogs and generated PHP data without launching PHP, WP-CLI or WordPress, covering contexts, plural forms, comments, flags, Unicode, escaping and PHP-looking input as data."},"322":{"id":"/js/wp-release/latest/development-7","page_id":"/js/wp-release/latest/development","tags":[],"type":"text","url":"/js/wp-release/latest/development#development","content":"The `wpelevator-source` export condition points at `src/index.ts`. The wp-release tests and monorepo CLI scripts use it to work with the source instead of a `dist/` build. Action builds use the declared dependency's default export, which resolves to `dist/` for the workspace copy and the published package. Build wp-release before building the actions."},"323":{"id":"/js/wp-release/latest/development-8","page_id":"/js/wp-release/latest/development","tags":[],"type":"text","url":"/js/wp-release/latest/development#development","content":"`execute( 'deploy-svn', args, { cwd, logger, svnRunner } )` runs a single-plugin deployment or a configured plan or deployment. The optional `svnRunner` replaces the external command runner in both modes; without it, the command uses its normal runner."},"324":{"id":"/js/wp-release/latest/development-9","page_id":"/js/wp-release/latest/development","tags":[],"type":"text","url":"/js/wp-release/latest/development#architecture","content":"wp-release has two layers, so that it fits any repository layout:"},"325":{"id":"/js/wp-release/latest/development-10","page_id":"/js/wp-release/latest/development","tags":[],"type":"text","url":"/js/wp-release/latest/development#architecture","content":"**Primitives** work on the directory, file or values they're given and know nothing about the repository: `build <dir>`, `zip <dir>`, `checksums`, `sign`, `verify`, `version-check`, `deploy-git <dir>`, `deploy-svn <dir>`, `i18n-pot <dir>`, `i18n-audit <dir>` and the `i18n-mo`, `i18n-json` and `i18n-php` compilers."},"326":{"id":"/js/wp-release/latest/development-11","page_id":"/js/wp-release/latest/development","tags":[],"type":"text","url":"/js/wp-release/latest/development#architecture","content":"**The config layer** reads `wp-release.config.js` for everything about the repository: where packages are (`root` and the package globs), how their versions and tags are named (`version`, `tagFormat`), which files they ship (`files`), how their translations are extracted (`i18n`), where they deploy (`deploy`) and the git `remote`. The changeset commands (with a single-project fallback when no config exists), `deploy-git` and `deploy-svn --release-ref`, `build --package` and `zip --package`, and `i18n-pot` and `i18n-audit` with `--package` or `--all` belong to it, and the global `--config` and `--tag-format` options select or adjust the config. `zip` and `checksums` also read caller configuration for integrity settings even without `--package`; verification reads it only when explicitly selected. Only `--release-ref` reads which package and version a ref releases. A primitive with a config mode, like `deploy-git --release-ref` beside `deploy-git <dir>` or `zip --package` beside `zip <dir>`, only takes the package directory, its files and its targets from the config there, and otherwise works the same."},"327":{"id":"/js/wp-release/latest/development-12","page_id":"/js/wp-release/latest/development","tags":[],"type":"text","url":"/js/wp-release/latest/development#architecture","content":"Configured repositories use the layout and naming conventions their config sets. Config-free changeset releases use the root-only detection and defaults described above."},"328":{"id":"/js/wp-release/latest/development-13","page_id":"/js/wp-release/latest/development","tags":[],"type":"text","url":"/js/wp-release/latest/development#architecture","content":"The GitHub Actions are adapters to these commands: they use the same flag names and `execute()` entry point, with secrets supplied through environment variables. The SVN action injects a command runner that checks or installs SVN only when a deployment runs its first SVN command; config planning and deployment behavior remain in `wp-release`."},"329":{"id":"/js/wp-release/latest/development-14","page_id":"/js/wp-release/latest/development","tags":[],"type":"text","url":"/js/wp-release/latest/development#architecture","content":"The package uses ES modules as its unit of encapsulation, like most Node.js CLI tools: a module exports a few functions and keeps its helpers private, so there's no class to wrap them in. A class is used only when it holds state across steps or binds dependencies, so that callers and tests can replace them:"},"330":{"id":"/js/wp-release/latest/development-15","page_id":"/js/wp-release/latest/development","tags":[],"type":"text","url":"/js/wp-release/latest/development#architecture","content":"**Workflows with steps** are classes, so that their steps share state and dependencies on the instance: `SvnDeploy` shares the temporary working copy across `prepare()`, `checkout()`, `sync()` and `commit()`, `GitDeploy` binds the options and the git runner to its steps, and `ChangesetRelease` binds the repository and the runners to `add()`, `version()` and `tag()`."},"331":{"id":"/js/wp-release/latest/development-16","page_id":"/js/wp-release/latest/development","tags":[],"type":"text","url":"/js/wp-release/latest/development#architecture","content":"**External commands** run through injectable runners: `createSvnRunner()` and `createGitRunner()` return functions that spawn the binary without a shell. The classes take a runner as an option and create the default one when it's missing, so tests pass a fake runner, or one that wraps the real runner and records some commands, instead of putting fake binaries on the `PATH`. The `Svn` and `ReleaseRepository` classes wrap a runner with the commands of their domain."},"332":{"id":"/js/wp-release/latest/development-17","page_id":"/js/wp-release/latest/development","tags":[],"type":"text","url":"/js/wp-release/latest/development#architecture","content":"**Domain logic** is plain functions that take their dependencies as arguments, like `discoverPackages( repository, config )`, so that each one can be tested on its own."},"333":{"id":"/js/wp-release/latest/development-18","page_id":"/js/wp-release/latest/development","tags":[],"type":"text","url":"/js/wp-release/latest/development#architecture","content":"**Commands** in `src/commands/` parse the CLI options and call the library, and `cli.ts` handles the global options, logging and exit codes. Errors carry their exit code, like `ValidationError` with `2`. Signing lives in `@wpelevator/signatures`, which throws errors with a `code`; `src/signing.ts` wraps it to read `WP_RELEASE_SIGNING_KEY` and to report those errors as `ValidationError`. ZIP archives live in `@wpelevator/zip` in the same way: `src/zip.ts` and `src/unzip.ts` adapt its entries and `zipPath` inputs and report its `ZipError` as `ValidationError`, with the `--force` hint for an existing archive. File selection and syncing live in `@wpelevator/fileset` and checksums in `@wpelevator/checksums`, which throw errors with a `code` in the same way: `src/file-selection.ts`, `src/sync.ts` and `src/checksums.ts` wrap them to report those errors as `ValidationError`, to build the manifest metadata from the plugin or theme slug and version, to select the files from the rules before hashing, and to pass the Git `export-ignore` lister to the fileset package. `src/integrity.ts` wraps the manifest codecs of the checksums package in the same way."},"334":{"id":"/js/wp-release/latest/development-19","page_id":"/js/wp-release/latest/development","tags":[],"type":"text","url":"/js/wp-release/latest/development#architecture","content":"Constructors only store their options. Work starts in a method call."},"335":{"id":"/js/wp-release/latest/development-20","page_id":"/js/wp-release/latest/development","tags":[],"type":"text","url":"/js/wp-release/latest/development#architecture","content":"The changeset release modules, from the entry point down:"},"336":{"id":"/js/wp-release/latest/development-21","page_id":"/js/wp-release/latest/development","tags":[],"type":"text","url":"/js/wp-release/latest/development#architecture","content":"| Module                 | Responsibility                                                                                                                              |\n| ---------------------- | ------------------------------------------------------------------------------------------------------------------------------------------- |\n| `changeset-release.ts` | `ChangesetRelease`, which plans releases and runs `add()`, `getStatus()`, `version()` and `tag()`, and the function form of each operation. |","table":"table-0"},"337":{"id":"/js/wp-release/latest/development-22","page_id":"/js/wp-release/latest/development","tags":[],"type":"text","url":"/js/wp-release/latest/development#architecture","content":"| Module              | Responsibility                                                                                       |\n| ------------------- | ---------------------------------------------------------------------------------------------------- |\n| `single-project.ts` | Resolving the config-free root project, its version source and targets, and shared release settings. |","table":"table-0"},"338":{"id":"/js/wp-release/latest/development-23","page_id":"/js/wp-release/latest/development","tags":[],"type":"text","url":"/js/wp-release/latest/development#architecture","content":"| Module                | Responsibility                                                                            |\n| --------------------- | ----------------------------------------------------------------------------------------- |\n| `changeset-config.ts` | Loading and validating `wp-release.config.js`, and the version source and target helpers. |","table":"table-0"},"339":{"id":"/js/wp-release/latest/development-24","page_id":"/js/wp-release/latest/development","tags":[],"type":"text","url":"/js/wp-release/latest/development#architecture","content":"| Module                  | Responsibility                                                                                             |\n| ----------------------- | ---------------------------------------------------------------------------------------------------------- |\n| `changeset-packages.ts` | Discovering the packages of the configured globs, with or without a version, and finding the changed ones. |","table":"table-0"},"340":{"id":"/js/wp-release/latest/development-25","page_id":"/js/wp-release/latest/development","tags":[],"type":"text","url":"/js/wp-release/latest/development#architecture","content":"| Module               | Responsibility                                  |\n| -------------------- | ----------------------------------------------- |\n| `changeset-files.ts` | Reading, writing and consuming changeset files. |","table":"table-0"},"341":{"id":"/js/wp-release/latest/development-26","page_id":"/js/wp-release/latest/development","tags":[],"type":"text","url":"/js/wp-release/latest/development#architecture","content":"| Module                    | Responsibility                                                                                             |\n| ------------------------- | ---------------------------------------------------------------------------------------------------------- |\n| `changeset-dependents.ts` | The dependents policy: which packages re-release with their sources, and rewriting their dependency specs. |","table":"table-0"},"342":{"id":"/js/wp-release/latest/development-27","page_id":"/js/wp-release/latest/development","tags":[],"type":"text","url":"/js/wp-release/latest/development#architecture","content":"| Module          | Responsibility                                            |\n| --------------- | --------------------------------------------------------- |\n| `changesets.ts` | Parsing and formatting changesets, and the release types. |","table":"table-0"},"343":{"id":"/js/wp-release/latest/development-28","page_id":"/js/wp-release/latest/development","tags":[],"type":"text","url":"/js/wp-release/latest/development#architecture","content":"| Module             | Responsibility                                                                 |\n| ------------------ | ------------------------------------------------------------------------------ |\n| `version-files.ts` | Reading and writing versions in manifests, headers, readmes and PHP constants. |","table":"table-0"},"344":{"id":"/js/wp-release/latest/development-29","page_id":"/js/wp-release/latest/development","tags":[],"type":"text","url":"/js/wp-release/latest/development#architecture","content":"| Module         | Responsibility                                                           |\n| -------------- | ------------------------------------------------------------------------ |\n| `changelog.ts` | Changelog entries, and the `CHANGELOG.md` and readme changelog sections. |","table":"table-0"},"345":{"id":"/js/wp-release/latest/development-30","page_id":"/js/wp-release/latest/development","tags":[],"type":"text","url":"/js/wp-release/latest/development#architecture","content":"| Module            | Responsibility                                                                      |\n| ----------------- | ----------------------------------------------------------------------------------- |\n| `release-tags.ts` | Choosing the version and previous tag of a release, and building its release notes. |","table":"table-0"},"346":{"id":"/js/wp-release/latest/development-31","page_id":"/js/wp-release/latest/development","tags":[],"type":"text","url":"/js/wp-release/latest/development#architecture","content":"| Module          | Responsibility                            |\n| --------------- | ----------------------------------------- |\n| `tag-format.ts` | Formatting tag names from the tag format. |","table":"table-0"},"347":{"id":"/js/wp-release/latest/development-32","page_id":"/js/wp-release/latest/development","tags":[],"type":"text","url":"/js/wp-release/latest/development#architecture","content":"| Module              | Responsibility                                                                                                                                                                                   |\n| ------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `package-deploy.ts` | Resolving the configured deploys of a ref: the released packages, their targets and file selections, for `deploy-git` and `deploy-svn`, and the file selection of a package for `zip --package`. |","table":"table-0"},"348":{"id":"/js/wp-release/latest/development-33","page_id":"/js/wp-release/latest/development","tags":[],"type":"text","url":"/js/wp-release/latest/development#architecture","content":"| Module           | Responsibility                                                                                                                      |\n| ---------------- | ----------------------------------------------------------------------------------------------------------------------------------- |\n| `package-zip.ts` | `zipPackage()`, the ZIP and checksums manifest of the selected files of a package, for `zip` and the snapshot builds of a monorepo. |","table":"table-0"},"349":{"id":"/js/wp-release/latest/development-34","page_id":"/js/wp-release/latest/development","tags":[],"type":"text","url":"/js/wp-release/latest/development#architecture","content":"| Module                  | Responsibility                                                                       |\n| ----------------------- | ------------------------------------------------------------------------------------ |\n| `release-repository.ts` | `ReleaseRepository`, the git commands of a release: tags, commits and changed files. |","table":"table-0"},"350":{"id":"/js/wp-release/latest/development-35","page_id":"/js/wp-release/latest/development","tags":[],"type":"text","url":"/js/wp-release/latest/development#architecture","content":"| Module            | Responsibility                                                                     |\n| ----------------- | ---------------------------------------------------------------------------------- |\n| `file-journal.ts` | `FileJournal`, which restores every file a failed `changeset-version` run changed. |","table":"table-0"},"351":{"id":"/js/wp-release/latest/development-36","page_id":"/js/wp-release/latest/development","tags":[],"type":"text","url":"/js/wp-release/latest/development#architecture","content":"| Module        | Responsibility                        |\n| ------------- | ------------------------------------- |\n| `versions.ts` | Version checks and SemVer precedence. |","table":"table-0"},"352":{"id":"/js/wp-release/latest/development-37","page_id":"/js/wp-release/latest/development","tags":[],"type":"text","url":"/js/wp-release/latest/development#architecture","content":"The internationalization modules in `src/i18n/` adapt the standalone `@wpelevator/wp-gettext` package, which owns extraction, catalogs, POT, PO, MO, script JSON, `.l10n.php` and audits:"},"353":{"id":"/js/wp-release/latest/development-38","page_id":"/js/wp-release/latest/development","tags":[],"type":"text","url":"/js/wp-release/latest/development#architecture","content":"| Module        | Responsibility                                                                                                                              |\n| ------------- | ------------------------------------------------------------------------------------------------------------------------------------------- |\n| `packages.ts` | `resolveI18nPackages()`, the config adapter that selects a directory, one package or all packages and resolves their options and POT paths. |","table":"table-1"},"354":{"id":"/js/wp-release/latest/development-39","page_id":"/js/wp-release/latest/development","tags":[],"type":"text","url":"/js/wp-release/latest/development#architecture","content":"| Module        | Responsibility                                                                                                                                                                                                                                         |\n| ------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `generate.ts` | `extractCatalog()`, `generatePackagePot()`, `resolvePotPath()` and `validatePotDestinations()`, which read the headers of the main file with `package-meta.ts` and pass them as `meta` to the generate functions of `@wpelevator/wp-gettext/generate`. |","table":"table-1"},"355":{"id":"/js/wp-release/latest/development-40","page_id":"/js/wp-release/latest/development","tags":[],"type":"text","url":"/js/wp-release/latest/development#architecture","content":"| Module       | Responsibility                                                                                                                                     |\n| ------------ | -------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `gettext.ts` | The other functions of `@wpelevator/wp-gettext`, with their `GettextError` reported as a `ValidationError` with the original error as its `cause`. |","table":"table-1"},"356":{"id":"/js/wp-release/latest","page_id":"/js/wp-release/latest","type":"page","content":"WP Release","breadcrumbs":["Docs","Js","Wp release","Latest"],"tags":[],"url":"/js/wp-release/latest"},"357":{"id":"/js/wp-release/latest-0","page_id":"/js/wp-release/latest","tags":[],"type":"text","url":"/js/wp-release/latest","content":"Build and release WordPress plugins, themes, and packages."},"358":{"id":"/js/wp-release/latest-1","page_id":"/js/wp-release/latest","type":"heading","tags":[],"url":"/js/wp-release/latest#install","content":"Install"},"359":{"id":"/js/wp-release/latest-2","page_id":"/js/wp-release/latest","type":"heading","tags":[],"url":"/js/wp-release/latest#start-with-the-cli","content":"Start with the CLI"},"360":{"id":"/js/wp-release/latest-3","page_id":"/js/wp-release/latest","type":"heading","tags":[],"url":"/js/wp-release/latest#guides","content":"Guides"},"361":{"id":"/js/wp-release/latest-4","page_id":"/js/wp-release/latest","tags":[],"type":"text","url":"/js/wp-release/latest","content":"`@wpelevator/wp-release` provides a CLI and library for building release directories and ZIPs, creating checksums and signatures, checking versions, extracting and compiling translations, and deploying to WordPress.org SVN or Git repositories."},"362":{"id":"/js/wp-release/latest-5","page_id":"/js/wp-release/latest","tags":[],"type":"text","url":"/js/wp-release/latest","content":"The `wp-release-zip`, `wp-release-checksums`, `wp-release-sign`, and `wp-release-deploy-svn` GitHub Actions expose the same commands in workflows."},"363":{"id":"/js/wp-release/latest-6","page_id":"/js/wp-release/latest","tags":[],"type":"text","url":"/js/wp-release/latest","content":"For projects that don't use Node.js or JavaScript tooling, PHP Changesets (`wpelevator/php-changesets`) runs the same changeset release workflow with PHP and Git alone: `changeset add`, `status`, `version` and `tag` read the same changeset files and match the options of the `changeset-*` commands described in Changesets support."},"364":{"id":"/js/wp-release/latest-7","page_id":"/js/wp-release/latest","tags":[],"type":"text","url":"/js/wp-release/latest","content":"WordPress.org themes are released by uploading a ZIP, so `deploy-svn` is for plugins only. Use `zip` to build a theme upload. Packaging and deployment options follow familiar community tools to ease migration; the comparison explains the differences."},"365":{"id":"/js/wp-release/latest-8","page_id":"/js/wp-release/latest","tags":[],"type":"text","url":"/js/wp-release/latest#install","content":"Node.js 22.12 or later is required. SVN deployments also require the `svn` command line client. Git deployments and changeset commands require Git."},"366":{"id":"/js/wp-release/latest-9","page_id":"/js/wp-release/latest","tags":[],"type":"text","url":"/js/wp-release/latest#install","content":"The package is an ES module with TypeScript declarations. CommonJS projects can load it with `require( '@wpelevator/wp-release' )` on Node.js 22.12 or later."},"367":{"id":"/js/wp-release/latest-10","page_id":"/js/wp-release/latest","tags":[],"type":"text","url":"/js/wp-release/latest#guides","content":"CLI and automation"},"368":{"id":"/js/wp-release/latest-11","page_id":"/js/wp-release/latest","tags":[],"type":"text","url":"/js/wp-release/latest#guides","content":"Changeset releases"},"369":{"id":"/js/wp-release/latest-12","page_id":"/js/wp-release/latest","tags":[],"type":"text","url":"/js/wp-release/latest#guides","content":"Configuration and file selection"},"370":{"id":"/js/wp-release/latest-13","page_id":"/js/wp-release/latest","tags":[],"type":"text","url":"/js/wp-release/latest#guides","content":"Packaging, checksums, signatures, and verification"},"371":{"id":"/js/wp-release/latest-14","page_id":"/js/wp-release/latest","tags":[],"type":"text","url":"/js/wp-release/latest#guides","content":"Git and WordPress.org deployment"},"372":{"id":"/js/wp-release/latest-15","page_id":"/js/wp-release/latest","tags":[],"type":"text","url":"/js/wp-release/latest#guides","content":"WordPress internationalization"},"373":{"id":"/js/wp-release/latest-16","page_id":"/js/wp-release/latest","tags":[],"type":"text","url":"/js/wp-release/latest#guides","content":"Library API"},"374":{"id":"/js/wp-release/latest-17","page_id":"/js/wp-release/latest","tags":[],"type":"text","url":"/js/wp-release/latest#guides","content":"Development and architecture"},"375":{"id":"/js/wp-release/latest-18","page_id":"/js/wp-release/latest","tags":[],"type":"text","url":"/js/wp-release/latest#guides","content":"Comparison with existing tools"},"376":{"id":"/js/wp-release/latest/internationalization","page_id":"/js/wp-release/latest/internationalization","type":"page","content":"Internationalization","breadcrumbs":["Docs","Js","Wp release","Latest"],"tags":[],"url":"/js/wp-release/latest/internationalization"},"377":{"id":"/js/wp-release/latest/internationalization-0","page_id":"/js/wp-release/latest/internationalization","type":"heading","tags":[],"url":"/js/wp-release/latest/internationalization#wordpress-internationalization","content":"WordPress internationalization"},"378":{"id":"/js/wp-release/latest/internationalization-1","page_id":"/js/wp-release/latest/internationalization","type":"heading","tags":[],"url":"/js/wp-release/latest/internationalization#supported-extraction-syntax","content":"Supported extraction syntax"},"379":{"id":"/js/wp-release/latest/internationalization-2","page_id":"/js/wp-release/latest/internationalization","type":"heading","tags":[],"url":"/js/wp-release/latest/internationalization#compile-translated-catalogs","content":"Compile translated catalogs"},"380":{"id":"/js/wp-release/latest/internationalization-3","page_id":"/js/wp-release/latest/internationalization","tags":[],"type":"text","url":"/js/wp-release/latest/internationalization#wordpress-internationalization","content":"`i18n-pot` extracts plugin/theme strings and writes a reproducible UTF-8 POT. `i18n-audit` reads the same source and returns findings without writing files. Both run with Node alone: no PHP, WordPress installation, database, WP-CLI or network requests. Extraction is independent of `files`, `.distignore` and Git `export-ignore` distribution rules."},"381":{"id":"/js/wp-release/latest/internationalization-4","page_id":"/js/wp-release/latest/internationalization","tags":[],"type":"text","url":"/js/wp-release/latest/internationalization#wordpress-internationalization","content":"Config-free source directories must have plugin/theme headers. The actual main file is discovered using the package metadata reader, including plugins whose main filename differs from their slug. The selected domain defaults to `Text Domain`, then the directory name. Calls with omitted domains belong to WordPress's `default` domain; block metadata without a domain inherits the package domain. `--all-domains` explicitly combines domains. A block's explicit `textdomain` always controls its messages."},"382":{"id":"/js/wp-release/latest/internationalization-5","page_id":"/js/wp-release/latest/internationalization","tags":[],"type":"text","url":"/js/wp-release/latest/internationalization#wordpress-internationalization","content":"`--package` selects one configured package and permits extraction-specific overrides; `--all` requires configuration and selects enabled WordPress packages only. Source directories, package selectors and `--all` are mutually exclusive. Config-free directory mode reads only its explicit options and metadata; it does not import repository config implicitly. A disabled package fails when explicitly selected. Configuration uses `i18n` at the root and on package entries, including an exact `glob` for an individual package, following the existing group model. Package entries remain non-overlapping; there is no additional package manifest configuration source."},"383":{"id":"/js/wp-release/latest/internationalization-6","page_id":"/js/wp-release/latest/internationalization","tags":[],"type":"text","url":"/js/wp-release/latest/internationalization#wordpress-internationalization","content":"Precedence is defaults, root configuration, package group/individual entry, then explicit command options. Scalars override, lists replace inherited lists, and gettext headers merge by key, case-insensitively, preserving intentionally empty values. A header set to `false` is removed, like `'Project-Id-Version': false` to keep the plugin version out of the POT so that it changes only when strings change; a later layer can set it again. `Content-Type` can't be removed, since it declares the UTF-8 charset. Options include `enabled`, `domain`, `allDomains`, `include`, `exclude`, `destination`, `headers`, `fileComment`, `location`, `strict`, `legacyGlobals` and audit `suppress`. `fileComment` adds static text above the POT header; each line is emitted as a gettext comment, and no copyright year is generated. The CLI accepts the same setting with `--file-comment`. Repeat `--include` or `--exclude` for multiple globs; these use case-sensitive minimatch semantics with `/` paths, `**`, brace expansion and dotfile matching, without gitignore negation or comma splitting. Default excludes cover dependency directories, dot directories, tests, minified files and generated translations. Source/build exclusions are a repository choice; this repository excludes `build`, `tools` and isolated vendors in its config."},"384":{"id":"/js/wp-release/latest/internationalization-7","page_id":"/js/wp-release/latest/internationalization","tags":[],"type":"text","url":"/js/wp-release/latest/internationalization#wordpress-internationalization","content":"The default output is `<Domain Path>/<text-domain>.pot`, or `languages/<text-domain>.pot`. A leading `/` in `Domain Path` is package-relative, and configured destinations cannot escape the package. `--destination` changes the package-relative directory. An explicit `--output <file.pot>` resolves against the command's working directory and requires one package. All multi-package destinations are validated before writing; each completed package replaces its file atomically, independently of other packages. `--check` compares bytes without writing and fails if the POT is absent or stale. Source references are preserved by default as `file:line`. `--add-location file` keeps only the file name, so that editing a source file doesn't change the POT unless its strings change, and `--no-location` (the same as `--add-location never`) omits them; `--add-location full` is the default. In configuration, set `location` to `'full'`, `'file'` or `'never'`. The older `--no-references` flag and `references: false` option still work as `--no-location`, and an explicit `location` wins over `references` in the same layer. Asking for locations and for none in the same command is an error. `POT-Creation-Date` and `PO-Revision-Date` default to empty values; no current date or year is inserted. Name/version headers come from metadata, and `--header NAME=VALUE` overrides any default, including with an empty value, and `--header NAME` removes the header. The POT lists the plugin or theme header strings first, then the strings of PHP, JavaScript, `block.json` and other metadata files in source order, so related strings stay together for translators. Each entry has its extracted comments, references and flags before the strings, in the usual gettext layout. The default headers come in a fixed order, and custom headers follow them. No generator header or generated copyright comment is added; set `fileComment` for a static one."},"385":{"id":"/js/wp-release/latest/internationalization-8","page_id":"/js/wp-release/latest/internationalization","tags":[],"type":"text","url":"/js/wp-release/latest/internationalization#supported-extraction-syntax","content":"PHP extraction uses `php-parser` in PHP 8.3 mode, tested with attributes, enums, match expressions, promoted properties and readonly classes. Supported WordPress functions are `__`, `_e`, `_x`, `_ex`, `_n`, `_nx`, `_n_noop`, `_nx_noop`, `esc_attr__`, `esc_attr_e`, `esc_attr_x`, `esc_html__`, `esc_html_e` and `esc_html_x`. Global and explicitly global calls, namespace fallback and explicit function imports/aliases are supported. Known file-local declarations and unrelated namespaced imports are excluded; methods and static methods are never translation calls. Named arguments resolve by PHP parameter name. Literal strings, static concatenation and non-interpolated heredoc/nowdoc preserve decoded escapes, Unicode and newlines. Counts may be dynamic; IDs, contexts and selected domains must be static."},"386":{"id":"/js/wp-release/latest/internationalization-9","page_id":"/js/wp-release/latest/internationalization","tags":[],"type":"text","url":"/js/wp-release/latest/internationalization#supported-extraction-syntax","content":"JavaScript extraction uses Babel's parser and lexical scope traversal, without transforms or project Babel config. JS, JSX, TS, TSX, MJS, CJS, MTS and CTS are supported. Named imports/aliases and namespace imports from `@wordpress/i18n`, unshadowed `wp.i18n` calls and unbound canonical legacy `__`, `_x`, `_n` and `_nx` calls extract strings. `--no-legacy-globals` requires imported or `wp.i18n` bindings. Locally shadowed/reassigned imports are excluded. Static literals, templates without substitutions, concatenation and TypeScript assertions are supported. Destructured CommonJS imports, transpiled `(0, i18n.__)` forms and arbitrary minified bundles are outside the supported syntax; scan source and use explicit source/build mapping for compiled JSON."},"387":{"id":"/js/wp-release/latest/internationalization-10","page_id":"/js/wp-release/latest/internationalization","tags":[],"type":"text","url":"/js/wp-release/latest/internationalization#supported-extraction-syntax","content":"A `translators:` comment attaches to the first translation call whose containing expression or nearest statement immediately follows it. Whitespace, parsed comments and ternary branch punctuation may intervene, but unrelated statements or argument expressions may not. Comments before outer wrappers reach nested translation calls; a comment is consumed once, so unrelated sibling calls do not inherit it. Multiline comment content is preserved. WordPress plugin/theme header labels serialize as extracted comments. Bundled metadata tables follow WordPress 6.8 block fields and theme fields, including styles, variations, presets, template names and nested block settings. Their upstream data license is GPL-2.0-or-later; tables are maintained intentionally with fixtures and never fetched during generation."},"388":{"id":"/js/wp-release/latest/internationalization-11","page_id":"/js/wp-release/latest/internationalization","tags":[],"type":"text","url":"/js/wp-release/latest/internationalization#supported-extraction-syntax","content":"Invalid syntax, unreadable selected files, selected source symlinks, empty/reserved message IDs, conflicting plural definitions and output errors fail generation. Unsupported dynamic arguments warn and are fatal with `--strict`. Audit adds `placeholder-comment`, `unordered-placeholders`, `plural-placeholders`, `empty-message` and `conflicting-comments` findings; suppress these explicitly by code where justified. Placeholders support `%%`, positional indexes, numeric width/precision, padding/flags and PHP/JS sprintf conversion types. Audit checks extraction and message quality, not every untranslated user-facing string. Audit fails on errors; strict audit also fails on warnings. Failed checks return exit code `2`; unexpected I/O/option-loading errors follow the existing CLI error handling. `--json`, GitHub annotations, summaries and step outputs use the existing CLI reporting facilities."},"389":{"id":"/js/wp-release/latest/internationalization-12","page_id":"/js/wp-release/latest/internationalization","tags":[],"type":"text","url":"/js/wp-release/latest/internationalization#compile-translated-catalogs","content":"Runtime formats require a translated PO, not an untranslated POT. PO updating, fuzzy matching and automatic translation are not provided. Compilation validates `Language` and `Plural-Forms`, excludes fuzzy, obsolete and untranslated entries, preserves contexts and plural forms, and never changes the input PO. An incompletely translated plural entry is excluded as a unit. Gettext parsing handles source encoding; runtime outputs use UTF-8. Each output is replaced atomically; JSON outputs are independent writes, and obsolete output files are not deleted automatically."},"390":{"id":"/js/wp-release/latest/internationalization-13","page_id":"/js/wp-release/latest/internationalization","tags":[],"type":"text","url":"/js/wp-release/latest/internationalization#compile-translated-catalogs","content":"MO and `.l10n.php` default beside the PO, with `.mo` and `.l10n.php` extensions; `--output` selects an explicit file relative to cwd. WordPress PHP catalogs require WordPress 6.5 or later. JSON requires an explicit domain; `--output` is a directory, defaulting to the PO directory. `--check` compares proposed bytes without writing and exits `2` on absent/stale outputs. Compiler commands are primitives and do not select configured packages."},"391":{"id":"/js/wp-release/latest/internationalization-14","page_id":"/js/wp-release/latest/internationalization","tags":[],"type":"text","url":"/js/wp-release/latest/internationalization#compile-translated-catalogs","content":"A script map is a JSON object from normalized package-relative source references to arrays of normalized runtime script paths. Many source files can feed one bundle, and one source can feed several scripts. An explicit map selects only listed references; an empty target array excludes that source. Without a map, JS/MJS/CJS references use identity paths, while JSX/TypeScript references require mapping. PHP-only references do not enter JSON catalogs."},"392":{"id":"/js/wp-release/latest/internationalization-15","page_id":"/js/wp-release/latest/internationalization","tags":[],"type":"text","url":"/js/wp-release/latest/internationalization#compile-translated-catalogs","content":"JSON filenames are `<domain>-<Language>-<md5(runtime-path)>.json`; the WordPress `default` domain uses `<Language>-<md5(runtime-path)>.json`. WordPress's `.min.js` normalization applies consistently to grouping, hashing and the JSON `source`. Jed keys preserve context through `\\u0004`, plural arrays contain all translated forms, and revision dates come from the PO metadata. `.l10n.php` writes safely escaped data arrays with NUL-separated plural translations; catalog text is never treated as executable PHP."},"393":{"id":"/js/wp-release/latest/internationalization-16","page_id":"/js/wp-release/latest/internationalization","tags":[],"type":"text","url":"/js/wp-release/latest/internationalization#compile-translated-catalogs","content":"The extraction and compilation primitives are in the standalone `@wpelevator/wp-gettext` package, without the repository and release tooling, and `wp-release` depends on it. See its README to use them in your own scripts."},"394":{"id":"/js/wp-release/latest/internationalization-17","page_id":"/js/wp-release/latest/internationalization","tags":[],"type":"text","url":"/js/wp-release/latest/internationalization#compile-translated-catalogs","content":"The package can be installed and used in any WordPress plugin or theme project; repository package selection is optional, and directory mode works without a wp-release config."},"395":{"id":"/js/wp-release/latest/library","page_id":"/js/wp-release/latest/library","type":"page","content":"Library API","breadcrumbs":["Docs","Js","Wp release","Latest"],"tags":[],"url":"/js/wp-release/latest/library"},"396":{"id":"/js/wp-release/latest/library-0","page_id":"/js/wp-release/latest/library","type":"heading","tags":[],"url":"/js/wp-release/latest/library#exit-codes","content":"Exit codes"},"397":{"id":"/js/wp-release/latest/library-1","page_id":"/js/wp-release/latest/library","type":"heading","tags":[],"url":"/js/wp-release/latest/library#library","content":"Library"},"398":{"id":"/js/wp-release/latest/library-2","page_id":"/js/wp-release/latest/library","type":"heading","tags":[],"url":"/js/wp-release/latest/library#signing","content":"Signing"},"399":{"id":"/js/wp-release/latest/library-3","page_id":"/js/wp-release/latest/library","type":"heading","tags":[],"url":"/js/wp-release/latest/library#zip-archives","content":"ZIP archives"},"400":{"id":"/js/wp-release/latest/library-4","page_id":"/js/wp-release/latest/library","type":"heading","tags":[],"url":"/js/wp-release/latest/library#file-selection","content":"File selection"},"401":{"id":"/js/wp-release/latest/library-5","page_id":"/js/wp-release/latest/library","type":"heading","tags":[],"url":"/js/wp-release/latest/library#checksums","content":"Checksums"},"402":{"id":"/js/wp-release/latest/library-6","page_id":"/js/wp-release/latest/library","type":"heading","tags":[],"url":"/js/wp-release/latest/library#translations","content":"Translations"},"403":{"id":"/js/wp-release/latest/library-7","page_id":"/js/wp-release/latest/library","type":"heading","tags":[],"url":"/js/wp-release/latest/library#logging","content":"Logging"},"404":{"id":"/js/wp-release/latest/library-8","page_id":"/js/wp-release/latest/library","tags":[],"type":"text","url":"/js/wp-release/latest/library#exit-codes","content":"| Code | Meaning                               |\n| ---- | ------------------------------------- |\n| `0`  | Success, dry run, no changes, or help |","table":"table-0"},"405":{"id":"/js/wp-release/latest/library-9","page_id":"/js/wp-release/latest/library","tags":[],"type":"text","url":"/js/wp-release/latest/library#exit-codes","content":"| Code | Meaning                                                 |\n| ---- | ------------------------------------------------------- |\n| `1`  | Unexpected failure, such as a failed svn or git command |","table":"table-0"},"406":{"id":"/js/wp-release/latest/library-10","page_id":"/js/wp-release/latest/library","tags":[],"type":"text","url":"/js/wp-release/latest/library#exit-codes","content":"| Code | Meaning                                                                                                                                          |\n| ---- | ------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `2`  | Invalid options, failed release checks, an existing SVN tag, a Git tag that exists with another release, or files that don't match the checksums |","table":"table-0"},"407":{"id":"/js/wp-release/latest/library-11","page_id":"/js/wp-release/latest/library","tags":[],"type":"text","url":"/js/wp-release/latest/library#exit-codes","content":"| Code | Meaning                                                   |\n| ---- | --------------------------------------------------------- |\n| `3`  | Missing SVN credentials, or credentials that SVN rejected |","table":"table-0"},"408":{"id":"/js/wp-release/latest/library-12","page_id":"/js/wp-release/latest/library","tags":[],"type":"text","url":"/js/wp-release/latest/library#library","content":"`resolveDeployOptions()` applies the defaults and throws a `ValidationError` (with `exitCode` `2`) for invalid combinations. `SvnDeploy` exposes each step (`prepare()`, `checkVersions()`, `checkout()`, `sync()`, `commit()` and `cleanup()`) separately so CI wrappers can run and report them one by one; `run()` runs all of them, or nothing when there's nothing to write. `getPlan()` lists the planned SVN changes. The `Svn` class wraps the svn command line, and takes the command runner as a dependency so that tests can replace it."},"409":{"id":"/js/wp-release/latest/library-13","page_id":"/js/wp-release/latest/library","tags":[],"type":"text","url":"/js/wp-release/latest/library#library","content":"Git deploys:"},"410":{"id":"/js/wp-release/latest/library-14","page_id":"/js/wp-release/latest/library","tags":[],"type":"text","url":"/js/wp-release/latest/library#library","content":"`resolveGitDeployOptions()` throws a `ValidationError` without a repository URL or with an invalid branch or tag. `GitDeploy` exposes `createTree()`, `fetchPrevious()`, `createRelease()`, `isOutdated()`, `checkTag()`, `getRefsToPush()` and `push()` separately, like `SvnDeploy`, and takes a git command runner from `createGitRunner()` as a dependency. The result has `outdated` when the branch wasn't moved for older source history, the refs to write in `planned` and the refs that were pushed in `pushed`, which is empty in a dry run. `redactUrls()` hides the credentials in URLs."},"411":{"id":"/js/wp-release/latest/library-15","page_id":"/js/wp-release/latest/library","tags":[],"type":"text","url":"/js/wp-release/latest/library#library","content":"Changeset releases:"},"412":{"id":"/js/wp-release/latest/library-16","page_id":"/js/wp-release/latest/library","tags":[],"type":"text","url":"/js/wp-release/latest/library#library","content":"`ChangesetRelease` runs the `changeset-*` commands: `add()`, `getStatus()`, `version()` and `tag()`, plus `getPlan()`, `getPackages()` and `getConfiguredPackages()`. Each call reads the configuration, packages and pending changesets again, so one instance can version and then tag. `getConfiguredPackages()` returns package directories with their resolved release group metadata; `formatTag()` and `formatTemplate()` apply the same placeholders as the release workflows. It takes a git runner from `createGitRunner()` as `git`, so that tests can replace it. Without a config file, it detects a single root project. Its optional `singleProject` settings accept `versions` (the existing version descriptors), `versionFrom` (the same selector as `--version-from`), `baseBranch`, `remote`, `changesets`, `readmeChangelog` and `changelogInsertAfter`; `tagFormat` remains a repository option. The functions `addChangeset()`, `getChangesetStatus()`, `versionChangesets()`, `tagChangesets()`, `getChangesetReleasePlan()`, `getChangesetPackages()` and `getConfiguredPackages()` do the same with the default runners, in one call."},"413":{"id":"/js/wp-release/latest/library-17","page_id":"/js/wp-release/latest/library","tags":[],"type":"text","url":"/js/wp-release/latest/library#signing","content":"The Ed25519 key handling and the WordPress, minisign and OpenSSH signature formats live in the `@wpelevator/signatures` package, which `@wpelevator/wp-release` depends on. It still re-exports the signing functions that it has always exported; the bytes-first functions and error guards are only in `@wpelevator/signatures`. The wp-release functions read the key from `WP_RELEASE_SIGNING_KEY` and report invalid input as a `ValidationError` with the original error as its `cause`; the `@wpelevator/signatures` functions use `SIGNING_KEY` by default and throw a `SigningError`."},"414":{"id":"/js/wp-release/latest/library-18","page_id":"/js/wp-release/latest/library","tags":[],"type":"text","url":"/js/wp-release/latest/library#zip-archives","content":"Reproducible archives and safe extraction live in the `@wpelevator/zip` package, which `@wpelevator/wp-release` depends on. It still exports `createZip()`, `readZipEntries()`, `getZipEntryErrors()`, `extractZip()`, `ZIP_MTIME` and `ZIP_FILE_MODE` with their `sourceDir`, `files` and `zipPath` inputs, and reports invalid input as a `ValidationError` with the original error as its `cause`. The zip package takes a list of `{ source, name }` entries, where the source is a file path or bytes, and can create and read archives in memory. Entries have the fixed `ZIP_MTIME`, or the `SOURCE_DATE_EPOCH` time when that environment variable is set."},"415":{"id":"/js/wp-release/latest/library-19","page_id":"/js/wp-release/latest/library","tags":[],"type":"text","url":"/js/wp-release/latest/library#file-selection","content":"Gitignore-style file selection and directory syncing live in the `@wpelevator/fileset` package, which `@wpelevator/wp-release` depends on. It still exports `resolveFileSelection()`, `loadFileRules()`, `selectFiles()`, `parseExclude()`, `syncDirectory()` and `copyFileIfChanged()` with the same inputs, and reports invalid input as a `ValidationError` with the original error as its `cause`. The fileset package has no Git dependency: it takes a function that lists more files to exclude, `listExcluded`, and `@wpelevator/wp-release` passes one that reads the `export-ignore` attribute with Git when `excludeGitattributes` is set. The ignore file name (`.distignore` by default) and the directories that a sync leaves alone (`.svn` by default) are options of the fileset package."},"416":{"id":"/js/wp-release/latest/library-20","page_id":"/js/wp-release/latest/library","tags":[],"type":"text","url":"/js/wp-release/latest/library#checksums","content":"Hashing, the checksums manifest formats and their comparison live in the `@wpelevator/checksums` package, which `@wpelevator/wp-release` depends on. It still exports `createChecksums()`, `writeChecksums()`, `readChecksums()`, `parseChecksums()`, `verifyChecksums()`, `compareChecksums()`, `hashFile()`, `hashFiles()` and the `wordpressCodec` and `sha256sumCodec` codecs with the same inputs and output, and reports invalid input as a `ValidationError` with the original error as its `cause`. The checksums package takes a plain list of file paths instead of file rules, hashes bytes and streams with `hashBytes()` and `hashStream()`, and keeps the plugin or theme slug and version as generic `metadata` next to the `files`, which `@wpelevator/wp-release` fills in. Manifests are written byte for byte as before."},"417":{"id":"/js/wp-release/latest/library-21","page_id":"/js/wp-release/latest/library","tags":[],"type":"text","url":"/js/wp-release/latest/library#translations","content":"Extracting translatable strings from PHP, JavaScript and `block.json` sources, building catalogs, writing POT files, compiling PO files to MO, script JSON and `.l10n.php`, and auditing live in the `@wpelevator/wp-gettext` package, which `@wpelevator/wp-release` depends on. It still exports the same functions, like `extractCatalog()`, `generatePackagePot()`, `serializePot()`, `parseTranslatedPo()` and `compileTranslations()`, with the same inputs and output, and reports invalid input as a `ValidationError` with the original error as its `cause`. The wp-gettext package doesn't read plugin and theme headers: it takes the header details as a `meta` input, which `@wpelevator/wp-release` reads from the main file with its own package metadata reader. `resolveI18nPackages()`, which selects the configured packages, stays in `@wpelevator/wp-release`. Importing the main entry of `@wpelevator/wp-gettext` doesn't load the PHP and JavaScript parsers, which are in the `/php` and `/javascript` sub-paths."},"418":{"id":"/js/wp-release/latest/library-22","page_id":"/js/wp-release/latest/library","tags":[],"type":"text","url":"/js/wp-release/latest/library#logging","content":"`Logger` filters messages by level and passes them to a writer, like the transports of other Node.js loggers. The writer decides how messages look:"},"419":{"id":"/js/wp-release/latest/library-23","page_id":"/js/wp-release/latest/library","tags":[],"type":"text","url":"/js/wp-release/latest/library#logging","content":"`TextWriter` prints plain text to `stdout` and `stderr`. It's the default."},"420":{"id":"/js/wp-release/latest/library-24","page_id":"/js/wp-release/latest/library","tags":[],"type":"text","url":"/js/wp-release/latest/library#logging","content":"`GitHubActionsWriter` prints workflow commands, so that notices, warnings and errors with a file are annotations, and appends summaries to `GITHUB_STEP_SUMMARY`. It's the CLI's `github` log format, and the GitHub Actions pass it to their logger. Its `workspace` and `summaryPath` options default to `GITHUB_WORKSPACE` and `GITHUB_STEP_SUMMARY`."},"421":{"id":"/js/wp-release/latest/library-25","page_id":"/js/wp-release/latest/library","tags":[],"type":"text","url":"/js/wp-release/latest/library#logging","content":"A writer implements `LogWriter` with `write()`, `startGroup()`, `endGroup()` and `summary()`, so other CI systems can have their own format. `summary()` takes a function that builds the Markdown, which only writers with a summary call."},"422":{"id":"/js/wp-release/latest/library-26","page_id":"/js/wp-release/latest/library","tags":[],"type":"text","url":"/js/wp-release/latest/library#logging","content":"A `ValidationError` can list `problems`, each with a `message` and an optional `file`, `line` and `title`. `logError( logger, error, title )` logs each problem as an error on its file and line and lists them in the summary under the title, or logs the message when there are none. `VersionMismatchError` and `version-check` report the version mismatches this way."},"423":{"id":"/js/wp-release/latest/library-27","page_id":"/js/wp-release/latest/library","tags":[],"type":"text","url":"/js/wp-release/latest/library#logging","content":"ZIP files and metadata:"},"424":{"id":"/js/wp-release/latest/library-28","page_id":"/js/wp-release/latest/library","tags":[],"type":"text","url":"/js/wp-release/latest/library#logging","content":"Checksums:"},"425":{"id":"/js/wp-release/latest/library-29","page_id":"/js/wp-release/latest/library","tags":[],"type":"text","url":"/js/wp-release/latest/library#logging","content":"`loadFileRules()` reads the ignore file and `--exclude` patterns into a gitignore matcher, optionally adds Git `export-ignore` paths, and `selectFiles()` lists the files it doesn't ignore. `compareChecksums()` compares two hash maps without reading any files, and `parseChecksums()` validates manifest JSON. `extractZip()` extracts a ZIP after the same checks as `deploy-svn --from-zip`."},"426":{"id":"/js/wp-release/latest/library-30","page_id":"/js/wp-release/latest/library","tags":[],"type":"text","url":"/js/wp-release/latest/library#logging","content":"Translations:"},"427":{"id":"/js/wp-release/latest/library-31","page_id":"/js/wp-release/latest/library","tags":[],"type":"text","url":"/js/wp-release/latest/library#logging","content":"The parsers, catalog and compiler functions are provided by `@wpelevator/wp-gettext`. Parsers return messages and structured diagnostics with stable codes, severity and source-relative locations. Catalog messages retain IDs, contexts, plurals, translations, translator comments, flags and structured references. `aggregateCatalog()` selects/merges a domain, unions references/comments and diagnoses plural conflicts. `resolveI18nPackages()` is the separate config adapter; extraction and serialization primitives know nothing about the repository. Library functions do not log, parse process arguments or set exit codes. Extraction results report unique files consulted, including the main plugin/theme file used for headers and header strings even when source globs exclude it. `parseTranslatedPo()`, `compileMo()`, `compileScriptTranslations()`, `compilePhpTranslations()` and `compileTranslations()` expose the same typed operations to library callers."},"428":{"id":"/js/wp-release/latest/packaging","page_id":"/js/wp-release/latest/packaging","type":"page","content":"Packaging and integrity","breadcrumbs":["Docs","Js","Wp release","Latest"],"tags":[],"url":"/js/wp-release/latest/packaging"},"429":{"id":"/js/wp-release/latest/packaging-0","page_id":"/js/wp-release/latest/packaging","type":"heading","tags":[],"url":"/js/wp-release/latest/packaging#build-a-directory","content":"Build a directory"},"430":{"id":"/js/wp-release/latest/packaging-1","page_id":"/js/wp-release/latest/packaging","type":"heading","tags":[],"url":"/js/wp-release/latest/packaging#zip","content":"ZIP"},"431":{"id":"/js/wp-release/latest/packaging-2","page_id":"/js/wp-release/latest/packaging","type":"heading","tags":[],"url":"/js/wp-release/latest/packaging#signing-targets-for-builds-and-zips","content":"Signing targets for builds and ZIPs"},"432":{"id":"/js/wp-release/latest/packaging-3","page_id":"/js/wp-release/latest/packaging","type":"heading","tags":[],"url":"/js/wp-release/latest/packaging#checksums","content":"Checksums"},"433":{"id":"/js/wp-release/latest/packaging-4","page_id":"/js/wp-release/latest/packaging","type":"heading","tags":[],"url":"/js/wp-release/latest/packaging#filenames-embedding-and-signing","content":"Filenames, embedding and signing"},"434":{"id":"/js/wp-release/latest/packaging-5","page_id":"/js/wp-release/latest/packaging","type":"heading","tags":[],"url":"/js/wp-release/latest/packaging#formats","content":"Formats"},"435":{"id":"/js/wp-release/latest/packaging-6","page_id":"/js/wp-release/latest/packaging","type":"heading","tags":[],"url":"/js/wp-release/latest/packaging#configuration-and-custom-codecs","content":"Configuration and custom codecs"},"436":{"id":"/js/wp-release/latest/packaging-7","page_id":"/js/wp-release/latest/packaging","type":"heading","tags":[],"url":"/js/wp-release/latest/packaging#manifest-inside-the-plugin","content":"Manifest inside the plugin"},"437":{"id":"/js/wp-release/latest/packaging-8","page_id":"/js/wp-release/latest/packaging","type":"heading","tags":[],"url":"/js/wp-release/latest/packaging#verify","content":"Verify"},"438":{"id":"/js/wp-release/latest/packaging-9","page_id":"/js/wp-release/latest/packaging","type":"heading","tags":[],"url":"/js/wp-release/latest/packaging#sign","content":"Sign"},"439":{"id":"/js/wp-release/latest/packaging-10","page_id":"/js/wp-release/latest/packaging","type":"heading","tags":[],"url":"/js/wp-release/latest/packaging#signature-formats","content":"Signature formats"},"440":{"id":"/js/wp-release/latest/packaging-11","page_id":"/js/wp-release/latest/packaging","type":"heading","tags":[],"url":"/js/wp-release/latest/packaging#version-check","content":"Version check"},"441":{"id":"/js/wp-release/latest/packaging-12","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#build-a-directory","content":"`build` and `zip` use the same internal helper to load file rules, exclude their outputs, select release files and reject an empty selection. `build` copies the selected files directly into `--output <dir>`, without a slug wrapper or ZIP. Checksums and manifest signatures are optional. It supports the shared file selection flags above and `--package <name>` with `--config <path>` for configured package rules. A configured package cannot be combined with a source directory or file selection flags."},"442":{"id":"/js/wp-release/latest/packaging-13","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#build-a-directory","content":"The destination is required and automatically excluded when it is inside the source. It cannot be the source directory or an ancestor, including through symlinked parents. Existing destinations require `--force`, which replaces the directory and removes stale files; existing files and symbolic links are rejected. Files are copied to a temporary directory before the existing build is replaced. Selected symbolic links are rejected as with ZIP packaging. `--json` returns `outputDir`, `files` and, for configured builds, `package`; it also returns `checksumsPath` when a manifest is generated, and `signatures` and `publicKey` when signing is requested. `--github-output` exposes these results too."},"443":{"id":"/js/wp-release/latest/packaging-14","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#build-a-directory","content":"`--checksums` writes `<output-dir>.checksums.json` beside the directory and hashes the copied build files. `--sign-checksums` generates and signs that manifest, implying `--checksums`. Use `--slug` and `--version` to override its metadata. The manifest and its signatures are excluded from the source selection, so rebuilding with `--force` does not package previous sidecars. Existing manifests and requested signature files also require `--force`; signing keys, formats and signature destinations are validated before creating or replacing the build. `--sign` is unsupported because a directory has no single file to sign."},"444":{"id":"/js/wp-release/latest/packaging-15","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#build-a-directory","content":"In the Deploy workflow, a directory build can be deployed with `wp-release deploy-svn dist/code-prettify --slug code-prettify --trunk --svn-tag \"$GITHUB_REF_NAME\" --no-distignore`. Keep `--from-zip` when the SVN deployment must match the attached ZIP exactly. Run dependency installation and compilation before `build`; it only selects and copies files."},"445":{"id":"/js/wp-release/latest/packaging-16","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#zip","content":"The `wp-release-zip` GitHub Action runs this command."},"446":{"id":"/js/wp-release/latest/packaging-17","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#zip","content":"`zip` writes `{slug}.{version}.zip` to the current directory, or to `--output <file>`, with the selected files in a `{slug}/` root folder:"},"447":{"id":"/js/wp-release/latest/packaging-18","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#zip","content":"`--root-folder <name>` changes the root folder and `--no-root-folder` puts the files at the root of the ZIP."},"448":{"id":"/js/wp-release/latest/packaging-19","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#zip","content":"`--filename-format` changes the name, like `--filename-format {slug}` for `my-plugin.zip`."},"449":{"id":"/js/wp-release/latest/packaging-20","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#zip","content":"Entries are sorted and use a fixed file mode and a fixed timestamp (1980-01-01), or the `SOURCE_DATE_EPOCH` Unix time when that environment variable is set, so the same files give the same ZIP. Built-in metadata is deterministic except for embedded minisign signatures, which include their signing timestamp; custom codec callbacks control their own encoded bytes."},"450":{"id":"/js/wp-release/latest/packaging-21","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#zip","content":"`--checksums` also writes the checksums manifest of the archived files next to the ZIP, with `.checksums.json` instead of `.zip`."},"451":{"id":"/js/wp-release/latest/packaging-22","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#zip","content":"`--sign` signs only the ZIP with `WP_RELEASE_SIGNING_KEY`. `--sign-checksums` generates and signs only the checksums manifest, implying `--checksums`. Use both flags to sign both files. External signatures are written alongside their files; embedded manifest signatures are written inside the package. The default format is WordPress `.sig`, unless integrity configuration selects another format."},"452":{"id":"/js/wp-release/latest/packaging-23","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#zip","content":"`--sign-format` selects formats for requested signatures, such as `--sign-format wordpress,minisign,ssh`. It requires `--sign` or `--sign-checksums` and never enables signing by itself. Signing keys, formats and existing signature destinations are validated before writing the ZIP or manifest. `--force` also overwrites requested signatures. Job summaries include signatures and public keys; JSON results include `signatures` and `publicKey`."},"453":{"id":"/js/wp-release/latest/packaging-24","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#zip","content":"An existing ZIP or manifest isn't overwritten without `--force`. A ZIP or manifest written inside the source directory is never archived."},"454":{"id":"/js/wp-release/latest/packaging-25","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#zip","content":"`--package <name>` zips a package of the configured packages, by identifier or path under the configured root like `plugins/alpha`, instead of a source directory: its directory with the `files` config of its package group, the same files that its deploys select. The slug defaults to the directory name and the version to the `Version` header, and `--slug` and `--version` still set them. Any package of the config works, with or without a version or deploy targets. To zip what a deploy just released, pass the `package` and `version` of the `deploy-git --release-ref` result, in the same job and from the same build, so the ZIP has exactly the files of the release tag in the release repository. It can't be combined with `<source-dir>` or the file selection options. The `--json` result has the `package`, `slug` and `version`. `zipPackage()` builds the same ZIP from a script, with `getPackageFiles()` for the directory and the files of a package."},"455":{"id":"/js/wp-release/latest/packaging-26","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#zip","content":"To embed a signed manifest with a stable filename, use:"},"456":{"id":"/js/wp-release/latest/packaging-27","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#zip","content":"See Checksums for filenames, placement, formats and configuration."},"457":{"id":"/js/wp-release/latest/packaging-28","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#signing-targets-for-builds-and-zips","content":"| Flag          | `zip`                                         | `build`                                             |\n| ------------- | --------------------------------------------- | --------------------------------------------------- |\n| `--checksums` | Generate an unsigned manifest beside the ZIP. | Generate an unsigned manifest beside the directory. |","table":"table-0"},"458":{"id":"/js/wp-release/latest/packaging-29","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#signing-targets-for-builds-and-zips","content":"| Flag     | `zip`              | `build`      |\n| -------- | ------------------ | ------------ |\n| `--sign` | Sign only the ZIP. | Unsupported. |","table":"table-0"},"459":{"id":"/js/wp-release/latest/packaging-30","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#signing-targets-for-builds-and-zips","content":"| Flag               | `zip`                           | `build`                         |\n| ------------------ | ------------------------------- | ------------------------------- |\n| `--sign-checksums` | Generate and sign the manifest. | Generate and sign the manifest. |","table":"table-0"},"460":{"id":"/js/wp-release/latest/packaging-31","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#signing-targets-for-builds-and-zips","content":"| Flag            | `zip`                                               | `build`                            |\n| --------------- | --------------------------------------------------- | ---------------------------------- |\n| `--sign-format` | Choose formats for explicitly requested signatures. | Same; requires `--sign-checksums`. |","table":"table-0"},"461":{"id":"/js/wp-release/latest/packaging-32","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#signing-targets-for-builds-and-zips","content":"These flags deliberately replace the former implicit signing behavior: `zip --checksums --sign` now leaves the manifest unsigned, and `--sign-format` alone is rejected. Add `--sign-checksums` to sign a manifest and `--sign` to sign a ZIP. The standalone `checksums` and `sign` commands remain available for workflows that write and sign a manifest inside the source before packaging it."},"462":{"id":"/js/wp-release/latest/packaging-33","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#checksums","content":"The `wp-release-checksums` GitHub Action runs this command."},"463":{"id":"/js/wp-release/latest/packaging-34","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#checksums","content":"`checksums` writes a manifest with the MD5 and SHA-256 hash of every selected file, in the format of the WordPress.org plugin checksums API (`https://downloads.wordpress.org/plugin-checksums/{slug}/{version}.json`). Paths are relative to the plugin or theme folder, sorted, and use forward slashes:"},"464":{"id":"/js/wp-release/latest/packaging-35","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#checksums","content":"Themes use a `theme` key instead of `plugin`, and the version is left out when it's unknown. The manifest is named `{slug}.{version}.checksums.json` after `--filename-format`, the same name as the ZIP with `.checksums.json` instead of `.zip`, so the two are published side by side; `--output <file>` writes it elsewhere. A manifest written inside `<source-dir>` is never listed in itself."},"465":{"id":"/js/wp-release/latest/packaging-36","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#checksums","content":"Because the manifest lists the files and not the ZIP, it stays valid for any copy of the same files: the GitHub release ZIP, the ZIP that WordPress.org builds from SVN, or an installed plugin on a site."},"466":{"id":"/js/wp-release/latest/packaging-37","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#filenames-embedding-and-signing","content":"`--checksums-file <file>` enables checksums and sets a relative filename independently of the ZIP name. Without `--embed-checksums`, it resolves against the ZIP output directory; with embedding, it resolves against the package root inside the ZIP (the archive root with `--no-root-folder`). Nested paths are supported, but absolute paths, backslashes, drive letters, control characters and dot segments are rejected. Embedding emits no external manifest and never modifies the source directory. Embedded minisign signatures contain a signing timestamp, so ZIP bytes can differ across signing times; unsigned metadata and WordPress/SSH signatures remain deterministic. Selected source files must not collide with generated manifest or signature entries."},"467":{"id":"/js/wp-release/latest/packaging-38","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#filenames-embedding-and-signing","content":"`--sign-checksums` enables checksums and signs only the manifest, before embedding when requested. It reads `WP_RELEASE_SIGNING_KEY` and uses `--sign-format wordpress,minisign,ssh` to select formats; each signature travels with the manifest. `--sign-format` selects formats for explicitly requested signing targets and never enables signing. `--sign` signs only the final ZIP; `--sign-checksums` controls the manifest in either placement mode. Use both flags to sign both targets. `--force` permits replacing external output files and signatures. `--json` reports external manifests in `checksumsPath`, embedded package-relative paths in `checksumsEmbedded`, and manifest signatures in `checksumsSignatures`."},"468":{"id":"/js/wp-release/latest/packaging-39","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#filenames-embedding-and-signing","content":"The default WordPress filename remains the ZIP basename with `.checksums.json` instead of `.zip`, in either placement mode. Choose `--checksums-file checksums.json` for a stable name. The version remains in the JSON content."},"469":{"id":"/js/wp-release/latest/packaging-40","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#formats","content":"`--checksums-format` chooses the manifest format. `wordpress-json` (default) uses the WordPress-compatible structure shown above. `sha256sum` uses GNU-compatible SHA-256 lines and escaping, with `SHA256SUMS` as its default filename. It carries no package identity or version, and standard `sha256sum --check` checks listed files without rejecting additional files; `wp-release verify` also checks for extra files."},"470":{"id":"/js/wp-release/latest/packaging-41","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#formats","content":"`--checksums-algorithms md5,sha256` selects JSON digest fields; lists replace configured lists. Supported algorithms are MD5 (for compatibility) and SHA-256. The `sha256sum` codec requires SHA-256. The standalone `checksums` command also accepts `--checksums-format`, keeping `--output` relative to the working directory."},"471":{"id":"/js/wp-release/latest/packaging-42","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#configuration-and-custom-codecs","content":"The optional top-level `integrity` configuration maps to these flags. Explicit CLI values override configuration; `--no-embed-checksums` and `--no-sign-checksums` disable their configured behaviors. Existing release configurations retain their `packages` array; use `packages: []` for a configuration containing only integrity settings."},"472":{"id":"/js/wp-release/latest/packaging-43","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#configuration-and-custom-codecs","content":"Use `codec: 'sha256sum'`, `algorithms: ['sha256']`, `file: 'SHA256SUMS'` and `sign: { formats: ['minisign'] }` for the GNU setup. Custom codecs provide `id`, a default `filename`, and `encode`/`decode` callbacks, which may be asynchronous. Generation validates the round trip before writing artifacts: codecs must preserve all selected file paths, represented digests and any represented package identity. They receive and return the existing WordPress-compatible `ChecksumsManifest` model (`plugin` or `theme`, optional `version`, and a `files` map of relative paths to digest fields), keeping format customization separate from selection, hashing and signing."},"473":{"id":"/js/wp-release/latest/packaging-44","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#configuration-and-custom-codecs","content":"`zip` and `checksums` read the caller's release configuration. For verification of custom codecs or configured filenames, pass `--config wp-release.config.mjs` explicitly. See Verify."},"474":{"id":"/js/wp-release/latest/packaging-45","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#manifest-inside-the-plugin","content":"For a manifest that is also published as a separate release asset or deployed directly from a source directory, write and sign it in that directory before packaging. Use `zip --embed-checksums` as described above when only the archive should contain the generated metadata. The source-directory workflow uses the same manifest for installed copies and release assets:"},"475":{"id":"/js/wp-release/latest/packaging-46","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#manifest-inside-the-plugin","content":"Write the manifest into the directory that is zipped and deployed. The `checksums` command leaves its output manifest and its signatures (`<name>.sig`, `<name>.minisig` and `<name>.sshsig`) out of the hashes, so running it again with the same output path and `--force` gives the same manifest. `verify` checks matching copies as described below. Sign it last, since the signature covers the exact bytes of the manifest."},"476":{"id":"/js/wp-release/latest/packaging-47","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#manifest-inside-the-plugin","content":"`zip` and `deploy-svn` carry the pair like any other file. Don't use `zip --checksums` here, since it would write a second manifest that lists the first one. Attach `build/checksums.json` and `build/checksums.json.sig` to the GitHub release as they are."},"477":{"id":"/js/wp-release/latest/packaging-48","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#manifest-inside-the-plugin","content":"The signature covers file hashes and not a ZIP, so it stays valid for the ZIP that WordPress.org builds from SVN. Check what WordPress.org serves after a deploy, with the manifest and public key from your build:"},"478":{"id":"/js/wp-release/latest/packaging-49","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#manifest-inside-the-plugin","content":"The manifest can have any name and location, for example `--output build/includes/signatures/checksums.json`, and missing folders are created. Tell `verify` where the shipped copy is with `--embedded <path>`, like `--embedded includes/signatures/checksums.json`. Both the `--checksums` file and its signature must then exist, both copies must be shipped, and they're skipped when comparing files and must be identical to the originals. The manifest can't list the embedded path. Without `--embedded`, `verify` looks for the manifest name at the root, and skips a file only when it exists, the matching original exists and the manifest doesn't list it. Otherwise it's checked like any other file, so a listed file that has the name of the manifest can't be deleted unnoticed, and a shipped `.sig` without an original is reported as not in the checksums."},"479":{"id":"/js/wp-release/latest/packaging-50","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#manifest-inside-the-plugin","content":"The public key has to come from somewhere other than the plugin that it checks, because someone who can overwrite the plugin files can also replace a key and a signature inside them. A copy of the manifest also doesn't prevent a downgrade to an older release that was signed too, so the installing side has to enforce a minimum version."},"480":{"id":"/js/wp-release/latest/packaging-51","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#verify","content":"`verify` checks a directory against a manifest from `checksums` or from the WordPress.org checksums API, and reports every changed, missing and extra file. It exits with `2` unless all files match:"},"481":{"id":"/js/wp-release/latest/packaging-52","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#verify","content":"A file matches when its SHA-256 equals the manifest. Manifests without SHA-256 fall back to MD5, and a hash can also be a list of accepted values."},"482":{"id":"/js/wp-release/latest/packaging-53","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#verify","content":"`verify` doesn't read `.distignore`, so that an ignore file inside the checked directory can't hide added files. `--exclude <patterns>` skips paths in both the directory and the manifest, for files that aren't part of the release, such as caches."},"483":{"id":"/js/wp-release/latest/packaging-54","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#verify","content":"Manifest paths outside the package folder (absolute or with `..`) are rejected."},"484":{"id":"/js/wp-release/latest/packaging-55","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#verify","content":"`--zip <file|url>` checks the files of a ZIP instead of a directory. The ZIP can be a URL, such as the one that WordPress.org builds for a release, and its single root folder is found automatically (or set `--root-folder`). The ZIP is extracted to a temporary directory after the same safety checks as `deploy-svn --from-zip`."},"485":{"id":"/js/wp-release/latest/packaging-56","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#verify","content":"The version in the manifest must match the `Version` header of the checked files, so that an older release with its own valid manifest can't pass as a newer one."},"486":{"id":"/js/wp-release/latest/packaging-57","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#verify","content":"A manifest can't list itself. A copy of the manifest and of its signature inside the checked files, at the root with the same names as the `--checksums` file or at the path of `--embedded`, is skipped when comparing files, but it must be identical to the `--checksums` file and its signature. The signature is the `.sig` file, or the file of `--signature-format`. A path that the manifest lists is never skipped, and a file that isn't a matching copy is reported as not in the checksums. See Manifest inside the plugin."},"487":{"id":"/js/wp-release/latest/packaging-58","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#verify","content":"A checksums manifest proves only that the files match the manifest. With `--public-key <key>`, `verify` first checks `<checksums>.sig` against the Ed25519 public key and fails with exit code `2` before comparing any file when the signature is missing or invalid, so that the manifest itself can be trusted. `--signature-format minisign` or `ssh` checks `<checksums>.minisig` or `<checksums>.sshsig` instead. The key can be the base64 key, the minisign public key or the `ssh-ed25519` public key, since they're forms of the same key. See Sign."},"488":{"id":"/js/wp-release/latest/packaging-59","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#verify","content":"Verification never executes configuration from inside a downloaded package. Without `--checksums`, `verify` reads the embedded filename selected by `--checksums-file`, explicit configuration, or the codec default. For a versioned embedded filename, pass that filename explicitly. With a public key, signatures are checked before decoding; the selected signature format must exist (WordPress `.sig` by default; pass `--signature-format minisign` or `ssh` for those formats), and all other present supported signature formats are also authenticated when verifying the embedded manifest. Without a public key, checksums detect changes but do not authenticate the publisher. Trusted public keys must come from outside the package."},"489":{"id":"/js/wp-release/latest/packaging-60","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#sign","content":"The `wp-release-sign` GitHub Action runs this command."},"490":{"id":"/js/wp-release/latest/packaging-61","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#sign","content":"`sign` writes a detached signature next to each file, `<file>.sig`, so that downloads and installed copies can be trusted. Sign both the ZIP and the checksums manifest: the ZIP signature covers installs and updates, and the manifest signature covers the contents after unpacking and copies that weren't built by you."},"491":{"id":"/js/wp-release/latest/packaging-62","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#sign","content":"The signature is the one WordPress core's `verify_file_signature()` checks: a base64 Ed25519 signature of the raw SHA-384 digest of the file. The tests check it against `sodium_crypto_sign_verify_detached()` in PHP. A `.sig` file can hold several signatures, one per line, and a file is valid when any of them match, which allows a key rotation window."},"492":{"id":"/js/wp-release/latest/packaging-63","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#sign","content":"The key is read from the `WP_RELEASE_SIGNING_KEY` environment variable only, as a base64 32-byte Ed25519 seed or a 64-byte libsodium secret key, the formats that `sodium_crypto_sign_seed_keypair()` and the update-pilot-server package signing key take. There's no flag for it, since it would show in the process list, and it's never logged."},"493":{"id":"/js/wp-release/latest/packaging-64","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#sign","content":"`--verbose` prints the public key of the signing key in the form of each written format. `--json` returns it as `publicKey`, and in every form as `publicKeys`. Pass it to `verify --public-key` and to the plugin that checks the signatures."},"494":{"id":"/js/wp-release/latest/packaging-65","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#sign","content":"An existing signature file isn't overwritten without `--force`."},"495":{"id":"/js/wp-release/latest/packaging-66","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#sign","content":"`zip --sign` signs only the ZIP; add `--sign-checksums` to sign its manifest too. `signFiles()` signs files from a script."},"496":{"id":"/js/wp-release/latest/packaging-67","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#signature-formats","content":"The same key can also sign in formats that tools outside WordPress check, for people who download a release by hand or verify it in other pipelines. Pick them with `--format`, comma-separated or repeated; the default is `wordpress`:"},"497":{"id":"/js/wp-release/latest/packaging-68","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#signature-formats","content":"| Format      | File         | Checked by                                                                        |\n| ----------- | ------------ | --------------------------------------------------------------------------------- |\n| `wordpress` | `<file>.sig` | WordPress core's `verify_file_signature()`, update-client and `wp-release verify` |","table":"table-1"},"498":{"id":"/js/wp-release/latest/packaging-69","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#signature-formats","content":"| Format     | File             | Checked by                                                                    |\n| ---------- | ---------------- | ----------------------------------------------------------------------------- |\n| `minisign` | `<file>.minisig` | minisign and compatible tools: `minisign -Vm <file> -P <minisign public key>` |","table":"table-1"},"499":{"id":"/js/wp-release/latest/packaging-70","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#signature-formats","content":"| Format | File            | Checked by                                                                                                      |\n| ------ | --------------- | --------------------------------------------------------------------------------------------------------------- |\n| `ssh`  | `<file>.sshsig` | OpenSSH 8.1 or later: `ssh-keygen -Y verify -f allowed_signers -I <identity> -n file -s <file>.sshsig < <file>` |","table":"table-1"},"500":{"id":"/js/wp-release/latest/packaging-71","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#signature-formats","content":"`minisign` signs the BLAKE2b-512 digest of the file, like `minisign -S` does by default, and adds a trusted comment with the signing time and file name that a second signature covers. minisign generates a random key ID for its keys, but the key here is a plain Ed25519 seed, so wp-release derives the key ID from the public key. `wp-release verify` doesn't compare key IDs, so signatures of keys that minisign generated verify too."},"501":{"id":"/js/wp-release/latest/packaging-72","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#signature-formats","content":"`ssh` is the armored `SSHSIG` format that `ssh-keygen -Y sign` writes, with a SHA-512 digest and the `file` namespace, so that the signature can't pass as one for commits or another namespace. It's written to `.sshsig` instead of the `.sig` of `ssh-keygen`, which the `wordpress` format uses. Put the SSH public key in an `allowed_signers` file as `<identity> ssh-ed25519 AAAA…`."},"502":{"id":"/js/wp-release/latest/packaging-73","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#signature-formats","content":"All formats are Ed25519 signatures by the same key, so one key and one secret cover all of them. The tests check each format with `minisign`, `ssh-keygen` and libsodium, and check the signatures that `minisign` and `ssh-keygen` write with `wp-release verify`."},"503":{"id":"/js/wp-release/latest/packaging-74","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#signature-formats","content":"Generate a key pair with `wp-release keygen`. It prints the private seed once as `WP_RELEASE_SIGNING_KEY=…` and the matching public key, also as a minisign public key and an `ssh-ed25519` public key. Generate keys locally and store the private seed in your secret manager or CI secrets. Distribute the public key to verifiers. `keygen --github-output` is rejected to keep the private seed out of workflow outputs; regular and `--json` output both include the seed."},"504":{"id":"/js/wp-release/latest/packaging-75","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#version-check","content":"`version-check` compares the versions that have to agree before a release, and reports every mismatch with exit code `2`:"},"505":{"id":"/js/wp-release/latest/packaging-76","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#version-check","content":"The expected version is `--version`, or the `Version` header."},"506":{"id":"/js/wp-release/latest/packaging-77","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#version-check","content":"The readme `Stable tag` must match for plugins; `--no-stable-tag` skips it, and themes have no Stable tag."},"507":{"id":"/js/wp-release/latest/packaging-78","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#version-check","content":"`--constant NAME` (repeatable) checks `define( 'NAME', '1.2.0' )` or `const NAME = '1.2.0'` in every PHP file outside `vendor/`, `node_modules/` and dot directories. A constant that isn't defined is a mismatch."},"508":{"id":"/js/wp-release/latest/packaging-79","page_id":"/js/wp-release/latest/packaging","tags":[],"type":"text","url":"/js/wp-release/latest/packaging#version-check","content":"`--git-tag` defaults to `GITHUB_REF` when it's a tag. `--git-tag-format` (default `{version}`) can have a prefix or the slug, like `v{version}` or `{slug}-{version}`; a leading `v` in the version is ignored, like for SVN tags."},"509":{"id":"/js/wp-release/v0.18.1/changesets","page_id":"/js/wp-release/v0.18.1/changesets","type":"page","content":"Changesets","breadcrumbs":["Docs","Js","Wp release","v0.18.1"],"tags":[],"url":"/js/wp-release/v0.18.1/changesets"},"510":{"id":"/js/wp-release/v0.18.1/changesets-0","page_id":"/js/wp-release/v0.18.1/changesets","type":"heading","tags":[],"url":"/js/wp-release/v0.18.1/changesets#changesets-support","content":"Changesets support"},"511":{"id":"/js/wp-release/v0.18.1/changesets-1","page_id":"/js/wp-release/v0.18.1/changesets","type":"heading","tags":[],"url":"/js/wp-release/v0.18.1/changesets#single-project-repositories-without-a-config-file","content":"Single-project repositories without a config file"},"512":{"id":"/js/wp-release/v0.18.1/changesets-2","page_id":"/js/wp-release/v0.18.1/changesets","type":"heading","tags":[],"url":"/js/wp-release/v0.18.1/changesets#single-project-checks-in-github-actions","content":"Single-project checks in GitHub Actions"},"513":{"id":"/js/wp-release/v0.18.1/changesets-3","page_id":"/js/wp-release/v0.18.1/changesets","type":"heading","tags":[],"url":"/js/wp-release/v0.18.1/changesets#packages-and-tags","content":"Packages and tags"},"514":{"id":"/js/wp-release/v0.18.1/changesets-4","page_id":"/js/wp-release/v0.18.1/changesets","type":"heading","tags":[],"url":"/js/wp-release/v0.18.1/changesets#pre-releases","content":"Pre-releases"},"515":{"id":"/js/wp-release/v0.18.1/changesets-5","page_id":"/js/wp-release/v0.18.1/changesets","type":"heading","tags":[],"url":"/js/wp-release/v0.18.1/changesets#snapshots","content":"Snapshots"},"516":{"id":"/js/wp-release/v0.18.1/changesets-6","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#changesets-support","content":"The changeset commands manage versioning, changelogs and release tags for single-package repositories and monorepos, including this repository. They read Changesets-style Markdown and load JavaScript configs with descriptors for npm and Composer manifests, plugin and theme headers, readme Stable tags, PHP constants, and Git tags. Use JavaScript configs with ESM (`export default`) or CommonJS (`module.exports`). Frontmatter uses `package-name: patch|minor|major` entries. For pre-releases, use the built-in pre-release workflow; the parser supports this simple frontmatter format rather than general YAML or the Changesets pre mode."},"517":{"id":"/js/wp-release/v0.18.1/changesets-7","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#changesets-support","content":"PHP projects that don't use Node.js or JavaScript can run the same workflow with PHP Changesets, a Composer package that needs only PHP and Git. Its `changeset add`, `changeset status`, `changeset version` and `changeset tag` commands take the options of the `changeset-*` commands here, read the same changeset files and print the same release plans, with a PHP config file in place of `wp-release.config.*`. Use `wp-release` when the project already builds with Node.js, or to also build ZIPs, translations and WordPress.org deploys; see the comparison for the differences."},"518":{"id":"/js/wp-release/v0.18.1/changesets-8","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#single-project-repositories-without-a-config-file","content":"The `changeset-*` commands can release one project at the repository root without a `wp-release.config.*` file. Run them from the root directory. With no version descriptor flags, they detect a root `package.json` or `composer.json` with a version, a plugin entry PHP file with a `Plugin Name` header, or a theme `style.css` with a `Theme Name` header. A detected plugin also updates the Stable tag in `readme.txt`, or `readme.md` when no Stable tag is found in `readme.txt`. Multiple version sources, multiple plugin entry files and npm workspaces require explicit descriptors or a config; files belonging to different projects aren't silently synchronized. A directory without a recognized version source still requires a config or explicit descriptors."},"519":{"id":"/js/wp-release/v0.18.1/changesets-9","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#single-project-repositories-without-a-config-file","content":"For a root npm package, the complete workflow needs no project flags:"},"520":{"id":"/js/wp-release/v0.18.1/changesets-10","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#single-project-repositories-without-a-config-file","content":"A single configured package is selected automatically for `changeset-add --bump` when `--since` isn't supplied, and for `changeset-tag --version`; `--since` still selects changed packages. npm and Composer projects use their root manifest's name as the changeset identifier when that manifest supplies the version; other projects use the root directory's basename. `--project-name <name>` pins the identifier of a repository without a manifest name, so local checkouts and CI don't need matching directory names; a config sets the same identifier with `id`. The fallback uses `.changeset/`, `CHANGELOG.md`, tags named `v{version}`, and the `origin` remote. There is no default comparison branch: pass `--since` or `--base-branch` when status checks should compare changes. Readme changelog updates are opt-in."},"521":{"id":"/js/wp-release/v0.18.1/changesets-11","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#single-project-repositories-without-a-config-file","content":"Explicit descriptors replace automatic detection and define the entire version target list. For a plugin whose version appears in its header, readme and a PHP constant:"},"522":{"id":"/js/wp-release/v0.18.1/changesets-12","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#single-project-repositories-without-a-config-file","content":"The same project flags belong on `changeset-add`, `changeset-status`, `changeset-version` and `changeset-tag`. Keep them consistent across all four commands, for example in command-specific npm scripts. An accompanying `package.json` used for build tools isn't changed unless it is included explicitly."},"523":{"id":"/js/wp-release/v0.18.1/changesets-13","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#single-project-repositories-without-a-config-file","content":"| Flag                            | Version descriptor                     |\n| ------------------------------- | -------------------------------------- |\n| `--version-package-json <file>` | npm manifest version source and target |","table":"table-0"},"524":{"id":"/js/wp-release/v0.18.1/changesets-14","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#single-project-repositories-without-a-config-file","content":"| Flag                             | Version descriptor                                                                                                       |\n| -------------------------------- | ------------------------------------------------------------------------------------------------------------------------ |\n| `--version-composer-json <file>` | Composer manifest version source and target; a target without a `version` field is skipped, while a source must have one |","table":"table-0"},"525":{"id":"/js/wp-release/v0.18.1/changesets-15","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#single-project-repositories-without-a-config-file","content":"| Flag                                | Version descriptor                                |\n| ----------------------------------- | ------------------------------------------------- |\n| `--version-wordpress-plugin <file>` | WordPress plugin Version header source and target |","table":"table-0"},"526":{"id":"/js/wp-release/v0.18.1/changesets-16","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#single-project-repositories-without-a-config-file","content":"| Flag                               | Version descriptor                               |\n| ---------------------------------- | ------------------------------------------------ |\n| `--version-wordpress-theme <file>` | WordPress theme Version header source and target |","table":"table-0"},"527":{"id":"/js/wp-release/v0.18.1/changesets-17","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#single-project-repositories-without-a-config-file","content":"| Flag                                    | Version descriptor                                                                                        |\n| --------------------------------------- | --------------------------------------------------------------------------------------------------------- |\n| `--version-wordpress-stable-tag <file>` | WordPress readme Stable tag source and target; keeps its stable version during pre-releases and snapshots |","table":"table-0"},"528":{"id":"/js/wp-release/v0.18.1/changesets-18","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#single-project-repositories-without-a-config-file","content":"| Flag                                       | Version descriptor                                  |\n| ------------------------------------------ | --------------------------------------------------- |\n| `--version-php-constant <file>#<constant>` | PHP `define()` or `const` version source and target |","table":"table-0"},"529":{"id":"/js/wp-release/v0.18.1/changesets-19","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#single-project-repositories-without-a-config-file","content":"| Flag                          | Version descriptor                                                                                                      |\n| ----------------------------- | ----------------------------------------------------------------------------------------------------------------------- |\n| `--version-git-tag <pattern>` | Current version from existing stable Git tags, with a pattern such as `v{version}`; source-only, never a version target |","table":"table-0"},"530":{"id":"/js/wp-release/v0.18.1/changesets-20","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#single-project-repositories-without-a-config-file","content":"File descriptor flags are repeatable. The source is inferred from a sole descriptor, or a unique descriptor other than a Stable tag. Otherwise use `--version-from <kind>`, where kind is `package-json`, `composer-json`, `wordpress-plugin`, `wordpress-theme`, `wordpress-stable-tag`, `php-constant` or `git-tag`. For repeated kinds, qualify the selector with the exact descriptor value: `--version-from package-json:package.json` or `--version-from 'php-constant:my-plugin.php#MY_PLUGIN_VERSION'`. Argument order doesn't select the source. A Git source requires a matching existing stable tag; its pattern selects the tags to read, while `--tag-format` controls tags to create. With multiple descriptors, explicitly select `git-tag` if it is the authoritative source."},"531":{"id":"/js/wp-release/v0.18.1/changesets-21","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#single-project-repositories-without-a-config-file","content":"| Shared option           | Config equivalent                                                                                                       |\n| ----------------------- | ----------------------------------------------------------------------------------------------------------------------- |\n| `--project-name <name>` | `id`, the literal changeset identifier of the root package, instead of the manifest name or checkout directory basename |","table":"table-1"},"532":{"id":"/js/wp-release/v0.18.1/changesets-22","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#single-project-repositories-without-a-config-file","content":"| Shared option            | Config equivalent                                                 |\n| ------------------------ | ----------------------------------------------------------------- |\n| `--base-branch <branch>` | `baseBranch`, used with the remote for the default comparison ref |","table":"table-1"},"533":{"id":"/js/wp-release/v0.18.1/changesets-23","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#single-project-repositories-without-a-config-file","content":"| Shared option     | Config equivalent                                       |\n| ----------------- | ------------------------------------------------------- |\n| `--remote <name>` | `remote`, used for comparisons and pushing release tags |","table":"table-1"},"534":{"id":"/js/wp-release/v0.18.1/changesets-24","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#single-project-repositories-without-a-config-file","content":"| Shared option            | Config equivalent                             |\n| ------------------------ | --------------------------------------------- |\n| `--changesets-dir <dir>` | `changesets`, relative to the repository root |","table":"table-1"},"535":{"id":"/js/wp-release/v0.18.1/changesets-25","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#single-project-repositories-without-a-config-file","content":"| Shared option                                  | Config equivalent                                                |\n| ---------------------------------------------- | ---------------------------------------------------------------- |\n| `--readme-changelog` / `--no-readme-changelog` | `readmeChangelog`, independent of updating the readme Stable tag |","table":"table-1"},"536":{"id":"/js/wp-release/v0.18.1/changesets-26","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#single-project-repositories-without-a-config-file","content":"| Shared option                       | Config equivalent                                                                                          |\n| ----------------------------------- | ---------------------------------------------------------------------------------------------------------- |\n| `--changelog-insert-after <marker>` | `changelogInsertAfter`; must exist in `CHANGELOG.md` and, with readme changelog updates, the plugin readme |","table":"table-1"},"537":{"id":"/js/wp-release/v0.18.1/changesets-27","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#single-project-repositories-without-a-config-file","content":"| Shared option           | Config equivalent                               |\n| ----------------------- | ----------------------------------------------- |\n| `--tag-format <format>` | `tagFormat`, replacing the default `v{version}` |","table":"table-1"},"538":{"id":"/js/wp-release/v0.18.1/changesets-28","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#single-project-repositories-without-a-config-file","content":"An explicit `--config` must load successfully. Otherwise a discovered config takes precedence over the single-project fallback. Single-project descriptor and settings flags cannot be mixed with a config file; put those settings in the config instead. The existing global `--tag-format` override works in both modes. Config files remain the place for package layouts, dependents, custom version and changelog callbacks, deployment destinations and distribution settings. Packaging and deployment commands retain their existing config requirements."},"539":{"id":"/js/wp-release/v0.18.1/changesets-29","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#single-project-repositories-without-a-config-file","content":"Typical release flow, from a feature pull request to the publish workflows triggered by release tags:"},"540":{"id":"/js/wp-release/v0.18.1/changesets-30","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#single-project-repositories-without-a-config-file","content":"An empty changeset marks a feature PR as no-release. The version workflow consumes it without changing versions, and a release PR containing only its deletion produces no tags."},"541":{"id":"/js/wp-release/v0.18.1/changesets-31","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#single-project-repositories-without-a-config-file","content":"`version.from` selects the current version; `version.to` lists release targets. Use `phpConstantVersion( { file, constant } )` to sync a PHP constant."},"542":{"id":"/js/wp-release/v0.18.1/changesets-32","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#single-project-checks-in-github-actions","content":"There are no dedicated build or changeset wrapper actions. Install the CLI in your project and run it directly. A root npm package can check a pull request with:"},"543":{"id":"/js/wp-release/v0.18.1/changesets-33","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#single-project-checks-in-github-actions","content":"For a plugin with several version targets, put the same descriptor flags in npm scripts for all four changeset commands. Full Git history and tags are needed for comparisons, Git version sources and release notes. Keep the checkout directory name consistent when it supplies the changeset identifier. Directory artifacts use `npx --no-install wp-release build --output dist/my-plugin --github-output`; upload that directory with your artifact action. `build` writes manifest sidecars outside the directory and does not accept the ZIP-only embedding, codec or manifest-filename flags."},"544":{"id":"/js/wp-release/v0.18.1/changesets-34","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#packages-and-tags","content":"The config describes the repository, so wp-release assumes no directory structure or naming convention of its own:"},"545":{"id":"/js/wp-release/v0.18.1/changesets-35","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#packages-and-tags","content":"**Packages** are the directories that the `glob` of a `packages` entry matches under `root`, with `*`, `?` and `**`, like `plugins/*`, or `.` for a repository with one package at its root. The settings of an entry apply to each of its packages. Discovery never looks inside `.git`, `node_modules`, `vendor` or `dist` directories. A package is identified by its path, or with `idFrom` by the name in its `package.json` or `composer.json`, or with a literal `id` when the group matches exactly one package, and commands that take a package accept a path or identifier."},"546":{"id":"/js/wp-release/v0.18.1/changesets-36","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#packages-and-tags","content":"**Templates** name the tags and the deploy targets of a package with these placeholders:"},"547":{"id":"/js/wp-release/v0.18.1/changesets-37","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#packages-and-tags","content":"| Placeholder | Value                                                                 | `plugins/alpha` | Root package |\n| ----------- | --------------------------------------------------------------------- | --------------- | ------------ |\n| `{path}`    | Package directory relative to `root`, empty for a package at the root | `plugins/alpha` | (empty)      |","table":"table-2"},"548":{"id":"/js/wp-release/v0.18.1/changesets-38","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#packages-and-tags","content":"| Placeholder | Value              | `plugins/alpha`                                     | Root package                             |\n| ----------- | ------------------ | --------------------------------------------------- | ---------------------------------------- |\n| `{name}`    | Package identifier | `plugins/alpha`, or its manifest name with `idFrom` | the manifest name, or the directory name |","table":"table-2"},"549":{"id":"/js/wp-release/v0.18.1/changesets-39","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#packages-and-tags","content":"| Placeholder | Value            | `plugins/alpha` | Root package |\n| ----------- | ---------------- | --------------- | ------------ |\n| `{version}` | Released version | `1.2.0`         | `1.2.0`      |","table":"table-2"},"550":{"id":"/js/wp-release/v0.18.1/changesets-40","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#packages-and-tags","content":"Deploy templates also have `{branch}`, `{ref}` and `{revision}` (see Deploy configured packages), and any template can be a callback that receives the package, for names that the placeholders don't cover, like the last directory of the path."},"551":{"id":"/js/wp-release/v0.18.1/changesets-41","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#packages-and-tags","content":"**`tagFormat`** names the release tags, `{path}/{version}` by default, like `plugins/alpha/1.2.0`. Empty placeholders leave no leading or repeated slashes in a tag, so a package at the root gets plain version tags, like `1.2.0`, from the same default. Deploy templates, like repository URLs, are filled in as they are. A `gitTagVersion()` version source reads the tags with its own `pattern`, also `{path}/{version}` by default, so set both when you change the format."},"552":{"id":"/js/wp-release/v0.18.1/changesets-42","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#packages-and-tags","content":"**`releaseTitle`** titles the release, like the `title` that `changeset-tag` reports for creating a GitHub Release. The default is `name@version`, like `plugins/alpha@1.2.0`, without the prefix for a package at the repository root, which is titled `1.2.0` like its tag. Like `tagFormat`, it supports `{name}`, `{path}`, `{version}` and `{tag}` placeholders: `releaseTitle: '{version} (beta)'`, or a callback that receives `{ package, version, tag }` like the release notes callback. A template without a placeholder fails at load time, since it would name every release alike. `changeset-tag --release-title <template>` replaces the `releaseTitle` of the config for one command, like `--tag-format` replaces `tagFormat`."},"553":{"id":"/js/wp-release/v0.18.1/changesets-43","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#packages-and-tags","content":"**`--tag-format <format>`** replaces the `tagFormat` of the config for one command, for a workflow or job that names its tags differently, like `--tag-format '{name}@{version}'`. Every command that creates or reads the same tags needs the same format: `changeset-tag`, which creates them and finds the previous tag for the release notes, `changeset-version --prerelease`, which numbers pre-releases from them, and `deploy-git` and `deploy-svn --release-ref`, which read the package and version of a tag."},"554":{"id":"/js/wp-release/v0.18.1/changesets-44","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#packages-and-tags","content":"**Slugs** are a WordPress concept: the folder of a plugin or theme. Only the commands that produce something for WordPress use one: the `{slug}/` root folder and name of a `zip`, the `checksums` manifest, the WordPress.org slug of `deploy-svn`, and `version-check`. Each takes `--slug`, which defaults to the name of the working directory, or of the package directory with `zip --package`, and an SVN deploy target takes `slug`, which defaults to the name of the package directory. Tags and Git deploy targets don't have a slug."},"555":{"id":"/js/wp-release/v0.18.1/changesets-45","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#packages-and-tags","content":"**`remote`** is the git remote that `changeset-tag --push` pushes tags to and that the base branch is compared on, `origin` by default."},"556":{"id":"/js/wp-release/v0.18.1/changesets-46","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#packages-and-tags","content":"The default strategy bumps stable `x.y.z` versions with SemVer rules, and the `x.y` and `x.y.z.w` versions common in WordPress plugins the same way: the bumped part is raised, the parts after it reset to `0`, and the version keeps its number of parts. A minor bump of `2.1` is `2.2` and a major bump is `3.0`, while a patch bump adds the third part, `2.1.1`. A patch bump of `1.2.3.4` is `1.2.4.0`, so raising only the fourth part needs a custom strategy. Configure `nextVersion( { package, bump, currentVersion, changesets } )` for other formats; changeset bumps remain `patch`, `minor` or `major`. Pre-releases are added to the next version with `--prerelease`, described below."},"557":{"id":"/js/wp-release/v0.18.1/changesets-47","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#packages-and-tags","content":"Without `--since`, `changeset-status` compares against `<remote>/<baseBranch>`, where `remote` in the config defaults to `origin` and is also the remote that `changeset-tag --push` pushes tags to; fetch that ref or pass `--since` when using a fork or different upstream. `loadChangesetConfig()` discovers a conventional config at the repository root, unless `--config <path>` selects one explicitly."},"558":{"id":"/js/wp-release/v0.18.1/changesets-48","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#packages-and-tags","content":"Add release notes in a feature PR with `npx wp-release changeset-add`. In a terminal, it lists the packages, marks the ones that changed since `<remote>/<baseBranch>` (or `--since <ref>`) without a changeset, and asks for the packages to release, a `patch`, `minor` or `major` bump for each, and the release note. Choose packages by number, identifier or path, or press Enter to release the changed ones; `none` adds an empty changeset. Changed files include uncommitted and untracked ones, since changesets are usually added before committing."},"559":{"id":"/js/wp-release/v0.18.1/changesets-49","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#packages-and-tags","content":"Without a terminal, or for scripts, pass the changeset as options: `npx wp-release changeset-add --package @vendor/plugin --bump patch --summary \"Fix the checkout validation.\"`. Repeat package and bump flags for multiple packages, or use `--empty` when no release is needed. A package can also be named by its path under `root`, like `plugins/alpha`, and the changeset records its identifier; `changeset-version --package` and `changeset-tag --package` accept paths too. A single `--bump` without `--package` releases every changed package without a changeset, like `changeset-add --bump patch --summary \"…\"` to fix a failing `changeset-status` check. `--json` and `--github-output` never ask."},"560":{"id":"/js/wp-release/v0.18.1/changesets-50","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#packages-and-tags","content":"In CI, `changeset-status --since origin/main` requires a changeset added by the PR; changesets already on the base do not count, while an empty PR changeset records an explicit no-release decision. Missing-change annotations identify an affected file."},"561":{"id":"/js/wp-release/v0.18.1/changesets-51","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#packages-and-tags","content":"On the release branch, preview with `changeset-version --dry-run`, then run `changeset-version` to update version targets and changelogs. By default, new Markdown entries go before the first version heading; `changelogInsertAfter` sets a literal insertion marker for `CHANGELOG.md` and, with `readmeChangelog`, the plugin readme. Put the marker in both files; a missing marker is an error. Without a marker, plugin readmes use the `== Changelog ==` heading. Failed updates are rolled back for safe retries."},"562":{"id":"/js/wp-release/v0.18.1/changesets-52","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#packages-and-tags","content":"Configure `changelogEntry( { package, changeset, commit } )` to format the changelog entry of each changeset, where `commit` is the `{ hash, shortHash, subject }` of the commit that added the changeset file, if it's committed. The formatted entries go into `CHANGELOG.md`, the `changelog` of each release in the `changeset-version` result, and so the release notes; plugin readmes keep the plain summaries. Without the callback, entries are the plain summaries. For example, to link each entry to its commit:"},"563":{"id":"/js/wp-release/v0.18.1/changesets-53","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#packages-and-tags","content":"Configure `dependents` to re-release packages that bundle a package when it releases. The dependents come from what the packages declare: a package is a dependent of a source when the spec that it declares in its npm `dependencies` or `optionalDependencies` (or the sections that the policy adds) resolves the current version of the source or points at the workspace, and it re-releases when the next version of the source falls outside the declared range, or always with `when: 'always'`. A pin to an older version selects a registry release instead and `changeset-status` warns about the drift until the pin resolves the package again. Versioning a dependent rewrites its declared specs of the source to the released version, keeping their range prefixes, so an exact pin matches the released workspace again and the built bundle matches the changelog. Wildcards and unpinned ranges accept the release without one, like the `devDependencies` of a package. The derived dependents appear in `changeset-status`, `changeset-version` and `changeset-tag` like any other release, and a dependent that releases for its own reasons keeps its own bump and appends the bundle note:"},"564":{"id":"/js/wp-release/v0.18.1/changesets-54","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#packages-and-tags","content":"Excluded packages still release with their own changesets and stay out of the automatic re-releases."},"565":{"id":"/js/wp-release/v0.18.1/changesets-55","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#packages-and-tags","content":"When the changesets of a pull request release a source, `changeset-status` requires no changeset for a dependent whose only change is the spec of that source in its `package.json`, since versioning rewrites the spec and the bundle note announces it. Any other change to the dependent, like another manifest field or dependency, documentation or code, needs its own changeset."},"566":{"id":"/js/wp-release/v0.18.1/changesets-56","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#packages-and-tags","content":"The bundle changelog entry defaults to `Bundle <source> <version>.` and is formatted with `dependents.changelog( { package, source } )`:"},"567":{"id":"/js/wp-release/v0.18.1/changesets-57","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#packages-and-tags","content":"`dependents.sections` lists the npm dependency sections that declare a source, defaulting to `dependencies` and `optionalDependencies`; add `devDependencies` for dependencies that end up in the dependent's build, or `peerDependencies` to scan them."},"568":{"id":"/js/wp-release/v0.18.1/changesets-58","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#packages-and-tags","content":"The `dependents.dependency` hooks extend the built-in npm scan instead of replacing it, so that both work behind the same range rule and rewrite:"},"569":{"id":"/js/wp-release/v0.18.1/changesets-59","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#packages-and-tags","content":"After versioning, run `npm install --package-lock-only` so that the root lockfile resolves the rewritten pins to the workspace links again; the `Prepare Release` workflow (`prepare-release.yml` in this monorepo) does it with its release pull request."},"570":{"id":"/js/wp-release/v0.18.1/changesets-60","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#packages-and-tags","content":"To release packages separately, for example with a release pull request for each, pass `--package <name>`, repeatable, to version only those packages. A changeset that also names other packages keeps only their entries and its summary, so it still applies to their releases with the same bump. Changesets without packages are left for a run without `--package`."},"571":{"id":"/js/wp-release/v0.18.1/changesets-61","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#packages-and-tags","content":"The `changeset-version` result lists each release with its `package`, `bump`, `currentVersion`, `nextVersion` and `changelog` entries, a Markdown list like the one added to `CHANGELOG.md`. Use it to name and describe the release pull request in a repository script, or call `versionChangesets()` from the library and format the entries of each release with `formatChangelogEntries( release.changesets )`."},"572":{"id":"/js/wp-release/v0.18.1/changesets-62","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#packages-and-tags","content":"After merging the release PR, `changeset-tag --since <merge-commit>^1 --push` pushes tags only for packages changed by that release. It pushes one tag at a time because GitHub doesn't trigger workflows for a push of more than three tags. wp-release doesn't create GitHub Releases: with `--json` or `--github-output`, each entry of `tags` has the `tag`, a `title` like `plugins/alpha@1.2.0` or, for a package at the repository root, the release title like `1.2.0` (see releaseTitle, and `--release-title` for overriding it in one command), the release `notes` and a `prerelease` flag, for a workflow step like `softprops/action-gh-release` to create the release (see the example below). For initial adoption, preview all missing tags with `changeset-tag --dry-run` (without `--since`), then push if needed. To release each package with a separate workflow instead, `changeset-tag --since <merge-commit>^1 --untagged --github-output` lists the releases that don't have a tag yet, without creating any. Tag pushes need Git write credentials."},"573":{"id":"/js/wp-release/v0.18.1/changesets-63","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#packages-and-tags","content":"To release a single package, for example from a manual workflow, pass `--package <name>`, repeatable, and with one package `--version <version>` to fail unless the package is at that version. Packages versioned by git tags have no version file, so for them `--version` is the version to tag. Before a tag is created, every `version.to` target must match the version, so a plugin `Version` header that disagrees with its readme `Stable tag` blocks the tag. Versions with a pre-release part, like `1.0.0-rc.1`, have `prerelease` set, so their GitHub Releases can be marked as pre-releases. This example selects one package, so `tags[0]` is its release; these fields are nested in the JSON result:"},"574":{"id":"/js/wp-release/v0.18.1/changesets-64","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#packages-and-tags","content":"The release notes are the version's `CHANGELOG.md` section, or without one the commits that changed the package since its previous tag, the highest version below the released one, skipping pre-releases for a stable version. Configure `releaseNotes( { package, version, tag, previousTag, changelog, commits, notes } )` to format them, for example to add links; `notes` is the default text and `commits` lists `{ hash, shortHash, subject }`, newest first. `changeset-tag --package <name> --dry-run` prints them without creating the tag."},"575":{"id":"/js/wp-release/v0.18.1/changesets-65","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#packages-and-tags","content":"For local development, run the TypeScript source with `npm run wp-release -- <command>` (for example, `npm run wp-release -- changeset-status --since origin/main`). GitHub workflows use the same CLI for versioning and tagging. `SUBTREE_DEPLOY_TOKEN` lets them update the release PR and push tags, and the `Tag Release` workflow passes it to `softprops/action-gh-release` to create the GitHub Releases."},"576":{"id":"/js/wp-release/v0.18.1/changesets-66","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#pre-releases","content":"`changeset-version --prerelease <id>` (the `prerelease` option of `versionChangesets()`) releases pre-releases of the next versions, like `1.3.0-rc.1` for a minor bump of `1.2.0`. The identifier, like `alpha`, `beta` or `rc`, can have a number, like `rc.2`, which is used as is and fails when the version is already tagged. Without a number, the number is one above the highest existing tag of that identifier and next stable version, read with the `tagFormat` of the package, so the first one is `rc.1`, and the numbering starts again at `.1` when later changesets raise the next version. The dependents of a source become pre-releases too, so that they bundle its pre-release, unless they're left out with `--no-dependents`."},"577":{"id":"/js/wp-release/v0.18.1/changesets-67","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#pre-releases","content":"A pre-release writes every version target except the readme `Stable tag`, which keeps the last stable version since WordPress.org offers it to every site, and `changeset-tag` skips the `Stable tag` when it verifies a pre-release. The changelog gets a section for the pre-release, like `## 1.3.0-rc.1 (2026-10-12)`, so that `changeset-tag` finds its release notes, and the changesets are consumed like in any release."},"578":{"id":"/js/wp-release/v0.18.1/changesets-68","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#pre-releases","content":"Since a pre-release consumes the changesets that the stable release needs, run it on a branch that isn't merged, and tag that branch commit:"},"579":{"id":"/js/wp-release/v0.18.1/changesets-69","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#pre-releases","content":"The base branch keeps its stable versions and pending changesets, so the stable release later versions them as usual, in one changelog section. The tag keeps the pre-release commit reachable after the branch is reset or deleted. The release notes of a stable release compare with the previous stable release, skipping the pre-releases before it, and the `git-tag` version source ignores pre-release tags, so packages versioned by git tags keep building on their last stable version."},"580":{"id":"/js/wp-release/v0.18.1/changesets-70","page_id":"/js/wp-release/v0.18.1/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/changesets#snapshots","content":"`changeset-version --snapshot <id>` (the `snapshot` option of `versionChangesets()`) releases snapshots of the next versions for test builds, like `1.3.0-pr-251.20261012183005` for a pull request: the next version with the identifier, like `pr-251` or `pr-251.0abc123` with a commit hash, and the UTC time, so that every snapshot is unique and they sort by time. Snapshots aren't numbered from tags and can't be combined with `--prerelease`. Like a pre-release, a snapshot writes every version target except the readme `Stable tag`. Build and publish the versioned files without committing them, for example under an npm dist-tag like `pr-251`, since a snapshot consumes the changesets:"},"581":{"id":"/js/wp-release/v0.18.1/cli","page_id":"/js/wp-release/v0.18.1/cli","type":"page","content":"CLI","breadcrumbs":["Docs","Js","Wp release","v0.18.1"],"tags":[],"url":"/js/wp-release/v0.18.1/cli"},"582":{"id":"/js/wp-release/v0.18.1/cli-0","page_id":"/js/wp-release/v0.18.1/cli","type":"heading","tags":[],"url":"/js/wp-release/v0.18.1/cli#cli","content":"CLI"},"583":{"id":"/js/wp-release/v0.18.1/cli-1","page_id":"/js/wp-release/v0.18.1/cli","type":"heading","tags":[],"url":"/js/wp-release/v0.18.1/cli#github-actions-annotations-and-job-summaries","content":"GitHub Actions annotations and job summaries"},"584":{"id":"/js/wp-release/v0.18.1/cli-2","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#cli","content":"| Command                                                    | Description                                   |\n| ---------------------------------------------------------- | --------------------------------------------- |\n| `wp-release build [<source-dir>] --output <dir> [options]` | Copy selected release files into a directory. |","table":"table-0"},"585":{"id":"/js/wp-release/v0.18.1/cli-3","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#cli","content":"| Command                                   | Description                                                                  |\n| ----------------------------------------- | ---------------------------------------------------------------------------- |\n| `wp-release zip [<source-dir>] [options]` | Create a ZIP archive with a `{slug}/` root folder, respecting `.distignore`. |","table":"table-0"},"586":{"id":"/js/wp-release/v0.18.1/cli-4","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#cli","content":"| Command                                         | Description                                                                         |\n| ----------------------------------------------- | ----------------------------------------------------------------------------------- |\n| `wp-release checksums [<source-dir>] [options]` | Write the MD5 and SHA-256 hashes of every distributed file to a checksums manifest. |","table":"table-0"},"587":{"id":"/js/wp-release/v0.18.1/cli-5","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#cli","content":"| Command                               | Description                                                                                                            |\n| ------------------------------------- | ---------------------------------------------------------------------------------------------------------------------- |\n| `wp-release sign <file>... [options]` | Sign files with Ed25519, writing a detached `<file>.sig` next to each, or minisign and SSH signatures with `--format`. |","table":"table-0"},"588":{"id":"/js/wp-release/v0.18.1/cli-6","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#cli","content":"| Command             | Description                                                                                      |\n| ------------------- | ------------------------------------------------------------------------------------------------ |\n| `wp-release keygen` | Generate a base64 Ed25519 private seed and its public key, also as minisign and SSH public keys. |","table":"table-0"},"589":{"id":"/js/wp-release/v0.18.1/cli-7","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#cli","content":"| Command                                                         | Description                                                                |\n| --------------------------------------------------------------- | -------------------------------------------------------------------------- |\n| `wp-release verify [<source-dir>] --checksums <file> [options]` | Check a plugin or theme directory, or a ZIP, against a checksums manifest. |","table":"table-0"},"590":{"id":"/js/wp-release/v0.18.1/cli-8","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#cli","content":"| Command                                             | Description                                                                            |\n| --------------------------------------------------- | -------------------------------------------------------------------------------------- |\n| `wp-release version-check [<source-dir>] [options]` | Check that the `Version` header, readme `Stable tag`, PHP constants and git tag agree. |","table":"table-0"},"591":{"id":"/js/wp-release/v0.18.1/cli-9","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#cli","content":"| Command                                          | Description                                                 |\n| ------------------------------------------------ | ----------------------------------------------------------- |\n| `wp-release deploy-svn [<source-dir>] [options]` | Deploy a plugin to the WordPress.org plugin SVN repository. |","table":"table-0"},"592":{"id":"/js/wp-release/v0.18.1/cli-10","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#cli","content":"| Command                                                          | Description                                                                             |\n| ---------------------------------------------------------------- | --------------------------------------------------------------------------------------- |\n| `wp-release deploy-git [<source-dir>] --git-url <url> [options]` | Deploy the files of a plugin, theme or package to a Git repository as a release commit. |","table":"table-0"},"593":{"id":"/js/wp-release/v0.18.1/cli-11","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#cli","content":"| Command                                                                 | Description                                                                     |\n| ----------------------------------------------------------------------- | ------------------------------------------------------------------------------- |\n| `wp-release deploy-git --release-ref <ref> [--package <name>] [--list]` | Deploy the configured packages of a release tag or branch to their Git targets. |","table":"table-0"},"594":{"id":"/js/wp-release/v0.18.1/cli-12","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#cli","content":"| Command                                                                 | Description                                                     |\n| ----------------------------------------------------------------------- | --------------------------------------------------------------- |\n| `wp-release deploy-svn --release-ref <ref> [--package <name>] [--list]` | Deploy the configured plugin of a release tag to WordPress.org. |","table":"table-0"},"595":{"id":"/js/wp-release/v0.18.1/cli-13","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#cli","content":"| Command                                        | Description                                                |\n| ---------------------------------------------- | ---------------------------------------------------------- |\n| `wp-release i18n-pot [<source-dir>] [options]` | Extract translatable strings into a reproducible POT file. |","table":"table-0"},"596":{"id":"/js/wp-release/v0.18.1/cli-14","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#cli","content":"| Command                                          | Description                                               |\n| ------------------------------------------------ | --------------------------------------------------------- |\n| `wp-release i18n-audit [<source-dir>] [options]` | Report translation string problems without writing files. |","table":"table-0"},"597":{"id":"/js/wp-release/v0.18.1/cli-15","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#cli","content":"| Command                                  | Description                           |\n| ---------------------------------------- | ------------------------------------- |\n| `wp-release i18n-mo <file.po> [options]` | Compile a translated PO file into MO. |","table":"table-0"},"598":{"id":"/js/wp-release/v0.18.1/cli-16","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#cli","content":"| Command                                                      | Description                                                                              |\n| ------------------------------------------------------------ | ---------------------------------------------------------------------------------------- |\n| `wp-release i18n-json <file.po> --domain <domain> [options]` | Compile the JavaScript strings of a translated PO file into WordPress script JSON files. |","table":"table-0"},"599":{"id":"/js/wp-release/v0.18.1/cli-17","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#cli","content":"| Command                                   | Description                                                     |\n| ----------------------------------------- | --------------------------------------------------------------- |\n| `wp-release i18n-php <file.po> [options]` | Compile a translated PO file into a WordPress `.l10n.php` file. |","table":"table-0"},"600":{"id":"/js/wp-release/v0.18.1/cli-18","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#cli","content":"| Command                              | Description                                  |\n| ------------------------------------ | -------------------------------------------- |\n| `wp-release changeset-add [options]` | Record the release impact of a pull request. |","table":"table-0"},"601":{"id":"/js/wp-release/v0.18.1/cli-19","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#cli","content":"| Command                                 | Description                                                      |\n| --------------------------------------- | ---------------------------------------------------------------- |\n| `wp-release changeset-status [options]` | List pending releases and check changed packages for changesets. |","table":"table-0"},"602":{"id":"/js/wp-release/v0.18.1/cli-20","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#cli","content":"| Command                                  | Description                                |\n| ---------------------------------------- | ------------------------------------------ |\n| `wp-release changeset-version [options]` | Apply version bumps and changelog entries. |","table":"table-0"},"603":{"id":"/js/wp-release/v0.18.1/cli-21","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#cli","content":"| Command                              | Description                          |\n| ------------------------------------ | ------------------------------------ |\n| `wp-release changeset-tag [options]` | Create missing package release tags. |","table":"table-0"},"604":{"id":"/js/wp-release/v0.18.1/cli-22","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#cli","content":"Run `npx wp-release <command> --help` for the options of each command. Directory-based commands accept a first `<source-dir>` argument or `--source-dir`, defaulting to the current directory. `sign` and the `i18n-mo`, `i18n-json` and `i18n-php` compilers take file arguments, `keygen` generates keys, and changeset commands operate on the configured repository. Every command prints its result as JSON with `--json`. Commands that take no positional arguments, like the changeset commands, reject bare arguments with the usage instead of ignoring them."},"605":{"id":"/js/wp-release/v0.18.1/cli-23","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#cli","content":"In GitHub Actions, `--github-output` writes the complete result as JSON to `steps.<id>.outputs.result` and exposes each top-level string, number or boolean as a plain output. Use `steps.zip.outputs.zipPath` for a ZIP path, for example. Arrays and objects remain in `result`: tag metadata is read with `fromJSON( steps.tag.outputs.result ).tags[0].tag`, even when only one package is selected. There is no plain `steps.tag.outputs.tag` output."},"606":{"id":"/js/wp-release/v0.18.1/cli-24","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#cli","content":"Prefer plain outputs in steps that run conditionally, since a skipped step has empty outputs. When reading JSON from a step that may be skipped, use a fallback such as `fromJSON( steps.tag.outputs.result || '{\"tags\":[]}' ).tags[0].tag`. For several tags or deploys, read the arrays in `result` to build a job matrix or process each item."},"607":{"id":"/js/wp-release/v0.18.1/cli-25","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#github-actions-annotations-and-job-summaries","content":"With the `github` log format, the CLI uses current GitHub Actions features to report problems where you look for them, instead of only in the log. `--log-format <name>` picks how the CLI logs, separately from the result that `--json` prints:"},"608":{"id":"/js/wp-release/v0.18.1/cli-26","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#github-actions-annotations-and-job-summaries","content":"| Log format | Output                                          |\n| ---------- | ----------------------------------------------- |\n| `text`     | Plain text. The default outside GitHub Actions. |","table":"table-1"},"609":{"id":"/js/wp-release/v0.18.1/cli-27","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#github-actions-annotations-and-job-summaries","content":"| Log format | Output                                                                                                              |\n| ---------- | ------------------------------------------------------------------------------------------------------------------- |\n| `github`   | GitHub Actions annotations and job summaries. The default when `GITHUB_ACTIONS=true`. `--ci` is a shorthand for it. |","table":"table-1"},"610":{"id":"/js/wp-release/v0.18.1/cli-28","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#github-actions-annotations-and-job-summaries","content":"Pass `--log-format text` for plain text in GitHub Actions. The GitHub Actions always use the `github` log format. Only the CLI checks `GITHUB_ACTIONS`: the library classes don't read the environment, and choose the format by the writer they get."},"611":{"id":"/js/wp-release/v0.18.1/cli-29","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#github-actions-annotations-and-job-summaries","content":"Errors, warnings and notices are printed as workflow commands, so they show up as annotations on the run and on the files of a pull request:"},"612":{"id":"/js/wp-release/v0.18.1/cli-30","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#github-actions-annotations-and-job-summaries","content":"`version-check` and `deploy-svn` annotate each version mismatch on the file and line of the version: the `Version` header, the readme `Stable tag` or the PHP constant."},"613":{"id":"/js/wp-release/v0.18.1/cli-31","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#github-actions-annotations-and-job-summaries","content":"`verify` annotates each changed file and each file that isn't in the checksums."},"614":{"id":"/js/wp-release/v0.18.1/cli-32","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#github-actions-annotations-and-job-summaries","content":"Each command also adds a section to the job summary of the run, when `GITHUB_STEP_SUMMARY` is set:"},"615":{"id":"/js/wp-release/v0.18.1/cli-33","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#github-actions-annotations-and-job-summaries","content":"| Command      | Summary                                                                                                                                                                                            |\n| ------------ | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `deploy-svn` | Plugin, linked to its WordPress.org page, version, written SVN paths, the commit linked to its WordPress.org changeset (or the dry run or no-op result), and the SVN changes in a collapsed table. |","table":"table-2"},"616":{"id":"/js/wp-release/v0.18.1/cli-34","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#github-actions-annotations-and-job-summaries","content":"| Command      | Summary                                                   |\n| ------------ | --------------------------------------------------------- |\n| `deploy-git` | Repository, release commit and the pushed branch and tag. |","table":"table-2"},"617":{"id":"/js/wp-release/v0.18.1/cli-35","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#github-actions-annotations-and-job-summaries","content":"| Command | Summary                                                                                               |\n| ------- | ----------------------------------------------------------------------------------------------------- |\n| `build` | Output directory, number of copied files and optional manifest; requested signatures and public keys. |","table":"table-2"},"618":{"id":"/js/wp-release/v0.18.1/cli-36","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#github-actions-annotations-and-job-summaries","content":"| Command | Summary                                                                                                                |\n| ------- | ---------------------------------------------------------------------------------------------------------------------- |\n| `zip`   | ZIP, number of files and checksums manifest; with `--sign`, signature files and the public key of each written format. |","table":"table-2"},"619":{"id":"/js/wp-release/v0.18.1/cli-37","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#github-actions-annotations-and-job-summaries","content":"| Command     | Summary                       |\n| ----------- | ----------------------------- |\n| `checksums` | Manifest and number of files. |","table":"table-2"},"620":{"id":"/js/wp-release/v0.18.1/cli-38","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#github-actions-annotations-and-job-summaries","content":"| Command | Summary                                                    |\n| ------- | ---------------------------------------------------------- |\n| `sign`  | Signature files and the public key of each written format. |","table":"table-2"},"621":{"id":"/js/wp-release/v0.18.1/cli-39","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#github-actions-annotations-and-job-summaries","content":"| Command  | Summary                                                                                  |\n| -------- | ---------------------------------------------------------------------------------------- |\n| `verify` | That all files match, or the counts and a table of the changed, missing and extra files. |","table":"table-2"},"622":{"id":"/js/wp-release/v0.18.1/cli-40","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#github-actions-annotations-and-job-summaries","content":"| Command         | Summary                                                                        |\n| --------------- | ------------------------------------------------------------------------------ |\n| `version-check` | The matching version, or a table of the mismatches with their files and lines. |","table":"table-2"},"623":{"id":"/js/wp-release/v0.18.1/cli-41","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#github-actions-annotations-and-job-summaries","content":"| Command            | Summary                                               |\n| ------------------ | ----------------------------------------------------- |\n| `changeset-status` | Each changed package with whether it has a changeset. |","table":"table-2"},"624":{"id":"/js/wp-release/v0.18.1/cli-42","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#github-actions-annotations-and-job-summaries","content":"| Command             | Summary                                                               |\n| ------------------- | --------------------------------------------------------------------- |\n| `changeset-version` | A table of the package releases with their version changes and bumps. |","table":"table-2"},"625":{"id":"/js/wp-release/v0.18.1/cli-43","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#github-actions-annotations-and-job-summaries","content":"| Command         | Summary                                                                                  |\n| --------------- | ---------------------------------------------------------------------------------------- |\n| `changeset-tag` | Each tag with its previous tag and status, and its release notes in a collapsed section. |","table":"table-2"},"626":{"id":"/js/wp-release/v0.18.1/cli-44","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#github-actions-annotations-and-job-summaries","content":"A failed command adds its error to the summary, or a table of its problems with their files and lines, listing up to 100 and counting the rest. The Markdown of the summaries isn't part of the library API. File paths are relative to `GITHUB_WORKSPACE`, or the current directory without it. Files outside it, like those of an extracted ZIP, get an annotation without a file. Multi-line messages stay one annotation."},"627":{"id":"/js/wp-release/v0.18.1/cli-45","page_id":"/js/wp-release/v0.18.1/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/cli#github-actions-annotations-and-job-summaries","content":"Use global `--config <path>` to select a config; relative paths resolve from the current directory. Otherwise, commands using the config discover `wp-release.config.js`, `.mjs` or `.cjs` at the repository root. Global `--tag-format <format>` replaces the `tagFormat` of the config for one command, see Packages and tags."},"628":{"id":"/js/wp-release/v0.18.1/comparison","page_id":"/js/wp-release/v0.18.1/comparison","type":"page","content":"Comparison with other tools","breadcrumbs":["Docs","Js","Wp release","v0.18.1"],"tags":[],"url":"/js/wp-release/v0.18.1/comparison"},"629":{"id":"/js/wp-release/v0.18.1/comparison-0","page_id":"/js/wp-release/v0.18.1/comparison","type":"heading","tags":[],"url":"/js/wp-release/v0.18.1/comparison#comparison-with-existing-tools","content":"Comparison with existing tools"},"630":{"id":"/js/wp-release/v0.18.1/comparison-1","page_id":"/js/wp-release/v0.18.1/comparison","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/comparison#comparison-with-existing-tools","content":"| Tool                                                             | What it does                                                                                                                                                                                                                                                                                                                | How `wp-release` differs                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |\n| ---------------------------------------------------------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| 10up WordPress.org plugin deploy and readme/asset update actions | Two separate GitHub Actions configured through env vars. A deploy always syncs the build to `trunk/` and copies it to the tag; readme and asset updates need the second action. Assets come from `.wordpress-org` by default, and files are selected with `.distignore` or `.gitattributes`. Files are synced with `rsync`. | One `deploy-svn` command with independent write flags, so a release, a readme-only update and an assets-only update are the same command with different flags. Runs locally and in any CI, not only GitHub Actions, and syncs in Node.js without `rsync`. Checks that the `Version` header, readme `Stable tag` and SVN tag agree before writing, which the 10up actions don't. Assets are deployed only when `--assets-dir` is passed, instead of always syncing `.wordpress-org` when it exists, so a plugin's own `assets/` folder is never uploaded by accident. Adds `--exclude` for patterns without an ignore file, opt-in Git `export-ignore` support and `--from-zip` to deploy the exact files of a ZIP. |","table":"table-0"},"631":{"id":"/js/wp-release/v0.18.1/comparison-2","page_id":"/js/wp-release/v0.18.1/comparison","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/comparison#comparison-with-existing-tools","content":"| Tool              | What it does                                                                                                     | How `wp-release` differs                                                                                                                                                                  |\n| ----------------- | ---------------------------------------------------------------------------------------------------------------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `grunt-wp-deploy` | Grunt task with `deploy_trunk` and `deploy_tag` booleans, interactive password prompts and a `Stable tag` check. | No Grunt dependency and never interactive. `--readme-only` is a separate flag, where `grunt-wp-deploy` can only update trunk with the full build. Assets are independent of trunk writes. |","table":"table-0"},"632":{"id":"/js/wp-release/v0.18.1/comparison-3","page_id":"/js/wp-release/v0.18.1/comparison","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/comparison#comparison-with-existing-tools","content":"| Tool                  | What it does                                                                     | How `wp-release` differs                                                                                                           |\n| --------------------- | -------------------------------------------------------------------------------- | ---------------------------------------------------------------------------------------------------------------------------------- |\n| codeinwp theme deploy | Fork of the 10up plugin action that commits themes to the themes SVN repository. | Doesn't deploy themes. Theme releases are ZIP uploads on WordPress.org; `zip` builds the upload with the theme folder as the root. |","table":"table-0"},"633":{"id":"/js/wp-release/v0.18.1/comparison-4","page_id":"/js/wp-release/v0.18.1/comparison","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/comparison#comparison-with-existing-tools","content":"| Tool              | What it does                                                                                             | How `wp-release` differs                                                                                                                                                                                                                                                                                                                                                                      |\n| ----------------- | -------------------------------------------------------------------------------------------------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `wp dist-archive` | WP-CLI command that zips a project using `.distignore`, with `--plugin-dirname` and `--filename-format`. | Same `.distignore` file and `{name}.{version}` style filename format, but needs only Node.js instead of PHP and WP-CLI. `.distignore` is matched with full gitignore syntax, including `!` negation, and `--distignore` / `--exclude` let you point at another ignore file or add patterns on the command line. Builds are reproducible, and `--checksums` writes a manifest next to the ZIP. |","table":"table-0"},"634":{"id":"/js/wp-release/v0.18.1/comparison-5","page_id":"/js/wp-release/v0.18.1/comparison","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/comparison#comparison-with-existing-tools","content":"| Tool               | What it does                                                                                                                                                                                                        | How `wp-release` differs                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |\n| ------------------ | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `wp i18n make-pot` | WP-CLI command that extracts PHP, JavaScript, `block.json` and `theme.json` strings into a POT, with `--domain`, `--include`/`--exclude`, `--headers`, `--file-comment`, `--merge`/`--subtract` and audit warnings. | `i18n-pot` and `i18n-audit` need only Node.js, write byte-for-byte reproducible POTs without dates, and `--check` fails CI on a stale POT. Headers are set one at a time with a repeatable `--header NAME=VALUE` instead of a JSON object, and `--include`/`--exclude` take one glob each, so patterns never need escaping or comma splitting. `--no-references` and `--all-domains` say what they do. Monorepos keep these settings once in `wp-release.config.js` and select packages with `--package` or `--all` instead of running the command for every directory. The audit is a separate read-only command with stable finding codes for `--suppress`, instead of warnings mixed into generation. There's no `--merge`, `--subtract` or `--skip-*`; `--include` and `--exclude` cover the same needs. |","table":"table-0"},"635":{"id":"/js/wp-release/v0.18.1/comparison-6","page_id":"/js/wp-release/v0.18.1/comparison","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/comparison#comparison-with-existing-tools","content":"| Tool                                          | What it does                                                                                                                                                                                          | How `wp-release` differs                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |\n| --------------------------------------------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `wp i18n make-mo`, `make-json` and `make-php` | WP-CLI commands that compile PO files into MO, script JSON and `.l10n.php` files. `make-json` maps sources with `--use-map` and removes JavaScript strings from the PO unless `--no-purge` is passed. | `i18n-mo`, `i18n-json` and `i18n-php` compile one translated PO at a time, never change it, and leave out fuzzy, obsolete and untranslated entries. `i18n-json` takes a many-to-many `--map` from source files to built scripts, and JSX and TypeScript sources need one, so catalogs are never written for files WordPress doesn't load. `--check` compares the outputs without writing. There's no `update-po`, so update PO files from the POT with gettext's `msgmerge` or a translation platform. |","table":"table-0"},"636":{"id":"/js/wp-release/v0.18.1/comparison-7","page_id":"/js/wp-release/v0.18.1/comparison","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/comparison#comparison-with-existing-tools","content":"| Tool                         | What it does                                                                          | How `wp-release` differs                                                                                                                                                                                                                        |\n| ---------------------------- | ------------------------------------------------------------------------------------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `wp plugin verify-checksums` | WP-CLI command that checks installed plugins against the WordPress.org checksums API. | Reads the same manifest format, but from a file, so it also works for plugins and themes that aren't hosted on WordPress.org and for build directories in CI. `checksums` writes the manifest that WordPress.org generates for its own plugins. |","table":"table-0"},"637":{"id":"/js/wp-release/v0.18.1/comparison-8","page_id":"/js/wp-release/v0.18.1/comparison","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/comparison#comparison-with-existing-tools","content":"| Tool                    | What it does                                                                                                                         | How `wp-release` differs                                                                                                                                                                                                                              |\n| ----------------------- | ------------------------------------------------------------------------------------------------------------------------------------ | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `wp-scripts plugin-zip` | Zips files from `package.json` `files` or a fixed allowlist, named after the npm package, with `--root-folder` / `--no-root-folder`. | Reuses the root folder flags, selects files with `.distignore` by default and can optionally honor Git `export-ignore` attributes, puts the version from the plugin headers in the filename and streams the archive instead of building it in memory. |","table":"table-0"},"638":{"id":"/js/wp-release/v0.18.1/configuration","page_id":"/js/wp-release/v0.18.1/configuration","type":"page","content":"Configuration","breadcrumbs":["Docs","Js","Wp release","v0.18.1"],"tags":[],"url":"/js/wp-release/v0.18.1/configuration"},"639":{"id":"/js/wp-release/v0.18.1/configuration-0","page_id":"/js/wp-release/v0.18.1/configuration","type":"heading","tags":[],"url":"/js/wp-release/v0.18.1/configuration#naming-convention","content":"Naming convention"},"640":{"id":"/js/wp-release/v0.18.1/configuration-1","page_id":"/js/wp-release/v0.18.1/configuration","type":"heading","tags":[],"url":"/js/wp-release/v0.18.1/configuration#file-selection","content":"File selection"},"641":{"id":"/js/wp-release/v0.18.1/configuration-2","page_id":"/js/wp-release/v0.18.1/configuration","type":"heading","tags":[],"url":"/js/wp-release/v0.18.1/configuration#plugin-and-theme-headers","content":"Plugin and theme headers"},"642":{"id":"/js/wp-release/v0.18.1/configuration-3","page_id":"/js/wp-release/v0.18.1/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/configuration#naming-convention","content":"`@wpelevator/wp-release` is the suite of release tools and `wp-release` is its CLI. \"Release\" is the whole workflow; each command is one operation in it. Commands are flat: a single word or dashed words like `version-check` and `deploy-svn`, without command groups or aliases. Each GitHub Action is named `wp-release-` followed by the command name, so the CLI command and the `uses:` name always match:"},"643":{"id":"/js/wp-release/v0.18.1/configuration-4","page_id":"/js/wp-release/v0.18.1/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/configuration#naming-convention","content":"| Capability        | CLI command        | GitHub Action |\n| ----------------- | ------------------ | ------------- |\n| Build a directory | `wp-release build` |               |","table":"table-0"},"644":{"id":"/js/wp-release/v0.18.1/configuration-5","page_id":"/js/wp-release/v0.18.1/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/configuration#naming-convention","content":"| Capability  | CLI command      | GitHub Action               |\n| ----------- | ---------------- | --------------------------- |\n| Build a ZIP | `wp-release zip` | `wpelevator/wp-release-zip` |","table":"table-0"},"645":{"id":"/js/wp-release/v0.18.1/configuration-6","page_id":"/js/wp-release/v0.18.1/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/configuration#naming-convention","content":"| Capability                  | CLI command            | GitHub Action                     |\n| --------------------------- | ---------------------- | --------------------------------- |\n| Create a checksums manifest | `wp-release checksums` | `wpelevator/wp-release-checksums` |","table":"table-0"},"646":{"id":"/js/wp-release/v0.18.1/configuration-7","page_id":"/js/wp-release/v0.18.1/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/configuration#naming-convention","content":"| Capability | CLI command       | GitHub Action                |\n| ---------- | ----------------- | ---------------------------- |\n| Sign files | `wp-release sign` | `wpelevator/wp-release-sign` |","table":"table-0"},"647":{"id":"/js/wp-release/v0.18.1/configuration-8","page_id":"/js/wp-release/v0.18.1/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/configuration#naming-convention","content":"| Capability                      | CLI command         | GitHub Action |\n| ------------------------------- | ------------------- | ------------- |\n| Verify files against a manifest | `wp-release verify` |               |","table":"table-0"},"648":{"id":"/js/wp-release/v0.18.1/configuration-9","page_id":"/js/wp-release/v0.18.1/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/configuration#naming-convention","content":"| Capability                    | CLI command                | GitHub Action |\n| ----------------------------- | -------------------------- | ------------- |\n| Check that the versions agree | `wp-release version-check` |               |","table":"table-0"},"649":{"id":"/js/wp-release/v0.18.1/configuration-10","page_id":"/js/wp-release/v0.18.1/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/configuration#naming-convention","content":"| Capability                  | CLI command             | GitHub Action                      |\n| --------------------------- | ----------------------- | ---------------------------------- |\n| Deploy to WordPress.org SVN | `wp-release deploy-svn` | `wpelevator/wp-release-deploy-svn` |","table":"table-0"},"650":{"id":"/js/wp-release/v0.18.1/configuration-11","page_id":"/js/wp-release/v0.18.1/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/configuration#naming-convention","content":"| Capability                 | CLI command             | GitHub Action |\n| -------------------------- | ----------------------- | ------------- |\n| Deploy to a Git repository | `wp-release deploy-git` |               |","table":"table-0"},"651":{"id":"/js/wp-release/v0.18.1/configuration-12","page_id":"/js/wp-release/v0.18.1/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/configuration#naming-convention","content":"The names below are scoped to their commands. `--output` selects the primary artifact of each command; ZIP packaging uses `--checksums-file` for its accompanying manifest:"},"652":{"id":"/js/wp-release/v0.18.1/configuration-13","page_id":"/js/wp-release/v0.18.1/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/configuration#naming-convention","content":"| Concept                   | CLI                                       | GitHub Action | Library     | Meaning                                                                           |\n| ------------------------- | ----------------------------------------- | ------------- | ----------- | --------------------------------------------------------------------------------- |\n| Plugin or theme directory | `<source-dir>` argument or `--source-dir` | `source-dir`  | `sourceDir` | Directory that a command reads, whether it's the repository or a build directory. |","table":"table-1"},"653":{"id":"/js/wp-release/v0.18.1/configuration-14","page_id":"/js/wp-release/v0.18.1/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/configuration#naming-convention","content":"| Concept         | CLI                    | GitHub Action | Library     | Meaning                                                    |\n| --------------- | ---------------------- | ------------- | ----------- | ---------------------------------------------------------- |\n| Build directory | `build --output <dir>` | —             | `outputDir` | Directory written by `build`; files go directly inside it. |","table":"table-1"},"654":{"id":"/js/wp-release/v0.18.1/configuration-15","page_id":"/js/wp-release/v0.18.1/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/configuration#naming-convention","content":"| Concept  | CLI                   | GitHub Action          | Library   | Meaning                                                           |\n| -------- | --------------------- | ---------------------- | --------- | ----------------------------------------------------------------- |\n| ZIP file | `zip --output <file>` | `output` in ZIP action | `zipPath` | Destination passed to `zipPackage()`; also returned as `zipPath`. |","table":"table-1"},"655":{"id":"/js/wp-release/v0.18.1/configuration-16","page_id":"/js/wp-release/v0.18.1/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/configuration#naming-convention","content":"| Concept                   | CLI                         | GitHub Action                | Library                              | Meaning                                                                                                       |\n| ------------------------- | --------------------------- | ---------------------------- | ------------------------------------ | ------------------------------------------------------------------------------------------------------------- |\n| Standalone checksums file | `checksums --output <file>` | `output` in checksums action | first argument of `writeChecksums()` | Manifest destination relative to the working directory; the CLI returns its absolute path as `checksumsPath`. |","table":"table-1"},"656":{"id":"/js/wp-release/v0.18.1/configuration-17","page_id":"/js/wp-release/v0.18.1/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/configuration#naming-convention","content":"| Concept                         | CLI                           | GitHub Action                  | Library         | Meaning                                                                             |\n| ------------------------------- | ----------------------------- | ------------------------------ | --------------- | ----------------------------------------------------------------------------------- |\n| Checksums filename when zipping | `zip --checksums-file <file>` | `checksums-file` in ZIP action | `checksumsFile` | Relative manifest filename beside the ZIP or inside its package root when embedded. |","table":"table-1"},"657":{"id":"/js/wp-release/v0.18.1/configuration-18","page_id":"/js/wp-release/v0.18.1/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/configuration#naming-convention","content":"| Concept       | CLI                 | GitHub Action | Library   | Meaning                                 |\n| ------------- | ------------------- | ------------- | --------- | --------------------------------------- |\n| ZIP to deploy | `--from-zip <file>` | `from-zip`    | `fromZip` | Existing ZIP read as the deploy source. |","table":"table-1"},"658":{"id":"/js/wp-release/v0.18.1/configuration-19","page_id":"/js/wp-release/v0.18.1/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/configuration#naming-convention","content":"| Concept            | CLI               | GitHub Action | Library  | Meaning                             |\n| ------------------ | ----------------- | ------------- | -------- | ----------------------------------- |\n| Git tag to compare | `--git-tag <tag>` |               | `gitTag` | Git tag checked by `version-check`. |","table":"table-1"},"659":{"id":"/js/wp-release/v0.18.1/configuration-20","page_id":"/js/wp-release/v0.18.1/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/configuration#naming-convention","content":"| Concept           | CLI                   | GitHub Action | Library  | Meaning                                               |\n| ----------------- | --------------------- | ------------- | -------- | ----------------------------------------------------- |\n| SVN tag to create | `--svn-tag <version>` | `svn-tag`     | `svnTag` | Tag written by `deploy-svn`, distinct from a git tag. |","table":"table-1"},"660":{"id":"/js/wp-release/v0.18.1/configuration-21","page_id":"/js/wp-release/v0.18.1/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/configuration#naming-convention","content":"| Concept        | CLI               | GitHub Action | Library  | Meaning             |\n| -------------- | ----------------- | ------------- | -------- | ------------------- |\n| SVN repository | `--svn-url <url>` | `svn-url`     | `svnUrl` | Deploy destination. |","table":"table-1"},"661":{"id":"/js/wp-release/v0.18.1/configuration-22","page_id":"/js/wp-release/v0.18.1/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/configuration#naming-convention","content":"| Concept        | CLI               | GitHub Action | Library  | Meaning                                                                                                               |\n| -------------- | ----------------- | ------------- | -------- | --------------------------------------------------------------------------------------------------------------------- |\n| Git repository | `--git-url <url>` |               | `gitUrl` | Destination of `deploy-git`. Credentials come from git, like a token in the URL or an SSH key, and are never printed. |","table":"table-1"},"662":{"id":"/js/wp-release/v0.18.1/configuration-23","page_id":"/js/wp-release/v0.18.1/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/configuration#naming-convention","content":"| Concept                      | CLI                               | GitHub Action | Library         | Meaning                                                                                                      |\n| ---------------------------- | --------------------------------- | ------------- | --------------- | ------------------------------------------------------------------------------------------------------------ |\n| Branch and tag to release to | `--branch <name>`, `--tag <name>` |               | `branch`, `tag` | Refs written by `deploy-git` in the Git repository, distinct from the git tag that `version-check` compares. |","table":"table-1"},"663":{"id":"/js/wp-release/v0.18.1/configuration-24","page_id":"/js/wp-release/v0.18.1/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/configuration#naming-convention","content":"| Concept        | CLI                    | GitHub Action | Library       | Meaning                                                                                                                       |\n| -------------- | ---------------------- | ------------- | ------------- | ----------------------------------------------------------------------------------------------------------------------------- |\n| Source history | `--split-prefix <dir>` |               | `splitPrefix` | Directory of a monorepo package whose history, from `git subtree split`, becomes the source history of `deploy-git` releases. |","table":"table-1"},"664":{"id":"/js/wp-release/v0.18.1/configuration-25","page_id":"/js/wp-release/v0.18.1/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/configuration#naming-convention","content":"| Concept         | CLI                                                                 | GitHub Action                  | Library                      | Meaning                                                                                                                                                    |\n| --------------- | ------------------------------------------------------------------- | ------------------------------ | ---------------------------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| SVN credentials | `--svn-username <name>`, `SVN_USERNAME` and `SVN_PASSWORD` env vars | `svn-username`, `svn-password` | `svnUsername`, `svnPassword` | Needed only to commit. There's no password flag, since it would show in the process list; the action inputs and library options fall back to the env vars. |","table":"table-1"},"665":{"id":"/js/wp-release/v0.18.1/configuration-26","page_id":"/js/wp-release/v0.18.1/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/configuration#naming-convention","content":"| Concept    | CLI                                                | GitHub Action   | Library                                                   | Meaning                                                                                                                               |\n| ---------- | -------------------------------------------------- | --------------- | --------------------------------------------------------- | ------------------------------------------------------------------------------------------------------------------------------------- |\n| Log format | `--log-format <text\\|github>`, `--ci` for `github` | always `github` | `writer: new TextWriter()` or `new GitHubActionsWriter()` | How the log is printed: plain text, or GitHub Actions annotations and job summaries. Each name matches the start of its writer class. |","table":"table-1"},"666":{"id":"/js/wp-release/v0.18.1/configuration-27","page_id":"/js/wp-release/v0.18.1/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/configuration#naming-convention","content":"| Concept        | CLI               | GitHub Action                              | Library      | Meaning                                                                                  |\n| -------------- | ----------------- | ------------------------------------------ | ------------ | ---------------------------------------------------------------------------------------- |\n| Release config | `--config <path>` | `config` in ZIP, checksums and SVN actions | `configFile` | Explicit JavaScript config path for package selection, integrity settings or deployment. |","table":"table-1"},"667":{"id":"/js/wp-release/v0.18.1/configuration-28","page_id":"/js/wp-release/v0.18.1/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/configuration#naming-convention","content":"| Concept            | CLI                     | GitHub Action              | Library     | Meaning                                                 |\n| ------------------ | ----------------------- | -------------------------- | ----------- | ------------------------------------------------------- |\n| Release tag format | `--tag-format <format>` | `tag-format` in SVN action | `tagFormat` | How `release-ref` identifies a package and its version. |","table":"table-1"},"668":{"id":"/js/wp-release/v0.18.1/configuration-29","page_id":"/js/wp-release/v0.18.1/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/configuration#naming-convention","content":"| Concept               | CLI                   | GitHub Action               | Library | Meaning                                                             |\n| --------------------- | --------------------- | --------------------------- | ------- | ------------------------------------------------------------------- |\n| Release ref to deploy | `--release-ref <ref>` | `release-ref` in SVN action | `ref`   | Read configured packages and deployment targets from a release ref. |","table":"table-1"},"669":{"id":"/js/wp-release/v0.18.1/configuration-30","page_id":"/js/wp-release/v0.18.1/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/configuration#naming-convention","content":"| Concept     | CLI                   | GitHub Action           | Library  | Meaning                                                                                                                               |\n| ----------- | --------------------- | ----------------------- | -------- | ------------------------------------------------------------------------------------------------------------------------------------- |\n| Assets sync | `--no-assets` to skip | `assets: false` to skip | `assets` | Booleans are positive in the library and the action; `--no-assets` is only the CLI negation, never `noAssets` or a `no-assets` input. |","table":"table-1"},"670":{"id":"/js/wp-release/v0.18.1/configuration-31","page_id":"/js/wp-release/v0.18.1/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/configuration#naming-convention","content":"CLI JSON results use camelCase keys like `zipPath`, and GitHub Action outputs use kebab-case like `zip-path`. The ZIP action supports `package` and `config`, the checksums action supports `config` for codec selection, and the SVN action supports `release-ref`, repeated `package` values as newline-separated input, `list`, `config` and `tag-format`."},"671":{"id":"/js/wp-release/v0.18.1/configuration-32","page_id":"/js/wp-release/v0.18.1/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/configuration#naming-convention","content":"The ZIP CLI result uses `checksumsEmbedded` for the package-relative embedded manifest path. Its `signatures` array includes external absolute paths and embedded package-relative paths, while `checksumsSignatures` contains only manifest signatures. The ZIP action exposes those locations as `checksums-embedded`, `signatures` for external signatures, and `signatures-embedded` for embedded signatures, so asset uploads receive local files. With CLI `--github-output`, signature arrays remain in the JSON `result` output."},"672":{"id":"/js/wp-release/v0.18.1/configuration-33","page_id":"/js/wp-release/v0.18.1/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/configuration#naming-convention","content":"Library classes are named after the capability (`SvnDeploy`, `Svn`, `GitDeploy`) without repeating \"release\"."},"673":{"id":"/js/wp-release/v0.18.1/configuration-34","page_id":"/js/wp-release/v0.18.1/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/configuration#file-selection","content":"`build`, `zip`, `checksums`, `deploy-svn` and `deploy-git` select files the same way:"},"674":{"id":"/js/wp-release/v0.18.1/configuration-35","page_id":"/js/wp-release/v0.18.1/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/configuration#file-selection","content":"| Option                | Description                                                                                                                    |\n| --------------------- | ------------------------------------------------------------------------------------------------------------------------------ |\n| `--distignore <file>` | Path to the ignore file. Defaults to `.distignore` in the source directory when present; an explicitly passed file must exist. |","table":"table-2"},"675":{"id":"/js/wp-release/v0.18.1/configuration-36","page_id":"/js/wp-release/v0.18.1/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/configuration#file-selection","content":"| Option            | Description                 |\n| ----------------- | --------------------------- |\n| `--no-distignore` | Don't read any ignore file. |","table":"table-2"},"676":{"id":"/js/wp-release/v0.18.1/configuration-37","page_id":"/js/wp-release/v0.18.1/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/configuration#file-selection","content":"| Option                 | Description                                                                                                                                                                                    |\n| ---------------------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `--exclude <patterns>` | Extra gitignore-style patterns, comma-separated or repeated, like `--exclude build/,assets/*,images/**/*`. They're applied after the ignore file, so a `!` pattern can also re-include a file. |","table":"table-2"},"677":{"id":"/js/wp-release/v0.18.1/configuration-38","page_id":"/js/wp-release/v0.18.1/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/configuration#file-selection","content":"| Option                    | Description                                                                                                                                  |\n| ------------------------- | -------------------------------------------------------------------------------------------------------------------------------------------- |\n| `--exclude-gitattributes` | Also exclude paths marked `export-ignore` by Git attributes. This is opt-in and requires the source directory to be inside a Git repository. |","table":"table-2"},"678":{"id":"/js/wp-release/v0.18.1/configuration-39","page_id":"/js/wp-release/v0.18.1/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/configuration#file-selection","content":"`.distignore` and `--exclude` use full gitignore syntax, including `!` negation. `--exclude-gitattributes` asks Git to evaluate `export-ignore` attributes, including nested `.gitattributes` files, then adds those paths to the exclusions. It is off by default, so releases don't unexpectedly depend on Git or change selection when a repository adds attributes. Git must be installed and the source directory must be inside a working tree; the flag is ignored by `deploy-svn --from-zip`, since the ZIP is already filtered. Version control metadata (`.git`, `.svn` and `.hg`, at any depth, including the `.git` files of worktrees and submodules) is always left out, also without an ignore file and when deploying from a ZIP, and no `!` pattern can re-include it. This keeps a repository's history out of ZIPs and deploys when the source directory is the repository root. The comma-separated `--exclude` list works like `--exclude` in `wp i18n make-pot`. Selected symbolic links are an error, since ZIP archives and WordPress.org SVN don't support them."},"679":{"id":"/js/wp-release/v0.18.1/configuration-40","page_id":"/js/wp-release/v0.18.1/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/configuration#plugin-and-theme-headers","content":"The commands read the same headers as WordPress. The main plugin file is the top-level `.php` file with a `Plugin Name:` header in its first 8 KB, preferring `{slug}.php` when several files have one. A directory without a plugin file and with `Theme Name:` in `style.css` is a theme. The readme headers (`Stable tag`, `Tested up to`, …) come from `readme.txt`, or `readme.md` when there's no `readme.txt`."},"680":{"id":"/js/wp-release/v0.18.1/configuration-41","page_id":"/js/wp-release/v0.18.1/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/configuration#plugin-and-theme-headers","content":"`--version` defaults to the `Version` header in `zip`, `checksums` and `version-check`, and `checksums --type` defaults to the detected package type."},"681":{"id":"/js/wp-release/v0.18.1/deployment","page_id":"/js/wp-release/v0.18.1/deployment","type":"page","content":"Deployment","breadcrumbs":["Docs","Js","Wp release","v0.18.1"],"tags":[],"url":"/js/wp-release/v0.18.1/deployment"},"682":{"id":"/js/wp-release/v0.18.1/deployment-0","page_id":"/js/wp-release/v0.18.1/deployment","type":"heading","tags":[],"url":"/js/wp-release/v0.18.1/deployment#deploy-to-svn","content":"Deploy to SVN"},"683":{"id":"/js/wp-release/v0.18.1/deployment-1","page_id":"/js/wp-release/v0.18.1/deployment","type":"heading","tags":[],"url":"/js/wp-release/v0.18.1/deployment#deploy-to-git","content":"Deploy to Git"},"684":{"id":"/js/wp-release/v0.18.1/deployment-2","page_id":"/js/wp-release/v0.18.1/deployment","type":"heading","tags":[],"url":"/js/wp-release/v0.18.1/deployment#deploy-configured-packages","content":"Deploy configured packages"},"685":{"id":"/js/wp-release/v0.18.1/deployment-3","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-to-svn","content":"The `wp-release-deploy-svn` GitHub Action runs this command."},"686":{"id":"/js/wp-release/v0.18.1/deployment-4","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-to-svn","content":"`deploy-svn` syncs a plugin to the WordPress.org plugin SVN repository. Each SVN write is a separate flag and nothing is written unless requested. All writes go into one commit."},"687":{"id":"/js/wp-release/v0.18.1/deployment-5","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-to-svn","content":"| Flag      | Default | Writes                                     |\n| --------- | ------- | ------------------------------------------ |\n| `--trunk` | off     | Sync the full source directory to `trunk/` |","table":"table-0"},"688":{"id":"/js/wp-release/v0.18.1/deployment-6","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-to-svn","content":"| Flag            | Default | Writes                                                                                                                             |\n| --------------- | ------- | ---------------------------------------------------------------------------------------------------------------------------------- |\n| `--readme-only` | off     | Sync only the readme to `trunk/`, for updates between releases such as bumping `Tested up to`. Can't be combined with `--svn-tag`. |","table":"table-0"},"689":{"id":"/js/wp-release/v0.18.1/deployment-7","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-to-svn","content":"| Flag                  | Default | Writes                                                                                                                                                                                                                                                        |\n| --------------------- | ------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `--svn-tag <version>` | off     | Create `tags/<version>`. With `--trunk`, the tag is a copy of the synced `trunk/`. Without it, the tag is built directly from the source files and `trunk/` is left alone, for pre-release tags. A leading `v` is stripped, so `v1.2.0` creates `tags/1.2.0`. |","table":"table-0"},"690":{"id":"/js/wp-release/v0.18.1/deployment-8","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-to-svn","content":"| Flag                 | Default | Writes                                                                                                                                                                                 |\n| -------------------- | ------- | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `--assets-dir <dir>` | not set | Sync this directory with banners, icons and screenshots to the SVN `assets/` directory. There's no default directory, so assets are only deployed when this is set, and it must exist. |","table":"table-0"},"691":{"id":"/js/wp-release/v0.18.1/deployment-9","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-to-svn","content":"| Flag          | Default | Writes                                                                                            |\n| ------------- | ------- | ------------------------------------------------------------------------------------------------- |\n| `--no-assets` |         | Skip the `--assets-dir` sync for one run, for example when a config always passes `--assets-dir`. |","table":"table-0"},"692":{"id":"/js/wp-release/v0.18.1/deployment-10","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-to-svn","content":"Typical runs:"},"693":{"id":"/js/wp-release/v0.18.1/deployment-11","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-to-svn","content":"How a deploy works:"},"694":{"id":"/js/wp-release/v0.18.1/deployment-12","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-to-svn","content":"The options are validated, including the slug, version and readme name, before they're used in URLs or paths."},"695":{"id":"/js/wp-release/v0.18.1/deployment-13","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-to-svn","content":"With `--trunk` or `--svn-tag`, the files must be a plugin whose `Version` header matches the version. When `--trunk` and `--svn-tag` are combined, the readme `Stable tag` must match too; a tag-only run skips that, since a pre-release tag doesn't change the stable tag. `--readme-only` needs the readme. Nothing is checked out when a check fails."},"696":{"id":"/js/wp-release/v0.18.1/deployment-14","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-to-svn","content":"The repository is checked out sparsely into a new temporary directory, with only the directories that the flags write to. A missing `assets/` (or `trunk/`, `tags/`) directory is created. The deploy stops when `tags/<version>` exists, unless `--force` replaces it."},"697":{"id":"/js/wp-release/v0.18.1/deployment-15","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-to-svn","content":"The files are synced in Node.js, without `rsync`: new and changed files are copied, files that are no longer selected are deleted, and `svn add` and `svn delete` stage them, including files that svn ignores by default. With `--trunk`, `trunk/` is then copied to the tag with `svn copy`. Without it, the same selected files are synced into `tags/<version>` instead, and with `--force` an existing tag is updated to match, deleting files that are no longer in the build."},"698":{"id":"/js/wp-release/v0.18.1/deployment-16","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-to-svn","content":"Asset images get `svn:mime-type` set for PNG, JPEG, GIF and SVG, the formats that WordPress.org documents for plugin assets. Other formats keep the type that svn assigns."},"699":{"id":"/js/wp-release/v0.18.1/deployment-17","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-to-svn","content":"When `svn status` is empty, the deploy ends without a commit. A dry run logs the status and stops before the commit. Otherwise the changes are committed, and the temporary directory is always removed."},"700":{"id":"/js/wp-release/v0.18.1/deployment-18","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-to-svn","content":"`--from-zip` reads the files from a ZIP instead of `<source-dir>`. The ZIP is checked before it's extracted: entries with absolute paths, `..` segments or symbolic links, and entries outside a single `{slug}/` root folder, are rejected."},"701":{"id":"/js/wp-release/v0.18.1/deployment-19","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-to-svn","content":"Credentials are only needed for the commit, not for dry runs, no-op runs or `file://` repositories. Pass the username with `--svn-username` or `SVN_USERNAME` and the password in `SVN_PASSWORD`. svn always runs non-interactively without caching credentials, and the password is passed on the standard input with `--password-from-stdin`, never on the command line or in the logs."},"702":{"id":"/js/wp-release/v0.18.1/deployment-20","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-to-svn","content":"Validation:"},"703":{"id":"/js/wp-release/v0.18.1/deployment-21","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-to-svn","content":"`--readme-only` can't be combined with `--svn-tag`, since a tag is a release snapshot that a readme update never changes."},"704":{"id":"/js/wp-release/v0.18.1/deployment-22","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-to-svn","content":"`--version` defaults to `--svn-tag`, then the `Version` header of the deployed files; when `--version` and `--svn-tag` are both set they must match."},"705":{"id":"/js/wp-release/v0.18.1/deployment-23","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-to-svn","content":"Pre-release versions like `1.0.0-rc.1` can be tagged, but syncing one to `trunk/` warns, since trunk is for the development version."},"706":{"id":"/js/wp-release/v0.18.1/deployment-24","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-to-svn","content":"`--trunk` without `--svn-tag` works but warns, to remind you that updating trunk alone doesn't create a version tag for stable downloads."},"707":{"id":"/js/wp-release/v0.18.1/deployment-25","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-to-svn","content":"A version mismatch throws a `VersionMismatchError`, a `ValidationError` with the `mismatches` and a problem for each, with its file and line. See Logging."},"708":{"id":"/js/wp-release/v0.18.1/deployment-26","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-to-git","content":"`deploy-git` deploys the selected files of a plugin, theme or package to a Git repository, like a distribution repository that ships the built files and `vendor/` for Composer installs or GitHub-hosted updates, or the release repository of a monorepo package. It selects files like `zip`, with `.distignore` and `--exclude`, so built files that git ignores in the source repository, like `build/` or `vendor/`, are released too. The source directory must be inside a Git repository, which provides the source history and stores the release objects before they're pushed."},"709":{"id":"/js/wp-release/v0.18.1/deployment-27","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-to-git","content":"| Flag              | Default | Writes                          |\n| ----------------- | ------- | ------------------------------- |\n| `--branch <name>` | off     | Push the release to this branch |","table":"table-1"},"710":{"id":"/js/wp-release/v0.18.1/deployment-28","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-to-git","content":"| Flag           | Default | Writes                          |\n| -------------- | ------- | ------------------------------- |\n| `--tag <name>` | off     | Create this tag for the release |","table":"table-1"},"711":{"id":"/js/wp-release/v0.18.1/deployment-29","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-to-git","content":"How a deploy works:"},"712":{"id":"/js/wp-release/v0.18.1/deployment-30","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-to-git","content":"The selected files are written to the object database of the source repository and become a tree, with a temporary index, so the working tree and the index of the repository are left alone. Executable files stay executable."},"713":{"id":"/js/wp-release/v0.18.1/deployment-31","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-to-git","content":"The previous release is fetched: the tip of `--branch`, or for a tag-only deploy the tip of the repository's default branch (its `HEAD`), whatever that branch holds. Release a tag together with `--branch` to choose the branch it builds on."},"714":{"id":"/js/wp-release/v0.18.1/deployment-32","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-to-git","content":"When the files are the same as in the previous release, that release is reused. Otherwise a release commit is created with the files, whose parents are the previous release and the source history: the source commit (`--source-ref`, default `HEAD`), or with `--split-prefix` the history of that directory from `git subtree split`. The repository keeps the source history, and `git log --first-parent` lists the releases."},"715":{"id":"/js/wp-release/v0.18.1/deployment-33","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-to-git","content":"When the previous release on `--branch` already has newer source history, the branch isn't moved, so running an older build again, like a re-run of an earlier CI job, can't release older files. The source history is outdated when it's an older commit of the source history that the previous release was made from, its last parent. `git subtree split` makes this reliable for `--split-prefix` too, since it creates the same commits for the same history. A revert is a new commit, so it's released, and with `--tag` the tag of an older build is still released, without moving the branch."},"716":{"id":"/js/wp-release/v0.18.1/deployment-34","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-to-git","content":"The tag is checked in the repository first. A tag that already has the same files is the release: it's reused and nothing is pushed, so running a tag release again is a no-op. A tag with other files fails with exit code `2` before anything is pushed."},"717":{"id":"/js/wp-release/v0.18.1/deployment-35","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-to-git","content":"The release is pushed to the branch, unless it didn't change or is outdated, and to the tag, in one atomic push. Pushes are never forced, so the branch only moves forward and a tag is never replaced, also when it was created in the meantime."},"718":{"id":"/js/wp-release/v0.18.1/deployment-36","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-to-git","content":"To release a tag again, for example after a release with the wrong files, delete the tag in the repository (`git push <url> :refs/tags/<tag>`) and run the deploy again. There's no flag for replacing a tag, since installs, Composer and GitHub Actions pins trust that a published tag doesn't change."},"719":{"id":"/js/wp-release/v0.18.1/deployment-37","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-to-git","content":"`--dry-run` runs everything except the push. `--message` sets the commit message, which defaults to `Release <tag or branch> from <source commit>`. Credentials come from git, like a credential helper or an SSH key, and credentials in URLs are never printed. For an HTTPS repository on `github.com`, or on the host of `GITHUB_SERVER_URL` like GitHub Enterprise Server, the `GITHUB_TOKEN` environment variable is sent as an authorization header, like `actions/checkout` does, so the token stays out of the URL, the git arguments and the repository config, and it replaces the header that `actions/checkout` persists. Pass `token` to `resolveGitDeployOptions()` for another HTTPS host. The commit needs a git identity (`user.name` and `user.email`)."},"720":{"id":"/js/wp-release/v0.18.1/deployment-38","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-configured-packages","content":"`deploy-git --release-ref <ref>` and `deploy-svn --release-ref <ref>` deploy the packages of a monorepo, or of a single-package repository, to the targets in the `deploy` config of their package groups, like the release repository of each package or its WordPress.org plugin. The ref decides what's deployed: a release tag of a package, like `refs/tags/plugins/alpha/1.2.0` read with the `tagFormat`, deploys that package and version, and a branch, like `refs/heads/main`, deploys every package with a target for that branch. A name without `refs/` is a release tag when it matches the tag format of a package, otherwise a branch, and in GitHub Actions `$GITHUB_REF` is the pushed ref."},"721":{"id":"/js/wp-release/v0.18.1/deployment-39","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-configured-packages","content":"| Mode | Command                          | Use                                                                                                                                                                                           |\n| ---- | -------------------------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| All  | `deploy-git --release-ref <ref>` | Deploy every package of the ref to each of its targets, one at a time, in one log group for each package. A failed deploy doesn't stop the others, and the command exits with `1` at the end. |","table":"table-2"},"722":{"id":"/js/wp-release/v0.18.1/deployment-40","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-configured-packages","content":"| Mode        | Command                                           | Use                                                                                                                                                       |\n| ----------- | ------------------------------------------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| One package | `deploy-git --release-ref <ref> --package <name>` | Deploy only that package (repeatable), by identifier or path, for example to retry a failed one or in a CI job for each package with its own credentials. |","table":"table-2"},"723":{"id":"/js/wp-release/v0.18.1/deployment-41","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-configured-packages","content":"| Mode | Command                                 | Use                                                                                                                                                                                                                                                                                             |\n| ---- | --------------------------------------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| Plan | `deploy-git --release-ref <ref> --list` | List the deploys without running them, with each package, its version or branch and the targets with the tag or branch they get. With `--json` or `--github-output` the result is `{ packages: [ … ] }`, for a CI matrix with `include: ${{ fromJSON( steps.plan.outputs.result ).packages }}`. |","table":"table-2"},"724":{"id":"/js/wp-release/v0.18.1/deployment-42","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-configured-packages","content":"| Mode             | Command                                      | Use                                                        |\n| ---------------- | -------------------------------------------- | ---------------------------------------------------------- |\n| Single directory | `deploy-git <dir> --git-url <url> [options]` | Deploy one directory without a config, as described above. |","table":"table-2"},"725":{"id":"/js/wp-release/v0.18.1/deployment-43","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-configured-packages","content":"`deploy-svn` has the same modes. `--release-ref` can't be combined with the options of a single target, like `--git-url`, `--tag` or `--svn-tag`, which come from the config."},"726":{"id":"/js/wp-release/v0.18.1/deployment-44","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-configured-packages","content":"**Git targets** take a `repository` and release both branches and tags by default. `branches` limits the branches, like `[ 'main' ]`, or turns them off with `false`, and `tag` is the tag template in the repository, `{version}` by default, or `false` to not release tags. A release tag is created on top of the default branch of the repository, and a branch is released to the same branch. `history: false` uses the source commit instead of the package history from `git subtree split`, and `message` sets the release commit message, `Release {ref} from {revision}` by default."},"727":{"id":"/js/wp-release/v0.18.1/deployment-45","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-configured-packages","content":"**SVN targets** only deploy release tags: a stable release syncs `trunk/`, creates its tag and syncs the `assetsDir`, and a pre-release only creates its tag. `slug`, the WordPress.org plugin slug, defaults to the name of the package directory, `url` to the WordPress.org plugin repository, and `message` sets the commit message. Credentials come from `SVN_USERNAME` and `SVN_PASSWORD`, or `--svn-username`."},"728":{"id":"/js/wp-release/v0.18.1/deployment-46","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-configured-packages","content":"**Several targets**: `git` and `svn` each take one target or a list, like a release repository and a mirror on another host. Each target is a separate deploy."},"729":{"id":"/js/wp-release/v0.18.1/deployment-47","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-configured-packages","content":"**Credentials**: a GitHub repository URL needs no token in it, since `GITHUB_TOKEN` is sent as an authorization header (see above). A callback can still add credentials for other hosts."},"730":{"id":"/js/wp-release/v0.18.1/deployment-48","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-configured-packages","content":"**Templates and callbacks**: `repository`, `slug` and `message` are templates with `{name}` and `{path}`, like the `tagFormat`, and `{version}`, `{branch}`, `{ref}` (the tag or branch that the deploy writes in the target) and `{revision}` (the source commit), or callbacks that receive `{ package, version, branch, ref, revision }`, where `package` has the `name`, `directory`, `path` and `type`. A callback can name a target after the package directory, choose another host for some packages, read the environment, or return nothing to skip the target for that package or ref; an empty `message` uses the default one. Credentials in URLs are never printed or listed."},"731":{"id":"/js/wp-release/v0.18.1/deployment-49","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-configured-packages","content":"**Results**: with `--json` or `--github-output`, the result lists each deploy in `deploys` with its `package`, `label`, `target` (the repository or WordPress.org plugin, with credentials redacted), `targetRef` (the tag or branch written there), `version` or `branch`, and its `result` or `error`. A remote target repository also has its `targetHost`, like `github.com`, and `targetPath`, like `me/my-plugin`, without credentials, for a workflow step that calls the API of the forge that hosts it, such as to create the release of the deployed tag. The targets of `--list` have the same `host` and `path`, and `parseRepositoryUrl()` reads them from an HTTP(S), SSH or scp-like URL. `wp-release` doesn't call forge APIs itself."},"732":{"id":"/js/wp-release/v0.18.1/deployment-50","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-configured-packages","content":"**Packages without a version**: a package entry without `version`, like a single directory with a `glob` of its path, isn't released with changesets, so changes to it don't need one, and it only deploys branches, since it has no release tags."},"733":{"id":"/js/wp-release/v0.18.1/deployment-51","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-configured-packages","content":"**Files**: `files.exclude` adds gitignore-style patterns relative to the package directory, and `files.distignore` sets the ignore file relative to it or turns it off with `false`. A `files` at the root of the config applies to every package group, for the rules that all packages share, and the `files` of a group add their patterns after it and can replace its ignore file. Without `files`, each package's `.distignore` applies, like for `zip`; there's no repository-wide `.distignore`, since each one is relative to its package. `zip --package <name>` zips a package with the same files, `getPackageFiles()` returns the directory and the file selection of any configured package, and `getDeployPackages()` lists the packages with deploy targets and their file selection."},"734":{"id":"/js/wp-release/v0.18.1/deployment-52","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-configured-packages","content":"A deploy releases the files of the working tree, so build the packages first. One job that builds once and runs `deploy-git --release-ref \"$GITHUB_REF\"` is the simplest setup, also for a branch that releases every package. A matrix with a job for each package from `--list` would build every package in every job, so build once and pass the built tree to the jobs as an artifact if you need one, for example for separate credentials."},"735":{"id":"/js/wp-release/v0.18.1/deployment-53","page_id":"/js/wp-release/v0.18.1/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/deployment#deploy-configured-packages","content":"Other monorepo tools split the same way with less of the release in the config: splitsh-lite, Symplify MonorepoBuilder and `danharrin/monorepo-split-github-action` push the source history of each package directory, with the packages and repositories listed in the workflow or a matrix, while `deploy-git` releases the built files on top of that history, so `vendor/` and `build/` reach Composer and WordPress installs. Like the publishers of GoReleaser, targets are lists with templates, and pre-releases skip the targets where they would replace the stable version."},"736":{"id":"/js/wp-release/v0.18.1/development","page_id":"/js/wp-release/v0.18.1/development","type":"page","content":"Development","breadcrumbs":["Docs","Js","Wp release","v0.18.1"],"tags":[],"url":"/js/wp-release/v0.18.1/development"},"737":{"id":"/js/wp-release/v0.18.1/development-0","page_id":"/js/wp-release/v0.18.1/development","type":"heading","tags":[],"url":"/js/wp-release/v0.18.1/development#development","content":"Development"},"738":{"id":"/js/wp-release/v0.18.1/development-1","page_id":"/js/wp-release/v0.18.1/development","type":"heading","tags":[],"url":"/js/wp-release/v0.18.1/development#architecture","content":"Architecture"},"739":{"id":"/js/wp-release/v0.18.1/development-2","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#development","content":"The source is TypeScript in `src/`, with tests next to the files they test (`*.test.ts`). The published package contains only the compiled `dist/` with JavaScript and `.d.ts` files; tests and translation fixtures stay in the repository."},"740":{"id":"/js/wp-release/v0.18.1/development-3","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#development","content":"`build` compiles `src/` to `dist/` with `tsc`, leaving out the tests."},"741":{"id":"/js/wp-release/v0.18.1/development-4","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#development","content":"`test` runs the `.ts` tests directly with `node --test`, using Node.js type stripping, so it needs Node.js 22.18 or later but no build. The SVN integration tests in `svn-deploy.integration.test.ts` create repositories with `svnadmin` and deploy to their `file://` URLs; they're skipped when `svn` or `svnadmin` isn't installed."},"742":{"id":"/js/wp-release/v0.18.1/development-5","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#development","content":"`lint` runs ESLint and a `tsc` type check."},"743":{"id":"/js/wp-release/v0.18.1/development-6","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#development","content":"The i18n tests validate gettext round trips, script catalogs and generated PHP data without launching PHP, WP-CLI or WordPress, covering contexts, plural forms, comments, flags, Unicode, escaping and PHP-looking input as data."},"744":{"id":"/js/wp-release/v0.18.1/development-7","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#development","content":"The `wpelevator-source` export condition points at `src/index.ts`. The wp-release tests and monorepo CLI scripts use it to work with the source instead of a `dist/` build. Action builds use the declared dependency's default export, which resolves to `dist/` for the workspace copy and the published package. Build wp-release before building the actions."},"745":{"id":"/js/wp-release/v0.18.1/development-8","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#development","content":"`execute( 'deploy-svn', args, { cwd, logger, svnRunner } )` runs a single-plugin deployment or a configured plan or deployment. The optional `svnRunner` replaces the external command runner in both modes; without it, the command uses its normal runner."},"746":{"id":"/js/wp-release/v0.18.1/development-9","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#architecture","content":"wp-release has two layers, so that it fits any repository layout:"},"747":{"id":"/js/wp-release/v0.18.1/development-10","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#architecture","content":"**Primitives** work on the directory, file or values they're given and know nothing about the repository: `build <dir>`, `zip <dir>`, `checksums`, `sign`, `verify`, `version-check`, `deploy-git <dir>`, `deploy-svn <dir>`, `i18n-pot <dir>`, `i18n-audit <dir>` and the `i18n-mo`, `i18n-json` and `i18n-php` compilers."},"748":{"id":"/js/wp-release/v0.18.1/development-11","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#architecture","content":"**The config layer** reads `wp-release.config.js` for everything about the repository: where packages are (`root` and the package globs), how their versions and tags are named (`version`, `tagFormat`), which files they ship (`files`), how their translations are extracted (`i18n`), where they deploy (`deploy`) and the git `remote`. The changeset commands (with a single-project fallback when no config exists), `deploy-git` and `deploy-svn --release-ref`, `build --package` and `zip --package`, and `i18n-pot` and `i18n-audit` with `--package` or `--all` belong to it, and the global `--config` and `--tag-format` options select or adjust the config. `zip` and `checksums` also read caller configuration for integrity settings even without `--package`; verification reads it only when explicitly selected. Only `--release-ref` reads which package and version a ref releases. A primitive with a config mode, like `deploy-git --release-ref` beside `deploy-git <dir>` or `zip --package` beside `zip <dir>`, only takes the package directory, its files and its targets from the config there, and otherwise works the same."},"749":{"id":"/js/wp-release/v0.18.1/development-12","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#architecture","content":"Configured repositories use the layout and naming conventions their config sets. Config-free changeset releases use the root-only detection and defaults described above."},"750":{"id":"/js/wp-release/v0.18.1/development-13","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#architecture","content":"The GitHub Actions are adapters to these commands: they use the same flag names and `execute()` entry point, with secrets supplied through environment variables. The SVN action injects a command runner that checks or installs SVN only when a deployment runs its first SVN command; config planning and deployment behavior remain in `wp-release`."},"751":{"id":"/js/wp-release/v0.18.1/development-14","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#architecture","content":"The package uses ES modules as its unit of encapsulation, like most Node.js CLI tools: a module exports a few functions and keeps its helpers private, so there's no class to wrap them in. A class is used only when it holds state across steps or binds dependencies, so that callers and tests can replace them:"},"752":{"id":"/js/wp-release/v0.18.1/development-15","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#architecture","content":"**Workflows with steps** are classes, so that their steps share state and dependencies on the instance: `SvnDeploy` shares the temporary working copy across `prepare()`, `checkout()`, `sync()` and `commit()`, `GitDeploy` binds the options and the git runner to its steps, and `ChangesetRelease` binds the repository and the runners to `add()`, `version()` and `tag()`."},"753":{"id":"/js/wp-release/v0.18.1/development-16","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#architecture","content":"**External commands** run through injectable runners: `createSvnRunner()` and `createGitRunner()` return functions that spawn the binary without a shell. The classes take a runner as an option and create the default one when it's missing, so tests pass a fake runner, or one that wraps the real runner and records some commands, instead of putting fake binaries on the `PATH`. The `Svn` and `ReleaseRepository` classes wrap a runner with the commands of their domain."},"754":{"id":"/js/wp-release/v0.18.1/development-17","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#architecture","content":"**Domain logic** is plain functions that take their dependencies as arguments, like `discoverPackages( repository, config )`, so that each one can be tested on its own."},"755":{"id":"/js/wp-release/v0.18.1/development-18","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#architecture","content":"**Commands** in `src/commands/` parse the CLI options and call the library, and `cli.ts` handles the global options, logging and exit codes. Errors carry their exit code, like `ValidationError` with `2`."},"756":{"id":"/js/wp-release/v0.18.1/development-19","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#architecture","content":"Constructors only store their options. Work starts in a method call."},"757":{"id":"/js/wp-release/v0.18.1/development-20","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#architecture","content":"The changeset release modules, from the entry point down:"},"758":{"id":"/js/wp-release/v0.18.1/development-21","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#architecture","content":"| Module                 | Responsibility                                                                                                                              |\n| ---------------------- | ------------------------------------------------------------------------------------------------------------------------------------------- |\n| `changeset-release.ts` | `ChangesetRelease`, which plans releases and runs `add()`, `getStatus()`, `version()` and `tag()`, and the function form of each operation. |","table":"table-0"},"759":{"id":"/js/wp-release/v0.18.1/development-22","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#architecture","content":"| Module              | Responsibility                                                                                       |\n| ------------------- | ---------------------------------------------------------------------------------------------------- |\n| `single-project.ts` | Resolving the config-free root project, its version source and targets, and shared release settings. |","table":"table-0"},"760":{"id":"/js/wp-release/v0.18.1/development-23","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#architecture","content":"| Module                | Responsibility                                                                            |\n| --------------------- | ----------------------------------------------------------------------------------------- |\n| `changeset-config.ts` | Loading and validating `wp-release.config.js`, and the version source and target helpers. |","table":"table-0"},"761":{"id":"/js/wp-release/v0.18.1/development-24","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#architecture","content":"| Module                  | Responsibility                                                                                             |\n| ----------------------- | ---------------------------------------------------------------------------------------------------------- |\n| `changeset-packages.ts` | Discovering the packages of the configured globs, with or without a version, and finding the changed ones. |","table":"table-0"},"762":{"id":"/js/wp-release/v0.18.1/development-25","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#architecture","content":"| Module               | Responsibility                                  |\n| -------------------- | ----------------------------------------------- |\n| `changeset-files.ts` | Reading, writing and consuming changeset files. |","table":"table-0"},"763":{"id":"/js/wp-release/v0.18.1/development-26","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#architecture","content":"| Module                    | Responsibility                                                                                             |\n| ------------------------- | ---------------------------------------------------------------------------------------------------------- |\n| `changeset-dependents.ts` | The dependents policy: which packages re-release with their sources, and rewriting their dependency specs. |","table":"table-0"},"764":{"id":"/js/wp-release/v0.18.1/development-27","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#architecture","content":"| Module          | Responsibility                                            |\n| --------------- | --------------------------------------------------------- |\n| `changesets.ts` | Parsing and formatting changesets, and the release types. |","table":"table-0"},"765":{"id":"/js/wp-release/v0.18.1/development-28","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#architecture","content":"| Module             | Responsibility                                                                 |\n| ------------------ | ------------------------------------------------------------------------------ |\n| `version-files.ts` | Reading and writing versions in manifests, headers, readmes and PHP constants. |","table":"table-0"},"766":{"id":"/js/wp-release/v0.18.1/development-29","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#architecture","content":"| Module         | Responsibility                                                           |\n| -------------- | ------------------------------------------------------------------------ |\n| `changelog.ts` | Changelog entries, and the `CHANGELOG.md` and readme changelog sections. |","table":"table-0"},"767":{"id":"/js/wp-release/v0.18.1/development-30","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#architecture","content":"| Module            | Responsibility                                                                      |\n| ----------------- | ----------------------------------------------------------------------------------- |\n| `release-tags.ts` | Choosing the version and previous tag of a release, and building its release notes. |","table":"table-0"},"768":{"id":"/js/wp-release/v0.18.1/development-31","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#architecture","content":"| Module          | Responsibility                            |\n| --------------- | ----------------------------------------- |\n| `tag-format.ts` | Formatting tag names from the tag format. |","table":"table-0"},"769":{"id":"/js/wp-release/v0.18.1/development-32","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#architecture","content":"| Module              | Responsibility                                                                                                                                                                                   |\n| ------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `package-deploy.ts` | Resolving the configured deploys of a ref: the released packages, their targets and file selections, for `deploy-git` and `deploy-svn`, and the file selection of a package for `zip --package`. |","table":"table-0"},"770":{"id":"/js/wp-release/v0.18.1/development-33","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#architecture","content":"| Module           | Responsibility                                                                                                                      |\n| ---------------- | ----------------------------------------------------------------------------------------------------------------------------------- |\n| `package-zip.ts` | `zipPackage()`, the ZIP and checksums manifest of the selected files of a package, for `zip` and the snapshot builds of a monorepo. |","table":"table-0"},"771":{"id":"/js/wp-release/v0.18.1/development-34","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#architecture","content":"| Module                  | Responsibility                                                                       |\n| ----------------------- | ------------------------------------------------------------------------------------ |\n| `release-repository.ts` | `ReleaseRepository`, the git commands of a release: tags, commits and changed files. |","table":"table-0"},"772":{"id":"/js/wp-release/v0.18.1/development-35","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#architecture","content":"| Module            | Responsibility                                                                     |\n| ----------------- | ---------------------------------------------------------------------------------- |\n| `file-journal.ts` | `FileJournal`, which restores every file a failed `changeset-version` run changed. |","table":"table-0"},"773":{"id":"/js/wp-release/v0.18.1/development-36","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#architecture","content":"| Module        | Responsibility                        |\n| ------------- | ------------------------------------- |\n| `versions.ts` | Version checks and SemVer precedence. |","table":"table-0"},"774":{"id":"/js/wp-release/v0.18.1/development-37","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#architecture","content":"The internationalization modules in `src/i18n/`, from the entry points down:"},"775":{"id":"/js/wp-release/v0.18.1/development-38","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#architecture","content":"| Module        | Responsibility                                                                                                                              |\n| ------------- | ------------------------------------------------------------------------------------------------------------------------------------------- |\n| `packages.ts` | `resolveI18nPackages()`, the config adapter that selects a directory, one package or all packages and resolves their options and POT paths. |","table":"table-1"},"776":{"id":"/js/wp-release/v0.18.1/development-39","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#architecture","content":"| Module       | Responsibility                                                              |\n| ------------ | --------------------------------------------------------------------------- |\n| `options.ts` | Validating and merging the `i18n` options of the config layers and the CLI. |","table":"table-1"},"777":{"id":"/js/wp-release/v0.18.1/development-40","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#architecture","content":"| Module        | Responsibility                                                                                                        |\n| ------------- | --------------------------------------------------------------------------------------------------------------------- |\n| `generate.ts` | `extractCatalog()` and `generatePackagePot()`, which read the selected files of a package and write or check its POT. |","table":"table-1"},"778":{"id":"/js/wp-release/v0.18.1/development-41","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#architecture","content":"| Module       | Responsibility                                                                                                                |\n| ------------ | ----------------------------------------------------------------------------------------------------------------------------- |\n| `compile.ts` | `compileTranslations()`, which compiles a translated PO into MO, script JSON or `.l10n.php` and writes or checks the outputs. |","table":"table-1"},"779":{"id":"/js/wp-release/v0.18.1/development-42","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#architecture","content":"| Module     | Responsibility                                                                                           |\n| ---------- | -------------------------------------------------------------------------------------------------------- |\n| `files.ts` | Selecting source files with the include and exclude globs, independently of the distribution file rules. |","table":"table-1"},"780":{"id":"/js/wp-release/v0.18.1/development-43","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#architecture","content":"| Module                                      | Responsibility                                                                                           |\n| ------------------------------------------- | -------------------------------------------------------------------------------------------------------- |\n| `php.ts`, `javascript.ts` and `metadata.ts` | Parsers for PHP, JavaScript and TypeScript, and `block.json`, `theme.json` and plugin and theme headers. |","table":"table-1"},"781":{"id":"/js/wp-release/v0.18.1/development-44","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#architecture","content":"| Module          | Responsibility                                                        |\n| --------------- | --------------------------------------------------------------------- |\n| `extraction.ts` | The translation functions and their arguments, shared by the parsers. |","table":"table-1"},"782":{"id":"/js/wp-release/v0.18.1/development-45","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#architecture","content":"| Module       | Responsibility                                                   |\n| ------------ | ---------------------------------------------------------------- |\n| `catalog.ts` | Catalog types, merging messages of a domain and the diagnostics. |","table":"table-1"},"783":{"id":"/js/wp-release/v0.18.1/development-46","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#architecture","content":"| Module                           | Responsibility                                               |\n| -------------------------------- | ------------------------------------------------------------ |\n| `audit.ts` and `placeholders.ts` | Audit findings and the sprintf placeholders that they check. |","table":"table-1"},"784":{"id":"/js/wp-release/v0.18.1/development-47","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#architecture","content":"| Module   | Responsibility                  |\n| -------- | ------------------------------- |\n| `pot.ts` | Serializing a catalog as a POT. |","table":"table-1"},"785":{"id":"/js/wp-release/v0.18.1/development-48","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#architecture","content":"| Module                                                  | Responsibility                                                             |\n| ------------------------------------------------------- | -------------------------------------------------------------------------- |\n| `po.ts`, `translation-json.ts` and `translation-php.ts` | Parsing translated PO files and compiling MO, script JSON and `.l10n.php`. |","table":"table-1"},"786":{"id":"/js/wp-release/v0.18.1/development-49","page_id":"/js/wp-release/v0.18.1/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/development#architecture","content":"| Module             | Responsibility                                                 |\n| ------------------ | -------------------------------------------------------------- |\n| `atomic-output.ts` | Validating output paths and replacing output files atomically. |","table":"table-1"},"787":{"id":"/js/wp-release/v0.18.1","page_id":"/js/wp-release/v0.18.1","type":"page","content":"WP Release","breadcrumbs":["Docs","Js","Wp release","v0.18.1"],"tags":[],"url":"/js/wp-release/v0.18.1"},"788":{"id":"/js/wp-release/v0.18.1-0","page_id":"/js/wp-release/v0.18.1","tags":[],"type":"text","url":"/js/wp-release/v0.18.1","content":"Build and release WordPress plugins, themes, and packages."},"789":{"id":"/js/wp-release/v0.18.1-1","page_id":"/js/wp-release/v0.18.1","type":"heading","tags":[],"url":"/js/wp-release/v0.18.1#install","content":"Install"},"790":{"id":"/js/wp-release/v0.18.1-2","page_id":"/js/wp-release/v0.18.1","type":"heading","tags":[],"url":"/js/wp-release/v0.18.1#start-with-the-cli","content":"Start with the CLI"},"791":{"id":"/js/wp-release/v0.18.1-3","page_id":"/js/wp-release/v0.18.1","type":"heading","tags":[],"url":"/js/wp-release/v0.18.1#guides","content":"Guides"},"792":{"id":"/js/wp-release/v0.18.1-4","page_id":"/js/wp-release/v0.18.1","tags":[],"type":"text","url":"/js/wp-release/v0.18.1","content":"`@wpelevator/wp-release` provides a CLI and library for building release directories and ZIPs, creating checksums and signatures, checking versions, extracting and compiling translations, and deploying to WordPress.org SVN or Git repositories."},"793":{"id":"/js/wp-release/v0.18.1-5","page_id":"/js/wp-release/v0.18.1","tags":[],"type":"text","url":"/js/wp-release/v0.18.1","content":"The `wp-release-zip`, `wp-release-checksums`, `wp-release-sign`, and `wp-release-deploy-svn` GitHub Actions expose the same commands in workflows."},"794":{"id":"/js/wp-release/v0.18.1-6","page_id":"/js/wp-release/v0.18.1","tags":[],"type":"text","url":"/js/wp-release/v0.18.1","content":"For projects that don't use Node.js or JavaScript tooling, PHP Changesets (`wpelevator/php-changesets`) runs the same changeset release workflow with PHP and Git alone: `changeset add`, `status`, `version` and `tag` read the same changeset files and match the options of the `changeset-*` commands described in Changesets support."},"795":{"id":"/js/wp-release/v0.18.1-7","page_id":"/js/wp-release/v0.18.1","tags":[],"type":"text","url":"/js/wp-release/v0.18.1","content":"WordPress.org themes are released by uploading a ZIP, so `deploy-svn` is for plugins only. Use `zip` to build a theme upload. Packaging and deployment options follow familiar community tools to ease migration; the comparison explains the differences."},"796":{"id":"/js/wp-release/v0.18.1-8","page_id":"/js/wp-release/v0.18.1","tags":[],"type":"text","url":"/js/wp-release/v0.18.1#install","content":"Node.js 22.12 or later is required. SVN deployments also require the `svn` command line client. Git deployments and changeset commands require Git."},"797":{"id":"/js/wp-release/v0.18.1-9","page_id":"/js/wp-release/v0.18.1","tags":[],"type":"text","url":"/js/wp-release/v0.18.1#install","content":"The package is an ES module with TypeScript declarations. CommonJS projects can load it with `require( '@wpelevator/wp-release' )` on Node.js 22.12 or later."},"798":{"id":"/js/wp-release/v0.18.1-10","page_id":"/js/wp-release/v0.18.1","tags":[],"type":"text","url":"/js/wp-release/v0.18.1#guides","content":"CLI and automation"},"799":{"id":"/js/wp-release/v0.18.1-11","page_id":"/js/wp-release/v0.18.1","tags":[],"type":"text","url":"/js/wp-release/v0.18.1#guides","content":"Changeset releases"},"800":{"id":"/js/wp-release/v0.18.1-12","page_id":"/js/wp-release/v0.18.1","tags":[],"type":"text","url":"/js/wp-release/v0.18.1#guides","content":"Configuration and file selection"},"801":{"id":"/js/wp-release/v0.18.1-13","page_id":"/js/wp-release/v0.18.1","tags":[],"type":"text","url":"/js/wp-release/v0.18.1#guides","content":"Packaging, checksums, signatures, and verification"},"802":{"id":"/js/wp-release/v0.18.1-14","page_id":"/js/wp-release/v0.18.1","tags":[],"type":"text","url":"/js/wp-release/v0.18.1#guides","content":"Git and WordPress.org deployment"},"803":{"id":"/js/wp-release/v0.18.1-15","page_id":"/js/wp-release/v0.18.1","tags":[],"type":"text","url":"/js/wp-release/v0.18.1#guides","content":"WordPress internationalization"},"804":{"id":"/js/wp-release/v0.18.1-16","page_id":"/js/wp-release/v0.18.1","tags":[],"type":"text","url":"/js/wp-release/v0.18.1#guides","content":"Library API"},"805":{"id":"/js/wp-release/v0.18.1-17","page_id":"/js/wp-release/v0.18.1","tags":[],"type":"text","url":"/js/wp-release/v0.18.1#guides","content":"Development and architecture"},"806":{"id":"/js/wp-release/v0.18.1-18","page_id":"/js/wp-release/v0.18.1","tags":[],"type":"text","url":"/js/wp-release/v0.18.1#guides","content":"Comparison with existing tools"},"807":{"id":"/js/wp-release/v0.18.1/internationalization","page_id":"/js/wp-release/v0.18.1/internationalization","type":"page","content":"Internationalization","breadcrumbs":["Docs","Js","Wp release","v0.18.1"],"tags":[],"url":"/js/wp-release/v0.18.1/internationalization"},"808":{"id":"/js/wp-release/v0.18.1/internationalization-0","page_id":"/js/wp-release/v0.18.1/internationalization","type":"heading","tags":[],"url":"/js/wp-release/v0.18.1/internationalization#wordpress-internationalization","content":"WordPress internationalization"},"809":{"id":"/js/wp-release/v0.18.1/internationalization-1","page_id":"/js/wp-release/v0.18.1/internationalization","type":"heading","tags":[],"url":"/js/wp-release/v0.18.1/internationalization#supported-extraction-syntax","content":"Supported extraction syntax"},"810":{"id":"/js/wp-release/v0.18.1/internationalization-2","page_id":"/js/wp-release/v0.18.1/internationalization","type":"heading","tags":[],"url":"/js/wp-release/v0.18.1/internationalization#compile-translated-catalogs","content":"Compile translated catalogs"},"811":{"id":"/js/wp-release/v0.18.1/internationalization-3","page_id":"/js/wp-release/v0.18.1/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/internationalization#wordpress-internationalization","content":"`i18n-pot` extracts plugin/theme strings and writes a reproducible UTF-8 POT. `i18n-audit` reads the same source and returns findings without writing files. Both run with Node alone: no PHP, WordPress installation, database, WP-CLI or network requests. Extraction is independent of `files`, `.distignore` and Git `export-ignore` distribution rules."},"812":{"id":"/js/wp-release/v0.18.1/internationalization-4","page_id":"/js/wp-release/v0.18.1/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/internationalization#wordpress-internationalization","content":"Config-free source directories must have plugin/theme headers. The actual main file is discovered using the package metadata reader, including plugins whose main filename differs from their slug. The selected domain defaults to `Text Domain`, then the directory name. Calls with omitted domains belong to WordPress's `default` domain; block metadata without a domain inherits the package domain. `--all-domains` explicitly combines domains. A block's explicit `textdomain` always controls its messages."},"813":{"id":"/js/wp-release/v0.18.1/internationalization-5","page_id":"/js/wp-release/v0.18.1/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/internationalization#wordpress-internationalization","content":"`--package` selects one configured package and permits extraction-specific overrides; `--all` requires configuration and selects enabled WordPress packages only. Source directories, package selectors and `--all` are mutually exclusive. Config-free directory mode reads only its explicit options and metadata; it does not import repository config implicitly. A disabled package fails when explicitly selected. Configuration uses `i18n` at the root and on package entries, including an exact `glob` for an individual package, following the existing group model. Package entries remain non-overlapping; there is no additional package manifest configuration source."},"814":{"id":"/js/wp-release/v0.18.1/internationalization-6","page_id":"/js/wp-release/v0.18.1/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/internationalization#wordpress-internationalization","content":"Precedence is defaults, root configuration, package group/individual entry, then explicit command options. Scalars override, lists replace inherited lists, and gettext headers merge by key, case-insensitively, preserving intentionally empty values. A header set to `false` is removed, like `'Project-Id-Version': false` to keep the plugin version out of the POT so that it changes only when strings change; a later layer can set it again. `Content-Type` can't be removed, since it declares the UTF-8 charset. Options include `enabled`, `domain`, `allDomains`, `include`, `exclude`, `destination`, `headers`, `fileComment`, `references`, `strict`, `legacyGlobals` and audit `suppress`. `fileComment` adds static text above the POT header; each line is emitted as a gettext comment, and no copyright year is generated. The CLI accepts the same setting with `--file-comment`. Repeat `--include` or `--exclude` for multiple globs; these use case-sensitive minimatch semantics with `/` paths, `**`, brace expansion and dotfile matching, without gitignore negation or comma splitting. Default excludes cover dependency directories, dot directories, tests, minified files and generated translations. Source/build exclusions are a repository choice; this repository excludes `build`, `tools` and isolated vendors in its config."},"815":{"id":"/js/wp-release/v0.18.1/internationalization-7","page_id":"/js/wp-release/v0.18.1/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/internationalization#wordpress-internationalization","content":"The default output is `<Domain Path>/<text-domain>.pot`, or `languages/<text-domain>.pot`. A leading `/` in `Domain Path` is package-relative, and configured destinations cannot escape the package. `--destination` changes the package-relative directory. An explicit `--output <file.pot>` resolves against the command's working directory and requires one package. All multi-package destinations are validated before writing; each completed package replaces its file atomically, independently of other packages. `--check` compares bytes without writing and fails if the POT is absent or stale. Source references are preserved by default; `--no-references` omits them. `POT-Creation-Date` and `PO-Revision-Date` default to empty values; no current date or year is inserted. Name/version headers come from metadata, and `--header NAME=VALUE` overrides any default, including with an empty value, and `--header NAME` removes the header. The POT lists the plugin or theme header strings first, then the strings of PHP, JavaScript, `block.json` and other metadata files in source order, so related strings stay together for translators. Each entry has its extracted comments, references and flags before the strings, in the usual gettext layout. The default headers come in a fixed order, and custom headers follow them. No generator header or generated copyright comment is added; set `fileComment` for a static one."},"816":{"id":"/js/wp-release/v0.18.1/internationalization-8","page_id":"/js/wp-release/v0.18.1/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/internationalization#supported-extraction-syntax","content":"PHP extraction uses `php-parser` in PHP 8.3 mode, tested with attributes, enums, match expressions, promoted properties and readonly classes. Supported WordPress functions are `__`, `_e`, `_x`, `_ex`, `_n`, `_nx`, `_n_noop`, `_nx_noop`, `esc_attr__`, `esc_attr_e`, `esc_attr_x`, `esc_html__`, `esc_html_e` and `esc_html_x`. Global and explicitly global calls, namespace fallback and explicit function imports/aliases are supported. Known file-local declarations and unrelated namespaced imports are excluded; methods and static methods are never translation calls. Named arguments resolve by PHP parameter name. Literal strings, static concatenation and non-interpolated heredoc/nowdoc preserve decoded escapes, Unicode and newlines. Counts may be dynamic; IDs, contexts and selected domains must be static."},"817":{"id":"/js/wp-release/v0.18.1/internationalization-9","page_id":"/js/wp-release/v0.18.1/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/internationalization#supported-extraction-syntax","content":"JavaScript extraction uses Babel's parser and lexical scope traversal, without transforms or project Babel config. JS, JSX, TS, TSX, MJS, CJS, MTS and CTS are supported. Named imports/aliases and namespace imports from `@wordpress/i18n`, unshadowed `wp.i18n` calls and unbound canonical legacy `__`, `_x`, `_n` and `_nx` calls extract strings. `--no-legacy-globals` requires imported or `wp.i18n` bindings. Locally shadowed/reassigned imports are excluded. Static literals, templates without substitutions, concatenation and TypeScript assertions are supported. Destructured CommonJS imports, transpiled `(0, i18n.__)` forms and arbitrary minified bundles are outside the supported syntax; scan source and use explicit source/build mapping for compiled JSON."},"818":{"id":"/js/wp-release/v0.18.1/internationalization-10","page_id":"/js/wp-release/v0.18.1/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/internationalization#supported-extraction-syntax","content":"A `translators:` comment attaches to the first translation call whose containing expression or nearest statement immediately follows it. Whitespace, parsed comments and ternary branch punctuation may intervene, but unrelated statements or argument expressions may not. Comments before outer wrappers reach nested translation calls; a comment is consumed once, so unrelated sibling calls do not inherit it. Multiline comment content is preserved. WordPress plugin/theme header labels serialize as extracted comments. Bundled metadata tables follow WordPress 6.8 block fields and theme fields, including styles, variations, presets, template names and nested block settings. Their upstream data license is GPL-2.0-or-later; tables are maintained intentionally with fixtures and never fetched during generation."},"819":{"id":"/js/wp-release/v0.18.1/internationalization-11","page_id":"/js/wp-release/v0.18.1/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/internationalization#supported-extraction-syntax","content":"Invalid syntax, unreadable selected files, selected source symlinks, empty/reserved message IDs, conflicting plural definitions and output errors fail generation. Unsupported dynamic arguments warn and are fatal with `--strict`. Audit adds `placeholder-comment`, `unordered-placeholders`, `plural-placeholders`, `empty-message` and `conflicting-comments` findings; suppress these explicitly by code where justified. Placeholders support `%%`, positional indexes, numeric width/precision, padding/flags and PHP/JS sprintf conversion types. Audit checks extraction and message quality, not every untranslated user-facing string. Audit fails on errors; strict audit also fails on warnings. Failed checks return exit code `2`; unexpected I/O/option-loading errors follow the existing CLI error handling. `--json`, GitHub annotations, summaries and step outputs use the existing CLI reporting facilities."},"820":{"id":"/js/wp-release/v0.18.1/internationalization-12","page_id":"/js/wp-release/v0.18.1/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/internationalization#compile-translated-catalogs","content":"Runtime formats require a translated PO, not an untranslated POT. PO updating, fuzzy matching and automatic translation are not provided. Compilation validates `Language` and `Plural-Forms`, excludes fuzzy, obsolete and untranslated entries, preserves contexts and plural forms, and never changes the input PO. An incompletely translated plural entry is excluded as a unit. Gettext parsing handles source encoding; runtime outputs use UTF-8. Each output is replaced atomically; JSON outputs are independent writes, and obsolete output files are not deleted automatically."},"821":{"id":"/js/wp-release/v0.18.1/internationalization-13","page_id":"/js/wp-release/v0.18.1/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/internationalization#compile-translated-catalogs","content":"MO and `.l10n.php` default beside the PO, with `.mo` and `.l10n.php` extensions; `--output` selects an explicit file relative to cwd. WordPress PHP catalogs require WordPress 6.5 or later. JSON requires an explicit domain; `--output` is a directory, defaulting to the PO directory. `--check` compares proposed bytes without writing and exits `2` on absent/stale outputs. Compiler commands are primitives and do not select configured packages."},"822":{"id":"/js/wp-release/v0.18.1/internationalization-14","page_id":"/js/wp-release/v0.18.1/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/internationalization#compile-translated-catalogs","content":"A script map is a JSON object from normalized package-relative source references to arrays of normalized runtime script paths. Many source files can feed one bundle, and one source can feed several scripts. An explicit map selects only listed references; an empty target array excludes that source. Without a map, JS/MJS/CJS references use identity paths, while JSX/TypeScript references require mapping. PHP-only references do not enter JSON catalogs."},"823":{"id":"/js/wp-release/v0.18.1/internationalization-15","page_id":"/js/wp-release/v0.18.1/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/internationalization#compile-translated-catalogs","content":"JSON filenames are `<domain>-<Language>-<md5(runtime-path)>.json`; the WordPress `default` domain uses `<Language>-<md5(runtime-path)>.json`. WordPress's `.min.js` normalization applies consistently to grouping, hashing and the JSON `source`. Jed keys preserve context through `\\u0004`, plural arrays contain all translated forms, and revision dates come from the PO metadata. `.l10n.php` writes safely escaped data arrays with NUL-separated plural translations; catalog text is never treated as executable PHP."},"824":{"id":"/js/wp-release/v0.18.1/internationalization-16","page_id":"/js/wp-release/v0.18.1/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/internationalization#compile-translated-catalogs","content":"The package can be installed and used in any WordPress plugin or theme project; repository package selection is optional, and directory mode works without a wp-release config."},"825":{"id":"/js/wp-release/v0.18.1/library","page_id":"/js/wp-release/v0.18.1/library","type":"page","content":"Library API","breadcrumbs":["Docs","Js","Wp release","v0.18.1"],"tags":[],"url":"/js/wp-release/v0.18.1/library"},"826":{"id":"/js/wp-release/v0.18.1/library-0","page_id":"/js/wp-release/v0.18.1/library","type":"heading","tags":[],"url":"/js/wp-release/v0.18.1/library#exit-codes","content":"Exit codes"},"827":{"id":"/js/wp-release/v0.18.1/library-1","page_id":"/js/wp-release/v0.18.1/library","type":"heading","tags":[],"url":"/js/wp-release/v0.18.1/library#library","content":"Library"},"828":{"id":"/js/wp-release/v0.18.1/library-2","page_id":"/js/wp-release/v0.18.1/library","type":"heading","tags":[],"url":"/js/wp-release/v0.18.1/library#logging","content":"Logging"},"829":{"id":"/js/wp-release/v0.18.1/library-3","page_id":"/js/wp-release/v0.18.1/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/library#exit-codes","content":"| Code | Meaning                               |\n| ---- | ------------------------------------- |\n| `0`  | Success, dry run, no changes, or help |","table":"table-0"},"830":{"id":"/js/wp-release/v0.18.1/library-4","page_id":"/js/wp-release/v0.18.1/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/library#exit-codes","content":"| Code | Meaning                                                 |\n| ---- | ------------------------------------------------------- |\n| `1`  | Unexpected failure, such as a failed svn or git command |","table":"table-0"},"831":{"id":"/js/wp-release/v0.18.1/library-5","page_id":"/js/wp-release/v0.18.1/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/library#exit-codes","content":"| Code | Meaning                                                                                                                                          |\n| ---- | ------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `2`  | Invalid options, failed release checks, an existing SVN tag, a Git tag that exists with another release, or files that don't match the checksums |","table":"table-0"},"832":{"id":"/js/wp-release/v0.18.1/library-6","page_id":"/js/wp-release/v0.18.1/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/library#exit-codes","content":"| Code | Meaning                                                   |\n| ---- | --------------------------------------------------------- |\n| `3`  | Missing SVN credentials, or credentials that SVN rejected |","table":"table-0"},"833":{"id":"/js/wp-release/v0.18.1/library-7","page_id":"/js/wp-release/v0.18.1/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/library#library","content":"`resolveDeployOptions()` applies the defaults and throws a `ValidationError` (with `exitCode` `2`) for invalid combinations. `SvnDeploy` exposes each step (`prepare()`, `checkVersions()`, `checkout()`, `sync()`, `commit()` and `cleanup()`) separately so CI wrappers can run and report them one by one; `run()` runs all of them, or nothing when there's nothing to write. `getPlan()` lists the planned SVN changes. The `Svn` class wraps the svn command line, and takes the command runner as a dependency so that tests can replace it."},"834":{"id":"/js/wp-release/v0.18.1/library-8","page_id":"/js/wp-release/v0.18.1/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/library#library","content":"Git deploys:"},"835":{"id":"/js/wp-release/v0.18.1/library-9","page_id":"/js/wp-release/v0.18.1/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/library#library","content":"`resolveGitDeployOptions()` throws a `ValidationError` without a repository URL or with an invalid branch or tag. `GitDeploy` exposes `createTree()`, `fetchPrevious()`, `createRelease()`, `isOutdated()`, `checkTag()`, `getRefsToPush()` and `push()` separately, like `SvnDeploy`, and takes a git command runner from `createGitRunner()` as a dependency. The result has `outdated` when the branch wasn't moved for older source history, the refs to write in `planned` and the refs that were pushed in `pushed`, which is empty in a dry run. `redactUrls()` hides the credentials in URLs."},"836":{"id":"/js/wp-release/v0.18.1/library-10","page_id":"/js/wp-release/v0.18.1/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/library#library","content":"Changeset releases:"},"837":{"id":"/js/wp-release/v0.18.1/library-11","page_id":"/js/wp-release/v0.18.1/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/library#library","content":"`ChangesetRelease` runs the `changeset-*` commands: `add()`, `getStatus()`, `version()` and `tag()`, plus `getPlan()`, `getPackages()` and `getConfiguredPackages()`. Each call reads the configuration, packages and pending changesets again, so one instance can version and then tag. `getConfiguredPackages()` returns package directories with their resolved release group metadata; `formatTag()` and `formatTemplate()` apply the same placeholders as the release workflows. It takes a git runner from `createGitRunner()` as `git`, so that tests can replace it. Without a config file, it detects a single root project. Its optional `singleProject` settings accept `versions` (the existing version descriptors), `versionFrom` (the same selector as `--version-from`), `baseBranch`, `remote`, `changesets`, `readmeChangelog` and `changelogInsertAfter`; `tagFormat` remains a repository option. The functions `addChangeset()`, `getChangesetStatus()`, `versionChangesets()`, `tagChangesets()`, `getChangesetReleasePlan()`, `getChangesetPackages()` and `getConfiguredPackages()` do the same with the default runners, in one call."},"838":{"id":"/js/wp-release/v0.18.1/library-12","page_id":"/js/wp-release/v0.18.1/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/library#logging","content":"`Logger` filters messages by level and passes them to a writer, like the transports of other Node.js loggers. The writer decides how messages look:"},"839":{"id":"/js/wp-release/v0.18.1/library-13","page_id":"/js/wp-release/v0.18.1/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/library#logging","content":"`TextWriter` prints plain text to `stdout` and `stderr`. It's the default."},"840":{"id":"/js/wp-release/v0.18.1/library-14","page_id":"/js/wp-release/v0.18.1/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/library#logging","content":"`GitHubActionsWriter` prints workflow commands, so that notices, warnings and errors with a file are annotations, and appends summaries to `GITHUB_STEP_SUMMARY`. It's the CLI's `github` log format, and the GitHub Actions pass it to their logger. Its `workspace` and `summaryPath` options default to `GITHUB_WORKSPACE` and `GITHUB_STEP_SUMMARY`."},"841":{"id":"/js/wp-release/v0.18.1/library-15","page_id":"/js/wp-release/v0.18.1/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/library#logging","content":"A writer implements `LogWriter` with `write()`, `startGroup()`, `endGroup()` and `summary()`, so other CI systems can have their own format. `summary()` takes a function that builds the Markdown, which only writers with a summary call."},"842":{"id":"/js/wp-release/v0.18.1/library-16","page_id":"/js/wp-release/v0.18.1/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/library#logging","content":"A `ValidationError` can list `problems`, each with a `message` and an optional `file`, `line` and `title`. `logError( logger, error, title )` logs each problem as an error on its file and line and lists them in the summary under the title, or logs the message when there are none. `VersionMismatchError` and `version-check` report the version mismatches this way."},"843":{"id":"/js/wp-release/v0.18.1/library-17","page_id":"/js/wp-release/v0.18.1/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/library#logging","content":"ZIP files and metadata:"},"844":{"id":"/js/wp-release/v0.18.1/library-18","page_id":"/js/wp-release/v0.18.1/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/library#logging","content":"Checksums:"},"845":{"id":"/js/wp-release/v0.18.1/library-19","page_id":"/js/wp-release/v0.18.1/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/library#logging","content":"`loadFileRules()` reads the ignore file and `--exclude` patterns into a gitignore matcher, optionally adds Git `export-ignore` paths, and `selectFiles()` lists the files it doesn't ignore. `compareChecksums()` compares two hash maps without reading any files, and `parseChecksums()` validates manifest JSON. `extractZip()` extracts a ZIP after the same checks as `deploy-svn --from-zip`."},"846":{"id":"/js/wp-release/v0.18.1/library-20","page_id":"/js/wp-release/v0.18.1/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/library#logging","content":"Translations:"},"847":{"id":"/js/wp-release/v0.18.1/library-21","page_id":"/js/wp-release/v0.18.1/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/library#logging","content":"Parsers return messages and structured diagnostics with stable codes, severity and source-relative locations. Catalog messages retain IDs, contexts, plurals, translations, translator comments, flags and structured references. `aggregateCatalog()` selects/merges a domain, unions references/comments and diagnoses plural conflicts. `resolveI18nPackages()` is the separate config adapter; extraction and serialization primitives know nothing about the repository. Library functions do not log, parse process arguments or set exit codes. Extraction results report unique files consulted, including the main plugin/theme file used for headers and header strings even when source globs exclude it. `parseTranslatedPo()`, `compileMo()`, `compileScriptTranslations()`, `compilePhpTranslations()` and `compileTranslations()` expose the same typed operations to library callers."},"848":{"id":"/js/wp-release/v0.18.1/packaging","page_id":"/js/wp-release/v0.18.1/packaging","type":"page","content":"Packaging and integrity","breadcrumbs":["Docs","Js","Wp release","v0.18.1"],"tags":[],"url":"/js/wp-release/v0.18.1/packaging"},"849":{"id":"/js/wp-release/v0.18.1/packaging-0","page_id":"/js/wp-release/v0.18.1/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.18.1/packaging#build-a-directory","content":"Build a directory"},"850":{"id":"/js/wp-release/v0.18.1/packaging-1","page_id":"/js/wp-release/v0.18.1/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.18.1/packaging#zip","content":"ZIP"},"851":{"id":"/js/wp-release/v0.18.1/packaging-2","page_id":"/js/wp-release/v0.18.1/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.18.1/packaging#signing-targets-for-builds-and-zips","content":"Signing targets for builds and ZIPs"},"852":{"id":"/js/wp-release/v0.18.1/packaging-3","page_id":"/js/wp-release/v0.18.1/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.18.1/packaging#checksums","content":"Checksums"},"853":{"id":"/js/wp-release/v0.18.1/packaging-4","page_id":"/js/wp-release/v0.18.1/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.18.1/packaging#filenames-embedding-and-signing","content":"Filenames, embedding and signing"},"854":{"id":"/js/wp-release/v0.18.1/packaging-5","page_id":"/js/wp-release/v0.18.1/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.18.1/packaging#formats","content":"Formats"},"855":{"id":"/js/wp-release/v0.18.1/packaging-6","page_id":"/js/wp-release/v0.18.1/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.18.1/packaging#configuration-and-custom-codecs","content":"Configuration and custom codecs"},"856":{"id":"/js/wp-release/v0.18.1/packaging-7","page_id":"/js/wp-release/v0.18.1/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.18.1/packaging#manifest-inside-the-plugin","content":"Manifest inside the plugin"},"857":{"id":"/js/wp-release/v0.18.1/packaging-8","page_id":"/js/wp-release/v0.18.1/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.18.1/packaging#verify","content":"Verify"},"858":{"id":"/js/wp-release/v0.18.1/packaging-9","page_id":"/js/wp-release/v0.18.1/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.18.1/packaging#sign","content":"Sign"},"859":{"id":"/js/wp-release/v0.18.1/packaging-10","page_id":"/js/wp-release/v0.18.1/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.18.1/packaging#signature-formats","content":"Signature formats"},"860":{"id":"/js/wp-release/v0.18.1/packaging-11","page_id":"/js/wp-release/v0.18.1/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.18.1/packaging#version-check","content":"Version check"},"861":{"id":"/js/wp-release/v0.18.1/packaging-12","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#build-a-directory","content":"`build` and `zip` use the same internal helper to load file rules, exclude their outputs, select release files and reject an empty selection. `build` copies the selected files directly into `--output <dir>`, without a slug wrapper or ZIP. Checksums and manifest signatures are optional. It supports the shared file selection flags above and `--package <name>` with `--config <path>` for configured package rules. A configured package cannot be combined with a source directory or file selection flags."},"862":{"id":"/js/wp-release/v0.18.1/packaging-13","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#build-a-directory","content":"The destination is required and automatically excluded when it is inside the source. It cannot be the source directory or an ancestor, including through symlinked parents. Existing destinations require `--force`, which replaces the directory and removes stale files; existing files and symbolic links are rejected. Files are copied to a temporary directory before the existing build is replaced. Selected symbolic links are rejected as with ZIP packaging. `--json` returns `outputDir`, `files` and, for configured builds, `package`; it also returns `checksumsPath` when a manifest is generated, and `signatures` and `publicKey` when signing is requested. `--github-output` exposes these results too."},"863":{"id":"/js/wp-release/v0.18.1/packaging-14","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#build-a-directory","content":"`--checksums` writes `<output-dir>.checksums.json` beside the directory and hashes the copied build files. `--sign-checksums` generates and signs that manifest, implying `--checksums`. Use `--slug` and `--version` to override its metadata. The manifest and its signatures are excluded from the source selection, so rebuilding with `--force` does not package previous sidecars. Existing manifests and requested signature files also require `--force`; signing keys, formats and signature destinations are validated before creating or replacing the build. `--sign` is unsupported because a directory has no single file to sign."},"864":{"id":"/js/wp-release/v0.18.1/packaging-15","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#build-a-directory","content":"In the Deploy workflow, a directory build can be deployed with `wp-release deploy-svn dist/code-prettify --slug code-prettify --trunk --svn-tag \"$GITHUB_REF_NAME\" --no-distignore`. Keep `--from-zip` when the SVN deployment must match the attached ZIP exactly. Run dependency installation and compilation before `build`; it only selects and copies files."},"865":{"id":"/js/wp-release/v0.18.1/packaging-16","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#zip","content":"The `wp-release-zip` GitHub Action runs this command."},"866":{"id":"/js/wp-release/v0.18.1/packaging-17","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#zip","content":"`zip` writes `{slug}.{version}.zip` to the current directory, or to `--output <file>`, with the selected files in a `{slug}/` root folder:"},"867":{"id":"/js/wp-release/v0.18.1/packaging-18","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#zip","content":"`--root-folder <name>` changes the root folder and `--no-root-folder` puts the files at the root of the ZIP."},"868":{"id":"/js/wp-release/v0.18.1/packaging-19","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#zip","content":"`--filename-format` changes the name, like `--filename-format {slug}` for `my-plugin.zip`."},"869":{"id":"/js/wp-release/v0.18.1/packaging-20","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#zip","content":"Entries are sorted and use a fixed timestamp and file mode. Built-in metadata is deterministic except for embedded minisign signatures, which include their signing timestamp; custom codec callbacks control their own encoded bytes."},"870":{"id":"/js/wp-release/v0.18.1/packaging-21","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#zip","content":"`--checksums` also writes the checksums manifest of the archived files next to the ZIP, with `.checksums.json` instead of `.zip`."},"871":{"id":"/js/wp-release/v0.18.1/packaging-22","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#zip","content":"`--sign` signs only the ZIP with `WP_RELEASE_SIGNING_KEY`. `--sign-checksums` generates and signs only the checksums manifest, implying `--checksums`. Use both flags to sign both files. External signatures are written alongside their files; embedded manifest signatures are written inside the package. The default format is WordPress `.sig`, unless integrity configuration selects another format."},"872":{"id":"/js/wp-release/v0.18.1/packaging-23","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#zip","content":"`--sign-format` selects formats for requested signatures, such as `--sign-format wordpress,minisign,ssh`. It requires `--sign` or `--sign-checksums` and never enables signing by itself. Signing keys, formats and existing signature destinations are validated before writing the ZIP or manifest. `--force` also overwrites requested signatures. Job summaries include signatures and public keys; JSON results include `signatures` and `publicKey`."},"873":{"id":"/js/wp-release/v0.18.1/packaging-24","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#zip","content":"An existing ZIP or manifest isn't overwritten without `--force`. A ZIP or manifest written inside the source directory is never archived."},"874":{"id":"/js/wp-release/v0.18.1/packaging-25","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#zip","content":"`--package <name>` zips a package of the configured packages, by identifier or path under the configured root like `plugins/alpha`, instead of a source directory: its directory with the `files` config of its package group, the same files that its deploys select. The slug defaults to the directory name and the version to the `Version` header, and `--slug` and `--version` still set them. Any package of the config works, with or without a version or deploy targets. To zip what a deploy just released, pass the `package` and `version` of the `deploy-git --release-ref` result, in the same job and from the same build, so the ZIP has exactly the files of the release tag in the release repository. It can't be combined with `<source-dir>` or the file selection options. The `--json` result has the `package`, `slug` and `version`. `zipPackage()` builds the same ZIP from a script, with `getPackageFiles()` for the directory and the files of a package."},"875":{"id":"/js/wp-release/v0.18.1/packaging-26","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#zip","content":"To embed a signed manifest with a stable filename, use:"},"876":{"id":"/js/wp-release/v0.18.1/packaging-27","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#zip","content":"See Checksums for filenames, placement, formats and configuration."},"877":{"id":"/js/wp-release/v0.18.1/packaging-28","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#signing-targets-for-builds-and-zips","content":"| Flag          | `zip`                                         | `build`                                             |\n| ------------- | --------------------------------------------- | --------------------------------------------------- |\n| `--checksums` | Generate an unsigned manifest beside the ZIP. | Generate an unsigned manifest beside the directory. |","table":"table-0"},"878":{"id":"/js/wp-release/v0.18.1/packaging-29","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#signing-targets-for-builds-and-zips","content":"| Flag     | `zip`              | `build`      |\n| -------- | ------------------ | ------------ |\n| `--sign` | Sign only the ZIP. | Unsupported. |","table":"table-0"},"879":{"id":"/js/wp-release/v0.18.1/packaging-30","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#signing-targets-for-builds-and-zips","content":"| Flag               | `zip`                           | `build`                         |\n| ------------------ | ------------------------------- | ------------------------------- |\n| `--sign-checksums` | Generate and sign the manifest. | Generate and sign the manifest. |","table":"table-0"},"880":{"id":"/js/wp-release/v0.18.1/packaging-31","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#signing-targets-for-builds-and-zips","content":"| Flag            | `zip`                                               | `build`                            |\n| --------------- | --------------------------------------------------- | ---------------------------------- |\n| `--sign-format` | Choose formats for explicitly requested signatures. | Same; requires `--sign-checksums`. |","table":"table-0"},"881":{"id":"/js/wp-release/v0.18.1/packaging-32","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#signing-targets-for-builds-and-zips","content":"These flags deliberately replace the former implicit signing behavior: `zip --checksums --sign` now leaves the manifest unsigned, and `--sign-format` alone is rejected. Add `--sign-checksums` to sign a manifest and `--sign` to sign a ZIP. The standalone `checksums` and `sign` commands remain available for workflows that write and sign a manifest inside the source before packaging it."},"882":{"id":"/js/wp-release/v0.18.1/packaging-33","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#checksums","content":"The `wp-release-checksums` GitHub Action runs this command."},"883":{"id":"/js/wp-release/v0.18.1/packaging-34","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#checksums","content":"`checksums` writes a manifest with the MD5 and SHA-256 hash of every selected file, in the format of the WordPress.org plugin checksums API (`https://downloads.wordpress.org/plugin-checksums/{slug}/{version}.json`). Paths are relative to the plugin or theme folder, sorted, and use forward slashes:"},"884":{"id":"/js/wp-release/v0.18.1/packaging-35","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#checksums","content":"Themes use a `theme` key instead of `plugin`, and the version is left out when it's unknown. The manifest is named `{slug}.{version}.checksums.json` after `--filename-format`, the same name as the ZIP with `.checksums.json` instead of `.zip`, so the two are published side by side; `--output <file>` writes it elsewhere. A manifest written inside `<source-dir>` is never listed in itself."},"885":{"id":"/js/wp-release/v0.18.1/packaging-36","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#checksums","content":"Because the manifest lists the files and not the ZIP, it stays valid for any copy of the same files: the GitHub release ZIP, the ZIP that WordPress.org builds from SVN, or an installed plugin on a site."},"886":{"id":"/js/wp-release/v0.18.1/packaging-37","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#filenames-embedding-and-signing","content":"`--checksums-file <file>` enables checksums and sets a relative filename independently of the ZIP name. Without `--embed-checksums`, it resolves against the ZIP output directory; with embedding, it resolves against the package root inside the ZIP (the archive root with `--no-root-folder`). Nested paths are supported, but absolute paths, backslashes, drive letters, control characters and dot segments are rejected. Embedding emits no external manifest and never modifies the source directory. Embedded minisign signatures contain a signing timestamp, so ZIP bytes can differ across signing times; unsigned metadata and WordPress/SSH signatures remain deterministic. Selected source files must not collide with generated manifest or signature entries."},"887":{"id":"/js/wp-release/v0.18.1/packaging-38","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#filenames-embedding-and-signing","content":"`--sign-checksums` enables checksums and signs only the manifest, before embedding when requested. It reads `WP_RELEASE_SIGNING_KEY` and uses `--sign-format wordpress,minisign,ssh` to select formats; each signature travels with the manifest. `--sign-format` selects formats for explicitly requested signing targets and never enables signing. `--sign` signs only the final ZIP; `--sign-checksums` controls the manifest in either placement mode. Use both flags to sign both targets. `--force` permits replacing external output files and signatures. `--json` reports external manifests in `checksumsPath`, embedded package-relative paths in `checksumsEmbedded`, and manifest signatures in `checksumsSignatures`."},"888":{"id":"/js/wp-release/v0.18.1/packaging-39","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#filenames-embedding-and-signing","content":"The default WordPress filename remains the ZIP basename with `.checksums.json` instead of `.zip`, in either placement mode. Choose `--checksums-file checksums.json` for a stable name. The version remains in the JSON content."},"889":{"id":"/js/wp-release/v0.18.1/packaging-40","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#formats","content":"`--checksums-format` chooses the manifest format. `wordpress-json` (default) uses the WordPress-compatible structure shown above. `sha256sum` uses GNU-compatible SHA-256 lines and escaping, with `SHA256SUMS` as its default filename. It carries no package identity or version, and standard `sha256sum --check` checks listed files without rejecting additional files; `wp-release verify` also checks for extra files."},"890":{"id":"/js/wp-release/v0.18.1/packaging-41","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#formats","content":"`--checksums-algorithms md5,sha256` selects JSON digest fields; lists replace configured lists. Supported algorithms are MD5 (for compatibility) and SHA-256. The `sha256sum` codec requires SHA-256. The standalone `checksums` command also accepts `--checksums-format`, keeping `--output` relative to the working directory."},"891":{"id":"/js/wp-release/v0.18.1/packaging-42","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#configuration-and-custom-codecs","content":"The optional top-level `integrity` configuration maps to these flags. Explicit CLI values override configuration; `--no-embed-checksums` and `--no-sign-checksums` disable their configured behaviors. Existing release configurations retain their `packages` array; use `packages: []` for a configuration containing only integrity settings."},"892":{"id":"/js/wp-release/v0.18.1/packaging-43","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#configuration-and-custom-codecs","content":"Use `codec: 'sha256sum'`, `algorithms: ['sha256']`, `file: 'SHA256SUMS'` and `sign: { formats: ['minisign'] }` for the GNU setup. Custom codecs provide `id`, a default `filename`, and `encode`/`decode` callbacks, which may be asynchronous. Generation validates the round trip before writing artifacts: codecs must preserve all selected file paths, represented digests and any represented package identity. They receive and return the existing WordPress-compatible `ChecksumsManifest` model (`plugin` or `theme`, optional `version`, and a `files` map of relative paths to digest fields), keeping format customization separate from selection, hashing and signing."},"893":{"id":"/js/wp-release/v0.18.1/packaging-44","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#configuration-and-custom-codecs","content":"`zip` and `checksums` read the caller's release configuration. For verification of custom codecs or configured filenames, pass `--config wp-release.config.mjs` explicitly. See Verify."},"894":{"id":"/js/wp-release/v0.18.1/packaging-45","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#manifest-inside-the-plugin","content":"For a manifest that is also published as a separate release asset or deployed directly from a source directory, write and sign it in that directory before packaging. Use `zip --embed-checksums` as described above when only the archive should contain the generated metadata. The source-directory workflow uses the same manifest for installed copies and release assets:"},"895":{"id":"/js/wp-release/v0.18.1/packaging-46","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#manifest-inside-the-plugin","content":"Write the manifest into the directory that is zipped and deployed. The `checksums` command leaves its output manifest and its signatures (`<name>.sig`, `<name>.minisig` and `<name>.sshsig`) out of the hashes, so running it again with the same output path and `--force` gives the same manifest. `verify` checks matching copies as described below. Sign it last, since the signature covers the exact bytes of the manifest."},"896":{"id":"/js/wp-release/v0.18.1/packaging-47","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#manifest-inside-the-plugin","content":"`zip` and `deploy-svn` carry the pair like any other file. Don't use `zip --checksums` here, since it would write a second manifest that lists the first one. Attach `build/checksums.json` and `build/checksums.json.sig` to the GitHub release as they are."},"897":{"id":"/js/wp-release/v0.18.1/packaging-48","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#manifest-inside-the-plugin","content":"The signature covers file hashes and not a ZIP, so it stays valid for the ZIP that WordPress.org builds from SVN. Check what WordPress.org serves after a deploy, with the manifest and public key from your build:"},"898":{"id":"/js/wp-release/v0.18.1/packaging-49","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#manifest-inside-the-plugin","content":"The manifest can have any name and location, for example `--output build/includes/signatures/checksums.json`, and missing folders are created. Tell `verify` where the shipped copy is with `--embedded <path>`, like `--embedded includes/signatures/checksums.json`. Both the `--checksums` file and its signature must then exist, both copies must be shipped, and they're skipped when comparing files and must be identical to the originals. The manifest can't list the embedded path. Without `--embedded`, `verify` looks for the manifest name at the root, and skips a file only when it exists, the matching original exists and the manifest doesn't list it. Otherwise it's checked like any other file, so a listed file that has the name of the manifest can't be deleted unnoticed, and a shipped `.sig` without an original is reported as not in the checksums."},"899":{"id":"/js/wp-release/v0.18.1/packaging-50","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#manifest-inside-the-plugin","content":"The public key has to come from somewhere other than the plugin that it checks, because someone who can overwrite the plugin files can also replace a key and a signature inside them. A copy of the manifest also doesn't prevent a downgrade to an older release that was signed too, so the installing side has to enforce a minimum version."},"900":{"id":"/js/wp-release/v0.18.1/packaging-51","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#verify","content":"`verify` checks a directory against a manifest from `checksums` or from the WordPress.org checksums API, and reports every changed, missing and extra file. It exits with `2` unless all files match:"},"901":{"id":"/js/wp-release/v0.18.1/packaging-52","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#verify","content":"A file matches when its SHA-256 equals the manifest. Manifests without SHA-256 fall back to MD5, and a hash can also be a list of accepted values."},"902":{"id":"/js/wp-release/v0.18.1/packaging-53","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#verify","content":"`verify` doesn't read `.distignore`, so that an ignore file inside the checked directory can't hide added files. `--exclude <patterns>` skips paths in both the directory and the manifest, for files that aren't part of the release, such as caches."},"903":{"id":"/js/wp-release/v0.18.1/packaging-54","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#verify","content":"Manifest paths outside the package folder (absolute or with `..`) are rejected."},"904":{"id":"/js/wp-release/v0.18.1/packaging-55","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#verify","content":"`--zip <file|url>` checks the files of a ZIP instead of a directory. The ZIP can be a URL, such as the one that WordPress.org builds for a release, and its single root folder is found automatically (or set `--root-folder`). The ZIP is extracted to a temporary directory after the same safety checks as `deploy-svn --from-zip`."},"905":{"id":"/js/wp-release/v0.18.1/packaging-56","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#verify","content":"The version in the manifest must match the `Version` header of the checked files, so that an older release with its own valid manifest can't pass as a newer one."},"906":{"id":"/js/wp-release/v0.18.1/packaging-57","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#verify","content":"A manifest can't list itself. A copy of the manifest and of its signature inside the checked files, at the root with the same names as the `--checksums` file or at the path of `--embedded`, is skipped when comparing files, but it must be identical to the `--checksums` file and its signature. The signature is the `.sig` file, or the file of `--signature-format`. A path that the manifest lists is never skipped, and a file that isn't a matching copy is reported as not in the checksums. See Manifest inside the plugin."},"907":{"id":"/js/wp-release/v0.18.1/packaging-58","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#verify","content":"A checksums manifest proves only that the files match the manifest. With `--public-key <key>`, `verify` first checks `<checksums>.sig` against the Ed25519 public key and fails with exit code `2` before comparing any file when the signature is missing or invalid, so that the manifest itself can be trusted. `--signature-format minisign` or `ssh` checks `<checksums>.minisig` or `<checksums>.sshsig` instead. The key can be the base64 key, the minisign public key or the `ssh-ed25519` public key, since they're forms of the same key. See Sign."},"908":{"id":"/js/wp-release/v0.18.1/packaging-59","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#verify","content":"Verification never executes configuration from inside a downloaded package. Without `--checksums`, `verify` reads the embedded filename selected by `--checksums-file`, explicit configuration, or the codec default. For a versioned embedded filename, pass that filename explicitly. With a public key, signatures are checked before decoding; the selected signature format must exist (WordPress `.sig` by default; pass `--signature-format minisign` or `ssh` for those formats), and all other present supported signature formats are also authenticated when verifying the embedded manifest. Without a public key, checksums detect changes but do not authenticate the publisher. Trusted public keys must come from outside the package."},"909":{"id":"/js/wp-release/v0.18.1/packaging-60","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#sign","content":"The `wp-release-sign` GitHub Action runs this command."},"910":{"id":"/js/wp-release/v0.18.1/packaging-61","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#sign","content":"`sign` writes a detached signature next to each file, `<file>.sig`, so that downloads and installed copies can be trusted. Sign both the ZIP and the checksums manifest: the ZIP signature covers installs and updates, and the manifest signature covers the contents after unpacking and copies that weren't built by you."},"911":{"id":"/js/wp-release/v0.18.1/packaging-62","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#sign","content":"The signature is the one WordPress core's `verify_file_signature()` checks: a base64 Ed25519 signature of the raw SHA-384 digest of the file. The tests check it against `sodium_crypto_sign_verify_detached()` in PHP. A `.sig` file can hold several signatures, one per line, and a file is valid when any of them match, which allows a key rotation window."},"912":{"id":"/js/wp-release/v0.18.1/packaging-63","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#sign","content":"The key is read from the `WP_RELEASE_SIGNING_KEY` environment variable only, as a base64 32-byte Ed25519 seed or a 64-byte libsodium secret key, the formats that `sodium_crypto_sign_seed_keypair()` and the update-pilot-server package signing key take. There's no flag for it, since it would show in the process list, and it's never logged."},"913":{"id":"/js/wp-release/v0.18.1/packaging-64","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#sign","content":"`--verbose` prints the public key of the signing key in the form of each written format. `--json` returns it as `publicKey`, and in every form as `publicKeys`. Pass it to `verify --public-key` and to the plugin that checks the signatures."},"914":{"id":"/js/wp-release/v0.18.1/packaging-65","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#sign","content":"An existing signature file isn't overwritten without `--force`."},"915":{"id":"/js/wp-release/v0.18.1/packaging-66","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#sign","content":"`zip --sign` signs only the ZIP; add `--sign-checksums` to sign its manifest too. `signFiles()` signs files from a script."},"916":{"id":"/js/wp-release/v0.18.1/packaging-67","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#signature-formats","content":"The same key can also sign in formats that tools outside WordPress check, for people who download a release by hand or verify it in other pipelines. Pick them with `--format`, comma-separated or repeated; the default is `wordpress`:"},"917":{"id":"/js/wp-release/v0.18.1/packaging-68","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#signature-formats","content":"| Format      | File         | Checked by                                                                        |\n| ----------- | ------------ | --------------------------------------------------------------------------------- |\n| `wordpress` | `<file>.sig` | WordPress core's `verify_file_signature()`, update-client and `wp-release verify` |","table":"table-1"},"918":{"id":"/js/wp-release/v0.18.1/packaging-69","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#signature-formats","content":"| Format     | File             | Checked by                                                                    |\n| ---------- | ---------------- | ----------------------------------------------------------------------------- |\n| `minisign` | `<file>.minisig` | minisign and compatible tools: `minisign -Vm <file> -P <minisign public key>` |","table":"table-1"},"919":{"id":"/js/wp-release/v0.18.1/packaging-70","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#signature-formats","content":"| Format | File            | Checked by                                                                                                      |\n| ------ | --------------- | --------------------------------------------------------------------------------------------------------------- |\n| `ssh`  | `<file>.sshsig` | OpenSSH 8.1 or later: `ssh-keygen -Y verify -f allowed_signers -I <identity> -n file -s <file>.sshsig < <file>` |","table":"table-1"},"920":{"id":"/js/wp-release/v0.18.1/packaging-71","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#signature-formats","content":"`minisign` signs the BLAKE2b-512 digest of the file, like `minisign -S` does by default, and adds a trusted comment with the signing time and file name that a second signature covers. minisign generates a random key ID for its keys, but the key here is a plain Ed25519 seed, so wp-release derives the key ID from the public key. `wp-release verify` doesn't compare key IDs, so signatures of keys that minisign generated verify too."},"921":{"id":"/js/wp-release/v0.18.1/packaging-72","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#signature-formats","content":"`ssh` is the armored `SSHSIG` format that `ssh-keygen -Y sign` writes, with a SHA-512 digest and the `file` namespace, so that the signature can't pass as one for commits or another namespace. It's written to `.sshsig` instead of the `.sig` of `ssh-keygen`, which the `wordpress` format uses. Put the SSH public key in an `allowed_signers` file as `<identity> ssh-ed25519 AAAA…`."},"922":{"id":"/js/wp-release/v0.18.1/packaging-73","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#signature-formats","content":"All formats are Ed25519 signatures by the same key, so one key and one secret cover all of them. The tests check each format with `minisign`, `ssh-keygen` and libsodium, and check the signatures that `minisign` and `ssh-keygen` write with `wp-release verify`."},"923":{"id":"/js/wp-release/v0.18.1/packaging-74","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#signature-formats","content":"Generate a key pair with `wp-release keygen`. It prints the private seed once as `WP_RELEASE_SIGNING_KEY=…` and the matching public key, also as a minisign public key and an `ssh-ed25519` public key. Generate keys locally and store the private seed in your secret manager or CI secrets. Distribute the public key to verifiers. `keygen --github-output` is rejected to keep the private seed out of workflow outputs; regular and `--json` output both include the seed."},"924":{"id":"/js/wp-release/v0.18.1/packaging-75","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#version-check","content":"`version-check` compares the versions that have to agree before a release, and reports every mismatch with exit code `2`:"},"925":{"id":"/js/wp-release/v0.18.1/packaging-76","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#version-check","content":"The expected version is `--version`, or the `Version` header."},"926":{"id":"/js/wp-release/v0.18.1/packaging-77","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#version-check","content":"The readme `Stable tag` must match for plugins; `--no-stable-tag` skips it, and themes have no Stable tag."},"927":{"id":"/js/wp-release/v0.18.1/packaging-78","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#version-check","content":"`--constant NAME` (repeatable) checks `define( 'NAME', '1.2.0' )` or `const NAME = '1.2.0'` in every PHP file outside `vendor/`, `node_modules/` and dot directories. A constant that isn't defined is a mismatch."},"928":{"id":"/js/wp-release/v0.18.1/packaging-79","page_id":"/js/wp-release/v0.18.1/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.1/packaging#version-check","content":"`--git-tag` defaults to `GITHUB_REF` when it's a tag. `--git-tag-format` (default `{version}`) can have a prefix or the slug, like `v{version}` or `{slug}-{version}`; a leading `v` in the version is ignored, like for SVN tags."},"929":{"id":"/js/wp-release/v0.18.2/changesets","page_id":"/js/wp-release/v0.18.2/changesets","type":"page","content":"Changesets","breadcrumbs":["Docs","Js","Wp release","v0.18.2"],"tags":[],"url":"/js/wp-release/v0.18.2/changesets"},"930":{"id":"/js/wp-release/v0.18.2/changesets-0","page_id":"/js/wp-release/v0.18.2/changesets","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2/changesets#changesets-support","content":"Changesets support"},"931":{"id":"/js/wp-release/v0.18.2/changesets-1","page_id":"/js/wp-release/v0.18.2/changesets","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2/changesets#single-project-repositories-without-a-config-file","content":"Single-project repositories without a config file"},"932":{"id":"/js/wp-release/v0.18.2/changesets-2","page_id":"/js/wp-release/v0.18.2/changesets","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2/changesets#single-project-checks-in-github-actions","content":"Single-project checks in GitHub Actions"},"933":{"id":"/js/wp-release/v0.18.2/changesets-3","page_id":"/js/wp-release/v0.18.2/changesets","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2/changesets#packages-and-tags","content":"Packages and tags"},"934":{"id":"/js/wp-release/v0.18.2/changesets-4","page_id":"/js/wp-release/v0.18.2/changesets","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2/changesets#pre-releases","content":"Pre-releases"},"935":{"id":"/js/wp-release/v0.18.2/changesets-5","page_id":"/js/wp-release/v0.18.2/changesets","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2/changesets#snapshots","content":"Snapshots"},"936":{"id":"/js/wp-release/v0.18.2/changesets-6","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#changesets-support","content":"The changeset commands manage versioning, changelogs and release tags for single-package repositories and monorepos, including this repository. They read Changesets-style Markdown and load JavaScript configs with descriptors for npm and Composer manifests, plugin and theme headers, readme Stable tags, PHP constants, and Git tags. Use JavaScript configs with ESM (`export default`) or CommonJS (`module.exports`). Frontmatter uses `package-name: patch|minor|major` entries. For pre-releases, use the built-in pre-release workflow; the parser supports this simple frontmatter format rather than general YAML or the Changesets pre mode."},"937":{"id":"/js/wp-release/v0.18.2/changesets-7","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#changesets-support","content":"PHP projects that don't use Node.js or JavaScript can run the same workflow with PHP Changesets, a Composer package that needs only PHP and Git. Its `changeset add`, `changeset status`, `changeset version` and `changeset tag` commands take the options of the `changeset-*` commands here, read the same changeset files and print the same release plans, with a PHP config file in place of `wp-release.config.*`. Use `wp-release` when the project already builds with Node.js, or to also build ZIPs, translations and WordPress.org deploys; see the comparison for the differences."},"938":{"id":"/js/wp-release/v0.18.2/changesets-8","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#single-project-repositories-without-a-config-file","content":"The `changeset-*` commands can release one project at the repository root without a `wp-release.config.*` file. Run them from the root directory. With no version descriptor flags, they detect a root `package.json` or `composer.json` with a version, a plugin entry PHP file with a `Plugin Name` header, or a theme `style.css` with a `Theme Name` header. A detected plugin also updates the Stable tag in `readme.txt`, or `readme.md` when no Stable tag is found in `readme.txt`. Multiple version sources, multiple plugin entry files and npm workspaces require explicit descriptors or a config; files belonging to different projects aren't silently synchronized. A directory without a recognized version source still requires a config or explicit descriptors."},"939":{"id":"/js/wp-release/v0.18.2/changesets-9","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#single-project-repositories-without-a-config-file","content":"For a root npm package, the complete workflow needs no project flags:"},"940":{"id":"/js/wp-release/v0.18.2/changesets-10","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#single-project-repositories-without-a-config-file","content":"A single configured package is selected automatically for `changeset-add --bump` when `--since` isn't supplied, and for `changeset-tag --version`; `--since` still selects changed packages. npm and Composer projects use their root manifest's name as the changeset identifier when that manifest supplies the version; other projects use the root directory's basename. `--project-name <name>` pins the identifier of a repository without a manifest name, so local checkouts and CI don't need matching directory names; a config sets the same identifier with `id`. The fallback uses `.changeset/`, `CHANGELOG.md`, tags named `v{version}`, and the `origin` remote. There is no default comparison branch: pass `--since` or `--base-branch` when status checks should compare changes. Readme changelog updates are opt-in."},"941":{"id":"/js/wp-release/v0.18.2/changesets-11","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#single-project-repositories-without-a-config-file","content":"Explicit descriptors replace automatic detection and define the entire version target list. For a plugin whose version appears in its header, readme and a PHP constant:"},"942":{"id":"/js/wp-release/v0.18.2/changesets-12","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#single-project-repositories-without-a-config-file","content":"The same project flags belong on `changeset-add`, `changeset-status`, `changeset-version` and `changeset-tag`. Keep them consistent across all four commands, for example in command-specific npm scripts. An accompanying `package.json` used for build tools isn't changed unless it is included explicitly."},"943":{"id":"/js/wp-release/v0.18.2/changesets-13","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#single-project-repositories-without-a-config-file","content":"| Flag                            | Version descriptor                     |\n| ------------------------------- | -------------------------------------- |\n| `--version-package-json <file>` | npm manifest version source and target |","table":"table-0"},"944":{"id":"/js/wp-release/v0.18.2/changesets-14","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#single-project-repositories-without-a-config-file","content":"| Flag                             | Version descriptor                                                                                                       |\n| -------------------------------- | ------------------------------------------------------------------------------------------------------------------------ |\n| `--version-composer-json <file>` | Composer manifest version source and target; a target without a `version` field is skipped, while a source must have one |","table":"table-0"},"945":{"id":"/js/wp-release/v0.18.2/changesets-15","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#single-project-repositories-without-a-config-file","content":"| Flag                                | Version descriptor                                |\n| ----------------------------------- | ------------------------------------------------- |\n| `--version-wordpress-plugin <file>` | WordPress plugin Version header source and target |","table":"table-0"},"946":{"id":"/js/wp-release/v0.18.2/changesets-16","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#single-project-repositories-without-a-config-file","content":"| Flag                               | Version descriptor                               |\n| ---------------------------------- | ------------------------------------------------ |\n| `--version-wordpress-theme <file>` | WordPress theme Version header source and target |","table":"table-0"},"947":{"id":"/js/wp-release/v0.18.2/changesets-17","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#single-project-repositories-without-a-config-file","content":"| Flag                                    | Version descriptor                                                                                        |\n| --------------------------------------- | --------------------------------------------------------------------------------------------------------- |\n| `--version-wordpress-stable-tag <file>` | WordPress readme Stable tag source and target; keeps its stable version during pre-releases and snapshots |","table":"table-0"},"948":{"id":"/js/wp-release/v0.18.2/changesets-18","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#single-project-repositories-without-a-config-file","content":"| Flag                                       | Version descriptor                                  |\n| ------------------------------------------ | --------------------------------------------------- |\n| `--version-php-constant <file>#<constant>` | PHP `define()` or `const` version source and target |","table":"table-0"},"949":{"id":"/js/wp-release/v0.18.2/changesets-19","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#single-project-repositories-without-a-config-file","content":"| Flag                          | Version descriptor                                                                                                      |\n| ----------------------------- | ----------------------------------------------------------------------------------------------------------------------- |\n| `--version-git-tag <pattern>` | Current version from existing stable Git tags, with a pattern such as `v{version}`; source-only, never a version target |","table":"table-0"},"950":{"id":"/js/wp-release/v0.18.2/changesets-20","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#single-project-repositories-without-a-config-file","content":"File descriptor flags are repeatable. The source is inferred from a sole descriptor, or a unique descriptor other than a Stable tag. Otherwise use `--version-from <kind>`, where kind is `package-json`, `composer-json`, `wordpress-plugin`, `wordpress-theme`, `wordpress-stable-tag`, `php-constant` or `git-tag`. For repeated kinds, qualify the selector with the exact descriptor value: `--version-from package-json:package.json` or `--version-from 'php-constant:my-plugin.php#MY_PLUGIN_VERSION'`. Argument order doesn't select the source. A Git source requires a matching existing stable tag; its pattern selects the tags to read, while `--tag-format` controls tags to create. With multiple descriptors, explicitly select `git-tag` if it is the authoritative source."},"951":{"id":"/js/wp-release/v0.18.2/changesets-21","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#single-project-repositories-without-a-config-file","content":"| Shared option           | Config equivalent                                                                                                       |\n| ----------------------- | ----------------------------------------------------------------------------------------------------------------------- |\n| `--project-name <name>` | `id`, the literal changeset identifier of the root package, instead of the manifest name or checkout directory basename |","table":"table-1"},"952":{"id":"/js/wp-release/v0.18.2/changesets-22","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#single-project-repositories-without-a-config-file","content":"| Shared option            | Config equivalent                                                 |\n| ------------------------ | ----------------------------------------------------------------- |\n| `--base-branch <branch>` | `baseBranch`, used with the remote for the default comparison ref |","table":"table-1"},"953":{"id":"/js/wp-release/v0.18.2/changesets-23","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#single-project-repositories-without-a-config-file","content":"| Shared option     | Config equivalent                                       |\n| ----------------- | ------------------------------------------------------- |\n| `--remote <name>` | `remote`, used for comparisons and pushing release tags |","table":"table-1"},"954":{"id":"/js/wp-release/v0.18.2/changesets-24","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#single-project-repositories-without-a-config-file","content":"| Shared option            | Config equivalent                             |\n| ------------------------ | --------------------------------------------- |\n| `--changesets-dir <dir>` | `changesets`, relative to the repository root |","table":"table-1"},"955":{"id":"/js/wp-release/v0.18.2/changesets-25","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#single-project-repositories-without-a-config-file","content":"| Shared option                                  | Config equivalent                                                |\n| ---------------------------------------------- | ---------------------------------------------------------------- |\n| `--readme-changelog` / `--no-readme-changelog` | `readmeChangelog`, independent of updating the readme Stable tag |","table":"table-1"},"956":{"id":"/js/wp-release/v0.18.2/changesets-26","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#single-project-repositories-without-a-config-file","content":"| Shared option                       | Config equivalent                                                                                          |\n| ----------------------------------- | ---------------------------------------------------------------------------------------------------------- |\n| `--changelog-insert-after <marker>` | `changelogInsertAfter`; must exist in `CHANGELOG.md` and, with readme changelog updates, the plugin readme |","table":"table-1"},"957":{"id":"/js/wp-release/v0.18.2/changesets-27","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#single-project-repositories-without-a-config-file","content":"| Shared option           | Config equivalent                               |\n| ----------------------- | ----------------------------------------------- |\n| `--tag-format <format>` | `tagFormat`, replacing the default `v{version}` |","table":"table-1"},"958":{"id":"/js/wp-release/v0.18.2/changesets-28","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#single-project-repositories-without-a-config-file","content":"An explicit `--config` must load successfully. Otherwise a discovered config takes precedence over the single-project fallback. Single-project descriptor and settings flags cannot be mixed with a config file; put those settings in the config instead. The existing global `--tag-format` override works in both modes. Config files remain the place for package layouts, dependents, custom version and changelog callbacks, deployment destinations and distribution settings. Packaging and deployment commands retain their existing config requirements."},"959":{"id":"/js/wp-release/v0.18.2/changesets-29","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#single-project-repositories-without-a-config-file","content":"Typical release flow, from a feature pull request to the publish workflows triggered by release tags:"},"960":{"id":"/js/wp-release/v0.18.2/changesets-30","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#single-project-repositories-without-a-config-file","content":"An empty changeset marks a feature PR as no-release. The version workflow consumes it without changing versions, and a release PR containing only its deletion produces no tags."},"961":{"id":"/js/wp-release/v0.18.2/changesets-31","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#single-project-repositories-without-a-config-file","content":"`version.from` selects the current version; `version.to` lists release targets. Use `phpConstantVersion( { file, constant } )` to sync a PHP constant."},"962":{"id":"/js/wp-release/v0.18.2/changesets-32","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#single-project-checks-in-github-actions","content":"There are no dedicated build or changeset wrapper actions. Install the CLI in your project and run it directly. A root npm package can check a pull request with:"},"963":{"id":"/js/wp-release/v0.18.2/changesets-33","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#single-project-checks-in-github-actions","content":"For a plugin with several version targets, put the same descriptor flags in npm scripts for all four changeset commands. Full Git history and tags are needed for comparisons, Git version sources and release notes. Keep the checkout directory name consistent when it supplies the changeset identifier. Directory artifacts use `npx --no-install wp-release build --output dist/my-plugin --github-output`; upload that directory with your artifact action. `build` writes manifest sidecars outside the directory and does not accept the ZIP-only embedding, codec or manifest-filename flags."},"964":{"id":"/js/wp-release/v0.18.2/changesets-34","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#packages-and-tags","content":"The config describes the repository, so wp-release assumes no directory structure or naming convention of its own:"},"965":{"id":"/js/wp-release/v0.18.2/changesets-35","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#packages-and-tags","content":"**Packages** are the directories that the `glob` of a `packages` entry matches under `root`, with `*`, `?` and `**`, like `plugins/*`, or `.` for a repository with one package at its root. The settings of an entry apply to each of its packages. Discovery never looks inside `.git`, `node_modules`, `vendor` or `dist` directories. A package is identified by its path, or with `idFrom` by the name in its `package.json` or `composer.json`, or with a literal `id` when the group matches exactly one package, and commands that take a package accept a path or identifier."},"966":{"id":"/js/wp-release/v0.18.2/changesets-36","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#packages-and-tags","content":"**Templates** name the tags and the deploy targets of a package with these placeholders:"},"967":{"id":"/js/wp-release/v0.18.2/changesets-37","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#packages-and-tags","content":"| Placeholder | Value                                                                 | `plugins/alpha` | Root package |\n| ----------- | --------------------------------------------------------------------- | --------------- | ------------ |\n| `{path}`    | Package directory relative to `root`, empty for a package at the root | `plugins/alpha` | (empty)      |","table":"table-2"},"968":{"id":"/js/wp-release/v0.18.2/changesets-38","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#packages-and-tags","content":"| Placeholder | Value              | `plugins/alpha`                                     | Root package                             |\n| ----------- | ------------------ | --------------------------------------------------- | ---------------------------------------- |\n| `{name}`    | Package identifier | `plugins/alpha`, or its manifest name with `idFrom` | the manifest name, or the directory name |","table":"table-2"},"969":{"id":"/js/wp-release/v0.18.2/changesets-39","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#packages-and-tags","content":"| Placeholder | Value            | `plugins/alpha` | Root package |\n| ----------- | ---------------- | --------------- | ------------ |\n| `{version}` | Released version | `1.2.0`         | `1.2.0`      |","table":"table-2"},"970":{"id":"/js/wp-release/v0.18.2/changesets-40","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#packages-and-tags","content":"Deploy templates also have `{branch}`, `{ref}` and `{revision}` (see Deploy configured packages), and any template can be a callback that receives the package, for names that the placeholders don't cover, like the last directory of the path."},"971":{"id":"/js/wp-release/v0.18.2/changesets-41","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#packages-and-tags","content":"**`tagFormat`** names the release tags, `{path}/{version}` by default, like `plugins/alpha/1.2.0`. Empty placeholders leave no leading or repeated slashes in a tag, so a package at the root gets plain version tags, like `1.2.0`, from the same default. Deploy templates, like repository URLs, are filled in as they are. A `gitTagVersion()` version source reads the tags with its own `pattern`, also `{path}/{version}` by default, so set both when you change the format."},"972":{"id":"/js/wp-release/v0.18.2/changesets-42","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#packages-and-tags","content":"**`releaseTitle`** titles the release, like the `title` that `changeset-tag` reports for creating a GitHub Release. The default is `name@version`, like `plugins/alpha@1.2.0`, without the prefix for a package at the repository root, which is titled `1.2.0` like its tag. Like `tagFormat`, it supports `{name}`, `{path}`, `{version}` and `{tag}` placeholders: `releaseTitle: '{version} (beta)'`, or a callback that receives `{ package, version, tag }` like the release notes callback. A template without a placeholder fails at load time, since it would name every release alike. `changeset-tag --release-title <template>` replaces the `releaseTitle` of the config for one command, like `--tag-format` replaces `tagFormat`."},"973":{"id":"/js/wp-release/v0.18.2/changesets-43","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#packages-and-tags","content":"**`--tag-format <format>`** replaces the `tagFormat` of the config for one command, for a workflow or job that names its tags differently, like `--tag-format '{name}@{version}'`. Every command that creates or reads the same tags needs the same format: `changeset-tag`, which creates them and finds the previous tag for the release notes, `changeset-version --prerelease`, which numbers pre-releases from them, and `deploy-git` and `deploy-svn --release-ref`, which read the package and version of a tag."},"974":{"id":"/js/wp-release/v0.18.2/changesets-44","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#packages-and-tags","content":"**Slugs** are a WordPress concept: the folder of a plugin or theme. Only the commands that produce something for WordPress use one: the `{slug}/` root folder and name of a `zip`, the `checksums` manifest, the WordPress.org slug of `deploy-svn`, and `version-check`. Each takes `--slug`, which defaults to the name of the working directory, or of the package directory with `zip --package`, and an SVN deploy target takes `slug`, which defaults to the name of the package directory. Tags and Git deploy targets don't have a slug."},"975":{"id":"/js/wp-release/v0.18.2/changesets-45","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#packages-and-tags","content":"**`remote`** is the git remote that `changeset-tag --push` pushes tags to and that the base branch is compared on, `origin` by default."},"976":{"id":"/js/wp-release/v0.18.2/changesets-46","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#packages-and-tags","content":"The default strategy bumps stable `x.y.z` versions with SemVer rules, and the `x.y` and `x.y.z.w` versions common in WordPress plugins the same way: the bumped part is raised, the parts after it reset to `0`, and the version keeps its number of parts. A minor bump of `2.1` is `2.2` and a major bump is `3.0`, while a patch bump adds the third part, `2.1.1`. A patch bump of `1.2.3.4` is `1.2.4.0`, so raising only the fourth part needs a custom strategy. Configure `nextVersion( { package, bump, currentVersion, changesets } )` for other formats; changeset bumps remain `patch`, `minor` or `major`. Pre-releases are added to the next version with `--prerelease`, described below."},"977":{"id":"/js/wp-release/v0.18.2/changesets-47","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#packages-and-tags","content":"Without `--since`, `changeset-status` compares against `<remote>/<baseBranch>`, where `remote` in the config defaults to `origin` and is also the remote that `changeset-tag --push` pushes tags to; fetch that ref or pass `--since` when using a fork or different upstream. `loadChangesetConfig()` discovers a conventional config at the repository root, unless `--config <path>` selects one explicitly."},"978":{"id":"/js/wp-release/v0.18.2/changesets-48","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#packages-and-tags","content":"Add release notes in a feature PR with `npx wp-release changeset-add`. In a terminal, it lists the packages, marks the ones that changed since `<remote>/<baseBranch>` (or `--since <ref>`) without a changeset, and asks for the packages to release, a `patch`, `minor` or `major` bump for each, and the release note. Choose packages by number, identifier or path, or press Enter to release the changed ones; `none` adds an empty changeset. Changed files include uncommitted and untracked ones, since changesets are usually added before committing."},"979":{"id":"/js/wp-release/v0.18.2/changesets-49","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#packages-and-tags","content":"Without a terminal, or for scripts, pass the changeset as options: `npx wp-release changeset-add --package @vendor/plugin --bump patch --summary \"Fix the checkout validation.\"`. Repeat package and bump flags for multiple packages, or use `--empty` when no release is needed. A package can also be named by its path under `root`, like `plugins/alpha`, and the changeset records its identifier; `changeset-version --package` and `changeset-tag --package` accept paths too. A single `--bump` without `--package` releases every changed package without a changeset, like `changeset-add --bump patch --summary \"…\"` to fix a failing `changeset-status` check. `--json` and `--github-output` never ask."},"980":{"id":"/js/wp-release/v0.18.2/changesets-50","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#packages-and-tags","content":"In CI, `changeset-status --since origin/main` requires a changeset added by the PR; changesets already on the base do not count, while an empty PR changeset records an explicit no-release decision. Missing-change annotations identify an affected file."},"981":{"id":"/js/wp-release/v0.18.2/changesets-51","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#packages-and-tags","content":"On the release branch, preview with `changeset-version --dry-run`, then run `changeset-version` to update version targets and changelogs. By default, new Markdown entries go before the first version heading; `changelogInsertAfter` sets a literal insertion marker for `CHANGELOG.md` and, with `readmeChangelog`, the plugin readme. Put the marker in both files; a missing marker is an error. Without a marker, plugin readmes use the `== Changelog ==` heading. Failed updates are rolled back for safe retries."},"982":{"id":"/js/wp-release/v0.18.2/changesets-52","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#packages-and-tags","content":"Configure `changelogEntry( { package, changeset, commit } )` to format the changelog entry of each changeset, where `commit` is the `{ hash, shortHash, subject }` of the commit that added the changeset file, if it's committed. The formatted entries go into `CHANGELOG.md`, the `changelog` of each release in the `changeset-version` result, and so the release notes; plugin readmes keep the plain summaries. Without the callback, entries are the plain summaries. For example, to link each entry to its commit:"},"983":{"id":"/js/wp-release/v0.18.2/changesets-53","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#packages-and-tags","content":"Configure `dependents` to re-release packages that bundle a package when it releases. The dependents come from what the packages declare: a package is a dependent of a source when the spec that it declares in its npm `dependencies` or `optionalDependencies` (or the sections that the policy adds) resolves the current version of the source or points at the workspace, and it re-releases when the next version of the source falls outside the declared range, or always with `when: 'always'`. A pin to an older version selects a registry release instead and `changeset-status` warns about the drift until the pin resolves the package again. Versioning a dependent rewrites its declared specs of the source to the released version, keeping their range prefixes, so an exact pin matches the released workspace again and the built bundle matches the changelog. Wildcards and unpinned ranges accept the release without one, like the `devDependencies` of a package. The derived dependents appear in `changeset-status`, `changeset-version` and `changeset-tag` like any other release, and a dependent that releases for its own reasons keeps its own bump and appends the bundle note:"},"984":{"id":"/js/wp-release/v0.18.2/changesets-54","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#packages-and-tags","content":"Excluded packages still release with their own changesets and stay out of the automatic re-releases."},"985":{"id":"/js/wp-release/v0.18.2/changesets-55","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#packages-and-tags","content":"When the changesets of a pull request release a source, `changeset-status` requires no changeset for a dependent whose only change is the spec of that source in its `package.json`, since versioning rewrites the spec and the bundle note announces it. Any other change to the dependent, like another manifest field or dependency, documentation or code, needs its own changeset."},"986":{"id":"/js/wp-release/v0.18.2/changesets-56","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#packages-and-tags","content":"The bundle changelog entry defaults to `Bundle <source> <version>.` and is formatted with `dependents.changelog( { package, source } )`:"},"987":{"id":"/js/wp-release/v0.18.2/changesets-57","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#packages-and-tags","content":"`dependents.sections` lists the npm dependency sections that declare a source, defaulting to `dependencies` and `optionalDependencies`; add `devDependencies` for dependencies that end up in the dependent's build, or `peerDependencies` to scan them."},"988":{"id":"/js/wp-release/v0.18.2/changesets-58","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#packages-and-tags","content":"The `dependents.dependency` hooks extend the built-in npm scan instead of replacing it, so that both work behind the same range rule and rewrite:"},"989":{"id":"/js/wp-release/v0.18.2/changesets-59","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#packages-and-tags","content":"After versioning, run `npm install --package-lock-only` so that the root lockfile resolves the rewritten pins to the workspace links again; the `Prepare Release` workflow (`prepare-release.yml` in this monorepo) does it with its release pull request."},"990":{"id":"/js/wp-release/v0.18.2/changesets-60","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#packages-and-tags","content":"To release packages separately, for example with a release pull request for each, pass `--package <name>`, repeatable, to version only those packages. A changeset that also names other packages keeps only their entries and its summary, so it still applies to their releases with the same bump. Changesets without packages are left for a run without `--package`."},"991":{"id":"/js/wp-release/v0.18.2/changesets-61","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#packages-and-tags","content":"The `changeset-version` result lists each release with its `package`, `bump`, `currentVersion`, `nextVersion` and `changelog` entries, a Markdown list like the one added to `CHANGELOG.md`. Use it to name and describe the release pull request in a repository script, or call `versionChangesets()` from the library and format the entries of each release with `formatChangelogEntries( release.changesets )`."},"992":{"id":"/js/wp-release/v0.18.2/changesets-62","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#packages-and-tags","content":"After merging the release PR, `changeset-tag --since <merge-commit>^1 --push` pushes tags only for packages changed by that release. It pushes one tag at a time because GitHub doesn't trigger workflows for a push of more than three tags. wp-release doesn't create GitHub Releases: with `--json` or `--github-output`, each entry of `tags` has the `tag`, a `title` like `plugins/alpha@1.2.0` or, for a package at the repository root, the release title like `1.2.0` (see releaseTitle, and `--release-title` for overriding it in one command), the release `notes` and a `prerelease` flag, for a workflow step like `softprops/action-gh-release` to create the release (see the example below). For initial adoption, preview all missing tags with `changeset-tag --dry-run` (without `--since`), then push if needed. To release each package with a separate workflow instead, `changeset-tag --since <merge-commit>^1 --untagged --github-output` lists the releases that don't have a tag yet, without creating any. Tag pushes need Git write credentials."},"993":{"id":"/js/wp-release/v0.18.2/changesets-63","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#packages-and-tags","content":"To release a single package, for example from a manual workflow, pass `--package <name>`, repeatable, and with one package `--version <version>` to fail unless the package is at that version. Packages versioned by git tags have no version file, so for them `--version` is the version to tag. Before a tag is created, every `version.to` target must match the version, so a plugin `Version` header that disagrees with its readme `Stable tag` blocks the tag. Versions with a pre-release part, like `1.0.0-rc.1`, have `prerelease` set, so their GitHub Releases can be marked as pre-releases. This example selects one package, so `tags[0]` is its release; these fields are nested in the JSON result:"},"994":{"id":"/js/wp-release/v0.18.2/changesets-64","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#packages-and-tags","content":"The release notes are the version's `CHANGELOG.md` section, or without one the commits that changed the package since its previous tag, the highest version below the released one, skipping pre-releases for a stable version. Configure `releaseNotes( { package, version, tag, previousTag, changelog, commits, notes } )` to format them, for example to add links; `notes` is the default text and `commits` lists `{ hash, shortHash, subject }`, newest first. `changeset-tag --package <name> --dry-run` prints them without creating the tag."},"995":{"id":"/js/wp-release/v0.18.2/changesets-65","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#packages-and-tags","content":"For local development, run the TypeScript source with `npm run wp-release -- <command>` (for example, `npm run wp-release -- changeset-status --since origin/main`). GitHub workflows use the same CLI for versioning and tagging. `SUBTREE_DEPLOY_TOKEN` lets them update the release PR and push tags, and the `Tag Release` workflow passes it to `softprops/action-gh-release` to create the GitHub Releases."},"996":{"id":"/js/wp-release/v0.18.2/changesets-66","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#pre-releases","content":"`changeset-version --prerelease <id>` (the `prerelease` option of `versionChangesets()`) releases pre-releases of the next versions, like `1.3.0-rc.1` for a minor bump of `1.2.0`. The identifier, like `alpha`, `beta` or `rc`, can have a number, like `rc.2`, which is used as is and fails when the version is already tagged. Without a number, the number is one above the highest existing tag of that identifier and next stable version, read with the `tagFormat` of the package, so the first one is `rc.1`, and the numbering starts again at `.1` when later changesets raise the next version. The dependents of a source become pre-releases too, so that they bundle its pre-release, unless they're left out with `--no-dependents`."},"997":{"id":"/js/wp-release/v0.18.2/changesets-67","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#pre-releases","content":"A pre-release writes every version target except the readme `Stable tag`, which keeps the last stable version since WordPress.org offers it to every site, and `changeset-tag` skips the `Stable tag` when it verifies a pre-release. The changelog gets a section for the pre-release, like `## 1.3.0-rc.1 (2026-10-12)`, so that `changeset-tag` finds its release notes, and the changesets are consumed like in any release."},"998":{"id":"/js/wp-release/v0.18.2/changesets-68","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#pre-releases","content":"Since a pre-release consumes the changesets that the stable release needs, run it on a branch that isn't merged, and tag that branch commit:"},"999":{"id":"/js/wp-release/v0.18.2/changesets-69","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#pre-releases","content":"The base branch keeps its stable versions and pending changesets, so the stable release later versions them as usual, in one changelog section. The tag keeps the pre-release commit reachable after the branch is reset or deleted. The release notes of a stable release compare with the previous stable release, skipping the pre-releases before it, and the `git-tag` version source ignores pre-release tags, so packages versioned by git tags keep building on their last stable version."},"1000":{"id":"/js/wp-release/v0.18.2/changesets-70","page_id":"/js/wp-release/v0.18.2/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/changesets#snapshots","content":"`changeset-version --snapshot <id>` (the `snapshot` option of `versionChangesets()`) releases snapshots of the next versions for test builds, like `1.3.0-pr-251.20261012183005` for a pull request: the next version with the identifier, like `pr-251` or `pr-251.0abc123` with a commit hash, and the UTC time, so that every snapshot is unique and they sort by time. Snapshots aren't numbered from tags and can't be combined with `--prerelease`. Like a pre-release, a snapshot writes every version target except the readme `Stable tag`. Build and publish the versioned files without committing them, for example under an npm dist-tag like `pr-251`, since a snapshot consumes the changesets:"},"1001":{"id":"/js/wp-release/v0.18.2/cli","page_id":"/js/wp-release/v0.18.2/cli","type":"page","content":"CLI","breadcrumbs":["Docs","Js","Wp release","v0.18.2"],"tags":[],"url":"/js/wp-release/v0.18.2/cli"},"1002":{"id":"/js/wp-release/v0.18.2/cli-0","page_id":"/js/wp-release/v0.18.2/cli","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2/cli#cli","content":"CLI"},"1003":{"id":"/js/wp-release/v0.18.2/cli-1","page_id":"/js/wp-release/v0.18.2/cli","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2/cli#github-actions-annotations-and-job-summaries","content":"GitHub Actions annotations and job summaries"},"1004":{"id":"/js/wp-release/v0.18.2/cli-2","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#cli","content":"| Command                                                    | Description                                   |\n| ---------------------------------------------------------- | --------------------------------------------- |\n| `wp-release build [<source-dir>] --output <dir> [options]` | Copy selected release files into a directory. |","table":"table-0"},"1005":{"id":"/js/wp-release/v0.18.2/cli-3","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#cli","content":"| Command                                   | Description                                                                  |\n| ----------------------------------------- | ---------------------------------------------------------------------------- |\n| `wp-release zip [<source-dir>] [options]` | Create a ZIP archive with a `{slug}/` root folder, respecting `.distignore`. |","table":"table-0"},"1006":{"id":"/js/wp-release/v0.18.2/cli-4","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#cli","content":"| Command                                         | Description                                                                         |\n| ----------------------------------------------- | ----------------------------------------------------------------------------------- |\n| `wp-release checksums [<source-dir>] [options]` | Write the MD5 and SHA-256 hashes of every distributed file to a checksums manifest. |","table":"table-0"},"1007":{"id":"/js/wp-release/v0.18.2/cli-5","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#cli","content":"| Command                               | Description                                                                                                            |\n| ------------------------------------- | ---------------------------------------------------------------------------------------------------------------------- |\n| `wp-release sign <file>... [options]` | Sign files with Ed25519, writing a detached `<file>.sig` next to each, or minisign and SSH signatures with `--format`. |","table":"table-0"},"1008":{"id":"/js/wp-release/v0.18.2/cli-6","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#cli","content":"| Command             | Description                                                                                      |\n| ------------------- | ------------------------------------------------------------------------------------------------ |\n| `wp-release keygen` | Generate a base64 Ed25519 private seed and its public key, also as minisign and SSH public keys. |","table":"table-0"},"1009":{"id":"/js/wp-release/v0.18.2/cli-7","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#cli","content":"| Command                                                         | Description                                                                |\n| --------------------------------------------------------------- | -------------------------------------------------------------------------- |\n| `wp-release verify [<source-dir>] --checksums <file> [options]` | Check a plugin or theme directory, or a ZIP, against a checksums manifest. |","table":"table-0"},"1010":{"id":"/js/wp-release/v0.18.2/cli-8","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#cli","content":"| Command                                             | Description                                                                            |\n| --------------------------------------------------- | -------------------------------------------------------------------------------------- |\n| `wp-release version-check [<source-dir>] [options]` | Check that the `Version` header, readme `Stable tag`, PHP constants and git tag agree. |","table":"table-0"},"1011":{"id":"/js/wp-release/v0.18.2/cli-9","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#cli","content":"| Command                                          | Description                                                 |\n| ------------------------------------------------ | ----------------------------------------------------------- |\n| `wp-release deploy-svn [<source-dir>] [options]` | Deploy a plugin to the WordPress.org plugin SVN repository. |","table":"table-0"},"1012":{"id":"/js/wp-release/v0.18.2/cli-10","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#cli","content":"| Command                                                          | Description                                                                             |\n| ---------------------------------------------------------------- | --------------------------------------------------------------------------------------- |\n| `wp-release deploy-git [<source-dir>] --git-url <url> [options]` | Deploy the files of a plugin, theme or package to a Git repository as a release commit. |","table":"table-0"},"1013":{"id":"/js/wp-release/v0.18.2/cli-11","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#cli","content":"| Command                                                                 | Description                                                                     |\n| ----------------------------------------------------------------------- | ------------------------------------------------------------------------------- |\n| `wp-release deploy-git --release-ref <ref> [--package <name>] [--list]` | Deploy the configured packages of a release tag or branch to their Git targets. |","table":"table-0"},"1014":{"id":"/js/wp-release/v0.18.2/cli-12","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#cli","content":"| Command                                                                 | Description                                                     |\n| ----------------------------------------------------------------------- | --------------------------------------------------------------- |\n| `wp-release deploy-svn --release-ref <ref> [--package <name>] [--list]` | Deploy the configured plugin of a release tag to WordPress.org. |","table":"table-0"},"1015":{"id":"/js/wp-release/v0.18.2/cli-13","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#cli","content":"| Command                                        | Description                                                |\n| ---------------------------------------------- | ---------------------------------------------------------- |\n| `wp-release i18n-pot [<source-dir>] [options]` | Extract translatable strings into a reproducible POT file. |","table":"table-0"},"1016":{"id":"/js/wp-release/v0.18.2/cli-14","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#cli","content":"| Command                                          | Description                                               |\n| ------------------------------------------------ | --------------------------------------------------------- |\n| `wp-release i18n-audit [<source-dir>] [options]` | Report translation string problems without writing files. |","table":"table-0"},"1017":{"id":"/js/wp-release/v0.18.2/cli-15","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#cli","content":"| Command                                  | Description                           |\n| ---------------------------------------- | ------------------------------------- |\n| `wp-release i18n-mo <file.po> [options]` | Compile a translated PO file into MO. |","table":"table-0"},"1018":{"id":"/js/wp-release/v0.18.2/cli-16","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#cli","content":"| Command                                                      | Description                                                                              |\n| ------------------------------------------------------------ | ---------------------------------------------------------------------------------------- |\n| `wp-release i18n-json <file.po> --domain <domain> [options]` | Compile the JavaScript strings of a translated PO file into WordPress script JSON files. |","table":"table-0"},"1019":{"id":"/js/wp-release/v0.18.2/cli-17","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#cli","content":"| Command                                   | Description                                                     |\n| ----------------------------------------- | --------------------------------------------------------------- |\n| `wp-release i18n-php <file.po> [options]` | Compile a translated PO file into a WordPress `.l10n.php` file. |","table":"table-0"},"1020":{"id":"/js/wp-release/v0.18.2/cli-18","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#cli","content":"| Command                              | Description                                  |\n| ------------------------------------ | -------------------------------------------- |\n| `wp-release changeset-add [options]` | Record the release impact of a pull request. |","table":"table-0"},"1021":{"id":"/js/wp-release/v0.18.2/cli-19","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#cli","content":"| Command                                 | Description                                                      |\n| --------------------------------------- | ---------------------------------------------------------------- |\n| `wp-release changeset-status [options]` | List pending releases and check changed packages for changesets. |","table":"table-0"},"1022":{"id":"/js/wp-release/v0.18.2/cli-20","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#cli","content":"| Command                                  | Description                                |\n| ---------------------------------------- | ------------------------------------------ |\n| `wp-release changeset-version [options]` | Apply version bumps and changelog entries. |","table":"table-0"},"1023":{"id":"/js/wp-release/v0.18.2/cli-21","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#cli","content":"| Command                              | Description                          |\n| ------------------------------------ | ------------------------------------ |\n| `wp-release changeset-tag [options]` | Create missing package release tags. |","table":"table-0"},"1024":{"id":"/js/wp-release/v0.18.2/cli-22","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#cli","content":"Run `npx wp-release <command> --help` for the options of each command. Directory-based commands accept a first `<source-dir>` argument or `--source-dir`, defaulting to the current directory. `sign` and the `i18n-mo`, `i18n-json` and `i18n-php` compilers take file arguments, `keygen` generates keys, and changeset commands operate on the configured repository. Every command prints its result as JSON with `--json`. Commands that take no positional arguments, like the changeset commands, reject bare arguments with the usage instead of ignoring them."},"1025":{"id":"/js/wp-release/v0.18.2/cli-23","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#cli","content":"In GitHub Actions, `--github-output` writes the complete result as JSON to `steps.<id>.outputs.result` and exposes each top-level string, number or boolean as a plain output. Use `steps.zip.outputs.zipPath` for a ZIP path, for example. Arrays and objects remain in `result`: tag metadata is read with `fromJSON( steps.tag.outputs.result ).tags[0].tag`, even when only one package is selected. There is no plain `steps.tag.outputs.tag` output."},"1026":{"id":"/js/wp-release/v0.18.2/cli-24","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#cli","content":"Prefer plain outputs in steps that run conditionally, since a skipped step has empty outputs. When reading JSON from a step that may be skipped, use a fallback such as `fromJSON( steps.tag.outputs.result || '{\"tags\":[]}' ).tags[0].tag`. For several tags or deploys, read the arrays in `result` to build a job matrix or process each item."},"1027":{"id":"/js/wp-release/v0.18.2/cli-25","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#github-actions-annotations-and-job-summaries","content":"With the `github` log format, the CLI uses current GitHub Actions features to report problems where you look for them, instead of only in the log. `--log-format <name>` picks how the CLI logs, separately from the result that `--json` prints:"},"1028":{"id":"/js/wp-release/v0.18.2/cli-26","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#github-actions-annotations-and-job-summaries","content":"| Log format | Output                                          |\n| ---------- | ----------------------------------------------- |\n| `text`     | Plain text. The default outside GitHub Actions. |","table":"table-1"},"1029":{"id":"/js/wp-release/v0.18.2/cli-27","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#github-actions-annotations-and-job-summaries","content":"| Log format | Output                                                                                                              |\n| ---------- | ------------------------------------------------------------------------------------------------------------------- |\n| `github`   | GitHub Actions annotations and job summaries. The default when `GITHUB_ACTIONS=true`. `--ci` is a shorthand for it. |","table":"table-1"},"1030":{"id":"/js/wp-release/v0.18.2/cli-28","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#github-actions-annotations-and-job-summaries","content":"Pass `--log-format text` for plain text in GitHub Actions. The GitHub Actions always use the `github` log format. Only the CLI checks `GITHUB_ACTIONS`: the library classes don't read the environment, and choose the format by the writer they get."},"1031":{"id":"/js/wp-release/v0.18.2/cli-29","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#github-actions-annotations-and-job-summaries","content":"Errors, warnings and notices are printed as workflow commands, so they show up as annotations on the run and on the files of a pull request:"},"1032":{"id":"/js/wp-release/v0.18.2/cli-30","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#github-actions-annotations-and-job-summaries","content":"`version-check` and `deploy-svn` annotate each version mismatch on the file and line of the version: the `Version` header, the readme `Stable tag` or the PHP constant."},"1033":{"id":"/js/wp-release/v0.18.2/cli-31","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#github-actions-annotations-and-job-summaries","content":"`verify` annotates each changed file and each file that isn't in the checksums."},"1034":{"id":"/js/wp-release/v0.18.2/cli-32","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#github-actions-annotations-and-job-summaries","content":"Each command also adds a section to the job summary of the run, when `GITHUB_STEP_SUMMARY` is set:"},"1035":{"id":"/js/wp-release/v0.18.2/cli-33","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#github-actions-annotations-and-job-summaries","content":"| Command      | Summary                                                                                                                                                                                            |\n| ------------ | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `deploy-svn` | Plugin, linked to its WordPress.org page, version, written SVN paths, the commit linked to its WordPress.org changeset (or the dry run or no-op result), and the SVN changes in a collapsed table. |","table":"table-2"},"1036":{"id":"/js/wp-release/v0.18.2/cli-34","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#github-actions-annotations-and-job-summaries","content":"| Command      | Summary                                                   |\n| ------------ | --------------------------------------------------------- |\n| `deploy-git` | Repository, release commit and the pushed branch and tag. |","table":"table-2"},"1037":{"id":"/js/wp-release/v0.18.2/cli-35","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#github-actions-annotations-and-job-summaries","content":"| Command | Summary                                                                                               |\n| ------- | ----------------------------------------------------------------------------------------------------- |\n| `build` | Output directory, number of copied files and optional manifest; requested signatures and public keys. |","table":"table-2"},"1038":{"id":"/js/wp-release/v0.18.2/cli-36","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#github-actions-annotations-and-job-summaries","content":"| Command | Summary                                                                                                                |\n| ------- | ---------------------------------------------------------------------------------------------------------------------- |\n| `zip`   | ZIP, number of files and checksums manifest; with `--sign`, signature files and the public key of each written format. |","table":"table-2"},"1039":{"id":"/js/wp-release/v0.18.2/cli-37","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#github-actions-annotations-and-job-summaries","content":"| Command     | Summary                       |\n| ----------- | ----------------------------- |\n| `checksums` | Manifest and number of files. |","table":"table-2"},"1040":{"id":"/js/wp-release/v0.18.2/cli-38","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#github-actions-annotations-and-job-summaries","content":"| Command | Summary                                                    |\n| ------- | ---------------------------------------------------------- |\n| `sign`  | Signature files and the public key of each written format. |","table":"table-2"},"1041":{"id":"/js/wp-release/v0.18.2/cli-39","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#github-actions-annotations-and-job-summaries","content":"| Command  | Summary                                                                                  |\n| -------- | ---------------------------------------------------------------------------------------- |\n| `verify` | That all files match, or the counts and a table of the changed, missing and extra files. |","table":"table-2"},"1042":{"id":"/js/wp-release/v0.18.2/cli-40","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#github-actions-annotations-and-job-summaries","content":"| Command         | Summary                                                                        |\n| --------------- | ------------------------------------------------------------------------------ |\n| `version-check` | The matching version, or a table of the mismatches with their files and lines. |","table":"table-2"},"1043":{"id":"/js/wp-release/v0.18.2/cli-41","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#github-actions-annotations-and-job-summaries","content":"| Command            | Summary                                               |\n| ------------------ | ----------------------------------------------------- |\n| `changeset-status` | Each changed package with whether it has a changeset. |","table":"table-2"},"1044":{"id":"/js/wp-release/v0.18.2/cli-42","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#github-actions-annotations-and-job-summaries","content":"| Command             | Summary                                                               |\n| ------------------- | --------------------------------------------------------------------- |\n| `changeset-version` | A table of the package releases with their version changes and bumps. |","table":"table-2"},"1045":{"id":"/js/wp-release/v0.18.2/cli-43","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#github-actions-annotations-and-job-summaries","content":"| Command         | Summary                                                                                  |\n| --------------- | ---------------------------------------------------------------------------------------- |\n| `changeset-tag` | Each tag with its previous tag and status, and its release notes in a collapsed section. |","table":"table-2"},"1046":{"id":"/js/wp-release/v0.18.2/cli-44","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#github-actions-annotations-and-job-summaries","content":"A failed command adds its error to the summary, or a table of its problems with their files and lines, listing up to 100 and counting the rest. The Markdown of the summaries isn't part of the library API. File paths are relative to `GITHUB_WORKSPACE`, or the current directory without it. Files outside it, like those of an extracted ZIP, get an annotation without a file. Multi-line messages stay one annotation."},"1047":{"id":"/js/wp-release/v0.18.2/cli-45","page_id":"/js/wp-release/v0.18.2/cli","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/cli#github-actions-annotations-and-job-summaries","content":"Use global `--config <path>` to select a config; relative paths resolve from the current directory. Otherwise, commands using the config discover `wp-release.config.js`, `.mjs` or `.cjs` at the repository root. Global `--tag-format <format>` replaces the `tagFormat` of the config for one command, see Packages and tags."},"1048":{"id":"/js/wp-release/v0.18.2/comparison","page_id":"/js/wp-release/v0.18.2/comparison","type":"page","content":"Comparison with other tools","breadcrumbs":["Docs","Js","Wp release","v0.18.2"],"tags":[],"url":"/js/wp-release/v0.18.2/comparison"},"1049":{"id":"/js/wp-release/v0.18.2/comparison-0","page_id":"/js/wp-release/v0.18.2/comparison","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2/comparison#comparison-with-existing-tools","content":"Comparison with existing tools"},"1050":{"id":"/js/wp-release/v0.18.2/comparison-1","page_id":"/js/wp-release/v0.18.2/comparison","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/comparison#comparison-with-existing-tools","content":"| Tool                                                             | What it does                                                                                                                                                                                                                                                                                                                | How `wp-release` differs                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |\n| ---------------------------------------------------------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| 10up WordPress.org plugin deploy and readme/asset update actions | Two separate GitHub Actions configured through env vars. A deploy always syncs the build to `trunk/` and copies it to the tag; readme and asset updates need the second action. Assets come from `.wordpress-org` by default, and files are selected with `.distignore` or `.gitattributes`. Files are synced with `rsync`. | One `deploy-svn` command with independent write flags, so a release, a readme-only update and an assets-only update are the same command with different flags. Runs locally and in any CI, not only GitHub Actions, and syncs in Node.js without `rsync`. Checks that the `Version` header, readme `Stable tag` and SVN tag agree before writing, which the 10up actions don't. Assets are deployed only when `--assets-dir` is passed, instead of always syncing `.wordpress-org` when it exists, so a plugin's own `assets/` folder is never uploaded by accident. Adds `--exclude` for patterns without an ignore file, opt-in Git `export-ignore` support and `--from-zip` to deploy the exact files of a ZIP. |","table":"table-0"},"1051":{"id":"/js/wp-release/v0.18.2/comparison-2","page_id":"/js/wp-release/v0.18.2/comparison","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/comparison#comparison-with-existing-tools","content":"| Tool              | What it does                                                                                                     | How `wp-release` differs                                                                                                                                                                  |\n| ----------------- | ---------------------------------------------------------------------------------------------------------------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `grunt-wp-deploy` | Grunt task with `deploy_trunk` and `deploy_tag` booleans, interactive password prompts and a `Stable tag` check. | No Grunt dependency and never interactive. `--readme-only` is a separate flag, where `grunt-wp-deploy` can only update trunk with the full build. Assets are independent of trunk writes. |","table":"table-0"},"1052":{"id":"/js/wp-release/v0.18.2/comparison-3","page_id":"/js/wp-release/v0.18.2/comparison","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/comparison#comparison-with-existing-tools","content":"| Tool                  | What it does                                                                     | How `wp-release` differs                                                                                                           |\n| --------------------- | -------------------------------------------------------------------------------- | ---------------------------------------------------------------------------------------------------------------------------------- |\n| codeinwp theme deploy | Fork of the 10up plugin action that commits themes to the themes SVN repository. | Doesn't deploy themes. Theme releases are ZIP uploads on WordPress.org; `zip` builds the upload with the theme folder as the root. |","table":"table-0"},"1053":{"id":"/js/wp-release/v0.18.2/comparison-4","page_id":"/js/wp-release/v0.18.2/comparison","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/comparison#comparison-with-existing-tools","content":"| Tool              | What it does                                                                                             | How `wp-release` differs                                                                                                                                                                                                                                                                                                                                                                      |\n| ----------------- | -------------------------------------------------------------------------------------------------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `wp dist-archive` | WP-CLI command that zips a project using `.distignore`, with `--plugin-dirname` and `--filename-format`. | Same `.distignore` file and `{name}.{version}` style filename format, but needs only Node.js instead of PHP and WP-CLI. `.distignore` is matched with full gitignore syntax, including `!` negation, and `--distignore` / `--exclude` let you point at another ignore file or add patterns on the command line. Builds are reproducible, and `--checksums` writes a manifest next to the ZIP. |","table":"table-0"},"1054":{"id":"/js/wp-release/v0.18.2/comparison-5","page_id":"/js/wp-release/v0.18.2/comparison","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/comparison#comparison-with-existing-tools","content":"| Tool               | What it does                                                                                                                                                                                                        | How `wp-release` differs                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |\n| ------------------ | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `wp i18n make-pot` | WP-CLI command that extracts PHP, JavaScript, `block.json` and `theme.json` strings into a POT, with `--domain`, `--include`/`--exclude`, `--headers`, `--file-comment`, `--merge`/`--subtract` and audit warnings. | `i18n-pot` and `i18n-audit` need only Node.js, write byte-for-byte reproducible POTs without dates, and `--check` fails CI on a stale POT. Headers are set one at a time with a repeatable `--header NAME=VALUE` instead of a JSON object, and `--include`/`--exclude` take one glob each, so patterns never need escaping or comma splitting. `--no-references` and `--all-domains` say what they do. Monorepos keep these settings once in `wp-release.config.js` and select packages with `--package` or `--all` instead of running the command for every directory. The audit is a separate read-only command with stable finding codes for `--suppress`, instead of warnings mixed into generation. There's no `--merge`, `--subtract` or `--skip-*`; `--include` and `--exclude` cover the same needs. |","table":"table-0"},"1055":{"id":"/js/wp-release/v0.18.2/comparison-6","page_id":"/js/wp-release/v0.18.2/comparison","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/comparison#comparison-with-existing-tools","content":"| Tool                                          | What it does                                                                                                                                                                                          | How `wp-release` differs                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |\n| --------------------------------------------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `wp i18n make-mo`, `make-json` and `make-php` | WP-CLI commands that compile PO files into MO, script JSON and `.l10n.php` files. `make-json` maps sources with `--use-map` and removes JavaScript strings from the PO unless `--no-purge` is passed. | `i18n-mo`, `i18n-json` and `i18n-php` compile one translated PO at a time, never change it, and leave out fuzzy, obsolete and untranslated entries. `i18n-json` takes a many-to-many `--map` from source files to built scripts, and JSX and TypeScript sources need one, so catalogs are never written for files WordPress doesn't load. `--check` compares the outputs without writing. There's no `update-po`, so update PO files from the POT with gettext's `msgmerge` or a translation platform. |","table":"table-0"},"1056":{"id":"/js/wp-release/v0.18.2/comparison-7","page_id":"/js/wp-release/v0.18.2/comparison","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/comparison#comparison-with-existing-tools","content":"| Tool                         | What it does                                                                          | How `wp-release` differs                                                                                                                                                                                                                        |\n| ---------------------------- | ------------------------------------------------------------------------------------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `wp plugin verify-checksums` | WP-CLI command that checks installed plugins against the WordPress.org checksums API. | Reads the same manifest format, but from a file, so it also works for plugins and themes that aren't hosted on WordPress.org and for build directories in CI. `checksums` writes the manifest that WordPress.org generates for its own plugins. |","table":"table-0"},"1057":{"id":"/js/wp-release/v0.18.2/comparison-8","page_id":"/js/wp-release/v0.18.2/comparison","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/comparison#comparison-with-existing-tools","content":"| Tool                    | What it does                                                                                                                         | How `wp-release` differs                                                                                                                                                                                                                              |\n| ----------------------- | ------------------------------------------------------------------------------------------------------------------------------------ | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `wp-scripts plugin-zip` | Zips files from `package.json` `files` or a fixed allowlist, named after the npm package, with `--root-folder` / `--no-root-folder`. | Reuses the root folder flags, selects files with `.distignore` by default and can optionally honor Git `export-ignore` attributes, puts the version from the plugin headers in the filename and streams the archive instead of building it in memory. |","table":"table-0"},"1058":{"id":"/js/wp-release/v0.18.2/configuration","page_id":"/js/wp-release/v0.18.2/configuration","type":"page","content":"Configuration","breadcrumbs":["Docs","Js","Wp release","v0.18.2"],"tags":[],"url":"/js/wp-release/v0.18.2/configuration"},"1059":{"id":"/js/wp-release/v0.18.2/configuration-0","page_id":"/js/wp-release/v0.18.2/configuration","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2/configuration#naming-convention","content":"Naming convention"},"1060":{"id":"/js/wp-release/v0.18.2/configuration-1","page_id":"/js/wp-release/v0.18.2/configuration","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2/configuration#file-selection","content":"File selection"},"1061":{"id":"/js/wp-release/v0.18.2/configuration-2","page_id":"/js/wp-release/v0.18.2/configuration","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2/configuration#plugin-and-theme-headers","content":"Plugin and theme headers"},"1062":{"id":"/js/wp-release/v0.18.2/configuration-3","page_id":"/js/wp-release/v0.18.2/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/configuration#naming-convention","content":"`@wpelevator/wp-release` is the suite of release tools and `wp-release` is its CLI. \"Release\" is the whole workflow; each command is one operation in it. Commands are flat: a single word or dashed words like `version-check` and `deploy-svn`, without command groups or aliases. Each GitHub Action is named `wp-release-` followed by the command name, so the CLI command and the `uses:` name always match:"},"1063":{"id":"/js/wp-release/v0.18.2/configuration-4","page_id":"/js/wp-release/v0.18.2/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/configuration#naming-convention","content":"| Capability        | CLI command        | GitHub Action |\n| ----------------- | ------------------ | ------------- |\n| Build a directory | `wp-release build` |               |","table":"table-0"},"1064":{"id":"/js/wp-release/v0.18.2/configuration-5","page_id":"/js/wp-release/v0.18.2/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/configuration#naming-convention","content":"| Capability  | CLI command      | GitHub Action               |\n| ----------- | ---------------- | --------------------------- |\n| Build a ZIP | `wp-release zip` | `wpelevator/wp-release-zip` |","table":"table-0"},"1065":{"id":"/js/wp-release/v0.18.2/configuration-6","page_id":"/js/wp-release/v0.18.2/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/configuration#naming-convention","content":"| Capability                  | CLI command            | GitHub Action                     |\n| --------------------------- | ---------------------- | --------------------------------- |\n| Create a checksums manifest | `wp-release checksums` | `wpelevator/wp-release-checksums` |","table":"table-0"},"1066":{"id":"/js/wp-release/v0.18.2/configuration-7","page_id":"/js/wp-release/v0.18.2/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/configuration#naming-convention","content":"| Capability | CLI command       | GitHub Action                |\n| ---------- | ----------------- | ---------------------------- |\n| Sign files | `wp-release sign` | `wpelevator/wp-release-sign` |","table":"table-0"},"1067":{"id":"/js/wp-release/v0.18.2/configuration-8","page_id":"/js/wp-release/v0.18.2/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/configuration#naming-convention","content":"| Capability                      | CLI command         | GitHub Action |\n| ------------------------------- | ------------------- | ------------- |\n| Verify files against a manifest | `wp-release verify` |               |","table":"table-0"},"1068":{"id":"/js/wp-release/v0.18.2/configuration-9","page_id":"/js/wp-release/v0.18.2/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/configuration#naming-convention","content":"| Capability                    | CLI command                | GitHub Action |\n| ----------------------------- | -------------------------- | ------------- |\n| Check that the versions agree | `wp-release version-check` |               |","table":"table-0"},"1069":{"id":"/js/wp-release/v0.18.2/configuration-10","page_id":"/js/wp-release/v0.18.2/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/configuration#naming-convention","content":"| Capability                  | CLI command             | GitHub Action                      |\n| --------------------------- | ----------------------- | ---------------------------------- |\n| Deploy to WordPress.org SVN | `wp-release deploy-svn` | `wpelevator/wp-release-deploy-svn` |","table":"table-0"},"1070":{"id":"/js/wp-release/v0.18.2/configuration-11","page_id":"/js/wp-release/v0.18.2/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/configuration#naming-convention","content":"| Capability                 | CLI command             | GitHub Action |\n| -------------------------- | ----------------------- | ------------- |\n| Deploy to a Git repository | `wp-release deploy-git` |               |","table":"table-0"},"1071":{"id":"/js/wp-release/v0.18.2/configuration-12","page_id":"/js/wp-release/v0.18.2/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/configuration#naming-convention","content":"The names below are scoped to their commands. `--output` selects the primary artifact of each command; ZIP packaging uses `--checksums-file` for its accompanying manifest:"},"1072":{"id":"/js/wp-release/v0.18.2/configuration-13","page_id":"/js/wp-release/v0.18.2/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/configuration#naming-convention","content":"| Concept                   | CLI                                       | GitHub Action | Library     | Meaning                                                                           |\n| ------------------------- | ----------------------------------------- | ------------- | ----------- | --------------------------------------------------------------------------------- |\n| Plugin or theme directory | `<source-dir>` argument or `--source-dir` | `source-dir`  | `sourceDir` | Directory that a command reads, whether it's the repository or a build directory. |","table":"table-1"},"1073":{"id":"/js/wp-release/v0.18.2/configuration-14","page_id":"/js/wp-release/v0.18.2/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/configuration#naming-convention","content":"| Concept         | CLI                    | GitHub Action | Library     | Meaning                                                    |\n| --------------- | ---------------------- | ------------- | ----------- | ---------------------------------------------------------- |\n| Build directory | `build --output <dir>` | —             | `outputDir` | Directory written by `build`; files go directly inside it. |","table":"table-1"},"1074":{"id":"/js/wp-release/v0.18.2/configuration-15","page_id":"/js/wp-release/v0.18.2/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/configuration#naming-convention","content":"| Concept  | CLI                   | GitHub Action          | Library   | Meaning                                                           |\n| -------- | --------------------- | ---------------------- | --------- | ----------------------------------------------------------------- |\n| ZIP file | `zip --output <file>` | `output` in ZIP action | `zipPath` | Destination passed to `zipPackage()`; also returned as `zipPath`. |","table":"table-1"},"1075":{"id":"/js/wp-release/v0.18.2/configuration-16","page_id":"/js/wp-release/v0.18.2/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/configuration#naming-convention","content":"| Concept                   | CLI                         | GitHub Action                | Library                              | Meaning                                                                                                       |\n| ------------------------- | --------------------------- | ---------------------------- | ------------------------------------ | ------------------------------------------------------------------------------------------------------------- |\n| Standalone checksums file | `checksums --output <file>` | `output` in checksums action | first argument of `writeChecksums()` | Manifest destination relative to the working directory; the CLI returns its absolute path as `checksumsPath`. |","table":"table-1"},"1076":{"id":"/js/wp-release/v0.18.2/configuration-17","page_id":"/js/wp-release/v0.18.2/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/configuration#naming-convention","content":"| Concept                         | CLI                           | GitHub Action                  | Library         | Meaning                                                                             |\n| ------------------------------- | ----------------------------- | ------------------------------ | --------------- | ----------------------------------------------------------------------------------- |\n| Checksums filename when zipping | `zip --checksums-file <file>` | `checksums-file` in ZIP action | `checksumsFile` | Relative manifest filename beside the ZIP or inside its package root when embedded. |","table":"table-1"},"1077":{"id":"/js/wp-release/v0.18.2/configuration-18","page_id":"/js/wp-release/v0.18.2/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/configuration#naming-convention","content":"| Concept       | CLI                 | GitHub Action | Library   | Meaning                                 |\n| ------------- | ------------------- | ------------- | --------- | --------------------------------------- |\n| ZIP to deploy | `--from-zip <file>` | `from-zip`    | `fromZip` | Existing ZIP read as the deploy source. |","table":"table-1"},"1078":{"id":"/js/wp-release/v0.18.2/configuration-19","page_id":"/js/wp-release/v0.18.2/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/configuration#naming-convention","content":"| Concept            | CLI               | GitHub Action | Library  | Meaning                             |\n| ------------------ | ----------------- | ------------- | -------- | ----------------------------------- |\n| Git tag to compare | `--git-tag <tag>` |               | `gitTag` | Git tag checked by `version-check`. |","table":"table-1"},"1079":{"id":"/js/wp-release/v0.18.2/configuration-20","page_id":"/js/wp-release/v0.18.2/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/configuration#naming-convention","content":"| Concept           | CLI                   | GitHub Action | Library  | Meaning                                               |\n| ----------------- | --------------------- | ------------- | -------- | ----------------------------------------------------- |\n| SVN tag to create | `--svn-tag <version>` | `svn-tag`     | `svnTag` | Tag written by `deploy-svn`, distinct from a git tag. |","table":"table-1"},"1080":{"id":"/js/wp-release/v0.18.2/configuration-21","page_id":"/js/wp-release/v0.18.2/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/configuration#naming-convention","content":"| Concept        | CLI               | GitHub Action | Library  | Meaning             |\n| -------------- | ----------------- | ------------- | -------- | ------------------- |\n| SVN repository | `--svn-url <url>` | `svn-url`     | `svnUrl` | Deploy destination. |","table":"table-1"},"1081":{"id":"/js/wp-release/v0.18.2/configuration-22","page_id":"/js/wp-release/v0.18.2/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/configuration#naming-convention","content":"| Concept        | CLI               | GitHub Action | Library  | Meaning                                                                                                               |\n| -------------- | ----------------- | ------------- | -------- | --------------------------------------------------------------------------------------------------------------------- |\n| Git repository | `--git-url <url>` |               | `gitUrl` | Destination of `deploy-git`. Credentials come from git, like a token in the URL or an SSH key, and are never printed. |","table":"table-1"},"1082":{"id":"/js/wp-release/v0.18.2/configuration-23","page_id":"/js/wp-release/v0.18.2/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/configuration#naming-convention","content":"| Concept                      | CLI                               | GitHub Action | Library         | Meaning                                                                                                      |\n| ---------------------------- | --------------------------------- | ------------- | --------------- | ------------------------------------------------------------------------------------------------------------ |\n| Branch and tag to release to | `--branch <name>`, `--tag <name>` |               | `branch`, `tag` | Refs written by `deploy-git` in the Git repository, distinct from the git tag that `version-check` compares. |","table":"table-1"},"1083":{"id":"/js/wp-release/v0.18.2/configuration-24","page_id":"/js/wp-release/v0.18.2/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/configuration#naming-convention","content":"| Concept        | CLI                    | GitHub Action | Library       | Meaning                                                                                                                       |\n| -------------- | ---------------------- | ------------- | ------------- | ----------------------------------------------------------------------------------------------------------------------------- |\n| Source history | `--split-prefix <dir>` |               | `splitPrefix` | Directory of a monorepo package whose history, from `git subtree split`, becomes the source history of `deploy-git` releases. |","table":"table-1"},"1084":{"id":"/js/wp-release/v0.18.2/configuration-25","page_id":"/js/wp-release/v0.18.2/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/configuration#naming-convention","content":"| Concept         | CLI                                                                 | GitHub Action                  | Library                      | Meaning                                                                                                                                                    |\n| --------------- | ------------------------------------------------------------------- | ------------------------------ | ---------------------------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| SVN credentials | `--svn-username <name>`, `SVN_USERNAME` and `SVN_PASSWORD` env vars | `svn-username`, `svn-password` | `svnUsername`, `svnPassword` | Needed only to commit. There's no password flag, since it would show in the process list; the action inputs and library options fall back to the env vars. |","table":"table-1"},"1085":{"id":"/js/wp-release/v0.18.2/configuration-26","page_id":"/js/wp-release/v0.18.2/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/configuration#naming-convention","content":"| Concept    | CLI                                                | GitHub Action   | Library                                                   | Meaning                                                                                                                               |\n| ---------- | -------------------------------------------------- | --------------- | --------------------------------------------------------- | ------------------------------------------------------------------------------------------------------------------------------------- |\n| Log format | `--log-format <text\\|github>`, `--ci` for `github` | always `github` | `writer: new TextWriter()` or `new GitHubActionsWriter()` | How the log is printed: plain text, or GitHub Actions annotations and job summaries. Each name matches the start of its writer class. |","table":"table-1"},"1086":{"id":"/js/wp-release/v0.18.2/configuration-27","page_id":"/js/wp-release/v0.18.2/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/configuration#naming-convention","content":"| Concept        | CLI               | GitHub Action                              | Library      | Meaning                                                                                  |\n| -------------- | ----------------- | ------------------------------------------ | ------------ | ---------------------------------------------------------------------------------------- |\n| Release config | `--config <path>` | `config` in ZIP, checksums and SVN actions | `configFile` | Explicit JavaScript config path for package selection, integrity settings or deployment. |","table":"table-1"},"1087":{"id":"/js/wp-release/v0.18.2/configuration-28","page_id":"/js/wp-release/v0.18.2/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/configuration#naming-convention","content":"| Concept            | CLI                     | GitHub Action              | Library     | Meaning                                                 |\n| ------------------ | ----------------------- | -------------------------- | ----------- | ------------------------------------------------------- |\n| Release tag format | `--tag-format <format>` | `tag-format` in SVN action | `tagFormat` | How `release-ref` identifies a package and its version. |","table":"table-1"},"1088":{"id":"/js/wp-release/v0.18.2/configuration-29","page_id":"/js/wp-release/v0.18.2/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/configuration#naming-convention","content":"| Concept               | CLI                   | GitHub Action               | Library | Meaning                                                             |\n| --------------------- | --------------------- | --------------------------- | ------- | ------------------------------------------------------------------- |\n| Release ref to deploy | `--release-ref <ref>` | `release-ref` in SVN action | `ref`   | Read configured packages and deployment targets from a release ref. |","table":"table-1"},"1089":{"id":"/js/wp-release/v0.18.2/configuration-30","page_id":"/js/wp-release/v0.18.2/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/configuration#naming-convention","content":"| Concept     | CLI                   | GitHub Action           | Library  | Meaning                                                                                                                               |\n| ----------- | --------------------- | ----------------------- | -------- | ------------------------------------------------------------------------------------------------------------------------------------- |\n| Assets sync | `--no-assets` to skip | `assets: false` to skip | `assets` | Booleans are positive in the library and the action; `--no-assets` is only the CLI negation, never `noAssets` or a `no-assets` input. |","table":"table-1"},"1090":{"id":"/js/wp-release/v0.18.2/configuration-31","page_id":"/js/wp-release/v0.18.2/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/configuration#naming-convention","content":"CLI JSON results use camelCase keys like `zipPath`, and GitHub Action outputs use kebab-case like `zip-path`. The ZIP action supports `package` and `config`, the checksums action supports `config` for codec selection, and the SVN action supports `release-ref`, repeated `package` values as newline-separated input, `list`, `config` and `tag-format`."},"1091":{"id":"/js/wp-release/v0.18.2/configuration-32","page_id":"/js/wp-release/v0.18.2/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/configuration#naming-convention","content":"The ZIP CLI result uses `checksumsEmbedded` for the package-relative embedded manifest path. Its `signatures` array includes external absolute paths and embedded package-relative paths, while `checksumsSignatures` contains only manifest signatures. The ZIP action exposes those locations as `checksums-embedded`, `signatures` for external signatures, and `signatures-embedded` for embedded signatures, so asset uploads receive local files. With CLI `--github-output`, signature arrays remain in the JSON `result` output."},"1092":{"id":"/js/wp-release/v0.18.2/configuration-33","page_id":"/js/wp-release/v0.18.2/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/configuration#naming-convention","content":"Library classes are named after the capability (`SvnDeploy`, `Svn`, `GitDeploy`) without repeating \"release\"."},"1093":{"id":"/js/wp-release/v0.18.2/configuration-34","page_id":"/js/wp-release/v0.18.2/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/configuration#file-selection","content":"`build`, `zip`, `checksums`, `deploy-svn` and `deploy-git` select files the same way:"},"1094":{"id":"/js/wp-release/v0.18.2/configuration-35","page_id":"/js/wp-release/v0.18.2/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/configuration#file-selection","content":"| Option                | Description                                                                                                                    |\n| --------------------- | ------------------------------------------------------------------------------------------------------------------------------ |\n| `--distignore <file>` | Path to the ignore file. Defaults to `.distignore` in the source directory when present; an explicitly passed file must exist. |","table":"table-2"},"1095":{"id":"/js/wp-release/v0.18.2/configuration-36","page_id":"/js/wp-release/v0.18.2/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/configuration#file-selection","content":"| Option            | Description                 |\n| ----------------- | --------------------------- |\n| `--no-distignore` | Don't read any ignore file. |","table":"table-2"},"1096":{"id":"/js/wp-release/v0.18.2/configuration-37","page_id":"/js/wp-release/v0.18.2/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/configuration#file-selection","content":"| Option                 | Description                                                                                                                                                                                    |\n| ---------------------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `--exclude <patterns>` | Extra gitignore-style patterns, comma-separated or repeated, like `--exclude build/,assets/*,images/**/*`. They're applied after the ignore file, so a `!` pattern can also re-include a file. |","table":"table-2"},"1097":{"id":"/js/wp-release/v0.18.2/configuration-38","page_id":"/js/wp-release/v0.18.2/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/configuration#file-selection","content":"| Option                    | Description                                                                                                                                  |\n| ------------------------- | -------------------------------------------------------------------------------------------------------------------------------------------- |\n| `--exclude-gitattributes` | Also exclude paths marked `export-ignore` by Git attributes. This is opt-in and requires the source directory to be inside a Git repository. |","table":"table-2"},"1098":{"id":"/js/wp-release/v0.18.2/configuration-39","page_id":"/js/wp-release/v0.18.2/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/configuration#file-selection","content":"`.distignore` and `--exclude` use full gitignore syntax, including `!` negation. `--exclude-gitattributes` asks Git to evaluate `export-ignore` attributes, including nested `.gitattributes` files, then adds those paths to the exclusions. It is off by default, so releases don't unexpectedly depend on Git or change selection when a repository adds attributes. Git must be installed and the source directory must be inside a working tree; the flag is ignored by `deploy-svn --from-zip`, since the ZIP is already filtered. Version control metadata (`.git`, `.svn` and `.hg`, at any depth, including the `.git` files of worktrees and submodules) is always left out, also without an ignore file and when deploying from a ZIP, and no `!` pattern can re-include it. This keeps a repository's history out of ZIPs and deploys when the source directory is the repository root. The comma-separated `--exclude` list works like `--exclude` in `wp i18n make-pot`. Selected symbolic links are an error, since ZIP archives and WordPress.org SVN don't support them."},"1099":{"id":"/js/wp-release/v0.18.2/configuration-40","page_id":"/js/wp-release/v0.18.2/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/configuration#plugin-and-theme-headers","content":"The commands read the same headers as WordPress. The main plugin file is the top-level `.php` file with a `Plugin Name:` header in its first 8 KB, preferring `{slug}.php` when several files have one. A directory without a plugin file and with `Theme Name:` in `style.css` is a theme. The readme headers (`Stable tag`, `Tested up to`, …) come from `readme.txt`, or `readme.md` when there's no `readme.txt`."},"1100":{"id":"/js/wp-release/v0.18.2/configuration-41","page_id":"/js/wp-release/v0.18.2/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/configuration#plugin-and-theme-headers","content":"`--version` defaults to the `Version` header in `zip`, `checksums` and `version-check`, and `checksums --type` defaults to the detected package type."},"1101":{"id":"/js/wp-release/v0.18.2/deployment","page_id":"/js/wp-release/v0.18.2/deployment","type":"page","content":"Deployment","breadcrumbs":["Docs","Js","Wp release","v0.18.2"],"tags":[],"url":"/js/wp-release/v0.18.2/deployment"},"1102":{"id":"/js/wp-release/v0.18.2/deployment-0","page_id":"/js/wp-release/v0.18.2/deployment","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2/deployment#deploy-to-svn","content":"Deploy to SVN"},"1103":{"id":"/js/wp-release/v0.18.2/deployment-1","page_id":"/js/wp-release/v0.18.2/deployment","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2/deployment#deploy-to-git","content":"Deploy to Git"},"1104":{"id":"/js/wp-release/v0.18.2/deployment-2","page_id":"/js/wp-release/v0.18.2/deployment","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2/deployment#deploy-configured-packages","content":"Deploy configured packages"},"1105":{"id":"/js/wp-release/v0.18.2/deployment-3","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-to-svn","content":"The `wp-release-deploy-svn` GitHub Action runs this command."},"1106":{"id":"/js/wp-release/v0.18.2/deployment-4","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-to-svn","content":"`deploy-svn` syncs a plugin to the WordPress.org plugin SVN repository. Each SVN write is a separate flag and nothing is written unless requested. All writes go into one commit."},"1107":{"id":"/js/wp-release/v0.18.2/deployment-5","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-to-svn","content":"| Flag      | Default | Writes                                     |\n| --------- | ------- | ------------------------------------------ |\n| `--trunk` | off     | Sync the full source directory to `trunk/` |","table":"table-0"},"1108":{"id":"/js/wp-release/v0.18.2/deployment-6","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-to-svn","content":"| Flag            | Default | Writes                                                                                                                             |\n| --------------- | ------- | ---------------------------------------------------------------------------------------------------------------------------------- |\n| `--readme-only` | off     | Sync only the readme to `trunk/`, for updates between releases such as bumping `Tested up to`. Can't be combined with `--svn-tag`. |","table":"table-0"},"1109":{"id":"/js/wp-release/v0.18.2/deployment-7","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-to-svn","content":"| Flag                  | Default | Writes                                                                                                                                                                                                                                                        |\n| --------------------- | ------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `--svn-tag <version>` | off     | Create `tags/<version>`. With `--trunk`, the tag is a copy of the synced `trunk/`. Without it, the tag is built directly from the source files and `trunk/` is left alone, for pre-release tags. A leading `v` is stripped, so `v1.2.0` creates `tags/1.2.0`. |","table":"table-0"},"1110":{"id":"/js/wp-release/v0.18.2/deployment-8","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-to-svn","content":"| Flag                 | Default | Writes                                                                                                                                                                                 |\n| -------------------- | ------- | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `--assets-dir <dir>` | not set | Sync this directory with banners, icons and screenshots to the SVN `assets/` directory. There's no default directory, so assets are only deployed when this is set, and it must exist. |","table":"table-0"},"1111":{"id":"/js/wp-release/v0.18.2/deployment-9","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-to-svn","content":"| Flag          | Default | Writes                                                                                            |\n| ------------- | ------- | ------------------------------------------------------------------------------------------------- |\n| `--no-assets` |         | Skip the `--assets-dir` sync for one run, for example when a config always passes `--assets-dir`. |","table":"table-0"},"1112":{"id":"/js/wp-release/v0.18.2/deployment-10","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-to-svn","content":"Typical runs:"},"1113":{"id":"/js/wp-release/v0.18.2/deployment-11","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-to-svn","content":"How a deploy works:"},"1114":{"id":"/js/wp-release/v0.18.2/deployment-12","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-to-svn","content":"The options are validated, including the slug, version and readme name, before they're used in URLs or paths."},"1115":{"id":"/js/wp-release/v0.18.2/deployment-13","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-to-svn","content":"With `--trunk` or `--svn-tag`, the files must be a plugin whose `Version` header matches the version. When `--trunk` and `--svn-tag` are combined, the readme `Stable tag` must match too; a tag-only run skips that, since a pre-release tag doesn't change the stable tag. `--readme-only` needs the readme. Nothing is checked out when a check fails."},"1116":{"id":"/js/wp-release/v0.18.2/deployment-14","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-to-svn","content":"The repository is checked out sparsely into a new temporary directory, with only the directories that the flags write to. A missing `assets/` (or `trunk/`, `tags/`) directory is created. The deploy stops when `tags/<version>` exists, unless `--force` replaces it."},"1117":{"id":"/js/wp-release/v0.18.2/deployment-15","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-to-svn","content":"The files are synced in Node.js, without `rsync`: new and changed files are copied, files that are no longer selected are deleted, and `svn add` and `svn delete` stage them, including files that svn ignores by default. With `--trunk`, `trunk/` is then copied to the tag with `svn copy`. Without it, the same selected files are synced into `tags/<version>` instead, and with `--force` an existing tag is updated to match, deleting files that are no longer in the build."},"1118":{"id":"/js/wp-release/v0.18.2/deployment-16","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-to-svn","content":"Asset images get `svn:mime-type` set for PNG, JPEG, GIF and SVG, the formats that WordPress.org documents for plugin assets. Other formats keep the type that svn assigns."},"1119":{"id":"/js/wp-release/v0.18.2/deployment-17","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-to-svn","content":"When `svn status` is empty, the deploy ends without a commit. A dry run logs the status and stops before the commit. Otherwise the changes are committed, and the temporary directory is always removed."},"1120":{"id":"/js/wp-release/v0.18.2/deployment-18","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-to-svn","content":"`--from-zip` reads the files from a ZIP instead of `<source-dir>`. The ZIP is checked before it's extracted: entries with absolute paths, `..` segments or symbolic links, and entries outside a single `{slug}/` root folder, are rejected."},"1121":{"id":"/js/wp-release/v0.18.2/deployment-19","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-to-svn","content":"Credentials are only needed for the commit, not for dry runs, no-op runs or `file://` repositories. Pass the username with `--svn-username` or `SVN_USERNAME` and the password in `SVN_PASSWORD`. svn always runs non-interactively without caching credentials, and the password is passed on the standard input with `--password-from-stdin`, never on the command line or in the logs."},"1122":{"id":"/js/wp-release/v0.18.2/deployment-20","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-to-svn","content":"Validation:"},"1123":{"id":"/js/wp-release/v0.18.2/deployment-21","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-to-svn","content":"`--readme-only` can't be combined with `--svn-tag`, since a tag is a release snapshot that a readme update never changes."},"1124":{"id":"/js/wp-release/v0.18.2/deployment-22","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-to-svn","content":"`--version` defaults to `--svn-tag`, then the `Version` header of the deployed files; when `--version` and `--svn-tag` are both set they must match."},"1125":{"id":"/js/wp-release/v0.18.2/deployment-23","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-to-svn","content":"Pre-release versions like `1.0.0-rc.1` can be tagged, but syncing one to `trunk/` warns, since trunk is for the development version."},"1126":{"id":"/js/wp-release/v0.18.2/deployment-24","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-to-svn","content":"`--trunk` without `--svn-tag` works but warns, to remind you that updating trunk alone doesn't create a version tag for stable downloads."},"1127":{"id":"/js/wp-release/v0.18.2/deployment-25","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-to-svn","content":"A version mismatch throws a `VersionMismatchError`, a `ValidationError` with the `mismatches` and a problem for each, with its file and line. See Logging."},"1128":{"id":"/js/wp-release/v0.18.2/deployment-26","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-to-git","content":"`deploy-git` deploys the selected files of a plugin, theme or package to a Git repository, like a distribution repository that ships the built files and `vendor/` for Composer installs or GitHub-hosted updates, or the release repository of a monorepo package. It selects files like `zip`, with `.distignore` and `--exclude`, so built files that git ignores in the source repository, like `build/` or `vendor/`, are released too. The source directory must be inside a Git repository, which provides the source history and stores the release objects before they're pushed."},"1129":{"id":"/js/wp-release/v0.18.2/deployment-27","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-to-git","content":"| Flag              | Default | Writes                          |\n| ----------------- | ------- | ------------------------------- |\n| `--branch <name>` | off     | Push the release to this branch |","table":"table-1"},"1130":{"id":"/js/wp-release/v0.18.2/deployment-28","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-to-git","content":"| Flag           | Default | Writes                          |\n| -------------- | ------- | ------------------------------- |\n| `--tag <name>` | off     | Create this tag for the release |","table":"table-1"},"1131":{"id":"/js/wp-release/v0.18.2/deployment-29","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-to-git","content":"How a deploy works:"},"1132":{"id":"/js/wp-release/v0.18.2/deployment-30","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-to-git","content":"The selected files are written to the object database of the source repository and become a tree, with a temporary index, so the working tree and the index of the repository are left alone. Executable files stay executable."},"1133":{"id":"/js/wp-release/v0.18.2/deployment-31","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-to-git","content":"The previous release is fetched: the tip of `--branch`, or for a tag-only deploy the tip of the repository's default branch (its `HEAD`), whatever that branch holds. Release a tag together with `--branch` to choose the branch it builds on."},"1134":{"id":"/js/wp-release/v0.18.2/deployment-32","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-to-git","content":"When the files are the same as in the previous release, that release is reused. Otherwise a release commit is created with the files, whose parents are the previous release and the source history: the source commit (`--source-ref`, default `HEAD`), or with `--split-prefix` the history of that directory from `git subtree split`. The repository keeps the source history, and `git log --first-parent` lists the releases."},"1135":{"id":"/js/wp-release/v0.18.2/deployment-33","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-to-git","content":"When the previous release on `--branch` already has newer source history, the branch isn't moved, so running an older build again, like a re-run of an earlier CI job, can't release older files. The source history is outdated when it's an older commit of the source history that the previous release was made from, its last parent. `git subtree split` makes this reliable for `--split-prefix` too, since it creates the same commits for the same history. A revert is a new commit, so it's released, and with `--tag` the tag of an older build is still released, without moving the branch."},"1136":{"id":"/js/wp-release/v0.18.2/deployment-34","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-to-git","content":"The tag is checked in the repository first. A tag that already has the same files is the release: it's reused and nothing is pushed, so running a tag release again is a no-op. A tag with other files fails with exit code `2` before anything is pushed."},"1137":{"id":"/js/wp-release/v0.18.2/deployment-35","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-to-git","content":"The release is pushed to the branch, unless it didn't change or is outdated, and to the tag, in one atomic push. Pushes are never forced, so the branch only moves forward and a tag is never replaced, also when it was created in the meantime."},"1138":{"id":"/js/wp-release/v0.18.2/deployment-36","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-to-git","content":"To release a tag again, for example after a release with the wrong files, delete the tag in the repository (`git push <url> :refs/tags/<tag>`) and run the deploy again. There's no flag for replacing a tag, since installs, Composer and GitHub Actions pins trust that a published tag doesn't change."},"1139":{"id":"/js/wp-release/v0.18.2/deployment-37","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-to-git","content":"`--dry-run` runs everything except the push. `--message` sets the commit message, which defaults to `Release <tag or branch> from <source commit>`. Credentials come from git, like a credential helper or an SSH key, and credentials in URLs are never printed. For an HTTPS repository on `github.com`, or on the host of `GITHUB_SERVER_URL` like GitHub Enterprise Server, the `GITHUB_TOKEN` environment variable is sent as an authorization header, like `actions/checkout` does, so the token stays out of the URL, the git arguments and the repository config, and it replaces the header that `actions/checkout` persists. Pass `token` to `resolveGitDeployOptions()` for another HTTPS host. The commit needs a git identity (`user.name` and `user.email`)."},"1140":{"id":"/js/wp-release/v0.18.2/deployment-38","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-configured-packages","content":"`deploy-git --release-ref <ref>` and `deploy-svn --release-ref <ref>` deploy the packages of a monorepo, or of a single-package repository, to the targets in the `deploy` config of their package groups, like the release repository of each package or its WordPress.org plugin. The ref decides what's deployed: a release tag of a package, like `refs/tags/plugins/alpha/1.2.0` read with the `tagFormat`, deploys that package and version, and a branch, like `refs/heads/main`, deploys every package with a target for that branch. A name without `refs/` is a release tag when it matches the tag format of a package, otherwise a branch, and in GitHub Actions `$GITHUB_REF` is the pushed ref."},"1141":{"id":"/js/wp-release/v0.18.2/deployment-39","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-configured-packages","content":"| Mode | Command                          | Use                                                                                                                                                                                           |\n| ---- | -------------------------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| All  | `deploy-git --release-ref <ref>` | Deploy every package of the ref to each of its targets, one at a time, in one log group for each package. A failed deploy doesn't stop the others, and the command exits with `1` at the end. |","table":"table-2"},"1142":{"id":"/js/wp-release/v0.18.2/deployment-40","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-configured-packages","content":"| Mode        | Command                                           | Use                                                                                                                                                       |\n| ----------- | ------------------------------------------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| One package | `deploy-git --release-ref <ref> --package <name>` | Deploy only that package (repeatable), by identifier or path, for example to retry a failed one or in a CI job for each package with its own credentials. |","table":"table-2"},"1143":{"id":"/js/wp-release/v0.18.2/deployment-41","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-configured-packages","content":"| Mode | Command                                 | Use                                                                                                                                                                                                                                                                                             |\n| ---- | --------------------------------------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| Plan | `deploy-git --release-ref <ref> --list` | List the deploys without running them, with each package, its version or branch and the targets with the tag or branch they get. With `--json` or `--github-output` the result is `{ packages: [ … ] }`, for a CI matrix with `include: ${{ fromJSON( steps.plan.outputs.result ).packages }}`. |","table":"table-2"},"1144":{"id":"/js/wp-release/v0.18.2/deployment-42","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-configured-packages","content":"| Mode             | Command                                      | Use                                                        |\n| ---------------- | -------------------------------------------- | ---------------------------------------------------------- |\n| Single directory | `deploy-git <dir> --git-url <url> [options]` | Deploy one directory without a config, as described above. |","table":"table-2"},"1145":{"id":"/js/wp-release/v0.18.2/deployment-43","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-configured-packages","content":"`deploy-svn` has the same modes. `--release-ref` can't be combined with the options of a single target, like `--git-url`, `--tag` or `--svn-tag`, which come from the config."},"1146":{"id":"/js/wp-release/v0.18.2/deployment-44","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-configured-packages","content":"**Git targets** take a `repository` and release both branches and tags by default. `branches` limits the branches, like `[ 'main' ]`, or turns them off with `false`, and `tag` is the tag template in the repository, `{version}` by default, or `false` to not release tags. A release tag is created on top of the default branch of the repository, and a branch is released to the same branch. `history: false` uses the source commit instead of the package history from `git subtree split`, and `message` sets the release commit message, `Release {ref} from {revision}` by default."},"1147":{"id":"/js/wp-release/v0.18.2/deployment-45","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-configured-packages","content":"**SVN targets** only deploy release tags: a stable release syncs `trunk/`, creates its tag and syncs the `assetsDir`, and a pre-release only creates its tag. `slug`, the WordPress.org plugin slug, defaults to the name of the package directory, `url` to the WordPress.org plugin repository, and `message` sets the commit message. Credentials come from `SVN_USERNAME` and `SVN_PASSWORD`, or `--svn-username`."},"1148":{"id":"/js/wp-release/v0.18.2/deployment-46","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-configured-packages","content":"**Several targets**: `git` and `svn` each take one target or a list, like a release repository and a mirror on another host. Each target is a separate deploy."},"1149":{"id":"/js/wp-release/v0.18.2/deployment-47","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-configured-packages","content":"**Credentials**: a GitHub repository URL needs no token in it, since `GITHUB_TOKEN` is sent as an authorization header (see above). A callback can still add credentials for other hosts."},"1150":{"id":"/js/wp-release/v0.18.2/deployment-48","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-configured-packages","content":"**Templates and callbacks**: `repository`, `slug` and `message` are templates with `{name}` and `{path}`, like the `tagFormat`, and `{version}`, `{branch}`, `{ref}` (the tag or branch that the deploy writes in the target) and `{revision}` (the source commit), or callbacks that receive `{ package, version, branch, ref, revision }`, where `package` has the `name`, `directory`, `path` and `type`. A callback can name a target after the package directory, choose another host for some packages, read the environment, or return nothing to skip the target for that package or ref; an empty `message` uses the default one. Credentials in URLs are never printed or listed."},"1151":{"id":"/js/wp-release/v0.18.2/deployment-49","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-configured-packages","content":"**Results**: with `--json` or `--github-output`, the result lists each deploy in `deploys` with its `package`, `label`, `target` (the repository or WordPress.org plugin, with credentials redacted), `targetRef` (the tag or branch written there), `version` or `branch`, and its `result` or `error`. A remote target repository also has its `targetHost`, like `github.com`, and `targetPath`, like `me/my-plugin`, without credentials, for a workflow step that calls the API of the forge that hosts it, such as to create the release of the deployed tag. The targets of `--list` have the same `host` and `path`, and `parseRepositoryUrl()` reads them from an HTTP(S), SSH or scp-like URL. `wp-release` doesn't call forge APIs itself."},"1152":{"id":"/js/wp-release/v0.18.2/deployment-50","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-configured-packages","content":"**Packages without a version**: a package entry without `version`, like a single directory with a `glob` of its path, isn't released with changesets, so changes to it don't need one, and it only deploys branches, since it has no release tags."},"1153":{"id":"/js/wp-release/v0.18.2/deployment-51","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-configured-packages","content":"**Files**: `files.exclude` adds gitignore-style patterns relative to the package directory, and `files.distignore` sets the ignore file relative to it or turns it off with `false`. A `files` at the root of the config applies to every package group, for the rules that all packages share, and the `files` of a group add their patterns after it and can replace its ignore file. Without `files`, each package's `.distignore` applies, like for `zip`; there's no repository-wide `.distignore`, since each one is relative to its package. `zip --package <name>` zips a package with the same files, `getPackageFiles()` returns the directory and the file selection of any configured package, and `getDeployPackages()` lists the packages with deploy targets and their file selection."},"1154":{"id":"/js/wp-release/v0.18.2/deployment-52","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-configured-packages","content":"A deploy releases the files of the working tree, so build the packages first. One job that builds once and runs `deploy-git --release-ref \"$GITHUB_REF\"` is the simplest setup, also for a branch that releases every package. A matrix with a job for each package from `--list` would build every package in every job, so build once and pass the built tree to the jobs as an artifact if you need one, for example for separate credentials."},"1155":{"id":"/js/wp-release/v0.18.2/deployment-53","page_id":"/js/wp-release/v0.18.2/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/deployment#deploy-configured-packages","content":"Other monorepo tools split the same way with less of the release in the config: splitsh-lite, Symplify MonorepoBuilder and `danharrin/monorepo-split-github-action` push the source history of each package directory, with the packages and repositories listed in the workflow or a matrix, while `deploy-git` releases the built files on top of that history, so `vendor/` and `build/` reach Composer and WordPress installs. Like the publishers of GoReleaser, targets are lists with templates, and pre-releases skip the targets where they would replace the stable version."},"1156":{"id":"/js/wp-release/v0.18.2/development","page_id":"/js/wp-release/v0.18.2/development","type":"page","content":"Development","breadcrumbs":["Docs","Js","Wp release","v0.18.2"],"tags":[],"url":"/js/wp-release/v0.18.2/development"},"1157":{"id":"/js/wp-release/v0.18.2/development-0","page_id":"/js/wp-release/v0.18.2/development","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2/development#development","content":"Development"},"1158":{"id":"/js/wp-release/v0.18.2/development-1","page_id":"/js/wp-release/v0.18.2/development","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2/development#architecture","content":"Architecture"},"1159":{"id":"/js/wp-release/v0.18.2/development-2","page_id":"/js/wp-release/v0.18.2/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/development#development","content":"The source is TypeScript in `src/`, with tests next to the files they test (`*.test.ts`). The published package contains only the compiled `dist/` with JavaScript and `.d.ts` files; tests and translation fixtures stay in the repository."},"1160":{"id":"/js/wp-release/v0.18.2/development-3","page_id":"/js/wp-release/v0.18.2/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/development#development","content":"`build` compiles `src/` to `dist/` with `tsc`, leaving out the tests."},"1161":{"id":"/js/wp-release/v0.18.2/development-4","page_id":"/js/wp-release/v0.18.2/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/development#development","content":"`test` runs the `.ts` tests directly with `node --test`, using Node.js type stripping, so it needs Node.js 22.18 or later but no build. The SVN integration tests in `svn-deploy.integration.test.ts` create repositories with `svnadmin` and deploy to their `file://` URLs; they're skipped when `svn` or `svnadmin` isn't installed."},"1162":{"id":"/js/wp-release/v0.18.2/development-5","page_id":"/js/wp-release/v0.18.2/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/development#development","content":"`lint` runs ESLint and a `tsc` type check."},"1163":{"id":"/js/wp-release/v0.18.2/development-6","page_id":"/js/wp-release/v0.18.2/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/development#development","content":"The i18n tests in `@wpelevator/wp-gettext` validate gettext round trips, script catalogs and generated PHP data without launching PHP, WP-CLI or WordPress, covering contexts, plural forms, comments, flags, Unicode, escaping and PHP-looking input as data."},"1164":{"id":"/js/wp-release/v0.18.2/development-7","page_id":"/js/wp-release/v0.18.2/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/development#development","content":"The `wpelevator-source` export condition points at `src/index.ts`. The wp-release tests and monorepo CLI scripts use it to work with the source instead of a `dist/` build. Action builds use the declared dependency's default export, which resolves to `dist/` for the workspace copy and the published package. Build wp-release before building the actions."},"1165":{"id":"/js/wp-release/v0.18.2/development-8","page_id":"/js/wp-release/v0.18.2/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/development#development","content":"`execute( 'deploy-svn', args, { cwd, logger, svnRunner } )` runs a single-plugin deployment or a configured plan or deployment. The optional `svnRunner` replaces the external command runner in both modes; without it, the command uses its normal runner."},"1166":{"id":"/js/wp-release/v0.18.2/development-9","page_id":"/js/wp-release/v0.18.2/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/development#architecture","content":"wp-release has two layers, so that it fits any repository layout:"},"1167":{"id":"/js/wp-release/v0.18.2/development-10","page_id":"/js/wp-release/v0.18.2/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/development#architecture","content":"**Primitives** work on the directory, file or values they're given and know nothing about the repository: `build <dir>`, `zip <dir>`, `checksums`, `sign`, `verify`, `version-check`, `deploy-git <dir>`, `deploy-svn <dir>`, `i18n-pot <dir>`, `i18n-audit <dir>` and the `i18n-mo`, `i18n-json` and `i18n-php` compilers."},"1168":{"id":"/js/wp-release/v0.18.2/development-11","page_id":"/js/wp-release/v0.18.2/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/development#architecture","content":"**The config layer** reads `wp-release.config.js` for everything about the repository: where packages are (`root` and the package globs), how their versions and tags are named (`version`, `tagFormat`), which files they ship (`files`), how their translations are extracted (`i18n`), where they deploy (`deploy`) and the git `remote`. The changeset commands (with a single-project fallback when no config exists), `deploy-git` and `deploy-svn --release-ref`, `build --package` and `zip --package`, and `i18n-pot` and `i18n-audit` with `--package` or `--all` belong to it, and the global `--config` and `--tag-format` options select or adjust the config. `zip` and `checksums` also read caller configuration for integrity settings even without `--package`; verification reads it only when explicitly selected. Only `--release-ref` reads which package and version a ref releases. A primitive with a config mode, like `deploy-git --release-ref` beside `deploy-git <dir>` or `zip --package` beside `zip <dir>`, only takes the package directory, its files and its targets from the config there, and otherwise works the same."},"1169":{"id":"/js/wp-release/v0.18.2/development-12","page_id":"/js/wp-release/v0.18.2/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/development#architecture","content":"Configured repositories use the layout and naming conventions their config sets. Config-free changeset releases use the root-only detection and defaults described above."},"1170":{"id":"/js/wp-release/v0.18.2/development-13","page_id":"/js/wp-release/v0.18.2/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/development#architecture","content":"The GitHub Actions are adapters to these commands: they use the same flag names and `execute()` entry point, with secrets supplied through environment variables. The SVN action injects a command runner that checks or installs SVN only when a deployment runs its first SVN command; config planning and deployment behavior remain in `wp-release`."},"1171":{"id":"/js/wp-release/v0.18.2/development-14","page_id":"/js/wp-release/v0.18.2/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/development#architecture","content":"The package uses ES modules as its unit of encapsulation, like most Node.js CLI tools: a module exports a few functions and keeps its helpers private, so there's no class to wrap them in. A class is used only when it holds state across steps or binds dependencies, so that callers and tests can replace them:"},"1172":{"id":"/js/wp-release/v0.18.2/development-15","page_id":"/js/wp-release/v0.18.2/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/development#architecture","content":"**Workflows with steps** are classes, so that their steps share state and dependencies on the instance: `SvnDeploy` shares the temporary working copy across `prepare()`, `checkout()`, `sync()` and `commit()`, `GitDeploy` binds the options and the git runner to its steps, and `ChangesetRelease` binds the repository and the runners to `add()`, `version()` and `tag()`."},"1173":{"id":"/js/wp-release/v0.18.2/development-16","page_id":"/js/wp-release/v0.18.2/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/development#architecture","content":"**External commands** run through injectable runners: `createSvnRunner()` and `createGitRunner()` return functions that spawn the binary without a shell. The classes take a runner as an option and create the default one when it's missing, so tests pass a fake runner, or one that wraps the real runner and records some commands, instead of putting fake binaries on the `PATH`. The `Svn` and `ReleaseRepository` classes wrap a runner with the commands of their domain."},"1174":{"id":"/js/wp-release/v0.18.2/development-17","page_id":"/js/wp-release/v0.18.2/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/development#architecture","content":"**Domain logic** is plain functions that take their dependencies as arguments, like `discoverPackages( repository, config )`, so that each one can be tested on its own."},"1175":{"id":"/js/wp-release/v0.18.2/development-18","page_id":"/js/wp-release/v0.18.2/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/development#architecture","content":"**Commands** in `src/commands/` parse the CLI options and call the library, and `cli.ts` handles the global options, logging and exit codes. Errors carry their exit code, like `ValidationError` with `2`. Signing lives in `@wpelevator/signatures`, which throws errors with a `code`; `src/signing.ts` wraps it to read `WP_RELEASE_SIGNING_KEY` and to report those errors as `ValidationError`. ZIP archives live in `@wpelevator/zip` in the same way: `src/zip.ts` and `src/unzip.ts` adapt its entries and `zipPath` inputs and report its `ZipError` as `ValidationError`, with the `--force` hint for an existing archive. File selection and syncing live in `@wpelevator/fileset` and checksums in `@wpelevator/checksums`, which throw errors with a `code` in the same way: `src/file-selection.ts`, `src/sync.ts` and `src/checksums.ts` wrap them to report those errors as `ValidationError`, to build the manifest metadata from the plugin or theme slug and version, to select the files from the rules before hashing, and to pass the Git `export-ignore` lister to the fileset package. `src/integrity.ts` wraps the manifest codecs of the checksums package in the same way."},"1176":{"id":"/js/wp-release/v0.18.2/development-19","page_id":"/js/wp-release/v0.18.2/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/development#architecture","content":"Constructors only store their options. Work starts in a method call."},"1177":{"id":"/js/wp-release/v0.18.2/development-20","page_id":"/js/wp-release/v0.18.2/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/development#architecture","content":"The changeset release modules, from the entry point down:"},"1178":{"id":"/js/wp-release/v0.18.2/development-21","page_id":"/js/wp-release/v0.18.2/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/development#architecture","content":"| Module                 | Responsibility                                                                                                                              |\n| ---------------------- | ------------------------------------------------------------------------------------------------------------------------------------------- |\n| `changeset-release.ts` | `ChangesetRelease`, which plans releases and runs `add()`, `getStatus()`, `version()` and `tag()`, and the function form of each operation. |","table":"table-0"},"1179":{"id":"/js/wp-release/v0.18.2/development-22","page_id":"/js/wp-release/v0.18.2/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/development#architecture","content":"| Module              | Responsibility                                                                                       |\n| ------------------- | ---------------------------------------------------------------------------------------------------- |\n| `single-project.ts` | Resolving the config-free root project, its version source and targets, and shared release settings. |","table":"table-0"},"1180":{"id":"/js/wp-release/v0.18.2/development-23","page_id":"/js/wp-release/v0.18.2/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/development#architecture","content":"| Module                | Responsibility                                                                            |\n| --------------------- | ----------------------------------------------------------------------------------------- |\n| `changeset-config.ts` | Loading and validating `wp-release.config.js`, and the version source and target helpers. |","table":"table-0"},"1181":{"id":"/js/wp-release/v0.18.2/development-24","page_id":"/js/wp-release/v0.18.2/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/development#architecture","content":"| Module                  | Responsibility                                                                                             |\n| ----------------------- | ---------------------------------------------------------------------------------------------------------- |\n| `changeset-packages.ts` | Discovering the packages of the configured globs, with or without a version, and finding the changed ones. |","table":"table-0"},"1182":{"id":"/js/wp-release/v0.18.2/development-25","page_id":"/js/wp-release/v0.18.2/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/development#architecture","content":"| Module               | Responsibility                                  |\n| -------------------- | ----------------------------------------------- |\n| `changeset-files.ts` | Reading, writing and consuming changeset files. |","table":"table-0"},"1183":{"id":"/js/wp-release/v0.18.2/development-26","page_id":"/js/wp-release/v0.18.2/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/development#architecture","content":"| Module                    | Responsibility                                                                                             |\n| ------------------------- | ---------------------------------------------------------------------------------------------------------- |\n| `changeset-dependents.ts` | The dependents policy: which packages re-release with their sources, and rewriting their dependency specs. |","table":"table-0"},"1184":{"id":"/js/wp-release/v0.18.2/development-27","page_id":"/js/wp-release/v0.18.2/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/development#architecture","content":"| Module          | Responsibility                                            |\n| --------------- | --------------------------------------------------------- |\n| `changesets.ts` | Parsing and formatting changesets, and the release types. |","table":"table-0"},"1185":{"id":"/js/wp-release/v0.18.2/development-28","page_id":"/js/wp-release/v0.18.2/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/development#architecture","content":"| Module             | Responsibility                                                                 |\n| ------------------ | ------------------------------------------------------------------------------ |\n| `version-files.ts` | Reading and writing versions in manifests, headers, readmes and PHP constants. |","table":"table-0"},"1186":{"id":"/js/wp-release/v0.18.2/development-29","page_id":"/js/wp-release/v0.18.2/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/development#architecture","content":"| Module         | Responsibility                                                           |\n| -------------- | ------------------------------------------------------------------------ |\n| `changelog.ts` | Changelog entries, and the `CHANGELOG.md` and readme changelog sections. |","table":"table-0"},"1187":{"id":"/js/wp-release/v0.18.2/development-30","page_id":"/js/wp-release/v0.18.2/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/development#architecture","content":"| Module            | Responsibility                                                                      |\n| ----------------- | ----------------------------------------------------------------------------------- |\n| `release-tags.ts` | Choosing the version and previous tag of a release, and building its release notes. |","table":"table-0"},"1188":{"id":"/js/wp-release/v0.18.2/development-31","page_id":"/js/wp-release/v0.18.2/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/development#architecture","content":"| Module          | Responsibility                            |\n| --------------- | ----------------------------------------- |\n| `tag-format.ts` | Formatting tag names from the tag format. |","table":"table-0"},"1189":{"id":"/js/wp-release/v0.18.2/development-32","page_id":"/js/wp-release/v0.18.2/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/development#architecture","content":"| Module              | Responsibility                                                                                                                                                                                   |\n| ------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `package-deploy.ts` | Resolving the configured deploys of a ref: the released packages, their targets and file selections, for `deploy-git` and `deploy-svn`, and the file selection of a package for `zip --package`. |","table":"table-0"},"1190":{"id":"/js/wp-release/v0.18.2/development-33","page_id":"/js/wp-release/v0.18.2/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/development#architecture","content":"| Module           | Responsibility                                                                                                                      |\n| ---------------- | ----------------------------------------------------------------------------------------------------------------------------------- |\n| `package-zip.ts` | `zipPackage()`, the ZIP and checksums manifest of the selected files of a package, for `zip` and the snapshot builds of a monorepo. |","table":"table-0"},"1191":{"id":"/js/wp-release/v0.18.2/development-34","page_id":"/js/wp-release/v0.18.2/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/development#architecture","content":"| Module                  | Responsibility                                                                       |\n| ----------------------- | ------------------------------------------------------------------------------------ |\n| `release-repository.ts` | `ReleaseRepository`, the git commands of a release: tags, commits and changed files. |","table":"table-0"},"1192":{"id":"/js/wp-release/v0.18.2/development-35","page_id":"/js/wp-release/v0.18.2/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/development#architecture","content":"| Module            | Responsibility                                                                     |\n| ----------------- | ---------------------------------------------------------------------------------- |\n| `file-journal.ts` | `FileJournal`, which restores every file a failed `changeset-version` run changed. |","table":"table-0"},"1193":{"id":"/js/wp-release/v0.18.2/development-36","page_id":"/js/wp-release/v0.18.2/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/development#architecture","content":"| Module        | Responsibility                        |\n| ------------- | ------------------------------------- |\n| `versions.ts` | Version checks and SemVer precedence. |","table":"table-0"},"1194":{"id":"/js/wp-release/v0.18.2/development-37","page_id":"/js/wp-release/v0.18.2/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/development#architecture","content":"The internationalization modules in `src/i18n/` adapt the standalone `@wpelevator/wp-gettext` package, which owns extraction, catalogs, POT, PO, MO, script JSON, `.l10n.php` and audits:"},"1195":{"id":"/js/wp-release/v0.18.2/development-38","page_id":"/js/wp-release/v0.18.2/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/development#architecture","content":"| Module        | Responsibility                                                                                                                              |\n| ------------- | ------------------------------------------------------------------------------------------------------------------------------------------- |\n| `packages.ts` | `resolveI18nPackages()`, the config adapter that selects a directory, one package or all packages and resolves their options and POT paths. |","table":"table-1"},"1196":{"id":"/js/wp-release/v0.18.2/development-39","page_id":"/js/wp-release/v0.18.2/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/development#architecture","content":"| Module        | Responsibility                                                                                                                                                                                                                                         |\n| ------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `generate.ts` | `extractCatalog()`, `generatePackagePot()`, `resolvePotPath()` and `validatePotDestinations()`, which read the headers of the main file with `package-meta.ts` and pass them as `meta` to the generate functions of `@wpelevator/wp-gettext/generate`. |","table":"table-1"},"1197":{"id":"/js/wp-release/v0.18.2/development-40","page_id":"/js/wp-release/v0.18.2/development","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/development#architecture","content":"| Module       | Responsibility                                                                                                                                     |\n| ------------ | -------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `gettext.ts` | The other functions of `@wpelevator/wp-gettext`, with their `GettextError` reported as a `ValidationError` with the original error as its `cause`. |","table":"table-1"},"1198":{"id":"/js/wp-release/v0.18.2","page_id":"/js/wp-release/v0.18.2","type":"page","content":"WP Release","breadcrumbs":["Docs","Js","Wp release","v0.18.2"],"tags":[],"url":"/js/wp-release/v0.18.2"},"1199":{"id":"/js/wp-release/v0.18.2-0","page_id":"/js/wp-release/v0.18.2","tags":[],"type":"text","url":"/js/wp-release/v0.18.2","content":"Build and release WordPress plugins, themes, and packages."},"1200":{"id":"/js/wp-release/v0.18.2-1","page_id":"/js/wp-release/v0.18.2","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2#install","content":"Install"},"1201":{"id":"/js/wp-release/v0.18.2-2","page_id":"/js/wp-release/v0.18.2","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2#start-with-the-cli","content":"Start with the CLI"},"1202":{"id":"/js/wp-release/v0.18.2-3","page_id":"/js/wp-release/v0.18.2","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2#guides","content":"Guides"},"1203":{"id":"/js/wp-release/v0.18.2-4","page_id":"/js/wp-release/v0.18.2","tags":[],"type":"text","url":"/js/wp-release/v0.18.2","content":"`@wpelevator/wp-release` provides a CLI and library for building release directories and ZIPs, creating checksums and signatures, checking versions, extracting and compiling translations, and deploying to WordPress.org SVN or Git repositories."},"1204":{"id":"/js/wp-release/v0.18.2-5","page_id":"/js/wp-release/v0.18.2","tags":[],"type":"text","url":"/js/wp-release/v0.18.2","content":"The `wp-release-zip`, `wp-release-checksums`, `wp-release-sign`, and `wp-release-deploy-svn` GitHub Actions expose the same commands in workflows."},"1205":{"id":"/js/wp-release/v0.18.2-6","page_id":"/js/wp-release/v0.18.2","tags":[],"type":"text","url":"/js/wp-release/v0.18.2","content":"For projects that don't use Node.js or JavaScript tooling, PHP Changesets (`wpelevator/php-changesets`) runs the same changeset release workflow with PHP and Git alone: `changeset add`, `status`, `version` and `tag` read the same changeset files and match the options of the `changeset-*` commands described in Changesets support."},"1206":{"id":"/js/wp-release/v0.18.2-7","page_id":"/js/wp-release/v0.18.2","tags":[],"type":"text","url":"/js/wp-release/v0.18.2","content":"WordPress.org themes are released by uploading a ZIP, so `deploy-svn` is for plugins only. Use `zip` to build a theme upload. Packaging and deployment options follow familiar community tools to ease migration; the comparison explains the differences."},"1207":{"id":"/js/wp-release/v0.18.2-8","page_id":"/js/wp-release/v0.18.2","tags":[],"type":"text","url":"/js/wp-release/v0.18.2#install","content":"Node.js 22.12 or later is required. SVN deployments also require the `svn` command line client. Git deployments and changeset commands require Git."},"1208":{"id":"/js/wp-release/v0.18.2-9","page_id":"/js/wp-release/v0.18.2","tags":[],"type":"text","url":"/js/wp-release/v0.18.2#install","content":"The package is an ES module with TypeScript declarations. CommonJS projects can load it with `require( '@wpelevator/wp-release' )` on Node.js 22.12 or later."},"1209":{"id":"/js/wp-release/v0.18.2-10","page_id":"/js/wp-release/v0.18.2","tags":[],"type":"text","url":"/js/wp-release/v0.18.2#guides","content":"CLI and automation"},"1210":{"id":"/js/wp-release/v0.18.2-11","page_id":"/js/wp-release/v0.18.2","tags":[],"type":"text","url":"/js/wp-release/v0.18.2#guides","content":"Changeset releases"},"1211":{"id":"/js/wp-release/v0.18.2-12","page_id":"/js/wp-release/v0.18.2","tags":[],"type":"text","url":"/js/wp-release/v0.18.2#guides","content":"Configuration and file selection"},"1212":{"id":"/js/wp-release/v0.18.2-13","page_id":"/js/wp-release/v0.18.2","tags":[],"type":"text","url":"/js/wp-release/v0.18.2#guides","content":"Packaging, checksums, signatures, and verification"},"1213":{"id":"/js/wp-release/v0.18.2-14","page_id":"/js/wp-release/v0.18.2","tags":[],"type":"text","url":"/js/wp-release/v0.18.2#guides","content":"Git and WordPress.org deployment"},"1214":{"id":"/js/wp-release/v0.18.2-15","page_id":"/js/wp-release/v0.18.2","tags":[],"type":"text","url":"/js/wp-release/v0.18.2#guides","content":"WordPress internationalization"},"1215":{"id":"/js/wp-release/v0.18.2-16","page_id":"/js/wp-release/v0.18.2","tags":[],"type":"text","url":"/js/wp-release/v0.18.2#guides","content":"Library API"},"1216":{"id":"/js/wp-release/v0.18.2-17","page_id":"/js/wp-release/v0.18.2","tags":[],"type":"text","url":"/js/wp-release/v0.18.2#guides","content":"Development and architecture"},"1217":{"id":"/js/wp-release/v0.18.2-18","page_id":"/js/wp-release/v0.18.2","tags":[],"type":"text","url":"/js/wp-release/v0.18.2#guides","content":"Comparison with existing tools"},"1218":{"id":"/js/wp-release/v0.18.2/internationalization","page_id":"/js/wp-release/v0.18.2/internationalization","type":"page","content":"Internationalization","breadcrumbs":["Docs","Js","Wp release","v0.18.2"],"tags":[],"url":"/js/wp-release/v0.18.2/internationalization"},"1219":{"id":"/js/wp-release/v0.18.2/internationalization-0","page_id":"/js/wp-release/v0.18.2/internationalization","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2/internationalization#wordpress-internationalization","content":"WordPress internationalization"},"1220":{"id":"/js/wp-release/v0.18.2/internationalization-1","page_id":"/js/wp-release/v0.18.2/internationalization","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2/internationalization#supported-extraction-syntax","content":"Supported extraction syntax"},"1221":{"id":"/js/wp-release/v0.18.2/internationalization-2","page_id":"/js/wp-release/v0.18.2/internationalization","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2/internationalization#compile-translated-catalogs","content":"Compile translated catalogs"},"1222":{"id":"/js/wp-release/v0.18.2/internationalization-3","page_id":"/js/wp-release/v0.18.2/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/internationalization#wordpress-internationalization","content":"`i18n-pot` extracts plugin/theme strings and writes a reproducible UTF-8 POT. `i18n-audit` reads the same source and returns findings without writing files. Both run with Node alone: no PHP, WordPress installation, database, WP-CLI or network requests. Extraction is independent of `files`, `.distignore` and Git `export-ignore` distribution rules."},"1223":{"id":"/js/wp-release/v0.18.2/internationalization-4","page_id":"/js/wp-release/v0.18.2/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/internationalization#wordpress-internationalization","content":"Config-free source directories must have plugin/theme headers. The actual main file is discovered using the package metadata reader, including plugins whose main filename differs from their slug. The selected domain defaults to `Text Domain`, then the directory name. Calls with omitted domains belong to WordPress's `default` domain; block metadata without a domain inherits the package domain. `--all-domains` explicitly combines domains. A block's explicit `textdomain` always controls its messages."},"1224":{"id":"/js/wp-release/v0.18.2/internationalization-5","page_id":"/js/wp-release/v0.18.2/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/internationalization#wordpress-internationalization","content":"`--package` selects one configured package and permits extraction-specific overrides; `--all` requires configuration and selects enabled WordPress packages only. Source directories, package selectors and `--all` are mutually exclusive. Config-free directory mode reads only its explicit options and metadata; it does not import repository config implicitly. A disabled package fails when explicitly selected. Configuration uses `i18n` at the root and on package entries, including an exact `glob` for an individual package, following the existing group model. Package entries remain non-overlapping; there is no additional package manifest configuration source."},"1225":{"id":"/js/wp-release/v0.18.2/internationalization-6","page_id":"/js/wp-release/v0.18.2/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/internationalization#wordpress-internationalization","content":"Precedence is defaults, root configuration, package group/individual entry, then explicit command options. Scalars override, lists replace inherited lists, and gettext headers merge by key, case-insensitively, preserving intentionally empty values. A header set to `false` is removed, like `'Project-Id-Version': false` to keep the plugin version out of the POT so that it changes only when strings change; a later layer can set it again. `Content-Type` can't be removed, since it declares the UTF-8 charset. Options include `enabled`, `domain`, `allDomains`, `include`, `exclude`, `destination`, `headers`, `fileComment`, `references`, `strict`, `legacyGlobals` and audit `suppress`. `fileComment` adds static text above the POT header; each line is emitted as a gettext comment, and no copyright year is generated. The CLI accepts the same setting with `--file-comment`. Repeat `--include` or `--exclude` for multiple globs; these use case-sensitive minimatch semantics with `/` paths, `**`, brace expansion and dotfile matching, without gitignore negation or comma splitting. Default excludes cover dependency directories, dot directories, tests, minified files and generated translations. Source/build exclusions are a repository choice; this repository excludes `build`, `tools` and isolated vendors in its config."},"1226":{"id":"/js/wp-release/v0.18.2/internationalization-7","page_id":"/js/wp-release/v0.18.2/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/internationalization#wordpress-internationalization","content":"The default output is `<Domain Path>/<text-domain>.pot`, or `languages/<text-domain>.pot`. A leading `/` in `Domain Path` is package-relative, and configured destinations cannot escape the package. `--destination` changes the package-relative directory. An explicit `--output <file.pot>` resolves against the command's working directory and requires one package. All multi-package destinations are validated before writing; each completed package replaces its file atomically, independently of other packages. `--check` compares bytes without writing and fails if the POT is absent or stale. Source references are preserved by default; `--no-references` omits them. `POT-Creation-Date` and `PO-Revision-Date` default to empty values; no current date or year is inserted. Name/version headers come from metadata, and `--header NAME=VALUE` overrides any default, including with an empty value, and `--header NAME` removes the header. The POT lists the plugin or theme header strings first, then the strings of PHP, JavaScript, `block.json` and other metadata files in source order, so related strings stay together for translators. Each entry has its extracted comments, references and flags before the strings, in the usual gettext layout. The default headers come in a fixed order, and custom headers follow them. No generator header or generated copyright comment is added; set `fileComment` for a static one."},"1227":{"id":"/js/wp-release/v0.18.2/internationalization-8","page_id":"/js/wp-release/v0.18.2/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/internationalization#supported-extraction-syntax","content":"PHP extraction uses `php-parser` in PHP 8.3 mode, tested with attributes, enums, match expressions, promoted properties and readonly classes. Supported WordPress functions are `__`, `_e`, `_x`, `_ex`, `_n`, `_nx`, `_n_noop`, `_nx_noop`, `esc_attr__`, `esc_attr_e`, `esc_attr_x`, `esc_html__`, `esc_html_e` and `esc_html_x`. Global and explicitly global calls, namespace fallback and explicit function imports/aliases are supported. Known file-local declarations and unrelated namespaced imports are excluded; methods and static methods are never translation calls. Named arguments resolve by PHP parameter name. Literal strings, static concatenation and non-interpolated heredoc/nowdoc preserve decoded escapes, Unicode and newlines. Counts may be dynamic; IDs, contexts and selected domains must be static."},"1228":{"id":"/js/wp-release/v0.18.2/internationalization-9","page_id":"/js/wp-release/v0.18.2/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/internationalization#supported-extraction-syntax","content":"JavaScript extraction uses Babel's parser and lexical scope traversal, without transforms or project Babel config. JS, JSX, TS, TSX, MJS, CJS, MTS and CTS are supported. Named imports/aliases and namespace imports from `@wordpress/i18n`, unshadowed `wp.i18n` calls and unbound canonical legacy `__`, `_x`, `_n` and `_nx` calls extract strings. `--no-legacy-globals` requires imported or `wp.i18n` bindings. Locally shadowed/reassigned imports are excluded. Static literals, templates without substitutions, concatenation and TypeScript assertions are supported. Destructured CommonJS imports, transpiled `(0, i18n.__)` forms and arbitrary minified bundles are outside the supported syntax; scan source and use explicit source/build mapping for compiled JSON."},"1229":{"id":"/js/wp-release/v0.18.2/internationalization-10","page_id":"/js/wp-release/v0.18.2/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/internationalization#supported-extraction-syntax","content":"A `translators:` comment attaches to the first translation call whose containing expression or nearest statement immediately follows it. Whitespace, parsed comments and ternary branch punctuation may intervene, but unrelated statements or argument expressions may not. Comments before outer wrappers reach nested translation calls; a comment is consumed once, so unrelated sibling calls do not inherit it. Multiline comment content is preserved. WordPress plugin/theme header labels serialize as extracted comments. Bundled metadata tables follow WordPress 6.8 block fields and theme fields, including styles, variations, presets, template names and nested block settings. Their upstream data license is GPL-2.0-or-later; tables are maintained intentionally with fixtures and never fetched during generation."},"1230":{"id":"/js/wp-release/v0.18.2/internationalization-11","page_id":"/js/wp-release/v0.18.2/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/internationalization#supported-extraction-syntax","content":"Invalid syntax, unreadable selected files, selected source symlinks, empty/reserved message IDs, conflicting plural definitions and output errors fail generation. Unsupported dynamic arguments warn and are fatal with `--strict`. Audit adds `placeholder-comment`, `unordered-placeholders`, `plural-placeholders`, `empty-message` and `conflicting-comments` findings; suppress these explicitly by code where justified. Placeholders support `%%`, positional indexes, numeric width/precision, padding/flags and PHP/JS sprintf conversion types. Audit checks extraction and message quality, not every untranslated user-facing string. Audit fails on errors; strict audit also fails on warnings. Failed checks return exit code `2`; unexpected I/O/option-loading errors follow the existing CLI error handling. `--json`, GitHub annotations, summaries and step outputs use the existing CLI reporting facilities."},"1231":{"id":"/js/wp-release/v0.18.2/internationalization-12","page_id":"/js/wp-release/v0.18.2/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/internationalization#compile-translated-catalogs","content":"Runtime formats require a translated PO, not an untranslated POT. PO updating, fuzzy matching and automatic translation are not provided. Compilation validates `Language` and `Plural-Forms`, excludes fuzzy, obsolete and untranslated entries, preserves contexts and plural forms, and never changes the input PO. An incompletely translated plural entry is excluded as a unit. Gettext parsing handles source encoding; runtime outputs use UTF-8. Each output is replaced atomically; JSON outputs are independent writes, and obsolete output files are not deleted automatically."},"1232":{"id":"/js/wp-release/v0.18.2/internationalization-13","page_id":"/js/wp-release/v0.18.2/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/internationalization#compile-translated-catalogs","content":"MO and `.l10n.php` default beside the PO, with `.mo` and `.l10n.php` extensions; `--output` selects an explicit file relative to cwd. WordPress PHP catalogs require WordPress 6.5 or later. JSON requires an explicit domain; `--output` is a directory, defaulting to the PO directory. `--check` compares proposed bytes without writing and exits `2` on absent/stale outputs. Compiler commands are primitives and do not select configured packages."},"1233":{"id":"/js/wp-release/v0.18.2/internationalization-14","page_id":"/js/wp-release/v0.18.2/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/internationalization#compile-translated-catalogs","content":"A script map is a JSON object from normalized package-relative source references to arrays of normalized runtime script paths. Many source files can feed one bundle, and one source can feed several scripts. An explicit map selects only listed references; an empty target array excludes that source. Without a map, JS/MJS/CJS references use identity paths, while JSX/TypeScript references require mapping. PHP-only references do not enter JSON catalogs."},"1234":{"id":"/js/wp-release/v0.18.2/internationalization-15","page_id":"/js/wp-release/v0.18.2/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/internationalization#compile-translated-catalogs","content":"JSON filenames are `<domain>-<Language>-<md5(runtime-path)>.json`; the WordPress `default` domain uses `<Language>-<md5(runtime-path)>.json`. WordPress's `.min.js` normalization applies consistently to grouping, hashing and the JSON `source`. Jed keys preserve context through `\\u0004`, plural arrays contain all translated forms, and revision dates come from the PO metadata. `.l10n.php` writes safely escaped data arrays with NUL-separated plural translations; catalog text is never treated as executable PHP."},"1235":{"id":"/js/wp-release/v0.18.2/internationalization-16","page_id":"/js/wp-release/v0.18.2/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/internationalization#compile-translated-catalogs","content":"The extraction and compilation primitives are in the standalone `@wpelevator/wp-gettext` package, without the repository and release tooling, and `wp-release` depends on it. See its README to use them in your own scripts."},"1236":{"id":"/js/wp-release/v0.18.2/internationalization-17","page_id":"/js/wp-release/v0.18.2/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/internationalization#compile-translated-catalogs","content":"The package can be installed and used in any WordPress plugin or theme project; repository package selection is optional, and directory mode works without a wp-release config."},"1237":{"id":"/js/wp-release/v0.18.2/library","page_id":"/js/wp-release/v0.18.2/library","type":"page","content":"Library API","breadcrumbs":["Docs","Js","Wp release","v0.18.2"],"tags":[],"url":"/js/wp-release/v0.18.2/library"},"1238":{"id":"/js/wp-release/v0.18.2/library-0","page_id":"/js/wp-release/v0.18.2/library","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2/library#exit-codes","content":"Exit codes"},"1239":{"id":"/js/wp-release/v0.18.2/library-1","page_id":"/js/wp-release/v0.18.2/library","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2/library#library","content":"Library"},"1240":{"id":"/js/wp-release/v0.18.2/library-2","page_id":"/js/wp-release/v0.18.2/library","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2/library#signing","content":"Signing"},"1241":{"id":"/js/wp-release/v0.18.2/library-3","page_id":"/js/wp-release/v0.18.2/library","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2/library#zip-archives","content":"ZIP archives"},"1242":{"id":"/js/wp-release/v0.18.2/library-4","page_id":"/js/wp-release/v0.18.2/library","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2/library#file-selection","content":"File selection"},"1243":{"id":"/js/wp-release/v0.18.2/library-5","page_id":"/js/wp-release/v0.18.2/library","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2/library#checksums","content":"Checksums"},"1244":{"id":"/js/wp-release/v0.18.2/library-6","page_id":"/js/wp-release/v0.18.2/library","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2/library#translations","content":"Translations"},"1245":{"id":"/js/wp-release/v0.18.2/library-7","page_id":"/js/wp-release/v0.18.2/library","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2/library#logging","content":"Logging"},"1246":{"id":"/js/wp-release/v0.18.2/library-8","page_id":"/js/wp-release/v0.18.2/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/library#exit-codes","content":"| Code | Meaning                               |\n| ---- | ------------------------------------- |\n| `0`  | Success, dry run, no changes, or help |","table":"table-0"},"1247":{"id":"/js/wp-release/v0.18.2/library-9","page_id":"/js/wp-release/v0.18.2/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/library#exit-codes","content":"| Code | Meaning                                                 |\n| ---- | ------------------------------------------------------- |\n| `1`  | Unexpected failure, such as a failed svn or git command |","table":"table-0"},"1248":{"id":"/js/wp-release/v0.18.2/library-10","page_id":"/js/wp-release/v0.18.2/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/library#exit-codes","content":"| Code | Meaning                                                                                                                                          |\n| ---- | ------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `2`  | Invalid options, failed release checks, an existing SVN tag, a Git tag that exists with another release, or files that don't match the checksums |","table":"table-0"},"1249":{"id":"/js/wp-release/v0.18.2/library-11","page_id":"/js/wp-release/v0.18.2/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/library#exit-codes","content":"| Code | Meaning                                                   |\n| ---- | --------------------------------------------------------- |\n| `3`  | Missing SVN credentials, or credentials that SVN rejected |","table":"table-0"},"1250":{"id":"/js/wp-release/v0.18.2/library-12","page_id":"/js/wp-release/v0.18.2/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/library#library","content":"`resolveDeployOptions()` applies the defaults and throws a `ValidationError` (with `exitCode` `2`) for invalid combinations. `SvnDeploy` exposes each step (`prepare()`, `checkVersions()`, `checkout()`, `sync()`, `commit()` and `cleanup()`) separately so CI wrappers can run and report them one by one; `run()` runs all of them, or nothing when there's nothing to write. `getPlan()` lists the planned SVN changes. The `Svn` class wraps the svn command line, and takes the command runner as a dependency so that tests can replace it."},"1251":{"id":"/js/wp-release/v0.18.2/library-13","page_id":"/js/wp-release/v0.18.2/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/library#library","content":"Git deploys:"},"1252":{"id":"/js/wp-release/v0.18.2/library-14","page_id":"/js/wp-release/v0.18.2/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/library#library","content":"`resolveGitDeployOptions()` throws a `ValidationError` without a repository URL or with an invalid branch or tag. `GitDeploy` exposes `createTree()`, `fetchPrevious()`, `createRelease()`, `isOutdated()`, `checkTag()`, `getRefsToPush()` and `push()` separately, like `SvnDeploy`, and takes a git command runner from `createGitRunner()` as a dependency. The result has `outdated` when the branch wasn't moved for older source history, the refs to write in `planned` and the refs that were pushed in `pushed`, which is empty in a dry run. `redactUrls()` hides the credentials in URLs."},"1253":{"id":"/js/wp-release/v0.18.2/library-15","page_id":"/js/wp-release/v0.18.2/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/library#library","content":"Changeset releases:"},"1254":{"id":"/js/wp-release/v0.18.2/library-16","page_id":"/js/wp-release/v0.18.2/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/library#library","content":"`ChangesetRelease` runs the `changeset-*` commands: `add()`, `getStatus()`, `version()` and `tag()`, plus `getPlan()`, `getPackages()` and `getConfiguredPackages()`. Each call reads the configuration, packages and pending changesets again, so one instance can version and then tag. `getConfiguredPackages()` returns package directories with their resolved release group metadata; `formatTag()` and `formatTemplate()` apply the same placeholders as the release workflows. It takes a git runner from `createGitRunner()` as `git`, so that tests can replace it. Without a config file, it detects a single root project. Its optional `singleProject` settings accept `versions` (the existing version descriptors), `versionFrom` (the same selector as `--version-from`), `baseBranch`, `remote`, `changesets`, `readmeChangelog` and `changelogInsertAfter`; `tagFormat` remains a repository option. The functions `addChangeset()`, `getChangesetStatus()`, `versionChangesets()`, `tagChangesets()`, `getChangesetReleasePlan()`, `getChangesetPackages()` and `getConfiguredPackages()` do the same with the default runners, in one call."},"1255":{"id":"/js/wp-release/v0.18.2/library-17","page_id":"/js/wp-release/v0.18.2/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/library#signing","content":"The Ed25519 key handling and the WordPress, minisign and OpenSSH signature formats live in the `@wpelevator/signatures` package, which `@wpelevator/wp-release` depends on. It still re-exports the signing functions that it has always exported; the bytes-first functions and error guards are only in `@wpelevator/signatures`. The wp-release functions read the key from `WP_RELEASE_SIGNING_KEY` and report invalid input as a `ValidationError` with the original error as its `cause`; the `@wpelevator/signatures` functions use `SIGNING_KEY` by default and throw a `SigningError`."},"1256":{"id":"/js/wp-release/v0.18.2/library-18","page_id":"/js/wp-release/v0.18.2/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/library#zip-archives","content":"Reproducible archives and safe extraction live in the `@wpelevator/zip` package, which `@wpelevator/wp-release` depends on. It still exports `createZip()`, `readZipEntries()`, `getZipEntryErrors()`, `extractZip()`, `ZIP_MTIME` and `ZIP_FILE_MODE` with their `sourceDir`, `files` and `zipPath` inputs, and reports invalid input as a `ValidationError` with the original error as its `cause`. The zip package takes a list of `{ source, name }` entries, where the source is a file path or bytes, and can create and read archives in memory. Entries have the fixed `ZIP_MTIME`, or the `SOURCE_DATE_EPOCH` time when that environment variable is set."},"1257":{"id":"/js/wp-release/v0.18.2/library-19","page_id":"/js/wp-release/v0.18.2/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/library#file-selection","content":"Gitignore-style file selection and directory syncing live in the `@wpelevator/fileset` package, which `@wpelevator/wp-release` depends on. It still exports `resolveFileSelection()`, `loadFileRules()`, `selectFiles()`, `parseExclude()`, `syncDirectory()` and `copyFileIfChanged()` with the same inputs, and reports invalid input as a `ValidationError` with the original error as its `cause`. The fileset package has no Git dependency: it takes a function that lists more files to exclude, `listExcluded`, and `@wpelevator/wp-release` passes one that reads the `export-ignore` attribute with Git when `excludeGitattributes` is set. The ignore file name (`.distignore` by default) and the directories that a sync leaves alone (`.svn` by default) are options of the fileset package."},"1258":{"id":"/js/wp-release/v0.18.2/library-20","page_id":"/js/wp-release/v0.18.2/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/library#checksums","content":"Hashing, the checksums manifest formats and their comparison live in the `@wpelevator/checksums` package, which `@wpelevator/wp-release` depends on. It still exports `createChecksums()`, `writeChecksums()`, `readChecksums()`, `parseChecksums()`, `verifyChecksums()`, `compareChecksums()`, `hashFile()`, `hashFiles()` and the `wordpressCodec` and `sha256sumCodec` codecs with the same inputs and output, and reports invalid input as a `ValidationError` with the original error as its `cause`. The checksums package takes a plain list of file paths instead of file rules, hashes bytes and streams with `hashBytes()` and `hashStream()`, and keeps the plugin or theme slug and version as generic `metadata` next to the `files`, which `@wpelevator/wp-release` fills in. Manifests are written byte for byte as before."},"1259":{"id":"/js/wp-release/v0.18.2/library-21","page_id":"/js/wp-release/v0.18.2/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/library#translations","content":"Extracting translatable strings from PHP, JavaScript and `block.json` sources, building catalogs, writing POT files, compiling PO files to MO, script JSON and `.l10n.php`, and auditing live in the `@wpelevator/wp-gettext` package, which `@wpelevator/wp-release` depends on. It still exports the same functions, like `extractCatalog()`, `generatePackagePot()`, `serializePot()`, `parseTranslatedPo()` and `compileTranslations()`, with the same inputs and output, and reports invalid input as a `ValidationError` with the original error as its `cause`. The wp-gettext package doesn't read plugin and theme headers: it takes the header details as a `meta` input, which `@wpelevator/wp-release` reads from the main file with its own package metadata reader. `resolveI18nPackages()`, which selects the configured packages, stays in `@wpelevator/wp-release`. Importing the main entry of `@wpelevator/wp-gettext` doesn't load the PHP and JavaScript parsers, which are in the `/php` and `/javascript` sub-paths."},"1260":{"id":"/js/wp-release/v0.18.2/library-22","page_id":"/js/wp-release/v0.18.2/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/library#logging","content":"`Logger` filters messages by level and passes them to a writer, like the transports of other Node.js loggers. The writer decides how messages look:"},"1261":{"id":"/js/wp-release/v0.18.2/library-23","page_id":"/js/wp-release/v0.18.2/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/library#logging","content":"`TextWriter` prints plain text to `stdout` and `stderr`. It's the default."},"1262":{"id":"/js/wp-release/v0.18.2/library-24","page_id":"/js/wp-release/v0.18.2/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/library#logging","content":"`GitHubActionsWriter` prints workflow commands, so that notices, warnings and errors with a file are annotations, and appends summaries to `GITHUB_STEP_SUMMARY`. It's the CLI's `github` log format, and the GitHub Actions pass it to their logger. Its `workspace` and `summaryPath` options default to `GITHUB_WORKSPACE` and `GITHUB_STEP_SUMMARY`."},"1263":{"id":"/js/wp-release/v0.18.2/library-25","page_id":"/js/wp-release/v0.18.2/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/library#logging","content":"A writer implements `LogWriter` with `write()`, `startGroup()`, `endGroup()` and `summary()`, so other CI systems can have their own format. `summary()` takes a function that builds the Markdown, which only writers with a summary call."},"1264":{"id":"/js/wp-release/v0.18.2/library-26","page_id":"/js/wp-release/v0.18.2/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/library#logging","content":"A `ValidationError` can list `problems`, each with a `message` and an optional `file`, `line` and `title`. `logError( logger, error, title )` logs each problem as an error on its file and line and lists them in the summary under the title, or logs the message when there are none. `VersionMismatchError` and `version-check` report the version mismatches this way."},"1265":{"id":"/js/wp-release/v0.18.2/library-27","page_id":"/js/wp-release/v0.18.2/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/library#logging","content":"ZIP files and metadata:"},"1266":{"id":"/js/wp-release/v0.18.2/library-28","page_id":"/js/wp-release/v0.18.2/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/library#logging","content":"Checksums:"},"1267":{"id":"/js/wp-release/v0.18.2/library-29","page_id":"/js/wp-release/v0.18.2/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/library#logging","content":"`loadFileRules()` reads the ignore file and `--exclude` patterns into a gitignore matcher, optionally adds Git `export-ignore` paths, and `selectFiles()` lists the files it doesn't ignore. `compareChecksums()` compares two hash maps without reading any files, and `parseChecksums()` validates manifest JSON. `extractZip()` extracts a ZIP after the same checks as `deploy-svn --from-zip`."},"1268":{"id":"/js/wp-release/v0.18.2/library-30","page_id":"/js/wp-release/v0.18.2/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/library#logging","content":"Translations:"},"1269":{"id":"/js/wp-release/v0.18.2/library-31","page_id":"/js/wp-release/v0.18.2/library","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/library#logging","content":"The parsers, catalog and compiler functions are provided by `@wpelevator/wp-gettext`. Parsers return messages and structured diagnostics with stable codes, severity and source-relative locations. Catalog messages retain IDs, contexts, plurals, translations, translator comments, flags and structured references. `aggregateCatalog()` selects/merges a domain, unions references/comments and diagnoses plural conflicts. `resolveI18nPackages()` is the separate config adapter; extraction and serialization primitives know nothing about the repository. Library functions do not log, parse process arguments or set exit codes. Extraction results report unique files consulted, including the main plugin/theme file used for headers and header strings even when source globs exclude it. `parseTranslatedPo()`, `compileMo()`, `compileScriptTranslations()`, `compilePhpTranslations()` and `compileTranslations()` expose the same typed operations to library callers."},"1270":{"id":"/js/wp-release/v0.18.2/packaging","page_id":"/js/wp-release/v0.18.2/packaging","type":"page","content":"Packaging and integrity","breadcrumbs":["Docs","Js","Wp release","v0.18.2"],"tags":[],"url":"/js/wp-release/v0.18.2/packaging"},"1271":{"id":"/js/wp-release/v0.18.2/packaging-0","page_id":"/js/wp-release/v0.18.2/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2/packaging#build-a-directory","content":"Build a directory"},"1272":{"id":"/js/wp-release/v0.18.2/packaging-1","page_id":"/js/wp-release/v0.18.2/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2/packaging#zip","content":"ZIP"},"1273":{"id":"/js/wp-release/v0.18.2/packaging-2","page_id":"/js/wp-release/v0.18.2/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2/packaging#signing-targets-for-builds-and-zips","content":"Signing targets for builds and ZIPs"},"1274":{"id":"/js/wp-release/v0.18.2/packaging-3","page_id":"/js/wp-release/v0.18.2/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2/packaging#checksums","content":"Checksums"},"1275":{"id":"/js/wp-release/v0.18.2/packaging-4","page_id":"/js/wp-release/v0.18.2/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2/packaging#filenames-embedding-and-signing","content":"Filenames, embedding and signing"},"1276":{"id":"/js/wp-release/v0.18.2/packaging-5","page_id":"/js/wp-release/v0.18.2/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2/packaging#formats","content":"Formats"},"1277":{"id":"/js/wp-release/v0.18.2/packaging-6","page_id":"/js/wp-release/v0.18.2/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2/packaging#configuration-and-custom-codecs","content":"Configuration and custom codecs"},"1278":{"id":"/js/wp-release/v0.18.2/packaging-7","page_id":"/js/wp-release/v0.18.2/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2/packaging#manifest-inside-the-plugin","content":"Manifest inside the plugin"},"1279":{"id":"/js/wp-release/v0.18.2/packaging-8","page_id":"/js/wp-release/v0.18.2/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2/packaging#verify","content":"Verify"},"1280":{"id":"/js/wp-release/v0.18.2/packaging-9","page_id":"/js/wp-release/v0.18.2/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2/packaging#sign","content":"Sign"},"1281":{"id":"/js/wp-release/v0.18.2/packaging-10","page_id":"/js/wp-release/v0.18.2/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2/packaging#signature-formats","content":"Signature formats"},"1282":{"id":"/js/wp-release/v0.18.2/packaging-11","page_id":"/js/wp-release/v0.18.2/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.18.2/packaging#version-check","content":"Version check"},"1283":{"id":"/js/wp-release/v0.18.2/packaging-12","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#build-a-directory","content":"`build` and `zip` use the same internal helper to load file rules, exclude their outputs, select release files and reject an empty selection. `build` copies the selected files directly into `--output <dir>`, without a slug wrapper or ZIP. Checksums and manifest signatures are optional. It supports the shared file selection flags above and `--package <name>` with `--config <path>` for configured package rules. A configured package cannot be combined with a source directory or file selection flags."},"1284":{"id":"/js/wp-release/v0.18.2/packaging-13","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#build-a-directory","content":"The destination is required and automatically excluded when it is inside the source. It cannot be the source directory or an ancestor, including through symlinked parents. Existing destinations require `--force`, which replaces the directory and removes stale files; existing files and symbolic links are rejected. Files are copied to a temporary directory before the existing build is replaced. Selected symbolic links are rejected as with ZIP packaging. `--json` returns `outputDir`, `files` and, for configured builds, `package`; it also returns `checksumsPath` when a manifest is generated, and `signatures` and `publicKey` when signing is requested. `--github-output` exposes these results too."},"1285":{"id":"/js/wp-release/v0.18.2/packaging-14","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#build-a-directory","content":"`--checksums` writes `<output-dir>.checksums.json` beside the directory and hashes the copied build files. `--sign-checksums` generates and signs that manifest, implying `--checksums`. Use `--slug` and `--version` to override its metadata. The manifest and its signatures are excluded from the source selection, so rebuilding with `--force` does not package previous sidecars. Existing manifests and requested signature files also require `--force`; signing keys, formats and signature destinations are validated before creating or replacing the build. `--sign` is unsupported because a directory has no single file to sign."},"1286":{"id":"/js/wp-release/v0.18.2/packaging-15","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#build-a-directory","content":"In the Deploy workflow, a directory build can be deployed with `wp-release deploy-svn dist/code-prettify --slug code-prettify --trunk --svn-tag \"$GITHUB_REF_NAME\" --no-distignore`. Keep `--from-zip` when the SVN deployment must match the attached ZIP exactly. Run dependency installation and compilation before `build`; it only selects and copies files."},"1287":{"id":"/js/wp-release/v0.18.2/packaging-16","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#zip","content":"The `wp-release-zip` GitHub Action runs this command."},"1288":{"id":"/js/wp-release/v0.18.2/packaging-17","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#zip","content":"`zip` writes `{slug}.{version}.zip` to the current directory, or to `--output <file>`, with the selected files in a `{slug}/` root folder:"},"1289":{"id":"/js/wp-release/v0.18.2/packaging-18","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#zip","content":"`--root-folder <name>` changes the root folder and `--no-root-folder` puts the files at the root of the ZIP."},"1290":{"id":"/js/wp-release/v0.18.2/packaging-19","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#zip","content":"`--filename-format` changes the name, like `--filename-format {slug}` for `my-plugin.zip`."},"1291":{"id":"/js/wp-release/v0.18.2/packaging-20","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#zip","content":"Entries are sorted and use a fixed file mode and a fixed timestamp (1980-01-01), or the `SOURCE_DATE_EPOCH` Unix time when that environment variable is set, so the same files give the same ZIP. Built-in metadata is deterministic except for embedded minisign signatures, which include their signing timestamp; custom codec callbacks control their own encoded bytes."},"1292":{"id":"/js/wp-release/v0.18.2/packaging-21","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#zip","content":"`--checksums` also writes the checksums manifest of the archived files next to the ZIP, with `.checksums.json` instead of `.zip`."},"1293":{"id":"/js/wp-release/v0.18.2/packaging-22","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#zip","content":"`--sign` signs only the ZIP with `WP_RELEASE_SIGNING_KEY`. `--sign-checksums` generates and signs only the checksums manifest, implying `--checksums`. Use both flags to sign both files. External signatures are written alongside their files; embedded manifest signatures are written inside the package. The default format is WordPress `.sig`, unless integrity configuration selects another format."},"1294":{"id":"/js/wp-release/v0.18.2/packaging-23","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#zip","content":"`--sign-format` selects formats for requested signatures, such as `--sign-format wordpress,minisign,ssh`. It requires `--sign` or `--sign-checksums` and never enables signing by itself. Signing keys, formats and existing signature destinations are validated before writing the ZIP or manifest. `--force` also overwrites requested signatures. Job summaries include signatures and public keys; JSON results include `signatures` and `publicKey`."},"1295":{"id":"/js/wp-release/v0.18.2/packaging-24","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#zip","content":"An existing ZIP or manifest isn't overwritten without `--force`. A ZIP or manifest written inside the source directory is never archived."},"1296":{"id":"/js/wp-release/v0.18.2/packaging-25","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#zip","content":"`--package <name>` zips a package of the configured packages, by identifier or path under the configured root like `plugins/alpha`, instead of a source directory: its directory with the `files` config of its package group, the same files that its deploys select. The slug defaults to the directory name and the version to the `Version` header, and `--slug` and `--version` still set them. Any package of the config works, with or without a version or deploy targets. To zip what a deploy just released, pass the `package` and `version` of the `deploy-git --release-ref` result, in the same job and from the same build, so the ZIP has exactly the files of the release tag in the release repository. It can't be combined with `<source-dir>` or the file selection options. The `--json` result has the `package`, `slug` and `version`. `zipPackage()` builds the same ZIP from a script, with `getPackageFiles()` for the directory and the files of a package."},"1297":{"id":"/js/wp-release/v0.18.2/packaging-26","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#zip","content":"To embed a signed manifest with a stable filename, use:"},"1298":{"id":"/js/wp-release/v0.18.2/packaging-27","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#zip","content":"See Checksums for filenames, placement, formats and configuration."},"1299":{"id":"/js/wp-release/v0.18.2/packaging-28","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#signing-targets-for-builds-and-zips","content":"| Flag          | `zip`                                         | `build`                                             |\n| ------------- | --------------------------------------------- | --------------------------------------------------- |\n| `--checksums` | Generate an unsigned manifest beside the ZIP. | Generate an unsigned manifest beside the directory. |","table":"table-0"},"1300":{"id":"/js/wp-release/v0.18.2/packaging-29","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#signing-targets-for-builds-and-zips","content":"| Flag     | `zip`              | `build`      |\n| -------- | ------------------ | ------------ |\n| `--sign` | Sign only the ZIP. | Unsupported. |","table":"table-0"},"1301":{"id":"/js/wp-release/v0.18.2/packaging-30","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#signing-targets-for-builds-and-zips","content":"| Flag               | `zip`                           | `build`                         |\n| ------------------ | ------------------------------- | ------------------------------- |\n| `--sign-checksums` | Generate and sign the manifest. | Generate and sign the manifest. |","table":"table-0"},"1302":{"id":"/js/wp-release/v0.18.2/packaging-31","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#signing-targets-for-builds-and-zips","content":"| Flag            | `zip`                                               | `build`                            |\n| --------------- | --------------------------------------------------- | ---------------------------------- |\n| `--sign-format` | Choose formats for explicitly requested signatures. | Same; requires `--sign-checksums`. |","table":"table-0"},"1303":{"id":"/js/wp-release/v0.18.2/packaging-32","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#signing-targets-for-builds-and-zips","content":"These flags deliberately replace the former implicit signing behavior: `zip --checksums --sign` now leaves the manifest unsigned, and `--sign-format` alone is rejected. Add `--sign-checksums` to sign a manifest and `--sign` to sign a ZIP. The standalone `checksums` and `sign` commands remain available for workflows that write and sign a manifest inside the source before packaging it."},"1304":{"id":"/js/wp-release/v0.18.2/packaging-33","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#checksums","content":"The `wp-release-checksums` GitHub Action runs this command."},"1305":{"id":"/js/wp-release/v0.18.2/packaging-34","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#checksums","content":"`checksums` writes a manifest with the MD5 and SHA-256 hash of every selected file, in the format of the WordPress.org plugin checksums API (`https://downloads.wordpress.org/plugin-checksums/{slug}/{version}.json`). Paths are relative to the plugin or theme folder, sorted, and use forward slashes:"},"1306":{"id":"/js/wp-release/v0.18.2/packaging-35","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#checksums","content":"Themes use a `theme` key instead of `plugin`, and the version is left out when it's unknown. The manifest is named `{slug}.{version}.checksums.json` after `--filename-format`, the same name as the ZIP with `.checksums.json` instead of `.zip`, so the two are published side by side; `--output <file>` writes it elsewhere. A manifest written inside `<source-dir>` is never listed in itself."},"1307":{"id":"/js/wp-release/v0.18.2/packaging-36","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#checksums","content":"Because the manifest lists the files and not the ZIP, it stays valid for any copy of the same files: the GitHub release ZIP, the ZIP that WordPress.org builds from SVN, or an installed plugin on a site."},"1308":{"id":"/js/wp-release/v0.18.2/packaging-37","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#filenames-embedding-and-signing","content":"`--checksums-file <file>` enables checksums and sets a relative filename independently of the ZIP name. Without `--embed-checksums`, it resolves against the ZIP output directory; with embedding, it resolves against the package root inside the ZIP (the archive root with `--no-root-folder`). Nested paths are supported, but absolute paths, backslashes, drive letters, control characters and dot segments are rejected. Embedding emits no external manifest and never modifies the source directory. Embedded minisign signatures contain a signing timestamp, so ZIP bytes can differ across signing times; unsigned metadata and WordPress/SSH signatures remain deterministic. Selected source files must not collide with generated manifest or signature entries."},"1309":{"id":"/js/wp-release/v0.18.2/packaging-38","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#filenames-embedding-and-signing","content":"`--sign-checksums` enables checksums and signs only the manifest, before embedding when requested. It reads `WP_RELEASE_SIGNING_KEY` and uses `--sign-format wordpress,minisign,ssh` to select formats; each signature travels with the manifest. `--sign-format` selects formats for explicitly requested signing targets and never enables signing. `--sign` signs only the final ZIP; `--sign-checksums` controls the manifest in either placement mode. Use both flags to sign both targets. `--force` permits replacing external output files and signatures. `--json` reports external manifests in `checksumsPath`, embedded package-relative paths in `checksumsEmbedded`, and manifest signatures in `checksumsSignatures`."},"1310":{"id":"/js/wp-release/v0.18.2/packaging-39","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#filenames-embedding-and-signing","content":"The default WordPress filename remains the ZIP basename with `.checksums.json` instead of `.zip`, in either placement mode. Choose `--checksums-file checksums.json` for a stable name. The version remains in the JSON content."},"1311":{"id":"/js/wp-release/v0.18.2/packaging-40","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#formats","content":"`--checksums-format` chooses the manifest format. `wordpress-json` (default) uses the WordPress-compatible structure shown above. `sha256sum` uses GNU-compatible SHA-256 lines and escaping, with `SHA256SUMS` as its default filename. It carries no package identity or version, and standard `sha256sum --check` checks listed files without rejecting additional files; `wp-release verify` also checks for extra files."},"1312":{"id":"/js/wp-release/v0.18.2/packaging-41","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#formats","content":"`--checksums-algorithms md5,sha256` selects JSON digest fields; lists replace configured lists. Supported algorithms are MD5 (for compatibility) and SHA-256. The `sha256sum` codec requires SHA-256. The standalone `checksums` command also accepts `--checksums-format`, keeping `--output` relative to the working directory."},"1313":{"id":"/js/wp-release/v0.18.2/packaging-42","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#configuration-and-custom-codecs","content":"The optional top-level `integrity` configuration maps to these flags. Explicit CLI values override configuration; `--no-embed-checksums` and `--no-sign-checksums` disable their configured behaviors. Existing release configurations retain their `packages` array; use `packages: []` for a configuration containing only integrity settings."},"1314":{"id":"/js/wp-release/v0.18.2/packaging-43","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#configuration-and-custom-codecs","content":"Use `codec: 'sha256sum'`, `algorithms: ['sha256']`, `file: 'SHA256SUMS'` and `sign: { formats: ['minisign'] }` for the GNU setup. Custom codecs provide `id`, a default `filename`, and `encode`/`decode` callbacks, which may be asynchronous. Generation validates the round trip before writing artifacts: codecs must preserve all selected file paths, represented digests and any represented package identity. They receive and return the existing WordPress-compatible `ChecksumsManifest` model (`plugin` or `theme`, optional `version`, and a `files` map of relative paths to digest fields), keeping format customization separate from selection, hashing and signing."},"1315":{"id":"/js/wp-release/v0.18.2/packaging-44","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#configuration-and-custom-codecs","content":"`zip` and `checksums` read the caller's release configuration. For verification of custom codecs or configured filenames, pass `--config wp-release.config.mjs` explicitly. See Verify."},"1316":{"id":"/js/wp-release/v0.18.2/packaging-45","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#manifest-inside-the-plugin","content":"For a manifest that is also published as a separate release asset or deployed directly from a source directory, write and sign it in that directory before packaging. Use `zip --embed-checksums` as described above when only the archive should contain the generated metadata. The source-directory workflow uses the same manifest for installed copies and release assets:"},"1317":{"id":"/js/wp-release/v0.18.2/packaging-46","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#manifest-inside-the-plugin","content":"Write the manifest into the directory that is zipped and deployed. The `checksums` command leaves its output manifest and its signatures (`<name>.sig`, `<name>.minisig` and `<name>.sshsig`) out of the hashes, so running it again with the same output path and `--force` gives the same manifest. `verify` checks matching copies as described below. Sign it last, since the signature covers the exact bytes of the manifest."},"1318":{"id":"/js/wp-release/v0.18.2/packaging-47","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#manifest-inside-the-plugin","content":"`zip` and `deploy-svn` carry the pair like any other file. Don't use `zip --checksums` here, since it would write a second manifest that lists the first one. Attach `build/checksums.json` and `build/checksums.json.sig` to the GitHub release as they are."},"1319":{"id":"/js/wp-release/v0.18.2/packaging-48","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#manifest-inside-the-plugin","content":"The signature covers file hashes and not a ZIP, so it stays valid for the ZIP that WordPress.org builds from SVN. Check what WordPress.org serves after a deploy, with the manifest and public key from your build:"},"1320":{"id":"/js/wp-release/v0.18.2/packaging-49","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#manifest-inside-the-plugin","content":"The manifest can have any name and location, for example `--output build/includes/signatures/checksums.json`, and missing folders are created. Tell `verify` where the shipped copy is with `--embedded <path>`, like `--embedded includes/signatures/checksums.json`. Both the `--checksums` file and its signature must then exist, both copies must be shipped, and they're skipped when comparing files and must be identical to the originals. The manifest can't list the embedded path. Without `--embedded`, `verify` looks for the manifest name at the root, and skips a file only when it exists, the matching original exists and the manifest doesn't list it. Otherwise it's checked like any other file, so a listed file that has the name of the manifest can't be deleted unnoticed, and a shipped `.sig` without an original is reported as not in the checksums."},"1321":{"id":"/js/wp-release/v0.18.2/packaging-50","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#manifest-inside-the-plugin","content":"The public key has to come from somewhere other than the plugin that it checks, because someone who can overwrite the plugin files can also replace a key and a signature inside them. A copy of the manifest also doesn't prevent a downgrade to an older release that was signed too, so the installing side has to enforce a minimum version."},"1322":{"id":"/js/wp-release/v0.18.2/packaging-51","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#verify","content":"`verify` checks a directory against a manifest from `checksums` or from the WordPress.org checksums API, and reports every changed, missing and extra file. It exits with `2` unless all files match:"},"1323":{"id":"/js/wp-release/v0.18.2/packaging-52","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#verify","content":"A file matches when its SHA-256 equals the manifest. Manifests without SHA-256 fall back to MD5, and a hash can also be a list of accepted values."},"1324":{"id":"/js/wp-release/v0.18.2/packaging-53","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#verify","content":"`verify` doesn't read `.distignore`, so that an ignore file inside the checked directory can't hide added files. `--exclude <patterns>` skips paths in both the directory and the manifest, for files that aren't part of the release, such as caches."},"1325":{"id":"/js/wp-release/v0.18.2/packaging-54","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#verify","content":"Manifest paths outside the package folder (absolute or with `..`) are rejected."},"1326":{"id":"/js/wp-release/v0.18.2/packaging-55","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#verify","content":"`--zip <file|url>` checks the files of a ZIP instead of a directory. The ZIP can be a URL, such as the one that WordPress.org builds for a release, and its single root folder is found automatically (or set `--root-folder`). The ZIP is extracted to a temporary directory after the same safety checks as `deploy-svn --from-zip`."},"1327":{"id":"/js/wp-release/v0.18.2/packaging-56","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#verify","content":"The version in the manifest must match the `Version` header of the checked files, so that an older release with its own valid manifest can't pass as a newer one."},"1328":{"id":"/js/wp-release/v0.18.2/packaging-57","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#verify","content":"A manifest can't list itself. A copy of the manifest and of its signature inside the checked files, at the root with the same names as the `--checksums` file or at the path of `--embedded`, is skipped when comparing files, but it must be identical to the `--checksums` file and its signature. The signature is the `.sig` file, or the file of `--signature-format`. A path that the manifest lists is never skipped, and a file that isn't a matching copy is reported as not in the checksums. See Manifest inside the plugin."},"1329":{"id":"/js/wp-release/v0.18.2/packaging-58","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#verify","content":"A checksums manifest proves only that the files match the manifest. With `--public-key <key>`, `verify` first checks `<checksums>.sig` against the Ed25519 public key and fails with exit code `2` before comparing any file when the signature is missing or invalid, so that the manifest itself can be trusted. `--signature-format minisign` or `ssh` checks `<checksums>.minisig` or `<checksums>.sshsig` instead. The key can be the base64 key, the minisign public key or the `ssh-ed25519` public key, since they're forms of the same key. See Sign."},"1330":{"id":"/js/wp-release/v0.18.2/packaging-59","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#verify","content":"Verification never executes configuration from inside a downloaded package. Without `--checksums`, `verify` reads the embedded filename selected by `--checksums-file`, explicit configuration, or the codec default. For a versioned embedded filename, pass that filename explicitly. With a public key, signatures are checked before decoding; the selected signature format must exist (WordPress `.sig` by default; pass `--signature-format minisign` or `ssh` for those formats), and all other present supported signature formats are also authenticated when verifying the embedded manifest. Without a public key, checksums detect changes but do not authenticate the publisher. Trusted public keys must come from outside the package."},"1331":{"id":"/js/wp-release/v0.18.2/packaging-60","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#sign","content":"The `wp-release-sign` GitHub Action runs this command."},"1332":{"id":"/js/wp-release/v0.18.2/packaging-61","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#sign","content":"`sign` writes a detached signature next to each file, `<file>.sig`, so that downloads and installed copies can be trusted. Sign both the ZIP and the checksums manifest: the ZIP signature covers installs and updates, and the manifest signature covers the contents after unpacking and copies that weren't built by you."},"1333":{"id":"/js/wp-release/v0.18.2/packaging-62","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#sign","content":"The signature is the one WordPress core's `verify_file_signature()` checks: a base64 Ed25519 signature of the raw SHA-384 digest of the file. The tests check it against `sodium_crypto_sign_verify_detached()` in PHP. A `.sig` file can hold several signatures, one per line, and a file is valid when any of them match, which allows a key rotation window."},"1334":{"id":"/js/wp-release/v0.18.2/packaging-63","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#sign","content":"The key is read from the `WP_RELEASE_SIGNING_KEY` environment variable only, as a base64 32-byte Ed25519 seed or a 64-byte libsodium secret key, the formats that `sodium_crypto_sign_seed_keypair()` and the update-pilot-server package signing key take. There's no flag for it, since it would show in the process list, and it's never logged."},"1335":{"id":"/js/wp-release/v0.18.2/packaging-64","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#sign","content":"`--verbose` prints the public key of the signing key in the form of each written format. `--json` returns it as `publicKey`, and in every form as `publicKeys`. Pass it to `verify --public-key` and to the plugin that checks the signatures."},"1336":{"id":"/js/wp-release/v0.18.2/packaging-65","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#sign","content":"An existing signature file isn't overwritten without `--force`."},"1337":{"id":"/js/wp-release/v0.18.2/packaging-66","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#sign","content":"`zip --sign` signs only the ZIP; add `--sign-checksums` to sign its manifest too. `signFiles()` signs files from a script."},"1338":{"id":"/js/wp-release/v0.18.2/packaging-67","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#signature-formats","content":"The same key can also sign in formats that tools outside WordPress check, for people who download a release by hand or verify it in other pipelines. Pick them with `--format`, comma-separated or repeated; the default is `wordpress`:"},"1339":{"id":"/js/wp-release/v0.18.2/packaging-68","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#signature-formats","content":"| Format      | File         | Checked by                                                                        |\n| ----------- | ------------ | --------------------------------------------------------------------------------- |\n| `wordpress` | `<file>.sig` | WordPress core's `verify_file_signature()`, update-client and `wp-release verify` |","table":"table-1"},"1340":{"id":"/js/wp-release/v0.18.2/packaging-69","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#signature-formats","content":"| Format     | File             | Checked by                                                                    |\n| ---------- | ---------------- | ----------------------------------------------------------------------------- |\n| `minisign` | `<file>.minisig` | minisign and compatible tools: `minisign -Vm <file> -P <minisign public key>` |","table":"table-1"},"1341":{"id":"/js/wp-release/v0.18.2/packaging-70","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#signature-formats","content":"| Format | File            | Checked by                                                                                                      |\n| ------ | --------------- | --------------------------------------------------------------------------------------------------------------- |\n| `ssh`  | `<file>.sshsig` | OpenSSH 8.1 or later: `ssh-keygen -Y verify -f allowed_signers -I <identity> -n file -s <file>.sshsig < <file>` |","table":"table-1"},"1342":{"id":"/js/wp-release/v0.18.2/packaging-71","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#signature-formats","content":"`minisign` signs the BLAKE2b-512 digest of the file, like `minisign -S` does by default, and adds a trusted comment with the signing time and file name that a second signature covers. minisign generates a random key ID for its keys, but the key here is a plain Ed25519 seed, so wp-release derives the key ID from the public key. `wp-release verify` doesn't compare key IDs, so signatures of keys that minisign generated verify too."},"1343":{"id":"/js/wp-release/v0.18.2/packaging-72","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#signature-formats","content":"`ssh` is the armored `SSHSIG` format that `ssh-keygen -Y sign` writes, with a SHA-512 digest and the `file` namespace, so that the signature can't pass as one for commits or another namespace. It's written to `.sshsig` instead of the `.sig` of `ssh-keygen`, which the `wordpress` format uses. Put the SSH public key in an `allowed_signers` file as `<identity> ssh-ed25519 AAAA…`."},"1344":{"id":"/js/wp-release/v0.18.2/packaging-73","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#signature-formats","content":"All formats are Ed25519 signatures by the same key, so one key and one secret cover all of them. The tests check each format with `minisign`, `ssh-keygen` and libsodium, and check the signatures that `minisign` and `ssh-keygen` write with `wp-release verify`."},"1345":{"id":"/js/wp-release/v0.18.2/packaging-74","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#signature-formats","content":"Generate a key pair with `wp-release keygen`. It prints the private seed once as `WP_RELEASE_SIGNING_KEY=…` and the matching public key, also as a minisign public key and an `ssh-ed25519` public key. Generate keys locally and store the private seed in your secret manager or CI secrets. Distribute the public key to verifiers. `keygen --github-output` is rejected to keep the private seed out of workflow outputs; regular and `--json` output both include the seed."},"1346":{"id":"/js/wp-release/v0.18.2/packaging-75","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#version-check","content":"`version-check` compares the versions that have to agree before a release, and reports every mismatch with exit code `2`:"},"1347":{"id":"/js/wp-release/v0.18.2/packaging-76","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#version-check","content":"The expected version is `--version`, or the `Version` header."},"1348":{"id":"/js/wp-release/v0.18.2/packaging-77","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#version-check","content":"The readme `Stable tag` must match for plugins; `--no-stable-tag` skips it, and themes have no Stable tag."},"1349":{"id":"/js/wp-release/v0.18.2/packaging-78","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#version-check","content":"`--constant NAME` (repeatable) checks `define( 'NAME', '1.2.0' )` or `const NAME = '1.2.0'` in every PHP file outside `vendor/`, `node_modules/` and dot directories. A constant that isn't defined is a mismatch."},"1350":{"id":"/js/wp-release/v0.18.2/packaging-79","page_id":"/js/wp-release/v0.18.2/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.18.2/packaging#version-check","content":"`--git-tag` defaults to `GITHUB_REF` when it's a tag. `--git-tag-format` (default `{version}`) can have a prefix or the slug, like `v{version}` or `{slug}-{version}`; a leading `v` in the version is ignored, like for SVN tags."},"1351":{"id":"/js/wp-release/v0.19.0/changesets","page_id":"/js/wp-release/v0.19.0/changesets","type":"page","content":"Changesets","breadcrumbs":["Docs","Js","Wp release","v0.19.0"],"tags":[],"url":"/js/wp-release/v0.19.0/changesets"},"1352":{"id":"/js/wp-release/v0.19.0/changesets-0","page_id":"/js/wp-release/v0.19.0/changesets","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0/changesets#changesets-support","content":"Changesets support"},"1353":{"id":"/js/wp-release/v0.19.0/changesets-1","page_id":"/js/wp-release/v0.19.0/changesets","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0/changesets#single-project-repositories-without-a-config-file","content":"Single-project repositories without a config file"},"1354":{"id":"/js/wp-release/v0.19.0/changesets-2","page_id":"/js/wp-release/v0.19.0/changesets","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0/changesets#single-project-checks-in-github-actions","content":"Single-project checks in GitHub Actions"},"1355":{"id":"/js/wp-release/v0.19.0/changesets-3","page_id":"/js/wp-release/v0.19.0/changesets","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0/changesets#packages-and-tags","content":"Packages and tags"},"1356":{"id":"/js/wp-release/v0.19.0/changesets-4","page_id":"/js/wp-release/v0.19.0/changesets","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0/changesets#pre-releases","content":"Pre-releases"},"1357":{"id":"/js/wp-release/v0.19.0/changesets-5","page_id":"/js/wp-release/v0.19.0/changesets","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0/changesets#snapshots","content":"Snapshots"},"1358":{"id":"/js/wp-release/v0.19.0/changesets-6","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#changesets-support","content":"The changeset commands manage versioning, changelogs and release tags for single-package repositories and monorepos, including this repository. They read Changesets-style Markdown and load JavaScript configs with descriptors for npm and Composer manifests, plugin and theme headers, readme Stable tags, PHP constants, and Git tags. Use JavaScript configs with ESM (`export default`) or CommonJS (`module.exports`). Frontmatter uses `package-name: patch|minor|major` entries. For pre-releases, use the built-in pre-release workflow; the parser supports this simple frontmatter format rather than general YAML or the Changesets pre mode."},"1359":{"id":"/js/wp-release/v0.19.0/changesets-7","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#changesets-support","content":"PHP projects that don't use Node.js or JavaScript can run the same workflow with PHP Changesets, a Composer package that needs only PHP and Git. Its `changeset add`, `changeset status`, `changeset version` and `changeset tag` commands take the options of the `changeset-*` commands here, read the same changeset files and print the same release plans, with a PHP config file in place of `wp-release.config.*`. Use `wp-release` when the project already builds with Node.js, or to also build ZIPs, translations and WordPress.org deploys; see the comparison for the differences."},"1360":{"id":"/js/wp-release/v0.19.0/changesets-8","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#single-project-repositories-without-a-config-file","content":"The `changeset-*` commands can release one project at the repository root without a `wp-release.config.*` file. Run them from the root directory. With no version descriptor flags, they detect a root `package.json` or `composer.json` with a version, a plugin entry PHP file with a `Plugin Name` header, or a theme `style.css` with a `Theme Name` header. A detected plugin also updates the Stable tag in `readme.txt`, or `readme.md` when no Stable tag is found in `readme.txt`. Multiple version sources, multiple plugin entry files and npm workspaces require explicit descriptors or a config; files belonging to different projects aren't silently synchronized. A directory without a recognized version source still requires a config or explicit descriptors."},"1361":{"id":"/js/wp-release/v0.19.0/changesets-9","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#single-project-repositories-without-a-config-file","content":"For a root npm package, the complete workflow needs no project flags:"},"1362":{"id":"/js/wp-release/v0.19.0/changesets-10","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#single-project-repositories-without-a-config-file","content":"A single configured package is selected automatically for `changeset-add --bump` when `--since` isn't supplied, and for `changeset-tag --version`; `--since` still selects changed packages. npm and Composer projects use their root manifest's name as the changeset identifier when that manifest supplies the version; other projects use the root directory's basename. `--project-name <name>` pins the identifier of a repository without a manifest name, so local checkouts and CI don't need matching directory names; a config sets the same identifier with `id`. The fallback uses `.changeset/`, `CHANGELOG.md`, tags named `v{version}`, and the `origin` remote. There is no default comparison branch: pass `--since` or `--base-branch` when status checks should compare changes. Readme changelog updates are opt-in."},"1363":{"id":"/js/wp-release/v0.19.0/changesets-11","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#single-project-repositories-without-a-config-file","content":"Explicit descriptors replace automatic detection and define the entire version target list. For a plugin whose version appears in its header, readme and a PHP constant:"},"1364":{"id":"/js/wp-release/v0.19.0/changesets-12","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#single-project-repositories-without-a-config-file","content":"The same project flags belong on `changeset-add`, `changeset-status`, `changeset-version` and `changeset-tag`. Keep them consistent across all four commands, for example in command-specific npm scripts. An accompanying `package.json` used for build tools isn't changed unless it is included explicitly."},"1365":{"id":"/js/wp-release/v0.19.0/changesets-13","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#single-project-repositories-without-a-config-file","content":"| Flag                            | Version descriptor                     |\n| ------------------------------- | -------------------------------------- |\n| `--version-package-json <file>` | npm manifest version source and target |","table":"table-0"},"1366":{"id":"/js/wp-release/v0.19.0/changesets-14","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#single-project-repositories-without-a-config-file","content":"| Flag                             | Version descriptor                                                                                                       |\n| -------------------------------- | ------------------------------------------------------------------------------------------------------------------------ |\n| `--version-composer-json <file>` | Composer manifest version source and target; a target without a `version` field is skipped, while a source must have one |","table":"table-0"},"1367":{"id":"/js/wp-release/v0.19.0/changesets-15","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#single-project-repositories-without-a-config-file","content":"| Flag                                | Version descriptor                                |\n| ----------------------------------- | ------------------------------------------------- |\n| `--version-wordpress-plugin <file>` | WordPress plugin Version header source and target |","table":"table-0"},"1368":{"id":"/js/wp-release/v0.19.0/changesets-16","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#single-project-repositories-without-a-config-file","content":"| Flag                               | Version descriptor                               |\n| ---------------------------------- | ------------------------------------------------ |\n| `--version-wordpress-theme <file>` | WordPress theme Version header source and target |","table":"table-0"},"1369":{"id":"/js/wp-release/v0.19.0/changesets-17","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#single-project-repositories-without-a-config-file","content":"| Flag                                    | Version descriptor                                                                                        |\n| --------------------------------------- | --------------------------------------------------------------------------------------------------------- |\n| `--version-wordpress-stable-tag <file>` | WordPress readme Stable tag source and target; keeps its stable version during pre-releases and snapshots |","table":"table-0"},"1370":{"id":"/js/wp-release/v0.19.0/changesets-18","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#single-project-repositories-without-a-config-file","content":"| Flag                                       | Version descriptor                                  |\n| ------------------------------------------ | --------------------------------------------------- |\n| `--version-php-constant <file>#<constant>` | PHP `define()` or `const` version source and target |","table":"table-0"},"1371":{"id":"/js/wp-release/v0.19.0/changesets-19","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#single-project-repositories-without-a-config-file","content":"| Flag                          | Version descriptor                                                                                                      |\n| ----------------------------- | ----------------------------------------------------------------------------------------------------------------------- |\n| `--version-git-tag <pattern>` | Current version from existing stable Git tags, with a pattern such as `v{version}`; source-only, never a version target |","table":"table-0"},"1372":{"id":"/js/wp-release/v0.19.0/changesets-20","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#single-project-repositories-without-a-config-file","content":"File descriptor flags are repeatable. The source is inferred from a sole descriptor, or a unique descriptor other than a Stable tag. Otherwise use `--version-from <kind>`, where kind is `package-json`, `composer-json`, `wordpress-plugin`, `wordpress-theme`, `wordpress-stable-tag`, `php-constant` or `git-tag`. For repeated kinds, qualify the selector with the exact descriptor value: `--version-from package-json:package.json` or `--version-from 'php-constant:my-plugin.php#MY_PLUGIN_VERSION'`. Argument order doesn't select the source. A Git source requires a matching existing stable tag; its pattern selects the tags to read, while `--tag-format` controls tags to create. With multiple descriptors, explicitly select `git-tag` if it is the authoritative source."},"1373":{"id":"/js/wp-release/v0.19.0/changesets-21","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#single-project-repositories-without-a-config-file","content":"| Shared option           | Config equivalent                                                                                                       |\n| ----------------------- | ----------------------------------------------------------------------------------------------------------------------- |\n| `--project-name <name>` | `id`, the literal changeset identifier of the root package, instead of the manifest name or checkout directory basename |","table":"table-1"},"1374":{"id":"/js/wp-release/v0.19.0/changesets-22","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#single-project-repositories-without-a-config-file","content":"| Shared option            | Config equivalent                                                 |\n| ------------------------ | ----------------------------------------------------------------- |\n| `--base-branch <branch>` | `baseBranch`, used with the remote for the default comparison ref |","table":"table-1"},"1375":{"id":"/js/wp-release/v0.19.0/changesets-23","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#single-project-repositories-without-a-config-file","content":"| Shared option     | Config equivalent                                       |\n| ----------------- | ------------------------------------------------------- |\n| `--remote <name>` | `remote`, used for comparisons and pushing release tags |","table":"table-1"},"1376":{"id":"/js/wp-release/v0.19.0/changesets-24","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#single-project-repositories-without-a-config-file","content":"| Shared option            | Config equivalent                             |\n| ------------------------ | --------------------------------------------- |\n| `--changesets-dir <dir>` | `changesets`, relative to the repository root |","table":"table-1"},"1377":{"id":"/js/wp-release/v0.19.0/changesets-25","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#single-project-repositories-without-a-config-file","content":"| Shared option                                  | Config equivalent                                                |\n| ---------------------------------------------- | ---------------------------------------------------------------- |\n| `--readme-changelog` / `--no-readme-changelog` | `readmeChangelog`, independent of updating the readme Stable tag |","table":"table-1"},"1378":{"id":"/js/wp-release/v0.19.0/changesets-26","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#single-project-repositories-without-a-config-file","content":"| Shared option                       | Config equivalent                                                                                          |\n| ----------------------------------- | ---------------------------------------------------------------------------------------------------------- |\n| `--changelog-insert-after <marker>` | `changelogInsertAfter`; must exist in `CHANGELOG.md` and, with readme changelog updates, the plugin readme |","table":"table-1"},"1379":{"id":"/js/wp-release/v0.19.0/changesets-27","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#single-project-repositories-without-a-config-file","content":"| Shared option           | Config equivalent                               |\n| ----------------------- | ----------------------------------------------- |\n| `--tag-format <format>` | `tagFormat`, replacing the default `v{version}` |","table":"table-1"},"1380":{"id":"/js/wp-release/v0.19.0/changesets-28","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#single-project-repositories-without-a-config-file","content":"An explicit `--config` must load successfully. Otherwise a discovered config takes precedence over the single-project fallback. Single-project descriptor and settings flags cannot be mixed with a config file; put those settings in the config instead. The existing global `--tag-format` override works in both modes. Config files remain the place for package layouts, dependents, custom version and changelog callbacks, deployment destinations and distribution settings. Packaging and deployment commands retain their existing config requirements."},"1381":{"id":"/js/wp-release/v0.19.0/changesets-29","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#single-project-repositories-without-a-config-file","content":"Typical release flow, from a feature pull request to the publish workflows triggered by release tags:"},"1382":{"id":"/js/wp-release/v0.19.0/changesets-30","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#single-project-repositories-without-a-config-file","content":"An empty changeset marks a feature PR as no-release. The version workflow consumes it without changing versions, and a release PR containing only its deletion produces no tags."},"1383":{"id":"/js/wp-release/v0.19.0/changesets-31","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#single-project-repositories-without-a-config-file","content":"`version.from` selects the current version; `version.to` lists release targets. Use `phpConstantVersion( { file, constant } )` to sync a PHP constant."},"1384":{"id":"/js/wp-release/v0.19.0/changesets-32","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#single-project-checks-in-github-actions","content":"There are no dedicated build or changeset wrapper actions. Install the CLI in your project and run it directly. A root npm package can check a pull request with:"},"1385":{"id":"/js/wp-release/v0.19.0/changesets-33","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#single-project-checks-in-github-actions","content":"For a plugin with several version targets, put the same descriptor flags in npm scripts for all four changeset commands. Full Git history and tags are needed for comparisons, Git version sources and release notes. Keep the checkout directory name consistent when it supplies the changeset identifier. Directory artifacts use `npx --no-install wp-release build --output dist/my-plugin --github-output`; upload that directory with your artifact action. `build` writes manifest sidecars outside the directory and does not accept the ZIP-only embedding, codec or manifest-filename flags."},"1386":{"id":"/js/wp-release/v0.19.0/changesets-34","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#packages-and-tags","content":"The config describes the repository, so wp-release assumes no directory structure or naming convention of its own:"},"1387":{"id":"/js/wp-release/v0.19.0/changesets-35","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#packages-and-tags","content":"**Packages** are the directories that the `glob` of a `packages` entry matches under `root`, with `*`, `?` and `**`, like `plugins/*`, or `.` for a repository with one package at its root. The settings of an entry apply to each of its packages. Discovery never looks inside `.git`, `node_modules`, `vendor` or `dist` directories. A package is identified by its path, or with `idFrom` by the name in its `package.json` or `composer.json`, or with a literal `id` when the group matches exactly one package, and commands that take a package accept a path or identifier."},"1388":{"id":"/js/wp-release/v0.19.0/changesets-36","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#packages-and-tags","content":"**Templates** name the tags and the deploy targets of a package with these placeholders:"},"1389":{"id":"/js/wp-release/v0.19.0/changesets-37","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#packages-and-tags","content":"| Placeholder | Value                                                                 | `plugins/alpha` | Root package |\n| ----------- | --------------------------------------------------------------------- | --------------- | ------------ |\n| `{path}`    | Package directory relative to `root`, empty for a package at the root | `plugins/alpha` | (empty)      |","table":"table-2"},"1390":{"id":"/js/wp-release/v0.19.0/changesets-38","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#packages-and-tags","content":"| Placeholder | Value              | `plugins/alpha`                                     | Root package                             |\n| ----------- | ------------------ | --------------------------------------------------- | ---------------------------------------- |\n| `{name}`    | Package identifier | `plugins/alpha`, or its manifest name with `idFrom` | the manifest name, or the directory name |","table":"table-2"},"1391":{"id":"/js/wp-release/v0.19.0/changesets-39","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#packages-and-tags","content":"| Placeholder | Value            | `plugins/alpha` | Root package |\n| ----------- | ---------------- | --------------- | ------------ |\n| `{version}` | Released version | `1.2.0`         | `1.2.0`      |","table":"table-2"},"1392":{"id":"/js/wp-release/v0.19.0/changesets-40","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#packages-and-tags","content":"Deploy templates also have `{branch}`, `{ref}` and `{revision}` (see Deploy configured packages), and any template can be a callback that receives the package, for names that the placeholders don't cover, like the last directory of the path."},"1393":{"id":"/js/wp-release/v0.19.0/changesets-41","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#packages-and-tags","content":"**`tagFormat`** names the release tags, `{path}/{version}` by default, like `plugins/alpha/1.2.0`. Empty placeholders leave no leading or repeated slashes in a tag, so a package at the root gets plain version tags, like `1.2.0`, from the same default. Deploy templates, like repository URLs, are filled in as they are. A `gitTagVersion()` version source reads the tags with its own `pattern`, also `{path}/{version}` by default, so set both when you change the format."},"1394":{"id":"/js/wp-release/v0.19.0/changesets-42","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#packages-and-tags","content":"**`releaseTitle`** titles the release, like the `title` that `changeset-tag` reports for creating a GitHub Release. The default is `name@version`, like `plugins/alpha@1.2.0`, without the prefix for a package at the repository root, which is titled `1.2.0` like its tag. Like `tagFormat`, it supports `{name}`, `{path}`, `{version}` and `{tag}` placeholders: `releaseTitle: '{version} (beta)'`, or a callback that receives `{ package, version, tag }` like the release notes callback. A template without a placeholder fails at load time, since it would name every release alike. `changeset-tag --release-title <template>` replaces the `releaseTitle` of the config for one command, like `--tag-format` replaces `tagFormat`."},"1395":{"id":"/js/wp-release/v0.19.0/changesets-43","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#packages-and-tags","content":"**`--tag-format <format>`** replaces the `tagFormat` of the config for one command, for a workflow or job that names its tags differently, like `--tag-format '{name}@{version}'`. Every command that creates or reads the same tags needs the same format: `changeset-tag`, which creates them and finds the previous tag for the release notes, `changeset-version --prerelease`, which numbers pre-releases from them, and `deploy-git` and `deploy-svn --release-ref`, which read the package and version of a tag."},"1396":{"id":"/js/wp-release/v0.19.0/changesets-44","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#packages-and-tags","content":"**Slugs** are a WordPress concept: the folder of a plugin or theme. Only the commands that produce something for WordPress use one: the `{slug}/` root folder and name of a `zip`, the `checksums` manifest, the WordPress.org slug of `deploy-svn`, and `version-check`. Each takes `--slug`, which defaults to the name of the working directory, or of the package directory with `zip --package`, and an SVN deploy target takes `slug`, which defaults to the name of the package directory. Tags and Git deploy targets don't have a slug."},"1397":{"id":"/js/wp-release/v0.19.0/changesets-45","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#packages-and-tags","content":"**`remote`** is the git remote that `changeset-tag --push` pushes tags to and that the base branch is compared on, `origin` by default."},"1398":{"id":"/js/wp-release/v0.19.0/changesets-46","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#packages-and-tags","content":"The default strategy bumps stable `x.y.z` versions with SemVer rules, and the `x.y` and `x.y.z.w` versions common in WordPress plugins the same way: the bumped part is raised, the parts after it reset to `0`, and the version keeps its number of parts. A minor bump of `2.1` is `2.2` and a major bump is `3.0`, while a patch bump adds the third part, `2.1.1`. A patch bump of `1.2.3.4` is `1.2.4.0`, so raising only the fourth part needs a custom strategy. Configure `nextVersion( { package, bump, currentVersion, changesets } )` for other formats; changeset bumps remain `patch`, `minor` or `major`. Pre-releases are added to the next version with `--prerelease`, described below."},"1399":{"id":"/js/wp-release/v0.19.0/changesets-47","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#packages-and-tags","content":"Without `--since`, `changeset-status` compares against `<remote>/<baseBranch>`, where `remote` in the config defaults to `origin` and is also the remote that `changeset-tag --push` pushes tags to; fetch that ref or pass `--since` when using a fork or different upstream. `loadChangesetConfig()` discovers a conventional config at the repository root, unless `--config <path>` selects one explicitly."},"1400":{"id":"/js/wp-release/v0.19.0/changesets-48","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#packages-and-tags","content":"Add release notes in a feature PR with `npx wp-release changeset-add`. In a terminal, it lists the packages, marks the ones that changed since `<remote>/<baseBranch>` (or `--since <ref>`) without a changeset, and asks for the packages to release, a `patch`, `minor` or `major` bump for each, and the release note. Choose packages by number, identifier or path, or press Enter to release the changed ones; `none` adds an empty changeset. Changed files include uncommitted and untracked ones, since changesets are usually added before committing."},"1401":{"id":"/js/wp-release/v0.19.0/changesets-49","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#packages-and-tags","content":"Without a terminal, or for scripts, pass the changeset as options: `npx wp-release changeset-add --package @vendor/plugin --bump patch --summary \"Fix the checkout validation.\"`. Repeat package and bump flags for multiple packages, or use `--empty` when no release is needed. A package can also be named by its path under `root`, like `plugins/alpha`, and the changeset records its identifier; `changeset-version --package` and `changeset-tag --package` accept paths too. A single `--bump` without `--package` releases every changed package without a changeset, like `changeset-add --bump patch --summary \"…\"` to fix a failing `changeset-status` check. `--json` and `--github-output` never ask."},"1402":{"id":"/js/wp-release/v0.19.0/changesets-50","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#packages-and-tags","content":"In CI, `changeset-status --since origin/main` requires a changeset added by the PR; changesets already on the base do not count, while an empty PR changeset records an explicit no-release decision. Missing-change annotations identify an affected file."},"1403":{"id":"/js/wp-release/v0.19.0/changesets-51","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#packages-and-tags","content":"On the release branch, preview with `changeset-version --dry-run`, then run `changeset-version` to update version targets and changelogs. By default, new Markdown entries go before the first version heading; `changelogInsertAfter` sets a literal insertion marker for `CHANGELOG.md` and, with `readmeChangelog`, the plugin readme. Put the marker in both files; a missing marker is an error. Without a marker, plugin readmes use the `== Changelog ==` heading. Failed updates are rolled back for safe retries."},"1404":{"id":"/js/wp-release/v0.19.0/changesets-52","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#packages-and-tags","content":"Configure `changelogEntry( { package, changeset, commit } )` to format the changelog entry of each changeset, where `commit` is the `{ hash, shortHash, subject }` of the commit that added the changeset file, if it's committed. The formatted entries go into `CHANGELOG.md`, the `changelog` of each release in the `changeset-version` result, and so the release notes; plugin readmes keep the plain summaries. Without the callback, entries are the plain summaries. For example, to link each entry to its commit:"},"1405":{"id":"/js/wp-release/v0.19.0/changesets-53","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#packages-and-tags","content":"Configure `dependents` to re-release packages that bundle a package when it releases. The dependents come from what the packages declare: a package is a dependent of a source when the spec that it declares in its npm `dependencies` or `optionalDependencies` (or the sections that the policy adds) resolves the current version of the source or points at the workspace, and it re-releases when the next version of the source falls outside the declared range, or always with `when: 'always'`. A pin to an older version selects a registry release instead and `changeset-status` warns about the drift until the pin resolves the package again. Versioning a dependent rewrites its declared specs of the source to the released version, keeping their range prefixes, so an exact pin matches the released workspace again and the built bundle matches the changelog. Wildcards and unpinned ranges accept the release without one, like the `devDependencies` of a package. The derived dependents appear in `changeset-status`, `changeset-version` and `changeset-tag` like any other release, and a dependent that releases for its own reasons keeps its own bump and appends the bundle note:"},"1406":{"id":"/js/wp-release/v0.19.0/changesets-54","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#packages-and-tags","content":"Excluded packages still release with their own changesets and stay out of the automatic re-releases."},"1407":{"id":"/js/wp-release/v0.19.0/changesets-55","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#packages-and-tags","content":"When the changesets of a pull request release a source, `changeset-status` requires no changeset for a dependent whose only change is the spec of that source in its `package.json`, since versioning rewrites the spec and the bundle note announces it. Any other change to the dependent, like another manifest field or dependency, documentation or code, needs its own changeset."},"1408":{"id":"/js/wp-release/v0.19.0/changesets-56","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#packages-and-tags","content":"The bundle changelog entry defaults to `Bundle <source> <version>.` and is formatted with `dependents.changelog( { package, source } )`:"},"1409":{"id":"/js/wp-release/v0.19.0/changesets-57","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#packages-and-tags","content":"`dependents.sections` lists the npm dependency sections that declare a source, defaulting to `dependencies` and `optionalDependencies`; add `devDependencies` for dependencies that end up in the dependent's build, or `peerDependencies` to scan them."},"1410":{"id":"/js/wp-release/v0.19.0/changesets-58","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#packages-and-tags","content":"The `dependents.dependency` hooks extend the built-in npm scan instead of replacing it, so that both work behind the same range rule and rewrite:"},"1411":{"id":"/js/wp-release/v0.19.0/changesets-59","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#packages-and-tags","content":"After versioning, run `npm install --package-lock-only` so that the root lockfile resolves the rewritten pins to the workspace links again; the `Prepare Release` workflow (`prepare-release.yml` in this monorepo) does it with its release pull request."},"1412":{"id":"/js/wp-release/v0.19.0/changesets-60","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#packages-and-tags","content":"To release packages separately, for example with a release pull request for each, pass `--package <name>`, repeatable, to version only those packages. A changeset that also names other packages keeps only their entries and its summary, so it still applies to their releases with the same bump. Changesets without packages are left for a run without `--package`."},"1413":{"id":"/js/wp-release/v0.19.0/changesets-61","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#packages-and-tags","content":"The `changeset-version` result lists each release with its `package`, `bump`, `currentVersion`, `nextVersion` and `changelog` entries, a Markdown list like the one added to `CHANGELOG.md`. Use it to name and describe the release pull request in a repository script, or call `versionChangesets()` from the library and format the entries of each release with `formatChangelogEntries( release.changesets )`."},"1414":{"id":"/js/wp-release/v0.19.0/changesets-62","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#packages-and-tags","content":"After merging the release PR, `changeset-tag --since <merge-commit>^1 --push` pushes tags only for packages changed by that release. It pushes one tag at a time because GitHub doesn't trigger workflows for a push of more than three tags. wp-release doesn't create GitHub Releases: with `--json` or `--github-output`, each entry of `tags` has the `tag`, a `title` like `plugins/alpha@1.2.0` or, for a package at the repository root, the release title like `1.2.0` (see releaseTitle, and `--release-title` for overriding it in one command), the release `notes` and a `prerelease` flag, for a workflow step like `softprops/action-gh-release` to create the release (see the example below). For initial adoption, preview all missing tags with `changeset-tag --dry-run` (without `--since`), then push if needed. To release each package with a separate workflow instead, `changeset-tag --since <merge-commit>^1 --untagged --github-output` lists the releases that don't have a tag yet, without creating any. Tag pushes need Git write credentials."},"1415":{"id":"/js/wp-release/v0.19.0/changesets-63","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#packages-and-tags","content":"To release a single package, for example from a manual workflow, pass `--package <name>`, repeatable, and with one package `--version <version>` to fail unless the package is at that version. Packages versioned by git tags have no version file, so for them `--version` is the version to tag. Before a tag is created, every `version.to` target must match the version, so a plugin `Version` header that disagrees with its readme `Stable tag` blocks the tag. Versions with a pre-release part, like `1.0.0-rc.1`, have `prerelease` set, so their GitHub Releases can be marked as pre-releases. This example selects one package, so `tags[0]` is its release; these fields are nested in the JSON result:"},"1416":{"id":"/js/wp-release/v0.19.0/changesets-64","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#packages-and-tags","content":"The release notes are the version's `CHANGELOG.md` section, or without one the commits that changed the package since its previous tag, the highest version below the released one, skipping pre-releases for a stable version. Configure `releaseNotes( { package, version, tag, previousTag, changelog, commits, notes } )` to format them, for example to add links; `notes` is the default text and `commits` lists `{ hash, shortHash, subject }`, newest first. `changeset-tag --package <name> --dry-run` prints them without creating the tag."},"1417":{"id":"/js/wp-release/v0.19.0/changesets-65","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#packages-and-tags","content":"For local development, run the TypeScript source with `npm run wp-release -- <command>` (for example, `npm run wp-release -- changeset-status --since origin/main`). GitHub workflows use the same CLI for versioning and tagging. `SUBTREE_DEPLOY_TOKEN` lets them update the release PR and push tags, and the `Tag Release` workflow passes it to `softprops/action-gh-release` to create the GitHub Releases."},"1418":{"id":"/js/wp-release/v0.19.0/changesets-66","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#pre-releases","content":"`changeset-version --prerelease <id>` (the `prerelease` option of `versionChangesets()`) releases pre-releases of the next versions, like `1.3.0-rc.1` for a minor bump of `1.2.0`. The identifier, like `alpha`, `beta` or `rc`, can have a number, like `rc.2`, which is used as is and fails when the version is already tagged. Without a number, the number is one above the highest existing tag of that identifier and next stable version, read with the `tagFormat` of the package, so the first one is `rc.1`, and the numbering starts again at `.1` when later changesets raise the next version. The dependents of a source become pre-releases too, so that they bundle its pre-release, unless they're left out with `--no-dependents`."},"1419":{"id":"/js/wp-release/v0.19.0/changesets-67","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#pre-releases","content":"A pre-release writes every version target except the readme `Stable tag`, which keeps the last stable version since WordPress.org offers it to every site, and `changeset-tag` skips the `Stable tag` when it verifies a pre-release. The changelog gets a section for the pre-release, like `## 1.3.0-rc.1 (2026-10-12)`, so that `changeset-tag` finds its release notes, and the changesets are consumed like in any release."},"1420":{"id":"/js/wp-release/v0.19.0/changesets-68","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#pre-releases","content":"Since a pre-release consumes the changesets that the stable release needs, run it on a branch that isn't merged, and tag that branch commit:"},"1421":{"id":"/js/wp-release/v0.19.0/changesets-69","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#pre-releases","content":"The base branch keeps its stable versions and pending changesets, so the stable release later versions them as usual, in one changelog section. The tag keeps the pre-release commit reachable after the branch is reset or deleted. The release notes of a stable release compare with the previous stable release, skipping the pre-releases before it, and the `git-tag` version source ignores pre-release tags, so packages versioned by git tags keep building on their last stable version."},"1422":{"id":"/js/wp-release/v0.19.0/changesets-70","page_id":"/js/wp-release/v0.19.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/changesets#snapshots","content":"`changeset-version --snapshot <id>` (the `snapshot` option of `versionChangesets()`) releases snapshots of the next versions for test builds, like `1.3.0-pr-251.20261012183005` for a pull request: the next version with the identifier, like `pr-251` or `pr-251.0abc123` with a commit hash, and the UTC time, so that every snapshot is unique and they sort by time. Snapshots aren't numbered from tags and can't be combined with `--prerelease`. Like a pre-release, a snapshot writes every version target except the readme `Stable tag`. Build and publish the versioned files without committing them, for example under an npm dist-tag like `pr-251`, since a snapshot consumes the changesets:"},"1423":{"id":"/js/wp-release/v0.19.0/cli","page_id":"/js/wp-release/v0.19.0/cli","type":"page","content":"CLI","breadcrumbs":["Docs","Js","Wp release","v0.19.0"],"tags":[],"url":"/js/wp-release/v0.19.0/cli"},"1424":{"id":"/js/wp-release/v0.19.0/cli-0","page_id":"/js/wp-release/v0.19.0/cli","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0/cli#cli","content":"CLI"},"1425":{"id":"/js/wp-release/v0.19.0/cli-1","page_id":"/js/wp-release/v0.19.0/cli","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0/cli#github-actions-annotations-and-job-summaries","content":"GitHub Actions annotations and job summaries"},"1426":{"id":"/js/wp-release/v0.19.0/cli-2","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#cli","content":"| Command                                                    | Description                                   |\n| ---------------------------------------------------------- | --------------------------------------------- |\n| `wp-release build [<source-dir>] --output <dir> [options]` | Copy selected release files into a directory. |","table":"table-0"},"1427":{"id":"/js/wp-release/v0.19.0/cli-3","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#cli","content":"| Command                                   | Description                                                                  |\n| ----------------------------------------- | ---------------------------------------------------------------------------- |\n| `wp-release zip [<source-dir>] [options]` | Create a ZIP archive with a `{slug}/` root folder, respecting `.distignore`. |","table":"table-0"},"1428":{"id":"/js/wp-release/v0.19.0/cli-4","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#cli","content":"| Command                                         | Description                                                                         |\n| ----------------------------------------------- | ----------------------------------------------------------------------------------- |\n| `wp-release checksums [<source-dir>] [options]` | Write the MD5 and SHA-256 hashes of every distributed file to a checksums manifest. |","table":"table-0"},"1429":{"id":"/js/wp-release/v0.19.0/cli-5","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#cli","content":"| Command                               | Description                                                                                                            |\n| ------------------------------------- | ---------------------------------------------------------------------------------------------------------------------- |\n| `wp-release sign <file>... [options]` | Sign files with Ed25519, writing a detached `<file>.sig` next to each, or minisign and SSH signatures with `--format`. |","table":"table-0"},"1430":{"id":"/js/wp-release/v0.19.0/cli-6","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#cli","content":"| Command             | Description                                                                                      |\n| ------------------- | ------------------------------------------------------------------------------------------------ |\n| `wp-release keygen` | Generate a base64 Ed25519 private seed and its public key, also as minisign and SSH public keys. |","table":"table-0"},"1431":{"id":"/js/wp-release/v0.19.0/cli-7","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#cli","content":"| Command                                                         | Description                                                                |\n| --------------------------------------------------------------- | -------------------------------------------------------------------------- |\n| `wp-release verify [<source-dir>] --checksums <file> [options]` | Check a plugin or theme directory, or a ZIP, against a checksums manifest. |","table":"table-0"},"1432":{"id":"/js/wp-release/v0.19.0/cli-8","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#cli","content":"| Command                                             | Description                                                                            |\n| --------------------------------------------------- | -------------------------------------------------------------------------------------- |\n| `wp-release version-check [<source-dir>] [options]` | Check that the `Version` header, readme `Stable tag`, PHP constants and git tag agree. |","table":"table-0"},"1433":{"id":"/js/wp-release/v0.19.0/cli-9","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#cli","content":"| Command                                          | Description                                                 |\n| ------------------------------------------------ | ----------------------------------------------------------- |\n| `wp-release deploy-svn [<source-dir>] [options]` | Deploy a plugin to the WordPress.org plugin SVN repository. |","table":"table-0"},"1434":{"id":"/js/wp-release/v0.19.0/cli-10","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#cli","content":"| Command                                                          | Description                                                                             |\n| ---------------------------------------------------------------- | --------------------------------------------------------------------------------------- |\n| `wp-release deploy-git [<source-dir>] --git-url <url> [options]` | Deploy the files of a plugin, theme or package to a Git repository as a release commit. |","table":"table-0"},"1435":{"id":"/js/wp-release/v0.19.0/cli-11","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#cli","content":"| Command                                                                 | Description                                                                     |\n| ----------------------------------------------------------------------- | ------------------------------------------------------------------------------- |\n| `wp-release deploy-git --release-ref <ref> [--package <name>] [--list]` | Deploy the configured packages of a release tag or branch to their Git targets. |","table":"table-0"},"1436":{"id":"/js/wp-release/v0.19.0/cli-12","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#cli","content":"| Command                                                                 | Description                                                     |\n| ----------------------------------------------------------------------- | --------------------------------------------------------------- |\n| `wp-release deploy-svn --release-ref <ref> [--package <name>] [--list]` | Deploy the configured plugin of a release tag to WordPress.org. |","table":"table-0"},"1437":{"id":"/js/wp-release/v0.19.0/cli-13","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#cli","content":"| Command                                        | Description                                                |\n| ---------------------------------------------- | ---------------------------------------------------------- |\n| `wp-release i18n-pot [<source-dir>] [options]` | Extract translatable strings into a reproducible POT file. |","table":"table-0"},"1438":{"id":"/js/wp-release/v0.19.0/cli-14","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#cli","content":"| Command                                          | Description                                               |\n| ------------------------------------------------ | --------------------------------------------------------- |\n| `wp-release i18n-audit [<source-dir>] [options]` | Report translation string problems without writing files. |","table":"table-0"},"1439":{"id":"/js/wp-release/v0.19.0/cli-15","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#cli","content":"| Command                                  | Description                           |\n| ---------------------------------------- | ------------------------------------- |\n| `wp-release i18n-mo <file.po> [options]` | Compile a translated PO file into MO. |","table":"table-0"},"1440":{"id":"/js/wp-release/v0.19.0/cli-16","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#cli","content":"| Command                                                      | Description                                                                              |\n| ------------------------------------------------------------ | ---------------------------------------------------------------------------------------- |\n| `wp-release i18n-json <file.po> --domain <domain> [options]` | Compile the JavaScript strings of a translated PO file into WordPress script JSON files. |","table":"table-0"},"1441":{"id":"/js/wp-release/v0.19.0/cli-17","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#cli","content":"| Command                                   | Description                                                     |\n| ----------------------------------------- | --------------------------------------------------------------- |\n| `wp-release i18n-php <file.po> [options]` | Compile a translated PO file into a WordPress `.l10n.php` file. |","table":"table-0"},"1442":{"id":"/js/wp-release/v0.19.0/cli-18","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#cli","content":"| Command                              | Description                                  |\n| ------------------------------------ | -------------------------------------------- |\n| `wp-release changeset-add [options]` | Record the release impact of a pull request. |","table":"table-0"},"1443":{"id":"/js/wp-release/v0.19.0/cli-19","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#cli","content":"| Command                                 | Description                                                      |\n| --------------------------------------- | ---------------------------------------------------------------- |\n| `wp-release changeset-status [options]` | List pending releases and check changed packages for changesets. |","table":"table-0"},"1444":{"id":"/js/wp-release/v0.19.0/cli-20","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#cli","content":"| Command                                  | Description                                |\n| ---------------------------------------- | ------------------------------------------ |\n| `wp-release changeset-version [options]` | Apply version bumps and changelog entries. |","table":"table-0"},"1445":{"id":"/js/wp-release/v0.19.0/cli-21","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#cli","content":"| Command                              | Description                          |\n| ------------------------------------ | ------------------------------------ |\n| `wp-release changeset-tag [options]` | Create missing package release tags. |","table":"table-0"},"1446":{"id":"/js/wp-release/v0.19.0/cli-22","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#cli","content":"Run `npx wp-release <command> --help` for the options of each command. Directory-based commands accept a first `<source-dir>` argument or `--source-dir`, defaulting to the current directory. `sign` and the `i18n-mo`, `i18n-json` and `i18n-php` compilers take file arguments, `keygen` generates keys, and changeset commands operate on the configured repository. Every command prints its result as JSON with `--json`. Commands that take no positional arguments, like the changeset commands, reject bare arguments with the usage instead of ignoring them."},"1447":{"id":"/js/wp-release/v0.19.0/cli-23","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#cli","content":"In GitHub Actions, `--github-output` writes the complete result as JSON to `steps.<id>.outputs.result` and exposes each top-level string, number or boolean as a plain output. Use `steps.zip.outputs.zipPath` for a ZIP path, for example. Arrays and objects remain in `result`: tag metadata is read with `fromJSON( steps.tag.outputs.result ).tags[0].tag`, even when only one package is selected. There is no plain `steps.tag.outputs.tag` output."},"1448":{"id":"/js/wp-release/v0.19.0/cli-24","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#cli","content":"Prefer plain outputs in steps that run conditionally, since a skipped step has empty outputs. When reading JSON from a step that may be skipped, use a fallback such as `fromJSON( steps.tag.outputs.result || '{\"tags\":[]}' ).tags[0].tag`. For several tags or deploys, read the arrays in `result` to build a job matrix or process each item."},"1449":{"id":"/js/wp-release/v0.19.0/cli-25","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#github-actions-annotations-and-job-summaries","content":"With the `github` log format, the CLI uses current GitHub Actions features to report problems where you look for them, instead of only in the log. `--log-format <name>` picks how the CLI logs, separately from the result that `--json` prints:"},"1450":{"id":"/js/wp-release/v0.19.0/cli-26","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#github-actions-annotations-and-job-summaries","content":"| Log format | Output                                          |\n| ---------- | ----------------------------------------------- |\n| `text`     | Plain text. The default outside GitHub Actions. |","table":"table-1"},"1451":{"id":"/js/wp-release/v0.19.0/cli-27","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#github-actions-annotations-and-job-summaries","content":"| Log format | Output                                                                                                              |\n| ---------- | ------------------------------------------------------------------------------------------------------------------- |\n| `github`   | GitHub Actions annotations and job summaries. The default when `GITHUB_ACTIONS=true`. `--ci` is a shorthand for it. |","table":"table-1"},"1452":{"id":"/js/wp-release/v0.19.0/cli-28","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#github-actions-annotations-and-job-summaries","content":"Pass `--log-format text` for plain text in GitHub Actions. The GitHub Actions always use the `github` log format. Only the CLI checks `GITHUB_ACTIONS`: the library classes don't read the environment, and choose the format by the writer they get."},"1453":{"id":"/js/wp-release/v0.19.0/cli-29","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#github-actions-annotations-and-job-summaries","content":"Errors, warnings and notices are printed as workflow commands, so they show up as annotations on the run and on the files of a pull request:"},"1454":{"id":"/js/wp-release/v0.19.0/cli-30","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#github-actions-annotations-and-job-summaries","content":"`version-check` and `deploy-svn` annotate each version mismatch on the file and line of the version: the `Version` header, the readme `Stable tag` or the PHP constant."},"1455":{"id":"/js/wp-release/v0.19.0/cli-31","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#github-actions-annotations-and-job-summaries","content":"`verify` annotates each changed file and each file that isn't in the checksums."},"1456":{"id":"/js/wp-release/v0.19.0/cli-32","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#github-actions-annotations-and-job-summaries","content":"Each command also adds a section to the job summary of the run, when `GITHUB_STEP_SUMMARY` is set:"},"1457":{"id":"/js/wp-release/v0.19.0/cli-33","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#github-actions-annotations-and-job-summaries","content":"| Command      | Summary                                                                                                                                                                                            |\n| ------------ | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `deploy-svn` | Plugin, linked to its WordPress.org page, version, written SVN paths, the commit linked to its WordPress.org changeset (or the dry run or no-op result), and the SVN changes in a collapsed table. |","table":"table-2"},"1458":{"id":"/js/wp-release/v0.19.0/cli-34","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#github-actions-annotations-and-job-summaries","content":"| Command      | Summary                                                   |\n| ------------ | --------------------------------------------------------- |\n| `deploy-git` | Repository, release commit and the pushed branch and tag. |","table":"table-2"},"1459":{"id":"/js/wp-release/v0.19.0/cli-35","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#github-actions-annotations-and-job-summaries","content":"| Command | Summary                                                                                               |\n| ------- | ----------------------------------------------------------------------------------------------------- |\n| `build` | Output directory, number of copied files and optional manifest; requested signatures and public keys. |","table":"table-2"},"1460":{"id":"/js/wp-release/v0.19.0/cli-36","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#github-actions-annotations-and-job-summaries","content":"| Command | Summary                                                                                                                |\n| ------- | ---------------------------------------------------------------------------------------------------------------------- |\n| `zip`   | ZIP, number of files and checksums manifest; with `--sign`, signature files and the public key of each written format. |","table":"table-2"},"1461":{"id":"/js/wp-release/v0.19.0/cli-37","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#github-actions-annotations-and-job-summaries","content":"| Command     | Summary                       |\n| ----------- | ----------------------------- |\n| `checksums` | Manifest and number of files. |","table":"table-2"},"1462":{"id":"/js/wp-release/v0.19.0/cli-38","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#github-actions-annotations-and-job-summaries","content":"| Command | Summary                                                    |\n| ------- | ---------------------------------------------------------- |\n| `sign`  | Signature files and the public key of each written format. |","table":"table-2"},"1463":{"id":"/js/wp-release/v0.19.0/cli-39","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#github-actions-annotations-and-job-summaries","content":"| Command  | Summary                                                                                  |\n| -------- | ---------------------------------------------------------------------------------------- |\n| `verify` | That all files match, or the counts and a table of the changed, missing and extra files. |","table":"table-2"},"1464":{"id":"/js/wp-release/v0.19.0/cli-40","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#github-actions-annotations-and-job-summaries","content":"| Command         | Summary                                                                        |\n| --------------- | ------------------------------------------------------------------------------ |\n| `version-check` | The matching version, or a table of the mismatches with their files and lines. |","table":"table-2"},"1465":{"id":"/js/wp-release/v0.19.0/cli-41","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#github-actions-annotations-and-job-summaries","content":"| Command            | Summary                                               |\n| ------------------ | ----------------------------------------------------- |\n| `changeset-status` | Each changed package with whether it has a changeset. |","table":"table-2"},"1466":{"id":"/js/wp-release/v0.19.0/cli-42","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#github-actions-annotations-and-job-summaries","content":"| Command             | Summary                                                               |\n| ------------------- | --------------------------------------------------------------------- |\n| `changeset-version` | A table of the package releases with their version changes and bumps. |","table":"table-2"},"1467":{"id":"/js/wp-release/v0.19.0/cli-43","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#github-actions-annotations-and-job-summaries","content":"| Command         | Summary                                                                                  |\n| --------------- | ---------------------------------------------------------------------------------------- |\n| `changeset-tag` | Each tag with its previous tag and status, and its release notes in a collapsed section. |","table":"table-2"},"1468":{"id":"/js/wp-release/v0.19.0/cli-44","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#github-actions-annotations-and-job-summaries","content":"A failed command adds its error to the summary, or a table of its problems with their files and lines, listing up to 100 and counting the rest. The Markdown of the summaries isn't part of the library API. File paths are relative to `GITHUB_WORKSPACE`, or the current directory without it. Files outside it, like those of an extracted ZIP, get an annotation without a file. Multi-line messages stay one annotation."},"1469":{"id":"/js/wp-release/v0.19.0/cli-45","page_id":"/js/wp-release/v0.19.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/cli#github-actions-annotations-and-job-summaries","content":"Use global `--config <path>` to select a config; relative paths resolve from the current directory. Otherwise, commands using the config discover `wp-release.config.js`, `.mjs` or `.cjs` at the repository root. Global `--tag-format <format>` replaces the `tagFormat` of the config for one command, see Packages and tags."},"1470":{"id":"/js/wp-release/v0.19.0/comparison","page_id":"/js/wp-release/v0.19.0/comparison","type":"page","content":"Comparison with other tools","breadcrumbs":["Docs","Js","Wp release","v0.19.0"],"tags":[],"url":"/js/wp-release/v0.19.0/comparison"},"1471":{"id":"/js/wp-release/v0.19.0/comparison-0","page_id":"/js/wp-release/v0.19.0/comparison","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0/comparison#comparison-with-existing-tools","content":"Comparison with existing tools"},"1472":{"id":"/js/wp-release/v0.19.0/comparison-1","page_id":"/js/wp-release/v0.19.0/comparison","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/comparison#comparison-with-existing-tools","content":"| Tool                                                             | What it does                                                                                                                                                                                                                                                                                                                | How `wp-release` differs                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |\n| ---------------------------------------------------------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| 10up WordPress.org plugin deploy and readme/asset update actions | Two separate GitHub Actions configured through env vars. A deploy always syncs the build to `trunk/` and copies it to the tag; readme and asset updates need the second action. Assets come from `.wordpress-org` by default, and files are selected with `.distignore` or `.gitattributes`. Files are synced with `rsync`. | One `deploy-svn` command with independent write flags, so a release, a readme-only update and an assets-only update are the same command with different flags. Runs locally and in any CI, not only GitHub Actions, and syncs in Node.js without `rsync`. Checks that the `Version` header, readme `Stable tag` and SVN tag agree before writing, which the 10up actions don't. Assets are deployed only when `--assets-dir` is passed, instead of always syncing `.wordpress-org` when it exists, so a plugin's own `assets/` folder is never uploaded by accident. Adds `--exclude` for patterns without an ignore file, opt-in Git `export-ignore` support and `--from-zip` to deploy the exact files of a ZIP. |","table":"table-0"},"1473":{"id":"/js/wp-release/v0.19.0/comparison-2","page_id":"/js/wp-release/v0.19.0/comparison","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/comparison#comparison-with-existing-tools","content":"| Tool              | What it does                                                                                                     | How `wp-release` differs                                                                                                                                                                  |\n| ----------------- | ---------------------------------------------------------------------------------------------------------------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `grunt-wp-deploy` | Grunt task with `deploy_trunk` and `deploy_tag` booleans, interactive password prompts and a `Stable tag` check. | No Grunt dependency and never interactive. `--readme-only` is a separate flag, where `grunt-wp-deploy` can only update trunk with the full build. Assets are independent of trunk writes. |","table":"table-0"},"1474":{"id":"/js/wp-release/v0.19.0/comparison-3","page_id":"/js/wp-release/v0.19.0/comparison","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/comparison#comparison-with-existing-tools","content":"| Tool                  | What it does                                                                     | How `wp-release` differs                                                                                                           |\n| --------------------- | -------------------------------------------------------------------------------- | ---------------------------------------------------------------------------------------------------------------------------------- |\n| codeinwp theme deploy | Fork of the 10up plugin action that commits themes to the themes SVN repository. | Doesn't deploy themes. Theme releases are ZIP uploads on WordPress.org; `zip` builds the upload with the theme folder as the root. |","table":"table-0"},"1475":{"id":"/js/wp-release/v0.19.0/comparison-4","page_id":"/js/wp-release/v0.19.0/comparison","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/comparison#comparison-with-existing-tools","content":"| Tool              | What it does                                                                                             | How `wp-release` differs                                                                                                                                                                                                                                                                                                                                                                      |\n| ----------------- | -------------------------------------------------------------------------------------------------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `wp dist-archive` | WP-CLI command that zips a project using `.distignore`, with `--plugin-dirname` and `--filename-format`. | Same `.distignore` file and `{name}.{version}` style filename format, but needs only Node.js instead of PHP and WP-CLI. `.distignore` is matched with full gitignore syntax, including `!` negation, and `--distignore` / `--exclude` let you point at another ignore file or add patterns on the command line. Builds are reproducible, and `--checksums` writes a manifest next to the ZIP. |","table":"table-0"},"1476":{"id":"/js/wp-release/v0.19.0/comparison-5","page_id":"/js/wp-release/v0.19.0/comparison","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/comparison#comparison-with-existing-tools","content":"| Tool               | What it does                                                                                                                                                                                                        | How `wp-release` differs                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |\n| ------------------ | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `wp i18n make-pot` | WP-CLI command that extracts PHP, JavaScript, `block.json` and `theme.json` strings into a POT, with `--domain`, `--include`/`--exclude`, `--headers`, `--file-comment`, `--merge`/`--subtract` and audit warnings. | `i18n-pot` and `i18n-audit` need only Node.js, write byte-for-byte reproducible POTs without dates, and `--check` fails CI on a stale POT. Headers are set one at a time with a repeatable `--header NAME=VALUE` instead of a JSON object, and `--include`/`--exclude` take one glob each, so patterns never need escaping or comma splitting. `--add-location`, `--no-location` and `--all-domains` say what they do, and `--add-location file` drops line numbers so that unrelated edits don't make the POT stale. Monorepos keep these settings once in `wp-release.config.js` and select packages with `--package` or `--all` instead of running the command for every directory. The audit is a separate read-only command with stable finding codes for `--suppress`, instead of warnings mixed into generation. There's no `--merge`, `--subtract` or `--skip-*`; `--include` and `--exclude` cover the same needs. |","table":"table-0"},"1477":{"id":"/js/wp-release/v0.19.0/comparison-6","page_id":"/js/wp-release/v0.19.0/comparison","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/comparison#comparison-with-existing-tools","content":"| Tool                                          | What it does                                                                                                                                                                                          | How `wp-release` differs                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |\n| --------------------------------------------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `wp i18n make-mo`, `make-json` and `make-php` | WP-CLI commands that compile PO files into MO, script JSON and `.l10n.php` files. `make-json` maps sources with `--use-map` and removes JavaScript strings from the PO unless `--no-purge` is passed. | `i18n-mo`, `i18n-json` and `i18n-php` compile one translated PO at a time, never change it, and leave out fuzzy, obsolete and untranslated entries. `i18n-json` takes a many-to-many `--map` from source files to built scripts, and JSX and TypeScript sources need one, so catalogs are never written for files WordPress doesn't load. `--check` compares the outputs without writing. There's no `update-po`, so update PO files from the POT with gettext's `msgmerge` or a translation platform. |","table":"table-0"},"1478":{"id":"/js/wp-release/v0.19.0/comparison-7","page_id":"/js/wp-release/v0.19.0/comparison","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/comparison#comparison-with-existing-tools","content":"| Tool                         | What it does                                                                          | How `wp-release` differs                                                                                                                                                                                                                        |\n| ---------------------------- | ------------------------------------------------------------------------------------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `wp plugin verify-checksums` | WP-CLI command that checks installed plugins against the WordPress.org checksums API. | Reads the same manifest format, but from a file, so it also works for plugins and themes that aren't hosted on WordPress.org and for build directories in CI. `checksums` writes the manifest that WordPress.org generates for its own plugins. |","table":"table-0"},"1479":{"id":"/js/wp-release/v0.19.0/comparison-8","page_id":"/js/wp-release/v0.19.0/comparison","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/comparison#comparison-with-existing-tools","content":"| Tool                    | What it does                                                                                                                         | How `wp-release` differs                                                                                                                                                                                                                              |\n| ----------------------- | ------------------------------------------------------------------------------------------------------------------------------------ | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `wp-scripts plugin-zip` | Zips files from `package.json` `files` or a fixed allowlist, named after the npm package, with `--root-folder` / `--no-root-folder`. | Reuses the root folder flags, selects files with `.distignore` by default and can optionally honor Git `export-ignore` attributes, puts the version from the plugin headers in the filename and streams the archive instead of building it in memory. |","table":"table-0"},"1480":{"id":"/js/wp-release/v0.19.0/configuration","page_id":"/js/wp-release/v0.19.0/configuration","type":"page","content":"Configuration","breadcrumbs":["Docs","Js","Wp release","v0.19.0"],"tags":[],"url":"/js/wp-release/v0.19.0/configuration"},"1481":{"id":"/js/wp-release/v0.19.0/configuration-0","page_id":"/js/wp-release/v0.19.0/configuration","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0/configuration#naming-convention","content":"Naming convention"},"1482":{"id":"/js/wp-release/v0.19.0/configuration-1","page_id":"/js/wp-release/v0.19.0/configuration","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0/configuration#file-selection","content":"File selection"},"1483":{"id":"/js/wp-release/v0.19.0/configuration-2","page_id":"/js/wp-release/v0.19.0/configuration","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0/configuration#plugin-and-theme-headers","content":"Plugin and theme headers"},"1484":{"id":"/js/wp-release/v0.19.0/configuration-3","page_id":"/js/wp-release/v0.19.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/configuration#naming-convention","content":"`@wpelevator/wp-release` is the suite of release tools and `wp-release` is its CLI. \"Release\" is the whole workflow; each command is one operation in it. Commands are flat: a single word or dashed words like `version-check` and `deploy-svn`, without command groups or aliases. Each GitHub Action is named `wp-release-` followed by the command name, so the CLI command and the `uses:` name always match:"},"1485":{"id":"/js/wp-release/v0.19.0/configuration-4","page_id":"/js/wp-release/v0.19.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/configuration#naming-convention","content":"| Capability        | CLI command        | GitHub Action |\n| ----------------- | ------------------ | ------------- |\n| Build a directory | `wp-release build` |               |","table":"table-0"},"1486":{"id":"/js/wp-release/v0.19.0/configuration-5","page_id":"/js/wp-release/v0.19.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/configuration#naming-convention","content":"| Capability  | CLI command      | GitHub Action               |\n| ----------- | ---------------- | --------------------------- |\n| Build a ZIP | `wp-release zip` | `wpelevator/wp-release-zip` |","table":"table-0"},"1487":{"id":"/js/wp-release/v0.19.0/configuration-6","page_id":"/js/wp-release/v0.19.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/configuration#naming-convention","content":"| Capability                  | CLI command            | GitHub Action                     |\n| --------------------------- | ---------------------- | --------------------------------- |\n| Create a checksums manifest | `wp-release checksums` | `wpelevator/wp-release-checksums` |","table":"table-0"},"1488":{"id":"/js/wp-release/v0.19.0/configuration-7","page_id":"/js/wp-release/v0.19.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/configuration#naming-convention","content":"| Capability | CLI command       | GitHub Action                |\n| ---------- | ----------------- | ---------------------------- |\n| Sign files | `wp-release sign` | `wpelevator/wp-release-sign` |","table":"table-0"},"1489":{"id":"/js/wp-release/v0.19.0/configuration-8","page_id":"/js/wp-release/v0.19.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/configuration#naming-convention","content":"| Capability                      | CLI command         | GitHub Action |\n| ------------------------------- | ------------------- | ------------- |\n| Verify files against a manifest | `wp-release verify` |               |","table":"table-0"},"1490":{"id":"/js/wp-release/v0.19.0/configuration-9","page_id":"/js/wp-release/v0.19.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/configuration#naming-convention","content":"| Capability                    | CLI command                | GitHub Action |\n| ----------------------------- | -------------------------- | ------------- |\n| Check that the versions agree | `wp-release version-check` |               |","table":"table-0"},"1491":{"id":"/js/wp-release/v0.19.0/configuration-10","page_id":"/js/wp-release/v0.19.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/configuration#naming-convention","content":"| Capability                  | CLI command             | GitHub Action                      |\n| --------------------------- | ----------------------- | ---------------------------------- |\n| Deploy to WordPress.org SVN | `wp-release deploy-svn` | `wpelevator/wp-release-deploy-svn` |","table":"table-0"},"1492":{"id":"/js/wp-release/v0.19.0/configuration-11","page_id":"/js/wp-release/v0.19.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/configuration#naming-convention","content":"| Capability                 | CLI command             | GitHub Action |\n| -------------------------- | ----------------------- | ------------- |\n| Deploy to a Git repository | `wp-release deploy-git` |               |","table":"table-0"},"1493":{"id":"/js/wp-release/v0.19.0/configuration-12","page_id":"/js/wp-release/v0.19.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/configuration#naming-convention","content":"The names below are scoped to their commands. `--output` selects the primary artifact of each command; ZIP packaging uses `--checksums-file` for its accompanying manifest:"},"1494":{"id":"/js/wp-release/v0.19.0/configuration-13","page_id":"/js/wp-release/v0.19.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/configuration#naming-convention","content":"| Concept                   | CLI                                       | GitHub Action | Library     | Meaning                                                                           |\n| ------------------------- | ----------------------------------------- | ------------- | ----------- | --------------------------------------------------------------------------------- |\n| Plugin or theme directory | `<source-dir>` argument or `--source-dir` | `source-dir`  | `sourceDir` | Directory that a command reads, whether it's the repository or a build directory. |","table":"table-1"},"1495":{"id":"/js/wp-release/v0.19.0/configuration-14","page_id":"/js/wp-release/v0.19.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/configuration#naming-convention","content":"| Concept         | CLI                    | GitHub Action | Library     | Meaning                                                    |\n| --------------- | ---------------------- | ------------- | ----------- | ---------------------------------------------------------- |\n| Build directory | `build --output <dir>` | —             | `outputDir` | Directory written by `build`; files go directly inside it. |","table":"table-1"},"1496":{"id":"/js/wp-release/v0.19.0/configuration-15","page_id":"/js/wp-release/v0.19.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/configuration#naming-convention","content":"| Concept  | CLI                   | GitHub Action          | Library   | Meaning                                                           |\n| -------- | --------------------- | ---------------------- | --------- | ----------------------------------------------------------------- |\n| ZIP file | `zip --output <file>` | `output` in ZIP action | `zipPath` | Destination passed to `zipPackage()`; also returned as `zipPath`. |","table":"table-1"},"1497":{"id":"/js/wp-release/v0.19.0/configuration-16","page_id":"/js/wp-release/v0.19.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/configuration#naming-convention","content":"| Concept                   | CLI                         | GitHub Action                | Library                              | Meaning                                                                                                       |\n| ------------------------- | --------------------------- | ---------------------------- | ------------------------------------ | ------------------------------------------------------------------------------------------------------------- |\n| Standalone checksums file | `checksums --output <file>` | `output` in checksums action | first argument of `writeChecksums()` | Manifest destination relative to the working directory; the CLI returns its absolute path as `checksumsPath`. |","table":"table-1"},"1498":{"id":"/js/wp-release/v0.19.0/configuration-17","page_id":"/js/wp-release/v0.19.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/configuration#naming-convention","content":"| Concept                         | CLI                           | GitHub Action                  | Library         | Meaning                                                                             |\n| ------------------------------- | ----------------------------- | ------------------------------ | --------------- | ----------------------------------------------------------------------------------- |\n| Checksums filename when zipping | `zip --checksums-file <file>` | `checksums-file` in ZIP action | `checksumsFile` | Relative manifest filename beside the ZIP or inside its package root when embedded. |","table":"table-1"},"1499":{"id":"/js/wp-release/v0.19.0/configuration-18","page_id":"/js/wp-release/v0.19.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/configuration#naming-convention","content":"| Concept       | CLI                 | GitHub Action | Library   | Meaning                                 |\n| ------------- | ------------------- | ------------- | --------- | --------------------------------------- |\n| ZIP to deploy | `--from-zip <file>` | `from-zip`    | `fromZip` | Existing ZIP read as the deploy source. |","table":"table-1"},"1500":{"id":"/js/wp-release/v0.19.0/configuration-19","page_id":"/js/wp-release/v0.19.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/configuration#naming-convention","content":"| Concept            | CLI               | GitHub Action | Library  | Meaning                             |\n| ------------------ | ----------------- | ------------- | -------- | ----------------------------------- |\n| Git tag to compare | `--git-tag <tag>` |               | `gitTag` | Git tag checked by `version-check`. |","table":"table-1"},"1501":{"id":"/js/wp-release/v0.19.0/configuration-20","page_id":"/js/wp-release/v0.19.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/configuration#naming-convention","content":"| Concept           | CLI                   | GitHub Action | Library  | Meaning                                               |\n| ----------------- | --------------------- | ------------- | -------- | ----------------------------------------------------- |\n| SVN tag to create | `--svn-tag <version>` | `svn-tag`     | `svnTag` | Tag written by `deploy-svn`, distinct from a git tag. |","table":"table-1"},"1502":{"id":"/js/wp-release/v0.19.0/configuration-21","page_id":"/js/wp-release/v0.19.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/configuration#naming-convention","content":"| Concept        | CLI               | GitHub Action | Library  | Meaning             |\n| -------------- | ----------------- | ------------- | -------- | ------------------- |\n| SVN repository | `--svn-url <url>` | `svn-url`     | `svnUrl` | Deploy destination. |","table":"table-1"},"1503":{"id":"/js/wp-release/v0.19.0/configuration-22","page_id":"/js/wp-release/v0.19.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/configuration#naming-convention","content":"| Concept        | CLI               | GitHub Action | Library  | Meaning                                                                                                               |\n| -------------- | ----------------- | ------------- | -------- | --------------------------------------------------------------------------------------------------------------------- |\n| Git repository | `--git-url <url>` |               | `gitUrl` | Destination of `deploy-git`. Credentials come from git, like a token in the URL or an SSH key, and are never printed. |","table":"table-1"},"1504":{"id":"/js/wp-release/v0.19.0/configuration-23","page_id":"/js/wp-release/v0.19.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/configuration#naming-convention","content":"| Concept                      | CLI                               | GitHub Action | Library         | Meaning                                                                                                      |\n| ---------------------------- | --------------------------------- | ------------- | --------------- | ------------------------------------------------------------------------------------------------------------ |\n| Branch and tag to release to | `--branch <name>`, `--tag <name>` |               | `branch`, `tag` | Refs written by `deploy-git` in the Git repository, distinct from the git tag that `version-check` compares. |","table":"table-1"},"1505":{"id":"/js/wp-release/v0.19.0/configuration-24","page_id":"/js/wp-release/v0.19.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/configuration#naming-convention","content":"| Concept        | CLI                    | GitHub Action | Library       | Meaning                                                                                                                       |\n| -------------- | ---------------------- | ------------- | ------------- | ----------------------------------------------------------------------------------------------------------------------------- |\n| Source history | `--split-prefix <dir>` |               | `splitPrefix` | Directory of a monorepo package whose history, from `git subtree split`, becomes the source history of `deploy-git` releases. |","table":"table-1"},"1506":{"id":"/js/wp-release/v0.19.0/configuration-25","page_id":"/js/wp-release/v0.19.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/configuration#naming-convention","content":"| Concept         | CLI                                                                 | GitHub Action                  | Library                      | Meaning                                                                                                                                                    |\n| --------------- | ------------------------------------------------------------------- | ------------------------------ | ---------------------------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| SVN credentials | `--svn-username <name>`, `SVN_USERNAME` and `SVN_PASSWORD` env vars | `svn-username`, `svn-password` | `svnUsername`, `svnPassword` | Needed only to commit. There's no password flag, since it would show in the process list; the action inputs and library options fall back to the env vars. |","table":"table-1"},"1507":{"id":"/js/wp-release/v0.19.0/configuration-26","page_id":"/js/wp-release/v0.19.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/configuration#naming-convention","content":"| Concept    | CLI                                                | GitHub Action   | Library                                                   | Meaning                                                                                                                               |\n| ---------- | -------------------------------------------------- | --------------- | --------------------------------------------------------- | ------------------------------------------------------------------------------------------------------------------------------------- |\n| Log format | `--log-format <text\\|github>`, `--ci` for `github` | always `github` | `writer: new TextWriter()` or `new GitHubActionsWriter()` | How the log is printed: plain text, or GitHub Actions annotations and job summaries. Each name matches the start of its writer class. |","table":"table-1"},"1508":{"id":"/js/wp-release/v0.19.0/configuration-27","page_id":"/js/wp-release/v0.19.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/configuration#naming-convention","content":"| Concept        | CLI               | GitHub Action                              | Library      | Meaning                                                                                  |\n| -------------- | ----------------- | ------------------------------------------ | ------------ | ---------------------------------------------------------------------------------------- |\n| Release config | `--config <path>` | `config` in ZIP, checksums and SVN actions | `configFile` | Explicit JavaScript config path for package selection, integrity settings or deployment. |","table":"table-1"},"1509":{"id":"/js/wp-release/v0.19.0/configuration-28","page_id":"/js/wp-release/v0.19.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/configuration#naming-convention","content":"| Concept            | CLI                     | GitHub Action              | Library     | Meaning                                                 |\n| ------------------ | ----------------------- | -------------------------- | ----------- | ------------------------------------------------------- |\n| Release tag format | `--tag-format <format>` | `tag-format` in SVN action | `tagFormat` | How `release-ref` identifies a package and its version. |","table":"table-1"},"1510":{"id":"/js/wp-release/v0.19.0/configuration-29","page_id":"/js/wp-release/v0.19.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/configuration#naming-convention","content":"| Concept               | CLI                   | GitHub Action               | Library | Meaning                                                             |\n| --------------------- | --------------------- | --------------------------- | ------- | ------------------------------------------------------------------- |\n| Release ref to deploy | `--release-ref <ref>` | `release-ref` in SVN action | `ref`   | Read configured packages and deployment targets from a release ref. |","table":"table-1"},"1511":{"id":"/js/wp-release/v0.19.0/configuration-30","page_id":"/js/wp-release/v0.19.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/configuration#naming-convention","content":"| Concept     | CLI                   | GitHub Action           | Library  | Meaning                                                                                                                               |\n| ----------- | --------------------- | ----------------------- | -------- | ------------------------------------------------------------------------------------------------------------------------------------- |\n| Assets sync | `--no-assets` to skip | `assets: false` to skip | `assets` | Booleans are positive in the library and the action; `--no-assets` is only the CLI negation, never `noAssets` or a `no-assets` input. |","table":"table-1"},"1512":{"id":"/js/wp-release/v0.19.0/configuration-31","page_id":"/js/wp-release/v0.19.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/configuration#naming-convention","content":"CLI JSON results use camelCase keys like `zipPath`, and GitHub Action outputs use kebab-case like `zip-path`. The ZIP action supports `package` and `config`, the checksums action supports `config` for codec selection, and the SVN action supports `release-ref`, repeated `package` values as newline-separated input, `list`, `config` and `tag-format`."},"1513":{"id":"/js/wp-release/v0.19.0/configuration-32","page_id":"/js/wp-release/v0.19.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/configuration#naming-convention","content":"The ZIP CLI result uses `checksumsEmbedded` for the package-relative embedded manifest path. Its `signatures` array includes external absolute paths and embedded package-relative paths, while `checksumsSignatures` contains only manifest signatures. The ZIP action exposes those locations as `checksums-embedded`, `signatures` for external signatures, and `signatures-embedded` for embedded signatures, so asset uploads receive local files. With CLI `--github-output`, signature arrays remain in the JSON `result` output."},"1514":{"id":"/js/wp-release/v0.19.0/configuration-33","page_id":"/js/wp-release/v0.19.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/configuration#naming-convention","content":"Library classes are named after the capability (`SvnDeploy`, `Svn`, `GitDeploy`) without repeating \"release\"."},"1515":{"id":"/js/wp-release/v0.19.0/configuration-34","page_id":"/js/wp-release/v0.19.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/configuration#file-selection","content":"`build`, `zip`, `checksums`, `deploy-svn` and `deploy-git` select files the same way:"},"1516":{"id":"/js/wp-release/v0.19.0/configuration-35","page_id":"/js/wp-release/v0.19.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/configuration#file-selection","content":"| Option                | Description                                                                                                                    |\n| --------------------- | ------------------------------------------------------------------------------------------------------------------------------ |\n| `--distignore <file>` | Path to the ignore file. Defaults to `.distignore` in the source directory when present; an explicitly passed file must exist. |","table":"table-2"},"1517":{"id":"/js/wp-release/v0.19.0/configuration-36","page_id":"/js/wp-release/v0.19.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/configuration#file-selection","content":"| Option            | Description                 |\n| ----------------- | --------------------------- |\n| `--no-distignore` | Don't read any ignore file. |","table":"table-2"},"1518":{"id":"/js/wp-release/v0.19.0/configuration-37","page_id":"/js/wp-release/v0.19.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/configuration#file-selection","content":"| Option                 | Description                                                                                                                                                                                    |\n| ---------------------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `--exclude <patterns>` | Extra gitignore-style patterns, comma-separated or repeated, like `--exclude build/,assets/*,images/**/*`. They're applied after the ignore file, so a `!` pattern can also re-include a file. |","table":"table-2"},"1519":{"id":"/js/wp-release/v0.19.0/configuration-38","page_id":"/js/wp-release/v0.19.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/configuration#file-selection","content":"| Option                    | Description                                                                                                                                  |\n| ------------------------- | -------------------------------------------------------------------------------------------------------------------------------------------- |\n| `--exclude-gitattributes` | Also exclude paths marked `export-ignore` by Git attributes. This is opt-in and requires the source directory to be inside a Git repository. |","table":"table-2"},"1520":{"id":"/js/wp-release/v0.19.0/configuration-39","page_id":"/js/wp-release/v0.19.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/configuration#file-selection","content":"`.distignore` and `--exclude` use full gitignore syntax, including `!` negation. `--exclude-gitattributes` asks Git to evaluate `export-ignore` attributes, including nested `.gitattributes` files, then adds those paths to the exclusions. It is off by default, so releases don't unexpectedly depend on Git or change selection when a repository adds attributes. Git must be installed and the source directory must be inside a working tree; the flag is ignored by `deploy-svn --from-zip`, since the ZIP is already filtered. Version control metadata (`.git`, `.svn` and `.hg`, at any depth, including the `.git` files of worktrees and submodules) is always left out, also without an ignore file and when deploying from a ZIP, and no `!` pattern can re-include it. This keeps a repository's history out of ZIPs and deploys when the source directory is the repository root. The comma-separated `--exclude` list works like `--exclude` in `wp i18n make-pot`. Selected symbolic links are an error, since ZIP archives and WordPress.org SVN don't support them."},"1521":{"id":"/js/wp-release/v0.19.0/configuration-40","page_id":"/js/wp-release/v0.19.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/configuration#plugin-and-theme-headers","content":"The commands read the same headers as WordPress. The main plugin file is the top-level `.php` file with a `Plugin Name:` header in its first 8 KB, preferring `{slug}.php` when several files have one. A directory without a plugin file and with `Theme Name:` in `style.css` is a theme. The readme headers (`Stable tag`, `Tested up to`, …) come from `readme.txt`, or `readme.md` when there's no `readme.txt`."},"1522":{"id":"/js/wp-release/v0.19.0/configuration-41","page_id":"/js/wp-release/v0.19.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/configuration#plugin-and-theme-headers","content":"`--version` defaults to the `Version` header in `zip`, `checksums` and `version-check`, and `checksums --type` defaults to the detected package type."},"1523":{"id":"/js/wp-release/v0.19.0/deployment","page_id":"/js/wp-release/v0.19.0/deployment","type":"page","content":"Deployment","breadcrumbs":["Docs","Js","Wp release","v0.19.0"],"tags":[],"url":"/js/wp-release/v0.19.0/deployment"},"1524":{"id":"/js/wp-release/v0.19.0/deployment-0","page_id":"/js/wp-release/v0.19.0/deployment","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0/deployment#deploy-to-svn","content":"Deploy to SVN"},"1525":{"id":"/js/wp-release/v0.19.0/deployment-1","page_id":"/js/wp-release/v0.19.0/deployment","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0/deployment#deploy-to-git","content":"Deploy to Git"},"1526":{"id":"/js/wp-release/v0.19.0/deployment-2","page_id":"/js/wp-release/v0.19.0/deployment","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0/deployment#deploy-configured-packages","content":"Deploy configured packages"},"1527":{"id":"/js/wp-release/v0.19.0/deployment-3","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-to-svn","content":"The `wp-release-deploy-svn` GitHub Action runs this command."},"1528":{"id":"/js/wp-release/v0.19.0/deployment-4","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-to-svn","content":"`deploy-svn` syncs a plugin to the WordPress.org plugin SVN repository. Each SVN write is a separate flag and nothing is written unless requested. All writes go into one commit."},"1529":{"id":"/js/wp-release/v0.19.0/deployment-5","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-to-svn","content":"| Flag      | Default | Writes                                     |\n| --------- | ------- | ------------------------------------------ |\n| `--trunk` | off     | Sync the full source directory to `trunk/` |","table":"table-0"},"1530":{"id":"/js/wp-release/v0.19.0/deployment-6","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-to-svn","content":"| Flag            | Default | Writes                                                                                                                             |\n| --------------- | ------- | ---------------------------------------------------------------------------------------------------------------------------------- |\n| `--readme-only` | off     | Sync only the readme to `trunk/`, for updates between releases such as bumping `Tested up to`. Can't be combined with `--svn-tag`. |","table":"table-0"},"1531":{"id":"/js/wp-release/v0.19.0/deployment-7","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-to-svn","content":"| Flag                  | Default | Writes                                                                                                                                                                                                                                                        |\n| --------------------- | ------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `--svn-tag <version>` | off     | Create `tags/<version>`. With `--trunk`, the tag is a copy of the synced `trunk/`. Without it, the tag is built directly from the source files and `trunk/` is left alone, for pre-release tags. A leading `v` is stripped, so `v1.2.0` creates `tags/1.2.0`. |","table":"table-0"},"1532":{"id":"/js/wp-release/v0.19.0/deployment-8","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-to-svn","content":"| Flag                 | Default | Writes                                                                                                                                                                                 |\n| -------------------- | ------- | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `--assets-dir <dir>` | not set | Sync this directory with banners, icons and screenshots to the SVN `assets/` directory. There's no default directory, so assets are only deployed when this is set, and it must exist. |","table":"table-0"},"1533":{"id":"/js/wp-release/v0.19.0/deployment-9","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-to-svn","content":"| Flag          | Default | Writes                                                                                            |\n| ------------- | ------- | ------------------------------------------------------------------------------------------------- |\n| `--no-assets` |         | Skip the `--assets-dir` sync for one run, for example when a config always passes `--assets-dir`. |","table":"table-0"},"1534":{"id":"/js/wp-release/v0.19.0/deployment-10","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-to-svn","content":"Typical runs:"},"1535":{"id":"/js/wp-release/v0.19.0/deployment-11","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-to-svn","content":"How a deploy works:"},"1536":{"id":"/js/wp-release/v0.19.0/deployment-12","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-to-svn","content":"The options are validated, including the slug, version and readme name, before they're used in URLs or paths."},"1537":{"id":"/js/wp-release/v0.19.0/deployment-13","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-to-svn","content":"With `--trunk` or `--svn-tag`, the files must be a plugin whose `Version` header matches the version. When `--trunk` and `--svn-tag` are combined, the readme `Stable tag` must match too; a tag-only run skips that, since a pre-release tag doesn't change the stable tag. `--readme-only` needs the readme. Nothing is checked out when a check fails."},"1538":{"id":"/js/wp-release/v0.19.0/deployment-14","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-to-svn","content":"The repository is checked out sparsely into a new temporary directory, with only the directories that the flags write to. A missing `assets/` (or `trunk/`, `tags/`) directory is created. The deploy stops when `tags/<version>` exists, unless `--force` replaces it."},"1539":{"id":"/js/wp-release/v0.19.0/deployment-15","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-to-svn","content":"The files are synced in Node.js, without `rsync`: new and changed files are copied, files that are no longer selected are deleted, and `svn add` and `svn delete` stage them, including files that svn ignores by default. With `--trunk`, `trunk/` is then copied to the tag with `svn copy`. Without it, the same selected files are synced into `tags/<version>` instead, and with `--force` an existing tag is updated to match, deleting files that are no longer in the build."},"1540":{"id":"/js/wp-release/v0.19.0/deployment-16","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-to-svn","content":"Asset images get `svn:mime-type` set for PNG, JPEG, GIF and SVG, the formats that WordPress.org documents for plugin assets. Other formats keep the type that svn assigns."},"1541":{"id":"/js/wp-release/v0.19.0/deployment-17","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-to-svn","content":"When `svn status` is empty, the deploy ends without a commit. A dry run logs the status and stops before the commit. Otherwise the changes are committed, and the temporary directory is always removed."},"1542":{"id":"/js/wp-release/v0.19.0/deployment-18","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-to-svn","content":"`--from-zip` reads the files from a ZIP instead of `<source-dir>`. The ZIP is checked before it's extracted: entries with absolute paths, `..` segments or symbolic links, and entries outside a single `{slug}/` root folder, are rejected."},"1543":{"id":"/js/wp-release/v0.19.0/deployment-19","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-to-svn","content":"Credentials are only needed for the commit, not for dry runs, no-op runs or `file://` repositories. Pass the username with `--svn-username` or `SVN_USERNAME` and the password in `SVN_PASSWORD`. svn always runs non-interactively without caching credentials, and the password is passed on the standard input with `--password-from-stdin`, never on the command line or in the logs."},"1544":{"id":"/js/wp-release/v0.19.0/deployment-20","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-to-svn","content":"Validation:"},"1545":{"id":"/js/wp-release/v0.19.0/deployment-21","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-to-svn","content":"`--readme-only` can't be combined with `--svn-tag`, since a tag is a release snapshot that a readme update never changes."},"1546":{"id":"/js/wp-release/v0.19.0/deployment-22","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-to-svn","content":"`--version` defaults to `--svn-tag`, then the `Version` header of the deployed files; when `--version` and `--svn-tag` are both set they must match."},"1547":{"id":"/js/wp-release/v0.19.0/deployment-23","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-to-svn","content":"Pre-release versions like `1.0.0-rc.1` can be tagged, but syncing one to `trunk/` warns, since trunk is for the development version."},"1548":{"id":"/js/wp-release/v0.19.0/deployment-24","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-to-svn","content":"`--trunk` without `--svn-tag` works but warns, to remind you that updating trunk alone doesn't create a version tag for stable downloads."},"1549":{"id":"/js/wp-release/v0.19.0/deployment-25","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-to-svn","content":"A version mismatch throws a `VersionMismatchError`, a `ValidationError` with the `mismatches` and a problem for each, with its file and line. See Logging."},"1550":{"id":"/js/wp-release/v0.19.0/deployment-26","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-to-git","content":"`deploy-git` deploys the selected files of a plugin, theme or package to a Git repository, like a distribution repository that ships the built files and `vendor/` for Composer installs or GitHub-hosted updates, or the release repository of a monorepo package. It selects files like `zip`, with `.distignore` and `--exclude`, so built files that git ignores in the source repository, like `build/` or `vendor/`, are released too. The source directory must be inside a Git repository, which provides the source history and stores the release objects before they're pushed."},"1551":{"id":"/js/wp-release/v0.19.0/deployment-27","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-to-git","content":"| Flag              | Default | Writes                          |\n| ----------------- | ------- | ------------------------------- |\n| `--branch <name>` | off     | Push the release to this branch |","table":"table-1"},"1552":{"id":"/js/wp-release/v0.19.0/deployment-28","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-to-git","content":"| Flag           | Default | Writes                          |\n| -------------- | ------- | ------------------------------- |\n| `--tag <name>` | off     | Create this tag for the release |","table":"table-1"},"1553":{"id":"/js/wp-release/v0.19.0/deployment-29","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-to-git","content":"How a deploy works:"},"1554":{"id":"/js/wp-release/v0.19.0/deployment-30","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-to-git","content":"The selected files are written to the object database of the source repository and become a tree, with a temporary index, so the working tree and the index of the repository are left alone. Executable files stay executable."},"1555":{"id":"/js/wp-release/v0.19.0/deployment-31","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-to-git","content":"The previous release is fetched: the tip of `--branch`, or for a tag-only deploy the tip of the repository's default branch (its `HEAD`), whatever that branch holds. Release a tag together with `--branch` to choose the branch it builds on."},"1556":{"id":"/js/wp-release/v0.19.0/deployment-32","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-to-git","content":"When the files are the same as in the previous release, that release is reused. Otherwise a release commit is created with the files, whose parents are the previous release and the source history: the source commit (`--source-ref`, default `HEAD`), or with `--split-prefix` the history of that directory from `git subtree split`. The repository keeps the source history, and `git log --first-parent` lists the releases."},"1557":{"id":"/js/wp-release/v0.19.0/deployment-33","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-to-git","content":"When the previous release on `--branch` already has newer source history, the branch isn't moved, so running an older build again, like a re-run of an earlier CI job, can't release older files. The source history is outdated when it's an older commit of the source history that the previous release was made from, its last parent. `git subtree split` makes this reliable for `--split-prefix` too, since it creates the same commits for the same history. A revert is a new commit, so it's released, and with `--tag` the tag of an older build is still released, without moving the branch."},"1558":{"id":"/js/wp-release/v0.19.0/deployment-34","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-to-git","content":"The tag is checked in the repository first. A tag that already has the same files is the release: it's reused and nothing is pushed, so running a tag release again is a no-op. A tag with other files fails with exit code `2` before anything is pushed."},"1559":{"id":"/js/wp-release/v0.19.0/deployment-35","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-to-git","content":"The release is pushed to the branch, unless it didn't change or is outdated, and to the tag, in one atomic push. Pushes are never forced, so the branch only moves forward and a tag is never replaced, also when it was created in the meantime."},"1560":{"id":"/js/wp-release/v0.19.0/deployment-36","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-to-git","content":"To release a tag again, for example after a release with the wrong files, delete the tag in the repository (`git push <url> :refs/tags/<tag>`) and run the deploy again. There's no flag for replacing a tag, since installs, Composer and GitHub Actions pins trust that a published tag doesn't change."},"1561":{"id":"/js/wp-release/v0.19.0/deployment-37","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-to-git","content":"`--dry-run` runs everything except the push. `--message` sets the commit message, which defaults to `Release <tag or branch> from <source commit>`. Credentials come from git, like a credential helper or an SSH key, and credentials in URLs are never printed. For an HTTPS repository on `github.com`, or on the host of `GITHUB_SERVER_URL` like GitHub Enterprise Server, the `GITHUB_TOKEN` environment variable is sent as an authorization header, like `actions/checkout` does, so the token stays out of the URL, the git arguments and the repository config, and it replaces the header that `actions/checkout` persists. Pass `token` to `resolveGitDeployOptions()` for another HTTPS host. The commit needs a git identity (`user.name` and `user.email`)."},"1562":{"id":"/js/wp-release/v0.19.0/deployment-38","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-configured-packages","content":"`deploy-git --release-ref <ref>` and `deploy-svn --release-ref <ref>` deploy the packages of a monorepo, or of a single-package repository, to the targets in the `deploy` config of their package groups, like the release repository of each package or its WordPress.org plugin. The ref decides what's deployed: a release tag of a package, like `refs/tags/plugins/alpha/1.2.0` read with the `tagFormat`, deploys that package and version, and a branch, like `refs/heads/main`, deploys every package with a target for that branch. A name without `refs/` is a release tag when it matches the tag format of a package, otherwise a branch, and in GitHub Actions `$GITHUB_REF` is the pushed ref."},"1563":{"id":"/js/wp-release/v0.19.0/deployment-39","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-configured-packages","content":"| Mode | Command                          | Use                                                                                                                                                                                           |\n| ---- | -------------------------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| All  | `deploy-git --release-ref <ref>` | Deploy every package of the ref to each of its targets, one at a time, in one log group for each package. A failed deploy doesn't stop the others, and the command exits with `1` at the end. |","table":"table-2"},"1564":{"id":"/js/wp-release/v0.19.0/deployment-40","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-configured-packages","content":"| Mode        | Command                                           | Use                                                                                                                                                       |\n| ----------- | ------------------------------------------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| One package | `deploy-git --release-ref <ref> --package <name>` | Deploy only that package (repeatable), by identifier or path, for example to retry a failed one or in a CI job for each package with its own credentials. |","table":"table-2"},"1565":{"id":"/js/wp-release/v0.19.0/deployment-41","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-configured-packages","content":"| Mode | Command                                 | Use                                                                                                                                                                                                                                                                                             |\n| ---- | --------------------------------------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| Plan | `deploy-git --release-ref <ref> --list` | List the deploys without running them, with each package, its version or branch and the targets with the tag or branch they get. With `--json` or `--github-output` the result is `{ packages: [ … ] }`, for a CI matrix with `include: ${{ fromJSON( steps.plan.outputs.result ).packages }}`. |","table":"table-2"},"1566":{"id":"/js/wp-release/v0.19.0/deployment-42","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-configured-packages","content":"| Mode             | Command                                      | Use                                                        |\n| ---------------- | -------------------------------------------- | ---------------------------------------------------------- |\n| Single directory | `deploy-git <dir> --git-url <url> [options]` | Deploy one directory without a config, as described above. |","table":"table-2"},"1567":{"id":"/js/wp-release/v0.19.0/deployment-43","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-configured-packages","content":"`deploy-svn` has the same modes. `--release-ref` can't be combined with the options of a single target, like `--git-url`, `--tag` or `--svn-tag`, which come from the config."},"1568":{"id":"/js/wp-release/v0.19.0/deployment-44","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-configured-packages","content":"**Git targets** take a `repository` and release both branches and tags by default. `branches` limits the branches, like `[ 'main' ]`, or turns them off with `false`, and `tag` is the tag template in the repository, `{version}` by default, or `false` to not release tags. A release tag is created on top of the default branch of the repository, and a branch is released to the same branch. `history: false` uses the source commit instead of the package history from `git subtree split`, and `message` sets the release commit message, `Release {ref} from {revision}` by default."},"1569":{"id":"/js/wp-release/v0.19.0/deployment-45","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-configured-packages","content":"**SVN targets** only deploy release tags: a stable release syncs `trunk/`, creates its tag and syncs the `assetsDir`, and a pre-release only creates its tag. `slug`, the WordPress.org plugin slug, defaults to the name of the package directory, `url` to the WordPress.org plugin repository, and `message` sets the commit message. Credentials come from `SVN_USERNAME` and `SVN_PASSWORD`, or `--svn-username`."},"1570":{"id":"/js/wp-release/v0.19.0/deployment-46","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-configured-packages","content":"**Several targets**: `git` and `svn` each take one target or a list, like a release repository and a mirror on another host. Each target is a separate deploy."},"1571":{"id":"/js/wp-release/v0.19.0/deployment-47","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-configured-packages","content":"**Credentials**: a GitHub repository URL needs no token in it, since `GITHUB_TOKEN` is sent as an authorization header (see above). A callback can still add credentials for other hosts."},"1572":{"id":"/js/wp-release/v0.19.0/deployment-48","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-configured-packages","content":"**Templates and callbacks**: `repository`, `slug` and `message` are templates with `{name}` and `{path}`, like the `tagFormat`, and `{version}`, `{branch}`, `{ref}` (the tag or branch that the deploy writes in the target) and `{revision}` (the source commit), or callbacks that receive `{ package, version, branch, ref, revision }`, where `package` has the `name`, `directory`, `path` and `type`. A callback can name a target after the package directory, choose another host for some packages, read the environment, or return nothing to skip the target for that package or ref; an empty `message` uses the default one. Credentials in URLs are never printed or listed."},"1573":{"id":"/js/wp-release/v0.19.0/deployment-49","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-configured-packages","content":"**Results**: with `--json` or `--github-output`, the result lists each deploy in `deploys` with its `package`, `label`, `target` (the repository or WordPress.org plugin, with credentials redacted), `targetRef` (the tag or branch written there), `version` or `branch`, and its `result` or `error`. A remote target repository also has its `targetHost`, like `github.com`, and `targetPath`, like `me/my-plugin`, without credentials, for a workflow step that calls the API of the forge that hosts it, such as to create the release of the deployed tag. The targets of `--list` have the same `host` and `path`, and `parseRepositoryUrl()` reads them from an HTTP(S), SSH or scp-like URL. `wp-release` doesn't call forge APIs itself."},"1574":{"id":"/js/wp-release/v0.19.0/deployment-50","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-configured-packages","content":"**Packages without a version**: a package entry without `version`, like a single directory with a `glob` of its path, isn't released with changesets, so changes to it don't need one, and it only deploys branches, since it has no release tags."},"1575":{"id":"/js/wp-release/v0.19.0/deployment-51","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-configured-packages","content":"**Files**: `files.exclude` adds gitignore-style patterns relative to the package directory, and `files.distignore` sets the ignore file relative to it or turns it off with `false`. A `files` at the root of the config applies to every package group, for the rules that all packages share, and the `files` of a group add their patterns after it and can replace its ignore file. Without `files`, each package's `.distignore` applies, like for `zip`; there's no repository-wide `.distignore`, since each one is relative to its package. `zip --package <name>` zips a package with the same files, `getPackageFiles()` returns the directory and the file selection of any configured package, and `getDeployPackages()` lists the packages with deploy targets and their file selection."},"1576":{"id":"/js/wp-release/v0.19.0/deployment-52","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-configured-packages","content":"A deploy releases the files of the working tree, so build the packages first. One job that builds once and runs `deploy-git --release-ref \"$GITHUB_REF\"` is the simplest setup, also for a branch that releases every package. A matrix with a job for each package from `--list` would build every package in every job, so build once and pass the built tree to the jobs as an artifact if you need one, for example for separate credentials."},"1577":{"id":"/js/wp-release/v0.19.0/deployment-53","page_id":"/js/wp-release/v0.19.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/deployment#deploy-configured-packages","content":"Other monorepo tools split the same way with less of the release in the config: splitsh-lite, Symplify MonorepoBuilder and `danharrin/monorepo-split-github-action` push the source history of each package directory, with the packages and repositories listed in the workflow or a matrix, while `deploy-git` releases the built files on top of that history, so `vendor/` and `build/` reach Composer and WordPress installs. Like the publishers of GoReleaser, targets are lists with templates, and pre-releases skip the targets where they would replace the stable version."},"1578":{"id":"/js/wp-release/v0.19.0/development","page_id":"/js/wp-release/v0.19.0/development","type":"page","content":"Development","breadcrumbs":["Docs","Js","Wp release","v0.19.0"],"tags":[],"url":"/js/wp-release/v0.19.0/development"},"1579":{"id":"/js/wp-release/v0.19.0/development-0","page_id":"/js/wp-release/v0.19.0/development","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0/development#development","content":"Development"},"1580":{"id":"/js/wp-release/v0.19.0/development-1","page_id":"/js/wp-release/v0.19.0/development","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0/development#architecture","content":"Architecture"},"1581":{"id":"/js/wp-release/v0.19.0/development-2","page_id":"/js/wp-release/v0.19.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/development#development","content":"The source is TypeScript in `src/`, with tests next to the files they test (`*.test.ts`). The published package contains only the compiled `dist/` with JavaScript and `.d.ts` files; tests and translation fixtures stay in the repository."},"1582":{"id":"/js/wp-release/v0.19.0/development-3","page_id":"/js/wp-release/v0.19.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/development#development","content":"`build` compiles `src/` to `dist/` with `tsc`, leaving out the tests. TypeScript resolves the workspace packages that wp-release depends on, like `@wpelevator/zip`, through their `wpelevator-source` condition, so it checks their source and needs no `dist/` of them. `preserveSymlinks` keeps their files under `node_modules`, so they aren't compiled into wp-release's `dist/`."},"1583":{"id":"/js/wp-release/v0.19.0/development-4","page_id":"/js/wp-release/v0.19.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/development#development","content":"`test` runs the `.ts` tests directly with `node --test`, using Node.js type stripping, so it needs Node.js 22.18 or later but no build. The SVN integration tests in `svn-deploy.integration.test.ts` create repositories with `svnadmin` and deploy to their `file://` URLs; they're skipped when `svn` or `svnadmin` isn't installed."},"1584":{"id":"/js/wp-release/v0.19.0/development-5","page_id":"/js/wp-release/v0.19.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/development#development","content":"`lint` runs ESLint and a `tsc` type check."},"1585":{"id":"/js/wp-release/v0.19.0/development-6","page_id":"/js/wp-release/v0.19.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/development#development","content":"The i18n tests in `@wpelevator/wp-gettext` validate gettext round trips, script catalogs and generated PHP data without launching PHP, WP-CLI or WordPress, covering contexts, plural forms, comments, flags, Unicode, escaping and PHP-looking input as data."},"1586":{"id":"/js/wp-release/v0.19.0/development-7","page_id":"/js/wp-release/v0.19.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/development#development","content":"The `wpelevator-source` export condition points at `src/index.ts`. The wp-release tests and monorepo CLI scripts use it to work with the source instead of a `dist/` build. Action builds use the declared dependency's default export, which resolves to `dist/` for the workspace copy and the published package. Build wp-release before building the actions."},"1587":{"id":"/js/wp-release/v0.19.0/development-8","page_id":"/js/wp-release/v0.19.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/development#development","content":"`execute( 'deploy-svn', args, { cwd, logger, svnRunner } )` runs a single-plugin deployment or a configured plan or deployment. The optional `svnRunner` replaces the external command runner in both modes; without it, the command uses its normal runner."},"1588":{"id":"/js/wp-release/v0.19.0/development-9","page_id":"/js/wp-release/v0.19.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/development#architecture","content":"wp-release has two layers, so that it fits any repository layout:"},"1589":{"id":"/js/wp-release/v0.19.0/development-10","page_id":"/js/wp-release/v0.19.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/development#architecture","content":"**Primitives** work on the directory, file or values they're given and know nothing about the repository: `build <dir>`, `zip <dir>`, `checksums`, `sign`, `verify`, `version-check`, `deploy-git <dir>`, `deploy-svn <dir>`, `i18n-pot <dir>`, `i18n-audit <dir>` and the `i18n-mo`, `i18n-json` and `i18n-php` compilers."},"1590":{"id":"/js/wp-release/v0.19.0/development-11","page_id":"/js/wp-release/v0.19.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/development#architecture","content":"**The config layer** reads `wp-release.config.js` for everything about the repository: where packages are (`root` and the package globs), how their versions and tags are named (`version`, `tagFormat`), which files they ship (`files`), how their translations are extracted (`i18n`), where they deploy (`deploy`) and the git `remote`. The changeset commands (with a single-project fallback when no config exists), `deploy-git` and `deploy-svn --release-ref`, `build --package` and `zip --package`, and `i18n-pot` and `i18n-audit` with `--package` or `--all` belong to it, and the global `--config` and `--tag-format` options select or adjust the config. `zip` and `checksums` also read caller configuration for integrity settings even without `--package`; verification reads it only when explicitly selected. Only `--release-ref` reads which package and version a ref releases. A primitive with a config mode, like `deploy-git --release-ref` beside `deploy-git <dir>` or `zip --package` beside `zip <dir>`, only takes the package directory, its files and its targets from the config there, and otherwise works the same."},"1591":{"id":"/js/wp-release/v0.19.0/development-12","page_id":"/js/wp-release/v0.19.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/development#architecture","content":"Configured repositories use the layout and naming conventions their config sets. Config-free changeset releases use the root-only detection and defaults described above."},"1592":{"id":"/js/wp-release/v0.19.0/development-13","page_id":"/js/wp-release/v0.19.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/development#architecture","content":"The GitHub Actions are adapters to these commands: they use the same flag names and `execute()` entry point, with secrets supplied through environment variables. The SVN action injects a command runner that checks or installs SVN only when a deployment runs its first SVN command; config planning and deployment behavior remain in `wp-release`."},"1593":{"id":"/js/wp-release/v0.19.0/development-14","page_id":"/js/wp-release/v0.19.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/development#architecture","content":"The package uses ES modules as its unit of encapsulation, like most Node.js CLI tools: a module exports a few functions and keeps its helpers private, so there's no class to wrap them in. A class is used only when it holds state across steps or binds dependencies, so that callers and tests can replace them:"},"1594":{"id":"/js/wp-release/v0.19.0/development-15","page_id":"/js/wp-release/v0.19.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/development#architecture","content":"**Workflows with steps** are classes, so that their steps share state and dependencies on the instance: `SvnDeploy` shares the temporary working copy across `prepare()`, `checkout()`, `sync()` and `commit()`, `GitDeploy` binds the options and the git runner to its steps, and `ChangesetRelease` binds the repository and the runners to `add()`, `version()` and `tag()`."},"1595":{"id":"/js/wp-release/v0.19.0/development-16","page_id":"/js/wp-release/v0.19.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/development#architecture","content":"**External commands** run through injectable runners: `createSvnRunner()` and `createGitRunner()` return functions that spawn the binary without a shell. The classes take a runner as an option and create the default one when it's missing, so tests pass a fake runner, or one that wraps the real runner and records some commands, instead of putting fake binaries on the `PATH`. The `Svn` and `ReleaseRepository` classes wrap a runner with the commands of their domain."},"1596":{"id":"/js/wp-release/v0.19.0/development-17","page_id":"/js/wp-release/v0.19.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/development#architecture","content":"**Domain logic** is plain functions that take their dependencies as arguments, like `discoverPackages( repository, config )`, so that each one can be tested on its own."},"1597":{"id":"/js/wp-release/v0.19.0/development-18","page_id":"/js/wp-release/v0.19.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/development#architecture","content":"**Commands** in `src/commands/` parse the CLI options and call the library, and `cli.ts` handles the global options, logging and exit codes. Errors carry their exit code, like `ValidationError` with `2`. Signing lives in `@wpelevator/signatures`, which throws errors with a `code`; `src/signing.ts` wraps it to read `WP_RELEASE_SIGNING_KEY` and to report those errors as `ValidationError`. ZIP archives live in `@wpelevator/zip` in the same way: `src/zip.ts` and `src/unzip.ts` adapt its entries and `zipPath` inputs and report its `ZipError` as `ValidationError`, with the `--force` hint for an existing archive. File selection and syncing live in `@wpelevator/fileset` and checksums in `@wpelevator/checksums`, which throw errors with a `code` in the same way: `src/file-selection.ts`, `src/sync.ts` and `src/checksums.ts` wrap them to report those errors as `ValidationError`, to build the manifest metadata from the plugin or theme slug and version, to select the files from the rules before hashing, and to pass the Git `export-ignore` lister to the fileset package. `src/integrity.ts` wraps the manifest codecs of the checksums package in the same way."},"1598":{"id":"/js/wp-release/v0.19.0/development-19","page_id":"/js/wp-release/v0.19.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/development#architecture","content":"Constructors only store their options. Work starts in a method call."},"1599":{"id":"/js/wp-release/v0.19.0/development-20","page_id":"/js/wp-release/v0.19.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/development#architecture","content":"The changeset release modules, from the entry point down:"},"1600":{"id":"/js/wp-release/v0.19.0/development-21","page_id":"/js/wp-release/v0.19.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/development#architecture","content":"| Module                 | Responsibility                                                                                                                              |\n| ---------------------- | ------------------------------------------------------------------------------------------------------------------------------------------- |\n| `changeset-release.ts` | `ChangesetRelease`, which plans releases and runs `add()`, `getStatus()`, `version()` and `tag()`, and the function form of each operation. |","table":"table-0"},"1601":{"id":"/js/wp-release/v0.19.0/development-22","page_id":"/js/wp-release/v0.19.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/development#architecture","content":"| Module              | Responsibility                                                                                       |\n| ------------------- | ---------------------------------------------------------------------------------------------------- |\n| `single-project.ts` | Resolving the config-free root project, its version source and targets, and shared release settings. |","table":"table-0"},"1602":{"id":"/js/wp-release/v0.19.0/development-23","page_id":"/js/wp-release/v0.19.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/development#architecture","content":"| Module                | Responsibility                                                                            |\n| --------------------- | ----------------------------------------------------------------------------------------- |\n| `changeset-config.ts` | Loading and validating `wp-release.config.js`, and the version source and target helpers. |","table":"table-0"},"1603":{"id":"/js/wp-release/v0.19.0/development-24","page_id":"/js/wp-release/v0.19.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/development#architecture","content":"| Module                  | Responsibility                                                                                             |\n| ----------------------- | ---------------------------------------------------------------------------------------------------------- |\n| `changeset-packages.ts` | Discovering the packages of the configured globs, with or without a version, and finding the changed ones. |","table":"table-0"},"1604":{"id":"/js/wp-release/v0.19.0/development-25","page_id":"/js/wp-release/v0.19.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/development#architecture","content":"| Module               | Responsibility                                  |\n| -------------------- | ----------------------------------------------- |\n| `changeset-files.ts` | Reading, writing and consuming changeset files. |","table":"table-0"},"1605":{"id":"/js/wp-release/v0.19.0/development-26","page_id":"/js/wp-release/v0.19.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/development#architecture","content":"| Module                    | Responsibility                                                                                             |\n| ------------------------- | ---------------------------------------------------------------------------------------------------------- |\n| `changeset-dependents.ts` | The dependents policy: which packages re-release with their sources, and rewriting their dependency specs. |","table":"table-0"},"1606":{"id":"/js/wp-release/v0.19.0/development-27","page_id":"/js/wp-release/v0.19.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/development#architecture","content":"| Module          | Responsibility                                            |\n| --------------- | --------------------------------------------------------- |\n| `changesets.ts` | Parsing and formatting changesets, and the release types. |","table":"table-0"},"1607":{"id":"/js/wp-release/v0.19.0/development-28","page_id":"/js/wp-release/v0.19.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/development#architecture","content":"| Module             | Responsibility                                                                 |\n| ------------------ | ------------------------------------------------------------------------------ |\n| `version-files.ts` | Reading and writing versions in manifests, headers, readmes and PHP constants. |","table":"table-0"},"1608":{"id":"/js/wp-release/v0.19.0/development-29","page_id":"/js/wp-release/v0.19.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/development#architecture","content":"| Module         | Responsibility                                                           |\n| -------------- | ------------------------------------------------------------------------ |\n| `changelog.ts` | Changelog entries, and the `CHANGELOG.md` and readme changelog sections. |","table":"table-0"},"1609":{"id":"/js/wp-release/v0.19.0/development-30","page_id":"/js/wp-release/v0.19.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/development#architecture","content":"| Module            | Responsibility                                                                      |\n| ----------------- | ----------------------------------------------------------------------------------- |\n| `release-tags.ts` | Choosing the version and previous tag of a release, and building its release notes. |","table":"table-0"},"1610":{"id":"/js/wp-release/v0.19.0/development-31","page_id":"/js/wp-release/v0.19.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/development#architecture","content":"| Module          | Responsibility                            |\n| --------------- | ----------------------------------------- |\n| `tag-format.ts` | Formatting tag names from the tag format. |","table":"table-0"},"1611":{"id":"/js/wp-release/v0.19.0/development-32","page_id":"/js/wp-release/v0.19.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/development#architecture","content":"| Module              | Responsibility                                                                                                                                                                                   |\n| ------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `package-deploy.ts` | Resolving the configured deploys of a ref: the released packages, their targets and file selections, for `deploy-git` and `deploy-svn`, and the file selection of a package for `zip --package`. |","table":"table-0"},"1612":{"id":"/js/wp-release/v0.19.0/development-33","page_id":"/js/wp-release/v0.19.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/development#architecture","content":"| Module           | Responsibility                                                                                                                      |\n| ---------------- | ----------------------------------------------------------------------------------------------------------------------------------- |\n| `package-zip.ts` | `zipPackage()`, the ZIP and checksums manifest of the selected files of a package, for `zip` and the snapshot builds of a monorepo. |","table":"table-0"},"1613":{"id":"/js/wp-release/v0.19.0/development-34","page_id":"/js/wp-release/v0.19.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/development#architecture","content":"| Module                  | Responsibility                                                                       |\n| ----------------------- | ------------------------------------------------------------------------------------ |\n| `release-repository.ts` | `ReleaseRepository`, the git commands of a release: tags, commits and changed files. |","table":"table-0"},"1614":{"id":"/js/wp-release/v0.19.0/development-35","page_id":"/js/wp-release/v0.19.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/development#architecture","content":"| Module            | Responsibility                                                                     |\n| ----------------- | ---------------------------------------------------------------------------------- |\n| `file-journal.ts` | `FileJournal`, which restores every file a failed `changeset-version` run changed. |","table":"table-0"},"1615":{"id":"/js/wp-release/v0.19.0/development-36","page_id":"/js/wp-release/v0.19.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/development#architecture","content":"| Module        | Responsibility                        |\n| ------------- | ------------------------------------- |\n| `versions.ts` | Version checks and SemVer precedence. |","table":"table-0"},"1616":{"id":"/js/wp-release/v0.19.0/development-37","page_id":"/js/wp-release/v0.19.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/development#architecture","content":"The internationalization modules in `src/i18n/` adapt the standalone `@wpelevator/wp-gettext` package, which owns extraction, catalogs, POT, PO, MO, script JSON, `.l10n.php` and audits:"},"1617":{"id":"/js/wp-release/v0.19.0/development-38","page_id":"/js/wp-release/v0.19.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/development#architecture","content":"| Module        | Responsibility                                                                                                                              |\n| ------------- | ------------------------------------------------------------------------------------------------------------------------------------------- |\n| `packages.ts` | `resolveI18nPackages()`, the config adapter that selects a directory, one package or all packages and resolves their options and POT paths. |","table":"table-1"},"1618":{"id":"/js/wp-release/v0.19.0/development-39","page_id":"/js/wp-release/v0.19.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/development#architecture","content":"| Module        | Responsibility                                                                                                                                                                                                                                         |\n| ------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `generate.ts` | `extractCatalog()`, `generatePackagePot()`, `resolvePotPath()` and `validatePotDestinations()`, which read the headers of the main file with `package-meta.ts` and pass them as `meta` to the generate functions of `@wpelevator/wp-gettext/generate`. |","table":"table-1"},"1619":{"id":"/js/wp-release/v0.19.0/development-40","page_id":"/js/wp-release/v0.19.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/development#architecture","content":"| Module       | Responsibility                                                                                                                                     |\n| ------------ | -------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `gettext.ts` | The other functions of `@wpelevator/wp-gettext`, with their `GettextError` reported as a `ValidationError` with the original error as its `cause`. |","table":"table-1"},"1620":{"id":"/js/wp-release/v0.19.0","page_id":"/js/wp-release/v0.19.0","type":"page","content":"WP Release","breadcrumbs":["Docs","Js","Wp release","v0.19.0"],"tags":[],"url":"/js/wp-release/v0.19.0"},"1621":{"id":"/js/wp-release/v0.19.0-0","page_id":"/js/wp-release/v0.19.0","tags":[],"type":"text","url":"/js/wp-release/v0.19.0","content":"Build and release WordPress plugins, themes, and packages."},"1622":{"id":"/js/wp-release/v0.19.0-1","page_id":"/js/wp-release/v0.19.0","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0#install","content":"Install"},"1623":{"id":"/js/wp-release/v0.19.0-2","page_id":"/js/wp-release/v0.19.0","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0#start-with-the-cli","content":"Start with the CLI"},"1624":{"id":"/js/wp-release/v0.19.0-3","page_id":"/js/wp-release/v0.19.0","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0#guides","content":"Guides"},"1625":{"id":"/js/wp-release/v0.19.0-4","page_id":"/js/wp-release/v0.19.0","tags":[],"type":"text","url":"/js/wp-release/v0.19.0","content":"`@wpelevator/wp-release` provides a CLI and library for building release directories and ZIPs, creating checksums and signatures, checking versions, extracting and compiling translations, and deploying to WordPress.org SVN or Git repositories."},"1626":{"id":"/js/wp-release/v0.19.0-5","page_id":"/js/wp-release/v0.19.0","tags":[],"type":"text","url":"/js/wp-release/v0.19.0","content":"The `wp-release-zip`, `wp-release-checksums`, `wp-release-sign`, and `wp-release-deploy-svn` GitHub Actions expose the same commands in workflows."},"1627":{"id":"/js/wp-release/v0.19.0-6","page_id":"/js/wp-release/v0.19.0","tags":[],"type":"text","url":"/js/wp-release/v0.19.0","content":"For projects that don't use Node.js or JavaScript tooling, PHP Changesets (`wpelevator/php-changesets`) runs the same changeset release workflow with PHP and Git alone: `changeset add`, `status`, `version` and `tag` read the same changeset files and match the options of the `changeset-*` commands described in Changesets support."},"1628":{"id":"/js/wp-release/v0.19.0-7","page_id":"/js/wp-release/v0.19.0","tags":[],"type":"text","url":"/js/wp-release/v0.19.0","content":"WordPress.org themes are released by uploading a ZIP, so `deploy-svn` is for plugins only. Use `zip` to build a theme upload. Packaging and deployment options follow familiar community tools to ease migration; the comparison explains the differences."},"1629":{"id":"/js/wp-release/v0.19.0-8","page_id":"/js/wp-release/v0.19.0","tags":[],"type":"text","url":"/js/wp-release/v0.19.0#install","content":"Node.js 22.12 or later is required. SVN deployments also require the `svn` command line client. Git deployments and changeset commands require Git."},"1630":{"id":"/js/wp-release/v0.19.0-9","page_id":"/js/wp-release/v0.19.0","tags":[],"type":"text","url":"/js/wp-release/v0.19.0#install","content":"The package is an ES module with TypeScript declarations. CommonJS projects can load it with `require( '@wpelevator/wp-release' )` on Node.js 22.12 or later."},"1631":{"id":"/js/wp-release/v0.19.0-10","page_id":"/js/wp-release/v0.19.0","tags":[],"type":"text","url":"/js/wp-release/v0.19.0#guides","content":"CLI and automation"},"1632":{"id":"/js/wp-release/v0.19.0-11","page_id":"/js/wp-release/v0.19.0","tags":[],"type":"text","url":"/js/wp-release/v0.19.0#guides","content":"Changeset releases"},"1633":{"id":"/js/wp-release/v0.19.0-12","page_id":"/js/wp-release/v0.19.0","tags":[],"type":"text","url":"/js/wp-release/v0.19.0#guides","content":"Configuration and file selection"},"1634":{"id":"/js/wp-release/v0.19.0-13","page_id":"/js/wp-release/v0.19.0","tags":[],"type":"text","url":"/js/wp-release/v0.19.0#guides","content":"Packaging, checksums, signatures, and verification"},"1635":{"id":"/js/wp-release/v0.19.0-14","page_id":"/js/wp-release/v0.19.0","tags":[],"type":"text","url":"/js/wp-release/v0.19.0#guides","content":"Git and WordPress.org deployment"},"1636":{"id":"/js/wp-release/v0.19.0-15","page_id":"/js/wp-release/v0.19.0","tags":[],"type":"text","url":"/js/wp-release/v0.19.0#guides","content":"WordPress internationalization"},"1637":{"id":"/js/wp-release/v0.19.0-16","page_id":"/js/wp-release/v0.19.0","tags":[],"type":"text","url":"/js/wp-release/v0.19.0#guides","content":"Library API"},"1638":{"id":"/js/wp-release/v0.19.0-17","page_id":"/js/wp-release/v0.19.0","tags":[],"type":"text","url":"/js/wp-release/v0.19.0#guides","content":"Development and architecture"},"1639":{"id":"/js/wp-release/v0.19.0-18","page_id":"/js/wp-release/v0.19.0","tags":[],"type":"text","url":"/js/wp-release/v0.19.0#guides","content":"Comparison with existing tools"},"1640":{"id":"/js/wp-release/v0.19.0/internationalization","page_id":"/js/wp-release/v0.19.0/internationalization","type":"page","content":"Internationalization","breadcrumbs":["Docs","Js","Wp release","v0.19.0"],"tags":[],"url":"/js/wp-release/v0.19.0/internationalization"},"1641":{"id":"/js/wp-release/v0.19.0/internationalization-0","page_id":"/js/wp-release/v0.19.0/internationalization","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0/internationalization#wordpress-internationalization","content":"WordPress internationalization"},"1642":{"id":"/js/wp-release/v0.19.0/internationalization-1","page_id":"/js/wp-release/v0.19.0/internationalization","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0/internationalization#supported-extraction-syntax","content":"Supported extraction syntax"},"1643":{"id":"/js/wp-release/v0.19.0/internationalization-2","page_id":"/js/wp-release/v0.19.0/internationalization","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0/internationalization#compile-translated-catalogs","content":"Compile translated catalogs"},"1644":{"id":"/js/wp-release/v0.19.0/internationalization-3","page_id":"/js/wp-release/v0.19.0/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/internationalization#wordpress-internationalization","content":"`i18n-pot` extracts plugin/theme strings and writes a reproducible UTF-8 POT. `i18n-audit` reads the same source and returns findings without writing files. Both run with Node alone: no PHP, WordPress installation, database, WP-CLI or network requests. Extraction is independent of `files`, `.distignore` and Git `export-ignore` distribution rules."},"1645":{"id":"/js/wp-release/v0.19.0/internationalization-4","page_id":"/js/wp-release/v0.19.0/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/internationalization#wordpress-internationalization","content":"Config-free source directories must have plugin/theme headers. The actual main file is discovered using the package metadata reader, including plugins whose main filename differs from their slug. The selected domain defaults to `Text Domain`, then the directory name. Calls with omitted domains belong to WordPress's `default` domain; block metadata without a domain inherits the package domain. `--all-domains` explicitly combines domains. A block's explicit `textdomain` always controls its messages."},"1646":{"id":"/js/wp-release/v0.19.0/internationalization-5","page_id":"/js/wp-release/v0.19.0/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/internationalization#wordpress-internationalization","content":"`--package` selects one configured package and permits extraction-specific overrides; `--all` requires configuration and selects enabled WordPress packages only. Source directories, package selectors and `--all` are mutually exclusive. Config-free directory mode reads only its explicit options and metadata; it does not import repository config implicitly. A disabled package fails when explicitly selected. Configuration uses `i18n` at the root and on package entries, including an exact `glob` for an individual package, following the existing group model. Package entries remain non-overlapping; there is no additional package manifest configuration source."},"1647":{"id":"/js/wp-release/v0.19.0/internationalization-6","page_id":"/js/wp-release/v0.19.0/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/internationalization#wordpress-internationalization","content":"Precedence is defaults, root configuration, package group/individual entry, then explicit command options. Scalars override, lists replace inherited lists, and gettext headers merge by key, case-insensitively, preserving intentionally empty values. A header set to `false` is removed, like `'Project-Id-Version': false` to keep the plugin version out of the POT so that it changes only when strings change; a later layer can set it again. `Content-Type` can't be removed, since it declares the UTF-8 charset. Options include `enabled`, `domain`, `allDomains`, `include`, `exclude`, `destination`, `headers`, `fileComment`, `location`, `strict`, `legacyGlobals` and audit `suppress`. `fileComment` adds static text above the POT header; each line is emitted as a gettext comment, and no copyright year is generated. The CLI accepts the same setting with `--file-comment`. Repeat `--include` or `--exclude` for multiple globs; these use case-sensitive minimatch semantics with `/` paths, `**`, brace expansion and dotfile matching, without gitignore negation or comma splitting. Default excludes cover dependency directories, dot directories, tests, minified files and generated translations. Source/build exclusions are a repository choice; this repository excludes `build`, `tools` and isolated vendors in its config."},"1648":{"id":"/js/wp-release/v0.19.0/internationalization-7","page_id":"/js/wp-release/v0.19.0/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/internationalization#wordpress-internationalization","content":"The default output is `<Domain Path>/<text-domain>.pot`, or `languages/<text-domain>.pot`. A leading `/` in `Domain Path` is package-relative, and configured destinations cannot escape the package. `--destination` changes the package-relative directory. An explicit `--output <file.pot>` resolves against the command's working directory and requires one package. All multi-package destinations are validated before writing; each completed package replaces its file atomically, independently of other packages. `--check` compares bytes without writing and fails if the POT is absent or stale. Source references are preserved by default as `file:line`. `--add-location file` keeps only the file name, so that editing a source file doesn't change the POT unless its strings change, and `--no-location` (the same as `--add-location never`) omits them; `--add-location full` is the default. In configuration, set `location` to `'full'`, `'file'` or `'never'`. The older `--no-references` flag and `references: false` option still work as `--no-location`, and an explicit `location` wins over `references` in the same layer. Asking for locations and for none in the same command is an error. `POT-Creation-Date` and `PO-Revision-Date` default to empty values; no current date or year is inserted. Name/version headers come from metadata, and `--header NAME=VALUE` overrides any default, including with an empty value, and `--header NAME` removes the header. The POT lists the plugin or theme header strings first, then the strings of PHP, JavaScript, `block.json` and other metadata files in source order, so related strings stay together for translators. Each entry has its extracted comments, references and flags before the strings, in the usual gettext layout. The default headers come in a fixed order, and custom headers follow them. No generator header or generated copyright comment is added; set `fileComment` for a static one."},"1649":{"id":"/js/wp-release/v0.19.0/internationalization-8","page_id":"/js/wp-release/v0.19.0/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/internationalization#supported-extraction-syntax","content":"PHP extraction uses `php-parser` in PHP 8.3 mode, tested with attributes, enums, match expressions, promoted properties and readonly classes. Supported WordPress functions are `__`, `_e`, `_x`, `_ex`, `_n`, `_nx`, `_n_noop`, `_nx_noop`, `esc_attr__`, `esc_attr_e`, `esc_attr_x`, `esc_html__`, `esc_html_e` and `esc_html_x`. Global and explicitly global calls, namespace fallback and explicit function imports/aliases are supported. Known file-local declarations and unrelated namespaced imports are excluded; methods and static methods are never translation calls. Named arguments resolve by PHP parameter name. Literal strings, static concatenation and non-interpolated heredoc/nowdoc preserve decoded escapes, Unicode and newlines. Counts may be dynamic; IDs, contexts and selected domains must be static."},"1650":{"id":"/js/wp-release/v0.19.0/internationalization-9","page_id":"/js/wp-release/v0.19.0/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/internationalization#supported-extraction-syntax","content":"JavaScript extraction uses Babel's parser and lexical scope traversal, without transforms or project Babel config. JS, JSX, TS, TSX, MJS, CJS, MTS and CTS are supported. Named imports/aliases and namespace imports from `@wordpress/i18n`, unshadowed `wp.i18n` calls and unbound canonical legacy `__`, `_x`, `_n` and `_nx` calls extract strings. `--no-legacy-globals` requires imported or `wp.i18n` bindings. Locally shadowed/reassigned imports are excluded. Static literals, templates without substitutions, concatenation and TypeScript assertions are supported. Destructured CommonJS imports, transpiled `(0, i18n.__)` forms and arbitrary minified bundles are outside the supported syntax; scan source and use explicit source/build mapping for compiled JSON."},"1651":{"id":"/js/wp-release/v0.19.0/internationalization-10","page_id":"/js/wp-release/v0.19.0/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/internationalization#supported-extraction-syntax","content":"A `translators:` comment attaches to the first translation call whose containing expression or nearest statement immediately follows it. Whitespace, parsed comments and ternary branch punctuation may intervene, but unrelated statements or argument expressions may not. Comments before outer wrappers reach nested translation calls; a comment is consumed once, so unrelated sibling calls do not inherit it. Multiline comment content is preserved. WordPress plugin/theme header labels serialize as extracted comments. Bundled metadata tables follow WordPress 6.8 block fields and theme fields, including styles, variations, presets, template names and nested block settings. Their upstream data license is GPL-2.0-or-later; tables are maintained intentionally with fixtures and never fetched during generation."},"1652":{"id":"/js/wp-release/v0.19.0/internationalization-11","page_id":"/js/wp-release/v0.19.0/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/internationalization#supported-extraction-syntax","content":"Invalid syntax, unreadable selected files, selected source symlinks, empty/reserved message IDs, conflicting plural definitions and output errors fail generation. Unsupported dynamic arguments warn and are fatal with `--strict`. Audit adds `placeholder-comment`, `unordered-placeholders`, `plural-placeholders`, `empty-message` and `conflicting-comments` findings; suppress these explicitly by code where justified. Placeholders support `%%`, positional indexes, numeric width/precision, padding/flags and PHP/JS sprintf conversion types. Audit checks extraction and message quality, not every untranslated user-facing string. Audit fails on errors; strict audit also fails on warnings. Failed checks return exit code `2`; unexpected I/O/option-loading errors follow the existing CLI error handling. `--json`, GitHub annotations, summaries and step outputs use the existing CLI reporting facilities."},"1653":{"id":"/js/wp-release/v0.19.0/internationalization-12","page_id":"/js/wp-release/v0.19.0/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/internationalization#compile-translated-catalogs","content":"Runtime formats require a translated PO, not an untranslated POT. PO updating, fuzzy matching and automatic translation are not provided. Compilation validates `Language` and `Plural-Forms`, excludes fuzzy, obsolete and untranslated entries, preserves contexts and plural forms, and never changes the input PO. An incompletely translated plural entry is excluded as a unit. Gettext parsing handles source encoding; runtime outputs use UTF-8. Each output is replaced atomically; JSON outputs are independent writes, and obsolete output files are not deleted automatically."},"1654":{"id":"/js/wp-release/v0.19.0/internationalization-13","page_id":"/js/wp-release/v0.19.0/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/internationalization#compile-translated-catalogs","content":"MO and `.l10n.php` default beside the PO, with `.mo` and `.l10n.php` extensions; `--output` selects an explicit file relative to cwd. WordPress PHP catalogs require WordPress 6.5 or later. JSON requires an explicit domain; `--output` is a directory, defaulting to the PO directory. `--check` compares proposed bytes without writing and exits `2` on absent/stale outputs. Compiler commands are primitives and do not select configured packages."},"1655":{"id":"/js/wp-release/v0.19.0/internationalization-14","page_id":"/js/wp-release/v0.19.0/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/internationalization#compile-translated-catalogs","content":"A script map is a JSON object from normalized package-relative source references to arrays of normalized runtime script paths. Many source files can feed one bundle, and one source can feed several scripts. An explicit map selects only listed references; an empty target array excludes that source. Without a map, JS/MJS/CJS references use identity paths, while JSX/TypeScript references require mapping. PHP-only references do not enter JSON catalogs."},"1656":{"id":"/js/wp-release/v0.19.0/internationalization-15","page_id":"/js/wp-release/v0.19.0/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/internationalization#compile-translated-catalogs","content":"JSON filenames are `<domain>-<Language>-<md5(runtime-path)>.json`; the WordPress `default` domain uses `<Language>-<md5(runtime-path)>.json`. WordPress's `.min.js` normalization applies consistently to grouping, hashing and the JSON `source`. Jed keys preserve context through `\\u0004`, plural arrays contain all translated forms, and revision dates come from the PO metadata. `.l10n.php` writes safely escaped data arrays with NUL-separated plural translations; catalog text is never treated as executable PHP."},"1657":{"id":"/js/wp-release/v0.19.0/internationalization-16","page_id":"/js/wp-release/v0.19.0/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/internationalization#compile-translated-catalogs","content":"The extraction and compilation primitives are in the standalone `@wpelevator/wp-gettext` package, without the repository and release tooling, and `wp-release` depends on it. See its README to use them in your own scripts."},"1658":{"id":"/js/wp-release/v0.19.0/internationalization-17","page_id":"/js/wp-release/v0.19.0/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/internationalization#compile-translated-catalogs","content":"The package can be installed and used in any WordPress plugin or theme project; repository package selection is optional, and directory mode works without a wp-release config."},"1659":{"id":"/js/wp-release/v0.19.0/library","page_id":"/js/wp-release/v0.19.0/library","type":"page","content":"Library API","breadcrumbs":["Docs","Js","Wp release","v0.19.0"],"tags":[],"url":"/js/wp-release/v0.19.0/library"},"1660":{"id":"/js/wp-release/v0.19.0/library-0","page_id":"/js/wp-release/v0.19.0/library","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0/library#exit-codes","content":"Exit codes"},"1661":{"id":"/js/wp-release/v0.19.0/library-1","page_id":"/js/wp-release/v0.19.0/library","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0/library#library","content":"Library"},"1662":{"id":"/js/wp-release/v0.19.0/library-2","page_id":"/js/wp-release/v0.19.0/library","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0/library#signing","content":"Signing"},"1663":{"id":"/js/wp-release/v0.19.0/library-3","page_id":"/js/wp-release/v0.19.0/library","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0/library#zip-archives","content":"ZIP archives"},"1664":{"id":"/js/wp-release/v0.19.0/library-4","page_id":"/js/wp-release/v0.19.0/library","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0/library#file-selection","content":"File selection"},"1665":{"id":"/js/wp-release/v0.19.0/library-5","page_id":"/js/wp-release/v0.19.0/library","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0/library#checksums","content":"Checksums"},"1666":{"id":"/js/wp-release/v0.19.0/library-6","page_id":"/js/wp-release/v0.19.0/library","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0/library#translations","content":"Translations"},"1667":{"id":"/js/wp-release/v0.19.0/library-7","page_id":"/js/wp-release/v0.19.0/library","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0/library#logging","content":"Logging"},"1668":{"id":"/js/wp-release/v0.19.0/library-8","page_id":"/js/wp-release/v0.19.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/library#exit-codes","content":"| Code | Meaning                               |\n| ---- | ------------------------------------- |\n| `0`  | Success, dry run, no changes, or help |","table":"table-0"},"1669":{"id":"/js/wp-release/v0.19.0/library-9","page_id":"/js/wp-release/v0.19.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/library#exit-codes","content":"| Code | Meaning                                                 |\n| ---- | ------------------------------------------------------- |\n| `1`  | Unexpected failure, such as a failed svn or git command |","table":"table-0"},"1670":{"id":"/js/wp-release/v0.19.0/library-10","page_id":"/js/wp-release/v0.19.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/library#exit-codes","content":"| Code | Meaning                                                                                                                                          |\n| ---- | ------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `2`  | Invalid options, failed release checks, an existing SVN tag, a Git tag that exists with another release, or files that don't match the checksums |","table":"table-0"},"1671":{"id":"/js/wp-release/v0.19.0/library-11","page_id":"/js/wp-release/v0.19.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/library#exit-codes","content":"| Code | Meaning                                                   |\n| ---- | --------------------------------------------------------- |\n| `3`  | Missing SVN credentials, or credentials that SVN rejected |","table":"table-0"},"1672":{"id":"/js/wp-release/v0.19.0/library-12","page_id":"/js/wp-release/v0.19.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/library#library","content":"`resolveDeployOptions()` applies the defaults and throws a `ValidationError` (with `exitCode` `2`) for invalid combinations. `SvnDeploy` exposes each step (`prepare()`, `checkVersions()`, `checkout()`, `sync()`, `commit()` and `cleanup()`) separately so CI wrappers can run and report them one by one; `run()` runs all of them, or nothing when there's nothing to write. `getPlan()` lists the planned SVN changes. The `Svn` class wraps the svn command line, and takes the command runner as a dependency so that tests can replace it."},"1673":{"id":"/js/wp-release/v0.19.0/library-13","page_id":"/js/wp-release/v0.19.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/library#library","content":"Git deploys:"},"1674":{"id":"/js/wp-release/v0.19.0/library-14","page_id":"/js/wp-release/v0.19.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/library#library","content":"`resolveGitDeployOptions()` throws a `ValidationError` without a repository URL or with an invalid branch or tag. `GitDeploy` exposes `createTree()`, `fetchPrevious()`, `createRelease()`, `isOutdated()`, `checkTag()`, `getRefsToPush()` and `push()` separately, like `SvnDeploy`, and takes a git command runner from `createGitRunner()` as a dependency. The result has `outdated` when the branch wasn't moved for older source history, the refs to write in `planned` and the refs that were pushed in `pushed`, which is empty in a dry run. `redactUrls()` hides the credentials in URLs."},"1675":{"id":"/js/wp-release/v0.19.0/library-15","page_id":"/js/wp-release/v0.19.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/library#library","content":"Changeset releases:"},"1676":{"id":"/js/wp-release/v0.19.0/library-16","page_id":"/js/wp-release/v0.19.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/library#library","content":"`ChangesetRelease` runs the `changeset-*` commands: `add()`, `getStatus()`, `version()` and `tag()`, plus `getPlan()`, `getPackages()` and `getConfiguredPackages()`. Each call reads the configuration, packages and pending changesets again, so one instance can version and then tag. `getConfiguredPackages()` returns package directories with their resolved release group metadata; `formatTag()` and `formatTemplate()` apply the same placeholders as the release workflows. It takes a git runner from `createGitRunner()` as `git`, so that tests can replace it. Without a config file, it detects a single root project. Its optional `singleProject` settings accept `versions` (the existing version descriptors), `versionFrom` (the same selector as `--version-from`), `baseBranch`, `remote`, `changesets`, `readmeChangelog` and `changelogInsertAfter`; `tagFormat` remains a repository option. The functions `addChangeset()`, `getChangesetStatus()`, `versionChangesets()`, `tagChangesets()`, `getChangesetReleasePlan()`, `getChangesetPackages()` and `getConfiguredPackages()` do the same with the default runners, in one call."},"1677":{"id":"/js/wp-release/v0.19.0/library-17","page_id":"/js/wp-release/v0.19.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/library#signing","content":"The Ed25519 key handling and the WordPress, minisign and OpenSSH signature formats live in the `@wpelevator/signatures` package, which `@wpelevator/wp-release` depends on. It still re-exports the signing functions that it has always exported; the bytes-first functions and error guards are only in `@wpelevator/signatures`. The wp-release functions read the key from `WP_RELEASE_SIGNING_KEY` and report invalid input as a `ValidationError` with the original error as its `cause`; the `@wpelevator/signatures` functions use `SIGNING_KEY` by default and throw a `SigningError`."},"1678":{"id":"/js/wp-release/v0.19.0/library-18","page_id":"/js/wp-release/v0.19.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/library#zip-archives","content":"Reproducible archives and safe extraction live in the `@wpelevator/zip` package, which `@wpelevator/wp-release` depends on. It still exports `createZip()`, `readZipEntries()`, `getZipEntryErrors()`, `extractZip()`, `ZIP_MTIME` and `ZIP_FILE_MODE` with their `sourceDir`, `files` and `zipPath` inputs, and reports invalid input as a `ValidationError` with the original error as its `cause`. The zip package takes a list of `{ source, name }` entries, where the source is a file path or bytes, and can create and read archives in memory. Entries have the fixed `ZIP_MTIME`, or the `SOURCE_DATE_EPOCH` time when that environment variable is set."},"1679":{"id":"/js/wp-release/v0.19.0/library-19","page_id":"/js/wp-release/v0.19.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/library#file-selection","content":"Gitignore-style file selection and directory syncing live in the `@wpelevator/fileset` package, which `@wpelevator/wp-release` depends on. It still exports `resolveFileSelection()`, `loadFileRules()`, `selectFiles()`, `parseExclude()`, `syncDirectory()` and `copyFileIfChanged()` with the same inputs, and reports invalid input as a `ValidationError` with the original error as its `cause`. The fileset package has no Git dependency: it takes a function that lists more files to exclude, `listExcluded`, and `@wpelevator/wp-release` passes one that reads the `export-ignore` attribute with Git when `excludeGitattributes` is set. The ignore file name (`.distignore` by default) and the directories that a sync leaves alone (`.svn` by default) are options of the fileset package."},"1680":{"id":"/js/wp-release/v0.19.0/library-20","page_id":"/js/wp-release/v0.19.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/library#checksums","content":"Hashing, the checksums manifest formats and their comparison live in the `@wpelevator/checksums` package, which `@wpelevator/wp-release` depends on. It still exports `createChecksums()`, `writeChecksums()`, `readChecksums()`, `parseChecksums()`, `verifyChecksums()`, `compareChecksums()`, `hashFile()`, `hashFiles()` and the `wordpressCodec` and `sha256sumCodec` codecs with the same inputs and output, and reports invalid input as a `ValidationError` with the original error as its `cause`. The checksums package takes a plain list of file paths instead of file rules, hashes bytes and streams with `hashBytes()` and `hashStream()`, and keeps the plugin or theme slug and version as generic `metadata` next to the `files`, which `@wpelevator/wp-release` fills in. Manifests are written byte for byte as before."},"1681":{"id":"/js/wp-release/v0.19.0/library-21","page_id":"/js/wp-release/v0.19.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/library#translations","content":"Extracting translatable strings from PHP, JavaScript and `block.json` sources, building catalogs, writing POT files, compiling PO files to MO, script JSON and `.l10n.php`, and auditing live in the `@wpelevator/wp-gettext` package, which `@wpelevator/wp-release` depends on. It still exports the same functions, like `extractCatalog()`, `generatePackagePot()`, `serializePot()`, `parseTranslatedPo()` and `compileTranslations()`, with the same inputs and output, and reports invalid input as a `ValidationError` with the original error as its `cause`. The wp-gettext package doesn't read plugin and theme headers: it takes the header details as a `meta` input, which `@wpelevator/wp-release` reads from the main file with its own package metadata reader. `resolveI18nPackages()`, which selects the configured packages, stays in `@wpelevator/wp-release`. Importing the main entry of `@wpelevator/wp-gettext` doesn't load the PHP and JavaScript parsers, which are in the `/php` and `/javascript` sub-paths."},"1682":{"id":"/js/wp-release/v0.19.0/library-22","page_id":"/js/wp-release/v0.19.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/library#logging","content":"`Logger` filters messages by level and passes them to a writer, like the transports of other Node.js loggers. The writer decides how messages look:"},"1683":{"id":"/js/wp-release/v0.19.0/library-23","page_id":"/js/wp-release/v0.19.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/library#logging","content":"`TextWriter` prints plain text to `stdout` and `stderr`. It's the default."},"1684":{"id":"/js/wp-release/v0.19.0/library-24","page_id":"/js/wp-release/v0.19.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/library#logging","content":"`GitHubActionsWriter` prints workflow commands, so that notices, warnings and errors with a file are annotations, and appends summaries to `GITHUB_STEP_SUMMARY`. It's the CLI's `github` log format, and the GitHub Actions pass it to their logger. Its `workspace` and `summaryPath` options default to `GITHUB_WORKSPACE` and `GITHUB_STEP_SUMMARY`."},"1685":{"id":"/js/wp-release/v0.19.0/library-25","page_id":"/js/wp-release/v0.19.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/library#logging","content":"A writer implements `LogWriter` with `write()`, `startGroup()`, `endGroup()` and `summary()`, so other CI systems can have their own format. `summary()` takes a function that builds the Markdown, which only writers with a summary call."},"1686":{"id":"/js/wp-release/v0.19.0/library-26","page_id":"/js/wp-release/v0.19.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/library#logging","content":"A `ValidationError` can list `problems`, each with a `message` and an optional `file`, `line` and `title`. `logError( logger, error, title )` logs each problem as an error on its file and line and lists them in the summary under the title, or logs the message when there are none. `VersionMismatchError` and `version-check` report the version mismatches this way."},"1687":{"id":"/js/wp-release/v0.19.0/library-27","page_id":"/js/wp-release/v0.19.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/library#logging","content":"ZIP files and metadata:"},"1688":{"id":"/js/wp-release/v0.19.0/library-28","page_id":"/js/wp-release/v0.19.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/library#logging","content":"Checksums:"},"1689":{"id":"/js/wp-release/v0.19.0/library-29","page_id":"/js/wp-release/v0.19.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/library#logging","content":"`loadFileRules()` reads the ignore file and `--exclude` patterns into a gitignore matcher, optionally adds Git `export-ignore` paths, and `selectFiles()` lists the files it doesn't ignore. `compareChecksums()` compares two hash maps without reading any files, and `parseChecksums()` validates manifest JSON. `extractZip()` extracts a ZIP after the same checks as `deploy-svn --from-zip`."},"1690":{"id":"/js/wp-release/v0.19.0/library-30","page_id":"/js/wp-release/v0.19.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/library#logging","content":"Translations:"},"1691":{"id":"/js/wp-release/v0.19.0/library-31","page_id":"/js/wp-release/v0.19.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/library#logging","content":"The parsers, catalog and compiler functions are provided by `@wpelevator/wp-gettext`. Parsers return messages and structured diagnostics with stable codes, severity and source-relative locations. Catalog messages retain IDs, contexts, plurals, translations, translator comments, flags and structured references. `aggregateCatalog()` selects/merges a domain, unions references/comments and diagnoses plural conflicts. `resolveI18nPackages()` is the separate config adapter; extraction and serialization primitives know nothing about the repository. Library functions do not log, parse process arguments or set exit codes. Extraction results report unique files consulted, including the main plugin/theme file used for headers and header strings even when source globs exclude it. `parseTranslatedPo()`, `compileMo()`, `compileScriptTranslations()`, `compilePhpTranslations()` and `compileTranslations()` expose the same typed operations to library callers."},"1692":{"id":"/js/wp-release/v0.19.0/packaging","page_id":"/js/wp-release/v0.19.0/packaging","type":"page","content":"Packaging and integrity","breadcrumbs":["Docs","Js","Wp release","v0.19.0"],"tags":[],"url":"/js/wp-release/v0.19.0/packaging"},"1693":{"id":"/js/wp-release/v0.19.0/packaging-0","page_id":"/js/wp-release/v0.19.0/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0/packaging#build-a-directory","content":"Build a directory"},"1694":{"id":"/js/wp-release/v0.19.0/packaging-1","page_id":"/js/wp-release/v0.19.0/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0/packaging#zip","content":"ZIP"},"1695":{"id":"/js/wp-release/v0.19.0/packaging-2","page_id":"/js/wp-release/v0.19.0/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0/packaging#signing-targets-for-builds-and-zips","content":"Signing targets for builds and ZIPs"},"1696":{"id":"/js/wp-release/v0.19.0/packaging-3","page_id":"/js/wp-release/v0.19.0/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0/packaging#checksums","content":"Checksums"},"1697":{"id":"/js/wp-release/v0.19.0/packaging-4","page_id":"/js/wp-release/v0.19.0/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0/packaging#filenames-embedding-and-signing","content":"Filenames, embedding and signing"},"1698":{"id":"/js/wp-release/v0.19.0/packaging-5","page_id":"/js/wp-release/v0.19.0/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0/packaging#formats","content":"Formats"},"1699":{"id":"/js/wp-release/v0.19.0/packaging-6","page_id":"/js/wp-release/v0.19.0/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0/packaging#configuration-and-custom-codecs","content":"Configuration and custom codecs"},"1700":{"id":"/js/wp-release/v0.19.0/packaging-7","page_id":"/js/wp-release/v0.19.0/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0/packaging#manifest-inside-the-plugin","content":"Manifest inside the plugin"},"1701":{"id":"/js/wp-release/v0.19.0/packaging-8","page_id":"/js/wp-release/v0.19.0/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0/packaging#verify","content":"Verify"},"1702":{"id":"/js/wp-release/v0.19.0/packaging-9","page_id":"/js/wp-release/v0.19.0/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0/packaging#sign","content":"Sign"},"1703":{"id":"/js/wp-release/v0.19.0/packaging-10","page_id":"/js/wp-release/v0.19.0/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0/packaging#signature-formats","content":"Signature formats"},"1704":{"id":"/js/wp-release/v0.19.0/packaging-11","page_id":"/js/wp-release/v0.19.0/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.19.0/packaging#version-check","content":"Version check"},"1705":{"id":"/js/wp-release/v0.19.0/packaging-12","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#build-a-directory","content":"`build` and `zip` use the same internal helper to load file rules, exclude their outputs, select release files and reject an empty selection. `build` copies the selected files directly into `--output <dir>`, without a slug wrapper or ZIP. Checksums and manifest signatures are optional. It supports the shared file selection flags above and `--package <name>` with `--config <path>` for configured package rules. A configured package cannot be combined with a source directory or file selection flags."},"1706":{"id":"/js/wp-release/v0.19.0/packaging-13","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#build-a-directory","content":"The destination is required and automatically excluded when it is inside the source. It cannot be the source directory or an ancestor, including through symlinked parents. Existing destinations require `--force`, which replaces the directory and removes stale files; existing files and symbolic links are rejected. Files are copied to a temporary directory before the existing build is replaced. Selected symbolic links are rejected as with ZIP packaging. `--json` returns `outputDir`, `files` and, for configured builds, `package`; it also returns `checksumsPath` when a manifest is generated, and `signatures` and `publicKey` when signing is requested. `--github-output` exposes these results too."},"1707":{"id":"/js/wp-release/v0.19.0/packaging-14","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#build-a-directory","content":"`--checksums` writes `<output-dir>.checksums.json` beside the directory and hashes the copied build files. `--sign-checksums` generates and signs that manifest, implying `--checksums`. Use `--slug` and `--version` to override its metadata. The manifest and its signatures are excluded from the source selection, so rebuilding with `--force` does not package previous sidecars. Existing manifests and requested signature files also require `--force`; signing keys, formats and signature destinations are validated before creating or replacing the build. `--sign` is unsupported because a directory has no single file to sign."},"1708":{"id":"/js/wp-release/v0.19.0/packaging-15","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#build-a-directory","content":"In the Deploy workflow, a directory build can be deployed with `wp-release deploy-svn dist/code-prettify --slug code-prettify --trunk --svn-tag \"$GITHUB_REF_NAME\" --no-distignore`. Keep `--from-zip` when the SVN deployment must match the attached ZIP exactly. Run dependency installation and compilation before `build`; it only selects and copies files."},"1709":{"id":"/js/wp-release/v0.19.0/packaging-16","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#zip","content":"The `wp-release-zip` GitHub Action runs this command."},"1710":{"id":"/js/wp-release/v0.19.0/packaging-17","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#zip","content":"`zip` writes `{slug}.{version}.zip` to the current directory, or to `--output <file>`, with the selected files in a `{slug}/` root folder:"},"1711":{"id":"/js/wp-release/v0.19.0/packaging-18","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#zip","content":"`--root-folder <name>` changes the root folder and `--no-root-folder` puts the files at the root of the ZIP."},"1712":{"id":"/js/wp-release/v0.19.0/packaging-19","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#zip","content":"`--filename-format` changes the name, like `--filename-format {slug}` for `my-plugin.zip`."},"1713":{"id":"/js/wp-release/v0.19.0/packaging-20","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#zip","content":"Entries are sorted and use a fixed file mode and a fixed timestamp (1980-01-01), or the `SOURCE_DATE_EPOCH` Unix time when that environment variable is set, so the same files give the same ZIP. Built-in metadata is deterministic except for embedded minisign signatures, which include their signing timestamp; custom codec callbacks control their own encoded bytes."},"1714":{"id":"/js/wp-release/v0.19.0/packaging-21","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#zip","content":"`--checksums` also writes the checksums manifest of the archived files next to the ZIP, with `.checksums.json` instead of `.zip`."},"1715":{"id":"/js/wp-release/v0.19.0/packaging-22","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#zip","content":"`--sign` signs only the ZIP with `WP_RELEASE_SIGNING_KEY`. `--sign-checksums` generates and signs only the checksums manifest, implying `--checksums`. Use both flags to sign both files. External signatures are written alongside their files; embedded manifest signatures are written inside the package. The default format is WordPress `.sig`, unless integrity configuration selects another format."},"1716":{"id":"/js/wp-release/v0.19.0/packaging-23","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#zip","content":"`--sign-format` selects formats for requested signatures, such as `--sign-format wordpress,minisign,ssh`. It requires `--sign` or `--sign-checksums` and never enables signing by itself. Signing keys, formats and existing signature destinations are validated before writing the ZIP or manifest. `--force` also overwrites requested signatures. Job summaries include signatures and public keys; JSON results include `signatures` and `publicKey`."},"1717":{"id":"/js/wp-release/v0.19.0/packaging-24","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#zip","content":"An existing ZIP or manifest isn't overwritten without `--force`. A ZIP or manifest written inside the source directory is never archived."},"1718":{"id":"/js/wp-release/v0.19.0/packaging-25","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#zip","content":"`--package <name>` zips a package of the configured packages, by identifier or path under the configured root like `plugins/alpha`, instead of a source directory: its directory with the `files` config of its package group, the same files that its deploys select. The slug defaults to the directory name and the version to the `Version` header, and `--slug` and `--version` still set them. Any package of the config works, with or without a version or deploy targets. To zip what a deploy just released, pass the `package` and `version` of the `deploy-git --release-ref` result, in the same job and from the same build, so the ZIP has exactly the files of the release tag in the release repository. It can't be combined with `<source-dir>` or the file selection options. The `--json` result has the `package`, `slug` and `version`. `zipPackage()` builds the same ZIP from a script, with `getPackageFiles()` for the directory and the files of a package."},"1719":{"id":"/js/wp-release/v0.19.0/packaging-26","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#zip","content":"To embed a signed manifest with a stable filename, use:"},"1720":{"id":"/js/wp-release/v0.19.0/packaging-27","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#zip","content":"See Checksums for filenames, placement, formats and configuration."},"1721":{"id":"/js/wp-release/v0.19.0/packaging-28","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#signing-targets-for-builds-and-zips","content":"| Flag          | `zip`                                         | `build`                                             |\n| ------------- | --------------------------------------------- | --------------------------------------------------- |\n| `--checksums` | Generate an unsigned manifest beside the ZIP. | Generate an unsigned manifest beside the directory. |","table":"table-0"},"1722":{"id":"/js/wp-release/v0.19.0/packaging-29","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#signing-targets-for-builds-and-zips","content":"| Flag     | `zip`              | `build`      |\n| -------- | ------------------ | ------------ |\n| `--sign` | Sign only the ZIP. | Unsupported. |","table":"table-0"},"1723":{"id":"/js/wp-release/v0.19.0/packaging-30","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#signing-targets-for-builds-and-zips","content":"| Flag               | `zip`                           | `build`                         |\n| ------------------ | ------------------------------- | ------------------------------- |\n| `--sign-checksums` | Generate and sign the manifest. | Generate and sign the manifest. |","table":"table-0"},"1724":{"id":"/js/wp-release/v0.19.0/packaging-31","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#signing-targets-for-builds-and-zips","content":"| Flag            | `zip`                                               | `build`                            |\n| --------------- | --------------------------------------------------- | ---------------------------------- |\n| `--sign-format` | Choose formats for explicitly requested signatures. | Same; requires `--sign-checksums`. |","table":"table-0"},"1725":{"id":"/js/wp-release/v0.19.0/packaging-32","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#signing-targets-for-builds-and-zips","content":"These flags deliberately replace the former implicit signing behavior: `zip --checksums --sign` now leaves the manifest unsigned, and `--sign-format` alone is rejected. Add `--sign-checksums` to sign a manifest and `--sign` to sign a ZIP. The standalone `checksums` and `sign` commands remain available for workflows that write and sign a manifest inside the source before packaging it."},"1726":{"id":"/js/wp-release/v0.19.0/packaging-33","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#checksums","content":"The `wp-release-checksums` GitHub Action runs this command."},"1727":{"id":"/js/wp-release/v0.19.0/packaging-34","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#checksums","content":"`checksums` writes a manifest with the MD5 and SHA-256 hash of every selected file, in the format of the WordPress.org plugin checksums API (`https://downloads.wordpress.org/plugin-checksums/{slug}/{version}.json`). Paths are relative to the plugin or theme folder, sorted, and use forward slashes:"},"1728":{"id":"/js/wp-release/v0.19.0/packaging-35","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#checksums","content":"Themes use a `theme` key instead of `plugin`, and the version is left out when it's unknown. The manifest is named `{slug}.{version}.checksums.json` after `--filename-format`, the same name as the ZIP with `.checksums.json` instead of `.zip`, so the two are published side by side; `--output <file>` writes it elsewhere. A manifest written inside `<source-dir>` is never listed in itself."},"1729":{"id":"/js/wp-release/v0.19.0/packaging-36","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#checksums","content":"Because the manifest lists the files and not the ZIP, it stays valid for any copy of the same files: the GitHub release ZIP, the ZIP that WordPress.org builds from SVN, or an installed plugin on a site."},"1730":{"id":"/js/wp-release/v0.19.0/packaging-37","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#filenames-embedding-and-signing","content":"`--checksums-file <file>` enables checksums and sets a relative filename independently of the ZIP name. Without `--embed-checksums`, it resolves against the ZIP output directory; with embedding, it resolves against the package root inside the ZIP (the archive root with `--no-root-folder`). Nested paths are supported, but absolute paths, backslashes, drive letters, control characters and dot segments are rejected. Embedding emits no external manifest and never modifies the source directory. Embedded minisign signatures contain a signing timestamp, so ZIP bytes can differ across signing times; unsigned metadata and WordPress/SSH signatures remain deterministic. Selected source files must not collide with generated manifest or signature entries."},"1731":{"id":"/js/wp-release/v0.19.0/packaging-38","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#filenames-embedding-and-signing","content":"`--sign-checksums` enables checksums and signs only the manifest, before embedding when requested. It reads `WP_RELEASE_SIGNING_KEY` and uses `--sign-format wordpress,minisign,ssh` to select formats; each signature travels with the manifest. `--sign-format` selects formats for explicitly requested signing targets and never enables signing. `--sign` signs only the final ZIP; `--sign-checksums` controls the manifest in either placement mode. Use both flags to sign both targets. `--force` permits replacing external output files and signatures. `--json` reports external manifests in `checksumsPath`, embedded package-relative paths in `checksumsEmbedded`, and manifest signatures in `checksumsSignatures`."},"1732":{"id":"/js/wp-release/v0.19.0/packaging-39","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#filenames-embedding-and-signing","content":"The default WordPress filename remains the ZIP basename with `.checksums.json` instead of `.zip`, in either placement mode. Choose `--checksums-file checksums.json` for a stable name. The version remains in the JSON content."},"1733":{"id":"/js/wp-release/v0.19.0/packaging-40","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#formats","content":"`--checksums-format` chooses the manifest format. `wordpress-json` (default) uses the WordPress-compatible structure shown above. `sha256sum` uses GNU-compatible SHA-256 lines and escaping, with `SHA256SUMS` as its default filename. It carries no package identity or version, and standard `sha256sum --check` checks listed files without rejecting additional files; `wp-release verify` also checks for extra files."},"1734":{"id":"/js/wp-release/v0.19.0/packaging-41","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#formats","content":"`--checksums-algorithms md5,sha256` selects JSON digest fields; lists replace configured lists. Supported algorithms are MD5 (for compatibility) and SHA-256. The `sha256sum` codec requires SHA-256. The standalone `checksums` command also accepts `--checksums-format`, keeping `--output` relative to the working directory."},"1735":{"id":"/js/wp-release/v0.19.0/packaging-42","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#configuration-and-custom-codecs","content":"The optional top-level `integrity` configuration maps to these flags. Explicit CLI values override configuration; `--no-embed-checksums` and `--no-sign-checksums` disable their configured behaviors. Existing release configurations retain their `packages` array; use `packages: []` for a configuration containing only integrity settings."},"1736":{"id":"/js/wp-release/v0.19.0/packaging-43","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#configuration-and-custom-codecs","content":"Use `codec: 'sha256sum'`, `algorithms: ['sha256']`, `file: 'SHA256SUMS'` and `sign: { formats: ['minisign'] }` for the GNU setup. Custom codecs provide `id`, a default `filename`, and `encode`/`decode` callbacks, which may be asynchronous. Generation validates the round trip before writing artifacts: codecs must preserve all selected file paths, represented digests and any represented package identity. They receive and return the existing WordPress-compatible `ChecksumsManifest` model (`plugin` or `theme`, optional `version`, and a `files` map of relative paths to digest fields), keeping format customization separate from selection, hashing and signing."},"1737":{"id":"/js/wp-release/v0.19.0/packaging-44","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#configuration-and-custom-codecs","content":"`zip` and `checksums` read the caller's release configuration. For verification of custom codecs or configured filenames, pass `--config wp-release.config.mjs` explicitly. See Verify."},"1738":{"id":"/js/wp-release/v0.19.0/packaging-45","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#manifest-inside-the-plugin","content":"For a manifest that is also published as a separate release asset or deployed directly from a source directory, write and sign it in that directory before packaging. Use `zip --embed-checksums` as described above when only the archive should contain the generated metadata. The source-directory workflow uses the same manifest for installed copies and release assets:"},"1739":{"id":"/js/wp-release/v0.19.0/packaging-46","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#manifest-inside-the-plugin","content":"Write the manifest into the directory that is zipped and deployed. The `checksums` command leaves its output manifest and its signatures (`<name>.sig`, `<name>.minisig` and `<name>.sshsig`) out of the hashes, so running it again with the same output path and `--force` gives the same manifest. `verify` checks matching copies as described below. Sign it last, since the signature covers the exact bytes of the manifest."},"1740":{"id":"/js/wp-release/v0.19.0/packaging-47","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#manifest-inside-the-plugin","content":"`zip` and `deploy-svn` carry the pair like any other file. Don't use `zip --checksums` here, since it would write a second manifest that lists the first one. Attach `build/checksums.json` and `build/checksums.json.sig` to the GitHub release as they are."},"1741":{"id":"/js/wp-release/v0.19.0/packaging-48","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#manifest-inside-the-plugin","content":"The signature covers file hashes and not a ZIP, so it stays valid for the ZIP that WordPress.org builds from SVN. Check what WordPress.org serves after a deploy, with the manifest and public key from your build:"},"1742":{"id":"/js/wp-release/v0.19.0/packaging-49","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#manifest-inside-the-plugin","content":"The manifest can have any name and location, for example `--output build/includes/signatures/checksums.json`, and missing folders are created. Tell `verify` where the shipped copy is with `--embedded <path>`, like `--embedded includes/signatures/checksums.json`. Both the `--checksums` file and its signature must then exist, both copies must be shipped, and they're skipped when comparing files and must be identical to the originals. The manifest can't list the embedded path. Without `--embedded`, `verify` looks for the manifest name at the root, and skips a file only when it exists, the matching original exists and the manifest doesn't list it. Otherwise it's checked like any other file, so a listed file that has the name of the manifest can't be deleted unnoticed, and a shipped `.sig` without an original is reported as not in the checksums."},"1743":{"id":"/js/wp-release/v0.19.0/packaging-50","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#manifest-inside-the-plugin","content":"The public key has to come from somewhere other than the plugin that it checks, because someone who can overwrite the plugin files can also replace a key and a signature inside them. A copy of the manifest also doesn't prevent a downgrade to an older release that was signed too, so the installing side has to enforce a minimum version."},"1744":{"id":"/js/wp-release/v0.19.0/packaging-51","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#verify","content":"`verify` checks a directory against a manifest from `checksums` or from the WordPress.org checksums API, and reports every changed, missing and extra file. It exits with `2` unless all files match:"},"1745":{"id":"/js/wp-release/v0.19.0/packaging-52","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#verify","content":"A file matches when its SHA-256 equals the manifest. Manifests without SHA-256 fall back to MD5, and a hash can also be a list of accepted values."},"1746":{"id":"/js/wp-release/v0.19.0/packaging-53","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#verify","content":"`verify` doesn't read `.distignore`, so that an ignore file inside the checked directory can't hide added files. `--exclude <patterns>` skips paths in both the directory and the manifest, for files that aren't part of the release, such as caches."},"1747":{"id":"/js/wp-release/v0.19.0/packaging-54","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#verify","content":"Manifest paths outside the package folder (absolute or with `..`) are rejected."},"1748":{"id":"/js/wp-release/v0.19.0/packaging-55","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#verify","content":"`--zip <file|url>` checks the files of a ZIP instead of a directory. The ZIP can be a URL, such as the one that WordPress.org builds for a release, and its single root folder is found automatically (or set `--root-folder`). The ZIP is extracted to a temporary directory after the same safety checks as `deploy-svn --from-zip`."},"1749":{"id":"/js/wp-release/v0.19.0/packaging-56","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#verify","content":"The version in the manifest must match the `Version` header of the checked files, so that an older release with its own valid manifest can't pass as a newer one."},"1750":{"id":"/js/wp-release/v0.19.0/packaging-57","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#verify","content":"A manifest can't list itself. A copy of the manifest and of its signature inside the checked files, at the root with the same names as the `--checksums` file or at the path of `--embedded`, is skipped when comparing files, but it must be identical to the `--checksums` file and its signature. The signature is the `.sig` file, or the file of `--signature-format`. A path that the manifest lists is never skipped, and a file that isn't a matching copy is reported as not in the checksums. See Manifest inside the plugin."},"1751":{"id":"/js/wp-release/v0.19.0/packaging-58","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#verify","content":"A checksums manifest proves only that the files match the manifest. With `--public-key <key>`, `verify` first checks `<checksums>.sig` against the Ed25519 public key and fails with exit code `2` before comparing any file when the signature is missing or invalid, so that the manifest itself can be trusted. `--signature-format minisign` or `ssh` checks `<checksums>.minisig` or `<checksums>.sshsig` instead. The key can be the base64 key, the minisign public key or the `ssh-ed25519` public key, since they're forms of the same key. See Sign."},"1752":{"id":"/js/wp-release/v0.19.0/packaging-59","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#verify","content":"Verification never executes configuration from inside a downloaded package. Without `--checksums`, `verify` reads the embedded filename selected by `--checksums-file`, explicit configuration, or the codec default. For a versioned embedded filename, pass that filename explicitly. With a public key, signatures are checked before decoding; the selected signature format must exist (WordPress `.sig` by default; pass `--signature-format minisign` or `ssh` for those formats), and all other present supported signature formats are also authenticated when verifying the embedded manifest. Without a public key, checksums detect changes but do not authenticate the publisher. Trusted public keys must come from outside the package."},"1753":{"id":"/js/wp-release/v0.19.0/packaging-60","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#sign","content":"The `wp-release-sign` GitHub Action runs this command."},"1754":{"id":"/js/wp-release/v0.19.0/packaging-61","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#sign","content":"`sign` writes a detached signature next to each file, `<file>.sig`, so that downloads and installed copies can be trusted. Sign both the ZIP and the checksums manifest: the ZIP signature covers installs and updates, and the manifest signature covers the contents after unpacking and copies that weren't built by you."},"1755":{"id":"/js/wp-release/v0.19.0/packaging-62","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#sign","content":"The signature is the one WordPress core's `verify_file_signature()` checks: a base64 Ed25519 signature of the raw SHA-384 digest of the file. The tests check it against `sodium_crypto_sign_verify_detached()` in PHP. A `.sig` file can hold several signatures, one per line, and a file is valid when any of them match, which allows a key rotation window."},"1756":{"id":"/js/wp-release/v0.19.0/packaging-63","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#sign","content":"The key is read from the `WP_RELEASE_SIGNING_KEY` environment variable only, as a base64 32-byte Ed25519 seed or a 64-byte libsodium secret key, the formats that `sodium_crypto_sign_seed_keypair()` and the update-pilot-server package signing key take. There's no flag for it, since it would show in the process list, and it's never logged."},"1757":{"id":"/js/wp-release/v0.19.0/packaging-64","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#sign","content":"`--verbose` prints the public key of the signing key in the form of each written format. `--json` returns it as `publicKey`, and in every form as `publicKeys`. Pass it to `verify --public-key` and to the plugin that checks the signatures."},"1758":{"id":"/js/wp-release/v0.19.0/packaging-65","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#sign","content":"An existing signature file isn't overwritten without `--force`."},"1759":{"id":"/js/wp-release/v0.19.0/packaging-66","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#sign","content":"`zip --sign` signs only the ZIP; add `--sign-checksums` to sign its manifest too. `signFiles()` signs files from a script."},"1760":{"id":"/js/wp-release/v0.19.0/packaging-67","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#signature-formats","content":"The same key can also sign in formats that tools outside WordPress check, for people who download a release by hand or verify it in other pipelines. Pick them with `--format`, comma-separated or repeated; the default is `wordpress`:"},"1761":{"id":"/js/wp-release/v0.19.0/packaging-68","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#signature-formats","content":"| Format      | File         | Checked by                                                                        |\n| ----------- | ------------ | --------------------------------------------------------------------------------- |\n| `wordpress` | `<file>.sig` | WordPress core's `verify_file_signature()`, update-client and `wp-release verify` |","table":"table-1"},"1762":{"id":"/js/wp-release/v0.19.0/packaging-69","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#signature-formats","content":"| Format     | File             | Checked by                                                                    |\n| ---------- | ---------------- | ----------------------------------------------------------------------------- |\n| `minisign` | `<file>.minisig` | minisign and compatible tools: `minisign -Vm <file> -P <minisign public key>` |","table":"table-1"},"1763":{"id":"/js/wp-release/v0.19.0/packaging-70","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#signature-formats","content":"| Format | File            | Checked by                                                                                                      |\n| ------ | --------------- | --------------------------------------------------------------------------------------------------------------- |\n| `ssh`  | `<file>.sshsig` | OpenSSH 8.1 or later: `ssh-keygen -Y verify -f allowed_signers -I <identity> -n file -s <file>.sshsig < <file>` |","table":"table-1"},"1764":{"id":"/js/wp-release/v0.19.0/packaging-71","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#signature-formats","content":"`minisign` signs the BLAKE2b-512 digest of the file, like `minisign -S` does by default, and adds a trusted comment with the signing time and file name that a second signature covers. minisign generates a random key ID for its keys, but the key here is a plain Ed25519 seed, so wp-release derives the key ID from the public key. `wp-release verify` doesn't compare key IDs, so signatures of keys that minisign generated verify too."},"1765":{"id":"/js/wp-release/v0.19.0/packaging-72","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#signature-formats","content":"`ssh` is the armored `SSHSIG` format that `ssh-keygen -Y sign` writes, with a SHA-512 digest and the `file` namespace, so that the signature can't pass as one for commits or another namespace. It's written to `.sshsig` instead of the `.sig` of `ssh-keygen`, which the `wordpress` format uses. Put the SSH public key in an `allowed_signers` file as `<identity> ssh-ed25519 AAAA…`."},"1766":{"id":"/js/wp-release/v0.19.0/packaging-73","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#signature-formats","content":"All formats are Ed25519 signatures by the same key, so one key and one secret cover all of them. The tests check each format with `minisign`, `ssh-keygen` and libsodium, and check the signatures that `minisign` and `ssh-keygen` write with `wp-release verify`."},"1767":{"id":"/js/wp-release/v0.19.0/packaging-74","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#signature-formats","content":"Generate a key pair with `wp-release keygen`. It prints the private seed once as `WP_RELEASE_SIGNING_KEY=…` and the matching public key, also as a minisign public key and an `ssh-ed25519` public key. Generate keys locally and store the private seed in your secret manager or CI secrets. Distribute the public key to verifiers. `keygen --github-output` is rejected to keep the private seed out of workflow outputs; regular and `--json` output both include the seed."},"1768":{"id":"/js/wp-release/v0.19.0/packaging-75","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#version-check","content":"`version-check` compares the versions that have to agree before a release, and reports every mismatch with exit code `2`:"},"1769":{"id":"/js/wp-release/v0.19.0/packaging-76","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#version-check","content":"The expected version is `--version`, or the `Version` header."},"1770":{"id":"/js/wp-release/v0.19.0/packaging-77","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#version-check","content":"The readme `Stable tag` must match for plugins; `--no-stable-tag` skips it, and themes have no Stable tag."},"1771":{"id":"/js/wp-release/v0.19.0/packaging-78","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#version-check","content":"`--constant NAME` (repeatable) checks `define( 'NAME', '1.2.0' )` or `const NAME = '1.2.0'` in every PHP file outside `vendor/`, `node_modules/` and dot directories. A constant that isn't defined is a mismatch."},"1772":{"id":"/js/wp-release/v0.19.0/packaging-79","page_id":"/js/wp-release/v0.19.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.19.0/packaging#version-check","content":"`--git-tag` defaults to `GITHUB_REF` when it's a tag. `--git-tag-format` (default `{version}`) can have a prefix or the slug, like `v{version}` or `{slug}-{version}`; a leading `v` in the version is ignored, like for SVN tags."},"1773":{"id":"/js/wp-release/v0.20.0/changesets","page_id":"/js/wp-release/v0.20.0/changesets","type":"page","content":"Changesets","breadcrumbs":["Docs","Js","Wp release","v0.20.0"],"tags":[],"url":"/js/wp-release/v0.20.0/changesets"},"1774":{"id":"/js/wp-release/v0.20.0/changesets-0","page_id":"/js/wp-release/v0.20.0/changesets","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0/changesets#changesets-support","content":"Changesets support"},"1775":{"id":"/js/wp-release/v0.20.0/changesets-1","page_id":"/js/wp-release/v0.20.0/changesets","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0/changesets#single-project-repositories-without-a-config-file","content":"Single-project repositories without a config file"},"1776":{"id":"/js/wp-release/v0.20.0/changesets-2","page_id":"/js/wp-release/v0.20.0/changesets","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0/changesets#single-project-checks-in-github-actions","content":"Single-project checks in GitHub Actions"},"1777":{"id":"/js/wp-release/v0.20.0/changesets-3","page_id":"/js/wp-release/v0.20.0/changesets","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0/changesets#packages-and-tags","content":"Packages and tags"},"1778":{"id":"/js/wp-release/v0.20.0/changesets-4","page_id":"/js/wp-release/v0.20.0/changesets","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0/changesets#pre-releases","content":"Pre-releases"},"1779":{"id":"/js/wp-release/v0.20.0/changesets-5","page_id":"/js/wp-release/v0.20.0/changesets","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0/changesets#snapshots","content":"Snapshots"},"1780":{"id":"/js/wp-release/v0.20.0/changesets-6","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#changesets-support","content":"The changeset commands manage versioning, changelogs and release tags for single-package repositories and monorepos, including this repository. They read Changesets-style Markdown and load JavaScript configs with descriptors for npm and Composer manifests, plugin and theme headers, readme Stable tags, PHP constants, and Git tags. Use JavaScript configs with ESM (`export default`) or CommonJS (`module.exports`). Frontmatter uses `package-name: patch|minor|major` entries. For pre-releases, use the built-in pre-release workflow; the parser supports this simple frontmatter format rather than general YAML or the Changesets pre mode."},"1781":{"id":"/js/wp-release/v0.20.0/changesets-7","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#changesets-support","content":"PHP projects that don't use Node.js or JavaScript can run the same workflow with PHP Changesets, a Composer package that needs only PHP and Git. Its `changeset add`, `changeset status`, `changeset version` and `changeset tag` commands take the options of the `changeset-*` commands here, read the same changeset files and print the same release plans, with a PHP config file in place of `wp-release.config.*`. Use `wp-release` when the project already builds with Node.js, or to also build ZIPs, translations and WordPress.org deploys; see the comparison for the differences."},"1782":{"id":"/js/wp-release/v0.20.0/changesets-8","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#single-project-repositories-without-a-config-file","content":"The `changeset-*` commands can release one project at the repository root without a `wp-release.config.*` file. Run them from the root directory. With no version descriptor flags, they detect a root `package.json` or `composer.json` with a version, a plugin entry PHP file with a `Plugin Name` header, or a theme `style.css` with a `Theme Name` header. A detected plugin also updates the Stable tag in `readme.txt`, or `readme.md` when no Stable tag is found in `readme.txt`. Multiple version sources, multiple plugin entry files and npm workspaces require explicit descriptors or a config; files belonging to different projects aren't silently synchronized. A directory without a recognized version source still requires a config or explicit descriptors."},"1783":{"id":"/js/wp-release/v0.20.0/changesets-9","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#single-project-repositories-without-a-config-file","content":"For a root npm package, the complete workflow needs no project flags:"},"1784":{"id":"/js/wp-release/v0.20.0/changesets-10","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#single-project-repositories-without-a-config-file","content":"A single configured package is selected automatically for `changeset-add --bump` when `--since` isn't supplied, and for `changeset-tag --version`; `--since` still selects changed packages. npm and Composer projects use their root manifest's name as the changeset identifier when that manifest supplies the version; other projects use the root directory's basename. `--project-name <name>` pins the identifier of a repository without a manifest name, so local checkouts and CI don't need matching directory names; a config sets the same identifier with `id`. The fallback uses `.changeset/`, `CHANGELOG.md`, tags named `v{version}`, and the `origin` remote. There is no default comparison branch: pass `--since` or `--base-branch` when status checks should compare changes. Readme changelog updates are opt-in."},"1785":{"id":"/js/wp-release/v0.20.0/changesets-11","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#single-project-repositories-without-a-config-file","content":"Explicit descriptors replace automatic detection and define the entire version target list. For a plugin whose version appears in its header, readme and a PHP constant:"},"1786":{"id":"/js/wp-release/v0.20.0/changesets-12","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#single-project-repositories-without-a-config-file","content":"The same project flags belong on `changeset-add`, `changeset-status`, `changeset-version` and `changeset-tag`. Keep them consistent across all four commands, for example in command-specific npm scripts. An accompanying `package.json` used for build tools isn't changed unless it is included explicitly."},"1787":{"id":"/js/wp-release/v0.20.0/changesets-13","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#single-project-repositories-without-a-config-file","content":"| Flag                            | Version descriptor                     |\n| ------------------------------- | -------------------------------------- |\n| `--version-package-json <file>` | npm manifest version source and target |","table":"table-0"},"1788":{"id":"/js/wp-release/v0.20.0/changesets-14","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#single-project-repositories-without-a-config-file","content":"| Flag                             | Version descriptor                                                                                                       |\n| -------------------------------- | ------------------------------------------------------------------------------------------------------------------------ |\n| `--version-composer-json <file>` | Composer manifest version source and target; a target without a `version` field is skipped, while a source must have one |","table":"table-0"},"1789":{"id":"/js/wp-release/v0.20.0/changesets-15","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#single-project-repositories-without-a-config-file","content":"| Flag                                | Version descriptor                                |\n| ----------------------------------- | ------------------------------------------------- |\n| `--version-wordpress-plugin <file>` | WordPress plugin Version header source and target |","table":"table-0"},"1790":{"id":"/js/wp-release/v0.20.0/changesets-16","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#single-project-repositories-without-a-config-file","content":"| Flag                               | Version descriptor                               |\n| ---------------------------------- | ------------------------------------------------ |\n| `--version-wordpress-theme <file>` | WordPress theme Version header source and target |","table":"table-0"},"1791":{"id":"/js/wp-release/v0.20.0/changesets-17","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#single-project-repositories-without-a-config-file","content":"| Flag                                    | Version descriptor                                                                                        |\n| --------------------------------------- | --------------------------------------------------------------------------------------------------------- |\n| `--version-wordpress-stable-tag <file>` | WordPress readme Stable tag source and target; keeps its stable version during pre-releases and snapshots |","table":"table-0"},"1792":{"id":"/js/wp-release/v0.20.0/changesets-18","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#single-project-repositories-without-a-config-file","content":"| Flag                                       | Version descriptor                                  |\n| ------------------------------------------ | --------------------------------------------------- |\n| `--version-php-constant <file>#<constant>` | PHP `define()` or `const` version source and target |","table":"table-0"},"1793":{"id":"/js/wp-release/v0.20.0/changesets-19","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#single-project-repositories-without-a-config-file","content":"| Flag                          | Version descriptor                                                                                                      |\n| ----------------------------- | ----------------------------------------------------------------------------------------------------------------------- |\n| `--version-git-tag <pattern>` | Current version from existing stable Git tags, with a pattern such as `v{version}`; source-only, never a version target |","table":"table-0"},"1794":{"id":"/js/wp-release/v0.20.0/changesets-20","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#single-project-repositories-without-a-config-file","content":"File descriptor flags are repeatable. The source is inferred from a sole descriptor, or a unique descriptor other than a Stable tag. Otherwise use `--version-from <kind>`, where kind is `package-json`, `composer-json`, `wordpress-plugin`, `wordpress-theme`, `wordpress-stable-tag`, `php-constant` or `git-tag`. For repeated kinds, qualify the selector with the exact descriptor value: `--version-from package-json:package.json` or `--version-from 'php-constant:my-plugin.php#MY_PLUGIN_VERSION'`. Argument order doesn't select the source. A Git source requires a matching existing stable tag; its pattern selects the tags to read, while `--tag-format` controls tags to create. With multiple descriptors, explicitly select `git-tag` if it is the authoritative source."},"1795":{"id":"/js/wp-release/v0.20.0/changesets-21","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#single-project-repositories-without-a-config-file","content":"| Shared option           | Config equivalent                                                                                                       |\n| ----------------------- | ----------------------------------------------------------------------------------------------------------------------- |\n| `--project-name <name>` | `id`, the literal changeset identifier of the root package, instead of the manifest name or checkout directory basename |","table":"table-1"},"1796":{"id":"/js/wp-release/v0.20.0/changesets-22","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#single-project-repositories-without-a-config-file","content":"| Shared option            | Config equivalent                                                 |\n| ------------------------ | ----------------------------------------------------------------- |\n| `--base-branch <branch>` | `baseBranch`, used with the remote for the default comparison ref |","table":"table-1"},"1797":{"id":"/js/wp-release/v0.20.0/changesets-23","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#single-project-repositories-without-a-config-file","content":"| Shared option     | Config equivalent                                       |\n| ----------------- | ------------------------------------------------------- |\n| `--remote <name>` | `remote`, used for comparisons and pushing release tags |","table":"table-1"},"1798":{"id":"/js/wp-release/v0.20.0/changesets-24","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#single-project-repositories-without-a-config-file","content":"| Shared option            | Config equivalent                             |\n| ------------------------ | --------------------------------------------- |\n| `--changesets-dir <dir>` | `changesets`, relative to the repository root |","table":"table-1"},"1799":{"id":"/js/wp-release/v0.20.0/changesets-25","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#single-project-repositories-without-a-config-file","content":"| Shared option                                  | Config equivalent                                                |\n| ---------------------------------------------- | ---------------------------------------------------------------- |\n| `--readme-changelog` / `--no-readme-changelog` | `readmeChangelog`, independent of updating the readme Stable tag |","table":"table-1"},"1800":{"id":"/js/wp-release/v0.20.0/changesets-26","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#single-project-repositories-without-a-config-file","content":"| Shared option                       | Config equivalent                                                                                          |\n| ----------------------------------- | ---------------------------------------------------------------------------------------------------------- |\n| `--changelog-insert-after <marker>` | `changelogInsertAfter`; must exist in `CHANGELOG.md` and, with readme changelog updates, the plugin readme |","table":"table-1"},"1801":{"id":"/js/wp-release/v0.20.0/changesets-27","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#single-project-repositories-without-a-config-file","content":"| Shared option           | Config equivalent                               |\n| ----------------------- | ----------------------------------------------- |\n| `--tag-format <format>` | `tagFormat`, replacing the default `v{version}` |","table":"table-1"},"1802":{"id":"/js/wp-release/v0.20.0/changesets-28","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#single-project-repositories-without-a-config-file","content":"An explicit `--config` must load successfully. Otherwise a discovered config takes precedence over the single-project fallback. Single-project descriptor and settings flags cannot be mixed with a config file; put those settings in the config instead. The existing global `--tag-format` override works in both modes. Config files remain the place for package layouts, dependents, custom version and changelog callbacks, deployment destinations and distribution settings. Packaging and deployment commands retain their existing config requirements."},"1803":{"id":"/js/wp-release/v0.20.0/changesets-29","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#single-project-repositories-without-a-config-file","content":"Typical release flow, from a feature pull request to the publish workflows triggered by release tags:"},"1804":{"id":"/js/wp-release/v0.20.0/changesets-30","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#single-project-repositories-without-a-config-file","content":"An empty changeset marks a feature PR as no-release. The version workflow consumes it without changing versions, and a release PR containing only its deletion produces no tags."},"1805":{"id":"/js/wp-release/v0.20.0/changesets-31","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#single-project-repositories-without-a-config-file","content":"`version.from` selects the current version; `version.to` lists release targets. Use `phpConstantVersion( { file, constant } )` to sync a PHP constant."},"1806":{"id":"/js/wp-release/v0.20.0/changesets-32","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#single-project-checks-in-github-actions","content":"There are no dedicated build or changeset wrapper actions. Install the CLI in your project and run it directly. A root npm package can check a pull request with:"},"1807":{"id":"/js/wp-release/v0.20.0/changesets-33","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#single-project-checks-in-github-actions","content":"For a plugin with several version targets, put the same descriptor flags in npm scripts for all four changeset commands. Full Git history and tags are needed for comparisons, Git version sources and release notes. Keep the checkout directory name consistent when it supplies the changeset identifier. Directory artifacts use `npx --no-install wp-release build --output dist/my-plugin --github-output`; upload that directory with your artifact action. `build` writes manifest sidecars outside the directory and does not accept the ZIP-only embedding, codec or manifest-filename flags."},"1808":{"id":"/js/wp-release/v0.20.0/changesets-34","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#packages-and-tags","content":"The config describes the repository, so wp-release assumes no directory structure or naming convention of its own:"},"1809":{"id":"/js/wp-release/v0.20.0/changesets-35","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#packages-and-tags","content":"**Packages** are the directories that the `glob` of a `packages` entry matches under `root`, with `*`, `?` and `**`, like `plugins/*`, or `.` for a repository with one package at its root. The settings of an entry apply to each of its packages. Discovery never looks inside `.git`, `node_modules`, `vendor` or `dist` directories. A package is identified by its path, or with `idFrom` by the name in its `package.json` or `composer.json`, or with a literal `id` when the group matches exactly one package, and commands that take a package accept a path or identifier."},"1810":{"id":"/js/wp-release/v0.20.0/changesets-36","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#packages-and-tags","content":"**Templates** name the tags and the deploy targets of a package with these placeholders:"},"1811":{"id":"/js/wp-release/v0.20.0/changesets-37","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#packages-and-tags","content":"| Placeholder | Value                                                                 | `plugins/alpha` | Root package |\n| ----------- | --------------------------------------------------------------------- | --------------- | ------------ |\n| `{path}`    | Package directory relative to `root`, empty for a package at the root | `plugins/alpha` | (empty)      |","table":"table-2"},"1812":{"id":"/js/wp-release/v0.20.0/changesets-38","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#packages-and-tags","content":"| Placeholder | Value              | `plugins/alpha`                                     | Root package                             |\n| ----------- | ------------------ | --------------------------------------------------- | ---------------------------------------- |\n| `{name}`    | Package identifier | `plugins/alpha`, or its manifest name with `idFrom` | the manifest name, or the directory name |","table":"table-2"},"1813":{"id":"/js/wp-release/v0.20.0/changesets-39","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#packages-and-tags","content":"| Placeholder | Value            | `plugins/alpha` | Root package |\n| ----------- | ---------------- | --------------- | ------------ |\n| `{version}` | Released version | `1.2.0`         | `1.2.0`      |","table":"table-2"},"1814":{"id":"/js/wp-release/v0.20.0/changesets-40","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#packages-and-tags","content":"Deploy templates also have `{branch}`, `{ref}` and `{revision}` (see Deploy configured packages), and any template can be a callback that receives the package, for names that the placeholders don't cover, like the last directory of the path."},"1815":{"id":"/js/wp-release/v0.20.0/changesets-41","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#packages-and-tags","content":"**`tagFormat`** names the release tags, `{path}/{version}` by default, like `plugins/alpha/1.2.0`. Empty placeholders leave no leading or repeated slashes in a tag, so a package at the root gets plain version tags, like `1.2.0`, from the same default. Deploy templates, like repository URLs, are filled in as they are. A `gitTagVersion()` version source reads the tags with its own `pattern`, also `{path}/{version}` by default, so set both when you change the format."},"1816":{"id":"/js/wp-release/v0.20.0/changesets-42","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#packages-and-tags","content":"**`releaseTitle`** titles the release, like the `title` that `changeset-tag` reports for creating a GitHub Release. The default is `name@version`, like `plugins/alpha@1.2.0`, without the prefix for a package at the repository root, which is titled `1.2.0` like its tag. Like `tagFormat`, it supports `{name}`, `{path}`, `{version}` and `{tag}` placeholders: `releaseTitle: '{version} (beta)'`, or a callback that receives `{ package, version, tag }` like the release notes callback. A template without a placeholder fails at load time, since it would name every release alike. `changeset-tag --release-title <template>` replaces the `releaseTitle` of the config for one command, like `--tag-format` replaces `tagFormat`."},"1817":{"id":"/js/wp-release/v0.20.0/changesets-43","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#packages-and-tags","content":"**`--tag-format <format>`** replaces the `tagFormat` of the config for one command, for a workflow or job that names its tags differently, like `--tag-format '{name}@{version}'`. Every command that creates or reads the same tags needs the same format: `changeset-tag`, which creates them and finds the previous tag for the release notes, `changeset-version --prerelease`, which numbers pre-releases from them, and `deploy-git` and `deploy-svn --release-ref`, which read the package and version of a tag."},"1818":{"id":"/js/wp-release/v0.20.0/changesets-44","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#packages-and-tags","content":"**Slugs** are a WordPress concept: the folder of a plugin or theme. Only the commands that produce something for WordPress use one: the `{slug}/` root folder and name of a `zip`, the `checksums` manifest, the WordPress.org slug of `deploy-svn`, and `version-check`. Each takes `--slug`, which defaults to the name of the working directory, or of the package directory with `zip --package`, and an SVN deploy target takes `slug`, which defaults to the name of the package directory. Tags and Git deploy targets don't have a slug."},"1819":{"id":"/js/wp-release/v0.20.0/changesets-45","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#packages-and-tags","content":"**`remote`** is the git remote that `changeset-tag --push` pushes tags to and that the base branch is compared on, `origin` by default."},"1820":{"id":"/js/wp-release/v0.20.0/changesets-46","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#packages-and-tags","content":"The default strategy bumps stable `x.y.z` versions with SemVer rules, and the `x.y` and `x.y.z.w` versions common in WordPress plugins the same way: the bumped part is raised, the parts after it reset to `0`, and the version keeps its number of parts. A minor bump of `2.1` is `2.2` and a major bump is `3.0`, while a patch bump adds the third part, `2.1.1`. A patch bump of `1.2.3.4` is `1.2.4.0`, so raising only the fourth part needs a custom strategy. Configure `nextVersion( { package, bump, currentVersion, changesets } )` for other formats; changeset bumps remain `patch`, `minor` or `major`. Pre-releases are added to the next version with `--prerelease`, described below."},"1821":{"id":"/js/wp-release/v0.20.0/changesets-47","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#packages-and-tags","content":"Without `--since`, `changeset-status` compares against `<remote>/<baseBranch>`, where `remote` in the config defaults to `origin` and is also the remote that `changeset-tag --push` pushes tags to; fetch that ref or pass `--since` when using a fork or different upstream. `loadChangesetConfig()` discovers a conventional config at the repository root, unless `--config <path>` selects one explicitly."},"1822":{"id":"/js/wp-release/v0.20.0/changesets-48","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#packages-and-tags","content":"Add release notes in a feature PR with `npx wp-release changeset-add`. In a terminal, it lists the packages, marks the ones that changed since `<remote>/<baseBranch>` (or `--since <ref>`) without a changeset, and asks for the packages to release, a `patch`, `minor` or `major` bump for each, and the release note. Choose packages by number, identifier or path, or press Enter to release the changed ones; `none` adds an empty changeset. Changed files include uncommitted and untracked ones, since changesets are usually added before committing."},"1823":{"id":"/js/wp-release/v0.20.0/changesets-49","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#packages-and-tags","content":"Without a terminal, or for scripts, pass the changeset as options: `npx wp-release changeset-add --package @vendor/plugin --bump patch --summary \"Fix the checkout validation.\"`. Repeat package and bump flags for multiple packages, or use `--empty` when no release is needed. A package can also be named by its path under `root`, like `plugins/alpha`, and the changeset records its identifier; `changeset-version --package` and `changeset-tag --package` accept paths too. A single `--bump` without `--package` releases every changed package without a changeset, like `changeset-add --bump patch --summary \"…\"` to fix a failing `changeset-status` check. `--json` and `--github-output` never ask."},"1824":{"id":"/js/wp-release/v0.20.0/changesets-50","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#packages-and-tags","content":"In CI, `changeset-status --since origin/main` requires a changeset added by the PR; changesets already on the base do not count, while an empty PR changeset records an explicit no-release decision. Missing-change annotations identify an affected file."},"1825":{"id":"/js/wp-release/v0.20.0/changesets-51","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#packages-and-tags","content":"On the release branch, preview with `changeset-version --dry-run`, then run `changeset-version` to update version targets and changelogs. By default, new Markdown entries go before the first version heading; `changelogInsertAfter` sets a literal insertion marker for `CHANGELOG.md` and, with `readmeChangelog`, the plugin readme. Put the marker in both files; a missing marker is an error. Without a marker, plugin readmes use the `== Changelog ==` heading. Failed updates are rolled back for safe retries."},"1826":{"id":"/js/wp-release/v0.20.0/changesets-52","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#packages-and-tags","content":"Configure `changelogEntry( { package, changeset, commit } )` to format the changelog entry of each changeset, where `commit` is the `{ hash, shortHash, subject }` of the commit that added the changeset file, if it's committed. The formatted entries go into `CHANGELOG.md`, the `changelog` of each release in the `changeset-version` result, and so the release notes; plugin readmes keep the plain summaries. Without the callback, entries are the plain summaries. For example, to link each entry to its commit:"},"1827":{"id":"/js/wp-release/v0.20.0/changesets-53","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#packages-and-tags","content":"Configure `dependents` to re-release packages that bundle a package when it releases. The dependents come from what the packages declare: a package is a dependent of a source when the spec that it declares in its npm `dependencies` or `optionalDependencies` (or the sections that the policy adds) resolves the current version of the source or points at the workspace, and it re-releases when the next version of the source falls outside the declared range, or always with `when: 'always'`. A pin to an older version selects a registry release instead and `changeset-status` warns about the drift until the pin resolves the package again. Versioning a dependent rewrites its declared specs of the source to the released version, keeping their range prefixes, so an exact pin matches the released workspace again and the built bundle matches the changelog. Wildcards and unpinned ranges accept the release without one, like the `devDependencies` of a package. The derived dependents appear in `changeset-status`, `changeset-version` and `changeset-tag` like any other release, and a dependent that releases for its own reasons keeps its own bump and appends the bundle note:"},"1828":{"id":"/js/wp-release/v0.20.0/changesets-54","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#packages-and-tags","content":"Excluded packages still release with their own changesets and stay out of the automatic re-releases."},"1829":{"id":"/js/wp-release/v0.20.0/changesets-55","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#packages-and-tags","content":"When the changesets of a pull request release a source, `changeset-status` requires no changeset for a dependent whose only change is the spec of that source in its `package.json`, since versioning rewrites the spec and the bundle note announces it. Any other change to the dependent, like another manifest field or dependency, documentation or code, needs its own changeset."},"1830":{"id":"/js/wp-release/v0.20.0/changesets-56","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#packages-and-tags","content":"The bundle changelog entry defaults to `Bundle <source> <version>.` and is formatted with `dependents.changelog( { package, source } )`:"},"1831":{"id":"/js/wp-release/v0.20.0/changesets-57","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#packages-and-tags","content":"`dependents.sections` lists the npm dependency sections that declare a source, defaulting to `dependencies` and `optionalDependencies`; add `devDependencies` for dependencies that end up in the dependent's build, or `peerDependencies` to scan them."},"1832":{"id":"/js/wp-release/v0.20.0/changesets-58","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#packages-and-tags","content":"The `dependents.dependency` hooks extend the built-in npm scan instead of replacing it, so that both work behind the same range rule and rewrite:"},"1833":{"id":"/js/wp-release/v0.20.0/changesets-59","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#packages-and-tags","content":"After versioning, run `npm install --package-lock-only` so that the root lockfile resolves the rewritten pins to the workspace links again; the `Prepare Release` workflow (`prepare-release.yml` in this monorepo) does it with its release pull request."},"1834":{"id":"/js/wp-release/v0.20.0/changesets-60","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#packages-and-tags","content":"To release packages separately, for example with a release pull request for each, pass `--package <name>`, repeatable, to version only those packages. A changeset that also names other packages keeps only their entries and its summary, so it still applies to their releases with the same bump. Changesets without packages are left for a run without `--package`."},"1835":{"id":"/js/wp-release/v0.20.0/changesets-61","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#packages-and-tags","content":"The `changeset-version` result lists each release with its `package`, `bump`, `currentVersion`, `nextVersion` and `changelog` entries, a Markdown list like the one added to `CHANGELOG.md`. Use it to name and describe the release pull request in a repository script, or call `versionChangesets()` from the library and format the entries of each release with `formatChangelogEntries( release.changesets )`."},"1836":{"id":"/js/wp-release/v0.20.0/changesets-62","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#packages-and-tags","content":"After merging the release PR, `changeset-tag --since <merge-commit>^1 --push` pushes tags only for packages changed by that release. It pushes one tag at a time because GitHub doesn't trigger workflows for a push of more than three tags. wp-release doesn't create GitHub Releases: with `--json` or `--github-output`, each entry of `tags` has the `tag`, a `title` like `plugins/alpha@1.2.0` or, for a package at the repository root, the release title like `1.2.0` (see releaseTitle, and `--release-title` for overriding it in one command), the release `notes` and a `prerelease` flag, for a workflow step like `softprops/action-gh-release` to create the release (see the example below). For initial adoption, preview all missing tags with `changeset-tag --dry-run` (without `--since`), then push if needed. To release each package with a separate workflow instead, `changeset-tag --since <merge-commit>^1 --untagged --github-output` lists the releases that don't have a tag yet, without creating any. Tag pushes need Git write credentials."},"1837":{"id":"/js/wp-release/v0.20.0/changesets-63","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#packages-and-tags","content":"To release a single package, for example from a manual workflow, pass `--package <name>`, repeatable, and with one package `--version <version>` to fail unless the package is at that version. Packages versioned by git tags have no version file, so for them `--version` is the version to tag. Before a tag is created, every `version.to` target must match the version, so a plugin `Version` header that disagrees with its readme `Stable tag` blocks the tag. Versions with a pre-release part, like `1.0.0-rc.1`, have `prerelease` set, so their GitHub Releases can be marked as pre-releases. This example selects one package, so `tags[0]` is its release; these fields are nested in the JSON result:"},"1838":{"id":"/js/wp-release/v0.20.0/changesets-64","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#packages-and-tags","content":"The release notes are the version's `CHANGELOG.md` section, or without one the commits that changed the package since its previous tag, the highest version below the released one, skipping pre-releases for a stable version. Configure `releaseNotes( { package, version, tag, previousTag, changelog, commits, notes } )` to format them, for example to add links; `notes` is the default text and `commits` lists `{ hash, shortHash, subject }`, newest first. `changeset-tag --package <name> --dry-run` prints them without creating the tag."},"1839":{"id":"/js/wp-release/v0.20.0/changesets-65","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#packages-and-tags","content":"For local development, run the TypeScript source with `npm run wp-release -- <command>` (for example, `npm run wp-release -- changeset-status --since origin/main`). GitHub workflows use the same CLI for versioning and tagging. `SUBTREE_DEPLOY_TOKEN` lets them update the release PR and push tags, and the `Tag Release` workflow passes it to `softprops/action-gh-release` to create the GitHub Releases."},"1840":{"id":"/js/wp-release/v0.20.0/changesets-66","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#pre-releases","content":"`changeset-version --prerelease <id>` (the `prerelease` option of `versionChangesets()`) releases pre-releases of the next versions, like `1.3.0-rc.1` for a minor bump of `1.2.0`. The identifier, like `alpha`, `beta` or `rc`, can have a number, like `rc.2`, which is used as is and fails when the version is already tagged. Without a number, the number is one above the highest existing tag of that identifier and next stable version, read with the `tagFormat` of the package, so the first one is `rc.1`, and the numbering starts again at `.1` when later changesets raise the next version. The dependents of a source become pre-releases too, so that they bundle its pre-release, unless they're left out with `--no-dependents`."},"1841":{"id":"/js/wp-release/v0.20.0/changesets-67","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#pre-releases","content":"A pre-release writes every version target except the readme `Stable tag`, which keeps the last stable version since WordPress.org offers it to every site, and `changeset-tag` skips the `Stable tag` when it verifies a pre-release. The changelog gets a section for the pre-release, like `## 1.3.0-rc.1 (2026-10-12)`, so that `changeset-tag` finds its release notes, and the changesets are consumed like in any release."},"1842":{"id":"/js/wp-release/v0.20.0/changesets-68","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#pre-releases","content":"Since a pre-release consumes the changesets that the stable release needs, run it on a branch that isn't merged, and tag that branch commit:"},"1843":{"id":"/js/wp-release/v0.20.0/changesets-69","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#pre-releases","content":"The base branch keeps its stable versions and pending changesets, so the stable release later versions them as usual, in one changelog section. The tag keeps the pre-release commit reachable after the branch is reset or deleted. The release notes of a stable release compare with the previous stable release, skipping the pre-releases before it, and the `git-tag` version source ignores pre-release tags, so packages versioned by git tags keep building on their last stable version."},"1844":{"id":"/js/wp-release/v0.20.0/changesets-70","page_id":"/js/wp-release/v0.20.0/changesets","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/changesets#snapshots","content":"`changeset-version --snapshot <id>` (the `snapshot` option of `versionChangesets()`) releases snapshots of the next versions for test builds, like `1.3.0-pr-251.20261012183005` for a pull request: the next version with the identifier, like `pr-251` or `pr-251.0abc123` with a commit hash, and the UTC time, so that every snapshot is unique and they sort by time. Snapshots aren't numbered from tags and can't be combined with `--prerelease`. Like a pre-release, a snapshot writes every version target except the readme `Stable tag`. Build and publish the versioned files without committing them, for example under an npm dist-tag like `pr-251`, since a snapshot consumes the changesets:"},"1845":{"id":"/js/wp-release/v0.20.0/cli","page_id":"/js/wp-release/v0.20.0/cli","type":"page","content":"CLI","breadcrumbs":["Docs","Js","Wp release","v0.20.0"],"tags":[],"url":"/js/wp-release/v0.20.0/cli"},"1846":{"id":"/js/wp-release/v0.20.0/cli-0","page_id":"/js/wp-release/v0.20.0/cli","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0/cli#cli","content":"CLI"},"1847":{"id":"/js/wp-release/v0.20.0/cli-1","page_id":"/js/wp-release/v0.20.0/cli","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0/cli#github-actions-annotations-and-job-summaries","content":"GitHub Actions annotations and job summaries"},"1848":{"id":"/js/wp-release/v0.20.0/cli-2","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#cli","content":"| Command                                                    | Description                                   |\n| ---------------------------------------------------------- | --------------------------------------------- |\n| `wp-release build [<source-dir>] --output <dir> [options]` | Copy selected release files into a directory. |","table":"table-0"},"1849":{"id":"/js/wp-release/v0.20.0/cli-3","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#cli","content":"| Command                                   | Description                                                                  |\n| ----------------------------------------- | ---------------------------------------------------------------------------- |\n| `wp-release zip [<source-dir>] [options]` | Create a ZIP archive with a `{slug}/` root folder, respecting `.distignore`. |","table":"table-0"},"1850":{"id":"/js/wp-release/v0.20.0/cli-4","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#cli","content":"| Command                                         | Description                                                                         |\n| ----------------------------------------------- | ----------------------------------------------------------------------------------- |\n| `wp-release checksums [<source-dir>] [options]` | Write the MD5 and SHA-256 hashes of every distributed file to a checksums manifest. |","table":"table-0"},"1851":{"id":"/js/wp-release/v0.20.0/cli-5","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#cli","content":"| Command                               | Description                                                                                                            |\n| ------------------------------------- | ---------------------------------------------------------------------------------------------------------------------- |\n| `wp-release sign <file>... [options]` | Sign files with Ed25519, writing a detached `<file>.sig` next to each, or minisign and SSH signatures with `--format`. |","table":"table-0"},"1852":{"id":"/js/wp-release/v0.20.0/cli-6","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#cli","content":"| Command             | Description                                                                                      |\n| ------------------- | ------------------------------------------------------------------------------------------------ |\n| `wp-release keygen` | Generate a base64 Ed25519 private seed and its public key, also as minisign and SSH public keys. |","table":"table-0"},"1853":{"id":"/js/wp-release/v0.20.0/cli-7","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#cli","content":"| Command                                                         | Description                                                                |\n| --------------------------------------------------------------- | -------------------------------------------------------------------------- |\n| `wp-release verify [<source-dir>] --checksums <file> [options]` | Check a plugin or theme directory, or a ZIP, against a checksums manifest. |","table":"table-0"},"1854":{"id":"/js/wp-release/v0.20.0/cli-8","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#cli","content":"| Command                                             | Description                                                                            |\n| --------------------------------------------------- | -------------------------------------------------------------------------------------- |\n| `wp-release version-check [<source-dir>] [options]` | Check that the `Version` header, readme `Stable tag`, PHP constants and git tag agree. |","table":"table-0"},"1855":{"id":"/js/wp-release/v0.20.0/cli-9","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#cli","content":"| Command                                          | Description                                                 |\n| ------------------------------------------------ | ----------------------------------------------------------- |\n| `wp-release deploy-svn [<source-dir>] [options]` | Deploy a plugin to the WordPress.org plugin SVN repository. |","table":"table-0"},"1856":{"id":"/js/wp-release/v0.20.0/cli-10","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#cli","content":"| Command                                                          | Description                                                                             |\n| ---------------------------------------------------------------- | --------------------------------------------------------------------------------------- |\n| `wp-release deploy-git [<source-dir>] --git-url <url> [options]` | Deploy the files of a plugin, theme or package to a Git repository as a release commit. |","table":"table-0"},"1857":{"id":"/js/wp-release/v0.20.0/cli-11","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#cli","content":"| Command                                                                 | Description                                                                     |\n| ----------------------------------------------------------------------- | ------------------------------------------------------------------------------- |\n| `wp-release deploy-git --release-ref <ref> [--package <name>] [--list]` | Deploy the configured packages of a release tag or branch to their Git targets. |","table":"table-0"},"1858":{"id":"/js/wp-release/v0.20.0/cli-12","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#cli","content":"| Command                                                                 | Description                                                     |\n| ----------------------------------------------------------------------- | --------------------------------------------------------------- |\n| `wp-release deploy-svn --release-ref <ref> [--package <name>] [--list]` | Deploy the configured plugin of a release tag to WordPress.org. |","table":"table-0"},"1859":{"id":"/js/wp-release/v0.20.0/cli-13","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#cli","content":"| Command                                        | Description                                                |\n| ---------------------------------------------- | ---------------------------------------------------------- |\n| `wp-release i18n-pot [<source-dir>] [options]` | Extract translatable strings into a reproducible POT file. |","table":"table-0"},"1860":{"id":"/js/wp-release/v0.20.0/cli-14","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#cli","content":"| Command                                          | Description                                               |\n| ------------------------------------------------ | --------------------------------------------------------- |\n| `wp-release i18n-audit [<source-dir>] [options]` | Report translation string problems without writing files. |","table":"table-0"},"1861":{"id":"/js/wp-release/v0.20.0/cli-15","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#cli","content":"| Command                                  | Description                           |\n| ---------------------------------------- | ------------------------------------- |\n| `wp-release i18n-mo <file.po> [options]` | Compile a translated PO file into MO. |","table":"table-0"},"1862":{"id":"/js/wp-release/v0.20.0/cli-16","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#cli","content":"| Command                                                      | Description                                                                              |\n| ------------------------------------------------------------ | ---------------------------------------------------------------------------------------- |\n| `wp-release i18n-json <file.po> --domain <domain> [options]` | Compile the JavaScript strings of a translated PO file into WordPress script JSON files. |","table":"table-0"},"1863":{"id":"/js/wp-release/v0.20.0/cli-17","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#cli","content":"| Command                                   | Description                                                     |\n| ----------------------------------------- | --------------------------------------------------------------- |\n| `wp-release i18n-php <file.po> [options]` | Compile a translated PO file into a WordPress `.l10n.php` file. |","table":"table-0"},"1864":{"id":"/js/wp-release/v0.20.0/cli-18","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#cli","content":"| Command                              | Description                                  |\n| ------------------------------------ | -------------------------------------------- |\n| `wp-release changeset-add [options]` | Record the release impact of a pull request. |","table":"table-0"},"1865":{"id":"/js/wp-release/v0.20.0/cli-19","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#cli","content":"| Command                                 | Description                                                      |\n| --------------------------------------- | ---------------------------------------------------------------- |\n| `wp-release changeset-status [options]` | List pending releases and check changed packages for changesets. |","table":"table-0"},"1866":{"id":"/js/wp-release/v0.20.0/cli-20","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#cli","content":"| Command                                  | Description                                |\n| ---------------------------------------- | ------------------------------------------ |\n| `wp-release changeset-version [options]` | Apply version bumps and changelog entries. |","table":"table-0"},"1867":{"id":"/js/wp-release/v0.20.0/cli-21","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#cli","content":"| Command                              | Description                          |\n| ------------------------------------ | ------------------------------------ |\n| `wp-release changeset-tag [options]` | Create missing package release tags. |","table":"table-0"},"1868":{"id":"/js/wp-release/v0.20.0/cli-22","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#cli","content":"Run `npx wp-release <command> --help` for the options of each command. Directory-based commands accept a first `<source-dir>` argument or `--source-dir`, defaulting to the current directory. `sign` and the `i18n-mo`, `i18n-json` and `i18n-php` compilers take file arguments, `keygen` generates keys, and changeset commands operate on the configured repository. Every command prints its result as JSON with `--json`. Commands that take no positional arguments, like the changeset commands, reject bare arguments with the usage instead of ignoring them."},"1869":{"id":"/js/wp-release/v0.20.0/cli-23","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#cli","content":"In GitHub Actions, `--github-output` writes the complete result as JSON to `steps.<id>.outputs.result` and exposes each top-level string, number or boolean as a plain output. Use `steps.zip.outputs.zipPath` for a ZIP path, for example. Arrays and objects remain in `result`: tag metadata is read with `fromJSON( steps.tag.outputs.result ).tags[0].tag`, even when only one package is selected. There is no plain `steps.tag.outputs.tag` output."},"1870":{"id":"/js/wp-release/v0.20.0/cli-24","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#cli","content":"Prefer plain outputs in steps that run conditionally, since a skipped step has empty outputs. When reading JSON from a step that may be skipped, use a fallback such as `fromJSON( steps.tag.outputs.result || '{\"tags\":[]}' ).tags[0].tag`. For several tags or deploys, read the arrays in `result` to build a job matrix or process each item."},"1871":{"id":"/js/wp-release/v0.20.0/cli-25","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#github-actions-annotations-and-job-summaries","content":"With the `github` log format, the CLI uses current GitHub Actions features to report problems where you look for them, instead of only in the log. `--log-format <name>` picks how the CLI logs, separately from the result that `--json` prints:"},"1872":{"id":"/js/wp-release/v0.20.0/cli-26","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#github-actions-annotations-and-job-summaries","content":"| Log format | Output                                          |\n| ---------- | ----------------------------------------------- |\n| `text`     | Plain text. The default outside GitHub Actions. |","table":"table-1"},"1873":{"id":"/js/wp-release/v0.20.0/cli-27","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#github-actions-annotations-and-job-summaries","content":"| Log format | Output                                                                                                              |\n| ---------- | ------------------------------------------------------------------------------------------------------------------- |\n| `github`   | GitHub Actions annotations and job summaries. The default when `GITHUB_ACTIONS=true`. `--ci` is a shorthand for it. |","table":"table-1"},"1874":{"id":"/js/wp-release/v0.20.0/cli-28","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#github-actions-annotations-and-job-summaries","content":"Pass `--log-format text` for plain text in GitHub Actions. The GitHub Actions always use the `github` log format. Only the CLI checks `GITHUB_ACTIONS`: the library classes don't read the environment, and choose the format by the writer they get."},"1875":{"id":"/js/wp-release/v0.20.0/cli-29","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#github-actions-annotations-and-job-summaries","content":"Errors, warnings and notices are printed as workflow commands, so they show up as annotations on the run and on the files of a pull request:"},"1876":{"id":"/js/wp-release/v0.20.0/cli-30","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#github-actions-annotations-and-job-summaries","content":"`version-check` and `deploy-svn` annotate each version mismatch on the file and line of the version: the `Version` header, the readme `Stable tag` or the PHP constant."},"1877":{"id":"/js/wp-release/v0.20.0/cli-31","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#github-actions-annotations-and-job-summaries","content":"`verify` annotates each changed file and each file that isn't in the checksums."},"1878":{"id":"/js/wp-release/v0.20.0/cli-32","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#github-actions-annotations-and-job-summaries","content":"Each command also adds a section to the job summary of the run, when `GITHUB_STEP_SUMMARY` is set:"},"1879":{"id":"/js/wp-release/v0.20.0/cli-33","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#github-actions-annotations-and-job-summaries","content":"| Command      | Summary                                                                                                                                                                                            |\n| ------------ | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `deploy-svn` | Plugin, linked to its WordPress.org page, version, written SVN paths, the commit linked to its WordPress.org changeset (or the dry run or no-op result), and the SVN changes in a collapsed table. |","table":"table-2"},"1880":{"id":"/js/wp-release/v0.20.0/cli-34","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#github-actions-annotations-and-job-summaries","content":"| Command      | Summary                                                   |\n| ------------ | --------------------------------------------------------- |\n| `deploy-git` | Repository, release commit and the pushed branch and tag. |","table":"table-2"},"1881":{"id":"/js/wp-release/v0.20.0/cli-35","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#github-actions-annotations-and-job-summaries","content":"| Command | Summary                                                                                               |\n| ------- | ----------------------------------------------------------------------------------------------------- |\n| `build` | Output directory, number of copied files and optional manifest; requested signatures and public keys. |","table":"table-2"},"1882":{"id":"/js/wp-release/v0.20.0/cli-36","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#github-actions-annotations-and-job-summaries","content":"| Command | Summary                                                                                                                |\n| ------- | ---------------------------------------------------------------------------------------------------------------------- |\n| `zip`   | ZIP, number of files and checksums manifest; with `--sign`, signature files and the public key of each written format. |","table":"table-2"},"1883":{"id":"/js/wp-release/v0.20.0/cli-37","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#github-actions-annotations-and-job-summaries","content":"| Command     | Summary                       |\n| ----------- | ----------------------------- |\n| `checksums` | Manifest and number of files. |","table":"table-2"},"1884":{"id":"/js/wp-release/v0.20.0/cli-38","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#github-actions-annotations-and-job-summaries","content":"| Command | Summary                                                    |\n| ------- | ---------------------------------------------------------- |\n| `sign`  | Signature files and the public key of each written format. |","table":"table-2"},"1885":{"id":"/js/wp-release/v0.20.0/cli-39","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#github-actions-annotations-and-job-summaries","content":"| Command  | Summary                                                                                  |\n| -------- | ---------------------------------------------------------------------------------------- |\n| `verify` | That all files match, or the counts and a table of the changed, missing and extra files. |","table":"table-2"},"1886":{"id":"/js/wp-release/v0.20.0/cli-40","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#github-actions-annotations-and-job-summaries","content":"| Command         | Summary                                                                        |\n| --------------- | ------------------------------------------------------------------------------ |\n| `version-check` | The matching version, or a table of the mismatches with their files and lines. |","table":"table-2"},"1887":{"id":"/js/wp-release/v0.20.0/cli-41","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#github-actions-annotations-and-job-summaries","content":"| Command            | Summary                                               |\n| ------------------ | ----------------------------------------------------- |\n| `changeset-status` | Each changed package with whether it has a changeset. |","table":"table-2"},"1888":{"id":"/js/wp-release/v0.20.0/cli-42","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#github-actions-annotations-and-job-summaries","content":"| Command             | Summary                                                               |\n| ------------------- | --------------------------------------------------------------------- |\n| `changeset-version` | A table of the package releases with their version changes and bumps. |","table":"table-2"},"1889":{"id":"/js/wp-release/v0.20.0/cli-43","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#github-actions-annotations-and-job-summaries","content":"| Command         | Summary                                                                                  |\n| --------------- | ---------------------------------------------------------------------------------------- |\n| `changeset-tag` | Each tag with its previous tag and status, and its release notes in a collapsed section. |","table":"table-2"},"1890":{"id":"/js/wp-release/v0.20.0/cli-44","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#github-actions-annotations-and-job-summaries","content":"A failed command adds its error to the summary, or a table of its problems with their files and lines, listing up to 100 and counting the rest. The Markdown of the summaries isn't part of the library API. File paths are relative to `GITHUB_WORKSPACE`, or the current directory without it. Files outside it, like those of an extracted ZIP, get an annotation without a file. Multi-line messages stay one annotation."},"1891":{"id":"/js/wp-release/v0.20.0/cli-45","page_id":"/js/wp-release/v0.20.0/cli","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/cli#github-actions-annotations-and-job-summaries","content":"Use global `--config <path>` to select a config; relative paths resolve from the current directory. Otherwise, commands using the config discover `wp-release.config.js`, `.mjs` or `.cjs` at the repository root. Global `--tag-format <format>` replaces the `tagFormat` of the config for one command, see Packages and tags."},"1892":{"id":"/js/wp-release/v0.20.0/comparison","page_id":"/js/wp-release/v0.20.0/comparison","type":"page","content":"Comparison with other tools","breadcrumbs":["Docs","Js","Wp release","v0.20.0"],"tags":[],"url":"/js/wp-release/v0.20.0/comparison"},"1893":{"id":"/js/wp-release/v0.20.0/comparison-0","page_id":"/js/wp-release/v0.20.0/comparison","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0/comparison#comparison-with-existing-tools","content":"Comparison with existing tools"},"1894":{"id":"/js/wp-release/v0.20.0/comparison-1","page_id":"/js/wp-release/v0.20.0/comparison","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/comparison#comparison-with-existing-tools","content":"| Tool                                                             | What it does                                                                                                                                                                                                                                                                                                                | How `wp-release` differs                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |\n| ---------------------------------------------------------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| 10up WordPress.org plugin deploy and readme/asset update actions | Two separate GitHub Actions configured through env vars. A deploy always syncs the build to `trunk/` and copies it to the tag; readme and asset updates need the second action. Assets come from `.wordpress-org` by default, and files are selected with `.distignore` or `.gitattributes`. Files are synced with `rsync`. | One `deploy-svn` command with independent write flags, so a release, a readme-only update and an assets-only update are the same command with different flags. Runs locally and in any CI, not only GitHub Actions, and syncs in Node.js without `rsync`. Checks that the `Version` header, readme `Stable tag` and SVN tag agree before writing, which the 10up actions don't. Assets are deployed only when `--assets-dir` is passed, instead of always syncing `.wordpress-org` when it exists, so a plugin's own `assets/` folder is never uploaded by accident. Adds `--exclude` for patterns without an ignore file, opt-in Git `export-ignore` support and `--from-zip` to deploy the exact files of a ZIP. |","table":"table-0"},"1895":{"id":"/js/wp-release/v0.20.0/comparison-2","page_id":"/js/wp-release/v0.20.0/comparison","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/comparison#comparison-with-existing-tools","content":"| Tool              | What it does                                                                                                     | How `wp-release` differs                                                                                                                                                                  |\n| ----------------- | ---------------------------------------------------------------------------------------------------------------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `grunt-wp-deploy` | Grunt task with `deploy_trunk` and `deploy_tag` booleans, interactive password prompts and a `Stable tag` check. | No Grunt dependency and never interactive. `--readme-only` is a separate flag, where `grunt-wp-deploy` can only update trunk with the full build. Assets are independent of trunk writes. |","table":"table-0"},"1896":{"id":"/js/wp-release/v0.20.0/comparison-3","page_id":"/js/wp-release/v0.20.0/comparison","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/comparison#comparison-with-existing-tools","content":"| Tool                  | What it does                                                                     | How `wp-release` differs                                                                                                           |\n| --------------------- | -------------------------------------------------------------------------------- | ---------------------------------------------------------------------------------------------------------------------------------- |\n| codeinwp theme deploy | Fork of the 10up plugin action that commits themes to the themes SVN repository. | Doesn't deploy themes. Theme releases are ZIP uploads on WordPress.org; `zip` builds the upload with the theme folder as the root. |","table":"table-0"},"1897":{"id":"/js/wp-release/v0.20.0/comparison-4","page_id":"/js/wp-release/v0.20.0/comparison","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/comparison#comparison-with-existing-tools","content":"| Tool              | What it does                                                                                             | How `wp-release` differs                                                                                                                                                                                                                                                                                                                                                                      |\n| ----------------- | -------------------------------------------------------------------------------------------------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `wp dist-archive` | WP-CLI command that zips a project using `.distignore`, with `--plugin-dirname` and `--filename-format`. | Same `.distignore` file and `{name}.{version}` style filename format, but needs only Node.js instead of PHP and WP-CLI. `.distignore` is matched with full gitignore syntax, including `!` negation, and `--distignore` / `--exclude` let you point at another ignore file or add patterns on the command line. Builds are reproducible, and `--checksums` writes a manifest next to the ZIP. |","table":"table-0"},"1898":{"id":"/js/wp-release/v0.20.0/comparison-5","page_id":"/js/wp-release/v0.20.0/comparison","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/comparison#comparison-with-existing-tools","content":"| Tool               | What it does                                                                                                                                                                                                        | How `wp-release` differs                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |\n| ------------------ | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `wp i18n make-pot` | WP-CLI command that extracts PHP, JavaScript, `block.json` and `theme.json` strings into a POT, with `--domain`, `--include`/`--exclude`, `--headers`, `--file-comment`, `--merge`/`--subtract` and audit warnings. | `i18n-pot` and `i18n-audit` need only Node.js, write byte-for-byte reproducible POTs without dates, and `--check` fails CI on a stale POT. Headers are set one at a time with a repeatable `--header NAME=VALUE` instead of a JSON object, and `--include`/`--exclude` take one glob each, so patterns never need escaping or comma splitting. `--add-location`, `--no-location` and `--all-domains` say what they do, and `--add-location file` drops line numbers so that unrelated edits don't make the POT stale. Monorepos keep these settings once in `wp-release.config.js` and select packages with `--package` or `--all` instead of running the command for every directory. The audit is a separate read-only command with stable finding codes for `--suppress`, instead of warnings mixed into generation. There's no `--merge`, `--subtract` or `--skip-*`; `--include` and `--exclude` cover the same needs. |","table":"table-0"},"1899":{"id":"/js/wp-release/v0.20.0/comparison-6","page_id":"/js/wp-release/v0.20.0/comparison","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/comparison#comparison-with-existing-tools","content":"| Tool                                          | What it does                                                                                                                                                                                          | How `wp-release` differs                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |\n| --------------------------------------------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `wp i18n make-mo`, `make-json` and `make-php` | WP-CLI commands that compile PO files into MO, script JSON and `.l10n.php` files. `make-json` maps sources with `--use-map` and removes JavaScript strings from the PO unless `--no-purge` is passed. | `i18n-mo`, `i18n-json` and `i18n-php` compile one translated PO at a time, never change it, and leave out fuzzy, obsolete and untranslated entries. `i18n-json` takes a many-to-many `--map` from source files to built scripts, and JSX and TypeScript sources need one, so catalogs are never written for files WordPress doesn't load. `--check` compares the outputs without writing. There's no `update-po`, so update PO files from the POT with gettext's `msgmerge` or a translation platform. |","table":"table-0"},"1900":{"id":"/js/wp-release/v0.20.0/comparison-7","page_id":"/js/wp-release/v0.20.0/comparison","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/comparison#comparison-with-existing-tools","content":"| Tool                         | What it does                                                                          | How `wp-release` differs                                                                                                                                                                                                                        |\n| ---------------------------- | ------------------------------------------------------------------------------------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `wp plugin verify-checksums` | WP-CLI command that checks installed plugins against the WordPress.org checksums API. | Reads the same manifest format, but from a file, so it also works for plugins and themes that aren't hosted on WordPress.org and for build directories in CI. `checksums` writes the manifest that WordPress.org generates for its own plugins. |","table":"table-0"},"1901":{"id":"/js/wp-release/v0.20.0/comparison-8","page_id":"/js/wp-release/v0.20.0/comparison","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/comparison#comparison-with-existing-tools","content":"| Tool                    | What it does                                                                                                                         | How `wp-release` differs                                                                                                                                                                                                                              |\n| ----------------------- | ------------------------------------------------------------------------------------------------------------------------------------ | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `wp-scripts plugin-zip` | Zips files from `package.json` `files` or a fixed allowlist, named after the npm package, with `--root-folder` / `--no-root-folder`. | Reuses the root folder flags, selects files with `.distignore` by default and can optionally honor Git `export-ignore` attributes, puts the version from the plugin headers in the filename and streams the archive instead of building it in memory. |","table":"table-0"},"1902":{"id":"/js/wp-release/v0.20.0/configuration","page_id":"/js/wp-release/v0.20.0/configuration","type":"page","content":"Configuration","breadcrumbs":["Docs","Js","Wp release","v0.20.0"],"tags":[],"url":"/js/wp-release/v0.20.0/configuration"},"1903":{"id":"/js/wp-release/v0.20.0/configuration-0","page_id":"/js/wp-release/v0.20.0/configuration","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0/configuration#naming-convention","content":"Naming convention"},"1904":{"id":"/js/wp-release/v0.20.0/configuration-1","page_id":"/js/wp-release/v0.20.0/configuration","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0/configuration#file-selection","content":"File selection"},"1905":{"id":"/js/wp-release/v0.20.0/configuration-2","page_id":"/js/wp-release/v0.20.0/configuration","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0/configuration#plugin-and-theme-headers","content":"Plugin and theme headers"},"1906":{"id":"/js/wp-release/v0.20.0/configuration-3","page_id":"/js/wp-release/v0.20.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/configuration#naming-convention","content":"`@wpelevator/wp-release` is the suite of release tools and `wp-release` is its CLI. \"Release\" is the whole workflow; each command is one operation in it. Commands are flat: a single word or dashed words like `version-check` and `deploy-svn`, without command groups or aliases. Each GitHub Action is named `wp-release-` followed by the command name, so the CLI command and the `uses:` name always match:"},"1907":{"id":"/js/wp-release/v0.20.0/configuration-4","page_id":"/js/wp-release/v0.20.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/configuration#naming-convention","content":"| Capability        | CLI command        | GitHub Action |\n| ----------------- | ------------------ | ------------- |\n| Build a directory | `wp-release build` |               |","table":"table-0"},"1908":{"id":"/js/wp-release/v0.20.0/configuration-5","page_id":"/js/wp-release/v0.20.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/configuration#naming-convention","content":"| Capability  | CLI command      | GitHub Action               |\n| ----------- | ---------------- | --------------------------- |\n| Build a ZIP | `wp-release zip` | `wpelevator/wp-release-zip` |","table":"table-0"},"1909":{"id":"/js/wp-release/v0.20.0/configuration-6","page_id":"/js/wp-release/v0.20.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/configuration#naming-convention","content":"| Capability                  | CLI command            | GitHub Action                     |\n| --------------------------- | ---------------------- | --------------------------------- |\n| Create a checksums manifest | `wp-release checksums` | `wpelevator/wp-release-checksums` |","table":"table-0"},"1910":{"id":"/js/wp-release/v0.20.0/configuration-7","page_id":"/js/wp-release/v0.20.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/configuration#naming-convention","content":"| Capability | CLI command       | GitHub Action                |\n| ---------- | ----------------- | ---------------------------- |\n| Sign files | `wp-release sign` | `wpelevator/wp-release-sign` |","table":"table-0"},"1911":{"id":"/js/wp-release/v0.20.0/configuration-8","page_id":"/js/wp-release/v0.20.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/configuration#naming-convention","content":"| Capability                      | CLI command         | GitHub Action |\n| ------------------------------- | ------------------- | ------------- |\n| Verify files against a manifest | `wp-release verify` |               |","table":"table-0"},"1912":{"id":"/js/wp-release/v0.20.0/configuration-9","page_id":"/js/wp-release/v0.20.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/configuration#naming-convention","content":"| Capability                    | CLI command                | GitHub Action |\n| ----------------------------- | -------------------------- | ------------- |\n| Check that the versions agree | `wp-release version-check` |               |","table":"table-0"},"1913":{"id":"/js/wp-release/v0.20.0/configuration-10","page_id":"/js/wp-release/v0.20.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/configuration#naming-convention","content":"| Capability                  | CLI command             | GitHub Action                      |\n| --------------------------- | ----------------------- | ---------------------------------- |\n| Deploy to WordPress.org SVN | `wp-release deploy-svn` | `wpelevator/wp-release-deploy-svn` |","table":"table-0"},"1914":{"id":"/js/wp-release/v0.20.0/configuration-11","page_id":"/js/wp-release/v0.20.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/configuration#naming-convention","content":"| Capability                 | CLI command             | GitHub Action |\n| -------------------------- | ----------------------- | ------------- |\n| Deploy to a Git repository | `wp-release deploy-git` |               |","table":"table-0"},"1915":{"id":"/js/wp-release/v0.20.0/configuration-12","page_id":"/js/wp-release/v0.20.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/configuration#naming-convention","content":"The names below are scoped to their commands. `--output` selects the primary artifact of each command; ZIP packaging uses `--checksums-file` for its accompanying manifest:"},"1916":{"id":"/js/wp-release/v0.20.0/configuration-13","page_id":"/js/wp-release/v0.20.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/configuration#naming-convention","content":"| Concept                   | CLI                                       | GitHub Action | Library     | Meaning                                                                           |\n| ------------------------- | ----------------------------------------- | ------------- | ----------- | --------------------------------------------------------------------------------- |\n| Plugin or theme directory | `<source-dir>` argument or `--source-dir` | `source-dir`  | `sourceDir` | Directory that a command reads, whether it's the repository or a build directory. |","table":"table-1"},"1917":{"id":"/js/wp-release/v0.20.0/configuration-14","page_id":"/js/wp-release/v0.20.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/configuration#naming-convention","content":"| Concept         | CLI                    | GitHub Action | Library     | Meaning                                                    |\n| --------------- | ---------------------- | ------------- | ----------- | ---------------------------------------------------------- |\n| Build directory | `build --output <dir>` | —             | `outputDir` | Directory written by `build`; files go directly inside it. |","table":"table-1"},"1918":{"id":"/js/wp-release/v0.20.0/configuration-15","page_id":"/js/wp-release/v0.20.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/configuration#naming-convention","content":"| Concept  | CLI                   | GitHub Action          | Library   | Meaning                                                           |\n| -------- | --------------------- | ---------------------- | --------- | ----------------------------------------------------------------- |\n| ZIP file | `zip --output <file>` | `output` in ZIP action | `zipPath` | Destination passed to `zipPackage()`; also returned as `zipPath`. |","table":"table-1"},"1919":{"id":"/js/wp-release/v0.20.0/configuration-16","page_id":"/js/wp-release/v0.20.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/configuration#naming-convention","content":"| Concept                   | CLI                         | GitHub Action                | Library                              | Meaning                                                                                                       |\n| ------------------------- | --------------------------- | ---------------------------- | ------------------------------------ | ------------------------------------------------------------------------------------------------------------- |\n| Standalone checksums file | `checksums --output <file>` | `output` in checksums action | first argument of `writeChecksums()` | Manifest destination relative to the working directory; the CLI returns its absolute path as `checksumsPath`. |","table":"table-1"},"1920":{"id":"/js/wp-release/v0.20.0/configuration-17","page_id":"/js/wp-release/v0.20.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/configuration#naming-convention","content":"| Concept                         | CLI                           | GitHub Action                  | Library         | Meaning                                                                             |\n| ------------------------------- | ----------------------------- | ------------------------------ | --------------- | ----------------------------------------------------------------------------------- |\n| Checksums filename when zipping | `zip --checksums-file <file>` | `checksums-file` in ZIP action | `checksumsFile` | Relative manifest filename beside the ZIP or inside its package root when embedded. |","table":"table-1"},"1921":{"id":"/js/wp-release/v0.20.0/configuration-18","page_id":"/js/wp-release/v0.20.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/configuration#naming-convention","content":"| Concept       | CLI                 | GitHub Action | Library   | Meaning                                 |\n| ------------- | ------------------- | ------------- | --------- | --------------------------------------- |\n| ZIP to deploy | `--from-zip <file>` | `from-zip`    | `fromZip` | Existing ZIP read as the deploy source. |","table":"table-1"},"1922":{"id":"/js/wp-release/v0.20.0/configuration-19","page_id":"/js/wp-release/v0.20.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/configuration#naming-convention","content":"| Concept            | CLI               | GitHub Action | Library  | Meaning                             |\n| ------------------ | ----------------- | ------------- | -------- | ----------------------------------- |\n| Git tag to compare | `--git-tag <tag>` |               | `gitTag` | Git tag checked by `version-check`. |","table":"table-1"},"1923":{"id":"/js/wp-release/v0.20.0/configuration-20","page_id":"/js/wp-release/v0.20.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/configuration#naming-convention","content":"| Concept           | CLI                   | GitHub Action | Library  | Meaning                                               |\n| ----------------- | --------------------- | ------------- | -------- | ----------------------------------------------------- |\n| SVN tag to create | `--svn-tag <version>` | `svn-tag`     | `svnTag` | Tag written by `deploy-svn`, distinct from a git tag. |","table":"table-1"},"1924":{"id":"/js/wp-release/v0.20.0/configuration-21","page_id":"/js/wp-release/v0.20.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/configuration#naming-convention","content":"| Concept        | CLI               | GitHub Action | Library  | Meaning             |\n| -------------- | ----------------- | ------------- | -------- | ------------------- |\n| SVN repository | `--svn-url <url>` | `svn-url`     | `svnUrl` | Deploy destination. |","table":"table-1"},"1925":{"id":"/js/wp-release/v0.20.0/configuration-22","page_id":"/js/wp-release/v0.20.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/configuration#naming-convention","content":"| Concept        | CLI               | GitHub Action | Library  | Meaning                                                                                                               |\n| -------------- | ----------------- | ------------- | -------- | --------------------------------------------------------------------------------------------------------------------- |\n| Git repository | `--git-url <url>` |               | `gitUrl` | Destination of `deploy-git`. Credentials come from git, like a token in the URL or an SSH key, and are never printed. |","table":"table-1"},"1926":{"id":"/js/wp-release/v0.20.0/configuration-23","page_id":"/js/wp-release/v0.20.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/configuration#naming-convention","content":"| Concept                      | CLI                               | GitHub Action | Library         | Meaning                                                                                                      |\n| ---------------------------- | --------------------------------- | ------------- | --------------- | ------------------------------------------------------------------------------------------------------------ |\n| Branch and tag to release to | `--branch <name>`, `--tag <name>` |               | `branch`, `tag` | Refs written by `deploy-git` in the Git repository, distinct from the git tag that `version-check` compares. |","table":"table-1"},"1927":{"id":"/js/wp-release/v0.20.0/configuration-24","page_id":"/js/wp-release/v0.20.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/configuration#naming-convention","content":"| Concept        | CLI                    | GitHub Action | Library       | Meaning                                                                                                                                                       |\n| -------------- | ---------------------- | ------------- | ------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| Source history | `--split-prefix <dir>` |               | `splitPrefix` | Directory of a monorepo package whose history, split into its own commits like `git subtree split` does, becomes the source history of `deploy-git` releases. |","table":"table-1"},"1928":{"id":"/js/wp-release/v0.20.0/configuration-25","page_id":"/js/wp-release/v0.20.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/configuration#naming-convention","content":"| Concept         | CLI                                                                 | GitHub Action                  | Library                      | Meaning                                                                                                                                                    |\n| --------------- | ------------------------------------------------------------------- | ------------------------------ | ---------------------------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| SVN credentials | `--svn-username <name>`, `SVN_USERNAME` and `SVN_PASSWORD` env vars | `svn-username`, `svn-password` | `svnUsername`, `svnPassword` | Needed only to commit. There's no password flag, since it would show in the process list; the action inputs and library options fall back to the env vars. |","table":"table-1"},"1929":{"id":"/js/wp-release/v0.20.0/configuration-26","page_id":"/js/wp-release/v0.20.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/configuration#naming-convention","content":"| Concept    | CLI                                                | GitHub Action   | Library                                                   | Meaning                                                                                                                               |\n| ---------- | -------------------------------------------------- | --------------- | --------------------------------------------------------- | ------------------------------------------------------------------------------------------------------------------------------------- |\n| Log format | `--log-format <text\\|github>`, `--ci` for `github` | always `github` | `writer: new TextWriter()` or `new GitHubActionsWriter()` | How the log is printed: plain text, or GitHub Actions annotations and job summaries. Each name matches the start of its writer class. |","table":"table-1"},"1930":{"id":"/js/wp-release/v0.20.0/configuration-27","page_id":"/js/wp-release/v0.20.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/configuration#naming-convention","content":"| Concept        | CLI               | GitHub Action                              | Library      | Meaning                                                                                  |\n| -------------- | ----------------- | ------------------------------------------ | ------------ | ---------------------------------------------------------------------------------------- |\n| Release config | `--config <path>` | `config` in ZIP, checksums and SVN actions | `configFile` | Explicit JavaScript config path for package selection, integrity settings or deployment. |","table":"table-1"},"1931":{"id":"/js/wp-release/v0.20.0/configuration-28","page_id":"/js/wp-release/v0.20.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/configuration#naming-convention","content":"| Concept            | CLI                     | GitHub Action              | Library     | Meaning                                                 |\n| ------------------ | ----------------------- | -------------------------- | ----------- | ------------------------------------------------------- |\n| Release tag format | `--tag-format <format>` | `tag-format` in SVN action | `tagFormat` | How `release-ref` identifies a package and its version. |","table":"table-1"},"1932":{"id":"/js/wp-release/v0.20.0/configuration-29","page_id":"/js/wp-release/v0.20.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/configuration#naming-convention","content":"| Concept               | CLI                   | GitHub Action               | Library | Meaning                                                             |\n| --------------------- | --------------------- | --------------------------- | ------- | ------------------------------------------------------------------- |\n| Release ref to deploy | `--release-ref <ref>` | `release-ref` in SVN action | `ref`   | Read configured packages and deployment targets from a release ref. |","table":"table-1"},"1933":{"id":"/js/wp-release/v0.20.0/configuration-30","page_id":"/js/wp-release/v0.20.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/configuration#naming-convention","content":"| Concept     | CLI                   | GitHub Action           | Library  | Meaning                                                                                                                               |\n| ----------- | --------------------- | ----------------------- | -------- | ------------------------------------------------------------------------------------------------------------------------------------- |\n| Assets sync | `--no-assets` to skip | `assets: false` to skip | `assets` | Booleans are positive in the library and the action; `--no-assets` is only the CLI negation, never `noAssets` or a `no-assets` input. |","table":"table-1"},"1934":{"id":"/js/wp-release/v0.20.0/configuration-31","page_id":"/js/wp-release/v0.20.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/configuration#naming-convention","content":"CLI JSON results use camelCase keys like `zipPath`, and GitHub Action outputs use kebab-case like `zip-path`. The ZIP action supports `package` and `config`, the checksums action supports `config` for codec selection, and the SVN action supports `release-ref`, repeated `package` values as newline-separated input, `list`, `config` and `tag-format`."},"1935":{"id":"/js/wp-release/v0.20.0/configuration-32","page_id":"/js/wp-release/v0.20.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/configuration#naming-convention","content":"The ZIP CLI result uses `checksumsEmbedded` for the package-relative embedded manifest path. Its `signatures` array includes external absolute paths and embedded package-relative paths, while `checksumsSignatures` contains only manifest signatures. The ZIP action exposes those locations as `checksums-embedded`, `signatures` for external signatures, and `signatures-embedded` for embedded signatures, so asset uploads receive local files. With CLI `--github-output`, signature arrays remain in the JSON `result` output."},"1936":{"id":"/js/wp-release/v0.20.0/configuration-33","page_id":"/js/wp-release/v0.20.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/configuration#naming-convention","content":"Library classes are named after the capability (`SvnDeploy`, `Svn`, `GitDeploy`) without repeating \"release\"."},"1937":{"id":"/js/wp-release/v0.20.0/configuration-34","page_id":"/js/wp-release/v0.20.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/configuration#file-selection","content":"`build`, `zip`, `checksums`, `deploy-svn` and `deploy-git` select files the same way:"},"1938":{"id":"/js/wp-release/v0.20.0/configuration-35","page_id":"/js/wp-release/v0.20.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/configuration#file-selection","content":"| Option                | Description                                                                                                                    |\n| --------------------- | ------------------------------------------------------------------------------------------------------------------------------ |\n| `--distignore <file>` | Path to the ignore file. Defaults to `.distignore` in the source directory when present; an explicitly passed file must exist. |","table":"table-2"},"1939":{"id":"/js/wp-release/v0.20.0/configuration-36","page_id":"/js/wp-release/v0.20.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/configuration#file-selection","content":"| Option            | Description                 |\n| ----------------- | --------------------------- |\n| `--no-distignore` | Don't read any ignore file. |","table":"table-2"},"1940":{"id":"/js/wp-release/v0.20.0/configuration-37","page_id":"/js/wp-release/v0.20.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/configuration#file-selection","content":"| Option                 | Description                                                                                                                                                                                    |\n| ---------------------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `--exclude <patterns>` | Extra gitignore-style patterns, comma-separated or repeated, like `--exclude build/,assets/*,images/**/*`. They're applied after the ignore file, so a `!` pattern can also re-include a file. |","table":"table-2"},"1941":{"id":"/js/wp-release/v0.20.0/configuration-38","page_id":"/js/wp-release/v0.20.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/configuration#file-selection","content":"| Option                    | Description                                                                                                                                  |\n| ------------------------- | -------------------------------------------------------------------------------------------------------------------------------------------- |\n| `--exclude-gitattributes` | Also exclude paths marked `export-ignore` by Git attributes. This is opt-in and requires the source directory to be inside a Git repository. |","table":"table-2"},"1942":{"id":"/js/wp-release/v0.20.0/configuration-39","page_id":"/js/wp-release/v0.20.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/configuration#file-selection","content":"`.distignore` and `--exclude` use full gitignore syntax, including `!` negation. `--exclude-gitattributes` asks Git to evaluate `export-ignore` attributes, including nested `.gitattributes` files, then adds those paths to the exclusions. It is off by default, so releases don't unexpectedly depend on Git or change selection when a repository adds attributes. Git must be installed and the source directory must be inside a working tree; the flag is ignored by `deploy-svn --from-zip`, since the ZIP is already filtered. Version control metadata (`.git`, `.svn` and `.hg`, at any depth, including the `.git` files of worktrees and submodules) is always left out, also without an ignore file and when deploying from a ZIP, and no `!` pattern can re-include it. This keeps a repository's history out of ZIPs and deploys when the source directory is the repository root. The comma-separated `--exclude` list works like `--exclude` in `wp i18n make-pot`. Selected symbolic links are an error, since ZIP archives and WordPress.org SVN don't support them."},"1943":{"id":"/js/wp-release/v0.20.0/configuration-40","page_id":"/js/wp-release/v0.20.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/configuration#plugin-and-theme-headers","content":"The commands read the same headers as WordPress. The main plugin file is the top-level `.php` file with a `Plugin Name:` header in its first 8 KB, preferring `{slug}.php` when several files have one. A directory without a plugin file and with `Theme Name:` in `style.css` is a theme. The readme headers (`Stable tag`, `Tested up to`, …) come from `readme.txt`, or `readme.md` when there's no `readme.txt`."},"1944":{"id":"/js/wp-release/v0.20.0/configuration-41","page_id":"/js/wp-release/v0.20.0/configuration","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/configuration#plugin-and-theme-headers","content":"`--version` defaults to the `Version` header in `zip`, `checksums` and `version-check`, and `checksums --type` defaults to the detected package type."},"1945":{"id":"/js/wp-release/v0.20.0/deployment","page_id":"/js/wp-release/v0.20.0/deployment","type":"page","content":"Deployment","breadcrumbs":["Docs","Js","Wp release","v0.20.0"],"tags":[],"url":"/js/wp-release/v0.20.0/deployment"},"1946":{"id":"/js/wp-release/v0.20.0/deployment-0","page_id":"/js/wp-release/v0.20.0/deployment","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0/deployment#deploy-to-svn","content":"Deploy to SVN"},"1947":{"id":"/js/wp-release/v0.20.0/deployment-1","page_id":"/js/wp-release/v0.20.0/deployment","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0/deployment#deploy-to-git","content":"Deploy to Git"},"1948":{"id":"/js/wp-release/v0.20.0/deployment-2","page_id":"/js/wp-release/v0.20.0/deployment","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0/deployment#deploy-configured-packages","content":"Deploy configured packages"},"1949":{"id":"/js/wp-release/v0.20.0/deployment-3","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-to-svn","content":"The `wp-release-deploy-svn` GitHub Action runs this command."},"1950":{"id":"/js/wp-release/v0.20.0/deployment-4","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-to-svn","content":"`deploy-svn` syncs a plugin to the WordPress.org plugin SVN repository. Each SVN write is a separate flag and nothing is written unless requested. All writes go into one commit."},"1951":{"id":"/js/wp-release/v0.20.0/deployment-5","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-to-svn","content":"| Flag      | Default | Writes                                     |\n| --------- | ------- | ------------------------------------------ |\n| `--trunk` | off     | Sync the full source directory to `trunk/` |","table":"table-0"},"1952":{"id":"/js/wp-release/v0.20.0/deployment-6","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-to-svn","content":"| Flag            | Default | Writes                                                                                                                             |\n| --------------- | ------- | ---------------------------------------------------------------------------------------------------------------------------------- |\n| `--readme-only` | off     | Sync only the readme to `trunk/`, for updates between releases such as bumping `Tested up to`. Can't be combined with `--svn-tag`. |","table":"table-0"},"1953":{"id":"/js/wp-release/v0.20.0/deployment-7","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-to-svn","content":"| Flag                  | Default | Writes                                                                                                                                                                                                                                                        |\n| --------------------- | ------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `--svn-tag <version>` | off     | Create `tags/<version>`. With `--trunk`, the tag is a copy of the synced `trunk/`. Without it, the tag is built directly from the source files and `trunk/` is left alone, for pre-release tags. A leading `v` is stripped, so `v1.2.0` creates `tags/1.2.0`. |","table":"table-0"},"1954":{"id":"/js/wp-release/v0.20.0/deployment-8","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-to-svn","content":"| Flag                 | Default | Writes                                                                                                                                                                                 |\n| -------------------- | ------- | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `--assets-dir <dir>` | not set | Sync this directory with banners, icons and screenshots to the SVN `assets/` directory. There's no default directory, so assets are only deployed when this is set, and it must exist. |","table":"table-0"},"1955":{"id":"/js/wp-release/v0.20.0/deployment-9","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-to-svn","content":"| Flag          | Default | Writes                                                                                            |\n| ------------- | ------- | ------------------------------------------------------------------------------------------------- |\n| `--no-assets` |         | Skip the `--assets-dir` sync for one run, for example when a config always passes `--assets-dir`. |","table":"table-0"},"1956":{"id":"/js/wp-release/v0.20.0/deployment-10","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-to-svn","content":"Typical runs:"},"1957":{"id":"/js/wp-release/v0.20.0/deployment-11","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-to-svn","content":"How a deploy works:"},"1958":{"id":"/js/wp-release/v0.20.0/deployment-12","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-to-svn","content":"The options are validated, including the slug, version and readme name, before they're used in URLs or paths."},"1959":{"id":"/js/wp-release/v0.20.0/deployment-13","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-to-svn","content":"With `--trunk` or `--svn-tag`, the files must be a plugin whose `Version` header matches the version. When `--trunk` and `--svn-tag` are combined, the readme `Stable tag` must match too; a tag-only run skips that, since a pre-release tag doesn't change the stable tag. `--readme-only` needs the readme. Nothing is checked out when a check fails."},"1960":{"id":"/js/wp-release/v0.20.0/deployment-14","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-to-svn","content":"The repository is checked out sparsely into a new temporary directory, with only the directories that the flags write to. A missing `assets/` (or `trunk/`, `tags/`) directory is created. The deploy stops when `tags/<version>` exists, unless `--force` replaces it."},"1961":{"id":"/js/wp-release/v0.20.0/deployment-15","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-to-svn","content":"The files are synced in Node.js, without `rsync`: new and changed files are copied, files that are no longer selected are deleted, and `svn add` and `svn delete` stage them, including files that svn ignores by default. With `--trunk`, `trunk/` is then copied to the tag with `svn copy`. Without it, the same selected files are synced into `tags/<version>` instead, and with `--force` an existing tag is updated to match, deleting files that are no longer in the build."},"1962":{"id":"/js/wp-release/v0.20.0/deployment-16","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-to-svn","content":"Asset images get `svn:mime-type` set for PNG, JPEG, GIF and SVG, the formats that WordPress.org documents for plugin assets. Other formats keep the type that svn assigns."},"1963":{"id":"/js/wp-release/v0.20.0/deployment-17","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-to-svn","content":"When `svn status` is empty, the deploy ends without a commit. A dry run logs the status and stops before the commit. Otherwise the changes are committed, and the temporary directory is always removed."},"1964":{"id":"/js/wp-release/v0.20.0/deployment-18","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-to-svn","content":"`--from-zip` reads the files from a ZIP instead of `<source-dir>`. The ZIP is checked before it's extracted: entries with absolute paths, `..` segments or symbolic links, and entries outside a single `{slug}/` root folder, are rejected."},"1965":{"id":"/js/wp-release/v0.20.0/deployment-19","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-to-svn","content":"Credentials are only needed for the commit, not for dry runs, no-op runs or `file://` repositories. Pass the username with `--svn-username` or `SVN_USERNAME` and the password in `SVN_PASSWORD`. svn always runs non-interactively without caching credentials, and the password is passed on the standard input with `--password-from-stdin`, never on the command line or in the logs."},"1966":{"id":"/js/wp-release/v0.20.0/deployment-20","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-to-svn","content":"Validation:"},"1967":{"id":"/js/wp-release/v0.20.0/deployment-21","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-to-svn","content":"`--readme-only` can't be combined with `--svn-tag`, since a tag is a release snapshot that a readme update never changes."},"1968":{"id":"/js/wp-release/v0.20.0/deployment-22","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-to-svn","content":"`--version` defaults to `--svn-tag`, then the `Version` header of the deployed files; when `--version` and `--svn-tag` are both set they must match."},"1969":{"id":"/js/wp-release/v0.20.0/deployment-23","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-to-svn","content":"Pre-release versions like `1.0.0-rc.1` can be tagged, but syncing one to `trunk/` warns, since trunk is for the development version."},"1970":{"id":"/js/wp-release/v0.20.0/deployment-24","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-to-svn","content":"`--trunk` without `--svn-tag` works but warns, to remind you that updating trunk alone doesn't create a version tag for stable downloads."},"1971":{"id":"/js/wp-release/v0.20.0/deployment-25","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-to-svn","content":"A version mismatch throws a `VersionMismatchError`, a `ValidationError` with the `mismatches` and a problem for each, with its file and line. See Logging."},"1972":{"id":"/js/wp-release/v0.20.0/deployment-26","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-to-git","content":"`deploy-git` deploys the selected files of a plugin, theme or package to a Git repository, like a distribution repository that ships the built files and `vendor/` for Composer installs or GitHub-hosted updates, or the release repository of a monorepo package. It selects files like `zip`, with `.distignore` and `--exclude`, so built files that git ignores in the source repository, like `build/` or `vendor/`, are released too. The source directory must be inside a Git repository, which provides the source history and stores the release objects before they're pushed."},"1973":{"id":"/js/wp-release/v0.20.0/deployment-27","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-to-git","content":"| Flag              | Default | Writes                          |\n| ----------------- | ------- | ------------------------------- |\n| `--branch <name>` | off     | Push the release to this branch |","table":"table-1"},"1974":{"id":"/js/wp-release/v0.20.0/deployment-28","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-to-git","content":"| Flag           | Default | Writes                          |\n| -------------- | ------- | ------------------------------- |\n| `--tag <name>` | off     | Create this tag for the release |","table":"table-1"},"1975":{"id":"/js/wp-release/v0.20.0/deployment-29","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-to-git","content":"How a deploy works:"},"1976":{"id":"/js/wp-release/v0.20.0/deployment-30","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-to-git","content":"The selected files are written to the object database of the source repository and become a tree, with a temporary index, so the working tree and the index of the repository are left alone. Executable files stay executable."},"1977":{"id":"/js/wp-release/v0.20.0/deployment-31","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-to-git","content":"The previous release is fetched: the tip of `--branch`, or for a tag-only deploy the tip of the repository's default branch (its `HEAD`), whatever that branch holds. Release a tag together with `--branch` to choose the branch it builds on."},"1978":{"id":"/js/wp-release/v0.20.0/deployment-32","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-to-git","content":"When the files are the same as in the previous release, that release is reused. Otherwise a release commit is created with the files, whose parents are the previous release and the source history: the source commit (`--source-ref`, default `HEAD`), or with `--split-prefix` the history of that directory, split with `@wpelevator/subtree-split` into the same commits as `git subtree split` makes. The repository keeps the source history, and `git log --first-parent` lists the releases."},"1979":{"id":"/js/wp-release/v0.20.0/deployment-33","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-to-git","content":"When the previous release on `--branch` already has newer source history, the branch isn't moved, so running an older build again, like a re-run of an earlier CI job, can't release older files. The source history is outdated when it's an older commit of the source history that the previous release was made from, its last parent. The split makes this reliable for `--split-prefix` too, since it creates the same commits for the same history. It needs the full history, so a shallow clone, like a checkout without `fetch-depth: 0`, fails. A revert is a new commit, so it's released, and with `--tag` the tag of an older build is still released, without moving the branch."},"1980":{"id":"/js/wp-release/v0.20.0/deployment-34","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-to-git","content":"The tag is checked in the repository first. A tag that already has the same files is the release: it's reused and nothing is pushed, so running a tag release again is a no-op. A tag with other files fails with exit code `2` before anything is pushed."},"1981":{"id":"/js/wp-release/v0.20.0/deployment-35","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-to-git","content":"The release is pushed to the branch, unless it didn't change or is outdated, and to the tag, in one atomic push. Pushes are never forced, so the branch only moves forward and a tag is never replaced, also when it was created in the meantime."},"1982":{"id":"/js/wp-release/v0.20.0/deployment-36","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-to-git","content":"To release a tag again, for example after a release with the wrong files, delete the tag in the repository (`git push <url> :refs/tags/<tag>`) and run the deploy again. There's no flag for replacing a tag, since installs, Composer and GitHub Actions pins trust that a published tag doesn't change."},"1983":{"id":"/js/wp-release/v0.20.0/deployment-37","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-to-git","content":"`--dry-run` runs everything except the push. `--message` sets the commit message, which defaults to `Release <tag or branch> from <source commit>`. Credentials come from git, like a credential helper or an SSH key, and credentials in URLs are never printed. For an HTTPS repository on `github.com`, or on the host of `GITHUB_SERVER_URL` like GitHub Enterprise Server, the `GITHUB_TOKEN` environment variable is sent as an authorization header, like `actions/checkout` does, so the token stays out of the URL, the git arguments and the repository config, and it replaces the header that `actions/checkout` persists. Pass `token` to `resolveGitDeployOptions()` for another HTTPS host. The commit needs a git identity (`user.name` and `user.email`)."},"1984":{"id":"/js/wp-release/v0.20.0/deployment-38","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-configured-packages","content":"`deploy-git --release-ref <ref>` and `deploy-svn --release-ref <ref>` deploy the packages of a monorepo, or of a single-package repository, to the targets in the `deploy` config of their package groups, like the release repository of each package or its WordPress.org plugin. The ref decides what's deployed: a release tag of a package, like `refs/tags/plugins/alpha/1.2.0` read with the `tagFormat`, deploys that package and version, and a branch, like `refs/heads/main`, deploys every package with a target for that branch. A name without `refs/` is a release tag when it matches the tag format of a package, otherwise a branch, and in GitHub Actions `$GITHUB_REF` is the pushed ref."},"1985":{"id":"/js/wp-release/v0.20.0/deployment-39","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-configured-packages","content":"| Mode | Command                          | Use                                                                                                                                                                                           |\n| ---- | -------------------------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| All  | `deploy-git --release-ref <ref>` | Deploy every package of the ref to each of its targets, one at a time, in one log group for each package. A failed deploy doesn't stop the others, and the command exits with `1` at the end. |","table":"table-2"},"1986":{"id":"/js/wp-release/v0.20.0/deployment-40","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-configured-packages","content":"| Mode        | Command                                           | Use                                                                                                                                                       |\n| ----------- | ------------------------------------------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| One package | `deploy-git --release-ref <ref> --package <name>` | Deploy only that package (repeatable), by identifier or path, for example to retry a failed one or in a CI job for each package with its own credentials. |","table":"table-2"},"1987":{"id":"/js/wp-release/v0.20.0/deployment-41","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-configured-packages","content":"| Mode | Command                                 | Use                                                                                                                                                                                                                                                                                             |\n| ---- | --------------------------------------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| Plan | `deploy-git --release-ref <ref> --list` | List the deploys without running them, with each package, its version or branch and the targets with the tag or branch they get. With `--json` or `--github-output` the result is `{ packages: [ … ] }`, for a CI matrix with `include: ${{ fromJSON( steps.plan.outputs.result ).packages }}`. |","table":"table-2"},"1988":{"id":"/js/wp-release/v0.20.0/deployment-42","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-configured-packages","content":"| Mode             | Command                                      | Use                                                        |\n| ---------------- | -------------------------------------------- | ---------------------------------------------------------- |\n| Single directory | `deploy-git <dir> --git-url <url> [options]` | Deploy one directory without a config, as described above. |","table":"table-2"},"1989":{"id":"/js/wp-release/v0.20.0/deployment-43","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-configured-packages","content":"`deploy-svn` has the same modes. `--release-ref` can't be combined with the options of a single target, like `--git-url`, `--tag` or `--svn-tag`, which come from the config."},"1990":{"id":"/js/wp-release/v0.20.0/deployment-44","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-configured-packages","content":"**Git targets** take a `repository` and release both branches and tags by default. `branches` limits the branches, like `[ 'main' ]`, or turns them off with `false`, and `tag` is the tag template in the repository, `{version}` by default, or `false` to not release tags. A release tag is created on top of the default branch of the repository, and a branch is released to the same branch. `history: false` uses the source commit instead of the package history, and `message` sets the release commit message, `Release {ref} from {revision}` by default."},"1991":{"id":"/js/wp-release/v0.20.0/deployment-45","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-configured-packages","content":"**SVN targets** only deploy release tags: a stable release syncs `trunk/`, creates its tag and syncs the `assetsDir`, and a pre-release only creates its tag. `slug`, the WordPress.org plugin slug, defaults to the name of the package directory, `url` to the WordPress.org plugin repository, and `message` sets the commit message. Credentials come from `SVN_USERNAME` and `SVN_PASSWORD`, or `--svn-username`."},"1992":{"id":"/js/wp-release/v0.20.0/deployment-46","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-configured-packages","content":"**Several targets**: `git` and `svn` each take one target or a list, like a release repository and a mirror on another host. Each target is a separate deploy."},"1993":{"id":"/js/wp-release/v0.20.0/deployment-47","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-configured-packages","content":"**Credentials**: a GitHub repository URL needs no token in it, since `GITHUB_TOKEN` is sent as an authorization header (see above). A callback can still add credentials for other hosts."},"1994":{"id":"/js/wp-release/v0.20.0/deployment-48","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-configured-packages","content":"**Templates and callbacks**: `repository`, `slug` and `message` are templates with `{name}` and `{path}`, like the `tagFormat`, and `{version}`, `{branch}`, `{ref}` (the tag or branch that the deploy writes in the target) and `{revision}` (the source commit), or callbacks that receive `{ package, version, branch, ref, revision }`, where `package` has the `name`, `directory`, `path` and `type`. A callback can name a target after the package directory, choose another host for some packages, read the environment, or return nothing to skip the target for that package or ref; an empty `message` uses the default one. Credentials in URLs are never printed or listed."},"1995":{"id":"/js/wp-release/v0.20.0/deployment-49","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-configured-packages","content":"**Results**: with `--json` or `--github-output`, the result lists each deploy in `deploys` with its `package`, `label`, `target` (the repository or WordPress.org plugin, with credentials redacted), `targetRef` (the tag or branch written there), `version` or `branch`, and its `result` or `error`. A remote target repository also has its `targetHost`, like `github.com`, and `targetPath`, like `me/my-plugin`, without credentials, for a workflow step that calls the API of the forge that hosts it, such as to create the release of the deployed tag. The targets of `--list` have the same `host` and `path`, and `parseRepositoryUrl()` reads them from an HTTP(S), SSH or scp-like URL. `wp-release` doesn't call forge APIs itself."},"1996":{"id":"/js/wp-release/v0.20.0/deployment-50","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-configured-packages","content":"**Packages without a version**: a package entry without `version`, like a single directory with a `glob` of its path, isn't released with changesets, so changes to it don't need one, and it only deploys branches, since it has no release tags."},"1997":{"id":"/js/wp-release/v0.20.0/deployment-51","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-configured-packages","content":"**Files**: `files.exclude` adds gitignore-style patterns relative to the package directory, and `files.distignore` sets the ignore file relative to it or turns it off with `false`. A `files` at the root of the config applies to every package group, for the rules that all packages share, and the `files` of a group add their patterns after it and can replace its ignore file. Without `files`, each package's `.distignore` applies, like for `zip`; there's no repository-wide `.distignore`, since each one is relative to its package. `zip --package <name>` zips a package with the same files, `getPackageFiles()` returns the directory and the file selection of any configured package, and `getDeployPackages()` lists the packages with deploy targets and their file selection."},"1998":{"id":"/js/wp-release/v0.20.0/deployment-52","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-configured-packages","content":"A deploy releases the files of the working tree, so build the packages first. One job that builds once and runs `deploy-git --release-ref \"$GITHUB_REF\"` is the simplest setup, also for a branch that releases every package. A matrix with a job for each package from `--list` would build every package in every job, so build once and pass the built tree to the jobs as an artifact if you need one, for example for separate credentials."},"1999":{"id":"/js/wp-release/v0.20.0/deployment-53","page_id":"/js/wp-release/v0.20.0/deployment","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/deployment#deploy-configured-packages","content":"Other monorepo tools split the same way with less of the release in the config: Symplify MonorepoBuilder and `danharrin/monorepo-split-github-action` push the source history of each package directory, with the packages and repositories listed in the workflow or a matrix, while `deploy-git` releases the built files on top of that history, so `vendor/` and `build/` reach Composer and WordPress installs. Like the publishers of GoReleaser, targets are lists with templates, and pre-releases skip the targets where they would replace the stable version."},"2000":{"id":"/js/wp-release/v0.20.0/development","page_id":"/js/wp-release/v0.20.0/development","type":"page","content":"Development","breadcrumbs":["Docs","Js","Wp release","v0.20.0"],"tags":[],"url":"/js/wp-release/v0.20.0/development"},"2001":{"id":"/js/wp-release/v0.20.0/development-0","page_id":"/js/wp-release/v0.20.0/development","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0/development#development","content":"Development"},"2002":{"id":"/js/wp-release/v0.20.0/development-1","page_id":"/js/wp-release/v0.20.0/development","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0/development#architecture","content":"Architecture"},"2003":{"id":"/js/wp-release/v0.20.0/development-2","page_id":"/js/wp-release/v0.20.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/development#development","content":"The source is TypeScript in `src/`, with tests next to the files they test (`*.test.ts`). The published package contains only the compiled `dist/` with JavaScript and `.d.ts` files; tests and translation fixtures stay in the repository."},"2004":{"id":"/js/wp-release/v0.20.0/development-3","page_id":"/js/wp-release/v0.20.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/development#development","content":"`build` compiles `src/` to `dist/` with `tsc`, leaving out the tests. TypeScript resolves the workspace packages that wp-release depends on, like `@wpelevator/zip`, through their `wpelevator-source` condition, so it checks their source and needs no `dist/` of them. `preserveSymlinks` keeps their files under `node_modules`, so they aren't compiled into wp-release's `dist/`."},"2005":{"id":"/js/wp-release/v0.20.0/development-4","page_id":"/js/wp-release/v0.20.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/development#development","content":"`test` runs the `.ts` tests directly with `node --test`, using Node.js type stripping, so it needs Node.js 22.18 or later but no build. The SVN integration tests in `svn-deploy.integration.test.ts` create repositories with `svnadmin` and deploy to their `file://` URLs; they're skipped when `svn` or `svnadmin` isn't installed."},"2006":{"id":"/js/wp-release/v0.20.0/development-5","page_id":"/js/wp-release/v0.20.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/development#development","content":"`lint` runs ESLint and a `tsc` type check."},"2007":{"id":"/js/wp-release/v0.20.0/development-6","page_id":"/js/wp-release/v0.20.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/development#development","content":"The i18n tests in `@wpelevator/wp-gettext` validate gettext round trips, script catalogs and generated PHP data without launching PHP, WP-CLI or WordPress, covering contexts, plural forms, comments, flags, Unicode, escaping and PHP-looking input as data."},"2008":{"id":"/js/wp-release/v0.20.0/development-7","page_id":"/js/wp-release/v0.20.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/development#development","content":"The `wpelevator-source` export condition points at `src/index.ts`. The wp-release tests and monorepo CLI scripts use it to work with the source instead of a `dist/` build. Action builds use the declared dependency's default export, which resolves to `dist/` for the workspace copy and the published package. Build wp-release before building the actions."},"2009":{"id":"/js/wp-release/v0.20.0/development-8","page_id":"/js/wp-release/v0.20.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/development#development","content":"`execute( 'deploy-svn', args, { cwd, logger, svnRunner } )` runs a single-plugin deployment or a configured plan or deployment. The optional `svnRunner` replaces the external command runner in both modes; without it, the command uses its normal runner."},"2010":{"id":"/js/wp-release/v0.20.0/development-9","page_id":"/js/wp-release/v0.20.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/development#architecture","content":"wp-release has two layers, so that it fits any repository layout:"},"2011":{"id":"/js/wp-release/v0.20.0/development-10","page_id":"/js/wp-release/v0.20.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/development#architecture","content":"**Primitives** work on the directory, file or values they're given and know nothing about the repository: `build <dir>`, `zip <dir>`, `checksums`, `sign`, `verify`, `version-check`, `deploy-git <dir>`, `deploy-svn <dir>`, `i18n-pot <dir>`, `i18n-audit <dir>` and the `i18n-mo`, `i18n-json` and `i18n-php` compilers."},"2012":{"id":"/js/wp-release/v0.20.0/development-11","page_id":"/js/wp-release/v0.20.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/development#architecture","content":"**The config layer** reads `wp-release.config.js` for everything about the repository: where packages are (`root` and the package globs), how their versions and tags are named (`version`, `tagFormat`), which files they ship (`files`), how their translations are extracted (`i18n`), where they deploy (`deploy`) and the git `remote`. The changeset commands (with a single-project fallback when no config exists), `deploy-git` and `deploy-svn --release-ref`, `build --package` and `zip --package`, and `i18n-pot` and `i18n-audit` with `--package` or `--all` belong to it, and the global `--config` and `--tag-format` options select or adjust the config. `zip` and `checksums` also read caller configuration for integrity settings even without `--package`; verification reads it only when explicitly selected. Only `--release-ref` reads which package and version a ref releases. A primitive with a config mode, like `deploy-git --release-ref` beside `deploy-git <dir>` or `zip --package` beside `zip <dir>`, only takes the package directory, its files and its targets from the config there, and otherwise works the same."},"2013":{"id":"/js/wp-release/v0.20.0/development-12","page_id":"/js/wp-release/v0.20.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/development#architecture","content":"Configured repositories use the layout and naming conventions their config sets. Config-free changeset releases use the root-only detection and defaults described above."},"2014":{"id":"/js/wp-release/v0.20.0/development-13","page_id":"/js/wp-release/v0.20.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/development#architecture","content":"The GitHub Actions are adapters to these commands: they use the same flag names and `execute()` entry point, with secrets supplied through environment variables. The SVN action injects a command runner that checks or installs SVN only when a deployment runs its first SVN command; config planning and deployment behavior remain in `wp-release`."},"2015":{"id":"/js/wp-release/v0.20.0/development-14","page_id":"/js/wp-release/v0.20.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/development#architecture","content":"The package uses ES modules as its unit of encapsulation, like most Node.js CLI tools: a module exports a few functions and keeps its helpers private, so there's no class to wrap them in. A class is used only when it holds state across steps or binds dependencies, so that callers and tests can replace them:"},"2016":{"id":"/js/wp-release/v0.20.0/development-15","page_id":"/js/wp-release/v0.20.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/development#architecture","content":"**Workflows with steps** are classes, so that their steps share state and dependencies on the instance: `SvnDeploy` shares the temporary working copy across `prepare()`, `checkout()`, `sync()` and `commit()`, `GitDeploy` binds the options and the git runner to its steps, and `ChangesetRelease` binds the repository and the runners to `add()`, `version()` and `tag()`."},"2017":{"id":"/js/wp-release/v0.20.0/development-16","page_id":"/js/wp-release/v0.20.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/development#architecture","content":"**External commands** run through injectable runners: `createSvnRunner()` and `createGitRunner()` return functions that spawn the binary without a shell. The classes take a runner as an option and create the default one when it's missing, so tests pass a fake runner, or one that wraps the real runner and records some commands, instead of putting fake binaries on the `PATH`. The `Svn` and `ReleaseRepository` classes wrap a runner with the commands of their domain."},"2018":{"id":"/js/wp-release/v0.20.0/development-17","page_id":"/js/wp-release/v0.20.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/development#architecture","content":"**Domain logic** is plain functions that take their dependencies as arguments, like `discoverPackages( repository, config )`, so that each one can be tested on its own."},"2019":{"id":"/js/wp-release/v0.20.0/development-18","page_id":"/js/wp-release/v0.20.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/development#architecture","content":"**Commands** in `src/commands/` parse the CLI options and call the library, and `cli.ts` handles the global options, logging and exit codes. Errors carry their exit code, like `ValidationError` with `2`. Signing lives in `@wpelevator/signatures`, which throws errors with a `code`; `src/signing.ts` wraps it to read `WP_RELEASE_SIGNING_KEY` and to report those errors as `ValidationError`. ZIP archives live in `@wpelevator/zip` in the same way: `src/zip.ts` and `src/unzip.ts` adapt its entries and `zipPath` inputs and report its `ZipError` as `ValidationError`, with the `--force` hint for an existing archive. File selection and syncing live in `@wpelevator/fileset` and checksums in `@wpelevator/checksums`, which throw errors with a `code` in the same way: `src/file-selection.ts`, `src/sync.ts` and `src/checksums.ts` wrap them to report those errors as `ValidationError`, to build the manifest metadata from the plugin or theme slug and version, to select the files from the rules before hashing, and to pass the Git `export-ignore` lister to the fileset package. `src/integrity.ts` wraps the manifest codecs of the checksums package in the same way."},"2020":{"id":"/js/wp-release/v0.20.0/development-19","page_id":"/js/wp-release/v0.20.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/development#architecture","content":"Constructors only store their options. Work starts in a method call."},"2021":{"id":"/js/wp-release/v0.20.0/development-20","page_id":"/js/wp-release/v0.20.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/development#architecture","content":"The changeset release modules, from the entry point down:"},"2022":{"id":"/js/wp-release/v0.20.0/development-21","page_id":"/js/wp-release/v0.20.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/development#architecture","content":"| Module                 | Responsibility                                                                                                                              |\n| ---------------------- | ------------------------------------------------------------------------------------------------------------------------------------------- |\n| `changeset-release.ts` | `ChangesetRelease`, which plans releases and runs `add()`, `getStatus()`, `version()` and `tag()`, and the function form of each operation. |","table":"table-0"},"2023":{"id":"/js/wp-release/v0.20.0/development-22","page_id":"/js/wp-release/v0.20.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/development#architecture","content":"| Module              | Responsibility                                                                                       |\n| ------------------- | ---------------------------------------------------------------------------------------------------- |\n| `single-project.ts` | Resolving the config-free root project, its version source and targets, and shared release settings. |","table":"table-0"},"2024":{"id":"/js/wp-release/v0.20.0/development-23","page_id":"/js/wp-release/v0.20.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/development#architecture","content":"| Module                | Responsibility                                                                            |\n| --------------------- | ----------------------------------------------------------------------------------------- |\n| `changeset-config.ts` | Loading and validating `wp-release.config.js`, and the version source and target helpers. |","table":"table-0"},"2025":{"id":"/js/wp-release/v0.20.0/development-24","page_id":"/js/wp-release/v0.20.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/development#architecture","content":"| Module                  | Responsibility                                                                                             |\n| ----------------------- | ---------------------------------------------------------------------------------------------------------- |\n| `changeset-packages.ts` | Discovering the packages of the configured globs, with or without a version, and finding the changed ones. |","table":"table-0"},"2026":{"id":"/js/wp-release/v0.20.0/development-25","page_id":"/js/wp-release/v0.20.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/development#architecture","content":"| Module               | Responsibility                                  |\n| -------------------- | ----------------------------------------------- |\n| `changeset-files.ts` | Reading, writing and consuming changeset files. |","table":"table-0"},"2027":{"id":"/js/wp-release/v0.20.0/development-26","page_id":"/js/wp-release/v0.20.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/development#architecture","content":"| Module                    | Responsibility                                                                                             |\n| ------------------------- | ---------------------------------------------------------------------------------------------------------- |\n| `changeset-dependents.ts` | The dependents policy: which packages re-release with their sources, and rewriting their dependency specs. |","table":"table-0"},"2028":{"id":"/js/wp-release/v0.20.0/development-27","page_id":"/js/wp-release/v0.20.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/development#architecture","content":"| Module          | Responsibility                                            |\n| --------------- | --------------------------------------------------------- |\n| `changesets.ts` | Parsing and formatting changesets, and the release types. |","table":"table-0"},"2029":{"id":"/js/wp-release/v0.20.0/development-28","page_id":"/js/wp-release/v0.20.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/development#architecture","content":"| Module             | Responsibility                                                                 |\n| ------------------ | ------------------------------------------------------------------------------ |\n| `version-files.ts` | Reading and writing versions in manifests, headers, readmes and PHP constants. |","table":"table-0"},"2030":{"id":"/js/wp-release/v0.20.0/development-29","page_id":"/js/wp-release/v0.20.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/development#architecture","content":"| Module         | Responsibility                                                           |\n| -------------- | ------------------------------------------------------------------------ |\n| `changelog.ts` | Changelog entries, and the `CHANGELOG.md` and readme changelog sections. |","table":"table-0"},"2031":{"id":"/js/wp-release/v0.20.0/development-30","page_id":"/js/wp-release/v0.20.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/development#architecture","content":"| Module            | Responsibility                                                                      |\n| ----------------- | ----------------------------------------------------------------------------------- |\n| `release-tags.ts` | Choosing the version and previous tag of a release, and building its release notes. |","table":"table-0"},"2032":{"id":"/js/wp-release/v0.20.0/development-31","page_id":"/js/wp-release/v0.20.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/development#architecture","content":"| Module          | Responsibility                            |\n| --------------- | ----------------------------------------- |\n| `tag-format.ts` | Formatting tag names from the tag format. |","table":"table-0"},"2033":{"id":"/js/wp-release/v0.20.0/development-32","page_id":"/js/wp-release/v0.20.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/development#architecture","content":"| Module              | Responsibility                                                                                                                                                                                   |\n| ------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `package-deploy.ts` | Resolving the configured deploys of a ref: the released packages, their targets and file selections, for `deploy-git` and `deploy-svn`, and the file selection of a package for `zip --package`. |","table":"table-0"},"2034":{"id":"/js/wp-release/v0.20.0/development-33","page_id":"/js/wp-release/v0.20.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/development#architecture","content":"| Module           | Responsibility                                                                                                                      |\n| ---------------- | ----------------------------------------------------------------------------------------------------------------------------------- |\n| `package-zip.ts` | `zipPackage()`, the ZIP and checksums manifest of the selected files of a package, for `zip` and the snapshot builds of a monorepo. |","table":"table-0"},"2035":{"id":"/js/wp-release/v0.20.0/development-34","page_id":"/js/wp-release/v0.20.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/development#architecture","content":"| Module                  | Responsibility                                                                       |\n| ----------------------- | ------------------------------------------------------------------------------------ |\n| `release-repository.ts` | `ReleaseRepository`, the git commands of a release: tags, commits and changed files. |","table":"table-0"},"2036":{"id":"/js/wp-release/v0.20.0/development-35","page_id":"/js/wp-release/v0.20.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/development#architecture","content":"| Module            | Responsibility                                                                     |\n| ----------------- | ---------------------------------------------------------------------------------- |\n| `file-journal.ts` | `FileJournal`, which restores every file a failed `changeset-version` run changed. |","table":"table-0"},"2037":{"id":"/js/wp-release/v0.20.0/development-36","page_id":"/js/wp-release/v0.20.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/development#architecture","content":"| Module        | Responsibility                        |\n| ------------- | ------------------------------------- |\n| `versions.ts` | Version checks and SemVer precedence. |","table":"table-0"},"2038":{"id":"/js/wp-release/v0.20.0/development-37","page_id":"/js/wp-release/v0.20.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/development#architecture","content":"The internationalization modules in `src/i18n/` adapt the standalone `@wpelevator/wp-gettext` package, which owns extraction, catalogs, POT, PO, MO, script JSON, `.l10n.php` and audits:"},"2039":{"id":"/js/wp-release/v0.20.0/development-38","page_id":"/js/wp-release/v0.20.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/development#architecture","content":"| Module        | Responsibility                                                                                                                              |\n| ------------- | ------------------------------------------------------------------------------------------------------------------------------------------- |\n| `packages.ts` | `resolveI18nPackages()`, the config adapter that selects a directory, one package or all packages and resolves their options and POT paths. |","table":"table-1"},"2040":{"id":"/js/wp-release/v0.20.0/development-39","page_id":"/js/wp-release/v0.20.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/development#architecture","content":"| Module        | Responsibility                                                                                                                                                                                                                                         |\n| ------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `generate.ts` | `extractCatalog()`, `generatePackagePot()`, `resolvePotPath()` and `validatePotDestinations()`, which read the headers of the main file with `package-meta.ts` and pass them as `meta` to the generate functions of `@wpelevator/wp-gettext/generate`. |","table":"table-1"},"2041":{"id":"/js/wp-release/v0.20.0/development-40","page_id":"/js/wp-release/v0.20.0/development","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/development#architecture","content":"| Module       | Responsibility                                                                                                                                     |\n| ------------ | -------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `gettext.ts` | The other functions of `@wpelevator/wp-gettext`, with their `GettextError` reported as a `ValidationError` with the original error as its `cause`. |","table":"table-1"},"2042":{"id":"/js/wp-release/v0.20.0","page_id":"/js/wp-release/v0.20.0","type":"page","content":"WP Release","breadcrumbs":["Docs","Js","Wp release","v0.20.0"],"tags":[],"url":"/js/wp-release/v0.20.0"},"2043":{"id":"/js/wp-release/v0.20.0-0","page_id":"/js/wp-release/v0.20.0","tags":[],"type":"text","url":"/js/wp-release/v0.20.0","content":"Build and release WordPress plugins, themes, and packages."},"2044":{"id":"/js/wp-release/v0.20.0-1","page_id":"/js/wp-release/v0.20.0","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0#install","content":"Install"},"2045":{"id":"/js/wp-release/v0.20.0-2","page_id":"/js/wp-release/v0.20.0","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0#start-with-the-cli","content":"Start with the CLI"},"2046":{"id":"/js/wp-release/v0.20.0-3","page_id":"/js/wp-release/v0.20.0","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0#guides","content":"Guides"},"2047":{"id":"/js/wp-release/v0.20.0-4","page_id":"/js/wp-release/v0.20.0","tags":[],"type":"text","url":"/js/wp-release/v0.20.0","content":"`@wpelevator/wp-release` provides a CLI and library for building release directories and ZIPs, creating checksums and signatures, checking versions, extracting and compiling translations, and deploying to WordPress.org SVN or Git repositories."},"2048":{"id":"/js/wp-release/v0.20.0-5","page_id":"/js/wp-release/v0.20.0","tags":[],"type":"text","url":"/js/wp-release/v0.20.0","content":"The `wp-release-zip`, `wp-release-checksums`, `wp-release-sign`, and `wp-release-deploy-svn` GitHub Actions expose the same commands in workflows."},"2049":{"id":"/js/wp-release/v0.20.0-6","page_id":"/js/wp-release/v0.20.0","tags":[],"type":"text","url":"/js/wp-release/v0.20.0","content":"For projects that don't use Node.js or JavaScript tooling, PHP Changesets (`wpelevator/php-changesets`) runs the same changeset release workflow with PHP and Git alone: `changeset add`, `status`, `version` and `tag` read the same changeset files and match the options of the `changeset-*` commands described in Changesets support."},"2050":{"id":"/js/wp-release/v0.20.0-7","page_id":"/js/wp-release/v0.20.0","tags":[],"type":"text","url":"/js/wp-release/v0.20.0","content":"WordPress.org themes are released by uploading a ZIP, so `deploy-svn` is for plugins only. Use `zip` to build a theme upload. Packaging and deployment options follow familiar community tools to ease migration; the comparison explains the differences."},"2051":{"id":"/js/wp-release/v0.20.0-8","page_id":"/js/wp-release/v0.20.0","tags":[],"type":"text","url":"/js/wp-release/v0.20.0#install","content":"Node.js 22.12 or later is required. SVN deployments also require the `svn` command line client. Git deployments and changeset commands require Git."},"2052":{"id":"/js/wp-release/v0.20.0-9","page_id":"/js/wp-release/v0.20.0","tags":[],"type":"text","url":"/js/wp-release/v0.20.0#install","content":"The package is an ES module with TypeScript declarations. CommonJS projects can load it with `require( '@wpelevator/wp-release' )` on Node.js 22.12 or later."},"2053":{"id":"/js/wp-release/v0.20.0-10","page_id":"/js/wp-release/v0.20.0","tags":[],"type":"text","url":"/js/wp-release/v0.20.0#guides","content":"CLI and automation"},"2054":{"id":"/js/wp-release/v0.20.0-11","page_id":"/js/wp-release/v0.20.0","tags":[],"type":"text","url":"/js/wp-release/v0.20.0#guides","content":"Changeset releases"},"2055":{"id":"/js/wp-release/v0.20.0-12","page_id":"/js/wp-release/v0.20.0","tags":[],"type":"text","url":"/js/wp-release/v0.20.0#guides","content":"Configuration and file selection"},"2056":{"id":"/js/wp-release/v0.20.0-13","page_id":"/js/wp-release/v0.20.0","tags":[],"type":"text","url":"/js/wp-release/v0.20.0#guides","content":"Packaging, checksums, signatures, and verification"},"2057":{"id":"/js/wp-release/v0.20.0-14","page_id":"/js/wp-release/v0.20.0","tags":[],"type":"text","url":"/js/wp-release/v0.20.0#guides","content":"Git and WordPress.org deployment"},"2058":{"id":"/js/wp-release/v0.20.0-15","page_id":"/js/wp-release/v0.20.0","tags":[],"type":"text","url":"/js/wp-release/v0.20.0#guides","content":"WordPress internationalization"},"2059":{"id":"/js/wp-release/v0.20.0-16","page_id":"/js/wp-release/v0.20.0","tags":[],"type":"text","url":"/js/wp-release/v0.20.0#guides","content":"Library API"},"2060":{"id":"/js/wp-release/v0.20.0-17","page_id":"/js/wp-release/v0.20.0","tags":[],"type":"text","url":"/js/wp-release/v0.20.0#guides","content":"Development and architecture"},"2061":{"id":"/js/wp-release/v0.20.0-18","page_id":"/js/wp-release/v0.20.0","tags":[],"type":"text","url":"/js/wp-release/v0.20.0#guides","content":"Comparison with existing tools"},"2062":{"id":"/js/wp-release/v0.20.0/internationalization","page_id":"/js/wp-release/v0.20.0/internationalization","type":"page","content":"Internationalization","breadcrumbs":["Docs","Js","Wp release","v0.20.0"],"tags":[],"url":"/js/wp-release/v0.20.0/internationalization"},"2063":{"id":"/js/wp-release/v0.20.0/internationalization-0","page_id":"/js/wp-release/v0.20.0/internationalization","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0/internationalization#wordpress-internationalization","content":"WordPress internationalization"},"2064":{"id":"/js/wp-release/v0.20.0/internationalization-1","page_id":"/js/wp-release/v0.20.0/internationalization","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0/internationalization#supported-extraction-syntax","content":"Supported extraction syntax"},"2065":{"id":"/js/wp-release/v0.20.0/internationalization-2","page_id":"/js/wp-release/v0.20.0/internationalization","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0/internationalization#compile-translated-catalogs","content":"Compile translated catalogs"},"2066":{"id":"/js/wp-release/v0.20.0/internationalization-3","page_id":"/js/wp-release/v0.20.0/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/internationalization#wordpress-internationalization","content":"`i18n-pot` extracts plugin/theme strings and writes a reproducible UTF-8 POT. `i18n-audit` reads the same source and returns findings without writing files. Both run with Node alone: no PHP, WordPress installation, database, WP-CLI or network requests. Extraction is independent of `files`, `.distignore` and Git `export-ignore` distribution rules."},"2067":{"id":"/js/wp-release/v0.20.0/internationalization-4","page_id":"/js/wp-release/v0.20.0/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/internationalization#wordpress-internationalization","content":"Config-free source directories must have plugin/theme headers. The actual main file is discovered using the package metadata reader, including plugins whose main filename differs from their slug. The selected domain defaults to `Text Domain`, then the directory name. Calls with omitted domains belong to WordPress's `default` domain; block metadata without a domain inherits the package domain. `--all-domains` explicitly combines domains. A block's explicit `textdomain` always controls its messages."},"2068":{"id":"/js/wp-release/v0.20.0/internationalization-5","page_id":"/js/wp-release/v0.20.0/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/internationalization#wordpress-internationalization","content":"`--package` selects one configured package and permits extraction-specific overrides; `--all` requires configuration and selects enabled WordPress packages only. Source directories, package selectors and `--all` are mutually exclusive. Config-free directory mode reads only its explicit options and metadata; it does not import repository config implicitly. A disabled package fails when explicitly selected. Configuration uses `i18n` at the root and on package entries, including an exact `glob` for an individual package, following the existing group model. Package entries remain non-overlapping; there is no additional package manifest configuration source."},"2069":{"id":"/js/wp-release/v0.20.0/internationalization-6","page_id":"/js/wp-release/v0.20.0/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/internationalization#wordpress-internationalization","content":"Precedence is defaults, root configuration, package group/individual entry, then explicit command options. Scalars override, lists replace inherited lists, and gettext headers merge by key, case-insensitively, preserving intentionally empty values. A header set to `false` is removed, like `'Project-Id-Version': false` to keep the plugin version out of the POT so that it changes only when strings change; a later layer can set it again. `Content-Type` can't be removed, since it declares the UTF-8 charset. Options include `enabled`, `domain`, `allDomains`, `include`, `exclude`, `destination`, `headers`, `fileComment`, `location`, `strict`, `legacyGlobals` and audit `suppress`. `fileComment` adds static text above the POT header; each line is emitted as a gettext comment, and no copyright year is generated. The CLI accepts the same setting with `--file-comment`. Repeat `--include` or `--exclude` for multiple globs; these use case-sensitive minimatch semantics with `/` paths, `**`, brace expansion and dotfile matching, without gitignore negation or comma splitting. Default excludes cover dependency directories, dot directories, tests, minified files and generated translations. Source/build exclusions are a repository choice; this repository excludes `build`, `tools` and isolated vendors in its config."},"2070":{"id":"/js/wp-release/v0.20.0/internationalization-7","page_id":"/js/wp-release/v0.20.0/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/internationalization#wordpress-internationalization","content":"The default output is `<Domain Path>/<text-domain>.pot`, or `languages/<text-domain>.pot`. A leading `/` in `Domain Path` is package-relative, and configured destinations cannot escape the package. `--destination` changes the package-relative directory. An explicit `--output <file.pot>` resolves against the command's working directory and requires one package. All multi-package destinations are validated before writing; each completed package replaces its file atomically, independently of other packages. `--check` compares bytes without writing and fails if the POT is absent or stale. Source references are preserved by default as `file:line`. `--add-location file` keeps only the file name, so that editing a source file doesn't change the POT unless its strings change, and `--no-location` (the same as `--add-location never`) omits them; `--add-location full` is the default. In configuration, set `location` to `'full'`, `'file'` or `'never'`. The older `--no-references` flag and `references: false` option still work as `--no-location`, and an explicit `location` wins over `references` in the same layer. Asking for locations and for none in the same command is an error. `POT-Creation-Date` and `PO-Revision-Date` default to empty values; no current date or year is inserted. Name/version headers come from metadata, and `--header NAME=VALUE` overrides any default, including with an empty value, and `--header NAME` removes the header. The POT lists the plugin or theme header strings first, then the strings of PHP, JavaScript, `block.json` and other metadata files in source order, so related strings stay together for translators. Each entry has its extracted comments, references and flags before the strings, in the usual gettext layout. The default headers come in a fixed order, and custom headers follow them. No generator header or generated copyright comment is added; set `fileComment` for a static one."},"2071":{"id":"/js/wp-release/v0.20.0/internationalization-8","page_id":"/js/wp-release/v0.20.0/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/internationalization#supported-extraction-syntax","content":"PHP extraction uses `php-parser` in PHP 8.3 mode, tested with attributes, enums, match expressions, promoted properties and readonly classes. Supported WordPress functions are `__`, `_e`, `_x`, `_ex`, `_n`, `_nx`, `_n_noop`, `_nx_noop`, `esc_attr__`, `esc_attr_e`, `esc_attr_x`, `esc_html__`, `esc_html_e` and `esc_html_x`. Global and explicitly global calls, namespace fallback and explicit function imports/aliases are supported. Known file-local declarations and unrelated namespaced imports are excluded; methods and static methods are never translation calls. Named arguments resolve by PHP parameter name. Literal strings, static concatenation and non-interpolated heredoc/nowdoc preserve decoded escapes, Unicode and newlines. Counts may be dynamic; IDs, contexts and selected domains must be static."},"2072":{"id":"/js/wp-release/v0.20.0/internationalization-9","page_id":"/js/wp-release/v0.20.0/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/internationalization#supported-extraction-syntax","content":"JavaScript extraction uses Babel's parser and lexical scope traversal, without transforms or project Babel config. JS, JSX, TS, TSX, MJS, CJS, MTS and CTS are supported. Named imports/aliases and namespace imports from `@wordpress/i18n`, unshadowed `wp.i18n` calls and unbound canonical legacy `__`, `_x`, `_n` and `_nx` calls extract strings. `--no-legacy-globals` requires imported or `wp.i18n` bindings. Locally shadowed/reassigned imports are excluded. Static literals, templates without substitutions, concatenation and TypeScript assertions are supported. Destructured CommonJS imports, transpiled `(0, i18n.__)` forms and arbitrary minified bundles are outside the supported syntax; scan source and use explicit source/build mapping for compiled JSON."},"2073":{"id":"/js/wp-release/v0.20.0/internationalization-10","page_id":"/js/wp-release/v0.20.0/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/internationalization#supported-extraction-syntax","content":"A `translators:` comment attaches to the first translation call whose containing expression or nearest statement immediately follows it. Whitespace, parsed comments and ternary branch punctuation may intervene, but unrelated statements or argument expressions may not. Comments before outer wrappers reach nested translation calls; a comment is consumed once, so unrelated sibling calls do not inherit it. Multiline comment content is preserved. WordPress plugin/theme header labels serialize as extracted comments. Bundled metadata tables follow WordPress 6.8 block fields and theme fields, including styles, variations, presets, template names and nested block settings. Their upstream data license is GPL-2.0-or-later; tables are maintained intentionally with fixtures and never fetched during generation."},"2074":{"id":"/js/wp-release/v0.20.0/internationalization-11","page_id":"/js/wp-release/v0.20.0/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/internationalization#supported-extraction-syntax","content":"Invalid syntax, unreadable selected files, selected source symlinks, empty/reserved message IDs, conflicting plural definitions and output errors fail generation. Unsupported dynamic arguments warn and are fatal with `--strict`. Audit adds `placeholder-comment`, `unordered-placeholders`, `plural-placeholders`, `empty-message` and `conflicting-comments` findings; suppress these explicitly by code where justified. Placeholders support `%%`, positional indexes, numeric width/precision, padding/flags and PHP/JS sprintf conversion types. Audit checks extraction and message quality, not every untranslated user-facing string. Audit fails on errors; strict audit also fails on warnings. Failed checks return exit code `2`; unexpected I/O/option-loading errors follow the existing CLI error handling. `--json`, GitHub annotations, summaries and step outputs use the existing CLI reporting facilities."},"2075":{"id":"/js/wp-release/v0.20.0/internationalization-12","page_id":"/js/wp-release/v0.20.0/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/internationalization#compile-translated-catalogs","content":"Runtime formats require a translated PO, not an untranslated POT. PO updating, fuzzy matching and automatic translation are not provided. Compilation validates `Language` and `Plural-Forms`, excludes fuzzy, obsolete and untranslated entries, preserves contexts and plural forms, and never changes the input PO. An incompletely translated plural entry is excluded as a unit. Gettext parsing handles source encoding; runtime outputs use UTF-8. Each output is replaced atomically; JSON outputs are independent writes, and obsolete output files are not deleted automatically."},"2076":{"id":"/js/wp-release/v0.20.0/internationalization-13","page_id":"/js/wp-release/v0.20.0/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/internationalization#compile-translated-catalogs","content":"MO and `.l10n.php` default beside the PO, with `.mo` and `.l10n.php` extensions; `--output` selects an explicit file relative to cwd. WordPress PHP catalogs require WordPress 6.5 or later. JSON requires an explicit domain; `--output` is a directory, defaulting to the PO directory. `--check` compares proposed bytes without writing and exits `2` on absent/stale outputs. Compiler commands are primitives and do not select configured packages."},"2077":{"id":"/js/wp-release/v0.20.0/internationalization-14","page_id":"/js/wp-release/v0.20.0/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/internationalization#compile-translated-catalogs","content":"A script map is a JSON object from normalized package-relative source references to arrays of normalized runtime script paths. Many source files can feed one bundle, and one source can feed several scripts. An explicit map selects only listed references; an empty target array excludes that source. Without a map, JS/MJS/CJS references use identity paths, while JSX/TypeScript references require mapping. PHP-only references do not enter JSON catalogs."},"2078":{"id":"/js/wp-release/v0.20.0/internationalization-15","page_id":"/js/wp-release/v0.20.0/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/internationalization#compile-translated-catalogs","content":"JSON filenames are `<domain>-<Language>-<md5(runtime-path)>.json`; the WordPress `default` domain uses `<Language>-<md5(runtime-path)>.json`. WordPress's `.min.js` normalization applies consistently to grouping, hashing and the JSON `source`. Jed keys preserve context through `\\u0004`, plural arrays contain all translated forms, and revision dates come from the PO metadata. `.l10n.php` writes safely escaped data arrays with NUL-separated plural translations; catalog text is never treated as executable PHP."},"2079":{"id":"/js/wp-release/v0.20.0/internationalization-16","page_id":"/js/wp-release/v0.20.0/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/internationalization#compile-translated-catalogs","content":"The extraction and compilation primitives are in the standalone `@wpelevator/wp-gettext` package, without the repository and release tooling, and `wp-release` depends on it. See its README to use them in your own scripts."},"2080":{"id":"/js/wp-release/v0.20.0/internationalization-17","page_id":"/js/wp-release/v0.20.0/internationalization","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/internationalization#compile-translated-catalogs","content":"The package can be installed and used in any WordPress plugin or theme project; repository package selection is optional, and directory mode works without a wp-release config."},"2081":{"id":"/js/wp-release/v0.20.0/library","page_id":"/js/wp-release/v0.20.0/library","type":"page","content":"Library API","breadcrumbs":["Docs","Js","Wp release","v0.20.0"],"tags":[],"url":"/js/wp-release/v0.20.0/library"},"2082":{"id":"/js/wp-release/v0.20.0/library-0","page_id":"/js/wp-release/v0.20.0/library","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0/library#exit-codes","content":"Exit codes"},"2083":{"id":"/js/wp-release/v0.20.0/library-1","page_id":"/js/wp-release/v0.20.0/library","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0/library#library","content":"Library"},"2084":{"id":"/js/wp-release/v0.20.0/library-2","page_id":"/js/wp-release/v0.20.0/library","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0/library#signing","content":"Signing"},"2085":{"id":"/js/wp-release/v0.20.0/library-3","page_id":"/js/wp-release/v0.20.0/library","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0/library#zip-archives","content":"ZIP archives"},"2086":{"id":"/js/wp-release/v0.20.0/library-4","page_id":"/js/wp-release/v0.20.0/library","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0/library#file-selection","content":"File selection"},"2087":{"id":"/js/wp-release/v0.20.0/library-5","page_id":"/js/wp-release/v0.20.0/library","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0/library#checksums","content":"Checksums"},"2088":{"id":"/js/wp-release/v0.20.0/library-6","page_id":"/js/wp-release/v0.20.0/library","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0/library#translations","content":"Translations"},"2089":{"id":"/js/wp-release/v0.20.0/library-7","page_id":"/js/wp-release/v0.20.0/library","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0/library#logging","content":"Logging"},"2090":{"id":"/js/wp-release/v0.20.0/library-8","page_id":"/js/wp-release/v0.20.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/library#exit-codes","content":"| Code | Meaning                               |\n| ---- | ------------------------------------- |\n| `0`  | Success, dry run, no changes, or help |","table":"table-0"},"2091":{"id":"/js/wp-release/v0.20.0/library-9","page_id":"/js/wp-release/v0.20.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/library#exit-codes","content":"| Code | Meaning                                                 |\n| ---- | ------------------------------------------------------- |\n| `1`  | Unexpected failure, such as a failed svn or git command |","table":"table-0"},"2092":{"id":"/js/wp-release/v0.20.0/library-10","page_id":"/js/wp-release/v0.20.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/library#exit-codes","content":"| Code | Meaning                                                                                                                                          |\n| ---- | ------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `2`  | Invalid options, failed release checks, an existing SVN tag, a Git tag that exists with another release, or files that don't match the checksums |","table":"table-0"},"2093":{"id":"/js/wp-release/v0.20.0/library-11","page_id":"/js/wp-release/v0.20.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/library#exit-codes","content":"| Code | Meaning                                                   |\n| ---- | --------------------------------------------------------- |\n| `3`  | Missing SVN credentials, or credentials that SVN rejected |","table":"table-0"},"2094":{"id":"/js/wp-release/v0.20.0/library-12","page_id":"/js/wp-release/v0.20.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/library#library","content":"`resolveDeployOptions()` applies the defaults and throws a `ValidationError` (with `exitCode` `2`) for invalid combinations. `SvnDeploy` exposes each step (`prepare()`, `checkVersions()`, `checkout()`, `sync()`, `commit()` and `cleanup()`) separately so CI wrappers can run and report them one by one; `run()` runs all of them, or nothing when there's nothing to write. `getPlan()` lists the planned SVN changes. The `Svn` class wraps the svn command line, and takes the command runner as a dependency so that tests can replace it."},"2095":{"id":"/js/wp-release/v0.20.0/library-13","page_id":"/js/wp-release/v0.20.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/library#library","content":"Git deploys:"},"2096":{"id":"/js/wp-release/v0.20.0/library-14","page_id":"/js/wp-release/v0.20.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/library#library","content":"`resolveGitDeployOptions()` throws a `ValidationError` without a repository URL or with an invalid branch or tag. `GitDeploy` exposes `createTree()`, `fetchPrevious()`, `createRelease()`, `isOutdated()`, `checkTag()`, `getRefsToPush()` and `push()` separately, like `SvnDeploy`, and takes a git command runner from `createGitRunner()` as a dependency. The result has `outdated` when the branch wasn't moved for older source history, the refs to write in `planned` and the refs that were pushed in `pushed`, which is empty in a dry run. `redactUrls()` hides the credentials in URLs."},"2097":{"id":"/js/wp-release/v0.20.0/library-15","page_id":"/js/wp-release/v0.20.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/library#library","content":"Changeset releases:"},"2098":{"id":"/js/wp-release/v0.20.0/library-16","page_id":"/js/wp-release/v0.20.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/library#library","content":"`ChangesetRelease` runs the `changeset-*` commands: `add()`, `getStatus()`, `version()` and `tag()`, plus `getPlan()`, `getPackages()` and `getConfiguredPackages()`. Each call reads the configuration, packages and pending changesets again, so one instance can version and then tag. `getConfiguredPackages()` returns package directories with their resolved release group metadata; `formatTag()` and `formatTemplate()` apply the same placeholders as the release workflows. It takes a git runner from `createGitRunner()` as `git`, so that tests can replace it. Without a config file, it detects a single root project. Its optional `singleProject` settings accept `versions` (the existing version descriptors), `versionFrom` (the same selector as `--version-from`), `baseBranch`, `remote`, `changesets`, `readmeChangelog` and `changelogInsertAfter`; `tagFormat` remains a repository option. The functions `addChangeset()`, `getChangesetStatus()`, `versionChangesets()`, `tagChangesets()`, `getChangesetReleasePlan()`, `getChangesetPackages()` and `getConfiguredPackages()` do the same with the default runners, in one call."},"2099":{"id":"/js/wp-release/v0.20.0/library-17","page_id":"/js/wp-release/v0.20.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/library#signing","content":"The Ed25519 key handling and the WordPress, minisign and OpenSSH signature formats live in the `@wpelevator/signatures` package, which `@wpelevator/wp-release` depends on. It still re-exports the signing functions that it has always exported; the bytes-first functions and error guards are only in `@wpelevator/signatures`. The wp-release functions read the key from `WP_RELEASE_SIGNING_KEY` and report invalid input as a `ValidationError` with the original error as its `cause`; the `@wpelevator/signatures` functions use `SIGNING_KEY` by default and throw a `SigningError`."},"2100":{"id":"/js/wp-release/v0.20.0/library-18","page_id":"/js/wp-release/v0.20.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/library#zip-archives","content":"Reproducible archives and safe extraction live in the `@wpelevator/zip` package, which `@wpelevator/wp-release` depends on. It still exports `createZip()`, `readZipEntries()`, `getZipEntryErrors()`, `extractZip()`, `ZIP_MTIME` and `ZIP_FILE_MODE` with their `sourceDir`, `files` and `zipPath` inputs, and reports invalid input as a `ValidationError` with the original error as its `cause`. The zip package takes a list of `{ source, name }` entries, where the source is a file path or bytes, and can create and read archives in memory. Entries have the fixed `ZIP_MTIME`, or the `SOURCE_DATE_EPOCH` time when that environment variable is set."},"2101":{"id":"/js/wp-release/v0.20.0/library-19","page_id":"/js/wp-release/v0.20.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/library#file-selection","content":"Gitignore-style file selection and directory syncing live in the `@wpelevator/fileset` package, which `@wpelevator/wp-release` depends on. It still exports `resolveFileSelection()`, `loadFileRules()`, `selectFiles()`, `parseExclude()`, `syncDirectory()` and `copyFileIfChanged()` with the same inputs, and reports invalid input as a `ValidationError` with the original error as its `cause`. The fileset package has no Git dependency: it takes a function that lists more files to exclude, `listExcluded`, and `@wpelevator/wp-release` passes one that reads the `export-ignore` attribute with Git when `excludeGitattributes` is set. The ignore file name (`.distignore` by default) and the directories that a sync leaves alone (`.svn` by default) are options of the fileset package."},"2102":{"id":"/js/wp-release/v0.20.0/library-20","page_id":"/js/wp-release/v0.20.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/library#checksums","content":"Hashing, the checksums manifest formats and their comparison live in the `@wpelevator/checksums` package, which `@wpelevator/wp-release` depends on. It still exports `createChecksums()`, `writeChecksums()`, `readChecksums()`, `parseChecksums()`, `verifyChecksums()`, `compareChecksums()`, `hashFile()`, `hashFiles()` and the `wordpressCodec` and `sha256sumCodec` codecs with the same inputs and output, and reports invalid input as a `ValidationError` with the original error as its `cause`. The checksums package takes a plain list of file paths instead of file rules, hashes bytes and streams with `hashBytes()` and `hashStream()`, and keeps the plugin or theme slug and version as generic `metadata` next to the `files`, which `@wpelevator/wp-release` fills in. Manifests are written byte for byte as before."},"2103":{"id":"/js/wp-release/v0.20.0/library-21","page_id":"/js/wp-release/v0.20.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/library#translations","content":"Extracting translatable strings from PHP, JavaScript and `block.json` sources, building catalogs, writing POT files, compiling PO files to MO, script JSON and `.l10n.php`, and auditing live in the `@wpelevator/wp-gettext` package, which `@wpelevator/wp-release` depends on. It still exports the same functions, like `extractCatalog()`, `generatePackagePot()`, `serializePot()`, `parseTranslatedPo()` and `compileTranslations()`, with the same inputs and output, and reports invalid input as a `ValidationError` with the original error as its `cause`. The wp-gettext package doesn't read plugin and theme headers: it takes the header details as a `meta` input, which `@wpelevator/wp-release` reads from the main file with its own package metadata reader. `resolveI18nPackages()`, which selects the configured packages, stays in `@wpelevator/wp-release`. Importing the main entry of `@wpelevator/wp-gettext` doesn't load the PHP and JavaScript parsers, which are in the `/php` and `/javascript` sub-paths."},"2104":{"id":"/js/wp-release/v0.20.0/library-22","page_id":"/js/wp-release/v0.20.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/library#logging","content":"`Logger` filters messages by level and passes them to a writer, like the transports of other Node.js loggers. The writer decides how messages look:"},"2105":{"id":"/js/wp-release/v0.20.0/library-23","page_id":"/js/wp-release/v0.20.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/library#logging","content":"`TextWriter` prints plain text to `stdout` and `stderr`. It's the default."},"2106":{"id":"/js/wp-release/v0.20.0/library-24","page_id":"/js/wp-release/v0.20.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/library#logging","content":"`GitHubActionsWriter` prints workflow commands, so that notices, warnings and errors with a file are annotations, and appends summaries to `GITHUB_STEP_SUMMARY`. It's the CLI's `github` log format, and the GitHub Actions pass it to their logger. Its `workspace` and `summaryPath` options default to `GITHUB_WORKSPACE` and `GITHUB_STEP_SUMMARY`."},"2107":{"id":"/js/wp-release/v0.20.0/library-25","page_id":"/js/wp-release/v0.20.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/library#logging","content":"A writer implements `LogWriter` with `write()`, `startGroup()`, `endGroup()` and `summary()`, so other CI systems can have their own format. `summary()` takes a function that builds the Markdown, which only writers with a summary call."},"2108":{"id":"/js/wp-release/v0.20.0/library-26","page_id":"/js/wp-release/v0.20.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/library#logging","content":"A `ValidationError` can list `problems`, each with a `message` and an optional `file`, `line` and `title`. `logError( logger, error, title )` logs each problem as an error on its file and line and lists them in the summary under the title, or logs the message when there are none. `VersionMismatchError` and `version-check` report the version mismatches this way."},"2109":{"id":"/js/wp-release/v0.20.0/library-27","page_id":"/js/wp-release/v0.20.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/library#logging","content":"ZIP files and metadata:"},"2110":{"id":"/js/wp-release/v0.20.0/library-28","page_id":"/js/wp-release/v0.20.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/library#logging","content":"Checksums:"},"2111":{"id":"/js/wp-release/v0.20.0/library-29","page_id":"/js/wp-release/v0.20.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/library#logging","content":"`loadFileRules()` reads the ignore file and `--exclude` patterns into a gitignore matcher, optionally adds Git `export-ignore` paths, and `selectFiles()` lists the files it doesn't ignore. `compareChecksums()` compares two hash maps without reading any files, and `parseChecksums()` validates manifest JSON. `extractZip()` extracts a ZIP after the same checks as `deploy-svn --from-zip`."},"2112":{"id":"/js/wp-release/v0.20.0/library-30","page_id":"/js/wp-release/v0.20.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/library#logging","content":"Translations:"},"2113":{"id":"/js/wp-release/v0.20.0/library-31","page_id":"/js/wp-release/v0.20.0/library","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/library#logging","content":"The parsers, catalog and compiler functions are provided by `@wpelevator/wp-gettext`. Parsers return messages and structured diagnostics with stable codes, severity and source-relative locations. Catalog messages retain IDs, contexts, plurals, translations, translator comments, flags and structured references. `aggregateCatalog()` selects/merges a domain, unions references/comments and diagnoses plural conflicts. `resolveI18nPackages()` is the separate config adapter; extraction and serialization primitives know nothing about the repository. Library functions do not log, parse process arguments or set exit codes. Extraction results report unique files consulted, including the main plugin/theme file used for headers and header strings even when source globs exclude it. `parseTranslatedPo()`, `compileMo()`, `compileScriptTranslations()`, `compilePhpTranslations()` and `compileTranslations()` expose the same typed operations to library callers."},"2114":{"id":"/js/wp-release/v0.20.0/packaging","page_id":"/js/wp-release/v0.20.0/packaging","type":"page","content":"Packaging and integrity","breadcrumbs":["Docs","Js","Wp release","v0.20.0"],"tags":[],"url":"/js/wp-release/v0.20.0/packaging"},"2115":{"id":"/js/wp-release/v0.20.0/packaging-0","page_id":"/js/wp-release/v0.20.0/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0/packaging#build-a-directory","content":"Build a directory"},"2116":{"id":"/js/wp-release/v0.20.0/packaging-1","page_id":"/js/wp-release/v0.20.0/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0/packaging#zip","content":"ZIP"},"2117":{"id":"/js/wp-release/v0.20.0/packaging-2","page_id":"/js/wp-release/v0.20.0/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0/packaging#signing-targets-for-builds-and-zips","content":"Signing targets for builds and ZIPs"},"2118":{"id":"/js/wp-release/v0.20.0/packaging-3","page_id":"/js/wp-release/v0.20.0/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0/packaging#checksums","content":"Checksums"},"2119":{"id":"/js/wp-release/v0.20.0/packaging-4","page_id":"/js/wp-release/v0.20.0/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0/packaging#filenames-embedding-and-signing","content":"Filenames, embedding and signing"},"2120":{"id":"/js/wp-release/v0.20.0/packaging-5","page_id":"/js/wp-release/v0.20.0/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0/packaging#formats","content":"Formats"},"2121":{"id":"/js/wp-release/v0.20.0/packaging-6","page_id":"/js/wp-release/v0.20.0/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0/packaging#configuration-and-custom-codecs","content":"Configuration and custom codecs"},"2122":{"id":"/js/wp-release/v0.20.0/packaging-7","page_id":"/js/wp-release/v0.20.0/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0/packaging#manifest-inside-the-plugin","content":"Manifest inside the plugin"},"2123":{"id":"/js/wp-release/v0.20.0/packaging-8","page_id":"/js/wp-release/v0.20.0/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0/packaging#verify","content":"Verify"},"2124":{"id":"/js/wp-release/v0.20.0/packaging-9","page_id":"/js/wp-release/v0.20.0/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0/packaging#sign","content":"Sign"},"2125":{"id":"/js/wp-release/v0.20.0/packaging-10","page_id":"/js/wp-release/v0.20.0/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0/packaging#signature-formats","content":"Signature formats"},"2126":{"id":"/js/wp-release/v0.20.0/packaging-11","page_id":"/js/wp-release/v0.20.0/packaging","type":"heading","tags":[],"url":"/js/wp-release/v0.20.0/packaging#version-check","content":"Version check"},"2127":{"id":"/js/wp-release/v0.20.0/packaging-12","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#build-a-directory","content":"`build` and `zip` use the same internal helper to load file rules, exclude their outputs, select release files and reject an empty selection. `build` copies the selected files directly into `--output <dir>`, without a slug wrapper or ZIP. Checksums and manifest signatures are optional. It supports the shared file selection flags above and `--package <name>` with `--config <path>` for configured package rules. A configured package cannot be combined with a source directory or file selection flags."},"2128":{"id":"/js/wp-release/v0.20.0/packaging-13","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#build-a-directory","content":"The destination is required and automatically excluded when it is inside the source. It cannot be the source directory or an ancestor, including through symlinked parents. Existing destinations require `--force`, which replaces the directory and removes stale files; existing files and symbolic links are rejected. Files are copied to a temporary directory before the existing build is replaced. Selected symbolic links are rejected as with ZIP packaging. `--json` returns `outputDir`, `files` and, for configured builds, `package`; it also returns `checksumsPath` when a manifest is generated, and `signatures` and `publicKey` when signing is requested. `--github-output` exposes these results too."},"2129":{"id":"/js/wp-release/v0.20.0/packaging-14","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#build-a-directory","content":"`--checksums` writes `<output-dir>.checksums.json` beside the directory and hashes the copied build files. `--sign-checksums` generates and signs that manifest, implying `--checksums`. Use `--slug` and `--version` to override its metadata. The manifest and its signatures are excluded from the source selection, so rebuilding with `--force` does not package previous sidecars. Existing manifests and requested signature files also require `--force`; signing keys, formats and signature destinations are validated before creating or replacing the build. `--sign` is unsupported because a directory has no single file to sign."},"2130":{"id":"/js/wp-release/v0.20.0/packaging-15","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#build-a-directory","content":"In the Deploy workflow, a directory build can be deployed with `wp-release deploy-svn dist/code-prettify --slug code-prettify --trunk --svn-tag \"$GITHUB_REF_NAME\" --no-distignore`. Keep `--from-zip` when the SVN deployment must match the attached ZIP exactly. Run dependency installation and compilation before `build`; it only selects and copies files."},"2131":{"id":"/js/wp-release/v0.20.0/packaging-16","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#zip","content":"The `wp-release-zip` GitHub Action runs this command."},"2132":{"id":"/js/wp-release/v0.20.0/packaging-17","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#zip","content":"`zip` writes `{slug}.{version}.zip` to the current directory, or to `--output <file>`, with the selected files in a `{slug}/` root folder:"},"2133":{"id":"/js/wp-release/v0.20.0/packaging-18","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#zip","content":"`--root-folder <name>` changes the root folder and `--no-root-folder` puts the files at the root of the ZIP."},"2134":{"id":"/js/wp-release/v0.20.0/packaging-19","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#zip","content":"`--filename-format` changes the name, like `--filename-format {slug}` for `my-plugin.zip`."},"2135":{"id":"/js/wp-release/v0.20.0/packaging-20","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#zip","content":"Entries are sorted and use a fixed file mode and a fixed timestamp (1980-01-01), or the `SOURCE_DATE_EPOCH` Unix time when that environment variable is set, so the same files give the same ZIP. Built-in metadata is deterministic except for embedded minisign signatures, which include their signing timestamp; custom codec callbacks control their own encoded bytes."},"2136":{"id":"/js/wp-release/v0.20.0/packaging-21","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#zip","content":"`--checksums` also writes the checksums manifest of the archived files next to the ZIP, with `.checksums.json` instead of `.zip`."},"2137":{"id":"/js/wp-release/v0.20.0/packaging-22","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#zip","content":"`--sign` signs only the ZIP with `WP_RELEASE_SIGNING_KEY`. `--sign-checksums` generates and signs only the checksums manifest, implying `--checksums`. Use both flags to sign both files. External signatures are written alongside their files; embedded manifest signatures are written inside the package. The default format is WordPress `.sig`, unless integrity configuration selects another format."},"2138":{"id":"/js/wp-release/v0.20.0/packaging-23","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#zip","content":"`--sign-format` selects formats for requested signatures, such as `--sign-format wordpress,minisign,ssh`. It requires `--sign` or `--sign-checksums` and never enables signing by itself. Signing keys, formats and existing signature destinations are validated before writing the ZIP or manifest. `--force` also overwrites requested signatures. Job summaries include signatures and public keys; JSON results include `signatures` and `publicKey`."},"2139":{"id":"/js/wp-release/v0.20.0/packaging-24","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#zip","content":"An existing ZIP or manifest isn't overwritten without `--force`. A ZIP or manifest written inside the source directory is never archived."},"2140":{"id":"/js/wp-release/v0.20.0/packaging-25","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#zip","content":"`--package <name>` zips a package of the configured packages, by identifier or path under the configured root like `plugins/alpha`, instead of a source directory: its directory with the `files` config of its package group, the same files that its deploys select. The slug defaults to the directory name and the version to the `Version` header, and `--slug` and `--version` still set them. Any package of the config works, with or without a version or deploy targets. To zip what a deploy just released, pass the `package` and `version` of the `deploy-git --release-ref` result, in the same job and from the same build, so the ZIP has exactly the files of the release tag in the release repository. It can't be combined with `<source-dir>` or the file selection options. The `--json` result has the `package`, `slug` and `version`. `zipPackage()` builds the same ZIP from a script, with `getPackageFiles()` for the directory and the files of a package."},"2141":{"id":"/js/wp-release/v0.20.0/packaging-26","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#zip","content":"To embed a signed manifest with a stable filename, use:"},"2142":{"id":"/js/wp-release/v0.20.0/packaging-27","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#zip","content":"See Checksums for filenames, placement, formats and configuration."},"2143":{"id":"/js/wp-release/v0.20.0/packaging-28","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#signing-targets-for-builds-and-zips","content":"| Flag          | `zip`                                         | `build`                                             |\n| ------------- | --------------------------------------------- | --------------------------------------------------- |\n| `--checksums` | Generate an unsigned manifest beside the ZIP. | Generate an unsigned manifest beside the directory. |","table":"table-0"},"2144":{"id":"/js/wp-release/v0.20.0/packaging-29","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#signing-targets-for-builds-and-zips","content":"| Flag     | `zip`              | `build`      |\n| -------- | ------------------ | ------------ |\n| `--sign` | Sign only the ZIP. | Unsupported. |","table":"table-0"},"2145":{"id":"/js/wp-release/v0.20.0/packaging-30","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#signing-targets-for-builds-and-zips","content":"| Flag               | `zip`                           | `build`                         |\n| ------------------ | ------------------------------- | ------------------------------- |\n| `--sign-checksums` | Generate and sign the manifest. | Generate and sign the manifest. |","table":"table-0"},"2146":{"id":"/js/wp-release/v0.20.0/packaging-31","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#signing-targets-for-builds-and-zips","content":"| Flag            | `zip`                                               | `build`                            |\n| --------------- | --------------------------------------------------- | ---------------------------------- |\n| `--sign-format` | Choose formats for explicitly requested signatures. | Same; requires `--sign-checksums`. |","table":"table-0"},"2147":{"id":"/js/wp-release/v0.20.0/packaging-32","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#signing-targets-for-builds-and-zips","content":"These flags deliberately replace the former implicit signing behavior: `zip --checksums --sign` now leaves the manifest unsigned, and `--sign-format` alone is rejected. Add `--sign-checksums` to sign a manifest and `--sign` to sign a ZIP. The standalone `checksums` and `sign` commands remain available for workflows that write and sign a manifest inside the source before packaging it."},"2148":{"id":"/js/wp-release/v0.20.0/packaging-33","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#checksums","content":"The `wp-release-checksums` GitHub Action runs this command."},"2149":{"id":"/js/wp-release/v0.20.0/packaging-34","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#checksums","content":"`checksums` writes a manifest with the MD5 and SHA-256 hash of every selected file, in the format of the WordPress.org plugin checksums API (`https://downloads.wordpress.org/plugin-checksums/{slug}/{version}.json`). Paths are relative to the plugin or theme folder, sorted, and use forward slashes:"},"2150":{"id":"/js/wp-release/v0.20.0/packaging-35","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#checksums","content":"Themes use a `theme` key instead of `plugin`, and the version is left out when it's unknown. The manifest is named `{slug}.{version}.checksums.json` after `--filename-format`, the same name as the ZIP with `.checksums.json` instead of `.zip`, so the two are published side by side; `--output <file>` writes it elsewhere. A manifest written inside `<source-dir>` is never listed in itself."},"2151":{"id":"/js/wp-release/v0.20.0/packaging-36","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#checksums","content":"Because the manifest lists the files and not the ZIP, it stays valid for any copy of the same files: the GitHub release ZIP, the ZIP that WordPress.org builds from SVN, or an installed plugin on a site."},"2152":{"id":"/js/wp-release/v0.20.0/packaging-37","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#filenames-embedding-and-signing","content":"`--checksums-file <file>` enables checksums and sets a relative filename independently of the ZIP name. Without `--embed-checksums`, it resolves against the ZIP output directory; with embedding, it resolves against the package root inside the ZIP (the archive root with `--no-root-folder`). Nested paths are supported, but absolute paths, backslashes, drive letters, control characters and dot segments are rejected. Embedding emits no external manifest and never modifies the source directory. Embedded minisign signatures contain a signing timestamp, so ZIP bytes can differ across signing times; unsigned metadata and WordPress/SSH signatures remain deterministic. Selected source files must not collide with generated manifest or signature entries."},"2153":{"id":"/js/wp-release/v0.20.0/packaging-38","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#filenames-embedding-and-signing","content":"`--sign-checksums` enables checksums and signs only the manifest, before embedding when requested. It reads `WP_RELEASE_SIGNING_KEY` and uses `--sign-format wordpress,minisign,ssh` to select formats; each signature travels with the manifest. `--sign-format` selects formats for explicitly requested signing targets and never enables signing. `--sign` signs only the final ZIP; `--sign-checksums` controls the manifest in either placement mode. Use both flags to sign both targets. `--force` permits replacing external output files and signatures. `--json` reports external manifests in `checksumsPath`, embedded package-relative paths in `checksumsEmbedded`, and manifest signatures in `checksumsSignatures`."},"2154":{"id":"/js/wp-release/v0.20.0/packaging-39","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#filenames-embedding-and-signing","content":"The default WordPress filename remains the ZIP basename with `.checksums.json` instead of `.zip`, in either placement mode. Choose `--checksums-file checksums.json` for a stable name. The version remains in the JSON content."},"2155":{"id":"/js/wp-release/v0.20.0/packaging-40","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#formats","content":"`--checksums-format` chooses the manifest format. `wordpress-json` (default) uses the WordPress-compatible structure shown above. `sha256sum` uses GNU-compatible SHA-256 lines and escaping, with `SHA256SUMS` as its default filename. It carries no package identity or version, and standard `sha256sum --check` checks listed files without rejecting additional files; `wp-release verify` also checks for extra files."},"2156":{"id":"/js/wp-release/v0.20.0/packaging-41","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#formats","content":"`--checksums-algorithms md5,sha256` selects JSON digest fields; lists replace configured lists. Supported algorithms are MD5 (for compatibility) and SHA-256. The `sha256sum` codec requires SHA-256. The standalone `checksums` command also accepts `--checksums-format`, keeping `--output` relative to the working directory."},"2157":{"id":"/js/wp-release/v0.20.0/packaging-42","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#configuration-and-custom-codecs","content":"The optional top-level `integrity` configuration maps to these flags. Explicit CLI values override configuration; `--no-embed-checksums` and `--no-sign-checksums` disable their configured behaviors. Existing release configurations retain their `packages` array; use `packages: []` for a configuration containing only integrity settings."},"2158":{"id":"/js/wp-release/v0.20.0/packaging-43","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#configuration-and-custom-codecs","content":"Use `codec: 'sha256sum'`, `algorithms: ['sha256']`, `file: 'SHA256SUMS'` and `sign: { formats: ['minisign'] }` for the GNU setup. Custom codecs provide `id`, a default `filename`, and `encode`/`decode` callbacks, which may be asynchronous. Generation validates the round trip before writing artifacts: codecs must preserve all selected file paths, represented digests and any represented package identity. They receive and return the existing WordPress-compatible `ChecksumsManifest` model (`plugin` or `theme`, optional `version`, and a `files` map of relative paths to digest fields), keeping format customization separate from selection, hashing and signing."},"2159":{"id":"/js/wp-release/v0.20.0/packaging-44","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#configuration-and-custom-codecs","content":"`zip` and `checksums` read the caller's release configuration. For verification of custom codecs or configured filenames, pass `--config wp-release.config.mjs` explicitly. See Verify."},"2160":{"id":"/js/wp-release/v0.20.0/packaging-45","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#manifest-inside-the-plugin","content":"For a manifest that is also published as a separate release asset or deployed directly from a source directory, write and sign it in that directory before packaging. Use `zip --embed-checksums` as described above when only the archive should contain the generated metadata. The source-directory workflow uses the same manifest for installed copies and release assets:"},"2161":{"id":"/js/wp-release/v0.20.0/packaging-46","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#manifest-inside-the-plugin","content":"Write the manifest into the directory that is zipped and deployed. The `checksums` command leaves its output manifest and its signatures (`<name>.sig`, `<name>.minisig` and `<name>.sshsig`) out of the hashes, so running it again with the same output path and `--force` gives the same manifest. `verify` checks matching copies as described below. Sign it last, since the signature covers the exact bytes of the manifest."},"2162":{"id":"/js/wp-release/v0.20.0/packaging-47","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#manifest-inside-the-plugin","content":"`zip` and `deploy-svn` carry the pair like any other file. Don't use `zip --checksums` here, since it would write a second manifest that lists the first one. Attach `build/checksums.json` and `build/checksums.json.sig` to the GitHub release as they are."},"2163":{"id":"/js/wp-release/v0.20.0/packaging-48","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#manifest-inside-the-plugin","content":"The signature covers file hashes and not a ZIP, so it stays valid for the ZIP that WordPress.org builds from SVN. Check what WordPress.org serves after a deploy, with the manifest and public key from your build:"},"2164":{"id":"/js/wp-release/v0.20.0/packaging-49","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#manifest-inside-the-plugin","content":"The manifest can have any name and location, for example `--output build/includes/signatures/checksums.json`, and missing folders are created. Tell `verify` where the shipped copy is with `--embedded <path>`, like `--embedded includes/signatures/checksums.json`. Both the `--checksums` file and its signature must then exist, both copies must be shipped, and they're skipped when comparing files and must be identical to the originals. The manifest can't list the embedded path. Without `--embedded`, `verify` looks for the manifest name at the root, and skips a file only when it exists, the matching original exists and the manifest doesn't list it. Otherwise it's checked like any other file, so a listed file that has the name of the manifest can't be deleted unnoticed, and a shipped `.sig` without an original is reported as not in the checksums."},"2165":{"id":"/js/wp-release/v0.20.0/packaging-50","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#manifest-inside-the-plugin","content":"The public key has to come from somewhere other than the plugin that it checks, because someone who can overwrite the plugin files can also replace a key and a signature inside them. A copy of the manifest also doesn't prevent a downgrade to an older release that was signed too, so the installing side has to enforce a minimum version."},"2166":{"id":"/js/wp-release/v0.20.0/packaging-51","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#verify","content":"`verify` checks a directory against a manifest from `checksums` or from the WordPress.org checksums API, and reports every changed, missing and extra file. It exits with `2` unless all files match:"},"2167":{"id":"/js/wp-release/v0.20.0/packaging-52","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#verify","content":"A file matches when its SHA-256 equals the manifest. Manifests without SHA-256 fall back to MD5, and a hash can also be a list of accepted values."},"2168":{"id":"/js/wp-release/v0.20.0/packaging-53","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#verify","content":"`verify` doesn't read `.distignore`, so that an ignore file inside the checked directory can't hide added files. `--exclude <patterns>` skips paths in both the directory and the manifest, for files that aren't part of the release, such as caches."},"2169":{"id":"/js/wp-release/v0.20.0/packaging-54","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#verify","content":"Manifest paths outside the package folder (absolute or with `..`) are rejected."},"2170":{"id":"/js/wp-release/v0.20.0/packaging-55","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#verify","content":"`--zip <file|url>` checks the files of a ZIP instead of a directory. The ZIP can be a URL, such as the one that WordPress.org builds for a release, and its single root folder is found automatically (or set `--root-folder`). The ZIP is extracted to a temporary directory after the same safety checks as `deploy-svn --from-zip`."},"2171":{"id":"/js/wp-release/v0.20.0/packaging-56","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#verify","content":"The version in the manifest must match the `Version` header of the checked files, so that an older release with its own valid manifest can't pass as a newer one."},"2172":{"id":"/js/wp-release/v0.20.0/packaging-57","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#verify","content":"A manifest can't list itself. A copy of the manifest and of its signature inside the checked files, at the root with the same names as the `--checksums` file or at the path of `--embedded`, is skipped when comparing files, but it must be identical to the `--checksums` file and its signature. The signature is the `.sig` file, or the file of `--signature-format`. A path that the manifest lists is never skipped, and a file that isn't a matching copy is reported as not in the checksums. See Manifest inside the plugin."},"2173":{"id":"/js/wp-release/v0.20.0/packaging-58","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#verify","content":"A checksums manifest proves only that the files match the manifest. With `--public-key <key>`, `verify` first checks `<checksums>.sig` against the Ed25519 public key and fails with exit code `2` before comparing any file when the signature is missing or invalid, so that the manifest itself can be trusted. `--signature-format minisign` or `ssh` checks `<checksums>.minisig` or `<checksums>.sshsig` instead. The key can be the base64 key, the minisign public key or the `ssh-ed25519` public key, since they're forms of the same key. See Sign."},"2174":{"id":"/js/wp-release/v0.20.0/packaging-59","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#verify","content":"Verification never executes configuration from inside a downloaded package. Without `--checksums`, `verify` reads the embedded filename selected by `--checksums-file`, explicit configuration, or the codec default. For a versioned embedded filename, pass that filename explicitly. With a public key, signatures are checked before decoding; the selected signature format must exist (WordPress `.sig` by default; pass `--signature-format minisign` or `ssh` for those formats), and all other present supported signature formats are also authenticated when verifying the embedded manifest. Without a public key, checksums detect changes but do not authenticate the publisher. Trusted public keys must come from outside the package."},"2175":{"id":"/js/wp-release/v0.20.0/packaging-60","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#sign","content":"The `wp-release-sign` GitHub Action runs this command."},"2176":{"id":"/js/wp-release/v0.20.0/packaging-61","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#sign","content":"`sign` writes a detached signature next to each file, `<file>.sig`, so that downloads and installed copies can be trusted. Sign both the ZIP and the checksums manifest: the ZIP signature covers installs and updates, and the manifest signature covers the contents after unpacking and copies that weren't built by you."},"2177":{"id":"/js/wp-release/v0.20.0/packaging-62","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#sign","content":"The signature is the one WordPress core's `verify_file_signature()` checks: a base64 Ed25519 signature of the raw SHA-384 digest of the file. The tests check it against `sodium_crypto_sign_verify_detached()` in PHP. A `.sig` file can hold several signatures, one per line, and a file is valid when any of them match, which allows a key rotation window."},"2178":{"id":"/js/wp-release/v0.20.0/packaging-63","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#sign","content":"The key is read from the `WP_RELEASE_SIGNING_KEY` environment variable only, as a base64 32-byte Ed25519 seed or a 64-byte libsodium secret key, the formats that `sodium_crypto_sign_seed_keypair()` and the update-pilot-server package signing key take. There's no flag for it, since it would show in the process list, and it's never logged."},"2179":{"id":"/js/wp-release/v0.20.0/packaging-64","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#sign","content":"`--verbose` prints the public key of the signing key in the form of each written format. `--json` returns it as `publicKey`, and in every form as `publicKeys`. Pass it to `verify --public-key` and to the plugin that checks the signatures."},"2180":{"id":"/js/wp-release/v0.20.0/packaging-65","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#sign","content":"An existing signature file isn't overwritten without `--force`."},"2181":{"id":"/js/wp-release/v0.20.0/packaging-66","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#sign","content":"`zip --sign` signs only the ZIP; add `--sign-checksums` to sign its manifest too. `signFiles()` signs files from a script."},"2182":{"id":"/js/wp-release/v0.20.0/packaging-67","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#signature-formats","content":"The same key can also sign in formats that tools outside WordPress check, for people who download a release by hand or verify it in other pipelines. Pick them with `--format`, comma-separated or repeated; the default is `wordpress`:"},"2183":{"id":"/js/wp-release/v0.20.0/packaging-68","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#signature-formats","content":"| Format      | File         | Checked by                                                                        |\n| ----------- | ------------ | --------------------------------------------------------------------------------- |\n| `wordpress` | `<file>.sig` | WordPress core's `verify_file_signature()`, update-client and `wp-release verify` |","table":"table-1"},"2184":{"id":"/js/wp-release/v0.20.0/packaging-69","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#signature-formats","content":"| Format     | File             | Checked by                                                                    |\n| ---------- | ---------------- | ----------------------------------------------------------------------------- |\n| `minisign` | `<file>.minisig` | minisign and compatible tools: `minisign -Vm <file> -P <minisign public key>` |","table":"table-1"},"2185":{"id":"/js/wp-release/v0.20.0/packaging-70","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#signature-formats","content":"| Format | File            | Checked by                                                                                                      |\n| ------ | --------------- | --------------------------------------------------------------------------------------------------------------- |\n| `ssh`  | `<file>.sshsig` | OpenSSH 8.1 or later: `ssh-keygen -Y verify -f allowed_signers -I <identity> -n file -s <file>.sshsig < <file>` |","table":"table-1"},"2186":{"id":"/js/wp-release/v0.20.0/packaging-71","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#signature-formats","content":"`minisign` signs the BLAKE2b-512 digest of the file, like `minisign -S` does by default, and adds a trusted comment with the signing time and file name that a second signature covers. minisign generates a random key ID for its keys, but the key here is a plain Ed25519 seed, so wp-release derives the key ID from the public key. `wp-release verify` doesn't compare key IDs, so signatures of keys that minisign generated verify too."},"2187":{"id":"/js/wp-release/v0.20.0/packaging-72","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#signature-formats","content":"`ssh` is the armored `SSHSIG` format that `ssh-keygen -Y sign` writes, with a SHA-512 digest and the `file` namespace, so that the signature can't pass as one for commits or another namespace. It's written to `.sshsig` instead of the `.sig` of `ssh-keygen`, which the `wordpress` format uses. Put the SSH public key in an `allowed_signers` file as `<identity> ssh-ed25519 AAAA…`."},"2188":{"id":"/js/wp-release/v0.20.0/packaging-73","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#signature-formats","content":"All formats are Ed25519 signatures by the same key, so one key and one secret cover all of them. The tests check each format with `minisign`, `ssh-keygen` and libsodium, and check the signatures that `minisign` and `ssh-keygen` write with `wp-release verify`."},"2189":{"id":"/js/wp-release/v0.20.0/packaging-74","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#signature-formats","content":"Generate a key pair with `wp-release keygen`. It prints the private seed once as `WP_RELEASE_SIGNING_KEY=…` and the matching public key, also as a minisign public key and an `ssh-ed25519` public key. Generate keys locally and store the private seed in your secret manager or CI secrets. Distribute the public key to verifiers. `keygen --github-output` is rejected to keep the private seed out of workflow outputs; regular and `--json` output both include the seed."},"2190":{"id":"/js/wp-release/v0.20.0/packaging-75","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#version-check","content":"`version-check` compares the versions that have to agree before a release, and reports every mismatch with exit code `2`:"},"2191":{"id":"/js/wp-release/v0.20.0/packaging-76","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#version-check","content":"The expected version is `--version`, or the `Version` header."},"2192":{"id":"/js/wp-release/v0.20.0/packaging-77","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#version-check","content":"The readme `Stable tag` must match for plugins; `--no-stable-tag` skips it, and themes have no Stable tag."},"2193":{"id":"/js/wp-release/v0.20.0/packaging-78","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#version-check","content":"`--constant NAME` (repeatable) checks `define( 'NAME', '1.2.0' )` or `const NAME = '1.2.0'` in every PHP file outside `vendor/`, `node_modules/` and dot directories. A constant that isn't defined is a mismatch."},"2194":{"id":"/js/wp-release/v0.20.0/packaging-79","page_id":"/js/wp-release/v0.20.0/packaging","tags":[],"type":"text","url":"/js/wp-release/v0.20.0/packaging#version-check","content":"`--git-tag` defaults to `GITHUB_REF` when it's a tag. `--git-tag-format` (default `{version}`) can have a prefix or the slug, like `v{version}` or `{slug}-{version}`; a leading `v` in the version is ignored, like for SVN tags."},"2195":{"id":"/php/php-changesets/latest/cli","page_id":"/php/php-changesets/latest/cli","type":"page","content":"Command line","breadcrumbs":["Docs","Php","Php changesets","Latest"],"tags":[],"url":"/php/php-changesets/latest/cli"},"2196":{"id":"/php/php-changesets/latest/cli-0","page_id":"/php/php-changesets/latest/cli","type":"heading","tags":[],"url":"/php/php-changesets/latest/cli#commands","content":"Commands"},"2197":{"id":"/php/php-changesets/latest/cli-1","page_id":"/php/php-changesets/latest/cli","type":"heading","tags":[],"url":"/php/php-changesets/latest/cli#add-a-changeset","content":"Add a changeset"},"2198":{"id":"/php/php-changesets/latest/cli-2","page_id":"/php/php-changesets/latest/cli","type":"heading","tags":[],"url":"/php/php-changesets/latest/cli#check-pull-requests-for-changesets","content":"Check pull requests for changesets"},"2199":{"id":"/php/php-changesets/latest/cli-3","page_id":"/php/php-changesets/latest/cli","type":"heading","tags":[],"url":"/php/php-changesets/latest/cli#preview-and-apply-a-release","content":"Preview and apply a release"},"2200":{"id":"/php/php-changesets/latest/cli-4","page_id":"/php/php-changesets/latest/cli","type":"heading","tags":[],"url":"/php/php-changesets/latest/cli#version-some-packages","content":"Version some packages"},"2201":{"id":"/php/php-changesets/latest/cli-5","page_id":"/php/php-changesets/latest/cli","type":"heading","tags":[],"url":"/php/php-changesets/latest/cli#tags-and-release-notes","content":"Tags and release notes"},"2202":{"id":"/php/php-changesets/latest/cli-6","page_id":"/php/php-changesets/latest/cli","type":"heading","tags":[],"url":"/php/php-changesets/latest/cli#pre-releases","content":"Pre-releases"},"2203":{"id":"/php/php-changesets/latest/cli-7","page_id":"/php/php-changesets/latest/cli","type":"heading","tags":[],"url":"/php/php-changesets/latest/cli#github-actions-output","content":"GitHub Actions output"},"2204":{"id":"/php/php-changesets/latest/cli-8","page_id":"/php/php-changesets/latest/cli","type":"heading","tags":[],"url":"/php/php-changesets/latest/cli#annotations-and-job-summaries","content":"Annotations and job summaries"},"2205":{"id":"/php/php-changesets/latest/cli-9","page_id":"/php/php-changesets/latest/cli","type":"heading","tags":[],"url":"/php/php-changesets/latest/cli#exit-codes","content":"Exit codes"},"2206":{"id":"/php/php-changesets/latest/cli-10","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#commands","content":"Run commands from the project root, or pass `--root DIRECTORY`."},"2207":{"id":"/php/php-changesets/latest/cli-11","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#commands","content":"| Command          | Purpose and options                                                                                                                                                                                                                                                                                                                                                                                                                                |\n| ---------------- | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `changeset init` | Create the changeset directory and, when no config exists, write a `changesets.config.php` scaffold from the inferred project settings. Inference adds a `packages/*` group only when every matched directory declares a Composer name and version; otherwise the scaffold stays one group and carries a commented template that shows how to add more groups. A plugin scaffold also carries the opt-in `readmeChangelog` setting, commented out. |","table":"table-0"},"2208":{"id":"/php/php-changesets/latest/cli-12","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#commands","content":"| Command         | Purpose and options                                                                                                                                                                                                    |       |                                                                                                                                                                                                                                                                                                                                   |\n| --------------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | ----- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `changeset add` | Add a changeset. Prompts for the affected packages, their bumps and the summary in a terminal; without one, pass `--package NAME` for each affected package, or `--since REF` for the changed ones, plus `--bump patch | minor | major --summary TEXT`. A package can be named by its identifier or its path under the configured root, like `plugins/alpha`. One `--bump` applies to every selected package; repeat `--bump` after each `--package` to give each its own bump. Use `--empty` for a no-release changeset, or `--name NAME` to choose the filename. |","table":"table-0"},"2209":{"id":"/php/php-changesets/latest/cli-13","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#commands","content":"| Command            | Purpose and options                                                                                                                                                                                         |\n| ------------------ | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `changeset status` | Show the pending release plan. With `--since REF`, or the configured base branch, also check that every package changed since then has a changeset added since then, and exit with code 2 when one doesn't. |","table":"table-0"},"2210":{"id":"/php/php-changesets/latest/cli-14","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#commands","content":"| Command             | Purpose and options                                                                                                                                                                                                                                                                                                                                                     |\n| ------------------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `changeset version` | Apply the pending release plan. Use `--dry-run` to preview it without writes, `--date YYYY-MM-DD` to set the changelog date, `--package NAME\\|PATH` (repeatable) to version only some packages, `--prerelease ID` to release pre-releases instead, like `--prerelease rc` or `--prerelease rc.2`, and `--snapshot ID` for snapshots like `1.3.0-pr-251.20261012183005`. |","table":"table-0"},"2211":{"id":"/php/php-changesets/latest/cli-15","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#commands","content":"| Command         | Purpose and options                                                                                                                                                                                                                                                                                                                                                                                                            |\n| --------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `changeset tag` | Create the missing release tags of the current versions. Use `--dry-run` or `--untagged` to list them without creating any, `--since REF` to tag only the packages changed since `REF`, `--package NAME\\|PATH` (repeatable) to tag only some packages, `--version VERSION` to fail unless the one selected package is at that version, `--release-title TEMPLATE` to title the releases and `--push` to push the created tags. |","table":"table-0"},"2212":{"id":"/php/php-changesets/latest/cli-16","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#commands","content":"| Command             | Purpose and options                                              |\n| ------------------- | ---------------------------------------------------------------- |\n| `changeset recover` | Restore original files after an interrupted release transaction. |","table":"table-0"},"2213":{"id":"/php/php-changesets/latest/cli-17","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#commands","content":"Every command accepts these global options:"},"2214":{"id":"/php/php-changesets/latest/cli-18","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#commands","content":"| Option             | Purpose                                         |\n| ------------------ | ----------------------------------------------- |\n| `--root DIRECTORY` | Project root, the current directory by default. |","table":"table-1"},"2215":{"id":"/php/php-changesets/latest/cli-19","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#commands","content":"| Option          | Purpose                                                                                                      |\n| --------------- | ------------------------------------------------------------------------------------------------------------ |\n| `--config PATH` | Config file to load instead of `changesets.config.php`; a relative path resolves from the current directory. |","table":"table-1"},"2216":{"id":"/php/php-changesets/latest/cli-20","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#commands","content":"| Option                | Purpose                                                                                                                                                                                           |\n| --------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `--tag-format FORMAT` | Replace the tag format of the config and of every package group for one command, like `--tag-format '{name}@{version}'`. Pass the same format to every command that reads or plans the same tags. |","table":"table-1"},"2217":{"id":"/php/php-changesets/latest/cli-21","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#commands","content":"| Option                | Purpose                                                                                                                                                                                                              |\n| --------------------- | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `--project-name NAME` | Identifier of an inferred root package, for a project without a config or a Composer `name`, so that local checkouts and CI don't depend on the directory name. A config sets the same identifier with a group `id`. |","table":"table-1"},"2218":{"id":"/php/php-changesets/latest/cli-22","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#commands","content":"| Option                 | Purpose                                                                                                                        |\n| ---------------------- | ------------------------------------------------------------------------------------------------------------------------------ |\n| `--base-branch BRANCH` | Branch on the remote that `status` and `add` compare with when there's no `--since`, replacing the `baseBranch` of the config. |","table":"table-1"},"2219":{"id":"/php/php-changesets/latest/cli-23","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#commands","content":"| Option          | Purpose                                                                                                       |\n| --------------- | ------------------------------------------------------------------------------------------------------------- |\n| `--remote NAME` | Git remote of the base branch and of `tag --push`, replacing the `remote` of the config, `origin` by default. |","table":"table-1"},"2220":{"id":"/php/php-changesets/latest/cli-24","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#commands","content":"| Option   | Purpose                   |\n| -------- | ------------------------- |\n| `--json` | Print the result as JSON. |","table":"table-1"},"2221":{"id":"/php/php-changesets/latest/cli-25","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#commands","content":"| Option            | Purpose                                        |\n| ----------------- | ---------------------------------------------- |\n| `--github-output` | Set the result as GitHub Actions step outputs. |","table":"table-1"},"2222":{"id":"/php/php-changesets/latest/cli-26","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#commands","content":"| Option                      | Purpose                                                                |\n| --------------------------- | ---------------------------------------------------------------------- |\n| `--log-format text\\|github` | Log as plain text, or as GitHub Actions annotations and job summaries. |","table":"table-1"},"2223":{"id":"/php/php-changesets/latest/cli-27","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#commands","content":"| Option | Purpose                              |\n| ------ | ------------------------------------ |\n| `--ci` | Shorthand for `--log-format github`. |","table":"table-1"},"2224":{"id":"/php/php-changesets/latest/cli-28","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#commands","content":"The CLI does not commit or publish, and only `tag` creates and, with `--push`, pushes tags. Review and commit version and changelog changes separately. A second `version` run with no pending changesets makes no release edits."},"2225":{"id":"/php/php-changesets/latest/cli-29","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#add-a-changeset","content":"A changeset's frontmatter maps one or more package names to a `patch`, `minor` or `major` bump, and its body is a nonempty Markdown summary:"},"2226":{"id":"/php/php-changesets/latest/cli-30","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#add-a-changeset","content":"A single changeset may release several packages by listing one `package: bump` mapping per line, so the frontmatter is a `Record<package name, bump>` like `wp-release` expects. Commit the generated file with the change. With one package, `add` selects it automatically; with several, it prompts in a terminal or requires one repeatable `--package NAME` per affected package. Like `wp-release changeset-add`, `--package a --bump minor --package b --bump patch` writes a different bump per package:"},"2227":{"id":"/php/php-changesets/latest/cli-31","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#add-a-changeset","content":"With `--since REF`, `add` compares the changes since `REF`, including uncommitted and untracked files, since changesets are usually added before committing. The prompt marks the changed packages without a changeset and Enter selects them, and a single `--bump` without `--package` releases them, like `changeset add --since origin/main --bump patch --summary \"…\"` to fix a failing status check."},"2228":{"id":"/php/php-changesets/latest/cli-32","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#add-a-changeset","content":"Unknown package names, duplicated entries and unsupported YAML are rejected against the discovered package names. Multiple changesets aggregate with the highest bump per package and keep their changelog entries in filename order."},"2229":{"id":"/php/php-changesets/latest/cli-33","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#add-a-changeset","content":"Empty frontmatter records an explicit no-release decision and applies to every package, so `--empty` needs no package selection and is consumed by the next release of all of them."},"2230":{"id":"/php/php-changesets/latest/cli-34","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#check-pull-requests-for-changesets","content":"In CI, `changeset status --since origin/main` (or `changeset status` with a configured `baseBranch` of `main`) requires a changeset added by the pull request for every package that it changes. Changesets already on the base don't count, and an empty changeset added by the pull request records an explicit no-release decision. A package at the repository root owns every changed file. The command exits with code 2 and reports `Changed package \"…\" has no changeset.` for each missing one; with the `github` log format, the error is an annotation on a changed file of the package. `--since` needs the history of the base, so check out with `fetch-depth: 0`."},"2231":{"id":"/php/php-changesets/latest/cli-35","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#check-pull-requests-for-changesets","content":"The result adds `since`, `changedPackages`, `changedPackageFiles` with the changed files of each package, and `missingChangesets` to the release plan."},"2232":{"id":"/php/php-changesets/latest/cli-36","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#preview-and-apply-a-release","content":"`status --json` and `version --dry-run --json` print the `wp-release` release-plan shape: `changesets` with `file`, `packages` and `summary` items, and one `releases[]` item per discovered package with `package`, `currentVersion`, `bump`, `nextVersion`, `tag`, `changesets`, the `changelog` Markdown list added to `CHANGELOG.md` and the affected `paths`, in configured group order. A release without changesets has a null bump and tag. Dry-run JSON also includes one combined `diff` string with a `### {package}` section per release."},"2233":{"id":"/php/php-changesets/latest/cli-37","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#preview-and-apply-a-release","content":"`version` checks that each proposed tag does not exist, updates the configured version targets of every release, prepends a `## {version} ({date})` changelog section and consumes the changesets. Every package's targets are checked before any files are written, and the edits of all releases apply as one transaction, so a failure never leaves one package released and another pending. An interrupted write leaves a `.php-changesets-transaction/` journal and blocks `status` and `version`; run `changeset recover` before retrying."},"2234":{"id":"/php/php-changesets/latest/cli-38","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#version-some-packages","content":"To release packages separately, for example with a release pull request for each, pass `--package NAME`, repeatable, to version only those packages. A changeset that also names other packages keeps only their entries and its summary, so it still applies to their releases with the same bump. Changesets without packages are left for a run without `--package`."},"2235":{"id":"/php/php-changesets/latest/cli-39","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#version-some-packages","content":"`version --snapshot ID` releases snapshots of the next versions for test builds, like `1.3.0-pr-251.20261012183005` for a pull request: the next version with the identifier and the UTC time, so that every snapshot is unique and they sort by time. Snapshots can't be combined with `--prerelease`, and like a pre-release, a snapshot keeps the readme `Stable tag`. Build the versioned files without committing them, since a snapshot consumes the changesets."},"2236":{"id":"/php/php-changesets/latest/cli-40","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#tags-and-release-notes","content":"After merging a release, `changeset tag` creates the missing tags of the current versions, and `--push` pushes them to the remote one at a time, since GitHub doesn't trigger workflows for a push of more than three tags. Tags are created only when absent, so a rerun after a partial failure is safe, and every version target of a package must match the version before its tag is created. `--dry-run` lists the tags without creating them, and `--untagged` lists only the releases without a tag, for example to release each of them with a separate workflow."},"2237":{"id":"/php/php-changesets/latest/cli-41","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#tags-and-release-notes","content":"With `--json` or `--github-output`, each entry of `tags` has the `package`, `version`, `tag`, a `title`, the `previousTag` when there is one, a `prerelease` flag, whether the tag already `exists` or was `created`, and the release `notes`. The title is `name@version`, or the version for a package at the repository root, unless `releaseTitle` or `--release-title` sets a template with `{name}`, `{path}`, `{version}` and `{tag}` placeholders. The notes are the changelog section of the version, or without one the commits that changed the package since the previous tag, the highest version below the released one, skipping pre-releases for a stable version."},"2238":{"id":"/php/php-changesets/latest/cli-42","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#tags-and-release-notes","content":"To release a single package, pass `--package NAME` and `--version VERSION`, which fails unless the package is at that version; a sole package is selected without `--package`. A package versioned by Git tags has no version file, so `--version` is the version to tag, and without it the version is the changelog version above its latest tag. The tags are read from the local repository, so check out the full history with its tags."},"2239":{"id":"/php/php-changesets/latest/cli-43","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#pre-releases","content":"There is no pre mode and no state file. Pre-releases are a per-run transform of the release plan, like in `wp-release`: `changeset version --prerelease ID` computes the stable plan first, then turns every release's version into a pre-release of that stable version."},"2240":{"id":"/php/php-changesets/latest/cli-44","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#pre-releases","content":"A bare identifier like `rc` numbers one above the highest existing `<stable>-<identifier>.` version among the package's Git tags in its tag format, so the first pre-release of a stable version is `1.2.5-rc.1`. Tag each pre-release with the release workflow; the numbering counts those tags."},"2241":{"id":"/php/php-changesets/latest/cli-45","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#pre-releases","content":"An explicit `id.n` like `rc.2` is used as is, and a run fails when that exact version already exists among the tags."},"2242":{"id":"/php/php-changesets/latest/cli-46","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#pre-releases","content":"Versions have two to four numeric parts, like `X.Y.Z` and the `X.Y` and `X.Y.Z.W` versions common in WordPress plugins, with an optional pre-release like `X.Y.Z-<tag>.<n>`; build metadata is rejected. A bump keeps the number of parts, so a minor bump of `2.1` is `2.2`, like `wp-release`."},"2243":{"id":"/php/php-changesets/latest/cli-47","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#pre-releases","content":"A stable release of a pre-release current version graduates like `semver inc`: a patch of `1.2.4-rc.1` plans `1.2.4`, and a minor of `1.3.0-rc.1` plans `1.3.0`, while a minor of `1.2.4-rc.1` plans `1.3.0`."},"2244":{"id":"/php/php-changesets/latest/cli-48","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#pre-releases","content":"The readme `Stable tag` keeps the last stable version for a pre-release, since WordPress.org offers the stable tag to every site."},"2245":{"id":"/php/php-changesets/latest/cli-49","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#pre-releases","content":"With a `nextVersion` hook, the transform applies to the stable version that the hook returns."},"2246":{"id":"/php/php-changesets/latest/cli-50","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#pre-releases","content":"The recommended flow is the `wp-release` one: cut a pre-release on a branch that isn't merged with `changeset version --prerelease rc`, tag it with the release workflow, and later run `changeset version` without the flag on the base branch to release the stable version."},"2247":{"id":"/php/php-changesets/latest/cli-51","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#github-actions-output","content":"`--github-output` writes the complete result as compact JSON to the `result` step output and each top-level string, number or boolean, like the dry-run `diff`, as its own output, like `wp-release`. Arrays and objects stay in `result`, so read them with `fromJSON( steps.tag.outputs.result ).tags`."},"2248":{"id":"/php/php-changesets/latest/cli-52","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#annotations-and-job-summaries","content":"`--log-format github`, the default when `GITHUB_ACTIONS=true` and also selected by `--ci`, prints errors as workflow commands, so they show up as annotations on the run and on the files of a pull request. Version mismatches are annotated on the file and line of the version, and missing changesets on a changed file of the package. File paths are relative to `GITHUB_WORKSPACE`, or the current directory without it. Pass `--log-format text` for plain text in GitHub Actions."},"2249":{"id":"/php/php-changesets/latest/cli-53","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#annotations-and-job-summaries","content":"When `GITHUB_STEP_SUMMARY` is set, each command adds a section to the job summary of the run:"},"2250":{"id":"/php/php-changesets/latest/cli-54","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#annotations-and-job-summaries","content":"| Command  | Summary                                               |\n| -------- | ----------------------------------------------------- |\n| `status` | Each changed package with whether it has a changeset. |","table":"table-2"},"2251":{"id":"/php/php-changesets/latest/cli-55","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#annotations-and-job-summaries","content":"| Command   | Summary                                                               |\n| --------- | --------------------------------------------------------------------- |\n| `version` | A table of the package releases with their version changes and bumps. |","table":"table-2"},"2252":{"id":"/php/php-changesets/latest/cli-56","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#annotations-and-job-summaries","content":"| Command | Summary                                                                                         |\n| ------- | ----------------------------------------------------------------------------------------------- |\n| `tag`   | Each tag with its title, previous tag and status, and its release notes in a collapsed section. |","table":"table-2"},"2253":{"id":"/php/php-changesets/latest/cli-57","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#annotations-and-job-summaries","content":"A failed command adds its error to the summary, or a table of its problems with their files and lines."},"2254":{"id":"/php/php-changesets/latest/cli-58","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#exit-codes","content":"| Code | Meaning                               |\n| ---- | ------------------------------------- |\n| `0`  | Success, dry run, no changes, or help |","table":"table-3"},"2255":{"id":"/php/php-changesets/latest/cli-59","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#exit-codes","content":"| Code | Meaning                                          |\n| ---- | ------------------------------------------------ |\n| `1`  | Unexpected failure, such as a failed git command |","table":"table-3"},"2256":{"id":"/php/php-changesets/latest/cli-60","page_id":"/php/php-changesets/latest/cli","tags":[],"type":"text","url":"/php/php-changesets/latest/cli#exit-codes","content":"| Code | Meaning                                                                                                                    |\n| ---- | -------------------------------------------------------------------------------------------------------------------------- |\n| `2`  | Invalid options, failed release checks like a version mismatch or an existing tag, or changed packages without a changeset |","table":"table-3"},"2257":{"id":"/php/php-changesets/latest/comparison","page_id":"/php/php-changesets/latest/comparison","type":"page","content":"Comparison with wp-release","breadcrumbs":["Docs","Php","Php changesets","Latest"],"tags":[],"url":"/php/php-changesets/latest/comparison"},"2258":{"id":"/php/php-changesets/latest/comparison-0","page_id":"/php/php-changesets/latest/comparison","type":"heading","tags":[],"url":"/php/php-changesets/latest/comparison#comparison-with-wp-release","content":"Comparison with wp-release"},"2259":{"id":"/php/php-changesets/latest/comparison-1","page_id":"/php/php-changesets/latest/comparison","type":"heading","tags":[],"url":"/php/php-changesets/latest/comparison#deliberate-differences","content":"Deliberate differences"},"2260":{"id":"/php/php-changesets/latest/comparison-2","page_id":"/php/php-changesets/latest/comparison","type":"heading","tags":[],"url":"/php/php-changesets/latest/comparison#excluded-by-design","content":"Excluded by design"},"2261":{"id":"/php/php-changesets/latest/comparison-3","page_id":"/php/php-changesets/latest/comparison","tags":[],"type":"text","url":"/php/php-changesets/latest/comparison#comparison-with-wp-release","content":"PHP Changesets is the PHP counterpart of the `changeset-*` commands of `wp-release`, for projects that release with PHP and Git alone and don't use Node.js or JavaScript. Choose `wp-release` when the project already has a Node.js toolchain, or needs its builds, ZIPs, translations and deploys, and PHP Changesets when Composer is the only package manager. Both read the same changeset files and print the same `releases[]` plan, so a repository can switch between them."},"2262":{"id":"/php/php-changesets/latest/comparison-4","page_id":"/php/php-changesets/latest/comparison","tags":[],"type":"text","url":"/php/php-changesets/latest/comparison#comparison-with-wp-release","content":"| PHP Changesets   | wp-release    | Notes                                                        |\n| ---------------- | ------------- | ------------------------------------------------------------ |\n| `changeset init` | No equivalent | Scaffolds `changesets.config.php` from the inferred project. |","table":"table-0"},"2263":{"id":"/php/php-changesets/latest/comparison-5","page_id":"/php/php-changesets/latest/comparison","tags":[],"type":"text","url":"/php/php-changesets/latest/comparison#comparison-with-wp-release","content":"| PHP Changesets  | wp-release      | Notes                                                       |\n| --------------- | --------------- | ----------------------------------------------------------- |\n| `changeset add` | `changeset-add` | Same options, including `--since` for the changed packages. |","table":"table-0"},"2264":{"id":"/php/php-changesets/latest/comparison-6","page_id":"/php/php-changesets/latest/comparison","tags":[],"type":"text","url":"/php/php-changesets/latest/comparison#comparison-with-wp-release","content":"| PHP Changesets     | wp-release         | Notes                                              |\n| ------------------ | ------------------ | -------------------------------------------------- |\n| `changeset status` | `changeset-status` | Same `--since` check, exit code and result fields. |","table":"table-0"},"2265":{"id":"/php/php-changesets/latest/comparison-7","page_id":"/php/php-changesets/latest/comparison","tags":[],"type":"text","url":"/php/php-changesets/latest/comparison#comparison-with-wp-release","content":"| PHP Changesets      | wp-release          | Notes                                    |\n| ------------------- | ------------------- | ---------------------------------------- |\n| `changeset version` | `changeset-version` | Same options, without `--no-dependents`. |","table":"table-0"},"2266":{"id":"/php/php-changesets/latest/comparison-8","page_id":"/php/php-changesets/latest/comparison","tags":[],"type":"text","url":"/php/php-changesets/latest/comparison#comparison-with-wp-release","content":"| PHP Changesets  | wp-release      | Notes                                              |\n| --------------- | --------------- | -------------------------------------------------- |\n| `changeset tag` | `changeset-tag` | Same options, including `--untagged` and `--push`. |","table":"table-0"},"2267":{"id":"/php/php-changesets/latest/comparison-9","page_id":"/php/php-changesets/latest/comparison","tags":[],"type":"text","url":"/php/php-changesets/latest/comparison#comparison-with-wp-release","content":"| PHP Changesets      | wp-release    | Notes                                                    |\n| ------------------- | ------------- | -------------------------------------------------------- |\n| `changeset recover` | No equivalent | Restores files after an interrupted release transaction. |","table":"table-0"},"2268":{"id":"/php/php-changesets/latest/comparison-10","page_id":"/php/php-changesets/latest/comparison","tags":[],"type":"text","url":"/php/php-changesets/latest/comparison#comparison-with-wp-release","content":"| PHP Changesets          | wp-release              | Notes                                                                                    |\n| ----------------------- | ----------------------- | ---------------------------------------------------------------------------------------- |\n| `changesets.config.php` | `wp-release.config.mjs` | `define_config()` and the descriptor functions mirror `defineConfig()` and its builders. |","table":"table-0"},"2269":{"id":"/php/php-changesets/latest/comparison-11","page_id":"/php/php-changesets/latest/comparison","tags":[],"type":"text","url":"/php/php-changesets/latest/comparison#comparison-with-wp-release","content":"They also share these conventions: `--json` and `--github-output` on every command, `--log-format github` annotations and job summaries, global `--config`, `--tag-format` and `--project-name`, the `remote` and `baseBranch` settings with their `--remote` and `--base-branch` options, the `{path}/{version}` tag format with `v{version}` for an inferred root project, and the exit codes 0, 1 and 2."},"2270":{"id":"/php/php-changesets/latest/comparison-12","page_id":"/php/php-changesets/latest/comparison","tags":[],"type":"text","url":"/php/php-changesets/latest/comparison#deliberate-differences","content":"The command is `changeset` with subcommands, like `changeset add`, where `wp-release` has `changeset-add` among its other commands. Run `changeset --help` for the commands."},"2271":{"id":"/php/php-changesets/latest/comparison-13","page_id":"/php/php-changesets/latest/comparison","tags":[],"type":"text","url":"/php/php-changesets/latest/comparison#deliberate-differences","content":"No single-project version flags like `--version-composer-json`: without a config, the project is inferred, and `changeset init` writes the inferred settings to `changesets.config.php` to change them."},"2272":{"id":"/php/php-changesets/latest/comparison-14","page_id":"/php/php-changesets/latest/comparison","tags":[],"type":"text","url":"/php/php-changesets/latest/comparison#deliberate-differences","content":"No `changelogInsertAfter`: new `CHANGELOG.md` sections go before the first version heading, and readme sections after the `== Changelog ==` heading."},"2273":{"id":"/php/php-changesets/latest/comparison-15","page_id":"/php/php-changesets/latest/comparison","tags":[],"type":"text","url":"/php/php-changesets/latest/comparison#deliberate-differences","content":"`tag` creates and pushes tags but not GitHub Releases. A workflow step like `softprops/action-gh-release` creates them from its result; see GitHub Actions."},"2274":{"id":"/php/php-changesets/latest/comparison-16","page_id":"/php/php-changesets/latest/comparison","tags":[],"type":"text","url":"/php/php-changesets/latest/comparison#deliberate-differences","content":"No `releaseNotes` callback: the release notes are the changelog section, or the commits since the previous tag."},"2275":{"id":"/php/php-changesets/latest/comparison-17","page_id":"/php/php-changesets/latest/comparison","tags":[],"type":"text","url":"/php/php-changesets/latest/comparison#deliberate-differences","content":"No library of primitives: the package is the config-driven CLI and its classes, without build, ZIP, checksum or deploy functions."},"2276":{"id":"/php/php-changesets/latest/comparison-18","page_id":"/php/php-changesets/latest/comparison","tags":[],"type":"text","url":"/php/php-changesets/latest/comparison#deliberate-differences","content":"A package at the repository root needs an `id`, a manifest name or `--project-name`, and the name of the checkout directory never names a package, so changesets keep working in forks, worktrees and CI."},"2277":{"id":"/php/php-changesets/latest/comparison-19","page_id":"/php/php-changesets/latest/comparison","tags":[],"type":"text","url":"/php/php-changesets/latest/comparison#deliberate-differences","content":"Only the literal `.` glob matches the package root, while in `wp-release` a pattern like `*` also matches it."},"2278":{"id":"/php/php-changesets/latest/comparison-20","page_id":"/php/php-changesets/latest/comparison","tags":[],"type":"text","url":"/php/php-changesets/latest/comparison#deliberate-differences","content":"A pre-release current version graduates like `semver inc` on a stable release, where `wp-release` rejects bumping one."},"2279":{"id":"/php/php-changesets/latest/comparison-21","page_id":"/php/php-changesets/latest/comparison","tags":[],"type":"text","url":"/php/php-changesets/latest/comparison#deliberate-differences","content":"Package groups can set their own `changelog` and `tagFormat`."},"2280":{"id":"/php/php-changesets/latest/comparison-22","page_id":"/php/php-changesets/latest/comparison","tags":[],"type":"text","url":"/php/php-changesets/latest/comparison#excluded-by-design","content":"These `wp-release` features are left out, and the CLI never commits or publishes versions. Their settings and options are rejected as unknown:"},"2281":{"id":"/php/php-changesets/latest/comparison-23","page_id":"/php/php-changesets/latest/comparison","tags":[],"type":"text","url":"/php/php-changesets/latest/comparison#excluded-by-design","content":"Fixed and linked version groups: every package releases from its own changesets and version descriptors."},"2282":{"id":"/php/php-changesets/latest/comparison-24","page_id":"/php/php-changesets/latest/comparison","tags":[],"type":"text","url":"/php/php-changesets/latest/comparison#excluded-by-design","content":"The dependents system and `version --no-dependents`: bundled or dependent packages release with their own changesets, not automatically after a source release."},"2283":{"id":"/php/php-changesets/latest/comparison-25","page_id":"/php/php-changesets/latest/comparison","tags":[],"type":"text","url":"/php/php-changesets/latest/comparison#excluded-by-design","content":"Publishing: no builds, ZIPs, i18n extraction, git commits, or package registry and WordPress.org deploys. The CLI only writes version, changelog and changeset files and creates the release tags."},"2284":{"id":"/php/php-changesets/latest/configuration","page_id":"/php/php-changesets/latest/configuration","type":"page","content":"Configuration","breadcrumbs":["Docs","Php","Php changesets","Latest"],"tags":[],"url":"/php/php-changesets/latest/configuration"},"2285":{"id":"/php/php-changesets/latest/configuration-0","page_id":"/php/php-changesets/latest/configuration","type":"heading","tags":[],"url":"/php/php-changesets/latest/configuration#configuration","content":"Configuration"},"2286":{"id":"/php/php-changesets/latest/configuration-1","page_id":"/php/php-changesets/latest/configuration","type":"heading","tags":[],"url":"/php/php-changesets/latest/configuration#workspace-settings","content":"Workspace settings"},"2287":{"id":"/php/php-changesets/latest/configuration-2","page_id":"/php/php-changesets/latest/configuration","type":"heading","tags":[],"url":"/php/php-changesets/latest/configuration#hooks","content":"Hooks"},"2288":{"id":"/php/php-changesets/latest/configuration-3","page_id":"/php/php-changesets/latest/configuration","type":"heading","tags":[],"url":"/php/php-changesets/latest/configuration#version-descriptors","content":"Version descriptors"},"2289":{"id":"/php/php-changesets/latest/configuration-4","page_id":"/php/php-changesets/latest/configuration","type":"heading","tags":[],"url":"/php/php-changesets/latest/configuration#builder-helpers","content":"Builder helpers"},"2290":{"id":"/php/php-changesets/latest/configuration-5","page_id":"/php/php-changesets/latest/configuration","type":"heading","tags":[],"url":"/php/php-changesets/latest/configuration#callback-descriptors","content":"Callback descriptors"},"2291":{"id":"/php/php-changesets/latest/configuration-6","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#configuration","content":"The configuration lives in `changesets.config.php` at the project root, the analog of `wp-release.config.mjs`. The global `--config PATH` selects another file for one command."},"2292":{"id":"/php/php-changesets/latest/configuration-7","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#configuration","content":"With no config, `init` infers the single project from a root Composer manifest or WordPress plugin headers as one group, tagged `v{version}` like the `wp-release` single-project default. The package is named by its Composer `name`, or for a plugin without one, by the slug of its main plugin file, like `demo` for `demo.php`, never by the checkout directory. `--project-name NAME` names any other project without a config. Readme changelog updates are opt-in, like in `wp-release`, so the scaffold of a plugin carries `readmeChangelog` commented out. When every directory under `packages/*` declares a Composer name and version, inference adds a second group for them. Other layouts keep the single group, and the scaffold carries a commented template that shows how to add groups. The config lives outside the changeset directory, so `.changeset/` holds only the Markdown changesets and its `README.md`."},"2293":{"id":"/php/php-changesets/latest/configuration-8","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#configuration","content":"The loader rejects the removed formats `.php-changesets.json`, `.changeset/config.php` and `config/changesets.php` with guidance pointing at `changesets.config.php`. It also rejects the upstream Changesets `.changeset/config.json`, since both tools would read and consume the same changeset files."},"2294":{"id":"/php/php-changesets/latest/configuration-9","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#configuration","content":"The config file is regular PHP (loaded with `require`) and must return an array, normally the result of `define_config()`, which validates the settings and hooks eagerly at load time and returns their canonical shape. The config helpers are namespaced functions, the PHP analogs of the `wp-release` `defineConfig()` and descriptor builders; import them with `use function`."},"2295":{"id":"/php/php-changesets/latest/configuration-10","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#workspace-settings","content":"The canonical configuration is a workspace with package groups; a single-project config is one group covering the repository root:"},"2296":{"id":"/php/php-changesets/latest/configuration-11","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#workspace-settings","content":"| Key        | Required | Default | Purpose                                             |\n| ---------- | -------- | ------- | --------------------------------------------------- |\n| `packages` | Yes      | —       | Non-empty list of package groups, in release order. |","table":"table-0"},"2297":{"id":"/php/php-changesets/latest/configuration-12","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#workspace-settings","content":"| Key          | Required | Default      | Purpose                                                                         |\n| ------------ | -------- | ------------ | ------------------------------------------------------------------------------- |\n| `changesets` | No       | `.changeset` | Directory containing changeset Markdown files, relative to the repository root. |","table":"table-0"},"2298":{"id":"/php/php-changesets/latest/configuration-13","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#workspace-settings","content":"| Key         | Required | Default            | Purpose                                                                                                                                                                                                                                                                            |\n| ----------- | -------- | ------------------ | ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `tagFormat` | No       | `{path}/{version}` | Proposed tag format, like `plugins/alpha/1.2.0`, or `1.2.0` for a package at the root; must contain `{version}` exactly once and may use `{name}` and `{path}`. The default matches `wp-release`, and the global `--tag-format` replaces it and the group formats for one command. |","table":"table-0"},"2299":{"id":"/php/php-changesets/latest/configuration-14","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#workspace-settings","content":"| Key            | Required | Default | Purpose                                                                                                                                                                                                                                                                                                                                                                                |\n| -------------- | -------- | ------- | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `releaseTitle` | No       | `null`  | Title of the releases that `tag` reports, as a template with `{name}`, `{path}`, `{version}` and `{tag}` placeholders, like `'{version} (beta)'`, or a callable that receives `[ 'package' => [ 'name' => …, 'path' => … ], 'version' => …, 'tag' => … ]`. `null` titles them `name@version`, or the version for a package at the root. `--release-title` replaces it for one command. |","table":"table-0"},"2300":{"id":"/php/php-changesets/latest/configuration-15","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#workspace-settings","content":"| Key    | Required | Default | Purpose                                                                                |\n| ------ | -------- | ------- | -------------------------------------------------------------------------------------- |\n| `root` | No       | `null`  | Package path base that package globs resolve against; `null` uses the repository root. |","table":"table-0"},"2301":{"id":"/php/php-changesets/latest/configuration-16","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#workspace-settings","content":"| Key      | Required | Default  | Purpose                                            |\n| -------- | -------- | -------- | -------------------------------------------------- |\n| `remote` | No       | `origin` | Git remote of the base branch and of `tag --push`. |","table":"table-0"},"2302":{"id":"/php/php-changesets/latest/configuration-17","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#workspace-settings","content":"| Key          | Required | Default | Purpose                                                                                                             |\n| ------------ | -------- | ------- | ------------------------------------------------------------------------------------------------------------------- |\n| `baseBranch` | No       | `null`  | Branch on the remote that `status` and `add` compare with when there's no `--since`, like `main` for `origin/main`. |","table":"table-0"},"2303":{"id":"/php/php-changesets/latest/configuration-18","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#workspace-settings","content":"| Key         | Required | Default        | Purpose                                                                                    |\n| ----------- | -------- | -------------- | ------------------------------------------------------------------------------------------ |\n| `changelog` | No       | `CHANGELOG.md` | Default changelog path for groups. Set to an empty string to disable changelog generation. |","table":"table-0"},"2304":{"id":"/php/php-changesets/latest/configuration-19","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#workspace-settings","content":"| Key               | Required | Default | Purpose                                                                                                                                                                                                                                                   |\n| ----------------- | -------- | ------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `readmeChangelog` | No       | `false` | Also add a `= {version} =` section with one `*` bullet per changeset summary after the `== Changelog ==` heading of a package's `readme.txt` or `readme.md`, which WordPress.org shows, like `wp-release`. A readme without the heading is left as it is. |","table":"table-0"},"2305":{"id":"/php/php-changesets/latest/configuration-20","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#workspace-settings","content":"| Key           | Required | Default | Purpose                                                              |\n| ------------- | -------- | ------- | -------------------------------------------------------------------- |\n| `nextVersion` | No       | `null`  | Callable replacing the stable bump computation; see the hooks below. |","table":"table-0"},"2306":{"id":"/php/php-changesets/latest/configuration-21","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#workspace-settings","content":"| Key              | Required | Default | Purpose                                                                  |\n| ---------------- | -------- | ------- | ------------------------------------------------------------------------ |\n| `changelogEntry` | No       | `null`  | Callable formatting one changeset's changelog line; see the hooks below. |","table":"table-0"},"2307":{"id":"/php/php-changesets/latest/configuration-22","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#workspace-settings","content":"Each package group sets:"},"2308":{"id":"/php/php-changesets/latest/configuration-23","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#workspace-settings","content":"| Key    | Required | Default | Purpose                                                                               |\n| ------ | -------- | ------- | ------------------------------------------------------------------------------------- |\n| `glob` | Yes      | —       | Relative path pattern for package directories, like `packages/*` or `.` for the root. |","table":"table-1"},"2309":{"id":"/php/php-changesets/latest/configuration-24","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#workspace-settings","content":"| Key       | Required | Default | Purpose                                                |\n| --------- | -------- | ------- | ------------------------------------------------------ |\n| `exclude` | No       | `[]`    | Relative path patterns removed from the group matches. |","table":"table-1"},"2310":{"id":"/php/php-changesets/latest/configuration-25","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#workspace-settings","content":"| Key  | Required | Default | Purpose                                                                                                 |\n| ---- | -------- | ------- | ------------------------------------------------------------------------------------------------------- |\n| `id` | No       | `null`  | Fixed package identifier for a glob that matches exactly one directory; takes precedence over `idFrom`. |","table":"table-1"},"2311":{"id":"/php/php-changesets/latest/configuration-26","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#workspace-settings","content":"| Key      | Required | Default | Purpose                                                                                                                                                                                                                                                                                                  |\n| -------- | -------- | ------- | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `idFrom` | No       | `path`  | Package name source: `composer.json#name`, `package.json#name`, or `path`. The package at the root (`.`) has no path, so it needs an `id` or a manifest source. Unlike in `wp-release`, the name of the checkout directory never names a package, so changesets keep working in forks, worktrees and CI. |","table":"table-1"},"2312":{"id":"/php/php-changesets/latest/configuration-27","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#workspace-settings","content":"| Key       | Required | Default | Purpose                                                       |\n| --------- | -------- | ------- | ------------------------------------------------------------- |\n| `version` | Yes      | —       | `{ from, to }` descriptors; every releasable group needs one. |","table":"table-1"},"2313":{"id":"/php/php-changesets/latest/configuration-28","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#workspace-settings","content":"| Key         | Required | Default   | Purpose                                                                                                                                     |\n| ----------- | -------- | --------- | ------------------------------------------------------------------------------------------------------------------------------------------- |\n| `changelog` | No       | Inherited | Per-package changelog path; empty string disables, `null` inherits. `wp-release` has no per-group setting and always writes `CHANGELOG.md`. |","table":"table-1"},"2314":{"id":"/php/php-changesets/latest/configuration-29","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#workspace-settings","content":"| Key         | Required | Default   | Purpose                                                                                |\n| ----------- | -------- | --------- | -------------------------------------------------------------------------------------- |\n| `tagFormat` | No       | Inherited | Per-package tag format; `null` inherits. `wp-release` only has the repository setting. |","table":"table-1"},"2315":{"id":"/php/php-changesets/latest/configuration-30","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#workspace-settings","content":"Discovery walks the directories below `root`, bounded by the deepest configured glob, and never enters `.git`, `node_modules`, `vendor` or `dist`. A glob that matches no directory, and duplicate package identifiers across groups, are configuration errors. Only the literal `.` glob matches the package root. Patterns like `*` and `packages/**` never cover it, while in `wp-release` a pattern like `*` also matches the root. Group settings and descriptor files must resolve inside the package, like all project paths."},"2316":{"id":"/php/php-changesets/latest/configuration-31","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#workspace-settings","content":"A monorepo config lists one group per package kind; releases stay in configured group order:"},"2317":{"id":"/php/php-changesets/latest/configuration-32","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#hooks","content":"Callbacks are plain PHP closures and live only in the PHP config; nothing else in the schema accepts callables, and callability is validated at config load. A failing hook, or a `nextVersion` result that is not a supported version, stops the run with a message naming the package."},"2318":{"id":"/php/php-changesets/latest/configuration-33","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#hooks","content":"`nextVersion` receives `{ package, bump, currentVersion, changesets }`, like the `wp-release` `NextVersionInput`, where `package` is `{ name, path, currentVersion }` and `changesets` lists the release's changeset records, and it returns the supported stable version of the release. A `--prerelease` run turns that version into a pre-release afterwards, as without a hook:"},"2319":{"id":"/php/php-changesets/latest/configuration-34","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#hooks","content":"`changelogEntry` receives `{ package, changeset }` where `changeset` is the record with `file`, `packages` and `summary`, and formats one changeset's changelog line, replacing the default `- {summary}` bullet. An empty result falls back to the default entry:"},"2320":{"id":"/php/php-changesets/latest/configuration-35","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#version-descriptors","content":"| `kind`          | Fields | Source or target behavior                                                                                                                                        |\n| --------------- | ------ | ---------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `composer-json` | `file` | Read or replace the top-level Composer `version` while preserving surrounding formatting. A target with `ifPresent: true` is skipped when the version is absent. |","table":"table-2"},"2321":{"id":"/php/php-changesets/latest/configuration-36","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#version-descriptors","content":"| `kind`                    | Fields | Source or target behavior                    |\n| ------------------------- | ------ | -------------------------------------------- |\n| `wordpress-plugin-header` | `file` | Read or replace the plugin `Version` header. |","table":"table-2"},"2322":{"id":"/php/php-changesets/latest/configuration-37","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#version-descriptors","content":"| `kind`                   | Fields | Source or target behavior                                                           |\n| ------------------------ | ------ | ----------------------------------------------------------------------------------- |\n| `wordpress-theme-header` | `file` | Read or replace the theme stylesheet `Version` header, over `style.css` by default. |","table":"table-2"},"2323":{"id":"/php/php-changesets/latest/configuration-38","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#version-descriptors","content":"| `kind`                 | Fields | Source or target behavior                                                                                             |\n| ---------------------- | ------ | --------------------------------------------------------------------------------------------------------------------- |\n| `wordpress-stable-tag` | `file` | Read or replace the readme `Stable tag`. A target with `ifPresent: true` is skipped when the file or value is absent. |","table":"table-2"},"2324":{"id":"/php/php-changesets/latest/configuration-39","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#version-descriptors","content":"| `kind`         | Fields             | Source or target behavior                                                               |\n| -------------- | ------------------ | --------------------------------------------------------------------------------------- |\n| `php-constant` | `file`, `constant` | Read or replace a `const` declaration or `define()` value with the given constant name. |","table":"table-2"},"2325":{"id":"/php/php-changesets/latest/configuration-40","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#version-descriptors","content":"| `kind`    | Fields                               | Source or target behavior                                                                                                                                                                                                                                       |\n| --------- | ------------------------------------ | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `git-tag` | `pattern`, optional `initialVersion` | Read the highest tag by version precedence matching `pattern`, which defaults to the package's tag format and also expands `{name}` and `{path}`; pre-release tags rank below the stable version of the same base. Source only; use an empty `version.to` list. |","table":"table-2"},"2326":{"id":"/php/php-changesets/latest/configuration-41","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#version-descriptors","content":"| `kind`     | Fields                                | Source or target behavior                                                  |\n| ---------- | ------------------------------------- | -------------------------------------------------------------------------- |\n| `callback` | `file`, `resolve`, optional `replace` | Resolve and replace a custom version span, available in every config path. |","table":"table-2"},"2327":{"id":"/php/php-changesets/latest/configuration-42","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#builder-helpers","content":"Version descriptors are built with functions in the `WPElevator\\PHP_Changesets` namespace, which Composer autoloads: `composer_json_version( ?string $file, bool $if_present )`, `wordpress_plugin_version( ?string $file )`, `wordpress_theme_version( ?string $file )` (`style.css` by default) and `wordpress_stable_tag( ?string $file, bool $if_present )` for the manifest, header and readme kinds, `php_constant_version( string $file, string $constant )` for constants, `git_tag_version( ?string $pattern, ?string $initial_version )` for tag-only sources, and `callback_version( string $file, callable $resolve, ?callable $replace )` for custom spans."},"2328":{"id":"/php/php-changesets/latest/configuration-43","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#builder-helpers","content":"`define_config( array $config )` validates a workspace configuration when it loads, rejects unknown or malformed settings and returns the canonical shape that the other classes read."},"2329":{"id":"/php/php-changesets/latest/configuration-44","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#builder-helpers","content":"A Git-tag-only library needs a first tag, like `git tag v0.1.0`, or an initial version for its first release:"},"2330":{"id":"/php/php-changesets/latest/configuration-45","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#builder-helpers","content":"Once a matching stable tag exists, it takes precedence over `initialVersion`. Tag-only releases do not modify `composer.json`: the release is recorded in the changelog, and `tag` tags the changelog version above the latest tag."},"2331":{"id":"/php/php-changesets/latest/configuration-46","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#callback-descriptors","content":"Use `callback_version()` when the built-in descriptors can't find the version. Its callables must return the same result for the same contents and must not write files:"},"2332":{"id":"/php/php-changesets/latest/configuration-47","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#callback-descriptors","content":"`resolve( string $contents ): ?array` returns the version `value`, zero-based byte `offset` and byte `length`, or `null` when absent. The span must contain exactly `value`."},"2333":{"id":"/php/php-changesets/latest/configuration-48","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#callback-descriptors","content":"`replace( string $contents, string $old_version, string $new_version ): string` optionally returns the complete proposed contents. Without it, only the resolved span is replaced."},"2334":{"id":"/php/php-changesets/latest/configuration-49","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#callback-descriptors","content":"After either replacement, `resolve` must find the new version. `resolve` runs for status and planning; `replace` runs whenever a bump is planned, including dry runs."},"2335":{"id":"/php/php-changesets/latest/configuration-50","page_id":"/php/php-changesets/latest/configuration","tags":[],"type":"text","url":"/php/php-changesets/latest/configuration#callback-descriptors","content":"The same descriptor can be the source and a target:"},"2336":{"id":"/php/php-changesets/latest/development","page_id":"/php/php-changesets/latest/development","type":"page","content":"Development","breadcrumbs":["Docs","Php","Php changesets","Latest"],"tags":[],"url":"/php/php-changesets/latest/development"},"2337":{"id":"/php/php-changesets/latest/development-0","page_id":"/php/php-changesets/latest/development","type":"heading","tags":[],"url":"/php/php-changesets/latest/development#development","content":"Development"},"2338":{"id":"/php/php-changesets/latest/development-1","page_id":"/php/php-changesets/latest/development","type":"heading","tags":[],"url":"/php/php-changesets/latest/development#architecture","content":"Architecture"},"2339":{"id":"/php/php-changesets/latest/development-2","page_id":"/php/php-changesets/latest/development","tags":[],"type":"text","url":"/php/php-changesets/latest/development#development","content":"Classes live in `php/` with Composer classmap autoloading, and tests live in `tests/phpunit/`. The `bin/changeset` entry point loads `php/bootstrap.php` so it also runs directly from a checkout. Run the package tests from the monorepo root:"},"2340":{"id":"/php/php-changesets/latest/development-3","page_id":"/php/php-changesets/latest/development","tags":[],"type":"text","url":"/php/php-changesets/latest/development#architecture","content":"| Component       | Responsibility                                                                                                                      |\n| --------------- | ----------------------------------------------------------------------------------------------------------------------------------- |\n| `Project_Files` | Hold the canonical project root and resolve safe paths inside it, also for a package directory. The other project classes share it. |","table":"table-0"},"2341":{"id":"/php/php-changesets/latest/development-4","page_id":"/php/php-changesets/latest/development","tags":[],"type":"text","url":"/php/php-changesets/latest/development#architecture","content":"| Component                           | Responsibility                                                                                                                                                                                     |\n| ----------------------------------- | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `Config_Schema` and `functions.php` | Validate the workspace configuration and its hooks through `define_config()`, and build the shared version descriptors with the namespaced builder functions, which Composer autoloads as `files`. |","table":"table-0"},"2342":{"id":"/php/php-changesets/latest/development-5","page_id":"/php/php-changesets/latest/development","tags":[],"type":"text","url":"/php/php-changesets/latest/development#architecture","content":"| Component           | Responsibility                                                                                                  |\n| ------------------- | --------------------------------------------------------------------------------------------------------------- |\n| `Package_Discovery` | Find package directories from the configured globs, with id resolution and duplicate and empty-match detection. |","table":"table-0"},"2343":{"id":"/php/php-changesets/latest/development-6","page_id":"/php/php-changesets/latest/development","tags":[],"type":"text","url":"/php/php-changesets/latest/development#architecture","content":"| Component | Responsibility                                                                                                                                                                                                                                                          |\n| --------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `Cli`     | Resolve the project root once, construct the project-bound services, parse commands and global options, prompt for package selection and changeset content, create changesets and configuration, print results and step outputs, set the exit code and invoke recovery. |","table":"table-0"},"2344":{"id":"/php/php-changesets/latest/development-7","page_id":"/php/php-changesets/latest/development","tags":[],"type":"text","url":"/php/php-changesets/latest/development#architecture","content":"| Component | Responsibility                                                                                                                     |\n| --------- | ---------------------------------------------------------------------------------------------------------------------------------- |\n| `Git`     | Run git commands in one directory and throw `Git_Exception` on failures, which exit with code 1. Tests replace it with a subclass. |","table":"table-0"},"2345":{"id":"/php/php-changesets/latest/development-8","page_id":"/php/php-changesets/latest/development","tags":[],"type":"text","url":"/php/php-changesets/latest/development#architecture","content":"| Component | Responsibility                                                                                |\n| --------- | --------------------------------------------------------------------------------------------- |\n| `Logger`  | Log plain text, or GitHub Actions annotations and job summaries with the `github` log format. |","table":"table-0"},"2346":{"id":"/php/php-changesets/latest/development-9","page_id":"/php/php-changesets/latest/development","tags":[],"type":"text","url":"/php/php-changesets/latest/development#architecture","content":"| Component        | Responsibility                                                                                                                                                                                                                                                                                                                                                                                                                                                           |\n| ---------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `Release_Engine` | Load the configuration and changesets, plan the versions, turn them into pre-releases for `--prerelease` or snapshots for `--snapshot`, version only the `--package` selection, format the changelog and readme changelog entries with the hooks, and build one ordered in-memory edit plan. It also finds the changed packages without a changeset since a ref, and creates and pushes the tags that released versions still need, with their titles and release notes. |","table":"table-0"},"2347":{"id":"/php/php-changesets/latest/development-10","page_id":"/php/php-changesets/latest/development","tags":[],"type":"text","url":"/php/php-changesets/latest/development#architecture","content":"| Component | Responsibility                                                                                                                                       |\n| --------- | ---------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `Semver`  | Parse, bump and compare the supported stable and pre-release versions, and number the pre-release versions of the stable plan from the package tags. |","table":"table-0"},"2348":{"id":"/php/php-changesets/latest/development-11","page_id":"/php/php-changesets/latest/development","tags":[],"type":"text","url":"/php/php-changesets/latest/development#architecture","content":"| Component    | Responsibility                                                                                                                   |\n| ------------ | -------------------------------------------------------------------------------------------------------------------------------- |\n| `Tag_Format` | Expand the `{name}`, `{path}` and `{version}` placeholders of tag formats and git-tag patterns, like `wp-release` `formatTag()`. |","table":"table-0"},"2349":{"id":"/php/php-changesets/latest/development-12","page_id":"/php/php-changesets/latest/development","tags":[],"type":"text","url":"/php/php-changesets/latest/development#architecture","content":"| Component                                | Responsibility                                                                                                                                     |\n| ---------------------------------------- | -------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `Changeset_Reader` and `Version_Planner` | Read ordered multi-package changesets and assemble the `releases[]` plan of every package, with the highest bump, next version, tag and changelog. |","table":"table-0"},"2350":{"id":"/php/php-changesets/latest/development-13","page_id":"/php/php-changesets/latest/development","tags":[],"type":"text","url":"/php/php-changesets/latest/development#architecture","content":"| Component       | Responsibility                                                                         |\n| --------------- | -------------------------------------------------------------------------------------- |\n| `Version_Files` | Resolve version descriptors and propose bounded in-memory edits without writing files. |","table":"table-0"},"2351":{"id":"/php/php-changesets/latest/development-14","page_id":"/php/php-changesets/latest/development","tags":[],"type":"text","url":"/php/php-changesets/latest/development#architecture","content":"| Component             | Responsibility                                                                                                                           |\n| --------------------- | ---------------------------------------------------------------------------------------------------------------------------------------- |\n| `Release_Transaction` | Check the expected contents, journal and stage the edits of every package, apply them as one transaction and recover interrupted writes. |","table":"table-0"},"2352":{"id":"/php/php-changesets/latest/development-15","page_id":"/php/php-changesets/latest/development","tags":[],"type":"text","url":"/php/php-changesets/latest/development#architecture","content":"`Project_Config`, `Version_Files`, `Release_Engine` and `Release_Transaction` are instance-based and receive `Project_Files` through their constructors. Constructors only store their dependencies, and the optional `Git`, `Semver` and `Tag_Format` arguments of `Release_Engine`, `Version_Files` and `Version_Planner` default to new instances, so tests can replace them. Validation errors are `Release_Exception`s, which exit with code 2 and can list problems with their files and lines for annotations. Package directories come from `Package_Discovery` in configured group order; the engine plans one release per discovered package and applies their combined edits as one transaction."},"2353":{"id":"/php/php-changesets/latest/development-16","page_id":"/php/php-changesets/latest/development","tags":[],"type":"text","url":"/php/php-changesets/latest/development#architecture","content":"`status` and `version --dry-run` only inspect the plan. `version` passes the same edits to the transaction layer. Only the CLI's `init` and `add` commands and the transaction layer write project files."},"2354":{"id":"/php/php-changesets/latest/development-17","page_id":"/php/php-changesets/latest/development","tags":[],"type":"text","url":"/php/php-changesets/latest/development#architecture","content":"PHP methods, parameters and local variables use snake_case. External JSON and configuration keys such as `currentVersion`, `nextVersion`, `tagFormat`, `initialVersion` and `ifPresent` stay camelCase, since other tools read them."},"2355":{"id":"/php/php-changesets/latest/development-18","page_id":"/php/php-changesets/latest/development","tags":[],"type":"text","url":"/php/php-changesets/latest/development#architecture","content":"Releases use the monorepo's `wp-release` workflow and are split to github.com/wpelevator/php-changesets."},"2356":{"id":"/php/php-changesets/latest/github-actions","page_id":"/php/php-changesets/latest/github-actions","type":"page","content":"GitHub Actions","breadcrumbs":["Docs","Php","Php changesets","Latest"],"tags":[],"url":"/php/php-changesets/latest/github-actions"},"2357":{"id":"/php/php-changesets/latest/github-actions-0","page_id":"/php/php-changesets/latest/github-actions","type":"heading","tags":[],"url":"/php/php-changesets/latest/github-actions#release-with-github-actions","content":"Release with GitHub Actions"},"2358":{"id":"/php/php-changesets/latest/github-actions-1","page_id":"/php/php-changesets/latest/github-actions","type":"heading","tags":[],"url":"/php/php-changesets/latest/github-actions#check-pull-requests","content":"Check pull requests"},"2359":{"id":"/php/php-changesets/latest/github-actions-2","page_id":"/php/php-changesets/latest/github-actions","type":"heading","tags":[],"url":"/php/php-changesets/latest/github-actions#release","content":"Release"},"2360":{"id":"/php/php-changesets/latest/github-actions-3","page_id":"/php/php-changesets/latest/github-actions","tags":[],"type":"text","url":"/php/php-changesets/latest/github-actions#release-with-github-actions","content":"The CLI prepares releases, and other actions publish them. These workflows check that pull requests add changesets, open a release pull request whenever changesets are pending on `main`, and after it's merged, create the tag and GitHub release of every released package. Packagist picks up the new tags of Composer packages; add the WP Release Zip and WP Release Deploy SVN actions to the `release` job to ship a WordPress plugin."},"2361":{"id":"/php/php-changesets/latest/github-actions-4","page_id":"/php/php-changesets/latest/github-actions","tags":[],"type":"text","url":"/php/php-changesets/latest/github-actions#check-pull-requests","content":"A pull request that changes a package without adding a changeset fails with an annotation on a changed file of the package and a job summary of the changed packages. Contributors fix it with `changeset add`, or with `changeset add --empty` for a change that needs no release."},"2362":{"id":"/php/php-changesets/latest/github-actions-5","page_id":"/php/php-changesets/latest/github-actions","tags":[],"type":"text","url":"/php/php-changesets/latest/github-actions#release","content":"The jobs need the full history (`fetch-depth: 0`) for the tags. `tag --untagged` lists the releases that still need a tag, and each `release` job tags one of them, checking that the package is at the listed version, and pushes the tag. The release notes come from the changelog section of each released version, and the titles are `name@version`, or the version for a package at the repository root, like `wp-release`. Tags pushed with the `GITHUB_TOKEN` don't trigger other workflows; pass a personal access token or GitHub App token to `actions/checkout` when a tag push should start one, like a Packagist or WordPress.org deploy."},"2363":{"id":"/php/php-changesets/latest","page_id":"/php/php-changesets/latest","type":"page","content":"PHP Changesets","breadcrumbs":["Docs","Php","Php changesets","Latest"],"tags":[],"url":"/php/php-changesets/latest"},"2364":{"id":"/php/php-changesets/latest-0","page_id":"/php/php-changesets/latest","tags":[],"type":"text","url":"/php/php-changesets/latest","content":"Prepare multi-package releases for PHP projects and monorepos with changeset Markdown files, PHP and Git."},"2365":{"id":"/php/php-changesets/latest-1","page_id":"/php/php-changesets/latest","type":"heading","tags":[],"url":"/php/php-changesets/latest#requirements","content":"Requirements"},"2366":{"id":"/php/php-changesets/latest-2","page_id":"/php/php-changesets/latest","type":"heading","tags":[],"url":"/php/php-changesets/latest#install","content":"Install"},"2367":{"id":"/php/php-changesets/latest-3","page_id":"/php/php-changesets/latest","type":"heading","tags":[],"url":"/php/php-changesets/latest#quickstart","content":"Quickstart"},"2368":{"id":"/php/php-changesets/latest-4","page_id":"/php/php-changesets/latest","type":"heading","tags":[],"url":"/php/php-changesets/latest#guides","content":"Guides"},"2369":{"id":"/php/php-changesets/latest-5","page_id":"/php/php-changesets/latest","tags":[],"type":"text","url":"/php/php-changesets/latest","content":"`wpelevator/php-changesets` releases WordPress plugins, themes and Composer packages from changeset Markdown files, with PHP and Git and without Node.js. It's for projects that don't use Node.js or JavaScript tooling: a Composer dependency replaces an npm one, and nothing needs installing in CI beyond PHP. It follows the release model of `wp-release`, the Node.js release tool of WP Elevator, so both tools read the same changesets, take the same command options and produce the same release plans."},"2370":{"id":"/php/php-changesets/latest-6","page_id":"/php/php-changesets/latest","tags":[],"type":"text","url":"/php/php-changesets/latest","content":"If your project already builds with Node.js, or you also want ZIPs, checksums, translations or WordPress.org deploys, use the `wp-release` changeset commands instead. The comparison lists the differences."},"2371":{"id":"/php/php-changesets/latest-7","page_id":"/php/php-changesets/latest","tags":[],"type":"text","url":"/php/php-changesets/latest","content":"Contributors describe each change in a small Markdown file. When you release, the `changeset` command bumps the versions of every changed package, writes the changelogs and creates the release tags. It never commits or publishes: those steps belong to your workflow, like the GitHub Actions workflow."},"2372":{"id":"/php/php-changesets/latest-8","page_id":"/php/php-changesets/latest","tags":[],"type":"text","url":"/php/php-changesets/latest#requirements","content":"PHP 7.4 or later."},"2373":{"id":"/php/php-changesets/latest-9","page_id":"/php/php-changesets/latest","tags":[],"type":"text","url":"/php/php-changesets/latest#requirements","content":"Git for tag-based versions, changed-package checks, release tags and dry-run diffs."},"2374":{"id":"/php/php-changesets/latest-10","page_id":"/php/php-changesets/latest","tags":[],"type":"text","url":"/php/php-changesets/latest#requirements","content":"Composer to install the CLI. Node.js is not required."},"2375":{"id":"/php/php-changesets/latest-11","page_id":"/php/php-changesets/latest","tags":[],"type":"text","url":"/php/php-changesets/latest#quickstart","content":"For a WordPress plugin or a Composer package at the repository root:"},"2376":{"id":"/php/php-changesets/latest-12","page_id":"/php/php-changesets/latest","tags":[],"type":"text","url":"/php/php-changesets/latest#guides","content":"Command line: the commands, changesets, the status check, releases, pre-releases, output formats and exit codes."},"2377":{"id":"/php/php-changesets/latest-13","page_id":"/php/php-changesets/latest","tags":[],"type":"text","url":"/php/php-changesets/latest#guides","content":"Configuration: `changesets.config.php`, package groups, version descriptors and hooks."},"2378":{"id":"/php/php-changesets/latest-14","page_id":"/php/php-changesets/latest","tags":[],"type":"text","url":"/php/php-changesets/latest#guides","content":"GitHub Actions: check pull requests for changesets, open release pull requests and create the tags and GitHub releases."},"2379":{"id":"/php/php-changesets/latest-15","page_id":"/php/php-changesets/latest","tags":[],"type":"text","url":"/php/php-changesets/latest#guides","content":"Comparison with wp-release: the command mapping and the deliberate differences."},"2380":{"id":"/php/php-changesets/latest-16","page_id":"/php/php-changesets/latest","tags":[],"type":"text","url":"/php/php-changesets/latest#guides","content":"Development: the architecture and tests of the package."},"2381":{"id":"/php/php-changesets/v2.0.0/cli","page_id":"/php/php-changesets/v2.0.0/cli","type":"page","content":"Command line","breadcrumbs":["Docs","Php","Php changesets","v2.0.0"],"tags":[],"url":"/php/php-changesets/v2.0.0/cli"},"2382":{"id":"/php/php-changesets/v2.0.0/cli-0","page_id":"/php/php-changesets/v2.0.0/cli","type":"heading","tags":[],"url":"/php/php-changesets/v2.0.0/cli#commands","content":"Commands"},"2383":{"id":"/php/php-changesets/v2.0.0/cli-1","page_id":"/php/php-changesets/v2.0.0/cli","type":"heading","tags":[],"url":"/php/php-changesets/v2.0.0/cli#add-a-changeset","content":"Add a changeset"},"2384":{"id":"/php/php-changesets/v2.0.0/cli-2","page_id":"/php/php-changesets/v2.0.0/cli","type":"heading","tags":[],"url":"/php/php-changesets/v2.0.0/cli#check-pull-requests-for-changesets","content":"Check pull requests for changesets"},"2385":{"id":"/php/php-changesets/v2.0.0/cli-3","page_id":"/php/php-changesets/v2.0.0/cli","type":"heading","tags":[],"url":"/php/php-changesets/v2.0.0/cli#preview-and-apply-a-release","content":"Preview and apply a release"},"2386":{"id":"/php/php-changesets/v2.0.0/cli-4","page_id":"/php/php-changesets/v2.0.0/cli","type":"heading","tags":[],"url":"/php/php-changesets/v2.0.0/cli#version-some-packages","content":"Version some packages"},"2387":{"id":"/php/php-changesets/v2.0.0/cli-5","page_id":"/php/php-changesets/v2.0.0/cli","type":"heading","tags":[],"url":"/php/php-changesets/v2.0.0/cli#tags-and-release-notes","content":"Tags and release notes"},"2388":{"id":"/php/php-changesets/v2.0.0/cli-6","page_id":"/php/php-changesets/v2.0.0/cli","type":"heading","tags":[],"url":"/php/php-changesets/v2.0.0/cli#pre-releases","content":"Pre-releases"},"2389":{"id":"/php/php-changesets/v2.0.0/cli-7","page_id":"/php/php-changesets/v2.0.0/cli","type":"heading","tags":[],"url":"/php/php-changesets/v2.0.0/cli#github-actions-output","content":"GitHub Actions output"},"2390":{"id":"/php/php-changesets/v2.0.0/cli-8","page_id":"/php/php-changesets/v2.0.0/cli","type":"heading","tags":[],"url":"/php/php-changesets/v2.0.0/cli#annotations-and-job-summaries","content":"Annotations and job summaries"},"2391":{"id":"/php/php-changesets/v2.0.0/cli-9","page_id":"/php/php-changesets/v2.0.0/cli","type":"heading","tags":[],"url":"/php/php-changesets/v2.0.0/cli#exit-codes","content":"Exit codes"},"2392":{"id":"/php/php-changesets/v2.0.0/cli-10","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#commands","content":"Run commands from the project root, or pass `--root DIRECTORY`."},"2393":{"id":"/php/php-changesets/v2.0.0/cli-11","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#commands","content":"| Command          | Purpose and options                                                                                                                                                                                                                                                                                                                                                                                                                                |\n| ---------------- | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `changeset init` | Create the changeset directory and, when no config exists, write a `changesets.config.php` scaffold from the inferred project settings. Inference adds a `packages/*` group only when every matched directory declares a Composer name and version; otherwise the scaffold stays one group and carries a commented template that shows how to add more groups. A plugin scaffold also carries the opt-in `readmeChangelog` setting, commented out. |","table":"table-0"},"2394":{"id":"/php/php-changesets/v2.0.0/cli-12","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#commands","content":"| Command         | Purpose and options                                                                                                                                                                                                    |       |                                                                                                                                                                                                                                                                                                                                   |\n| --------------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | ----- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `changeset add` | Add a changeset. Prompts for the affected packages, their bumps and the summary in a terminal; without one, pass `--package NAME` for each affected package, or `--since REF` for the changed ones, plus `--bump patch | minor | major --summary TEXT`. A package can be named by its identifier or its path under the configured root, like `plugins/alpha`. One `--bump` applies to every selected package; repeat `--bump` after each `--package` to give each its own bump. Use `--empty` for a no-release changeset, or `--name NAME` to choose the filename. |","table":"table-0"},"2395":{"id":"/php/php-changesets/v2.0.0/cli-13","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#commands","content":"| Command            | Purpose and options                                                                                                                                                                                         |\n| ------------------ | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `changeset status` | Show the pending release plan. With `--since REF`, or the configured base branch, also check that every package changed since then has a changeset added since then, and exit with code 2 when one doesn't. |","table":"table-0"},"2396":{"id":"/php/php-changesets/v2.0.0/cli-14","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#commands","content":"| Command             | Purpose and options                                                                                                                                                                                                                                                                                                                                                     |\n| ------------------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `changeset version` | Apply the pending release plan. Use `--dry-run` to preview it without writes, `--date YYYY-MM-DD` to set the changelog date, `--package NAME\\|PATH` (repeatable) to version only some packages, `--prerelease ID` to release pre-releases instead, like `--prerelease rc` or `--prerelease rc.2`, and `--snapshot ID` for snapshots like `1.3.0-pr-251.20261012183005`. |","table":"table-0"},"2397":{"id":"/php/php-changesets/v2.0.0/cli-15","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#commands","content":"| Command         | Purpose and options                                                                                                                                                                                                                                                                                                                                                                                                            |\n| --------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `changeset tag` | Create the missing release tags of the current versions. Use `--dry-run` or `--untagged` to list them without creating any, `--since REF` to tag only the packages changed since `REF`, `--package NAME\\|PATH` (repeatable) to tag only some packages, `--version VERSION` to fail unless the one selected package is at that version, `--release-title TEMPLATE` to title the releases and `--push` to push the created tags. |","table":"table-0"},"2398":{"id":"/php/php-changesets/v2.0.0/cli-16","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#commands","content":"| Command             | Purpose and options                                              |\n| ------------------- | ---------------------------------------------------------------- |\n| `changeset recover` | Restore original files after an interrupted release transaction. |","table":"table-0"},"2399":{"id":"/php/php-changesets/v2.0.0/cli-17","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#commands","content":"Every command accepts these global options:"},"2400":{"id":"/php/php-changesets/v2.0.0/cli-18","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#commands","content":"| Option             | Purpose                                         |\n| ------------------ | ----------------------------------------------- |\n| `--root DIRECTORY` | Project root, the current directory by default. |","table":"table-1"},"2401":{"id":"/php/php-changesets/v2.0.0/cli-19","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#commands","content":"| Option          | Purpose                                                                                                      |\n| --------------- | ------------------------------------------------------------------------------------------------------------ |\n| `--config PATH` | Config file to load instead of `changesets.config.php`; a relative path resolves from the current directory. |","table":"table-1"},"2402":{"id":"/php/php-changesets/v2.0.0/cli-20","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#commands","content":"| Option                | Purpose                                                                                                                                                                                           |\n| --------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `--tag-format FORMAT` | Replace the tag format of the config and of every package group for one command, like `--tag-format '{name}@{version}'`. Pass the same format to every command that reads or plans the same tags. |","table":"table-1"},"2403":{"id":"/php/php-changesets/v2.0.0/cli-21","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#commands","content":"| Option                | Purpose                                                                                                                                                                                                              |\n| --------------------- | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `--project-name NAME` | Identifier of an inferred root package, for a project without a config or a Composer `name`, so that local checkouts and CI don't depend on the directory name. A config sets the same identifier with a group `id`. |","table":"table-1"},"2404":{"id":"/php/php-changesets/v2.0.0/cli-22","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#commands","content":"| Option                 | Purpose                                                                                                                        |\n| ---------------------- | ------------------------------------------------------------------------------------------------------------------------------ |\n| `--base-branch BRANCH` | Branch on the remote that `status` and `add` compare with when there's no `--since`, replacing the `baseBranch` of the config. |","table":"table-1"},"2405":{"id":"/php/php-changesets/v2.0.0/cli-23","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#commands","content":"| Option          | Purpose                                                                                                       |\n| --------------- | ------------------------------------------------------------------------------------------------------------- |\n| `--remote NAME` | Git remote of the base branch and of `tag --push`, replacing the `remote` of the config, `origin` by default. |","table":"table-1"},"2406":{"id":"/php/php-changesets/v2.0.0/cli-24","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#commands","content":"| Option   | Purpose                   |\n| -------- | ------------------------- |\n| `--json` | Print the result as JSON. |","table":"table-1"},"2407":{"id":"/php/php-changesets/v2.0.0/cli-25","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#commands","content":"| Option            | Purpose                                        |\n| ----------------- | ---------------------------------------------- |\n| `--github-output` | Set the result as GitHub Actions step outputs. |","table":"table-1"},"2408":{"id":"/php/php-changesets/v2.0.0/cli-26","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#commands","content":"| Option                      | Purpose                                                                |\n| --------------------------- | ---------------------------------------------------------------------- |\n| `--log-format text\\|github` | Log as plain text, or as GitHub Actions annotations and job summaries. |","table":"table-1"},"2409":{"id":"/php/php-changesets/v2.0.0/cli-27","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#commands","content":"| Option | Purpose                              |\n| ------ | ------------------------------------ |\n| `--ci` | Shorthand for `--log-format github`. |","table":"table-1"},"2410":{"id":"/php/php-changesets/v2.0.0/cli-28","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#commands","content":"The CLI does not commit or publish, and only `tag` creates and, with `--push`, pushes tags. Review and commit version and changelog changes separately. A second `version` run with no pending changesets makes no release edits."},"2411":{"id":"/php/php-changesets/v2.0.0/cli-29","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#add-a-changeset","content":"A changeset's frontmatter maps one or more package names to a `patch`, `minor` or `major` bump, and its body is a nonempty Markdown summary:"},"2412":{"id":"/php/php-changesets/v2.0.0/cli-30","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#add-a-changeset","content":"A single changeset may release several packages by listing one `package: bump` mapping per line, so the frontmatter is a `Record<package name, bump>` like `wp-release` expects. Commit the generated file with the change. With one package, `add` selects it automatically; with several, it prompts in a terminal or requires one repeatable `--package NAME` per affected package. Like `wp-release changeset-add`, `--package a --bump minor --package b --bump patch` writes a different bump per package:"},"2413":{"id":"/php/php-changesets/v2.0.0/cli-31","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#add-a-changeset","content":"With `--since REF`, `add` compares the changes since `REF`, including uncommitted and untracked files, since changesets are usually added before committing. The prompt marks the changed packages without a changeset and Enter selects them, and a single `--bump` without `--package` releases them, like `changeset add --since origin/main --bump patch --summary \"…\"` to fix a failing status check."},"2414":{"id":"/php/php-changesets/v2.0.0/cli-32","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#add-a-changeset","content":"Unknown package names, duplicated entries and unsupported YAML are rejected against the discovered package names. Multiple changesets aggregate with the highest bump per package and keep their changelog entries in filename order."},"2415":{"id":"/php/php-changesets/v2.0.0/cli-33","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#add-a-changeset","content":"Empty frontmatter records an explicit no-release decision and applies to every package, so `--empty` needs no package selection and is consumed by the next release of all of them."},"2416":{"id":"/php/php-changesets/v2.0.0/cli-34","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#check-pull-requests-for-changesets","content":"In CI, `changeset status --since origin/main` (or `changeset status` with a configured `baseBranch` of `main`) requires a changeset added by the pull request for every package that it changes. Changesets already on the base don't count, and an empty changeset added by the pull request records an explicit no-release decision. A package at the repository root owns every changed file. The command exits with code 2 and reports `Changed package \"…\" has no changeset.` for each missing one; with the `github` log format, the error is an annotation on a changed file of the package. `--since` needs the history of the base, so check out with `fetch-depth: 0`."},"2417":{"id":"/php/php-changesets/v2.0.0/cli-35","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#check-pull-requests-for-changesets","content":"The result adds `since`, `changedPackages`, `changedPackageFiles` with the changed files of each package, and `missingChangesets` to the release plan."},"2418":{"id":"/php/php-changesets/v2.0.0/cli-36","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#preview-and-apply-a-release","content":"`status --json` and `version --dry-run --json` print the `wp-release` release-plan shape: `changesets` with `file`, `packages` and `summary` items, and one `releases[]` item per discovered package with `package`, `currentVersion`, `bump`, `nextVersion`, `tag`, `changesets`, the `changelog` Markdown list added to `CHANGELOG.md` and the affected `paths`, in configured group order. A release without changesets has a null bump and tag. Dry-run JSON also includes one combined `diff` string with a `### {package}` section per release."},"2419":{"id":"/php/php-changesets/v2.0.0/cli-37","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#preview-and-apply-a-release","content":"`version` checks that each proposed tag does not exist, updates the configured version targets of every release, prepends a `## {version} ({date})` changelog section and consumes the changesets. Every package's targets are checked before any files are written, and the edits of all releases apply as one transaction, so a failure never leaves one package released and another pending. An interrupted write leaves a `.php-changesets-transaction/` journal and blocks `status` and `version`; run `changeset recover` before retrying."},"2420":{"id":"/php/php-changesets/v2.0.0/cli-38","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#version-some-packages","content":"To release packages separately, for example with a release pull request for each, pass `--package NAME`, repeatable, to version only those packages. A changeset that also names other packages keeps only their entries and its summary, so it still applies to their releases with the same bump. Changesets without packages are left for a run without `--package`."},"2421":{"id":"/php/php-changesets/v2.0.0/cli-39","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#version-some-packages","content":"`version --snapshot ID` releases snapshots of the next versions for test builds, like `1.3.0-pr-251.20261012183005` for a pull request: the next version with the identifier and the UTC time, so that every snapshot is unique and they sort by time. Snapshots can't be combined with `--prerelease`, and like a pre-release, a snapshot keeps the readme `Stable tag`. Build the versioned files without committing them, since a snapshot consumes the changesets."},"2422":{"id":"/php/php-changesets/v2.0.0/cli-40","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#tags-and-release-notes","content":"After merging a release, `changeset tag` creates the missing tags of the current versions, and `--push` pushes them to the remote one at a time, since GitHub doesn't trigger workflows for a push of more than three tags. Tags are created only when absent, so a rerun after a partial failure is safe, and every version target of a package must match the version before its tag is created. `--dry-run` lists the tags without creating them, and `--untagged` lists only the releases without a tag, for example to release each of them with a separate workflow."},"2423":{"id":"/php/php-changesets/v2.0.0/cli-41","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#tags-and-release-notes","content":"With `--json` or `--github-output`, each entry of `tags` has the `package`, `version`, `tag`, a `title`, the `previousTag` when there is one, a `prerelease` flag, whether the tag already `exists` or was `created`, and the release `notes`. The title is `name@version`, or the version for a package at the repository root, unless `releaseTitle` or `--release-title` sets a template with `{name}`, `{path}`, `{version}` and `{tag}` placeholders. The notes are the changelog section of the version, or without one the commits that changed the package since the previous tag, the highest version below the released one, skipping pre-releases for a stable version."},"2424":{"id":"/php/php-changesets/v2.0.0/cli-42","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#tags-and-release-notes","content":"To release a single package, pass `--package NAME` and `--version VERSION`, which fails unless the package is at that version; a sole package is selected without `--package`. A package versioned by Git tags has no version file, so `--version` is the version to tag, and without it the version is the changelog version above its latest tag. The tags are read from the local repository, so check out the full history with its tags."},"2425":{"id":"/php/php-changesets/v2.0.0/cli-43","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#pre-releases","content":"There is no pre mode and no state file. Pre-releases are a per-run transform of the release plan, like in `wp-release`: `changeset version --prerelease ID` computes the stable plan first, then turns every release's version into a pre-release of that stable version."},"2426":{"id":"/php/php-changesets/v2.0.0/cli-44","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#pre-releases","content":"A bare identifier like `rc` numbers one above the highest existing `<stable>-<identifier>.` version among the package's Git tags in its tag format, so the first pre-release of a stable version is `1.2.5-rc.1`. Tag each pre-release with the release workflow; the numbering counts those tags."},"2427":{"id":"/php/php-changesets/v2.0.0/cli-45","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#pre-releases","content":"An explicit `id.n` like `rc.2` is used as is, and a run fails when that exact version already exists among the tags."},"2428":{"id":"/php/php-changesets/v2.0.0/cli-46","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#pre-releases","content":"Versions have two to four numeric parts, like `X.Y.Z` and the `X.Y` and `X.Y.Z.W` versions common in WordPress plugins, with an optional pre-release like `X.Y.Z-<tag>.<n>`; build metadata is rejected. A bump keeps the number of parts, so a minor bump of `2.1` is `2.2`, like `wp-release`."},"2429":{"id":"/php/php-changesets/v2.0.0/cli-47","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#pre-releases","content":"A stable release of a pre-release current version graduates like `semver inc`: a patch of `1.2.4-rc.1` plans `1.2.4`, and a minor of `1.3.0-rc.1` plans `1.3.0`, while a minor of `1.2.4-rc.1` plans `1.3.0`."},"2430":{"id":"/php/php-changesets/v2.0.0/cli-48","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#pre-releases","content":"The readme `Stable tag` keeps the last stable version for a pre-release, since WordPress.org offers the stable tag to every site."},"2431":{"id":"/php/php-changesets/v2.0.0/cli-49","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#pre-releases","content":"With a `nextVersion` hook, the transform applies to the stable version that the hook returns."},"2432":{"id":"/php/php-changesets/v2.0.0/cli-50","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#pre-releases","content":"The recommended flow is the `wp-release` one: cut a pre-release on a branch that isn't merged with `changeset version --prerelease rc`, tag it with the release workflow, and later run `changeset version` without the flag on the base branch to release the stable version."},"2433":{"id":"/php/php-changesets/v2.0.0/cli-51","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#github-actions-output","content":"`--github-output` writes the complete result as compact JSON to the `result` step output and each top-level string, number or boolean, like the dry-run `diff`, as its own output, like `wp-release`. Arrays and objects stay in `result`, so read them with `fromJSON( steps.tag.outputs.result ).tags`."},"2434":{"id":"/php/php-changesets/v2.0.0/cli-52","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#annotations-and-job-summaries","content":"`--log-format github`, the default when `GITHUB_ACTIONS=true` and also selected by `--ci`, prints errors as workflow commands, so they show up as annotations on the run and on the files of a pull request. Version mismatches are annotated on the file and line of the version, and missing changesets on a changed file of the package. File paths are relative to `GITHUB_WORKSPACE`, or the current directory without it. Pass `--log-format text` for plain text in GitHub Actions."},"2435":{"id":"/php/php-changesets/v2.0.0/cli-53","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#annotations-and-job-summaries","content":"When `GITHUB_STEP_SUMMARY` is set, each command adds a section to the job summary of the run:"},"2436":{"id":"/php/php-changesets/v2.0.0/cli-54","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#annotations-and-job-summaries","content":"| Command  | Summary                                               |\n| -------- | ----------------------------------------------------- |\n| `status` | Each changed package with whether it has a changeset. |","table":"table-2"},"2437":{"id":"/php/php-changesets/v2.0.0/cli-55","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#annotations-and-job-summaries","content":"| Command   | Summary                                                               |\n| --------- | --------------------------------------------------------------------- |\n| `version` | A table of the package releases with their version changes and bumps. |","table":"table-2"},"2438":{"id":"/php/php-changesets/v2.0.0/cli-56","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#annotations-and-job-summaries","content":"| Command | Summary                                                                                         |\n| ------- | ----------------------------------------------------------------------------------------------- |\n| `tag`   | Each tag with its title, previous tag and status, and its release notes in a collapsed section. |","table":"table-2"},"2439":{"id":"/php/php-changesets/v2.0.0/cli-57","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#annotations-and-job-summaries","content":"A failed command adds its error to the summary, or a table of its problems with their files and lines."},"2440":{"id":"/php/php-changesets/v2.0.0/cli-58","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#exit-codes","content":"| Code | Meaning                               |\n| ---- | ------------------------------------- |\n| `0`  | Success, dry run, no changes, or help |","table":"table-3"},"2441":{"id":"/php/php-changesets/v2.0.0/cli-59","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#exit-codes","content":"| Code | Meaning                                          |\n| ---- | ------------------------------------------------ |\n| `1`  | Unexpected failure, such as a failed git command |","table":"table-3"},"2442":{"id":"/php/php-changesets/v2.0.0/cli-60","page_id":"/php/php-changesets/v2.0.0/cli","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/cli#exit-codes","content":"| Code | Meaning                                                                                                                    |\n| ---- | -------------------------------------------------------------------------------------------------------------------------- |\n| `2`  | Invalid options, failed release checks like a version mismatch or an existing tag, or changed packages without a changeset |","table":"table-3"},"2443":{"id":"/php/php-changesets/v2.0.0/comparison","page_id":"/php/php-changesets/v2.0.0/comparison","type":"page","content":"Comparison with wp-release","breadcrumbs":["Docs","Php","Php changesets","v2.0.0"],"tags":[],"url":"/php/php-changesets/v2.0.0/comparison"},"2444":{"id":"/php/php-changesets/v2.0.0/comparison-0","page_id":"/php/php-changesets/v2.0.0/comparison","type":"heading","tags":[],"url":"/php/php-changesets/v2.0.0/comparison#comparison-with-wp-release","content":"Comparison with wp-release"},"2445":{"id":"/php/php-changesets/v2.0.0/comparison-1","page_id":"/php/php-changesets/v2.0.0/comparison","type":"heading","tags":[],"url":"/php/php-changesets/v2.0.0/comparison#deliberate-differences","content":"Deliberate differences"},"2446":{"id":"/php/php-changesets/v2.0.0/comparison-2","page_id":"/php/php-changesets/v2.0.0/comparison","type":"heading","tags":[],"url":"/php/php-changesets/v2.0.0/comparison#excluded-by-design","content":"Excluded by design"},"2447":{"id":"/php/php-changesets/v2.0.0/comparison-3","page_id":"/php/php-changesets/v2.0.0/comparison","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/comparison#comparison-with-wp-release","content":"PHP Changesets is the PHP counterpart of the `changeset-*` commands of `wp-release`, for projects that release with PHP and Git alone and don't use Node.js or JavaScript. Choose `wp-release` when the project already has a Node.js toolchain, or needs its builds, ZIPs, translations and deploys, and PHP Changesets when Composer is the only package manager. Both read the same changeset files and print the same `releases[]` plan, so a repository can switch between them."},"2448":{"id":"/php/php-changesets/v2.0.0/comparison-4","page_id":"/php/php-changesets/v2.0.0/comparison","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/comparison#comparison-with-wp-release","content":"| PHP Changesets   | wp-release    | Notes                                                        |\n| ---------------- | ------------- | ------------------------------------------------------------ |\n| `changeset init` | No equivalent | Scaffolds `changesets.config.php` from the inferred project. |","table":"table-0"},"2449":{"id":"/php/php-changesets/v2.0.0/comparison-5","page_id":"/php/php-changesets/v2.0.0/comparison","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/comparison#comparison-with-wp-release","content":"| PHP Changesets  | wp-release      | Notes                                                       |\n| --------------- | --------------- | ----------------------------------------------------------- |\n| `changeset add` | `changeset-add` | Same options, including `--since` for the changed packages. |","table":"table-0"},"2450":{"id":"/php/php-changesets/v2.0.0/comparison-6","page_id":"/php/php-changesets/v2.0.0/comparison","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/comparison#comparison-with-wp-release","content":"| PHP Changesets     | wp-release         | Notes                                              |\n| ------------------ | ------------------ | -------------------------------------------------- |\n| `changeset status` | `changeset-status` | Same `--since` check, exit code and result fields. |","table":"table-0"},"2451":{"id":"/php/php-changesets/v2.0.0/comparison-7","page_id":"/php/php-changesets/v2.0.0/comparison","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/comparison#comparison-with-wp-release","content":"| PHP Changesets      | wp-release          | Notes                                    |\n| ------------------- | ------------------- | ---------------------------------------- |\n| `changeset version` | `changeset-version` | Same options, without `--no-dependents`. |","table":"table-0"},"2452":{"id":"/php/php-changesets/v2.0.0/comparison-8","page_id":"/php/php-changesets/v2.0.0/comparison","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/comparison#comparison-with-wp-release","content":"| PHP Changesets  | wp-release      | Notes                                              |\n| --------------- | --------------- | -------------------------------------------------- |\n| `changeset tag` | `changeset-tag` | Same options, including `--untagged` and `--push`. |","table":"table-0"},"2453":{"id":"/php/php-changesets/v2.0.0/comparison-9","page_id":"/php/php-changesets/v2.0.0/comparison","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/comparison#comparison-with-wp-release","content":"| PHP Changesets      | wp-release    | Notes                                                    |\n| ------------------- | ------------- | -------------------------------------------------------- |\n| `changeset recover` | No equivalent | Restores files after an interrupted release transaction. |","table":"table-0"},"2454":{"id":"/php/php-changesets/v2.0.0/comparison-10","page_id":"/php/php-changesets/v2.0.0/comparison","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/comparison#comparison-with-wp-release","content":"| PHP Changesets          | wp-release              | Notes                                                                                    |\n| ----------------------- | ----------------------- | ---------------------------------------------------------------------------------------- |\n| `changesets.config.php` | `wp-release.config.mjs` | `define_config()` and the descriptor functions mirror `defineConfig()` and its builders. |","table":"table-0"},"2455":{"id":"/php/php-changesets/v2.0.0/comparison-11","page_id":"/php/php-changesets/v2.0.0/comparison","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/comparison#comparison-with-wp-release","content":"They also share these conventions: `--json` and `--github-output` on every command, `--log-format github` annotations and job summaries, global `--config`, `--tag-format` and `--project-name`, the `remote` and `baseBranch` settings with their `--remote` and `--base-branch` options, the `{path}/{version}` tag format with `v{version}` for an inferred root project, and the exit codes 0, 1 and 2."},"2456":{"id":"/php/php-changesets/v2.0.0/comparison-12","page_id":"/php/php-changesets/v2.0.0/comparison","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/comparison#deliberate-differences","content":"The command is `changeset` with subcommands, like `changeset add`, where `wp-release` has `changeset-add` among its other commands. Run `changeset --help` for the commands."},"2457":{"id":"/php/php-changesets/v2.0.0/comparison-13","page_id":"/php/php-changesets/v2.0.0/comparison","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/comparison#deliberate-differences","content":"No single-project version flags like `--version-composer-json`: without a config, the project is inferred, and `changeset init` writes the inferred settings to `changesets.config.php` to change them."},"2458":{"id":"/php/php-changesets/v2.0.0/comparison-14","page_id":"/php/php-changesets/v2.0.0/comparison","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/comparison#deliberate-differences","content":"No `changelogInsertAfter`: new `CHANGELOG.md` sections go before the first version heading, and readme sections after the `== Changelog ==` heading."},"2459":{"id":"/php/php-changesets/v2.0.0/comparison-15","page_id":"/php/php-changesets/v2.0.0/comparison","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/comparison#deliberate-differences","content":"`tag` creates and pushes tags but not GitHub Releases. A workflow step like `softprops/action-gh-release` creates them from its result; see GitHub Actions."},"2460":{"id":"/php/php-changesets/v2.0.0/comparison-16","page_id":"/php/php-changesets/v2.0.0/comparison","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/comparison#deliberate-differences","content":"No `releaseNotes` callback: the release notes are the changelog section, or the commits since the previous tag."},"2461":{"id":"/php/php-changesets/v2.0.0/comparison-17","page_id":"/php/php-changesets/v2.0.0/comparison","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/comparison#deliberate-differences","content":"No library of primitives: the package is the config-driven CLI and its classes, without build, ZIP, checksum or deploy functions."},"2462":{"id":"/php/php-changesets/v2.0.0/comparison-18","page_id":"/php/php-changesets/v2.0.0/comparison","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/comparison#deliberate-differences","content":"A package at the repository root needs an `id`, a manifest name or `--project-name`, and the name of the checkout directory never names a package, so changesets keep working in forks, worktrees and CI."},"2463":{"id":"/php/php-changesets/v2.0.0/comparison-19","page_id":"/php/php-changesets/v2.0.0/comparison","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/comparison#deliberate-differences","content":"Only the literal `.` glob matches the package root, while in `wp-release` a pattern like `*` also matches it."},"2464":{"id":"/php/php-changesets/v2.0.0/comparison-20","page_id":"/php/php-changesets/v2.0.0/comparison","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/comparison#deliberate-differences","content":"A pre-release current version graduates like `semver inc` on a stable release, where `wp-release` rejects bumping one."},"2465":{"id":"/php/php-changesets/v2.0.0/comparison-21","page_id":"/php/php-changesets/v2.0.0/comparison","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/comparison#deliberate-differences","content":"Package groups can set their own `changelog` and `tagFormat`."},"2466":{"id":"/php/php-changesets/v2.0.0/comparison-22","page_id":"/php/php-changesets/v2.0.0/comparison","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/comparison#excluded-by-design","content":"These `wp-release` features are left out, and the CLI never commits or publishes versions. Their settings and options are rejected as unknown:"},"2467":{"id":"/php/php-changesets/v2.0.0/comparison-23","page_id":"/php/php-changesets/v2.0.0/comparison","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/comparison#excluded-by-design","content":"Fixed and linked version groups: every package releases from its own changesets and version descriptors."},"2468":{"id":"/php/php-changesets/v2.0.0/comparison-24","page_id":"/php/php-changesets/v2.0.0/comparison","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/comparison#excluded-by-design","content":"The dependents system and `version --no-dependents`: bundled or dependent packages release with their own changesets, not automatically after a source release."},"2469":{"id":"/php/php-changesets/v2.0.0/comparison-25","page_id":"/php/php-changesets/v2.0.0/comparison","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/comparison#excluded-by-design","content":"Publishing: no builds, ZIPs, i18n extraction, git commits, or package registry and WordPress.org deploys. The CLI only writes version, changelog and changeset files and creates the release tags."},"2470":{"id":"/php/php-changesets/v2.0.0/configuration","page_id":"/php/php-changesets/v2.0.0/configuration","type":"page","content":"Configuration","breadcrumbs":["Docs","Php","Php changesets","v2.0.0"],"tags":[],"url":"/php/php-changesets/v2.0.0/configuration"},"2471":{"id":"/php/php-changesets/v2.0.0/configuration-0","page_id":"/php/php-changesets/v2.0.0/configuration","type":"heading","tags":[],"url":"/php/php-changesets/v2.0.0/configuration#configuration","content":"Configuration"},"2472":{"id":"/php/php-changesets/v2.0.0/configuration-1","page_id":"/php/php-changesets/v2.0.0/configuration","type":"heading","tags":[],"url":"/php/php-changesets/v2.0.0/configuration#workspace-settings","content":"Workspace settings"},"2473":{"id":"/php/php-changesets/v2.0.0/configuration-2","page_id":"/php/php-changesets/v2.0.0/configuration","type":"heading","tags":[],"url":"/php/php-changesets/v2.0.0/configuration#hooks","content":"Hooks"},"2474":{"id":"/php/php-changesets/v2.0.0/configuration-3","page_id":"/php/php-changesets/v2.0.0/configuration","type":"heading","tags":[],"url":"/php/php-changesets/v2.0.0/configuration#version-descriptors","content":"Version descriptors"},"2475":{"id":"/php/php-changesets/v2.0.0/configuration-4","page_id":"/php/php-changesets/v2.0.0/configuration","type":"heading","tags":[],"url":"/php/php-changesets/v2.0.0/configuration#builder-helpers","content":"Builder helpers"},"2476":{"id":"/php/php-changesets/v2.0.0/configuration-5","page_id":"/php/php-changesets/v2.0.0/configuration","type":"heading","tags":[],"url":"/php/php-changesets/v2.0.0/configuration#callback-descriptors","content":"Callback descriptors"},"2477":{"id":"/php/php-changesets/v2.0.0/configuration-6","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#configuration","content":"The configuration lives in `changesets.config.php` at the project root, the analog of `wp-release.config.mjs`. The global `--config PATH` selects another file for one command."},"2478":{"id":"/php/php-changesets/v2.0.0/configuration-7","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#configuration","content":"With no config, `init` infers the single project from a root Composer manifest or WordPress plugin headers as one group, tagged `v{version}` like the `wp-release` single-project default. The package is named by its Composer `name`, or for a plugin without one, by the slug of its main plugin file, like `demo` for `demo.php`, never by the checkout directory. `--project-name NAME` names any other project without a config. Readme changelog updates are opt-in, like in `wp-release`, so the scaffold of a plugin carries `readmeChangelog` commented out. When every directory under `packages/*` declares a Composer name and version, inference adds a second group for them. Other layouts keep the single group, and the scaffold carries a commented template that shows how to add groups. The config lives outside the changeset directory, so `.changeset/` holds only the Markdown changesets and its `README.md`."},"2479":{"id":"/php/php-changesets/v2.0.0/configuration-8","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#configuration","content":"The loader rejects the removed formats `.php-changesets.json`, `.changeset/config.php` and `config/changesets.php` with guidance pointing at `changesets.config.php`. It also rejects the upstream Changesets `.changeset/config.json`, since both tools would read and consume the same changeset files."},"2480":{"id":"/php/php-changesets/v2.0.0/configuration-9","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#configuration","content":"The config file is regular PHP (loaded with `require`) and must return an array, normally the result of `define_config()`, which validates the settings and hooks eagerly at load time and returns their canonical shape. The config helpers are namespaced functions, the PHP analogs of the `wp-release` `defineConfig()` and descriptor builders; import them with `use function`."},"2481":{"id":"/php/php-changesets/v2.0.0/configuration-10","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#workspace-settings","content":"The canonical configuration is a workspace with package groups; a single-project config is one group covering the repository root:"},"2482":{"id":"/php/php-changesets/v2.0.0/configuration-11","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#workspace-settings","content":"| Key        | Required | Default | Purpose                                             |\n| ---------- | -------- | ------- | --------------------------------------------------- |\n| `packages` | Yes      | —       | Non-empty list of package groups, in release order. |","table":"table-0"},"2483":{"id":"/php/php-changesets/v2.0.0/configuration-12","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#workspace-settings","content":"| Key          | Required | Default      | Purpose                                                                         |\n| ------------ | -------- | ------------ | ------------------------------------------------------------------------------- |\n| `changesets` | No       | `.changeset` | Directory containing changeset Markdown files, relative to the repository root. |","table":"table-0"},"2484":{"id":"/php/php-changesets/v2.0.0/configuration-13","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#workspace-settings","content":"| Key         | Required | Default            | Purpose                                                                                                                                                                                                                                                                            |\n| ----------- | -------- | ------------------ | ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `tagFormat` | No       | `{path}/{version}` | Proposed tag format, like `plugins/alpha/1.2.0`, or `1.2.0` for a package at the root; must contain `{version}` exactly once and may use `{name}` and `{path}`. The default matches `wp-release`, and the global `--tag-format` replaces it and the group formats for one command. |","table":"table-0"},"2485":{"id":"/php/php-changesets/v2.0.0/configuration-14","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#workspace-settings","content":"| Key            | Required | Default | Purpose                                                                                                                                                                                                                                                                                                                                                                                |\n| -------------- | -------- | ------- | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `releaseTitle` | No       | `null`  | Title of the releases that `tag` reports, as a template with `{name}`, `{path}`, `{version}` and `{tag}` placeholders, like `'{version} (beta)'`, or a callable that receives `[ 'package' => [ 'name' => …, 'path' => … ], 'version' => …, 'tag' => … ]`. `null` titles them `name@version`, or the version for a package at the root. `--release-title` replaces it for one command. |","table":"table-0"},"2486":{"id":"/php/php-changesets/v2.0.0/configuration-15","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#workspace-settings","content":"| Key    | Required | Default | Purpose                                                                                |\n| ------ | -------- | ------- | -------------------------------------------------------------------------------------- |\n| `root` | No       | `null`  | Package path base that package globs resolve against; `null` uses the repository root. |","table":"table-0"},"2487":{"id":"/php/php-changesets/v2.0.0/configuration-16","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#workspace-settings","content":"| Key      | Required | Default  | Purpose                                            |\n| -------- | -------- | -------- | -------------------------------------------------- |\n| `remote` | No       | `origin` | Git remote of the base branch and of `tag --push`. |","table":"table-0"},"2488":{"id":"/php/php-changesets/v2.0.0/configuration-17","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#workspace-settings","content":"| Key          | Required | Default | Purpose                                                                                                             |\n| ------------ | -------- | ------- | ------------------------------------------------------------------------------------------------------------------- |\n| `baseBranch` | No       | `null`  | Branch on the remote that `status` and `add` compare with when there's no `--since`, like `main` for `origin/main`. |","table":"table-0"},"2489":{"id":"/php/php-changesets/v2.0.0/configuration-18","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#workspace-settings","content":"| Key         | Required | Default        | Purpose                                                                                    |\n| ----------- | -------- | -------------- | ------------------------------------------------------------------------------------------ |\n| `changelog` | No       | `CHANGELOG.md` | Default changelog path for groups. Set to an empty string to disable changelog generation. |","table":"table-0"},"2490":{"id":"/php/php-changesets/v2.0.0/configuration-19","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#workspace-settings","content":"| Key               | Required | Default | Purpose                                                                                                                                                                                                                                                   |\n| ----------------- | -------- | ------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `readmeChangelog` | No       | `false` | Also add a `= {version} =` section with one `*` bullet per changeset summary after the `== Changelog ==` heading of a package's `readme.txt` or `readme.md`, which WordPress.org shows, like `wp-release`. A readme without the heading is left as it is. |","table":"table-0"},"2491":{"id":"/php/php-changesets/v2.0.0/configuration-20","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#workspace-settings","content":"| Key           | Required | Default | Purpose                                                              |\n| ------------- | -------- | ------- | -------------------------------------------------------------------- |\n| `nextVersion` | No       | `null`  | Callable replacing the stable bump computation; see the hooks below. |","table":"table-0"},"2492":{"id":"/php/php-changesets/v2.0.0/configuration-21","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#workspace-settings","content":"| Key              | Required | Default | Purpose                                                                  |\n| ---------------- | -------- | ------- | ------------------------------------------------------------------------ |\n| `changelogEntry` | No       | `null`  | Callable formatting one changeset's changelog line; see the hooks below. |","table":"table-0"},"2493":{"id":"/php/php-changesets/v2.0.0/configuration-22","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#workspace-settings","content":"Each package group sets:"},"2494":{"id":"/php/php-changesets/v2.0.0/configuration-23","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#workspace-settings","content":"| Key    | Required | Default | Purpose                                                                               |\n| ------ | -------- | ------- | ------------------------------------------------------------------------------------- |\n| `glob` | Yes      | —       | Relative path pattern for package directories, like `packages/*` or `.` for the root. |","table":"table-1"},"2495":{"id":"/php/php-changesets/v2.0.0/configuration-24","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#workspace-settings","content":"| Key       | Required | Default | Purpose                                                |\n| --------- | -------- | ------- | ------------------------------------------------------ |\n| `exclude` | No       | `[]`    | Relative path patterns removed from the group matches. |","table":"table-1"},"2496":{"id":"/php/php-changesets/v2.0.0/configuration-25","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#workspace-settings","content":"| Key  | Required | Default | Purpose                                                                                                 |\n| ---- | -------- | ------- | ------------------------------------------------------------------------------------------------------- |\n| `id` | No       | `null`  | Fixed package identifier for a glob that matches exactly one directory; takes precedence over `idFrom`. |","table":"table-1"},"2497":{"id":"/php/php-changesets/v2.0.0/configuration-26","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#workspace-settings","content":"| Key      | Required | Default | Purpose                                                                                                                                                                                                                                                                                                  |\n| -------- | -------- | ------- | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `idFrom` | No       | `path`  | Package name source: `composer.json#name`, `package.json#name`, or `path`. The package at the root (`.`) has no path, so it needs an `id` or a manifest source. Unlike in `wp-release`, the name of the checkout directory never names a package, so changesets keep working in forks, worktrees and CI. |","table":"table-1"},"2498":{"id":"/php/php-changesets/v2.0.0/configuration-27","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#workspace-settings","content":"| Key       | Required | Default | Purpose                                                       |\n| --------- | -------- | ------- | ------------------------------------------------------------- |\n| `version` | Yes      | —       | `{ from, to }` descriptors; every releasable group needs one. |","table":"table-1"},"2499":{"id":"/php/php-changesets/v2.0.0/configuration-28","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#workspace-settings","content":"| Key         | Required | Default   | Purpose                                                                                                                                     |\n| ----------- | -------- | --------- | ------------------------------------------------------------------------------------------------------------------------------------------- |\n| `changelog` | No       | Inherited | Per-package changelog path; empty string disables, `null` inherits. `wp-release` has no per-group setting and always writes `CHANGELOG.md`. |","table":"table-1"},"2500":{"id":"/php/php-changesets/v2.0.0/configuration-29","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#workspace-settings","content":"| Key         | Required | Default   | Purpose                                                                                |\n| ----------- | -------- | --------- | -------------------------------------------------------------------------------------- |\n| `tagFormat` | No       | Inherited | Per-package tag format; `null` inherits. `wp-release` only has the repository setting. |","table":"table-1"},"2501":{"id":"/php/php-changesets/v2.0.0/configuration-30","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#workspace-settings","content":"Discovery walks the directories below `root`, bounded by the deepest configured glob, and never enters `.git`, `node_modules`, `vendor` or `dist`. A glob that matches no directory, and duplicate package identifiers across groups, are configuration errors. Only the literal `.` glob matches the package root. Patterns like `*` and `packages/**` never cover it, while in `wp-release` a pattern like `*` also matches the root. Group settings and descriptor files must resolve inside the package, like all project paths."},"2502":{"id":"/php/php-changesets/v2.0.0/configuration-31","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#workspace-settings","content":"A monorepo config lists one group per package kind; releases stay in configured group order:"},"2503":{"id":"/php/php-changesets/v2.0.0/configuration-32","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#hooks","content":"Callbacks are plain PHP closures and live only in the PHP config; nothing else in the schema accepts callables, and callability is validated at config load. A failing hook, or a `nextVersion` result that is not a supported version, stops the run with a message naming the package."},"2504":{"id":"/php/php-changesets/v2.0.0/configuration-33","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#hooks","content":"`nextVersion` receives `{ package, bump, currentVersion, changesets }`, like the `wp-release` `NextVersionInput`, where `package` is `{ name, path, currentVersion }` and `changesets` lists the release's changeset records, and it returns the supported stable version of the release. A `--prerelease` run turns that version into a pre-release afterwards, as without a hook:"},"2505":{"id":"/php/php-changesets/v2.0.0/configuration-34","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#hooks","content":"`changelogEntry` receives `{ package, changeset }` where `changeset` is the record with `file`, `packages` and `summary`, and formats one changeset's changelog line, replacing the default `- {summary}` bullet. An empty result falls back to the default entry:"},"2506":{"id":"/php/php-changesets/v2.0.0/configuration-35","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#version-descriptors","content":"| `kind`          | Fields | Source or target behavior                                                                                                                                        |\n| --------------- | ------ | ---------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `composer-json` | `file` | Read or replace the top-level Composer `version` while preserving surrounding formatting. A target with `ifPresent: true` is skipped when the version is absent. |","table":"table-2"},"2507":{"id":"/php/php-changesets/v2.0.0/configuration-36","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#version-descriptors","content":"| `kind`                    | Fields | Source or target behavior                    |\n| ------------------------- | ------ | -------------------------------------------- |\n| `wordpress-plugin-header` | `file` | Read or replace the plugin `Version` header. |","table":"table-2"},"2508":{"id":"/php/php-changesets/v2.0.0/configuration-37","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#version-descriptors","content":"| `kind`                   | Fields | Source or target behavior                                                           |\n| ------------------------ | ------ | ----------------------------------------------------------------------------------- |\n| `wordpress-theme-header` | `file` | Read or replace the theme stylesheet `Version` header, over `style.css` by default. |","table":"table-2"},"2509":{"id":"/php/php-changesets/v2.0.0/configuration-38","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#version-descriptors","content":"| `kind`                 | Fields | Source or target behavior                                                                                             |\n| ---------------------- | ------ | --------------------------------------------------------------------------------------------------------------------- |\n| `wordpress-stable-tag` | `file` | Read or replace the readme `Stable tag`. A target with `ifPresent: true` is skipped when the file or value is absent. |","table":"table-2"},"2510":{"id":"/php/php-changesets/v2.0.0/configuration-39","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#version-descriptors","content":"| `kind`         | Fields             | Source or target behavior                                                               |\n| -------------- | ------------------ | --------------------------------------------------------------------------------------- |\n| `php-constant` | `file`, `constant` | Read or replace a `const` declaration or `define()` value with the given constant name. |","table":"table-2"},"2511":{"id":"/php/php-changesets/v2.0.0/configuration-40","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#version-descriptors","content":"| `kind`    | Fields                               | Source or target behavior                                                                                                                                                                                                                                       |\n| --------- | ------------------------------------ | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `git-tag` | `pattern`, optional `initialVersion` | Read the highest tag by version precedence matching `pattern`, which defaults to the package's tag format and also expands `{name}` and `{path}`; pre-release tags rank below the stable version of the same base. Source only; use an empty `version.to` list. |","table":"table-2"},"2512":{"id":"/php/php-changesets/v2.0.0/configuration-41","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#version-descriptors","content":"| `kind`     | Fields                                | Source or target behavior                                                  |\n| ---------- | ------------------------------------- | -------------------------------------------------------------------------- |\n| `callback` | `file`, `resolve`, optional `replace` | Resolve and replace a custom version span, available in every config path. |","table":"table-2"},"2513":{"id":"/php/php-changesets/v2.0.0/configuration-42","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#builder-helpers","content":"Version descriptors are built with functions in the `WPElevator\\PHP_Changesets` namespace, which Composer autoloads: `composer_json_version( ?string $file, bool $if_present )`, `wordpress_plugin_version( ?string $file )`, `wordpress_theme_version( ?string $file )` (`style.css` by default) and `wordpress_stable_tag( ?string $file, bool $if_present )` for the manifest, header and readme kinds, `php_constant_version( string $file, string $constant )` for constants, `git_tag_version( ?string $pattern, ?string $initial_version )` for tag-only sources, and `callback_version( string $file, callable $resolve, ?callable $replace )` for custom spans."},"2514":{"id":"/php/php-changesets/v2.0.0/configuration-43","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#builder-helpers","content":"`define_config( array $config )` validates a workspace configuration when it loads, rejects unknown or malformed settings and returns the canonical shape that the other classes read."},"2515":{"id":"/php/php-changesets/v2.0.0/configuration-44","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#builder-helpers","content":"A Git-tag-only library needs a first tag, like `git tag v0.1.0`, or an initial version for its first release:"},"2516":{"id":"/php/php-changesets/v2.0.0/configuration-45","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#builder-helpers","content":"Once a matching stable tag exists, it takes precedence over `initialVersion`. Tag-only releases do not modify `composer.json`: the release is recorded in the changelog, and `tag` tags the changelog version above the latest tag."},"2517":{"id":"/php/php-changesets/v2.0.0/configuration-46","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#callback-descriptors","content":"Use `callback_version()` when the built-in descriptors can't find the version. Its callables must return the same result for the same contents and must not write files:"},"2518":{"id":"/php/php-changesets/v2.0.0/configuration-47","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#callback-descriptors","content":"`resolve( string $contents ): ?array` returns the version `value`, zero-based byte `offset` and byte `length`, or `null` when absent. The span must contain exactly `value`."},"2519":{"id":"/php/php-changesets/v2.0.0/configuration-48","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#callback-descriptors","content":"`replace( string $contents, string $old_version, string $new_version ): string` optionally returns the complete proposed contents. Without it, only the resolved span is replaced."},"2520":{"id":"/php/php-changesets/v2.0.0/configuration-49","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#callback-descriptors","content":"After either replacement, `resolve` must find the new version. `resolve` runs for status and planning; `replace` runs whenever a bump is planned, including dry runs."},"2521":{"id":"/php/php-changesets/v2.0.0/configuration-50","page_id":"/php/php-changesets/v2.0.0/configuration","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/configuration#callback-descriptors","content":"The same descriptor can be the source and a target:"},"2522":{"id":"/php/php-changesets/v2.0.0/development","page_id":"/php/php-changesets/v2.0.0/development","type":"page","content":"Development","breadcrumbs":["Docs","Php","Php changesets","v2.0.0"],"tags":[],"url":"/php/php-changesets/v2.0.0/development"},"2523":{"id":"/php/php-changesets/v2.0.0/development-0","page_id":"/php/php-changesets/v2.0.0/development","type":"heading","tags":[],"url":"/php/php-changesets/v2.0.0/development#development","content":"Development"},"2524":{"id":"/php/php-changesets/v2.0.0/development-1","page_id":"/php/php-changesets/v2.0.0/development","type":"heading","tags":[],"url":"/php/php-changesets/v2.0.0/development#architecture","content":"Architecture"},"2525":{"id":"/php/php-changesets/v2.0.0/development-2","page_id":"/php/php-changesets/v2.0.0/development","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/development#development","content":"Classes live in `php/` with Composer classmap autoloading, and tests live in `tests/phpunit/`. The `bin/changeset` entry point loads `php/bootstrap.php` so it also runs directly from a checkout. Run the package tests from the monorepo root:"},"2526":{"id":"/php/php-changesets/v2.0.0/development-3","page_id":"/php/php-changesets/v2.0.0/development","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/development#architecture","content":"| Component       | Responsibility                                                                                                                      |\n| --------------- | ----------------------------------------------------------------------------------------------------------------------------------- |\n| `Project_Files` | Hold the canonical project root and resolve safe paths inside it, also for a package directory. The other project classes share it. |","table":"table-0"},"2527":{"id":"/php/php-changesets/v2.0.0/development-4","page_id":"/php/php-changesets/v2.0.0/development","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/development#architecture","content":"| Component                           | Responsibility                                                                                                                                                                                     |\n| ----------------------------------- | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `Config_Schema` and `functions.php` | Validate the workspace configuration and its hooks through `define_config()`, and build the shared version descriptors with the namespaced builder functions, which Composer autoloads as `files`. |","table":"table-0"},"2528":{"id":"/php/php-changesets/v2.0.0/development-5","page_id":"/php/php-changesets/v2.0.0/development","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/development#architecture","content":"| Component           | Responsibility                                                                                                  |\n| ------------------- | --------------------------------------------------------------------------------------------------------------- |\n| `Package_Discovery` | Find package directories from the configured globs, with id resolution and duplicate and empty-match detection. |","table":"table-0"},"2529":{"id":"/php/php-changesets/v2.0.0/development-6","page_id":"/php/php-changesets/v2.0.0/development","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/development#architecture","content":"| Component | Responsibility                                                                                                                                                                                                                                                          |\n| --------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `Cli`     | Resolve the project root once, construct the project-bound services, parse commands and global options, prompt for package selection and changeset content, create changesets and configuration, print results and step outputs, set the exit code and invoke recovery. |","table":"table-0"},"2530":{"id":"/php/php-changesets/v2.0.0/development-7","page_id":"/php/php-changesets/v2.0.0/development","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/development#architecture","content":"| Component | Responsibility                                                                                                                     |\n| --------- | ---------------------------------------------------------------------------------------------------------------------------------- |\n| `Git`     | Run git commands in one directory and throw `Git_Exception` on failures, which exit with code 1. Tests replace it with a subclass. |","table":"table-0"},"2531":{"id":"/php/php-changesets/v2.0.0/development-8","page_id":"/php/php-changesets/v2.0.0/development","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/development#architecture","content":"| Component | Responsibility                                                                                |\n| --------- | --------------------------------------------------------------------------------------------- |\n| `Logger`  | Log plain text, or GitHub Actions annotations and job summaries with the `github` log format. |","table":"table-0"},"2532":{"id":"/php/php-changesets/v2.0.0/development-9","page_id":"/php/php-changesets/v2.0.0/development","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/development#architecture","content":"| Component        | Responsibility                                                                                                                                                                                                                                                                                                                                                                                                                                                           |\n| ---------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `Release_Engine` | Load the configuration and changesets, plan the versions, turn them into pre-releases for `--prerelease` or snapshots for `--snapshot`, version only the `--package` selection, format the changelog and readme changelog entries with the hooks, and build one ordered in-memory edit plan. It also finds the changed packages without a changeset since a ref, and creates and pushes the tags that released versions still need, with their titles and release notes. |","table":"table-0"},"2533":{"id":"/php/php-changesets/v2.0.0/development-10","page_id":"/php/php-changesets/v2.0.0/development","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/development#architecture","content":"| Component | Responsibility                                                                                                                                       |\n| --------- | ---------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `Semver`  | Parse, bump and compare the supported stable and pre-release versions, and number the pre-release versions of the stable plan from the package tags. |","table":"table-0"},"2534":{"id":"/php/php-changesets/v2.0.0/development-11","page_id":"/php/php-changesets/v2.0.0/development","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/development#architecture","content":"| Component    | Responsibility                                                                                                                   |\n| ------------ | -------------------------------------------------------------------------------------------------------------------------------- |\n| `Tag_Format` | Expand the `{name}`, `{path}` and `{version}` placeholders of tag formats and git-tag patterns, like `wp-release` `formatTag()`. |","table":"table-0"},"2535":{"id":"/php/php-changesets/v2.0.0/development-12","page_id":"/php/php-changesets/v2.0.0/development","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/development#architecture","content":"| Component                                | Responsibility                                                                                                                                     |\n| ---------------------------------------- | -------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `Changeset_Reader` and `Version_Planner` | Read ordered multi-package changesets and assemble the `releases[]` plan of every package, with the highest bump, next version, tag and changelog. |","table":"table-0"},"2536":{"id":"/php/php-changesets/v2.0.0/development-13","page_id":"/php/php-changesets/v2.0.0/development","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/development#architecture","content":"| Component       | Responsibility                                                                         |\n| --------------- | -------------------------------------------------------------------------------------- |\n| `Version_Files` | Resolve version descriptors and propose bounded in-memory edits without writing files. |","table":"table-0"},"2537":{"id":"/php/php-changesets/v2.0.0/development-14","page_id":"/php/php-changesets/v2.0.0/development","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/development#architecture","content":"| Component             | Responsibility                                                                                                                           |\n| --------------------- | ---------------------------------------------------------------------------------------------------------------------------------------- |\n| `Release_Transaction` | Check the expected contents, journal and stage the edits of every package, apply them as one transaction and recover interrupted writes. |","table":"table-0"},"2538":{"id":"/php/php-changesets/v2.0.0/development-15","page_id":"/php/php-changesets/v2.0.0/development","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/development#architecture","content":"`Project_Config`, `Version_Files`, `Release_Engine` and `Release_Transaction` are instance-based and receive `Project_Files` through their constructors. Constructors only store their dependencies, and the optional `Git`, `Semver` and `Tag_Format` arguments of `Release_Engine`, `Version_Files` and `Version_Planner` default to new instances, so tests can replace them. Validation errors are `Release_Exception`s, which exit with code 2 and can list problems with their files and lines for annotations. Package directories come from `Package_Discovery` in configured group order; the engine plans one release per discovered package and applies their combined edits as one transaction."},"2539":{"id":"/php/php-changesets/v2.0.0/development-16","page_id":"/php/php-changesets/v2.0.0/development","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/development#architecture","content":"`status` and `version --dry-run` only inspect the plan. `version` passes the same edits to the transaction layer. Only the CLI's `init` and `add` commands and the transaction layer write project files."},"2540":{"id":"/php/php-changesets/v2.0.0/development-17","page_id":"/php/php-changesets/v2.0.0/development","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/development#architecture","content":"PHP methods, parameters and local variables use snake_case. External JSON and configuration keys such as `currentVersion`, `nextVersion`, `tagFormat`, `initialVersion` and `ifPresent` stay camelCase, since other tools read them."},"2541":{"id":"/php/php-changesets/v2.0.0/development-18","page_id":"/php/php-changesets/v2.0.0/development","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/development#architecture","content":"Releases use the monorepo's `wp-release` workflow and are split to github.com/wpelevator/php-changesets."},"2542":{"id":"/php/php-changesets/v2.0.0/github-actions","page_id":"/php/php-changesets/v2.0.0/github-actions","type":"page","content":"GitHub Actions","breadcrumbs":["Docs","Php","Php changesets","v2.0.0"],"tags":[],"url":"/php/php-changesets/v2.0.0/github-actions"},"2543":{"id":"/php/php-changesets/v2.0.0/github-actions-0","page_id":"/php/php-changesets/v2.0.0/github-actions","type":"heading","tags":[],"url":"/php/php-changesets/v2.0.0/github-actions#release-with-github-actions","content":"Release with GitHub Actions"},"2544":{"id":"/php/php-changesets/v2.0.0/github-actions-1","page_id":"/php/php-changesets/v2.0.0/github-actions","type":"heading","tags":[],"url":"/php/php-changesets/v2.0.0/github-actions#check-pull-requests","content":"Check pull requests"},"2545":{"id":"/php/php-changesets/v2.0.0/github-actions-2","page_id":"/php/php-changesets/v2.0.0/github-actions","type":"heading","tags":[],"url":"/php/php-changesets/v2.0.0/github-actions#release","content":"Release"},"2546":{"id":"/php/php-changesets/v2.0.0/github-actions-3","page_id":"/php/php-changesets/v2.0.0/github-actions","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/github-actions#release-with-github-actions","content":"The CLI prepares releases, and other actions publish them. These workflows check that pull requests add changesets, open a release pull request whenever changesets are pending on `main`, and after it's merged, create the tag and GitHub release of every released package. Packagist picks up the new tags of Composer packages; add the WP Release Zip and WP Release Deploy SVN actions to the `release` job to ship a WordPress plugin."},"2547":{"id":"/php/php-changesets/v2.0.0/github-actions-4","page_id":"/php/php-changesets/v2.0.0/github-actions","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/github-actions#check-pull-requests","content":"A pull request that changes a package without adding a changeset fails with an annotation on a changed file of the package and a job summary of the changed packages. Contributors fix it with `changeset add`, or with `changeset add --empty` for a change that needs no release."},"2548":{"id":"/php/php-changesets/v2.0.0/github-actions-5","page_id":"/php/php-changesets/v2.0.0/github-actions","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0/github-actions#release","content":"The jobs need the full history (`fetch-depth: 0`) for the tags. `tag --untagged` lists the releases that still need a tag, and each `release` job tags one of them, checking that the package is at the listed version, and pushes the tag. The release notes come from the changelog section of each released version, and the titles are `name@version`, or the version for a package at the repository root, like `wp-release`. Tags pushed with the `GITHUB_TOKEN` don't trigger other workflows; pass a personal access token or GitHub App token to `actions/checkout` when a tag push should start one, like a Packagist or WordPress.org deploy."},"2549":{"id":"/php/php-changesets/v2.0.0","page_id":"/php/php-changesets/v2.0.0","type":"page","content":"PHP Changesets","breadcrumbs":["Docs","Php","Php changesets","v2.0.0"],"tags":[],"url":"/php/php-changesets/v2.0.0"},"2550":{"id":"/php/php-changesets/v2.0.0-0","page_id":"/php/php-changesets/v2.0.0","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0","content":"Prepare multi-package releases for PHP projects and monorepos with changeset Markdown files, PHP and Git."},"2551":{"id":"/php/php-changesets/v2.0.0-1","page_id":"/php/php-changesets/v2.0.0","type":"heading","tags":[],"url":"/php/php-changesets/v2.0.0#requirements","content":"Requirements"},"2552":{"id":"/php/php-changesets/v2.0.0-2","page_id":"/php/php-changesets/v2.0.0","type":"heading","tags":[],"url":"/php/php-changesets/v2.0.0#install","content":"Install"},"2553":{"id":"/php/php-changesets/v2.0.0-3","page_id":"/php/php-changesets/v2.0.0","type":"heading","tags":[],"url":"/php/php-changesets/v2.0.0#quickstart","content":"Quickstart"},"2554":{"id":"/php/php-changesets/v2.0.0-4","page_id":"/php/php-changesets/v2.0.0","type":"heading","tags":[],"url":"/php/php-changesets/v2.0.0#guides","content":"Guides"},"2555":{"id":"/php/php-changesets/v2.0.0-5","page_id":"/php/php-changesets/v2.0.0","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0","content":"`wpelevator/php-changesets` releases WordPress plugins, themes and Composer packages from changeset Markdown files, with PHP and Git and without Node.js. It's for projects that don't use Node.js or JavaScript tooling: a Composer dependency replaces an npm one, and nothing needs installing in CI beyond PHP. It follows the release model of `wp-release`, the Node.js release tool of WP Elevator, so both tools read the same changesets, take the same command options and produce the same release plans."},"2556":{"id":"/php/php-changesets/v2.0.0-6","page_id":"/php/php-changesets/v2.0.0","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0","content":"If your project already builds with Node.js, or you also want ZIPs, checksums, translations or WordPress.org deploys, use the `wp-release` changeset commands instead. The comparison lists the differences."},"2557":{"id":"/php/php-changesets/v2.0.0-7","page_id":"/php/php-changesets/v2.0.0","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0","content":"Contributors describe each change in a small Markdown file. When you release, the `changeset` command bumps the versions of every changed package, writes the changelogs and creates the release tags. It never commits or publishes: those steps belong to your workflow, like the GitHub Actions workflow."},"2558":{"id":"/php/php-changesets/v2.0.0-8","page_id":"/php/php-changesets/v2.0.0","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0#requirements","content":"PHP 7.4 or later."},"2559":{"id":"/php/php-changesets/v2.0.0-9","page_id":"/php/php-changesets/v2.0.0","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0#requirements","content":"Git for tag-based versions, changed-package checks, release tags and dry-run diffs."},"2560":{"id":"/php/php-changesets/v2.0.0-10","page_id":"/php/php-changesets/v2.0.0","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0#requirements","content":"Composer to install the CLI. Node.js is not required."},"2561":{"id":"/php/php-changesets/v2.0.0-11","page_id":"/php/php-changesets/v2.0.0","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0#quickstart","content":"For a WordPress plugin or a Composer package at the repository root:"},"2562":{"id":"/php/php-changesets/v2.0.0-12","page_id":"/php/php-changesets/v2.0.0","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0#guides","content":"Command line: the commands, changesets, the status check, releases, pre-releases, output formats and exit codes."},"2563":{"id":"/php/php-changesets/v2.0.0-13","page_id":"/php/php-changesets/v2.0.0","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0#guides","content":"Configuration: `changesets.config.php`, package groups, version descriptors and hooks."},"2564":{"id":"/php/php-changesets/v2.0.0-14","page_id":"/php/php-changesets/v2.0.0","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0#guides","content":"GitHub Actions: check pull requests for changesets, open release pull requests and create the tags and GitHub releases."},"2565":{"id":"/php/php-changesets/v2.0.0-15","page_id":"/php/php-changesets/v2.0.0","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0#guides","content":"Comparison with wp-release: the command mapping and the deliberate differences."},"2566":{"id":"/php/php-changesets/v2.0.0-16","page_id":"/php/php-changesets/v2.0.0","tags":[],"type":"text","url":"/php/php-changesets/v2.0.0#guides","content":"Development: the architecture and tests of the package."}},"count":2566},"sorting":{"language":"english","sortableProperties":["content","page